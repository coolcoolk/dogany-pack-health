{
  "id": "pack_health",
  "name_en": "Dogany Health Trainer",
  "name_ko": "Dogany 헬스 트레이너",
  "kind": "pack",
  "pack_version": "0.38.3",
  "contract_version": 1,
  "requires_framework": ">=2.6.0",
  "requires_kit": {
    "kit": "kit_life",
    "range": ">=2.46.0-dev.28 <3.0.0"
  },
  "capabilities": {
    "db_lane": false
  },
  "hooks": [
    {
      "event": "SessionStart",
      "script": "routines/bundle/domain-onboarding-check.py"
    },
    {
      "event": "Stop",
      "script": "routines/bundle/domain-onboarding-stop.py"
    },
    {
      "event": "UserPromptSubmit",
      "script": "routines/bundle/domain-onboarding-prompt.py",
      "timeout": 30
    },
    {
      "event": "UserPromptSubmit",
      "script": "routines/bundle/session-progress-inject.py",
      "timeout": 20
    },
    {
      "event": "UserPromptSubmit",
      "script": "routines/bundle/goal-entry-gate.py",
      "timeout": 10
    },
    {
      "event": "PreToolUse",
      "script": "routines/bundle/tool-output-filter-gate.py",
      "timeout": 5
    }
  ],
  "post_mint_next": "[domain onboarding -- pack_health] Identity onboarding just finished; the health goal stage may still be outstanding. Run the declared wrapper exactly as named, from own root: /usr/bin/python3 routines/bundle/domain-onboarding-check.py (no arguments, empty stdin). Its NONEMPTY STDOUT is the continuation signal; its exit code is always 0. On nonempty stdout: load the health-onboarding skill, obey its step 0 verdict recheck, and in THIS same message open with its step 1 CONTINUATION OPENING: goal-session's first message (program-plan next), verbatim, with no transition line and no second settings recap. Empty stdout, an error or a timeout: no domain setup copy.",
  "payload_root": "payload",
  "service_namespace": "health",
  "knowledge_warehouse": "kimwog",
  "skills": [
    {
      "name": "health-onboarding",
      "sharing_mode": "own"
    },
    {
      "name": "workout-session",
      "sharing_mode": "own"
    },
    {
      "name": "workout-program",
      "sharing_mode": "own"
    },
    {
      "name": "pain-triage",
      "sharing_mode": "own"
    },
    {
      "name": "diet-plan",
      "sharing_mode": "own"
    },
    {
      "name": "diet-status",
      "sharing_mode": "own"
    },
    {
      "name": "exercise-form-demo",
      "sharing_mode": "own"
    }
  ],
  "deploy_owner": "skull",
  "status": "published",
  "tone_candidates": {
