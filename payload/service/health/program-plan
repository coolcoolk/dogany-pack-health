# template at import and on every rendered `say` (runtime).
# "카드" left this list in round 3: the goal card and the program card are
# things the user now SEES (owner 16:55 "채워지는 카드처럼"; the owner's own
# wrap line "카드가 다 찼어요"). The program file is still never named.
INTERNAL_TERMS = (
    "below_floor", "above_ceiling", "in_band", "untrained", "fatigue",
    "MEV", "MAV", "MRV", "program.yaml", "rotation", "로테이션",
    "beginner", "returner", "continuous", "슬롯", "draft", "stage", "볼륨 감사",
    "ledger", "consult", "focus_areas", "tradeoff", "프라이머", "primer",
    "makeup", "queue", "저장돼서", "구조예요", "입력 형식", "--",
)
# An escape hatch is never offered (journey K8, D5b): no "later" sentence and
# no "later" button. A user who says it first is still heard -- the answer
# payload keeps `pick: later` -- but the tool never puts it in front of them.
ESCAPE_TERMS = ("나중에",)


class CopyLeak(Exception):
    pass


def _copy_gate(text, where):
    for t in INTERNAL_TERMS:
        if t in text:
            raise CopyLeak("internal term %r in user copy (%s)" % (t, where))
    for t in ESCAPE_TERMS:
        if t in text:
            raise CopyLeak("escape hatch %r in user copy (%s)" % (t, where))
    return text


# Hand-gesture emoji (owner 2026-09-26 13:49: emoji are fine, hand signs are
# not -- thumbs, pointing, waving, folded hands, OK/victory signs, and the
# skin-tone modifiers that ride them). Every other emoji may be spoken.
# Same set as the kit's _HAND_EMOJI_RE.
HAND_EMOJI_RANGES = ((0x261D, 0x261D), (0x270A, 0x270D), (0x1F446, 0x1F450),
                     (0x1F485, 0x1F485), (0x1F590, 0x1F590),
                     (0x1F595, 0x1F596), (0x1F64B, 0x1F64C),
                     (0x1F64F, 0x1F64F), (0x1F90C, 0x1F90C),
                     (0x1F90F, 0x1F90F), (0x1F918, 0x1F91F),
                     (0x1F932, 0x1F932), (0x1FAF0, 0x1FAF8),
                     (0x1F3FB, 0x1F3FF))


def has_hand_emoji(text):
    return any(lo <= ord(ch) <= hi for ch in text or ""
               for lo, hi in HAND_EMOJI_RANGES)


# Any emoji at all in consult copy (journey 2장: pros / cons are text labels,
# the consult speaks no persona emoji). The same code-point ranges as the
# kit's _MOVE_EMOJI_RE, so both halves of the journey refuse the same set.
EMOJI_RANGES = ((0x2600, 0x27BF), (0x1F000, 0x1FAFF), (0x2B50, 0x2B50),
                (0x2B55, 0x2B55))


def has_emoji(text):
    return any(lo <= ord(ch) <= hi for ch in text or ""
               for lo, hi in EMOJI_RANGES)


def form_error(text):
    """None when a spoken text is allowed, else the reason: no emoji (hand
    gestures included), no code block, no backslash escape (a literal
    backslash reaches the user as-is on the channel)."""
    t = text or ""
    if has_hand_emoji(t):
        return "hand-gesture emoji"
    if has_emoji(t):
        return "emoji"
    if "```" in t:
        return "code block"
    if "\\" in t:
        return "backslash escape"
    return None


for _k, _v in COPY.items():
    _copy_gate(_v, "COPY[%s]" % _k)
    if form_error(_v):
        raise CopyLeak("%s in user copy (COPY[%s])" % (form_error(_v), _k))


def ends_on_decision(text):
    """True when the last spoken line is a question: every rendered move
    ends on the next decision (owner rehearsal 2026-09-26 13:27), never on
    an open "tell me if you want it different". The question may carry a
    short how-to-answer tail on the same line (e.g. "go with these four
    sessions? name only the exercise you want changed.")."""
    lines = _spoken_lines(text)
    return bool(lines) and "?" in lines[-1]


def _spoken_lines(text):
    lines = [ln.strip() for ln in (text or "").split("\n") if ln.strip()]
    # Example answers sit BELOW the question under a "예)" line (the kit's
    # goal-interview shape, owner 2026-09-26 18:58): they are not the last
    # spoken line, the question above them is.
    if "예)" in lines:
        lines = lines[:len(lines) - 1 - lines[::-1].index("예)")]
    elif lines and lines[-1].startswith("예) "):
        # one example on the same line (the count and minutes ask)
        lines = lines[:-1]
    if len(lines) > 1 and lines[-1] == T("free_input"):
        lines = lines[:-1]
    return lines


def reask_line(say):
    """The one line a side-question reply ends on (owner 2026-10-05, again
    2026-10-07 15:52): the open move's own question, cut at its first "?"
    so the how-to-answer tail already on screen is not repeated; a fact ask
    that ends on a request keeps its whole last line."""
    lines = [ln[1:].strip() if ln.startswith(">") else ln
             for ln in _spoken_lines(say)]
    if not lines:
        return None
    last = lines[-1]
    return last[:last.index("?") + 1] if "?" in last else last


def reask_move(mv):
    """`program-plan reask`: the move still open after a side question,
    re-asked in ONE line with the SAME choices -- no card, no readback, no
    lead or option bodies (they are already on screen). Nothing is recorded
    and nothing moves; a move without a question (done, paused, error) is
    passed through untouched."""
    line = reask_line(mv.get("say"))
    if mv.get("kind") in FINAL_KINDS + ("error", "paused") or not line:
        return mv
    return {"kind": "reask", "stage": mv["stage"], "readback": [],
            "say": line, "choices": list(mv.get("choices") or []),
            "answer": mv.get("answer")}


def ends_on_request(text):
    """An open fact ask (FACT_ASKS) may end on the request for the facts
    instead of a question mark (owner rehearsal 2026-10-01, the days and
    times: '... tell me')."""
    lines = _spoken_lines(text)
    return bool(lines) and lines[-1].endswith(T("request_tail"))


