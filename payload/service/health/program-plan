def light_partner(cx, rc, code, name, lifts, avoid):
    """A lighter lift of the same pattern for `name` in session `code`:
    same candidates the compose drew from (place, muscle map), not a lift
    the plan already swapped out for a safety site, not heavy, not already
    in the session, carrying a Korean name; closest muscle credit wins."""
    pat = rc.pattern(name)
    best = None
    for c in candidates(cx):
        nm = c["name"]
        if (nm in lifts[code] or nm in avoid or not rc.lib.mapped(nm)
                or loads_caution_area(cx, nm)):
            continue
        if rc.pattern(nm) != pat or rc.heavy(nm):
            continue
        ko = exercise_ko(nm)
        if not ko:
            continue
        key = (-rc.overlap(name, nm), nm)
        if best is None or key < best[0]:
            best = (key, nm, ko)
    return (best[1], best[2]) if best else None


def plan_spacing(cx, rc, rot, lifts, pinned=()):
    """(order, swaps, clashes left). swaps: [(session, heavy lift, light
    lift, light display, near lift)] applied in order."""
    starts = training_starts(cx)
    avoid = {ex.get("replaces") for c in rot
             for ex in cx.st["compose"].get(c) or [] if ex.get("replaces")}
    best = None
    for order in split_orders(rot):
        cur = {c: list(v) for c, v in lifts.items()}
        swaps = []
        clashes = spacing_clashes(rc, starts, order, cur)
        while clashes:
            done = False
            for cl in clashes:
                for code, lift, near in ((cl["then"], cl["then_lift"],
                                          cl["first_lift"]),
                                         (cl["first"], cl["first_lift"],
                                          cl["then_lift"])):
                    if (code, lift) in pinned:
                        continue
                    others = [x for c in order for x in cur[c]
                              if (c, x) != (code, lift) and rc.heavy(x)
                              and rc.pattern(x) == rc.pattern(lift)]
                    if not others:
                        continue          # the week's only heavy one stays
                    lt = light_partner(cx, rc, code, lift, cur, avoid)
                    if not lt:
                        continue
                    cur[code] = [lt[0] if x == lift else x
                                 for x in cur[code]]
                    swaps.append((code, lift, lt[0], lt[1], near))
                    done = True
                    break
                if done:
                    break
            if not done:
                break
            clashes = spacing_clashes(rc, starts, order, cur)
        score = (len(clashes), len(swaps),
                 sum(1 for a, b in zip(order, rot) if a != b))
        if best is None or score < best[0]:
            best = (score, order, swaps, clashes)
        if score == (0, 0, 0):
            break
    return best[1], best[2], best[3]


def apply_spacing(cx, pinned=()):
    """Space the heavy lifts of the recorded compose (see the rule above).
    Records what changed in st['spacing'] for the session cards."""
    st = cx.st
    rot = list(st["structure"]["rotation"])
    mf = kit_mf()
    if mf is None:
        st["spacing"] = {"skipped": "kit per-muscle recovery model not found "
                                    "(%s)" % kit_db_dir()}
        return
    rc = Recovery(mf, cx.db)
    lifts = {c: [ex["name"] for ex in st["compose"][c]] for c in rot}
    starts = training_starts(cx)
    before = spacing_clashes(rc, starts, rot, lifts)
    rec = {"before": before}
    if before:
        order, swaps, left = plan_spacing(cx, rc, rot, lifts, pinned)
        if order != rot:
            old_note = queue_note(cx)
            st["structure"]["rotation"] = order
            rec["order_from"] = rot
            new_note = queue_note(cx)
            for nt in st.get("notes") or []:
                if nt.get("text") == old_note:
                    nt["text"] = new_note
        for code, lift, light, ko, near in swaps:
            lst = st["compose"][code]
            for i, ex in enumerate(lst):
                if ex["name"] != lift:
                    continue
                near_ko = next((e["display"] for c in order
                                for e in st["compose"][c]
                                if e["name"] == near), near)
                lst[i] = {"name": light, "display": ko,
                          "spaced": {"from": lift,
                                     "from_display": ex["display"],
                                     "near": near, "near_display": near_ko}}
        rec["swaps"] = [{"session": c, "from": a, "to": b, "near": n}
                        for c, a, b, _k, n in swaps]
        rec["left"] = left
    st["spacing"] = rec


def spacing_order_line(cx, code):
    """The one card line for a session the reorder moved, or None."""
    sp = cx.st.get("spacing") or {}
    frm = sp.get("order_from")
    rot = cx.st["structure"]["rotation"]
    if not frm or code not in frm or frm.index(code) == rot.index(code):
        return None
    for cl in sp.get("before") or []:
        if code in (cl["first"], cl["then"]):
            near = cl["then_lift"] if code == cl["first"] else cl["first_lift"]
            other = cl["then"] if code == cl["first"] else cl["first"]
            ko = next((e["display"] for e in cx.st["compose"].get(other) or []
                       if e["name"] == near), None)
            if ko:
                return T("spaced_order", near=ko)
    return None


COMPOSE_KEYS = ("compose", "prep", "cooldown", "titles", "set_adjust",
                "fields", "structure", "spacing", "notes", "practice_blocks",
                "volume_shortfall")


def accept_compose(cx, payload, pinned=(), defer_floors=False):
    """Record a validated compose and hold the weekly volume floor INSIDE it
    (owner 17:38): every slot starts at the rule dose, the tool raises /
    trims sets silently within [3, MAX_SETS_FIX], and a program it cannot
    bring into the band is REFUSED -- nothing recorded -- so the model adds
    or changes a lift. No volume question is ever asked. The heavy lifts
    are spaced over the week first (apply_spacing), so the volume is held on
    the lifts the week will actually run; `pinned` = (session, lift) pairs
    the user named, never lightened. Internal repair probes may defer floor
    refusals to compare deficits; the final acceptance still enforces them."""
    rot = cx.st["structure"]["rotation"]
    before = {k: copy.deepcopy(cx.st.get(k)) for k in COMPOSE_KEYS}
    # the retired swap review's state (a consult parked at it before the
    # 2026-10-04 caution policy): a new compose has nothing to review
    for k in ("swap_decisions", "swap_review", "swap_error",
              "swap_validation_error"):
        cx.st.pop(k, None)
    cx.st["compose"] = {c: [dict(ex) for ex in payload["days"][c]]
                        for c in rot}
    fill_chosen_practices(cx)
    cx.st["prep"] = {c: prep_for_lifts(cx, cx.st["compose"][c])
                     for c in rot}
    cx.st["cooldown"] = {c: MC.distinct_drills(payload["cooldown"][c])
                         for c in rot}
    cx.st.pop("titles", None)
    cx.st["set_adjust"] = {}
    apply_spacing(cx, pinned)
    rot = cx.st["structure"]["rotation"]
    import compose_rank
    ranked = compose_rank.for_context(cx, candidates(cx), globals())
    cx.st['compose'] = {c: compose_rank.ordered(ranked, c, cx.st['compose'][c]) for c in rot}
    errors = compose_rank.validate(ranked, cx.st['compose'])
    if not errors:
        cx.st['prep'] = {c: prep_for_lifts(cx, cx.st['compose'][c]) for c in rot}
        cx.st['practice_blocks'] = session_practice_blocks(cx)
        fit_prep_block(cx)
        shoulder_cuff_week(cx)
        errors = compose_rank.validate_blocks(chosen_practices(cx), cx.st['practice_blocks'],
                                              weekly_days=weekly_days(cx))
    if errors:
        for k, v in before.items():
            if v is None:
                cx.st.pop(k, None)
            else:
                cx.st[k] = v
        raise Refused('\n'.join(errors))
    names = {ex["name"] for c in rot for ex in cx.st["compose"][c]}
    cx.st["fields"] = {k: v for k, v in (before["fields"] or {}).items()
                       if k in names}
    fd = final_days(cx)
    cx.st.pop("volume_error", None)
    cx.st.pop("volume_shortfall", None)
    try:
        adjust, left, capped = fit_volume(cx, fd)
    except Exception as e:                                  # noqa: BLE001
        # an audit that cannot run does not block the build; the reason is
        # kept for `status`, never guessed around
        adjust, left, capped = {}, [], set()
        cx.st["volume_error"] = str(e)[-300:]
    # A floor the session minutes cannot hold is a SOFT shortfall (owner
    # 2026-10-01: the minutes are the user's, nothing is composed past
    # them): recorded for the consult to mention, never a refusal. A floor
    # no set can reach for another reason still refuses.
    short = [(m, e) for m, e in left if (m in capped or defer_floors)
             and e["proposed_weekly_sets"] < e["band"]["floor"]]
    left = [(m, e) for m, e in left if (m, e) not in short]
    if short and not left:
        cx.st["volume_shortfall"] = [
            dict(muscle=m, weekly_sets=int(round(e["proposed_weekly_sets"])),
                 floor=e["band"]["floor"]) for m, e in short]
    if left:
        for k, v in before.items():
            if v is None:
                cx.st.pop(k, None)
            else:
                cx.st[k] = v
        raise Refused("\n".join(
            "E-VOLUME-%s\tdays\t%s: %d weekly sets, band %d~%d, even with "
            "every slot at %d~%d sets -- %s" % (
                "FLOOR" if e["proposed_weekly_sets"] < e["band"]["floor"]
                else "CEILING", m, int(round(e["proposed_weekly_sets"])),
                e["band"]["floor"], e["band"]["ceiling"],
                set_level(cx), MAX_SETS_FIX,
                "add a lift that trains it as a primary muscle"
                if e["proposed_weekly_sets"] < e["band"]["floor"]
                else "take a lift for it out")
            for m, e in left))
    cx.st["set_adjust"] = adjust
    if cx.st.get('trainer_fit'):
        cx.st['trainer_fit']['minutes'] = compose_rank.program_minutes(cx, candidates(cx), globals())
    cx.st.pop("sessions", None)


