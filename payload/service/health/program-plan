        ["end=" + horizon] if horizon else []) + ["--new"]


def cardio_routine_args(cx):
    """`routine add` args for the supplementary day the cardio moved to
    (reconcile, cardio_extra), or None."""
    tp = cx.st.get("time_plan") or {}
    if tp.get("pick") != "cardio_extra" or not tp.get("cardio_day"):
        return None
    day = tp["cardio_day"]
    args = ["routine", "add", T("cal_cardio_title"), "W:" + day]
    for w in (cx.st.get("daytime") or {}).get("extra_windows") or ():
        if day in w["weekdays"] and w.get("start"):
