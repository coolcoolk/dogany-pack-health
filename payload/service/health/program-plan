def prep_file_text(cx):
    """prep.yaml for the first program: the drills the compose named (display
    from the display layer, every one a mat drill; stretches timed
    cooldown) and each session's prep / cooldown lists, in order. Same
    schema as sot/prep.TEMPLATE.yaml; the pack supplies each drill's dose and
    a short physical instruction."""
    rot = cx.st["structure"]["rotation"]
    # A mobility-flow pick opens the mat prep with its flow drills.
    flows = {code: (((cx.st.get("practice_blocks") or {}).get(code) or {})
                    .get("flow") or {}).get("drills") or [] for code in rot}
    lists = {"prep": {c: MC.distinct_drills(flows[c] + cx.st["prep"][c])
                      for c in rot},
             "cooldown": {c: MC.distinct_drills(cx.st["cooldown"][c])
                          for c in rot}}
    keys = []
    for code in rot:
        for k in lists["prep"][code] + lists["cooldown"][code]:
            if k not in keys:
                keys.append(k)
    out = ["# prep.yaml -- written by program-plan with the first program "
           "(%s)." % cx.today.isoformat(),
           "# The user's own data from here on: no install and no later "
           "program-plan run overwrites it.",
           "drills:"]
    for k in keys:
        out += ["  %s:" % k, '    name: "%s"' % k,
                '    display: "%s"' % MC.MOVEMENTS[k]['ko'],
                "    zone: %s" % drill_zone(k)]
        cue = MC.MOVEMENTS[k]['how']
        out += ['    howto: "%s"' % cue]
        if k in _COOLDOWN_KEYS:
            out.append("    timing: cooldown")
    out.append("days:")
    for code in rot:
        out.append("  %s:" % code)
        for block in ("prep", "cooldown"):
            out.append("    %s:" % block)
            for k in lists[block][code]:
                dose = MC.MOVEMENTS[k]['dose']
                number = int(re.search(r'\d+', dose).group())
                out.append('      - code: %s' % k)
                if '초' in dose:
                    out.append('        target_reps: 1')
                    out.append('        target_unit: hold_sets')
                    out.append('        hold_sec: %d' % number)
                else:
                    out.append('        target_reps: %d' % number)
                    out.append('        target_unit: %s' %
                               ('per_side' if '좌우' in dose else 'reps'))
                swap = better_swap(cx, k) if block == "prep" else None
                if swap:
                    # the one in-session swap line (owner 2026-10-06 16:11)
                    out.append('        better_code: %s' % swap[0])
                    out.append('        better_tool: %s' % swap[1])
                    out.append('        better_display: "%s"'
                               % MC.MOVEMENTS[swap[0]]['ko'])
    return "\n".join(out) + "\n"




def drill_zone(code):
    """prep.yaml zone: a fixed station (machine / cable / rack / bench) is
    `equipment`, anything carried or bodyweight is `mat`."""
    return ("equipment" if drill_class(code) in ("machine", "cable", "rack",
                                                 "bench", "barbell")
            else "mat")


def write_prep_file(cx):
    """Write prep.yaml beside the program when there is none (the mat-prep
    and cooldown slots become what session-open and the morning card read).
    An existing prep.yaml is the user's data and is never touched."""
    path = os.path.join(os.path.dirname(os.path.abspath(cx.program)),
                        "prep.yaml")
    if os.path.exists(path):
        cx.st["prep_file"] = "kept"
        return
    text = prep_file_text(cx)
    rx = init_mod()._load_rx()
    problems = rx.validate_prep(rx._parse_yaml_lines(
        text.splitlines(True)))
    if problems:
        cx.st["prep_file"] = "refused"
        cx.st.setdefault("kit_errors", []).append(
            "prep.yaml: %s" % "; ".join(problems)[-300:])
        return
    fd_, tmp = tempfile.mkstemp(prefix=".prep-", dir=os.path.dirname(path))
    with os.fdopen(fd_, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)
    cx.st["prep_file"] = "written"


def _minutes(start, end):
    h1, m1 = (int(x) for x in start.split(":"))
    h2, m2 = (int(x) for x in end.split(":"))
    return (h2 * 60 + m2) - (h1 * 60 + m1)


def replaced_routines(cx):
    """The active health routines a new plan may replace: workouts, the
    measure day and the cardio day this plan writes. register_calendar
    retires only those the plan does not repeat as they are.

    The kit retains past occurrences. Keep links existing rows without adding
    another copy of the same schedule.
    """
    if cx.st.get("calendar_existing_answered") == "keep":
        return []
    return [dict(w, kind=kind) for kind in ("exercise", "measure", "cardio")
            for w in calendar_routines(cx.db, kind)]


def exercise_routine_args(cx, w):
    """`routine add` args for one training window ("헬스")."""
    args = ["routine", "add", "헬스", "W:" + ",".join(w["weekdays"])]
    if w.get("start"):
        args.append("time=%s" % w["start"])
        hour, minute = map(int, w["start"].split(":"))
        # The routine engine sends the lead alert and the start alert.
        args.append("notify=%d" % (hour * 60 + minute + 180))
        if w.get("end"):
            args.append("duration=%d" % _minutes(w["start"], w["end"]))
    horizon = handoff(cx).get("horizon")
    if horizon:
        args.append("end=" + horizon)
    place = routine_place(cx)
    if place:
        # by NAME (the kit's canonical one): exact on every kit, where a
        # bare id on a kit before place=<id> would mint a place called "4"
        args.append("place=" + place)
    return args + ["--new"]


def measure_routine_args(cx):
    """`routine add` args for the measure day, or None (no weekly slot)."""
    m = cx.st.get("measure") or {}
    if m.get("status") != "set" or m.get("cadence") != "weekly" or \
            not m.get("weekday"):
        return None
    start = None
    for w in (cx.st.get("daytime") or {}).get("windows") or ():
        if m["weekday"] in w["weekdays"]:
            start = w.get("start")
    args = ["routine", "add", "인바디", "W:" + m["weekday"]]
    if start:
        args += ["time=%s" % start, "duration=10"]
    horizon = handoff(cx).get("horizon")
    return args + ["purpose=체성분 측정 (운동 전, 공복)"] + (
        ["end=" + horizon] if horizon else []) + ["--new"]


def cardio_routine_args(cx):
    """`routine add` args for the supplementary day the cardio moved to
    (reconcile, cardio_extra), or None."""
    tp = cx.st.get("time_plan") or {}
    if tp.get("pick") != "cardio_extra" or not tp.get("cardio_day"):
        return None
    day = tp["cardio_day"]
    args = ["routine", "add", T("cal_cardio_title"), "W:" + day]
    for w in (cx.st.get("daytime") or {}).get("extra_windows") or ():
        if day in w["weekdays"] and w.get("start"):
            args += ["time=%s" % w["start"], "duration=%d" % tp["cardio"]]
    horizon = handoff(cx).get("horizon")
    return args + (["end=" + horizon] if horizon else []) + ["--new"]


def _routine_sig(weekdays, start, end):
    """(weekdays, start, end) -- what makes two weekly routines the same
    calendar rule; no length (end == start) counts as no end."""
    return (tuple(weekdays), start or None,
            end if start and end and end != start else None)


def _args_sig(args):
    """The rule signature of `routine add` args (see _routine_sig)."""
    days, start, dur = [], None, 0
    for a in args:
        if a.startswith("W:"):
            days = cadence_weekdays(a)
        elif a.startswith("time="):
            start = a[5:]
        elif a.startswith("duration="):
            dur = int(a[9:])
    end = None
    if start:
        h, mi = (int(x) for x in start.split(":"))
        e = h * 60 + mi + dur
        end = "%02d:%02d" % ((e // 60) % 24, e % 60)
    return _routine_sig(days, start, end)


def _routine_ends(db):
    """{routine id: end_date} of the routine rows; {} without the column."""
    return {rid: str(end or "")[:10] for rid, end in _q(
        db, "SELECT id, end_date FROM routine_def")}


def register_calendar(cx):
    """Reconcile, then replace (D3, P8). The plan's routines -- one per time
    window ("헬스", its weekdays, start and length; no time said -> all-day,
    a time is never picked for the user, E13), the cardio day and the
    measure day -- are diffed against the active ones FIRST: a routine the
    plan repeats as it is (title, weekdays, start, end) stays (its future blocks untouched; only its end
    follows the new horizon), the rest are RETIRED through the kit (an end
    date, then `routine retire`: the row stays, only future instances are
    cancelled -- nothing deleted), THEN only what is missing is added. A
    re-run with the same windows writes no routine (2026-10-07: a retire
    then re-read lost every 헬스 rule). True when the days are on the
    calendar."""
    wins = (cx.st.get("daytime") or {}).get("windows") or []
    if not wins:
        return False
    if cx.st.get("calendar_existing_answered") == "keep":
        cx.st["calendar_linked"] = [x["id"] for x in cx.st.get("calendar_existing_items", [])]
        return True
    today = cx.today.isoformat()
    horizon = handoff(cx).get("horizon")
    wanted = [("exercise", exercise_routine_args(cx, w)) for w in wins]
    cargs = cardio_routine_args(cx)
    if cargs:
        wanted.append(("cardio", cargs))
    margs = measure_routine_args(cx)
    if margs:
        wanted.append(("measure", margs))
    _READS.clear()                  # the diff reads the DB as it is now
    current = replaced_routines(cx)
    ends = _routine_ends(cx.db) if horizon else {}
    kept, to_add = set(), []
    for kind, args in wanted:
        sig = _args_sig(args)
        same = [w for w in current if w["kind"] == kind and w["id"] not in kept
                and (w["title"] or "").strip() == args[2]
                and _routine_sig(w["weekdays"], w.get("start"),
                                 w.get("end")) == sig]
        if same:
            kept.add(same[0]["id"])
            if horizon and ends.get(same[0]["id"], horizon) != horizon:
                rc, _o, e = kit(["routine", "update", str(same[0]["id"]),
                                 "end=" + horizon])
                if rc != 0:
                    cx.st.setdefault("kit_errors", []).append(
                        "routine update %s: %s" % (same[0]["id"],
                                                   (e or "").strip()[-200:]))
        else:
            to_add.append((kind, args))
    cx.st["calendar_kept"] = sorted(kept)
    place = routine_place(cx)
    if place and kept:
        # a kept workout rule without the plan's place gets it (place is not
        # part of the rule's sameness: the rows stay, the place lands on
        # them and travel follows -- kit routine update place=)
        want = ensure_place(cx, place) if place else None
        pids = _routine_place_ids(cx.db)
        for w in current:
            if w["id"] in kept and w["kind"] == "exercise" and \
                    want and want[0] == "ok" and w["id"] in pids and \
                    pids[w["id"]] != want[1]:
                set_routine_place(cx, w["id"], place)
    replaced = []
    for w in current:
        if w["id"] in kept:
            continue
        rc, _o, e = kit(["routine", "update", str(w["id"]), "end=" + today])
        if rc != 0:
            cx.st.setdefault("kit_errors", []).append(
                "routine update %s: %s" % (w["id"], (e or "").strip()[-200:]))
        rc, _o, e = kit(["routine", "retire", str(w["id"])])
        if rc != 0:
            cx.st.setdefault("kit_errors", []).append(
                "routine retire %s: %s" % (w["id"], (e or "").strip()[-200:]))
            continue
        replaced.append({"id": w["id"], "title": w["title"],
                         "since": w.get("since")})
    cx.st["calendar_replaced"] = replaced
    # Cancel only future manual blocks. The kit verb retains a tombstone and
    # never rewrites a completed historical instance.
    for item in cx.st.get("calendar_existing_items", []):
        if item.get("source") != "block":
            continue
        try:
            if local_calendar_stamp(item["start_at"]).date() < cx.today:
                continue
        except (ValueError, TypeError):
            continue
        verb = {"appointment": "appt-cancel", "presence": "presence-cancel",
                "task": "task-del"}.get(item.get("block_kind"))
        if verb:
            rc, _out, err = kit([verb, str(item["id"])])
            if rc != 0:
                cx.st.setdefault("kit_errors", []).append(
                    "calendar block %s: %s" % (item["id"], (err or "").strip()[-200:]))
    ok = True
    if margs:
        cx.st["calendar_measure"] = True
    for kind, args in to_add:
        rc, out, e = kit(args)
        if kind == "measure":
            cx.st["calendar_measure"] = rc == 0
            if rc != 0:
                cx.st.setdefault("kit_errors", []).append(
                    "routine add (measure): %s" % ((e or out or "").strip()[-200:]))
            continue
        if rc != 0:
            ok = False
            cx.st.setdefault("kit_errors", []).append(
                "routine add%s: %s" % (" (cardio)" if kind == "cardio" else "",
                                       (e or out or "").strip()[-200:]))
    return ok


def archive_program(cx):
    """The program being replaced is copied to files/_archive/<ts>/ before
    the new one is written (the replace question is gone: on onboarding and
    restart, a new plan IS the intent)."""
    if not os.path.exists(cx.program):
        return None
    root = os.path.dirname(os.path.dirname(os.path.abspath(cx.program)))
    dest = os.path.join(root, "_archive", "program-%s" % datetime.datetime
                        .now().strftime("%Y%m%d-%H%M%S"))
