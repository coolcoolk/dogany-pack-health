def active_goal_metrics(db):
    """Metric tokens in the earliest selected consult phase or active goals."""
    strands = _q(db, "SELECT axis_key, phase_order FROM metric_axis WHERE "
                     "origin='user' AND role='picture'")
    ordered = [r for r in strands if r[1] is not None]
    if ordered:
        first = min(r[1] for r in ordered)
        keys = {k for k, o in ordered if o == first}
    else:
        keys = set()
        for (detail,) in _q(db, "SELECT detail FROM ledger_goal WHERE "
                                "status='active' AND detail IS NOT NULL"):
            try:
                d = json.loads(detail)
            except (ValueError, TypeError):
                continue
            if isinstance(d, dict) and d.get("axis_key"):
                keys.add(d["axis_key"])
    metrics = set()
    for k in keys:
        metrics.update(m for (m,) in _q(
            db, "SELECT metric_token FROM goal_metric_source WHERE "
                "axis_key=?", (k,)))
    return metrics


CUT_METRICS = ("body_fat_pct", "body_weight")
GROW_METRIC = "skeletal_muscle_kg"


def goal_phase(db):
    """(phase, metric) of the current consult phase, read from the active
    goals' DIRECTION (owner rehearsal 2026-10-01): a body fat / body weight
    goal going down is a cut even when skeletal muscle is linked to the same
    strand; a skeletal muscle goal going up (and no fat-down goal) is grow.
    Goals outside the earliest selected phase are not read while that phase
    has one. No goal with a metric: the linked metrics decide, as before.
    (None, None) when nothing says."""
    rows = [(m, (d or "up")) for m, d in _q(
        db, "SELECT metric, target_dir FROM ledger_goal WHERE "
            "status='active' AND metric IS NOT NULL ORDER BY id")]
    metrics = active_goal_metrics(db)
    current = [r for r in rows if r[0] in metrics] or rows
    for m in CUT_METRICS:
        if (m, "down") in current:
            return "cut", m
    if (GROW_METRIC, "up") in current:
        return "grow", GROW_METRIC
    if current:
        return None, None
    if GROW_METRIC in metrics:
        return "grow", GROW_METRIC
    for m in CUT_METRICS:
        if m in metrics:
            return "cut", m
    return None, None


def cut_phase_metric(db):
    """The metric the current phase reduces, or None outside a cut."""
    phase, metric = goal_phase(db)
    return metric if phase == "cut" else None


# -- the goals by priority (owner 2026-10-04 21:27-21:31) --------------------
# (resources capped -> the goals compete by priority, what survives is
# planned): when the time cannot hold the plan, dropping lifts / sets below
# what the goal needs IS a goal adjustment, driven by the goals' priority.
# The kit's goal layer carries it: ledger_goal.focus_state (focus > backlog
# > dormant) and priority_rank (lower first), written through goal-set /
# goal-focus. Only a strength-served goal (its rate rides the weekly sets)
# can be moved by a strength cut; a fat / weight goal's rate is the kit's
# time-based rate model (personal_rate), so a cut never moves its date --
# in a cut it lets go of its muscle-keeping branch instead.
STRENGTH_GOAL_METRICS = ("skeletal_muscle_kg", "lift_capacity_kg")
CUT_GOAL_METRICS = ("body_fat_pct", "body_weight")
FOCUS_ORDER = {"focus": 0, "backlog": 1, "dormant": 2}


def active_goals(cx):
    """[{id, metric, dir, horizon, focus, rank, detail}] of the active
    health goals with a metric, in the kit's own order (focus, rank, id)."""
    rows = _q(cx.db, "SELECT id, metric, target_dir, horizon_date, "
                     "focus_state, priority_rank, detail, target_value "
                     "FROM ledger_goal WHERE status='active' AND metric IS "
                     "NOT NULL AND (domain='health' OR domain IS NULL) "
                     "ORDER BY id")
    out = [dict(id=r[0], metric=r[1], dir=r[2] or "up", horizon=r[3],
                focus=r[4] or "backlog", rank=r[5], detail=r[6],
                target=r[7]) for r in rows]
    out.sort(key=lambda g: (FOCUS_ORDER.get(g["focus"], 1),
                            g["rank"] if g["rank"] is not None else 999999,
                            g["id"]))
    return out


def goal_order(cx):
    """(goals by priority, recorded): the kit's recorded priority (a rank,
    or focus states that differ) wins; else the user's answer in this
    consult (goal_first); else the current phase's goal first (a cut puts
    the fat goal first, a grow the muscle goal) -- an assumption, said."""
    goals = active_goals(cx)
    if len(goals) < 2:
        return goals, True
    if any(g["rank"] is not None for g in goals) or \
            len({g["focus"] for g in goals}) > 1:
        return goals, True
    first = cx.st.get("goal_first")
    if first in [g["id"] for g in goals]:
        return sorted(goals, key=lambda g: g["id"] != first), True
    phase, metric = goal_phase(cx.db)
    lead = [g for g in goals if g["metric"] == metric]
    return lead + [g for g in goals if g not in lead], False


