def cal_sample_card(cx, target, protein, res):
    """The sample diet card after the step settles: diet-status card.py with
    the settled target terms and two meals marked as samples. Returns the
    image path, or None (no renderer / no card / a render failure -- the
    say then tells the user the card could not be drawn)."""
    if os.environ.get("HEALTH_SAMPLE_CARD") == "off":
        # the walk-heavy suites skip the render (the say then says the card
        # comes with the first real record); the replay renders it
        return None
    card = diet_status_path("card.py")
    if not card or not os.path.isfile(card):
        return None
    out_dir = os.environ.get("HEALTH_OUTBOX")
    if not out_dir:
        db = os.path.abspath(cx.db)
        if os.path.basename(os.path.dirname(db)) == "database":
            out_dir = os.path.join(os.path.dirname(os.path.dirname(db)),
                                   "files", "outbox")
        else:
            out_dir = os.path.join(os.path.dirname(db), "outbox")
    out = os.path.join(out_dir, "diet_card_sample.png")
    meals = [{"type": T(slot), "name": T(name), "kcal": k, "protein": p,
              "carbs": c, "fat": f}
             for name, slot, k, p, c, f in CAL_SAMPLE_MEALS]
    m = res["maint"]
    data = {"sample": True, "title": T("cal_sample_title"),
            "date": T("cal_sample_date"), "output": out, "meals": meals,
            "intake_kcal": {"current": sum(x["kcal"] for x in meals)},
            "protein": {"current": sum(x["protein"] for x in meals)},
            "carbs": {"current": sum(x["carbs"] for x in meals)},
            "fat": {"current": sum(x["fat"] for x in meals)},
            "settled": {"target": int(target), "maintenance_mid": m["middle"],
                        "deficit": max(0, m["middle"] - int(target)),
                        "surplus": max(0, int(target) - m["middle"])}}
    if protein:
        data["protein"]["goal"] = protein
    py = os.environ.get("RENDER_PYTHON")
    if not py:
        venv = os.path.expanduser("~/dogany/.venvs/render/bin/python")
        py = venv if os.access(venv, os.X_OK) else sys.executable
    try:
        os.makedirs(out_dir, exist_ok=True)
        r = subprocess.run([py, card, json.dumps(data, ensure_ascii=False)],
                           capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError):
        return None
    if r.returncode != 0 or not os.path.isfile(out):
        cx.st.setdefault("kit_errors", []).append(
            "sample diet card: %s" % (r.stderr or "").strip()[-200:])
        return None
    return out


def cal_close(cx, receipt=None):
    """Close the step: the receipt, the meal-logging guide (with the sample
    card) and THEN the program transition ride the program's FIRST question
    (the wrap fold, A2), never a message of their own; the program line is
    never said before the calorie step is settled."""
    st = cx.st
    cal = st["calorie"]
    res = cal.get("result") or {}
    photo = None
    if receipt is None:
        if cal.get("status") == "set":
            receipt = T("cal_set", target=format(cal["target"], ","))
        elif res.get("why") == "measure_first":
            receipt = T("cal_measure_first")
        else:
            lines = cal_result_lines(cx, res) if res.get("maint") else []
            receipt = "\n".join(lines + [T("cal_unverifiable")])
    if cal.get("status") == "set":
        # settled: how to log meals, with the sample card on the real target
        receipt += "\n\n" + T("cal_meal_guide")
        if cal.get("target") and res.get("maint"):
            photo = cal_sample_card(cx, cal["target"], cal_protein(cx), res)
            receipt += "\n" + T("cal_meal_card" if photo
                                else "cal_meal_card_none")
    if cal.get("status") == "open":
        cal["status"] = "noted"
    cal["closed"] = True
    st.pop("calorie_pending", None)
    st["calorie_goal"] = calorie_goal(cx)
    cal.pop("fold", None)
    st["wrap_fold"] = {"readback": [],
                       "say": receipt + "\n\n" + T("wrap_transition")}
    if photo:
        st["wrap_fold"]["photo"] = photo
    cx.save()


def cal_write_activity(cx):
    """WRITE BEFORE SPEAK (A9): the activity facts, as answered."""
    ans = cx.st["calorie"]["answers"]
    kv = ["activity_job=%s" % ans["job"]]
    if ans.get("steps"):
        kv.append("steps_weekly_mean=%d" % ans["steps"])
    _cal_kit(cx, ["config-set"] + kv)


def cal_write_target(cx):
    """Ledger first, then the config mirror, no utterance between. The
    mirror carries the SETTLED target (calorie_target_kcal + its terms):
    the one number the diet card, the pin and the briefs read."""
    cal = cx.st["calorie"]
    res = cal["result"]
    cb = cal_band()
    neat = cb.kit_neat(res["maint"], res["bmr"])
    deficit = max(0, res["maint"]["middle"] - cal["target"])
    surplus = max(0, cal["target"] - res["maint"]["middle"])
    key, val = ("surplus_kcal", surplus) if surplus else \
        ("deficit_kcal", deficit)
    # audit fix 4: the ledger row is the target; a refused ledger write
    # stops here -- no config copy of a target the ledger does not hold
    if not _cal_kit(cx, ["constraint-add", "--class", "nutrition", "--key",
                         key, "--value", str(val), "--source", "interview"]
                    + anchor_args("calorie.%s" % key)):
        cx.st.setdefault("kit_errors", []).append(
            "calorie target not stored: the ledger write failed, so the "
            "config copy was not written")
        return False
    protein = (cal.get("existing") or {}).get("protein_g")
    if protein is not None:
        if not _cal_kit(cx, ["constraint-add", "--class", "nutrition",
                             "--key", "protein_g", "--value", str(protein),
                             "--source", "interview"]
                        + anchor_args("calorie.protein_g")):
            return False
        if not _cal_kit(cx, ["config-set", "protein_g=%d" % protein]):
            return False
    m = res["maint"]
    src = res.get("bmr_src") or {}
    if not _cal_kit(cx, ["config-set", "deficit_kcal=%d" % deficit,
                  "surplus_kcal=%d" % surplus,
                  "avg_steps=%d" % neat["avg_steps"],
                  "other_neat_kcal=%d" % neat["other_neat_kcal"],
                  "maintenance_low=%d" % m["low"],
                  "maintenance_high=%d" % m["high"],
                  "maintenance_mid=%d" % m["middle"],
                  "maintenance_basis=start_estimate",
                  "calorie_target_kcal=%d" % cal["target"],
                  "calorie_bmr=%d" % int(round(res["bmr"])),
                  "calorie_bmr_source=%s" % (src.get("kind") or "katch"),
                  "calorie_set_on=%s" % cx.today.isoformat()]):
        return False
    if cx.side_effects:
        _modules_set(cx, "done@" + cx.today.isoformat())
    cx.st["tail_diet"] = False
    return True


def apply_calorie(cx, stage, payload):
    st = cx.st
    cal = st.get("calorie") or {}
    if cal.get("status") != "open":
        raise Refused("E-STAGE\t%s\tno calorie question is open (use next)"
                      % stage)
    want = cal_open_step(cal)
    sub = stage.split(":", 1)[1] if ":" in stage else want
    if sub != want:
        raise Refused("E-STAGE\t%s\topen step is calorie:%s" % (stage, want))
    ans = cal["answers"]
    if sub == "existing":
        pick = _pick(payload, ("keep", "adjust"))
        protein = payload.get("protein")
        if protein is not None:
            if isinstance(protein, bool) or not isinstance(protein, (int, float)) \
                    or not 1 <= protein <= 500:
                raise Refused("E-PROTEIN\tprotein\tthe user's daily protein g (1-500)")
            cal["existing"]["protein_g"] = int(protein)
        res = cal.get("result") or {}
        cal.pop("fold", None)
        if pick == "keep" and res.get("kind") == "propose":
            # the kept setting, on today's body: the gated target off the
            # band's middle is what is settled (and what the card reads)
            cal["target"] = int(res["target"])
            if not cal_write_target(cx):
                return
            cal["status"] = "set"
            cal["existing_answered"] = True
            cal_close(cx)
        elif pick == "keep":
            # no number on record to recompute (measure-first / gate):
            # explicit reconfirmation, ledger first, then its config mirror
            for key, value in cal["existing"].items():
                if not _cal_kit(cx, ["constraint-add", "--class", "nutrition",
                                     "--key", key, "--value", str(value),
                                     "--source", "interview"]
                                + anchor_args("calorie.%s" % key)):
                    return
            if not _cal_kit(cx, ["config-set"] + ["%s=%s" % item
                              for item in cal["existing"].items()]):
                return
            cal["status"] = "set"
            cal["existing_answered"] = True
            st["tail_diet"] = False
            _modules_set(cx, "done@" + cx.today.isoformat())
            cal_close(cx, receipt=T("cal_existing_kept"))
        else:
            cal["existing_answered"] = True
            if res.get("kind") == "propose":
                cal["adjusting"] = True
            elif res:
                cal_close(cx)
        return
    if sub == "job":
        ans["job"] = _pick(payload, CAL_JOB_PICKS)
        cal.pop("fold", None)
    elif sub == "watch":
        p = _pick(payload, ("link", "none"))
        ans["watch"] = p
        if p == "link":
            _cal_kit(cx, ["config-set", "watch_link=linked",
                          "watch_import=%s"
                          % ",".join(cal_band().WATCH_IMPORT_KINDS)])
        else:
            _cal_kit(cx, ["config-set", "watch_link=none"])
    elif sub == "steps":
        p = _pick(payload, CAL_STEP_PICKS)
        if p == "said":
            n = cal_band().parse_steps(payload.get("steps"))
            if not n or n > 60000:
                raise Refused("E-STEPS\tsteps\tthe user's daily step count "
                              "(1-60000)")
            ans["steps"] = n
        elif p == "unknown":
            ans["steps"] = None
        else:
            ans["steps"] = cal_band().STEP_PICKS[p]
        ans["steps_pick"] = p
        cal_after_steps(cx)
    else:
        res = cal["result"]
        if cal.get("adjusting"):
            p = "set"
        else:
            p = _pick(payload, ("ok", "adjust"))
        kcal = payload.get("kcal")
        if p == "adjust" and not isinstance(kcal, (int, float)):
            cal["adjusting"] = True
            return
        if p in ("adjust", "set"):
            if isinstance(kcal, bool) or not isinstance(kcal, (int, float)) \
                    or not 800 <= kcal <= 6000:
                raise Refused("E-KCAL\tkcal\tthe user's daily kcal (int)")
            gate = calorie_gate()
            deficit = max(0, res["maint"]["middle"] - int(kcal))
            v = gate.evaluate(deficit, int(kcal), res["bmr"],
                              config_value(cx.db, "sex"), db_path=cx.db)
            if v["verdict"] == "unverifiable":
                cal["adjusting"] = False
                cal_close(cx, receipt=T("cal_unverifiable"))
                return
            target = gate.permitted_base(v, int(kcal), deficit)
            if target != int(kcal):
                # hoisted / capped: the refracted number is the proposal,
                # with the gate's own line (G6-b) -- asked again, not set
                res.update(target=int(target), why=cal_why(gate, v, target),
                           deficit=max(0, res["maint"]["middle"]
                                       - int(target)),
                           surplus=max(0, int(target)
                                       - res["maint"]["middle"]))
                cal["adjusting"] = False
                return
            res.update(target=int(kcal), why="",
                       deficit=max(0, res["maint"]["middle"] - int(kcal)),
                       surplus=max(0, int(kcal) - res["maint"]["middle"]))
        cal["adjusting"] = False
        cal["target"] = int(res["target"])
        if not cal_write_target(cx):
            return
        cal["status"] = "set"
        cal_close(cx)


# ---------------------------------------------------------------------------
# the state machine -- ONE journey, declared once
# ---------------------------------------------------------------------------
# The onboarding journey (owner-approved 2026-09-26 23:03; JOURNEY.md 1장 +
# AMENDMENTS A1-A8), in the order the user decides things. `next` walks this
# tuple and nothing else; an answer for a stage while an earlier one is still
# open is refused (E-STAGE); tests/test-journey-order.py reads the SAME
# tuple. The goal part (G1-G8) is the kit's move loop -- its own order is the
# kit's GOAL_JOURNEY, pinned by the same test.
#   goal        G1-G8, the kit's moves passed through; the wrap message ends
#               on the program's first question (A2)
#   safety      fallback only: the kit asks it inside the goal part (G4)
#   calorie     G3 inside the goal part (owner 2026-10-08): the job, the
#               watch link, the steps, then the range + target (G6-gated);
#               the wrap folds into its first question, its receipt into
#               the program's first question
#   place       from records, stated on the card; asked when unknown/unnamed
#   frequency   the program's first question, the dose: the weekly count
#               (3 options) and ONE day-total recommended (owner 2026-10-02)
#   daytime     A4 open question naming the dose: base + extra days with
#               windows, one pass
#   reconcile   each day's window against the day-total: all fit -> one
#               line; a day short -> cardio to the supplementary day /
#               shorter strength / one more day (time_plan)
#   measure     after the schedule, on a training day: stated or one confirm
#   experience  read from the kit (G3); asked only without it
#   split       three structurally different options
#   focus       stated in a cut phase; a decision otherwise
#   emphasis    only when a focus area meets a safety site
#   compose     model lane, silent
#   field       a lift no dose rule covers
#   swaps       confirm safety changes, with optional individual review
#   cardio      the type, before preview so it appears in execution order;
#               the minutes are the reconcile's
#   sessions    all sessions, one confirm
#   done        write, archive the old plan, replace the calendar, close
JOURNEY = ("goal", "safety", "calorie", "place", "frequency", "daytime", "reconcile",
           "measure",
           "experience",
           "split", "focus", "emphasis", "compose", "field", "swaps",
           "cardio", "sessions", "done")
# Stages that speak with no proposal in front of them (the only open value
# questions): the daytime (A4) and the gym's name. The kit's fact asks are
# the kit's _FACT_ASKS.
FACT_ASKS = ("daytime", "daytime:end", "daytime:range", "daytime:start",
             "daytime:when", "daytime:confirm", "place:gym_name",
             "reconcile:day")
# A stage asked INSIDE an earlier one (the pack's safety / experience
# questions stand in for the kit's inside the goal part).
ASKED_INSIDE = {"safety": "goal", "experience": "goal"}
# A move that stands in for a journey stage (no lift fits the place: the
# compose step asks for the place again).
STAGE_ALIAS = {"blocked": "compose", "calendar_existing": "daytime"}


def _stage_goal(cx):
    return stage_goal(cx)


def _stage_safety(cx):
    if cx.st.get("safety") and not safety_stale(cx):
        return None
    return stage_safety(cx)


def _stage_place(cx):
    st = cx.st
    if not st.get("place") and not st.get("place_reask"):
        place_from_record(cx) or place_from_handoff(cx)
    if not st.get("place"):
        return stage_place(cx)
    p = st["place"]
    if p.get("venue") == "gym" and not p.get("place_id") and \
            not p.get("place_near") and (p.get("name") or p.get("label")):
        # a gym known by name (answered, or read from the records): it is
        # a kit place before the plan puts it on the routines
        link_gym_place(cx, p)
    if place_open(cx):
        return stage_place(cx)
    if st.get("tools_due"):
        # right after the user answered or confirmed the place, never
        # before it: a place read silently from records is not a question,
        # so its tools are not either (the prep keeps the one swap line)
        if tools_pending(st):
            return stage_tools(cx)
        st.pop("tools_due")
        cx.save()
    return None


TOOL_PICKS = ("gym_band", "carry_band", "none", "unknown", "words")


def tools_pending(st):
    """The small-tool question is open: a gym, a caution site whose prep it
    decides, and no tool record for this gym yet (asked once per place; the
    user's carried tools are kept across places). `next` asks it only when
    the place step spoke (tools_due)."""
    p = st.get("place") or {}
    if not st.get("safety_items") or p.get("venue") != "gym":
        return False
    return place_key(p) not in ((st.get("tools") or {}).get("place") or {})


def stage_tools(cx):
    return pmove(cx, "ask", "place:tools", say=T("tools_ask"),
                 choices=[choice("gym_band", T("c_tools_gym_band")),
                          choice("carry_band", T("c_tools_carry_band")),
                          choice("none", T("c_tools_none")),
                          choice("unknown", T("c_tools_unknown"))],
                 answer={"stage": "place", "payload": {
                     "tools": " | ".join(TOOL_PICKS),
                     "words": "on words: the user's words as said",
                     "gym": "optional: list from %s" % ", ".join(
                         _care_policy()["small_tools"]),
                     "carry": "optional: list from %s" % ", ".join(
                         _care_policy()["small_tools"])}})


def parse_tools(words):
    """(gym tools, carried tools) from a free answer: per clause, a carry
    word makes its tools the user's, else the gym's."""
    pol = _care_policy()
    gym, carry = [], []
    for clause in re.split(r"[,.;/\n]|(?<=\uc788\uace0)\s|(?<=\uc5c6\uace0)\s|\sand\s",
                           str(words or "")):
        found = [t for t, pat in pol["tool_words"].items()
                 if re.search(pat, clause, re.IGNORECASE)]
        if "mini_band" in found and "band" in found and not re.search(
                pol["tool_words"]["band"], re.sub(pol["tool_words"]["mini_band"],
                                                   "", clause, flags=re.I), re.I):
            found.remove("band")
        if re.search(pol["tool_none_words"], clause, re.IGNORECASE) and not \
                re.search(r"\uc788", clause):
            continue
        dest = carry if re.search(pol["tool_carry_words"], clause,
                                  re.IGNORECASE) else gym
        for t in found:
            if t not in dest:
                dest.append(t)
    return gym, carry


def apply_tools(st, payload):
    pick = payload.get("tools")
    if pick not in TOOL_PICKS:
        raise Refused("E-PICK\ttools\texpected one of %s, got %r"
                      % ("|".join(TOOL_PICKS), pick))
    known = set(_care_policy()["small_tools"])
    gym, carry = {"gym_band": (["band"], []), "carry_band": ([], ["band"]),
                  "none": ([], []), "unknown": ("unknown", "unknown")}.get(
                      pick, (None, None))
    if pick == "words":
        gym, carry = parse_tools(payload.get("words"))
    for key in ("gym", "carry"):
        if isinstance(payload.get(key), list):
            if any(t not in known for t in payload[key]):
                raise Refused("E-TOOLS\t%s\tlist from %s"
                              % (key, ", ".join(sorted(known))))
            if key == "gym":
                gym = list(payload[key])
            else:
                carry = list(payload[key])
    rec = st.setdefault("tools", {})
    rec.setdefault("place", {})[place_key(st.get("place"))] = gym
    st.pop("tools_due", None)
    old = rec.get("carry")
    if isinstance(carry, list) and isinstance(old, list):
        carry = list(dict.fromkeys(old + carry))
    if isinstance(carry, list) or not isinstance(old, list):
        rec["carry"] = carry


def _stage_frequency(cx):
    st = cx.st
    if st.get("frequency"):
        return None
    if st.get("daytime"):
