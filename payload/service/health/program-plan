def land_extra_windows(cx, dt):
    """The extra / makeup days as kit availability windows; the answer is
    the whole set (the first write replaces the old ones; none -> the old
    ones are retired). A start-only window ends a session length later
    (said in the row's note)."""
    wins = dt.get("extra_windows") or []
    live = getattr(cx, "side_effects", True) and kit_anchor_ready()
    if not wins:
        for w in (kit_json(["availability-list", "--domain", ANCHOR_DOMAIN,
                            "--json"]) or [] if live else []):
            kit_land(cx, ["availability-retire", str(w["id"])],
                     "extra_days")
        return
    total = int((cx.st.get("time_plan") or {}).get("total")
                or cx.st.get("available_minutes") or 60)
    for i, w in enumerate(wins):
        args = ["availability-add", "--domain", ANCHOR_DOMAIN, "--days",
                ",".join(w["weekdays"]), "--source", "program"]
        start, end = w.get("start"), w.get("end")
        if start and not end:
            h, m = (int(x) for x in start.split(":"))
            mins = min(h * 60 + m + total, 23 * 60 + 59)
            end = "%02d:%02d" % divmod(mins, 60)
            args += ["--note", "end=start+%dmin" % total]
        args += (["--from", start, "--to", end] if start else ["--anytime"])
        if i == 0:
            args.append("--replace")
        kit_land(cx, args + anchor_args("extra_days"), "extra_days")


# -- the kit side missing (root cause 2026-10-13 B) ----------------------------
# The answers above landed only when they CHANGED. Answers given before the
# 074 verbs existed (2026-10-09) sat in plan state while the kit stayed
# empty, and re-answering the same words wrote nothing. The condition is the
# kit side: an answer in plan state whose kit row is missing is written on
# the next consult call. Once written there is nothing missing, so a second
# run writes nothing.
def _kit_care(cx, key):
    """The active safety row's structured care (list), [] when empty, or
    None when the row is missing."""
    rows = _q(cx.db, "SELECT care FROM ledger_constraint WHERE "
                     "class='safety' AND status='active' AND key=? "
                     "ORDER BY id DESC LIMIT 1", (key,))
    if not rows:
        return None
    try:
        care = json.loads(rows[0][0] or "null")
    except (TypeError, ValueError):
        care = None
    return care if isinstance(care, list) else []


def _kit_gym_place_missing(name):
    """True when the kit's active env resource named `name` is missing or
    has no place_id; False when it has one or the list is unread."""
    rows = kit_json(["resource-list", "--kind", "env", "--json"])
    if not isinstance(rows, list):
        return False
    rows = [r for r in rows if r.get("name") == name]
    return not rows or not rows[-1].get("place_id")


def extra_days_missing(cx, dt):
    """The answer holds extra windows and the kit holds no active one."""
    if not dt.get("extra_windows") or not getattr(cx, "side_effects", True) \
            or not kit_anchor_ready():
        return False
    return kit_json(["availability-list", "--domain", ANCHOR_DOMAIN,
                     "--json"]) == []      # None = unread: not missing


def kit_backfill(cx):
    """Write each consult answer whose kit side is missing: extra windows
    with no active availability window, a safety item's care with an empty
    care column, the gym's kit place with an empty place_id. Returns the
    names written ([] = nothing missing)."""
    if not getattr(cx, "side_effects", True) or not kit_anchor_ready():
        return []
    st = cx.st
    done = []
    dt = st.get("daytime") or {}
    if extra_days_missing(cx, dt):
        land_extra_windows(cx, dt)
        done.append("extra_days")
    for it in st.get("safety_items") or []:
        if not it.get("site"):
            continue
        key = _injury_key(it)
        if _kit_care(cx, key) != []:
            continue        # filled, or no kit row to hold it
        if not care_drills(it, None):
            continue        # nothing to write: a write would stay empty
        if kit_note_care(cx, it, None):
            done.append("care.%s" % key)
    p = st.get("place") or {}
    name = p.get("name") or p.get("label")
    if p.get("venue") == "gym" and p.get("place_id") and name \
            and _kit_gym_place_missing(name):
        if land_gym(cx, p):
            done.append("gym")
    return done


