def first_move(cx):
    first = cx.st["structure"]["rotation"][0]
    if (cx.st.get("first_session") or {}).get("pick") == "other":
        return move("ask", "first", say=T("first_other_ask"),
                    answer={"stage": "first", "payload": {
                        "pick": "other", "date": "YYYY-MM-DD",
                        "time": "HH:MM when said"}})
    opts = first_options(cx)
    d, start = opts["next"]
    key = ("first_next_tomorrow" if d == cx.today + datetime.timedelta(days=1)
           else "first_next")
    lines = [T("first_head"), T(key, when=_day_when(d, start), first=first)]
    choices = [tail_choice("next", T("first_c_next"), True)]
    if opts["tomorrow"]:
        tom, tstart = opts["tomorrow"]
        lines.append(T("first_tomorrow",
                       day=UL.weekday_full(UL.WEEKDAY_ORDER[tom.weekday()]),
                       clock="(%s)" % spoken_clock(tstart) if tstart else ""))
        choices.append(tail_choice("tomorrow", T("first_c_tomorrow")))
    choices.append(tail_choice("other", T("first_c_other")))
    lines.append(T("first_ask"))
    return move("ask", "first", say="\n".join(lines), choices=choices,
                answer={"stage": "first", "payload": {
