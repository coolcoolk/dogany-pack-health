def program_card(cx, now=None, stage=None):
    """The program card: the title line, then one line per slot, filled from
    the plan state, the slot asked now in bold. One renderer for every
    program message and the closing one."""
    st = cx.st
    val = {"goal": handoff_goal_line(cx),
           "place": card_place(st.get("place")),
           "frequency": card_frequency(st),
           "daytime": card_daytime(st.get("daytime")),
           "measure": card_measure(st),
           "split": card_split(st),
           "focus": card_focus(cx),
           "safety": card_safety(st, safety_card_phrase(cx)),
           "sessions": card_sessions(st, stage),
           "extra": card_extra(st.get("daytime")),
           "cardio": ("%s %d분" % (st["cardio"]["display"],
                                      st["cardio"]["minutes"])
                      if st.get("cardio") else None)}
    lines = [T("card_title")]
    for slot in CARD_SLOTS:
        if slot in ("safety", "goal") and not val[slot]:
            continue
        if val[slot]:
            key = "card_line_now" if slot == now else "card_line"
        else:
            key = "card_line_now_empty" if slot == now else "card_line_empty"
        lines.append(T(key, name=T("card." + slot), value=val[slot]))
    return "\n".join(lines)


# Side questions inside a step (a lift's starting amount, protecting a sore
# area) do not carry the statements queued for the next decision message.
NOTE_SKIP = ("field", "emphasis", "cardio", "swaps")
# A note that answers the step just before and means nothing past a given
# step: the reconcile's "every window holds the day" line answers the days;
# the split screen opens on its own lead, so the line is dropped there
# (owner 2026-10-06 10:16) rather than carried onto it. Matched by key, or
# by text for a note queued before the key existed.
NOTE_NOT_AT = {"rc_fits": ("split",)}


def pmove(cx, kind, stage, **kw):
    """A program move: the card opens it (last readback line), then the
    one-time notes queued for the first program message after a decision
    (the measure day, the queue explanation, the focus statement).

    The FIRST program question rides the goal wrap instead (A2): ONE message
    = the goal card, the wrap line + transition line, a blank line, the
    question -- no program card; the card opens from the next message. The
    fold stays until that question is answered, so a repeated `next`
    renders the same message."""
    base = stage.split(":")[0]
    notes = []
    for n in cx.st.get("notes") or []:
        if n.get("at") in (None, base) and any(
                base in at and (n.get("key") == key or n.get("text") == T(key))
                for key, at in NOTE_NOT_AT.items()):
            n["at"] = "dropped"
            cx.save()
            continue
        if n.get("at") is None and base not in NOTE_SKIP:
            n["at"] = base
            cx.save()
        if n["at"] == base:
            notes.append(n["text"])
    rb = list(kw.pop("readback", None) or [])
    say = kw.pop("say", None)
    fold_card = kw.pop("fold_card", False)
    if notes and say:
        say = "\n\n".join(notes + [say])
    fold = cx.st.get("wrap_fold")
    if fold and say:
        if fold_card:
            # a slot filled from the goal part is stated on the card, so the
            # card opens on this first question (owner rehearsal 2026-10-01)
            say = program_card(cx, STAGE_SLOT.get(base)) + "\n\n" + say
        if fold.get("photo"):
            # the sample diet card after the calorie step (send_file::)
            pk = photo_kw(fold["photo"])
            kw.setdefault("photo", pk["photo"])
            kw["for_model"] = " ".join(
                x for x in (kw.get("for_model"), pk["for_model"]) if x)
        return move(kind, stage, say=fold["say"] + "\n\n" + say, card=None,
                    readback=list(fold.get("readback") or []) + rb, **kw)
    lead = cx.st.get("lead")
    if lead and say:
        # restart --from program: the one restart line, then the question
        # (no card either: it opens from the next message, as after a wrap)
        return move(kind, stage, say=lead + "\n" + say, card=None,
                    readback=rb, **kw)
    card = program_card(cx, STAGE_SLOT.get(base), base)
    return move(kind, stage, say=say, card=card, readback=rb + [card], **kw)


