def floor_why(phase):
    """'<goal phrase> 부위마다 주 N번씩 하는 게 좋아요.' -- the goal's region
    frequency floor (split_model rules) in the owner's words; one sentence
    for the count and the split screens."""
    import split_model
    phase = phase if phase in ("cut", "grow", "maintain") else "maintain"
    return T("goal_floor_why", goal=T("goal_why_" + phase),
             floor=split_model.rules()["frequency_floor"][phase])


def stage_split(cx):
    import split_model
    opts, rec_src = split_options(cx)
    model = cx.st["split_model"]
    if any(row['triage'] for row in model['constraints']['intensity'].values()):
        cx.st.pop('split_offer', None)
        cx.save()
        return pmove(cx, 'handoff', 'split',
                     say=split_model.care_text(model, globals()).strip()
                         + T('care_pain_resume'),
                     handoff_skill='pain-triage')
    n = len(cx.st["daytime"]["weekdays"])
    built = [o for _k, o in opts if o["facts"]]
    lead = T("split_lead", n=n, floor_why=floor_why(model["goal"]["phase"]))
    if len(built) >= 2:
        lead += T("sm_compare", count=T("count_%d" % len(opts)))
    # a site cared for by prep alone does not change the split: said once
    lead += split_model.care_text(model, globals())
    lines = [lead, ""]
    rows = split_model.option_lines(opts, model, globals())
    rec = rec_src == "model"
    choices = []
    for i, (k, o) in enumerate(opts, 1):
        title = split_model.title(k, globals())
        # ONE quote block per option (owner 2026-10-06 17:02, approved by
        # sample): the title, the "[day] session" line, the bullets that
        # differ, the bundle sentence; no folded stats, no separate caution
        # section, no calendar grid
        lines += [UL.i18n("health.plan.cal_quote", line=ln) for ln in
                  [T("opt_title", n=i, title=title + (REC if i == 1 and rec else ""))]
                  + rows[k]]
        lines.append("")
        # marked in the body only, never in the button label
        choices.append(dict(choice(k, title), recommended=i == 1 and rec))
    lines += split_reason(cx, opts, rec_src)
    lines.append(T("sm_ask"))
    cx.st["split_offer"] = {k: o for k, o in opts}
    cx.save()
    return pmove(cx, "decide", "split", say="\n".join(lines),
                 choices=choices, recommend=opts[0][0] if rec else None,
                 handoff_skill=('pain-triage' if any(
                     r['triage'] for r in model['constraints']['intensity'].values()) else None),
                 narrowed=len(opts) < 3,
                 decision_axis="simple<->expressive",
                 answer={"stage": "split", "payload": {
                     "pick": " | ".join([k for k, _o in opts] + ["other"]),
                     "rotation": "on other: the session names the user "
                                 "wants, in order (<= 16 chars each, no "
                                 "spaces)"}},
                 options=[{"pick": k, "rotation": o["rotation"],
                           "weekdays": o["weekdays"]} for k, o in opts])


def queue_note(cx):
    """What the split means for the week, said ONCE (owner 17:29): sessions
    are a queue over the training days, a missed day shifts it, an extra day
    is a makeup session that does not consume it (the rotation-current +
    makeup machinery already works that way)."""
    rot = cx.st["structure"]["rotation"]
    extra = (cx.st.get("daytime") or {}).get("extra") or []
    tail = (T("queue_extra", days=UL.days_phrase_ko(extra)) if extra
            else T("queue_no_extra"))
    return T("queue", order=" → ".join(rot)) + " " + tail


