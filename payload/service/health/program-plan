# the user's words for the count and the minutes ("4 times 60 min",
# "4 times an hour"); native Korean numbers one..seven, escaped
NATIVE_NUM = {"\ud55c": 1, "\ub450": 2, "\uc138": 3, "\ub124": 4,
              "\ub2e4\uc12f": 5, "\uc5ec\uc12f": 6, "\uc77c\uacf1": 7}
_NATIVE = "|".join(sorted(NATIVE_NUM, key=len, reverse=True))
# (week) N (times | days)
COUNT_WORDS = re.compile(r"(?:\uc8fc\s*)?(\d|%s)\s*(?:\ud68c|\ubc88|\uc77c(?!\w))"
                         % _NATIVE)
# N hour(s) [half | M minutes]
HOUR_WORDS = re.compile(r"(\d+(?:\.\d+)?|%s)\s*\uc2dc\uac04"
                        r"(?:\s*(\ubc18|\d+\s*\ubd84))?" % _NATIVE)
HALF = "\ubc18"
# N minutes
MINUTE_WORDS = re.compile(r"(\d+)\s*\ubd84")


def _num(word):
    return NATIVE_NUM[word] if word in NATIVE_NUM else float(word)


def parse_count_minutes(words):
    """(count | None, minutes | None) read from the user's words."""
    text = str(words or "")
    minutes = None
    h = HOUR_WORDS.search(text)
    if h:
        minutes = _num(h.group(1)) * 60
        tail = h.group(2) or ""
        minutes += 30 if tail == HALF else int(re.sub(r"\D", "", tail) or 0)
        text = text[:h.start()] + " " + text[h.end():]
    else:
        m = MINUTE_WORDS.search(text)
        if m:
            minutes = int(m.group(1))
            text = text[:m.start()] + " " + text[m.end():]
    c = COUNT_WORDS.search(text)
    count = int(_num(c.group(1))) if c else None
    return count, (int(round(minutes)) if minutes is not None else None)


def _int(raw):
    try:
        return None if isinstance(raw, bool) or raw in (None, "") \
            else int(raw)
    except (TypeError, ValueError):
        return None


def parse_frequency(payload):
    """(count | None, minutes | None). A button pick is the count alone;
    on other, the numbers the agent read, else the user's words. Refused
    when neither is there or one is out of range."""
    p = payload.get("pick")
    other = p in (None, "other")
    words_n, words_m = parse_count_minutes(payload.get("words"))
    n = _int(payload.get("count") if other else p)
    if n is None and other:
        n = words_n
    m = _int(payload.get("minutes"))
    if m is None:
        m = words_m
    if n is None and m is None or n is not None and not (
            FREQ_MIN <= n <= FREQ_MAX):
        raise Refused("E-FREQUENCY\t%s\ta weekly count %d..%d"
                      % ("count" if other else "pick", FREQ_MIN, FREQ_MAX))
    if m is not None and not (SESSION_MIN <= m <= SESSION_MAX):
        raise Refused("E-FREQUENCY\tminutes\tminutes a day %d..%d"
                      % (SESSION_MIN, SESSION_MAX))
    return n, m


# -- daytime (round 3: ONE slot, the days and times; after the weekly count) --
def local_calendar_stamp(raw):
    """UTC kit block timestamp as the owner's Seoul calendar time."""
    stamp = datetime.datetime.fromisoformat(str(raw).replace("Z", "+00:00"))
    if stamp.tzinfo is None:
        stamp = stamp.replace(tzinfo=datetime.timezone.utc)
    return stamp.astimezone(datetime.timezone(datetime.timedelta(hours=9)))


def existing_calendar_items(cx):
    """All active health routines and future manual or migrated blocks."""
    items = []
    for kind in ("exercise", "measure"):
        for routine in calendar_routines(cx.db, kind):
            items.append(dict(routine, source="routine", kind=kind))
    # Blocks generated by an active routine are represented by its rule.
    # Manual and migrated occurrences with no active routine remain separate.
    active_recurrences = {x.get("recurrence_id") for x in items if x.get("recurrence_id")}
    for rid, title, start_at, end_at, kind, status, recurrence in _q(
            cx.db, "SELECT id,title,start_at,end_at,kind,status,recurrence_id "
                   "FROM timeblock WHERE substr(start_at,1,10)>=? "
                   "AND status IN ('open','scheduled') ORDER BY start_at",
            ((cx.today - datetime.timedelta(days=1)).isoformat(),)):
        if recurrence in active_recurrences or not (
                EXERCISE_WORDS.search(title or "") or
                MEASURE_WORDS.search(title or "")):
            continue
        try:
            if local_calendar_stamp(start_at).date() < cx.today:
                continue
        except (ValueError, TypeError):
            continue
        category = "measure" if MEASURE_WORDS.search(title or "") else "exercise"
        items.append({"id": rid, "title": title, "start_at": start_at,
                      "end_at": end_at, "source": "block", "kind": category,
                      "block_kind": kind})
    return items


def existing_calendar_move(cx, items):
    lines = ["캘린더에 기존 운동 일정이 이렇게 있었네요."]
    for item in items[:12]:
        if item["source"] == "routine":
