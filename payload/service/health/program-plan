def answers_doc(cx, fd, provisional=False):
    """The program-init answers doc. provisional: a lift whose dose is still
    to be asked (a `field`) counts at the rule's set floor, so the volume fit
    can run before that question."""
    doc = {"rotation": list(cx.st["structure"]["rotation"]),
           "weekly_frequency": len(cx.st["days"]["weekdays"]),
           "days": {}}
    if cx.st.get("focus_areas"):
        kept = compose_focus(cx)
        if kept:
            doc["focus_areas"] = kept
    if cx.st.get("care"):
        doc["care"] = care_for_card(cx.st["care"])
    style, spec = set_style_spec(cx)
    if cx.st.get("set_style"):
        doc["set_style"] = style
    if (cx.st.get("time_plan") or {}).get("pick") == "shrink":
        import compose_rank
        timing = compose_rank.time_budget(cx, _minutes)
        blocks = timing["strength"] - timing["lift_minutes"]
        doc["time_plan"] = dict(cx.st["time_plan"], lift_minutes={
            day: max(0, cap - blocks)
            for day, cap in timing["per_day"].items()})
    for code in doc["rotation"]:
        exs = []
        for ex in fd[code]:
            d, _w = dose(cx, ex["name"])
            if d is None and provisional:
                d = {"sets": RX_RULES["compound"]["sets"],
                     "rep_range": [1, 1], "unit": "reps"}
            slot = {"name": ex["name"], "display": ex["display"],
                    "weight_kg": history_weight(cx.db, ex["name"]),
                    "sets": sets_for(cx, code, ex["name"], d["sets"]),
                    "rep_range": d["rep_range"]}
            if d["unit"] == "sec":
                slot["progression"] = "hold"
            elif (spec or {}).get("rir_target") and not g19_class(cx, ex["name"]):
                # the style's working effort (rules set_style rir_target); a
                # G19 compound freeweight keeps its own band (rir-floor.md)
                slot["rir_target"] = list(spec["rir_target"])
            if ex.get("safety_note"):
                slot["safety_note"] = ex["safety_note"]
            exs.append(slot)
        doc["days"][code] = {"exercises": exs}
    return doc


def history_weight(db_path, name):
    """Most recent recorded working load for this exact catalog lift.

    A workout note or a different exercise is not load evidence. Older kit
    databases may have no workout_sets table, in which case calibration is
    explicit in the session flow.
    """
    key = ("history_weight", os.path.abspath(db_path), name)
    stamp = _db_stamp(db_path)
    hit = _READS.get(key)
    if hit is not None and hit[0] == stamp:
        return hit[1]
    try:
        conn = sqlite3.connect('file:%s?mode=ro' % db_path, uri=True)
        try:
            row = conn.execute(
                "SELECT s.weight_kg FROM workout_sets s JOIN workouts w "
                "ON w.id=s.session_id WHERE s.exercise_name=? "
                "AND s.set_seq>=1 AND s.weight_kg IS NOT NULL "
                "ORDER BY w.date DESC, s.session_id DESC, s.set_seq DESC "
                "LIMIT 1", (name,)).fetchone()
        finally:
            conn.close()
    except sqlite3.Error:
        return None
    _READS[key] = (stamp, row[0] if row else None)
    return row[0] if row else None


def run_audit(cx, doc):
    im = init_mod()
    program, _n = im.derive_program(doc, cx.facts())
    rx = im._load_rx()
    return rx.volume_audit(program, cx.db, cx.today.isoformat())


def volume_violations(audit):
    out = []
    for m, e in sorted((audit.get("per_muscle") or {}).items()):
        if e.get("verdict") in ("below_floor", "above_ceiling"):
            out.append((m, e))
    return out


def dose_violations(audit):
    """The PROGRAM's own out-of-band muscles: proposed weekly sets against
    the band. The audit's actual-delivery floor (what the records show) is
    not the new program's to fix and is left to the weekly review."""
    out = []
    for m, e in sorted((audit.get("per_muscle") or {}).items()):
        if e.get("verdict") == "untrained":
            continue
        n, band = e["proposed_weekly_sets"], e["band"]
        if n < band["floor"] or n > band["ceiling"]:
            out.append((m, e))
    return out


def fit_volume(cx, fd):
    """Round-robin +/-1 set on the slots whose PRIMARY muscle is short/over,
    inside [set level, MAX_SETS_FIX] and inside the session's lift minutes
    (a set is never added past the user's session length), re-auditing
    after each step. Returns (set_adjust, still_out_of_band, capped): capped
    = the short muscles held below the floor only by the session minutes."""
    import compose_rank
    mmap = cx.muscle_map()
    base = dict(cx.st.get("set_adjust") or {})
    adjust = dict(base)
    viol = []
    floor_sets = set_level(cx)
    ranked = compose_rank.for_context(cx, candidates(cx), globals())
    rules = compose_rank.load_rules()
    catalog = {c["name"]: compose_rank.enrich(c) for c in candidates(cx)}
    doses = {ex["name"]: dose(cx, ex["name"])[0]
             for items in fd.values() for ex in items}
    practice_only = compose_rank.practice_only_names(rules)
    credit = compose_rank.muscle_credit_table(rules)
    keep = list((cx.st.get("time_plan") or {}).get("keep") or ())
    # trainer fit: each session's first (primary) compound keeps a working
    # dose; its minutes were reserved in the lift budget (for_context)
    # -- every MAIN lift (the first compound of each region, lift_kinds),
    # not the first lift alone (owner 2026-10-06 21:04: 상체A's bench and
    # shoulder press sat at 2 sets under a "메인 3~4세트" line); the draft
    # reserved their minutes (compose_rank.main_reserve)
    floors = {}
    # a trained lifter's mains keep the experience floor on any path at
    # the floor's set level (rules experience_set_floor, owner 2026-10-06
    # 21:31); a level below it is the last resort of a window too short
    # for the floor, where the rules as before apply
    exp_floor = compose_rank.set_floor(
        compose_rank.experience_facts(cx, config_value), rules)
    if exp_floor and floor_sets < exp_floor["accessory_min_sets"]:
        exp_floor = None
    # the set style's caps (rules set_style, owner 2026-10-07): under a
    # style that caps the slots (intensity: mains 3, the rest 2) a weekly
    # floor the capped sets cannot reach is refused (E-VOLUME-FLOOR), so the
    # draft keeps / adds a lift -- never a set past the cap
    caps = {}
    trainer_primary = (cx.st.get("trainer_fit") or {}).get("primary")
    if trainer_primary or exp_floor:
        primary_min = max(rules["trainer_fit"]["primary_min_sets"]
                          if trainer_primary else 0,
                          (exp_floor or {}).get("main_min_sets", 0))
        if (exp_floor or {}).get("primary_min_sets") is not None:
            primary_min = max(exp_floor["primary_min_sets"],
                              exp_floor.get("main_min_sets", 0))
        for code in cx.st["structure"]["rotation"]:
            items = fd.get(code) or []
            for ex, kind in zip(items, lift_kinds(cx, items)):
                c = catalog.get(ex["name"], {})
                if (kind == KIND_MAIN and "compound" in c.get("tags", ())
                        and lift_region(cx, ex["name"]) != "core"
                        and ex["name"] not in practice_only
                        and doses[ex["name"]]["unit"] != "sec"):
                    k = "%s/%s" % (code, ex["name"])
                    floors[k] = max(floor_sets, primary_min)
                    adjust[k] = max(adjust.get(k, floor_sets), floors[k])
    if exp_floor and compose_rank.slot_set_cap(exp_floor, False):
        for code in cx.st["structure"]["rotation"]:
            items = fd.get(code) or []
            for ex, kind in zip(items, lift_kinds(cx, items)):
                k = "%s/%s" % (code, ex["name"])
                compound = (kind in (KIND_MAIN, KIND_ASSIST) and "compound"
                            in catalog.get(ex["name"], {}).get("tags", ()))
                caps[k] = compose_rank.slot_set_cap(exp_floor, compound)
                d = doses[ex["name"]]
                if d is not None and d["unit"] != "sec" and \
                        adjust.get(k, d["sets"]) > caps[k]:
                    # a dose above the cap (a knee precedent's fixed sets)
                    # is held to it too
                    adjust[k] = caps[k]

    def fits(code, k, n):
        """True when session `code` with slot k at n sets stays inside the
        lift minutes."""
        lifts = [dict(catalog[ex["name"]],
                      sets=n if "%s/%s" % (code, ex["name"]) == k
                      else adjust.get("%s/%s" % (code, ex["name"]),
                                      doses[ex["name"]]["sets"]))
                 for ex in fd[code]]
        return compose_rank.session_minutes(lifts, rules) <= \
            ranked["profile"]["lift_minutes"]
    # Allocation depends on proposed sets, scope and bands only. Use the
    # audit's own calculators; history/fatigue queries cannot change this
    # decision and are prohibitively expensive inside composition trials.
    im = init_mod()
    rx = im._load_rx()
    program, _ = im.derive_program(answers_doc(cx, fd, True), cx.facts())
    focus, _ = rx.get_focus_muscles(cx.db, program)
    scope = rx.programmed_muscles(program, mmap) | focus
    audit = {'per_muscle': {
        muscle: dict(band=rx.resolve_band(muscle, program, focus),
                     verdict='in_band' if muscle in scope else 'untrained')
        for muscle in rx.muscle_vocab(cx.db)}}
    capped = set()
    for _round in range(48):
        cx.st["set_adjust"] = adjust
        program, _ = im.derive_program(answers_doc(cx, fd, True), cx.facts())
        proposed, _, _, _ = rx.proposed_sets(program, mmap, audit['per_muscle'])
        for muscle, entry in audit['per_muscle'].items():
            entry['proposed_weekly_sets'] = round(proposed[muscle], 2)
        viol = dose_violations(audit)
        # the goal's keep order first (time_plan keep, owner 2026-10-05):
        # the minutes left go to the sets the surviving goals need most
        viol.sort(key=lambda me: keep.index(me[0]) if me[0] in keep
                  else len(keep))
        moved = False
        # the short muscles a set could only be added to past the minutes
        capped = set()
        for m, e in viol:
            step = 1 if e["proposed_weekly_sets"] < e["band"]["floor"] else -1
            for code in cx.st["structure"]["rotation"]:
                for ex in fd[code]:
                    if (m, "primary") not in mmap.get(ex["name"], []):
                        continue
                    if ex["name"] in practice_only:
                        continue    # practice dose, not a band lever
                    if not compose_rank.muscle_credit(credit, ex["name"], True):
                        continue    # not band volume (rx-calc)
                    d = doses[ex["name"]]
                    if d is not None and d["unit"] == "sec":
                        continue
                    k = "%s/%s" % (code, ex["name"])
                    cur = adjust.get(k, floor_sets)
                    nxt = cur + step
                    precedent = rules['knee_precedents'].get(ex['name'], {})
                    cap = min(precedent.get('max_sets', MAX_SETS_FIX), max(rules['set_caps'].values()),
                              caps.get(k, MAX_SETS_FIX))
                    if not floors.get(k, floor_sets) <= nxt <= cap:
                        continue
                    if step > 0 and not fits(code, k, nxt):
                        capped.add(m)
                        continue
                    adjust[k] = nxt
                    moved = True
                    break
                if moved:
                    break
            if moved:
                break
        if not moved:
            break
    margin_short = []
    margin = compose_rank.region_margin(
        compose_rank.experience_facts(cx, config_value), rules)
    if margin and not viol:
        adjust, margin_short = fit_margin(
            cx, fd, adjust, margin, dict(
                im=im, rx=rx, mmap=mmap, audit=audit, floors=floors,
                floor_sets=floor_sets, doses=doses, catalog=catalog,
                practice_only=practice_only, credit=credit, ranked=ranked,
                rules=rules, caps=caps))
    if margin_short:
        cx.st["margin_short"] = margin_short
    else:
        cx.st.pop("margin_short", None)
    cx.st["set_adjust"] = base
    return adjust, viol, capped


def fit_margin(cx, fd, adjust, margin, k):
    """The region margin (rules region_margin, owner 2026-10-06 21:31):
    with every band met, +1 set at a time on the primary slots of the
    margin muscles still under floor + margin, inside the set caps, the
    band ceilings and the minutes -- the trainer-fit window's, not only
    the day the search first completed at. Returns (adjust, the margin
    muscles still short)."""
    import compose_rank
    muscles, extra = margin
    rules, mmap, audit = k["rules"], k["mmap"], k["audit"]
    rot = cx.st["structure"]["rotation"]
    fit = cx.st.get("trainer_fit") or {}
    room = 0
    if fit.get("window") and cx.st.get("day_minutes"):
        room = max(0, int(fit["window"]) - int(cx.st["day_minutes"]))
    capacity = k["ranked"]["profile"]["lift_minutes"] + room

    def minutes(code, key, n):
        return compose_rank.session_minutes([dict(
            k["catalog"][ex["name"]],
            sets=n if "%s/%s" % (code, ex["name"]) == key
            else adjust.get("%s/%s" % (code, ex["name"]),
                            k["doses"][ex["name"]]["sets"]))
            for ex in fd[code]], rules)

    def proposed():
        cx.st["set_adjust"] = adjust
        program, _ = k["im"].derive_program(answers_doc(cx, fd, True), cx.facts())
        return k["rx"].proposed_sets(program, mmap, audit["per_muscle"])[0]

    def short(now):
        return [m for m in muscles
                if audit["per_muscle"].get(m, {}).get("verdict") != "untrained"
                and now[m] < audit["per_muscle"][m]["band"]["floor"] + extra]

    now = proposed()
    for _round in range(48):
        moved = False
        for m in short(now):
            for code in rot:
                for ex in fd[code]:
                    if (m, "primary") not in mmap.get(ex["name"], []):
                        continue
                    if ex["name"] in k["practice_only"] or not \
                            compose_rank.muscle_credit(k["credit"], ex["name"], True):
                        continue
                    if (k["doses"][ex["name"]] or {}).get("unit") == "sec":
                        continue
                    key = "%s/%s" % (code, ex["name"])
                    cur = adjust.get(key, k["floor_sets"])
                    precedent = rules["knee_precedents"].get(ex["name"], {})
                    cap = min(precedent.get("max_sets", MAX_SETS_FIX),
                              max(rules["set_caps"].values()),
                              k["caps"].get(key, MAX_SETS_FIX))
                    if cur + 1 > cap or minutes(code, key, cur + 1) > capacity:
                        continue
                    adjust[key] = cur + 1
                    after = proposed()
                    if any(after[x] > e["band"]["ceiling"]
                           for x, e in audit["per_muscle"].items()
                           if e.get("verdict") != "untrained"):
                        adjust[key] = cur        # never past a band ceiling
                        continue
                    now, moved = after, True
                    break
                if moved:
                    break
            if moved:
                break
        if not moved:
            break
    return adjust, short(now)


def practice_line(cx, practice):
