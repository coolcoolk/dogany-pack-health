def caution_lifts(cx, names):
    """[(site, lift)]: per recorded caution site (record order), the first
    of `names` that uses it -- split_model.uses_site, the split screen's own
    test (works the site's muscles and loads it, or is the site's safer
    variant / table substitute) -- or None when no lift does."""
    sites = [s for s in dict.fromkeys(
        it.get("site") for it in cx.st.get("safety_items") or []) if s]
    if not sites or not names:
        return []
    import compose_rank
    import split_model
    rules = compose_rank.shared_rules()
    facts, mmap = cx.facts(), cx.muscle_map()
    movement = dict(_q(cx.db, "SELECT exercise_name, movement "
                              "FROM exercise_movement_grip"))
    cost = dict(_q(cx.db, "SELECT exercise_name, cost "
                          "FROM exercise_fatigue_cost"))
    lifts = []
    for name in names:
        f = facts.get(name) or {}
        c = compose_rank.enrich({
            "name": name, "pattern": f.get("pattern"),
            "equipment": f.get("equipment"),
            "primary": sorted(m for m, r in mmap.get(name, []) if r == "primary"),
            "secondary": sorted(m for m, r in mmap.get(name, [])
                                if r == "secondary")})
        if name in movement:
            c["movement"] = movement[name]
        c["fatigue"] = cost.get(name, c.get("fatigue"))
        c["stabilizers"] = list(compose_rank.CATALOG_FACTS.get(name, {}).get(
            "stabilizers", compose_rank.EXISTING_STABILIZERS.get(name, ())))
        lifts.append(c)
    return [(site, next((c["name"] for c in lifts
                         if split_model.uses_site(c, site, rules)), None))
            for site in sites]


def prep_for_lifts(cx, lifts):
    """Use today's taxonomy patterns and caution sites for the mat sequence.
    A caution site PREPARES (compose_rank caution_policy, owner 2026-09-27 /
    2026-10-04): a session holding a lift that uses the site opens with the
    site's prep drills first; then a cover for any site still bare, the
    first lift's pattern prep, and fill -- inside the prep budget."""
    names = [ex['name'] for ex in lifts]
    if not names:
        return []
    conn = _ro(cx.db)
    try:
        marks = ','.join('?' for _ in names)
        rows = conn.execute('SELECT exercise_name, pattern FROM exercise_pattern '
                            'WHERE exercise_name IN (%s)' % marks, names)
        by_name = dict(rows)
    finally:
        conn.close()
    patterns = [by_name.get(name) for name in names]
    caution = [it.get('site') for it in cx.st.get('safety_items') or []]
    rules = _compose_rules()
    budget = rules['budget']
    keys = []

    def add(k):
        cat = MC.MOVEMENTS[k]['category']
        if (k not in keys and len(keys) < budget['max_prep']
                and sum(MC.MOVEMENTS[x]['category'] == cat for x in keys)
                < budget['max_prep_per_category']):
            keys.append(k)

    site_prep = rules['caution_policy']['site_prep']
    for site, lift in caution_lifts(cx, names):
        if lift is not None:
            for k in site_prep.get(site, ()):
                add(k)
    # every recorded site keeps a drill preparing it (E-PREP-SITE), even in
    # a session that does not load it
    for site in sorted(set(caution) - {None}):
        covers = [k for k, d in PREP_DRILLS.items()
                  if d['slot'] == 'prep' and site in d['sites']]
        if covers and not set(covers) & set(keys):
            for k in covers:
                before = len(keys)
                add(k)
                if len(keys) > before:
                    break
    for k in rules['prep_by_pattern'].get(patterns[0], ['cat_cow', 'dead_bug']):
        add(k)
    for k in MC.available_prep([patterns[0]], []):
        add(k)
    return keys or ['dead_bug']


