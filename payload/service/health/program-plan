def _ro(db):
    return sqlite3.connect("file:%s?mode=ro" % os.path.abspath(db), uri=True)


def _q(db, sql, args=()):
    try:
        conn = _ro(db)
    except sqlite3.Error:
        return []
    try:
        return conn.execute(sql, args).fetchall()
    except sqlite3.Error:
        return []
    finally:
        conn.close()


def safety_rows(db):
    """Active standing safety rows: [(site, side, key)]."""
    out = []
    for key, _value in _q(db, "SELECT key, value FROM ledger_constraint WHERE "
                              "class='safety' AND status='active' ORDER BY id"):
        site, side = UL.parse_site_key(key)
        if site:
            out.append((site, side, key))
    return out


def venue_record(db):
    """(venue, place_label) from what is already stored, or (None, None).
    A stored venue is a READ and never renders as a question (ASK-GATE)."""
    rows = _q(db, "SELECT name, detail FROM ledger_resource WHERE kind='env' "
                  "AND status='active' ORDER BY id DESC LIMIT 1")
    if rows:
        name, detail = rows[0]
        venue = None
        try:
            d = json.loads(detail) if detail else {}
            venue = d.get("venue") if isinstance(d, dict) else None
        except (ValueError, TypeError):
            pass
        return venue or "other", name
    if _q(db, "SELECT 1 FROM ax_machine LIMIT 1"):
        return "gym", ax_gym_name(db)
    return None, None


def ax_gym_name(db):
    """The gym the machine registry belongs to (kit `place` row that
    ax_machine.gym_id points at, else a place noted as the gym registry), or
    None. P1: the name is READ from the record, never assumed away."""
    rows = _q(db, "SELECT p.name FROM ax_machine m JOIN place p ON "
                  "p.id = m.gym_id WHERE p.status='active' GROUP BY p.id "
                  "ORDER BY COUNT(*) DESC LIMIT 1")
    if not rows:
        rows = _q(db, "SELECT name FROM place WHERE status='active' AND "
                      "note LIKE '%gym registry%' ORDER BY id LIMIT 1")
    return rows[0][0] if rows and rows[0][0] else None


