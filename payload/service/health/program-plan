def dose(cx, name):
    """(slot numbers, None) from the rule tables: the user's override
    first, then a registered hold, then the class rule; an unclassified lift
    takes the lighter isolation scheme. Every lift gets a dose."""
    fields = cx.st.get("fields") or {}
    if name in fields:
        f = fields[name]
        return {"sets": RX_RULES["compound"]["sets"],
                "rep_range": list(f["rep_range"]),
                "unit": f.get("unit", "reps")}, None
    hold = hold_seconds(cx.db).get(name)
    if hold:
        return {"sets": 3, "rep_range": [int(hold), int(hold)],
                "unit": "sec"}, None
    from compose_rank import shared_rules
    practice_dose = shared_rules()["practice_dose"].get(name)
    if practice_dose:
        return {"sets": practice_dose["sets"],
                "rep_range": list(practice_dose["rep_range"]),
                "unit": "reps"}, None
    f = cx.facts().get(name) or {}
    movement, pattern = f.get("movement"), f.get("pattern")
    if is_hold(cx, name):
        rule = RX_RULES["hold"]
    elif pattern == "core":
        rule = RX_RULES["core"]
    elif movement == "compound" or (movement is None and f.get("equipment")
                                    and pattern in COMPOUND_PATTERNS):
        rule = RX_RULES["compound"]
    else:
        # isolation, or a lift no class covers: the lighter scheme is the
        # safe start (owner 2026-09-27: the pack decides, never asks).
        rule = RX_RULES["isolation"]
    from compose_rank import shared_rules
    precedent = shared_rules()['knee_precedents'].get(name, {})
    if 'max_sets' in precedent and any(s.get('site') == 'knee' for s in cx.st.get('safety_items') or []):
        return {'sets': precedent['max_sets'], 'rep_range': [precedent['reps'], precedent['reps']], 'unit': 'reps'}, None
    return {"sets": min(rule["sets"], set_level(cx)),
            "rep_range": list(rule["rep_range"]),
            "unit": rule.get("unit", "reps")}, None


