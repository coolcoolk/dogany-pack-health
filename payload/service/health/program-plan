def _korean_text(d, p, key, errs, limit=None):
    if not isinstance(d, str) or not any("가" <= ch <= "힣" for ch in d):
        errs.append("E-DISPLAY\t%s.%s\ta Korean name the user reads is "
                    "required" % (p, key))
        return
    if limit and len(d) > limit:
        errs.append("E-DISPLAY\t%s.%s\tat most %d characters" % (p, key,
                                                                  limit))
        return
    try:
        _copy_gate(d, p)
        if form_error(d):
            raise CopyLeak(form_error(d))
    except CopyLeak as e:
        errs.append("E-DISPLAY\t%s.%s\t%s" % (p, key, e))


def lift_region(cx, name):
    prim = {m for m, r in cx.muscle_map().get(name, []) if r == "primary"}
    for m, region in MUSCLE_REGION:
        if m in prim:
            return region
    return None


def back_and_forth(cx, items):
    """The first lift that returns to a body region the session already
    left, as (index, region), or None (round 3 17:31, the 09-11 rule)."""
    done, cur = set(), None
    for i, ex in enumerate(items):
        r = lift_region(cx, ex.get("name")) if isinstance(ex, dict) else None
        if r is None or r == cur:
            continue
        if r in done:
            return i, r
        if cur is not None:
            done.add(cur)
        cur = r
    return None


def _drill_list(payload, key, code, slot, errs):
    lst = (payload.get(key) or {}).get(code) if isinstance(
        payload.get(key), dict) else None
    p = "%s.%s" % (key, code)
    if not isinstance(lst, list) or not lst:
        errs.append("E-%s\t%s\tevery session opens with mat prep and ends "
                    "with a cooldown stretch: name its drills" % (
                        key.upper(), p))
        return []
    seen = []
    for i, k in enumerate(lst):
        d = PREP_DRILLS.get(k)
        if d is None or d["slot"] != slot:
            errs.append("E-%s\t%s[%d]\t%r is not a %s drill (one of %s)"
                        % (key.upper(), p, i, k, slot, ", ".join(
                            x for x in PREP_DRILLS
                            if PREP_DRILLS[x]["slot"] == slot)))
        elif k in seen:
            errs.append("E-DUP\t%s[%d]\t%r twice" % (p, i, k))
        seen.append(k)
    return seen


def validate_compose(cx, payload):
    errs = []
    rot = cx.st["structure"]["rotation"]
    days = payload.get("days") if isinstance(payload, dict) else None
    if not isinstance(days, dict):
        return ["E-SHAPE\tdays\tpayload must be {\"days\": {<day>: [...]}}"]
    import compose_rank
    ranked = compose_rank.for_context(cx, candidates(cx), globals())
    errs.extend(compose_rank.validate(ranked, days))
    allowed = {c["name"] for c in candidates(cx)}
    sites = {it.get("site") for it in (cx.st.get("safety_items") or [])}
    for code in rot:
        items = days.get(code)
        if not isinstance(items, list) or not items:
            errs.append("E-DAY-EMPTY\tdays.%s\tevery day needs lifts" % code)
            continue
        seen = set()
        for i, ex in enumerate(items):
            p = "days.%s[%d]" % (code, i)
            if not isinstance(ex, dict):
                errs.append("E-SHAPE\t%s\teach lift is an object" % p)
                continue
            for k in NUMBER_KEYS:
                if k in ex:
                    errs.append("E-NUMBER-FROM-MODEL\t%s.%s\tthe pack doses "
                                "every slot from its rules; drop the number"
                                % (p, k))
            if ex.get("name") in ACTIVATION_CORE:
                errs.append("E-ACTIVATION-IN-WORK\t%s\t%r wakes the trunk up "
                            "and is not training volume: put it in "
                            "prep.%s" % (p, ex.get("name"), code))
                continue
            for key in ("name", "replaces"):
                nm = ex.get(key)
                if key == "replaces" and nm is None:
                    continue
                if nm not in allowed:
                    errs.append("E-NOT-A-CANDIDATE\t%s.%s\t%r is not in "
                                "`candidates` (no muscle map, or not usable "
                                "at this place)" % (p, key, nm))
            _korean_text(ex.get("display"), p, "display", errs)
            if ex.get("replaces") is not None:
                _korean_text(ex.get("replaces_display"), p,
                             "replaces_display", errs)
            if ex.get("why") is not None or ex.get("replaces") or ex.get("for_site"):
                _korean_text(ex.get("why"), p, "why", errs, WHY_MAX)
            if (ex.get("replaces") is not None
                    or ex.get("for_site") is not None) and \
                    ex.get("for_site") not in sites:
                errs.append("E-SWAP-SITE\t%s.for_site\ta swap or safety "
                            "change must name a site from the safety answer "
                            "(%s)" % (p, ", ".join(sorted(
                                s for s in sites if s))))
            if ex.get("replaces") and loads_caution_area(cx, ex.get("name") or ""):
                errs.append("E-SWAP-CAUTION\t%s.name\treplacement loads "
                            "a recorded caution area" % p)
            if ex.get("replaces") and ex.get("for_site") in sites:
                row = compose_rank.caution_substitution(
                    ex["replaces"], {ex["for_site"]})
                if not row or row[1] != ex.get("name"):
                    errs.append("E-SWAP-TABLE\t%s.replaces\ta caution site "
                                "adds prep, it does not swap: keep %r (the "
                                "only swaps are caution_policy.substitutions)"
                                % (p, ex["replaces"]))
            if ex.get("focus") is not None and \
                    ex["focus"] not in compose_focus(cx):
                errs.append("E-FOCUS\t%s.focus\tnot one of the chosen areas"
                            % p)
            if ex.get("name") in seen:
                errs.append("E-DUP\t%s\t%r twice on one day"
                            % (p, ex.get("name")))
            seen.add(ex.get("name"))
        bf = back_and_forth(cx, items)
        if bf:
            errs.append("E-ORDER-BACK-AND-FORTH\tdays.%s[%d]\treturns to %s "
                        "after the session moved on: finish one region "
                        "before the next" % (code, bf[0], bf[1]))
        prep = _drill_list(payload, "prep", code, "prep", errs)
        _drill_list(payload, "cooldown", code, "cooldown", errs)
        if len(prep) > compose_rank.load_rules()['budget']['max_prep']:
            errs.append('E-PREP-BUDGET\tprep.%s\tat most four drills in five minutes' % code)
        category_list = [MC.MOVEMENTS.get(k, {}).get('category') for k in prep]
        if any(category_list.count(cat) > compose_rank.load_rules()['budget']['max_prep_per_category'] for cat in ('mobility', 'activation')):
            errs.append('E-PREP-BUDGET\tprep.%s\tat most two mobility and two activation drills' % code)
        categories = set(category_list)
        if not {'mobility', 'activation'} <= categories:
            errs.append('E-PREP-KINDS\tprep.%s\tinclude mobility and activation' % code)
        for site in sorted(s for s in sites if s):
            covers = [k for k, d in PREP_DRILLS.items()
                      if d["slot"] == "prep" and site in d["sites"]]
            if covers and not set(covers) & set(prep):
                errs.append("E-PREP-SITE\tprep.%s\tthe safety site %r needs "
                            "a prep drill: one of %s" % (code, site,
                                                         ", ".join(covers)))
    for key in ("days", "prep", "cooldown"):
        for code in (payload.get(key) or {}) if isinstance(
                payload.get(key), dict) else ():
            if code not in rot:
                errs.append("E-DAY-UNKNOWN\t%s.%s\tnot a planned day"
                            % (key, code))
    return errs


# -- heavy-lift spacing (owner 2026-09-27 12:41) ----------------------------
# "You said you'd compute load while building the program, but it put squat
# on day 1 and deadlift right on the next day." The split reason promised
# the squat and deadlift days split the load; nothing checked the WEEK: the
# rotation was laid over the training days in order and the only build-time
# number was the weekly set count. The rule now:
#
#   Two high axial-load lifts (back squat / conventional deadlift families)
#   with kit fatigue cost `high` that load a common muscle node never start inside that
#   node's recovery window of each other when the week allows otherwise.
#
# Every number is the kit's (056 muscle_fatigue, the single recovery model):
# fatigue cost (exercise_fatigue_cost via Library.cost_of), which
# nodes a lift loads (Library.credit), and the window = the time a node the
# kit calls hard (STATE_HARD x dose) takes to decay to its recovering line
# (STATE_RECOVERING x dose) at the node's own half-life (Taxonomy.hl). No
# private recovery table.
#
# The fix the pack makes, never asked (the pack decides; it never asks the owner to):
#   1. reorder the rotation across the same days, keeping the split (the
#      same sessions, the same body-part alternation) -- fewest moves first;
#   2. if no order clears it, pair the heavy lift with a LIGHT one of the
#      same pattern (kit cost not high, from the same candidates, closest
#      muscle credit) in the session that sits next to it -- only a lift
#      whose pattern keeps another heavy lift in the week is lightened, so a
#      week never loses its only heavy squat or hinge.
# A lift the user put back by name is never lightened again.
# Axial spinal load is the owner's definition; kit cost and recovery still
# determine the gap after a lift qualifies. RDL and machine V squat do not.
SPACING_AXIAL = {"back_squat", "deadlift", "conventional_deadlift"}
SPACING_HEAVY_COST = "high"


def kit_db_dir():
    return (os.environ.get("KIT_DB_DIR")
            or os.path.join(PROJECT_ROOT, "database"))


_MF = {}


def kit_mf():
    """The kit's per-muscle fatigue model (056), or None (no kit)."""
    d = kit_db_dir()
    if d not in _MF:
        path = os.path.join(d, "muscle_fatigue.py")
        _MF[d] = _load("kit_muscle_fatigue", path) if os.path.exists(
            path) else None
    return _MF[d]


def exercise_ko(name):
    """The pack's own Korean name for a lift (fatigue_copy.json), or None."""
    try:
        with open(os.path.join(HERE, "fatigue_copy.json"),
                  encoding="utf-8") as f:
            return (json.load(f).get("exercise") or {}).get(name)
    except (OSError, ValueError):
        return None


class Recovery(object):
    """The kit model, read once per build."""

    def __init__(self, mf, db):
        self.mf = mf
        conn = _ro(db)
        try:
            self.tax = mf.Taxonomy(conn)
            self.lib = mf.Library(conn, self.tax)
        finally:
            conn.close()
        self.span = math.log(mf.STATE_HARD / mf.STATE_RECOVERING, 2)

    def pattern(self, name):
        return self.lib.pattern.get(name)

    def heavy(self, name):
        return (name in SPACING_AXIAL and self.lib.mapped(name)
                and self.lib.cost_of(name)[0] == SPACING_HEAVY_COST)

    def window_h(self, a, b):
        """Hours the later of two lifts must wait: the longest recovery
        window over the nodes both load (0 = nothing shared)."""
        ca, cb = self.lib.credit(a), self.lib.credit(b)
        shared = [n for n in ca if ca[n] > 0 and cb.get(n, 0) > 0]
        return max([self.tax.hl(n) * self.span for n in shared] or [0.0])

    def overlap(self, a, b):
        ca, cb = self.lib.credit(a), self.lib.credit(b)
        return sum(min(w, cb.get(n, 0.0)) for n, w in ca.items())


def training_starts(cx):
    """[(weekday, minutes from Monday 00:00)] for the regular days, in week
    order. A day with no clock time starts at midnight."""
    days = list((cx.st.get("days") or {}).get("weekdays")
                or (cx.st.get("daytime") or {}).get("weekdays") or [])
    start = {}
    for w in (cx.st.get("daytime") or {}).get("windows") or []:
        for d in w.get("weekdays") or []:
            if w.get("start"):
                hh, mm = w["start"].split(":")
                start[d] = int(hh) * 60 + int(mm)
    return [(d, UL.WEEKDAY_ORDER.index(d) * 1440 + start.get(d, 0))
            for d in UL.WEEKDAY_ORDER if d in set(days)]


def spacing_clashes(rc, starts, rot, lifts):
    """Pairs of heavy lifts that start inside each other's window.
    lifts: {session: [name, ...]}. The rotation is a queue over the days, so
    the check runs every occurrence of a full cycle (weeks until the
    session and the weekday line up again) plus the wrap into the next."""
    n, k = len(starts), len(rot)
    if not n or not k:
        return []
    cycle = n * k // math.gcd(n, k)
    occ = []
    for i in range(cycle * 2):
        wk, (day, t) = divmod(i, n)[0], starts[i % n]
        occ.append((i, rot[i % k], day, wk * 7 * 1440 + t))
    heavy = {c: [x for x in lifts[c] if rc.heavy(x)] for c in rot}
    out, seen = [], set()
    for i in range(cycle):
        _i, ci, di, ti = occ[i]
        for j in range(i + 1, len(occ)):
            _j, cj, dj, tj = occ[j]
            gap_h = (tj - ti) / 60.0
            if gap_h <= 0:
                continue
            hit = False
            for a in heavy[ci]:
                for b in heavy[cj]:
                    if gap_h < rc.window_h(a, b):
                        key = (ci, a, di, cj, b, dj)
                        if key not in seen:
                            seen.add(key)
                            out.append({"first": ci, "first_lift": a,
                                        "first_day": di, "then": cj,
                                        "then_lift": b, "then_day": dj,
                                        "gap_h": round(gap_h, 1)})
                        hit = True
            if not hit and gap_h > 7 * 24:
                break
    return out


def split_orders(rot):
    """Every order of the same sessions that keeps the split: the body-part
    sequence is the original's up to where the week starts. Fewest moved
    sessions first; the original first of all."""
    glyphs = [cell_glyph(c) for c in rot]
    shapes = {tuple(glyphs[i:] + glyphs[:i]) for i in range(len(glyphs))}
    out = []
    if len(rot) <= 6:
        for p in itertools.permutations(rot):
            if tuple(cell_glyph(c) for c in p) in shapes:
                out.append(list(p))
    if list(rot) not in out:
        out.append(list(rot))
    moved = lambda p: sum(1 for a, b in zip(p, rot) if a != b)    # noqa: E731
    return sorted(out, key=lambda p: (moved(p), p != list(rot)))


def loads_caution_area(cx, name):
    """True when a recorded caution site's substitution table takes `name`
    out of the plan (compose_rank caution_policy.substitutions). Owner
    2026-09-27, restated 2026-10-04 11:44: a caution site prepares, it does
    not swap -- a lift not in the table keeps its place."""
    import compose_rank
    sites = {it.get("site") for it in cx.st.get("safety_items") or []}
    return bool(sites - {None}) and compose_rank.caution_substitution(
        name, sites) is not None


