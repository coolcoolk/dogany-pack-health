def calorie_goal(cx):
    """Stable goal inputs, including edits to existing rows (not just IDs)."""
    available = {r[1] for r in _q(cx.db, "PRAGMA table_info(ledger_goal)")}
    columns = [k for k in ("id", "metric", "target_value", "target_dir",
                           "horizon_date", "focus_state", "priority_rank") if k in available]
    rows = _q(cx.db, "SELECT %s FROM ledger_goal WHERE status='active' "
              "AND (domain='health' OR domain IS NULL) ORDER BY id"
              % ",".join(columns)) if columns else []
    return {"mode": config_value(cx.db, "goal_mode"),
            "goals": [list(r) for r in rows]}


def calorie_due(cx):
    """Every completed goal consult owes a decision, regardless of diet state.
    A program-only run reopens it only on a known change to its goal inputs."""
    st = cx.st
    cal = st.get("calorie") or {}
    if cal.get("status") == "open" or st.get("calorie_pending"):
        return True
    previous = st.get("calorie_goal")
    if previous is not None and previous != calorie_goal(cx):
        return True
    if cal.get("status") in ("set", "noted", "skipped"):
        return False
    # Legacy in-flight program state is not evidence of a new goal consult.
    if any(st.get(k) for k in ("frequency", "daytime", "structure", "written")):
        return False
    g = st.get("goal") or {}
    return bool(g.get("done") and g.get("live")
                and g.get("restart") != "program")


def cal_existing(cx):
    """Nutrition ledger values win over the legacy config mirror."""
    values = {k: config_value(cx.db, k) for k in
              ("deficit_kcal", "surplus_kcal", "protein_g")}
    for key, value in _q(cx.db, "SELECT key, value FROM ledger_constraint "
                         "WHERE class='nutrition' AND status='active' "
                         "ORDER BY id"):
        if key in values:
            values[key] = value
    out = {}
    for key, value in values.items():
        try:
            number = float(value)
            if math.isfinite(number) and number >= 0:
                out[key] = int(number)
        except (ValueError, TypeError):
            pass
    return out if any(k in out for k in ("deficit_kcal", "surplus_kcal")) else {}


def cal_existing_lines(values):
    lines = []
    for key in ("deficit_kcal", "surplus_kcal", "protein_g"):
        if key in values and (values[key] or key == "deficit_kcal"):
            lines.append(T("cal_existing_" + key, value=format(values[key], ",")))
    return "\n".join(lines)


def cal_stored_activity(cx):
    """The activity the user ANSWERED in an earlier calorie step
    (activity_job + steps_weekly_mean, written by cal_write_activity), or
    None. A seeded avg_steps is not an answer: without activity_job the
    job and steps questions are asked again (owner 2026-10-11 12:14)."""
    job = config_value(cx.db, "activity_job")
    if job not in CAL_JOB_PICKS:
        return None
    try:
        steps = int(float(config_value(cx.db, "steps_weekly_mean") or 0))
    except (TypeError, ValueError):
        steps = 0
    return {"job": job, "steps": steps if steps > 0 else None}


def cal_open_step(cal):
    ans = cal.get("answers", {})
    if not cal.get("activity_stored"):
        for s in CAL_STEPS:
            if s == "result":
                break
            if s not in ans:
                return s
    if cal.get("existing") and not cal.get("existing_answered"):
        return "existing"
    if cal.get("result") and not cal.get("closed"):
        return "result"
    return None


def _cal_kit(cx, args):
    """A kit write for the calorie step (skipped on a replay). True when the
    kit took it (a replay counts as taken: it writes nothing)."""
    if not cx.side_effects:
        cx.st.setdefault("cal_writes", []).append(list(args))
        return True
    rc, _o, e = kit(args)
    if rc != 0:
        cx.st.setdefault("kit_errors", []).append(
            "%s: %s" % (args[0], (e or "").strip()[-200:]))
    return rc == 0


def _float_or_none(v):
    try:
        f = float(v)
    except (TypeError, ValueError):
        return None
    return f if math.isfinite(f) and f > 0 else None


def _latest_metric(cx, names):
    """(value, date) of the newest metric_log row among `names`."""
    best = None
    for name in names:
        rows = _q(cx.db, "SELECT date, value FROM metric_log WHERE metric=? "
                  "AND value IS NOT NULL ORDER BY date DESC, id DESC LIMIT 1",
                  (name,))
        if rows and _float_or_none(rows[0][1]) and (
                best is None or str(rows[0][0]) > best[1]):
            best = (float(rows[0][1]), str(rows[0][0])[:10])
    return best if best else (None, None)


def cal_bmr_info(cx):
    """(bmr, source): the latest InBody BMR reading (metric_log bmr_kcal /
    bmr, the kit's G6 BMR limb reads the same rows), else the kit
    calculator's BMR (`body-state`) when the body stats it rests on are the
    user's own (weight + height on record); else (None, None) --
    measure-first, never a default body. source = {kind: inbody | katch |
    mifflin, date}."""
    if not (config_value(cx.db, "weight_kg") and
            config_value(cx.db, "height_cm")):
        return None, None
    bmr, as_of = _latest_metric(cx, ("bmr_kcal", "bmr"))
    if bmr:
        return bmr, {"kind": "inbody", "date": as_of}
    rc, out, _e = kit(["body-state"])
    if rc != 0:
        return None, None
    for ln in (out or "").splitlines():
        k, _, v = ln.partition("=")
        if k.strip().lower() == "bmr":
            b = _float_or_none(v.strip())
            if b is None:
                return None, None
            method = config_value(cx.db, "diet_bmr_method")
            return b, {"kind": "mifflin" if method == "mifflin" else "katch",
                       "date": None}
    return None, None


def cal_bmr(cx):
    return cal_bmr_info(cx)[0]


def cal_profile(cx):
    """The body facts the BMR block states, each only when on record:
    sex, age (birth year / birthday, else a stated age), height, weight
    (latest reading, else the config), body fat %."""
    out = {}
    sex = config_value(cx.db, "sex")
    if sex in ("male", "female"):
        out["sex"] = sex
    age = None
    for key in ("birth_year", "birthday", "birth_date"):
        age = cal_band().age_from(config_value(cx.db, key), cx.today)
        if age:
            break
    if not age:
        a = _float_or_none(config_value(cx.db, "age"))
        age = int(a) if a else None
    if age:
        out["age"] = age
    h = _float_or_none(config_value(cx.db, "height_cm"))
    if h:
        out["height"] = h
    w, _d = _latest_metric(cx, ("body_weight", "weight_kg"))
    w = w or _float_or_none(config_value(cx.db, "weight_kg"))
    if w:
        out["weight"] = w
    bf, _d = _latest_metric(cx, ("body_fat_pct",))
    if not bf:
        bf = _float_or_none(config_value(cx.db, "body_fat_pct"))
    if not bf and w:
        fm = _float_or_none(config_value(cx.db, "fat_mass_kg"))
        bf = fm / w * 100.0 if fm else None
    if bf:
        out["bf"] = bf
    return out


def _num1(x):
    """82.3 -> '82.3', 170.0 -> '170'."""
    r = round(float(x), 1)
    return str(int(r)) if r == int(r) else str(r)


def cal_phase(cx):
    phase = goal_direction(cx)
    return phase if phase in ("cut", "grow") else "maintain"


def cal_compute(cx):
    """Range + target, cleared by the gate. {kind: 'propose' | 'noted',
    maint, target, deficit, surplus, verdict, why, bmr, bmr_src}."""
    cal = cx.st["calorie"]
    ans = cal["answers"]
    bmr, src = cal_bmr_info(cx)
    if bmr is None:
        return {"kind": "noted", "why": "measure_first"}
    cb = cal_band()
    maint = cb.maintenance(bmr, ans["job"], ans.get("steps"))
    phase = cal_phase(cx)
    tg = cb.target(maint, phase)
    existing = cal.get("existing") or {}
    key = "deficit_kcal" if phase == "cut" else "surplus_kcal"
    if phase in ("cut", "grow") and key in existing:
        delta = existing[key]
        tg = {"target": maint["middle"] + (-delta if phase == "cut" else delta),
              "deficit": delta if phase == "cut" else 0,
              "surplus": delta if phase == "grow" else 0}
    gate = calorie_gate()
    if gate is None:
        return {"kind": "noted", "why": "unverifiable", "maint": maint,
                "bmr": bmr, "bmr_src": src, "phase": phase}
    sex = config_value(cx.db, "sex")
    v = gate.evaluate(tg["deficit"], tg["target"], bmr, sex,
                      db_path=cx.db)
    if v["verdict"] == "unverifiable":
        return {"kind": "noted", "why": "unverifiable", "maint": maint,
                "bmr": bmr, "bmr_src": src, "phase": phase,
                "missing": v.get("limits_missing")}
    target = gate.permitted_base(v, tg["target"], tg["deficit"])
    out = dict(tg, kind="propose", maint=maint, bmr=bmr, bmr_src=src,
               phase=phase, verdict=v["verdict"],
               why=cal_why(gate, v, target))
    if target != tg["target"]:
        out["target"] = int(target)
        if phase == "cut":
            out["deficit"] = max(0, maint["middle"] - int(target))
    return out


def cal_why(gate, v, final):
    """The ONE gate line that bound the number (G6-b): the floor's line
    names the hoisted number; otherwise the cap moved it. Two lines naming
    two different numbers read as two floors."""
    bits = [b.strip() for b in (gate.why_line(v) or "").split(" / ")
            if b.strip()]
    if not bits:
        return ""
    line = next((b for b in bits
                 if str(int(final)) in b.replace(",", "")), bits[0])
    return line if line.endswith((".", "?")) else line + "."


def cal_basis_line(cx, res):
    """The activity basis the range used, in the user's own answers."""
    ans = cx.st["calorie"]["answers"]
    m = res["maint"]
    job = T("cal_job_" + ans["job"])
    steps = format(ans["steps"], ",") if ans.get("steps") else None
    return (T("cal_basis_" + m["basis"], job=job, steps=steps)
            if steps or m["basis"] == "job" else T("cal_basis_job", job=job))


def cal_result_lines(cx, res):
    m = res["maint"]
    return [T("cal_range", low=format(m["low"], ","),
              high=format(m["high"], ",")),
            cal_basis_line(cx, res), T("cal_lifting")]


def cal_target_line(res):
    m = res["maint"]
    key = CAL_SHIFT_KEY.get(res["phase"], "cal_target_maintain")
    delta = res["deficit"] or res["surplus"]
    if not delta:
        key = "cal_target_maintain"
    return T(key, middle=format(m["middle"], ","), delta=format(delta, ","),
             target=format(res["target"], ","))


def cal_protein(cx):
    """The daily protein the step settles with: the user's revised / kept
    number, else the config's own (never the kit's code default)."""
    cal = cx.st["calorie"]
    p = (cal.get("existing") or {}).get("protein_g")
    if p is None:
        p = _float_or_none(config_value(cx.db, "protein_g"))
    return int(p) if p else None


def _quote(line):
    return UL.i18n("health.plan.cal_quote", line=line)


def cal_blocks(cx, res):
    """Three blockquote blocks, every number from the record (owner
    2026-10-11 12:06): the BMR with its basis and meaning, the maintenance
    range with the activity basis it used, the target with protein, the
    expected weekly change and the trend note."""
    cal = cx.st["calorie"]
    prof = cal_profile(cx)
    src = res.get("bmr_src") or {}
    facts = []
    if prof.get("sex"):
        facts.append(T("cal_sex_" + prof["sex"]))
    if prof.get("age"):
        facts.append(T("cal_age", age=prof["age"]))
    if prof.get("height"):
        facts.append(T("cal_height", v=_num1(prof["height"])))
    if prof.get("weight"):
        facts.append(T("cal_weight", v=_num1(prof["weight"])))
    if prof.get("bf"):
        facts.append(T("cal_bf", v=_num1(prof["bf"])))
    if src.get("kind") == "inbody" and src.get("date"):
        d = datetime.date.fromisoformat(src["date"])
        how = T("cal_bmr_inbody", m=d.month, d=d.day)
    else:
        how = T("cal_bmr_" + (src.get("kind") or "katch"))
    bmr = [T("cal_blk_bmr_head", bmr=format(int(round(res["bmr"])), ",")),
           _quote(" \u00b7 ".join(facts + [how])),
           _quote(T("cal_bmr_meaning"))]
    m = res["maint"]
    maint = [T("cal_blk_maint_head", low=format(m["low"], ","),
               high=format(m["high"], ",")),
             _quote(cal_basis_line(cx, res)), _quote(T("cal_lifting"))]
    target = [T("cal_blk_target_head", target=format(res["target"], ",")),
              _quote(cal_target_line(res))]
    if res.get("why"):
        target.append(_quote(res["why"]))
    protein = cal_protein(cx)
    if protein:
        per = cal_band().protein_per_kg(protein, prof.get("weight"))
        target.append(_quote(T("cal_protein_per_kg", g=protein, per=per)
                             if per else T("cal_protein", g=protein)))
    delta = res["surplus"] - res["deficit"]
    if delta:
        kg = abs(cal_band().weekly_change_kg(delta))
        target.append(_quote(T("cal_pace_cut" if delta < 0
                               else "cal_pace_grow", kg=kg)))
    target.append(_quote(T("cal_trend_recheck")))
    return "\n\n".join("\n".join(b) for b in (bmr, maint, target))


def cal_move(cx, step):
    cal = cx.st["calorie"]
    if step == "existing":
        res = cal.get("result")
        if res is None and cal.get("answers", {}).get("job"):
            res = cal["result"] = cal_compute(cx)
            cx.save()
        ex = cal["existing"]
        if res and res.get("kind") == "propose":
            key = "deficit_kcal" if ex.get("deficit_kcal") or \
                not ex.get("surplus_kcal") else "surplus_kcal"
            say = (T("cal_existing_lead_" + key,
                     value=format(ex.get(key) or 0, ","))
                   + "\n\n" + cal_blocks(cx, res)
                   + "\n\n" + T("cal_existing_ask"))
        else:
            say = cal_existing_lines(ex) + "\n\n" + T("cal_existing_ask")
        choices = [choice("keep", T("c_cal_keep"), True),
                   choice("adjust", T("c_cal_adjust"))]
        payload = {"pick": "keep | adjust",
                   "protein": "optional: the user's revised daily protein g"}
    elif step == "job":
        say = T("cal_job_ask")
        choices = [choice(p, T("c_cal_" + p)) for p in CAL_JOB_PICKS]
        payload = {"pick": " | ".join(CAL_JOB_PICKS),
                   "words": "free text: the user's own words, mapped to the "
                            "closest pick"}
    elif step == "watch":
        say = T("cal_watch_ask")
        choices = [choice("link", T("c_cal_link")),
                   choice("none", T("c_cal_nowatch"))]
        payload = {"pick": "link | none"}
    elif step == "steps":
        linked = cal["answers"].get("watch") == "link"
        say = T("cal_steps_ask_linked" if linked else "cal_steps_ask")
        choices = [choice(p, T("c_cal_" + p)) for p in
                   ("under5k", "5to10k", "over10k")] + \
            [choice("unknown", T("c_cal_steps_unknown"))]
        payload = {"pick": "under5k | 5to10k | over10k | unknown | said",
                   "steps": "on said: the user's own daily step count (int)"}
    else:
        res = cal["result"]
        if cal.get("adjusting"):
            say = T("cal_adjust_ask")
            choices = []
            payload = {"pick": "set", "kcal": "the user's daily kcal (int)"}
        else:
            body = cal_blocks(cx, res)
            if CAL_WATCH_ASK and cal["answers"].get("watch") == "link":
                body += "\n" + T("cal_watch_kcal")
            say = body + "\n\n" + T("cal_confirm")
            choices = [choice("ok", T("c_cal_ok"), True),
                       choice("adjust", T("c_cal_adjust"))]
            payload = {"pick": "ok | adjust",
                       "kcal": "on adjust with a number: the user's daily "
                               "kcal (int)"}
    readback = []
    fold = cal.get("fold")
    if fold:
        say = fold["say"] + "\n\n" + say
        readback = list(fold.get("readback") or [])
    return move("ask", "calorie:" + step, say=say, choices=choices,
                readback=readback,
                answer={"stage": "calorie:" + step, "payload": payload},
                numbers=(cal.get("result") or {}).get("maint"))


def cal_fold_say(say):
    """The goal wrap's say with the program transition line swapped for the
    calorie step's: the program comes after this step now. Both the pack's
    program line and the kit's wrap transition (pack i18n
    goal.move.wrap_transition, which leads into this step since 0.38.2)
    are dropped, so the step's lead is said once, before its question."""
    markers = [m for m in (T("wrap_transition").split(".")[0],
                           UL.i18n("goal.move.wrap_transition").split(".")[0],
                           T("cal_transition").split(".")[0])
               if m and m != "goal"]
    keep = [ln for ln in str(say or "").split("\n")
            if not any(mk in ln for mk in markers)]
    text = "\n".join(keep).strip()
    return (text + "\n\n" if text else "") + T("cal_transition")


def _stage_calorie(cx):
    if not calorie_due(cx):
        return None
    st = cx.st
    cal = st.setdefault("calorie", {})
    if cal.get("status") != "open":
        cal.clear()
        cal.update({"status": "open", "answers": {},
                    "existing": cal_existing(cx),
                    "asked": cx.today.isoformat()})
        fold = st.pop("wrap_fold", None)
        cal["fold"] = {"readback": list((fold or {}).get("readback") or []),
                       "say": cal_fold_say((fold or {}).get("say"))}
        stored = cal_stored_activity(cx)
        if stored:
            # answered in an earlier step: no job / steps question again
            cal["activity_stored"] = True
            cal["answers"].update(stored, steps_pick="stored")
            cal["result"] = cal_compute(cx)
        cx.save()
    step = cal_open_step(cal)
    if step is None:
        cal_close(cx)
        return None
    return cal_move(cx, step)


def cal_after_steps(cx):
    """The activity is answered: write it, compute the range + target. The
    first-time path speaks the result next; the existing path speaks its
    blocks on the keep / change ask."""
    cal = cx.st["calorie"]
    cal_write_activity(cx)
    res = cal_compute(cx)
    cal["result"] = res
    if res["kind"] == "noted" and not cal.get("existing"):
        cal_close(cx)


