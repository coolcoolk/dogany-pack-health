def ieyo(word):
    """The copula after `word` (consonant-final: ieyo form, else yeyo)."""
    return UL.josa(word, "\uc774\uc5d0\uc694", "\uc608\uc694")[len(word):]


def tail_choice(pick, label, rec=False):
    """A tail button: the label stays neutral (the recommendation is marked
    in the body line), the flag rides the data."""
    return {"pick": pick, "label": label, "recommended": bool(rec)}


TAIL_CLOCK_PARTS = ((6, "dawn"), (12, "morning"), (18, "day"),
                    (21, "evening"), (24, "night"))


def spoken_clock(hhmm):
    """'04:30' -> dawn 4 and a half, '21:00' -> night 9 (the tail copy: a
    5 a.m. session is dawn, 9 p.m. is night, as the kit says them)."""
    try:
        h, m = (int(x) for x in str(hhmm).split(":", 1))
    except (ValueError, TypeError):
        return str(hhmm)
    part = next(p for top, p in TAIL_CLOCK_PARTS if h < top)
    h12 = h % 12 or 12
    said = (T("clock_hour", h=h12) if m == 0 else
            T("clock_half", h=h12) if m == 30 else T("clock_hm", h=h12, m=m))
    return T("clock_part_" + part) + " " + said


def _hhmm(v):
    v = str(v or "").strip()
    try:
        h, m = (int(x) for x in v.split(":", 1))
    except ValueError:
        return None
    return "%02d:%02d" % (h, m) if 0 <= h < 24 and 0 <= m < 60 else None


def _day_when(d, start=None):
    """'10월 8일 목요일 새벽 5시' (no time: the date alone)."""
    wd = UL.WEEKDAY_ORDER[d.weekday()]
    out = T("day_when", month=d.month, day=d.day, weekday=UL.weekday_full(wd))
    return out + (" " + spoken_clock(start) if start else "")


