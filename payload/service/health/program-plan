    if _INIT is None:
        _INIT = _load("program_init_mod", INIT_PATH)
    return _INIT


# ---------------------------------------------------------------------------
# read-only DB helpers -- every one tolerates a missing table or column
# ---------------------------------------------------------------------------
def _ro(db):
    return sqlite3.connect("file:%s?mode=ro" % os.path.abspath(db), uri=True)


def _db_stamp(db):
    """The kit DB's on-disk stamp: the main file's size and mtime and the
    WAL's size. A write grows the WAL or, checkpointed, moves the main
    file; the WAL's own mtime is not read (sqlite recreates an empty WAL
    as connections come and go, a reader included)."""
    out = []
    for p in (db, str(db) + "-wal"):
        try:
            st = os.stat(p)
            out.append((st.st_size, st.st_mtime_ns) if p == db
                       else st.st_size)
        except (OSError, TypeError):
            out.append(None)
    return tuple(out)


# Read-only query results, per process, while the DB's stamp holds. The
# plan never writes the kit DB in process (the kit's own verbs run as
# subprocesses and move the stamp), and the compose search repeats the
# same reads tens of thousands of times (owner replay 2026-10-06).
_READS = {}


def _q(db, sql, args=()):
    key = (os.path.abspath(db) if isinstance(db, str) else db, sql,
           tuple(args))
    stamp = _db_stamp(db)
    hit = _READS.get(key)
    if hit is not None and hit[0] == stamp:
        return list(hit[1])
    try:
        conn = _ro(db)
    except sqlite3.Error:
        return []
    try:
        rows = conn.execute(sql, args).fetchall()
    except sqlite3.Error:
        return []
    finally:
        conn.close()
    _READS[key] = (stamp, rows)
    return list(rows)


def safety_rows(db):
    """Active standing safety rows: [(site, side, key)]."""
    out = []
    for key, _value in _q(db, "SELECT key, value FROM ledger_constraint WHERE "
                              "class='safety' AND status='active' ORDER BY id"):
        site, side = UL.parse_site_key(key)
        if site:
            out.append((site, side, key))
    return out


def _safety_keys(db):
    return sorted(k for _s, _d, k in safety_rows(db))


def safety_stale(cx):
    """True when the active injury rows differ from the ones the stored
    answer was about: another agent sharing this person added,
    changed or retired a standing row since (kit delta
    pack-health-safety-reread-delta, 2026-10-06). The program then re-asks
    the one-tap records confirm instead of working on the old list."""
    st = cx.st
    if not st.get("safety"):
        return False
    seen = st.get("safety_keys")
    if seen is None:
        # state from before safety_keys: compare by (site, side)
        have = {(it.get("site"), it.get("side"))
                for it in st.get("safety_items") or []}
        now = {(s, d) for s, d, _k in safety_rows(cx.db)}
        return not now <= have
    return seen != _safety_keys(cx.db)


