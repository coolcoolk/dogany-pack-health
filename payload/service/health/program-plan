    candidate['stabilizers'] = list(compose_rank.CATALOG_FACTS.get(name, {}).get(
        'stabilizers', compose_rank.EXISTING_STABILIZERS.get(name, ())))
    return compose_rank.caution_unavailable(candidate, profiles)


