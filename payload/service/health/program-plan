def josa(word, pair):
    a, b = {"i": ("이", "가"), "eun": ("은", "는"), "reul": ("을", "를"),
            "wa": ("과", "와"), "ro": ("으로", "로")}[pair]
    last = ord(word[-1]) - 0xAC00 if word else -1
    if pair == "ro" and 0 <= last < 11172 and last % 28 == 8:
        return b      # a final rieul takes the vowel form
    return UL.josa(word, a, b)[len(word):]


