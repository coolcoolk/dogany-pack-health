        pick = "watch | " + pick
    return move("decide", "automation", say=T("consent_ask"),
                choices=choices,
                answer={"stage": "automation", "payload": {
                    "pick": pick,
                    "kinds": "on selected: workout, steps, heart_rate, "
                             "sleep, active_energy"}})


def _stage_done(cx):
    # Cardio is selected before the sessions preview; include it in the final
    # self-check before the wrap is rendered.
    checks = self_check(cx)
    if not checks.get("cardio"):
        return cardio_move(cx)
    fd = final_days(cx)
    if os.path.exists(cx.program):
        cx.st["program_archived"] = archive_program(cx)
    rc, out, err = do_write(cx, fd, force=True)
    if rc not in (0, 4):
        return move("error", "write", say=None, program_init_rc=rc,
                    stdout=out[-500:], stderr=err[-1500:])
    return finish(cx)


STAGE_MOVES = {
    "goal": _stage_goal, "safety": _stage_safety,
    "calorie": _stage_calorie, "place": _stage_place,
    "frequency": _stage_frequency, "daytime": _stage_daytime,
    "reconcile": _stage_reconcile, "measure": _stage_measure,
    "experience": _stage_experience, "split": _stage_split,
    "focus": _stage_focus, "emphasis": _stage_emphasis,
    "compose": _stage_compose, "field": _stage_field,
    "swaps": _stage_swaps, "cardio": _stage_cardio,
    "sessions": _stage_sessions,
    "done": _stage_done,
}
assert tuple(STAGE_MOVES) == JOURNEY, "JOURNEY and STAGE_MOVES disagree"


def next_move(cx):
    st = cx.st
    if st.get("written") and calorie_due(cx):
        mv = _stage_calorie(cx)
        if mv is not None:
            return mv
    if st.get("reprogram_pending"):
        return reprogram_move(cx)
    if st.get("reprogram_keep"):
        fold = st.pop("wrap_fold", None) or {}
        receipt = str(fold.get("say") or "").replace(T("wrap_transition"), "").strip()
        cx.save()
        extra = photo_kw(fold["photo"]) if fold.get("photo") else {}
        return move("done", "reprogram", say=(receipt + "\n" if receipt else "")
                    + T("reprogram_kept"), **extra)
    if st.get("written"):
        if st.get("offer") == "later":
            return move("paused", "paused", say=None)
        if tail_open(cx):
            mv = tail_move(cx)
            if mv is not None:
                return mv
        if automation_enabled() and not st.get("automation_answered"):
            return consent_move(cx)
        if tail_open(cx):
            return wrap_move(cx)
        if not automation_enabled() or st.get("tail") == "closed":
            return move("done", "done", say=None)
        return move("done", "automation", say=T(
            "consent_skipped" if st["automation_answered"] == "skip"
            else "consent_done"))
    if st.get("offer") == "later":
        # the user said "later" first (D5b): paused, state kept
        return move("paused", "paused", say=None)
    for stage in JOURNEY:
        mv = STAGE_MOVES[stage](cx)
        if mv is not None:
            return mv
    return finish_move(cx)


# `frequency` is absent on purpose: days answered before the count are
# accepted and settle it (in-flight state, never a refusal). `reconcile`
# refuses only while a pick waits for its day (need_day).
STAGE_DONE = {
    "goal": lambda st: bool((st.get("goal") or {}).get("done"))
    and not goal_skip_stuck(st.get("goal") or {}),
    "safety": lambda st: bool(st.get("safety")),
    "calorie": lambda st: (st.get("calorie") or {}).get("status") != "open",
    "place": lambda st: bool(st.get("place")) and not (
        (st["place"].get("venue") == "home" and "equipment" not in
         st["place"]) or st["place"].get("venue") is None
        or gym_name_pending(st["place"])),
    # the small-tool question (tools_pending) is asked by `next` but never
    # holds a later answer: a consult already past the place keeps going
    "daytime": lambda st: bool(st.get("daytime")) and not daytime_followup(st),
    # in-flight state from before the reconcile existed carries no
    # time_plan: never a refusal (as `frequency`); a pick waiting for its
    # day still holds the later stages
    "reconcile": lambda st: (st.get("time_plan") or {}).get("status")
    != "need_day",
    "measure": lambda st: (st.get("measure") or {}).get("status") == "set",
    "experience": lambda st: bool(st.get("experience")
                                  and st.get("years_band")),
    "split": lambda st: bool(st.get("structure")),
    "focus": lambda st: "focus_areas" in st,
    "emphasis": lambda st: bool(st.get("emphasis")),
    "compose": lambda st: bool(st.get("compose")),
    "swaps": lambda st: True,
    "cardio": lambda st: bool(st.get("cardio")),
}


def check_stage_order(cx, stage):
    """E-STAGE: an answer for a stage while an EARLIER journey stage is still
    open is refused, nothing recorded (the measure day never comes before
    the schedule, the split never before the days)."""
    base = STAGE_ALIAS.get(stage.split(":")[0], stage.split(":")[0])
    if base not in JOURNEY:
        raise Refused("E-STAGE\tstage\tunknown stage %r (use `next`)"
                      % stage)
    inside = ASKED_INSIDE.get(base)
    if inside and not STAGE_DONE[inside](cx.st):
        return          # asked inside the goal part, which is still open
    for s in JOURNEY[:JOURNEY.index(base)]:
        if s == inside or s not in STAGE_DONE:
            continue
        if (s == "calorie" and calorie_due(cx)) or not STAGE_DONE[s](cx.st):
            raise Refused("E-STAGE\tstage\t%r comes after %r, which is "
                          "still open (use `next`)" % (base, s))


# ---------------------------------------------------------------------------
# restart ("다시 하자") -- the ONE path (D11: a restart is ledger state)
# ---------------------------------------------------------------------------
def restart(cx, from_="goal"):
    """Archive the plan state to files/_archive/restart-<ts>/ (never
    deleted), then either restart the goal consult through the kit (its
    `--restart`: unfinished interview archived, finished goals kept active
    until the new wrap) or, --from program, keep the goal and open the
    program part again. Returns the first move of the new run."""
    root = os.path.dirname(os.path.dirname(os.path.abspath(cx.state_path)))
    if os.path.exists(cx.state_path):
        dest = os.path.join(root, "_archive", "restart-%s" % datetime
                            .datetime.now().strftime("%Y%m%d-%H%M%S"))
        os.makedirs(dest, exist_ok=True)
        shutil.copy2(cx.state_path, dest)
    old = cx.st
    if from_ == "program":
        rc, out, _e = kit(["goal-interview", "--restart", "--domain",
                           "health", "--from", "program", "--json"])
        line = T("restart_program")
        try:
            line = json.loads(out).get("say") or line if rc == 0 else line
        except (ValueError, AttributeError):
            pass
        keep = {k: old[k] for k in ("calorie", "calorie_pending", "calorie_goal",
                                    "handoff", "safety", "safety_items",
                                    "safety_keys", "safety_card", "safety_source",
                                    "safety_noted", "care", "experience",
                                    "years_band", "frequency",
                                    "day_minutes", "available_minutes",
                                    "daytime", "time_plan",
                                    "days",
                                    "place", "tools",
                                    "cardio_preference",
                                    # the user's set style (rules
                                    # set_style): a preference, not a
                                    # consult answer
                                    "set_style",
                                    # the brief / retro times were decided
                                    # once; a change goes through the kit's
                                    # brief-setup, not a second ask
                                    "brief_slots", "brief_standard")
                if k in old}
        cx.st = dict(keep, goal={"done": True, "restart": "program"},
                     lead=line,
                     restart_facts_pending=bool(keep.get("daytime") and
                                                keep.get("place")))
        cx.save()
        refresh_workbench(cx)
        return next_move(cx)
    rc, out, err = kit(["goal-interview", "--restart", "--domain", "health",
                        "--json"])
    try:
        res = json.loads(out) if rc == 0 else None
    except ValueError:
        res = None
    if not isinstance(res, dict):
        return move("error", "restart", say=None,
                    stderr=(err or out or "rc=%s" % rc).strip()[-500:])
    cx.st = {"goal": {"live": True, "restart": "goal"}}
    cx.save()
    refresh_workbench(cx)
    nxt = res.get("next")
    if isinstance(nxt, dict) and nxt.get("kind"):
        nxt = dict(nxt, stage="goal", source="kit")
        return nxt
    return next_move(cx)


def _with_readback(cx, mv):
    rb = cx.st.pop("readback", None)
    if rb and mv.get("say"):
        mv["readback"] = rb + list(mv.get("readback") or [])
        cx.save()
    elif rb:
        cx.st["readback"] = rb
    return mv


