def caution_lifts(cx, names, sites=None):
    """[(site, lift)]: per recorded caution site (record order), the first
    of `names` that uses it -- split_model.uses_site, the split screen's own
    test (works the site's muscles and loads it, or is the site's safer
    variant / table substitute) -- or None when no lift does. `sites`
    defaults to the sites whose rung keeps prep."""
    import caution_care
    if sites is None:
        sites = [site for site, profile in care_profiles(cx).items()
                 if caution_care.intensity(profile)['prep']]
    if not sites or not names:
        return []
    import compose_rank
    import split_model
    rules = compose_rank.shared_rules()
    facts, mmap = cx.facts(), cx.muscle_map()
    movement = dict(_q(cx.db, "SELECT exercise_name, movement "
                              "FROM exercise_movement_grip"))
    cost = dict(_q(cx.db, "SELECT exercise_name, cost "
                          "FROM exercise_fatigue_cost"))
    lifts = []
    for name in names:
        f = facts.get(name) or {}
        c = compose_rank.enrich({
            "name": name, "pattern": f.get("pattern"),
            "equipment": f.get("equipment"),
            "primary": sorted(m for m, r in mmap.get(name, []) if r == "primary"),
            "secondary": sorted(m for m, r in mmap.get(name, [])
                                if r == "secondary")})
        if name in movement:
            c["movement"] = movement[name]
        c["fatigue"] = cost.get(name, c.get("fatigue"))
        c["stabilizers"] = list(compose_rank.CATALOG_FACTS.get(name, {}).get(
            "stabilizers", compose_rank.EXISTING_STABILIZERS.get(name, ())))
        lifts.append(c)
    return [(site, next((c["name"] for c in lifts
                         if split_model.uses_site(c, site, rules)), None))
            for site in sites]


def loaded_sites(cx, names, sites):
    """The recorded `sites` (sorted) one of `names` loads (caution_lifts)."""
    sites = sorted(set(sites) - {None})
    if not sites:
        return []
    return [site for site, lift in caution_lifts(cx, names, sites)
            if lift is not None]


def kit_care_before(cx, site):
    """The catalog drills the kit's safety rows for `site` carry as care
    `when: before` (ledger_constraint.care, kit 074), in row order, usable
    at this place. Care modes ('prep', 'warm' ...) are not drills."""
    out = []
    for s, _d, key in safety_rows(cx.db):
        if s != site:
            continue
        rows = _q(cx.db, "SELECT care FROM ledger_constraint WHERE "
                         "class='safety' AND status='active' AND key=? "
                         "ORDER BY id DESC LIMIT 1", (key,))
        try:
            care = json.loads((rows[0][0] if rows else None) or "[]")
        except (TypeError, ValueError):
            care = []
        for c in care if isinstance(care, list) else ():
            if not isinstance(c, dict) or c.get("when") != "before":
                continue
            k = c.get("drill")
            if k in MC.MOVEMENTS and k not in out and drill_usable(cx, k):
                out.append(k)
    return out


def prep_for_lifts(cx, lifts):
    """Use today's taxonomy patterns and caution sites for the mat sequence.
    A caution site PREPARES (compose_rank caution_policy, owner 2026-09-27 /
    2026-10-04): a session holding a lift that uses the site opens with the
    site's prep drills first; then a cover for any site still bare, the
    first lift's pattern prep, and fill -- inside the prep budget."""
    names = [ex['name'] for ex in lifts]
    if not names:
        return []
    conn = _ro(cx.db)
    try:
        marks = ','.join('?' for _ in names)
        rows = conn.execute('SELECT exercise_name, pattern FROM exercise_pattern '
                            'WHERE exercise_name IN (%s)' % marks, names)
        by_name = dict(rows)
    finally:
        conn.close()
    patterns = [by_name.get(name) for name in names]
    caution = [it.get('site') for it in cx.st.get('safety_items') or []]
    rules = _compose_rules()
    budget = rules['budget']
    keys = []

    def add(k):
        cat = MC.MOVEMENTS[k]['category']
        if (MC.drill_identity(k) not in {MC.drill_identity(x) for x in keys}
                and len(keys) < budget['max_prep']
                and sum(MC.MOVEMENTS[x]['category'] == cat for x in keys)
                < budget['max_prep_per_category']):
            keys.append(k)

    loaded = [site for site, lift in caution_lifts(cx, names)
              if lift is not None]
    # the drills the user's care names for "before" (the kit constraint's
    # structured care) head the prep of a session loading that site
    for site in loaded:
        for k in kit_care_before(cx, site):
            add(k)
    for site in loaded:
        for k in site_drills(cx, site):
            add(k)
    # a site's prep and strengthening go only into the sessions whose lifts
    # load it (an upper day carries no knee or foot drill, a lower day no
    # shoulder drill); every such site keeps a drill preparing it
    # (E-PREP-SITE)
    for site in loaded_sites(cx, names, caution):
        covers = site_drills(cx, site) + [
            k for k, d in PREP_DRILLS.items()
            if d['slot'] == 'prep' and site in d['sites']
            and drill_usable(cx, k)]
        if covers and not set(covers) & set(keys):
            for k in covers:
                before = len(keys)
                add(k)
                if len(keys) > before:
                    break
    for k in rules['prep_by_pattern'].get(patterns[0], ['cat_cow', 'dead_bug']):
        if drill_usable(cx, k):
            add(k)
    for k in MC.available_prep([patterns[0]], []):
        if drill_usable(cx, k):
            add(k)
    return keys or ['dead_bug']


# -- drill equipment (owner 2026-10-06 16:11/16:21) ---------------------------
# Machine-first prep: the drill the user named > gym standard > bodyweight >
# a small tool only when known to be there. Data: compose_rank_rules
# caution_policy (drill_equipment, prep_variants, better_with, named_drills,
# tool_words).
def _care_policy():
    return _compose_rules()['caution_policy']


def drill_class(code):
    return _care_policy()['drill_equipment'].get(code, 'none')


def place_key(place):
    """The key a place's small-tool record is stored under."""
    p = place or {}
    return str(p.get('name') or p.get('label') or p.get('venue') or '')


def tools_record(st):
    """(gym tools or None, carried tools or None): None = not known."""
    rec = st.get('tools') or {}
    gym = (rec.get('place') or {}).get(place_key(st.get('place')))
    carry = rec.get('carry')
    return (gym if isinstance(gym, list) else None,
            carry if isinstance(carry, list) else None)


def tool_known(st, tool):
    """True (the gym has it or the user carries it), False (both answered,
    neither has it), None (not known)."""
    gym, carry = tools_record(st)
    if tool in (gym or ()) or tool in (carry or ()):
        return True
    if gym is not None and carry is not None:
        return False
    return None


def drill_usable(cx, code):
    """The drill can be prescribed at this place: bodyweight always; a
    gym-standard class at a gym (or a place whose equipment lists it); a
    small tool only when known to be there."""
    cls = drill_class(code)
    pol = _care_policy()
    if cls == 'none':
        return True
    if cls in pol['small_tools']:
        return tool_known(cx.st, cls) is True
    allowed = allowed_equipment(cx)
    if allowed is None:
        return True
    want = {'kettlebell_or_dumbbell': ('dumbbell', 'kettlebell')}.get(cls, (cls,))
    return any(w in allowed for w in want)


def named_drills(cx, site):
    """The drills the user named for `site` in their own safety words
    (any interview; caution_care.segments keeps one site's stretch)."""
    import caution_care
    out = []
    for it in cx.st.get('safety_items') or []:
        if it.get('site') != site:
            continue
        text = ' '.join(caution_care.segments(care_words(cx, it), site))
        for row in _care_policy()['named_drills']:
            if (site in row['sites'] and row['drill'] not in out
                    and re.search(row['cue'], text, re.IGNORECASE)):
                out.append(row['drill'])
    return out


def _class_rank(code):
    cls = drill_class(code)
    pol = _care_policy()
    return 0 if cls in pol['gym_standard'] else 1 if cls == 'none' else 2


def site_drills(cx, site):
    """The site's prep drills in order: per slot of caution_policy.site_prep
    the user-named drill, else gym standard > bodyweight > a small tool
    known to be there; a better small-tool variant known to be there is
    taken outright."""
    pol = _care_policy()
    named = [k for k in named_drills(cx, site) if drill_usable(cx, k)]
    groups = [[head] + list(pol['prep_variants'].get(head, ()))
              for head in pol['site_prep'].get(site, ())]
    # a named drill of no slot takes the first slot none of the named fills
    loose = [k for k in named if not any(k in g for g in groups)]
    out = []
    for group in groups:
        hit = [k for k in named if k in group]
        if not hit and loose:
            hit = [loose.pop(0)]
        if hit:
            pick = hit[0]
        else:
            usable = sorted((k for k in group if drill_usable(cx, k)),
                            key=_class_rank)
            if not usable:
                continue
            pick = usable[0]
            better = pol['better_with'].get(pick)
            if better and tool_known(cx.st, drill_class(better)) is True:
                pick = better
        if pick not in out:
            out.append(pick)
    out += [k for k in loose if k not in out]
    # rungs that weigh the site add its targeted strengthening (056)
    import caution_care
    profile = care_profiles(cx).get(site)
    if profile is not None and caution_care.intensity(profile).get('strengthen'):
        out += [k for k in pol.get('site_strength', {}).get(site, ())
                if k not in out and drill_usable(cx, k)]
    return out


def better_swap(cx, code):
    """(better drill, tool) for the one in-session swap line when the
    better small-tool variant's availability is unknown, else None."""
    better = _care_policy()['better_with'].get(code)
    if better and tool_known(cx.st, drill_class(better)) is None:
        return better, drill_class(better)
    return None


