def handoff(cx):
    return cx.st.get("handoff") or {}


def _date_ko(iso):
    try:
        d = datetime.date.fromisoformat(str(iso)[:10])
    except ValueError:
        return None
    return d


def goal_direction(cx):
    """cut | grow | maintain for the card's goal line: the active goals'
    direction (goal_phase), else a stated maintain goal mode; None when
    nothing says (the line keeps the goal card's order)."""
    phase, _metric = goal_phase(cx.db)
    if phase:
        return phase
    mode = (config_value(cx.db, "goal_mode") or handoff(cx).get("goal_mode")
            or cx.st.get("goal_mode"))
    return "maintain" if mode == "maintain" else None


def handoff_goal_line(cx):
    """The program card's first line: the goal's direction ('cut body fat')
    and the deadline (owner rehearsal 2026-10-01); without a direction the
    goal card's order + deadline; None when the kit handed nothing over."""
    h = handoff(cx)
    ga = cx.st.get("goal_adjust") or {}
    # the card's own goal moved its date in the time decision: the new one
    horizon = ga["to"] if ga.get("card") and ga.get("to") else \
        h.get("horizon")
    d = _date_ko(horizon) if horizon else None
    date = T("card_date", y=d.year, m=d.month, d=d.day) if d else None
    direction = goal_direction(cx) if h else None
    if direction:
        what = T("goal_dir_" + direction)
        return T("card_goal", order=what, date=date) if date else what
    if h.get("order_line") and date:
        return T("card_goal", order=h["order_line"], date=date)
    if date:
        return T("card_goal_date", date=date)
    return h.get("order_line") or None


# -- safety ------------------------------------------------------------------
def kit_note_safety(cx):
    """Write the pack's safety answer back through the kit (goal-move-note
    --safety for the kit's move state, constraint-add per named site).
    Once per answer. True when the kit was told."""
    g = cx.st.get("goal") or {}
    wid = g.get("safety_why")
    if wid is None or cx.st.get("safety_noted") == cx.st.get("safety"):
        return False
    items = cx.st.get("safety_items") or []
    words = "; ".join(it.get("words") or UL.site_ko(it.get("site"),
                                                     it.get("side"))
                      for it in items) or "none"
    calls = [["goal-move-note", "--why-id", str(wid), "--safety", words]]
    known = {k for _s, _d, k in safety_rows(cx.db)}
    for it in items:
        key = "injury_%s%s" % (it["site"], "_" + it["side"]
                               if it.get("side") else "")
        if key in known:
            continue
        calls.append(["constraint-add", "--class", "safety", "--key", key,
                      "--value", it.get("words") or UL.site_ko(
                          it["site"], it.get("side")),
                      "--source", "interview"] + anchor_args("safety"))
    for c in calls:
        rc, _o, e = kit(c)
        if rc != 0:
            cx.st.setdefault("kit_errors", []).append(
                "%s: %s" % (c[0], (e or "").strip()[-200:]))
    cx.st["safety_noted"] = cx.st.get("safety")
    cx.save()
    return True


# -- caution care modes (owner 2026-10-05 10:41) ----------------------------
# A caution site carries the care the USER said it needs, never one fixed
# care for every site: prep (warm it before the lifts that load it),
# fatigue (keep its load days apart), frequency (cap its days a week),
# avoid (keep heavy loading off it). Read from the recorded words by the
# caution_care cue table; words that state none are asked ONCE per site at
# the split (the first stage the mode changes), and the answer goes back to
# the same kit constraint row as words, so it is read again, never re-asked.
CARE_ASK_STAGE = "split:care"


def _injury_key(it):
    return "injury_%s%s" % (it["site"], "_" + it["side"]
                            if it.get("side") else "")


def _constraint_row(cx, key):
    """(value, inviolable) of the active safety row for key, or None."""
    rows = _q(cx.db, "SELECT value, inviolable FROM ledger_constraint WHERE "
                     "class='safety' AND status='active' AND key=? "
                     "ORDER BY id DESC LIMIT 1", (key,))
    return (str(rows[0][0] or ""), rows[0][1]) if rows else None


def care_words(cx, it):
    """The user's words about one safety item: the kit row's (it carries an
    answered mode too), else the item's own (a 'same' answer has none)."""
    row = _constraint_row(cx, _injury_key(it))
    if row and not (it.get('care_from') == 'answer'
                    and row[0] == it.get('care_base_words')):
        return row[0]
    return str(it.get('words') or '')


def item_care(cx, it):
    """The item's modes: the answer on record, else what the words state;
    [] while unknown."""
    return list(item_care_profile(cx, it)['care'])


def care_modes(cx):
    """{site: [mode, ...]} over the safety items (split_model reads it)."""
    out = {}
    for it in cx.st.get("safety_items") or []:
        if it.get("site"):
            out[it["site"]] = list(dict.fromkeys(
                out.get(it["site"], []) + item_care(cx, it)))
    return out


def item_care_profile(cx, it):
    import caution_care
    words = care_words(cx, it)
    result = caution_care.profile_from_words(words, it["site"])
    # A later kit update (including pain-triage's outcome) supersedes the
    # cached answer. A failed / not-yet-visible write retains its local value.
    # Legacy r7 answers have no source snapshot; retain their explicit mode.
    if words == it.get('words') or 'care_base_words' not in it:
        for field in ("care", "severity", "recency"):
            if it.get(field) is not None:
                result[field] = it[field]
    return result


def user_site_name(cx, it):
    """A safety item's site with the side word the user used (caution_care
    side_words, e.g. the formal word for right), else the display layer's."""
    import caution_care
    side = it.get("side")
    side = {"right": "r", "left": "l"}.get(side, side)
    words = care_words(cx, it)
    row = _constraint_row(cx, _injury_key(it))
    if row:
        # an answer without a side word ('족저근막이 당기고 아픔'): the
        # record's own words name the side
        words += " " + row[0]
    for w in caution_care.rules().get("side_words", {}).get(side, ()):
        if w.lower() in words.lower():
            return "%s %s" % (w, UL.site_ko(it.get("site")))
    return UL.site_ko(it.get("site"), side)


def care_profiles(cx):
    """Read-only profiles, cached during compose's repeated draft probes.

    Item changes or a kit DB/WAL write invalidate the cache, including an
    external pain-triage update while a context remains in use.
    """
    import caution_care
    if not cx.st.get('safety_items'):
        return {}
    stamps = _db_stamp(cx.db) if cx.db else None
    signature = (json.dumps(cx.st.get('safety_items'), sort_keys=True),
                 stamps, id(caution_care.rules()))
    cached = getattr(cx, '_care_profiles_cache', None)
    if cached and cached[0] == signature:
        return cached[1]
    out = {}
    # Bilateral records share a split score: retain the stronger intensity.
    for it in cx.st.get("safety_items") or []:
        if not it.get("site"):
            continue
        profile = item_care_profile(cx, it)
        previous = out.get(it["site"])
        row = caution_care.intensity(profile)
        if previous:
            old = caution_care.intensity(previous)
            if (old['triage'], old['factor']) > (row['triage'], row['factor']):
                profile, previous = previous, profile
            profile = dict(profile, care=list(dict.fromkeys(
                caution_care.intensity(profile)['care']
                + caution_care.intensity(previous)['care'])))
        out[it["site"]] = profile
    cx._care_profiles_cache = (signature, out)
    return out


def care_pending(cx):
    """One merged ask per site, plus history's narrow timing follow-up."""
    for it in cx.st.get("safety_items") or []:
        if not it.get("site"):
            continue
        profile = item_care_profile(cx, it)
        if profile['severity'] is None or (profile['severity'] == 'history'
                                          and profile['recency'] is None):
            return it
    return None


def care_ask_move(cx, it):
    name = user_site_name(cx, it)
    timing = item_care_profile(cx, it)['severity'] == 'history'
    field = 'recency' if timing else 'severity'
    picks = ['recent', 'old'] if timing else ['mild', 'history', 'current']
    cx.st["care_ask"] = {"site": it["site"], "side": it.get("side"),
                         "field": field}
    cx.save()
    return pmove(cx, "ask", CARE_ASK_STAGE,
                 say=T("care_recency_ask" if timing else "care_ask",
                       site=name, eun=josa(name, "eun")) + "\n" + T("free_input"),
                 choices=[choice(m, T("care_c_" + m)) for m in picks],
                 answer={"stage": CARE_ASK_STAGE, "payload": {
                     "pick": " | ".join(picks + ["other"]),
                     "modes": "optional explicit care modes from the user's answer",
                     "words": "on other: the user's own words about the site"}})


def apply_care(cx, payload):
    """Persist the merged answer in the r7 item and kit constraint row."""
    import caution_care
    ask = cx.st.get("care_ask") or {}
    items = [it for it in cx.st.get("safety_items") or []
             if it.get("site") == ask.get("site")
             and it.get("side") == ask.get("side")]
    if not items:
        raise Refused("E-STAGE\tstage\tno care question is open (use next)")
    field = ask.get('field', 'severity')
    known = ['recent', 'old'] if field == 'recency' else ['mild', 'history', 'current']
    pick = payload.get('pick')
    modes = payload.get('modes')
    if modes is not None and (not isinstance(modes, list) or not modes
                              or any(m not in caution_care.modes() for m in modes)):
        raise Refused("E-PICK\tmodes\texpected explicit care modes")
    if pick == 'other':
        said = ' '.join(str(payload.get('words') or '').split())
        if not said:
            raise Refused("E-CARE\twords\ton other: the user's own words")
    elif pick in known:
        said = T('care_c_' + pick)
    else:
        raise Refused("E-PICK\tpick\texpected %s|other" % '|'.join(known))
    for it in items:
        before = item_care_profile(cx, it)
        # Include the old injury words so a timing-only answer is parsed.
        combined = T('care_record', words=care_words(cx, it), said=said,
                     site=user_site_name(cx, it))
        profile = caution_care.profile_from_words(combined, it['site'])
        if field == 'recency' and profile['severity'] is None:
            profile['severity'] = before['severity']
        profile[field] = pick if pick in known else (profile[field] or caution_care.UNKNOWN)
        if profile['severity'] != 'history':
            profile['recency'] = None
        profile['care'] = modes or profile['care'] or before['care']
        for key in ('care', 'severity', 'recency'):
            it[key] = profile[key]
        row = _constraint_row(cx, _injury_key(it))
        it['care_base_words'] = row[0] if row else None
        it['care_from'] = 'answer'
        if profile[field] == caution_care.UNKNOWN:
            said += T('care_said_sep') + T('care_unknown_' + field)
        record_modes = modes or [m for m in profile['care']
                                 if m in caution_care.modes() and m not in
                                 caution_care.modes_from_words(combined, it['site'])]
        if record_modes:
            said += T('care_said_sep') + T('care_said_sep').join(
                T('care_c_' + m) for m in record_modes)
        it['words'] = T('care_record', words=care_words(cx, it), said=said,
                        site=user_site_name(cx, it))
    kit_note_care(cx, items[0], said)
    cx.st.pop("care_ask", None)
    cx.st.pop("split_offer", None)


def kit_note_care(cx, it, said):
    """The answer back on the same kit constraint row, as words after the
    user's own ('<words> / <site>: <answer>'): the kit has no detail field
    for a constraint (constraint-add upserts the value), so the words carry
    it and the cue table reads it again. True when the kit took it."""
    key = _injury_key(it)
    row = _constraint_row(cx, key)
    words = row[0] if row else (it.get("words") or UL.site_ko(
        it["site"], it.get("side")))
    value = it.get("words") if it.get("care_from") == "answer" else None
    if said is None:
        value = value or words      # a backfill: the row's words stand
    value = value or T("care_record", words=words, said=said,
                       site=UL.site_ko(it["site"], it.get("side")))
    args = ["constraint-add", "--class", "safety", "--key", key,
            "--value", value, "--source", "program"]
    if row and row[1]:
        args.append("--inviolable")
    if kit_anchor_ready():
        args += ["--care", json.dumps(care_drills(it, said),
                                      ensure_ascii=False)]
        args += anchor_args("care.%s" % key, said)
    rc, _o, e = kit(args)
    if rc != 0:
        cx.st.setdefault("kit_errors", []).append(
            "constraint-add: %s" % (e or "").strip()[-200:])
    return rc == 0


# -- consult answers through kit verbs (consult-anchor, 2026-10-09) ----------
# Owner 2026-10-09 09:23/09:25: every consult answer lands in the lifekit
# system; the kit goal consult is the anchor that holds them. Each answer is
# written through a kit verb carrying --anchor health:<question> (kit 074
# consult_answer: the question, the user's words, the row that holds it).
# A kit before 074 has neither the verbs nor --anchor: the answer stays in
# plan state, its name goes to kit_pending (the kit's
# tools/consult-anchor-backfill.py lands it) -- never into another table.
ANCHOR_DOMAIN = "health"
_KIT_ANCHOR = {}


def kit_anchor_ready():
    """True when the kit has the 074 verbs (probed once per kit path)."""
    key = kit_path()
    if key not in _KIT_ANCHOR:
        rc, _o, _e = kit(["consult-answers", "--domain", ANCHOR_DOMAIN,
                          "--json"])
        _KIT_ANCHOR[key] = rc == 0
    return _KIT_ANCHOR[key]


def anchor_args(question, said=None):
    """--anchor health:<question> [--said <words>], or [] on an older kit."""
    if not kit_anchor_ready():
        return []
    out = ["--anchor", "%s:%s" % (ANCHOR_DOMAIN, question)]
    if said:
        out += ["--said", said]
    return out


def kit_land(cx, args, what):
    """One consult answer through a 074 kit verb. Replay: queued in
    kit_writes. Older kit: `what` in kit_pending. A refused write is a
    kit_errors line (never a silent success). True when the kit took it."""
    if not getattr(cx, "side_effects", True):
        cx.st.setdefault("kit_writes", []).append(list(args))
        return False
    if not kit_anchor_ready():
        pend = cx.st.setdefault("kit_pending", [])
        if what not in pend:
            pend.append(what)
        return False
    rc, out, e = kit(args)
    if rc != 0:
        cx.st.setdefault("kit_errors", []).append(
            "%s: %s" % (args[0], (e or out or "").strip()[-200:]))
        return False
    return True


def kit_json(args):
    """A kit read verb's --json answer, or None."""
    rc, out, _e = kit(args)
    if rc != 0:
        return None
    try:
        return json.loads(out)
    except (TypeError, ValueError):
        return None


def care_drills(it, said):
    """The site's care as the kit's structured list (ledger_constraint.care):
    a drill the user named (a movement-catalog drill for this site whose
    name appears in their words) runs before; then each care mode the
    answer holds (prep before, the others anytime). The words ride along."""
    import movement_catalog as MC
    words = " ".join(x for x in (it.get("words"), said) if x)
    out = []
    for key, e in MC.MOVEMENTS.items():
        if it.get("site") not in (e.get("caution") or ()):
            continue
        toks = [t for t in re.split(r"[\s()]+", e.get("ko") or "")
                if len(t) >= 3]
        if any(t in words for t in toks):
            out.append({"drill": key, "when": "before"})
    for m in it.get("care") or ():
        out.append({"drill": m, "when": "before" if m == "prep"
                    else "anytime"})
    if out and said:
        out[0]["words"] = said
    return out


def land_gym(cx, cur):
