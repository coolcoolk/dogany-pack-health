        for items in days.values())
    mode = compose_rank.goal_mode(cx, config_value, goal_phase)
    caps = day_windows(st.get('daytime'), st.get('available_minutes'))
    timed = any(m is not None for m in caps.values()) or st.get('available_minutes')
