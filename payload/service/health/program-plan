def brief_morning_time(cx):
    """HH:MM, BRIEF_LEAD_MIN before the earliest regular window start; None
    when no window carries a time (a time is never picked for the user)."""
    starts = sorted(w["start"] for w in
                    (cx.st.get("daytime") or {}).get("windows") or ()
                    if w.get("start"))
    if not starts:
        return None
    h, m = (int(x) for x in starts[0].split(":"))
    x = (h * 60 + m - BRIEF_LEAD_MIN) % (24 * 60)
    return "%02d:%02d" % (x // 60, x % 60)


def finish(cx):
    """After the program is written: kit bookkeeping, the calendar and the
    prep file, then the program's closing message -- and the setup tail
    opens (diet, first session, brief / retro times, wrap)."""
    today = cx.today.isoformat()
    # read before anything moves the ledger: the diet step runs while the
    # diet module is open
    # the calorie step inside the goal part settled it: never asked twice
    cx.st["tail_diet"] = diet_ask_due(cx) and (
        (cx.st.get("calorie") or {}).get("status") != "set")
    if cx.side_effects:
        cur = config_value(cx.db, "consult_modules")
        rc, _o, e = kit(["config-set", "consult_modules=%s"
                         % merge_modules(cur, today)])
        if rc != 0:
            cx.st.setdefault("kit_errors", []).append(
                "config-set: %s" % (e or "").strip()[-200:])
        cx.st["calendar"] = register_calendar(cx)
    else:
        # a replay: the kit's DB and calendar are the instance's, whatever
        # --db says (kit_life.sh binds its own database/kit_life.db)
        cx.st["calendar"] = False
        cx.st["side_effects"] = "skipped"
    cx.st["tail_brief"] = brief_available(cx)
    cx.st["tail"] = "open"
    write_prep_file(cx)
    cx.st["written"] = today
    cx.save()
    refresh_workbench(cx)
    return finish_move(cx)


def next_session(cx):
    """(date, weekday, start or None, session code): the first regular day
    after today and the session the queue opens with."""
    days = cx.st["days"]["weekdays"]
    for k in range(1, 8):
        d = cx.today + datetime.timedelta(days=k)
        wd = UL.WEEKDAY_ORDER[d.weekday()]
        if wd in days:
            break
    start = None
    for w in (cx.st.get("daytime") or {}).get("windows") or ():
        if wd in w["weekdays"]:
            start = w.get("start")
    return d, wd, start, cx.st["structure"]["rotation"][0]


CHECK_ITEMS = ("goal", "caution", "spacing", "practice", "cardio", "health")


def checked_line(cx):
    """The self-check folded into one line (owner 2026-10-06 21:46: the
    six-bullet block is gone), only the checks actually made."""
    checks = cx.st.get("self_check") or {}
    items = []
    for key in CHECK_ITEMS:
        label = T("check_" + key)
        if not checks.get(key):
            continue
        if key == "caution" and not cx.st.get("safety_items"):
            continue
        if key == "practice" and not chosen_practices(cx):
            continue
        items.append(label)
    if not items:
        return ""
    line = T("done_checked", items=", ".join(items))
    moved = cardio_where(cx.st.get("time_plan"), "done_cardio_moved_short")
    return line + (" " + moved if moved and checks.get("cardio") else "")


def calendar_line(cx):
    """What went on the calendar (and what it replaced), one line, or ''."""
    if not cx.st.get("calendar"):
        return ""
    measure = bool(cx.st.get("calendar_measure"))
    old = cx.st.get("calendar_replaced") or []
    if cx.st.get("calendar_existing_answered") == "keep":
        return T("done_calendar_kept")
    if old:
        titles = []
        for w in old:
            t = T("done_title", title=w["title"])
            if t not in titles:
                titles.append(t)
        since = [d for d in (_date_ko(w.get("since") or "") for w in old)
                 if d and d <= cx.today]
        return T("done_calendar_replaced",
                 what=T("done_what_measure" if measure else "done_what"),
                 since=(T("measure_since", m=min(since).month)
                        if since else ""),
                 titles="·".join(titles))
    return T("done_calendar_measure" if measure else "done_calendar")


def finish_move(cx):
    """The program's closing message (owner 17:48, amended 2026-10-06
    21:46): the full card, "the program is done", the self-check in one
    line. It asks nothing -- and it is never the end: `then` carries the
    setup tail's first question, sent as its OWN message right after (the
    first session, the times and the calendar are said by the tail and its
    wrap, never dumped here)."""
    d, wd, start, first = next_session(cx)
    # a decision taken on the last step (the time pick: what a short day
    # loses) is said once more here, as pmove says it on any other step
    said = []
    for n in cx.st.get("notes") or []:
        if n.get("at") is None:
            n["at"] = "done"
            cx.save()
        if n["at"] == "done":
            said.append(n["text"])
    check = checked_line(cx)
    parts = said + [T("done") + ("\n" + check if check else "")]
    if cx.st.get("program_archived"):
        parts.append(T("done_archived"))
    card = program_card(cx)
    then = tail_move(cx) if tail_open(cx) else None
    mv = move("done", "done", say="\n\n".join(parts),
              readback=[card], card=card,
              next_session={"date": d.isoformat(), "session": first,
                            "time": start},
              care=cx.st.get("care") or [],
              kit_errors=cx.st.get("kit_errors") or [])
    if then:
        mv["then"] = then
        mv["for_model"] = (
            "Send the readback + `say` as one message (it asks nothing), "
            "then `then.say` with `then.choices` as buttons as a SECOND "
            "message in the same reply: the setup goes on, never a dead stop.")
    return mv


