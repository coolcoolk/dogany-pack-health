    areas = set(compose_focus(cx))
    return [m for m, r in MUSCLE_REGION if m in areas or r in areas]


def goal_keep(cx, g, short=()):
    """[muscle] goal g needs most from the lifts, first first (see
    CUT_KEEP)."""
    if g["metric"] in CUT_GOAL_METRICS:
        return list(CUT_KEEP)
    out = focus_muscles(cx) + [s_["muscle"] for s_ in short] + list(CUT_KEEP)
    return list(dict.fromkeys(out))


def goal_adjust_target(cx, short=()):
    """None, or {kind, goal, first, recorded, goals, keep}: what a strength
    cut adjusts, by priority, and what the surviving goal keeps (keep).
    kind `deadline` / `focus`: the lowest-priority strength-served goal
    (never the top one while another competes) -- its date moves when it has
    one, else it leaves the focus; a single strength goal moves its own
    date. kind `fat`: a strength goal first and a fat / weight goal lower --
    the lower goal's cardio gives its minutes to strength (its date moved
    by the kit's energy model, or it leaves the focus when no record can
    compute one: _time_decision decides). kind `branch`: a cut goal and no
    strength goal -- the muscle-keeping branch of the cut's direction is
    eased (the fat goal and its date stay)."""
    goals, recorded = goal_order(cx)
    if not goals:
        return None
    strength = [g for g in goals if g["metric"] in STRENGTH_GOAL_METRICS
                and g["dir"] == "up"]
    cut = [g for g in goals if g["metric"] in CUT_GOAL_METRICS
           and g["dir"] == "down"]
    out = dict(first=goals[0], recorded=recorded, goals=goals,
               keep=goal_keep(cx, goals[0], short))
    if strength:
        low = strength[-1]
        if low is goals[0] and len(goals) > 1:
            # the strength goal comes first: the lower fat goal gives way
            lower = [g for g in cut if g is not goals[0]]
            if not lower:
                return None
            return dict(out, kind="fat", goal=lower[-1])
        return dict(out, kind="deadline" if low["horizon"] else "focus",
                    goal=low)
    if cut:
        return dict(out, kind="branch", goal=cut[0])
    return None


def _latest(cx, keys):
    """The latest metric_log value under one of `keys`, or None."""
    rows = _q(cx.db, "SELECT value FROM metric_log WHERE metric IN (%s) "
                     "AND value IS NOT NULL ORDER BY date DESC, id DESC "
                     "LIMIT 1" % ",".join("?" * len(keys)), tuple(keys))
    try:
        return float(rows[0][0]) if rows else None
    except (TypeError, ValueError):
        return None


def fat_energy(cx, g, cut_minutes, n):
    """None, or {need, less, frac, fat_now, fat_goal, ffm}: what `cut_minutes`
    less cardio a session (n sessions a week) costs the fat goal g, from the
    kit's own energy model -- the fat left to the target in kg (fat-free
    mass held, as the kit's pace does) over the days left is the daily
    deficit its date needs (need); the cardio's active kcal a day is what
    the cut takes from it (less); frac = the share of the rate kept. None
    when a record it needs (weight, body fat, the target, the cardio type)
    is missing or nothing is left to lose: never an invented number."""
    if g["metric"] != "body_fat_pct" or not g.get("horizon"):
        return None
    w = _latest(cx, ("weight_kg", "body_weight"))
    bf = _latest(cx, ("body_fat_pct",))
    met = MC.CARDIO_CATALOG.get((cx.st.get("cardio") or {}).get("pick"),
                                {}).get("met")
    try:
        target = float(g["target"])
        end = datetime.date.fromisoformat(str(g["horizon"])[:10])
    except (TypeError, ValueError):
        return None
    left = (end - cx.today).days
    if not (w and bf and met and 0 < target < bf < 100 and left > 0):
        return None
    fat_now = w * bf / 100.0
    ffm = w - fat_now
    fat_goal = ffm * target / (100.0 - target)
    need = (fat_now - fat_goal) * FAT_KCAL_PER_KG / left
    less = (met - 1) * w * cut_minutes / 60.0 * n / 7.0
    if need <= 0 or less <= 0 or less >= need:
        return None
    return dict(need=need, less=less, frac=(need - less) / need,
                fat_now=fat_now, fat_goal=fat_goal, ffm=ffm, left=left,
                end=end)


