def tail_move(cx):
    """The open step's question, the last answer's one-line receipt on top
    (the step it closes is said once, then the next decision)."""
    step = tail_step(cx)
    if step is None:
        return None
    mv = tail_ask(cx, step)
    lead = cx.st.pop("tail_lead", None)
    if lead:
        cx.save()
        mv = dict(mv, say=lead + "\n\n" + mv["say"])
    mv["for_model"] = (mv.get("for_model") or "") + (
        " Setup tail (one conversation to the end): send `say` with "
        "`choices` as buttons; the user's own words also answer (a skip "
        "included). Answer with `program-plan answer --stage %s`." % step
    ).strip()
    return mv


def wrap_move(cx):
    """The tail's last message: what was set, one line each; asks nothing."""
    st = cx.st
    lines = [T("wrap_head")]
    fs = st.get("first_session") or {}
    if fs.get("date"):
        day = datetime.date.fromisoformat(fs["date"])
        line = T("wrap_first", when=_day_when(day, fs.get("time")),
                 first=fs.get("session"))
        if fs.get("pick") == "next" and fs.get("time") and st.get("calendar"):
            line += T("wrap_first_notice")
        lines.append(line)
    bs = st.get("brief_standard") or {}
    slots = st.get("brief_slots") or {}
    said_brief = None
    if st.get("tail_brief") and bs.get("status") in ("refused", "error"):
        said_brief = bs.get("say") if bs.get("status") == "refused" \
            else T("wrap_brief_failed")
    elif st.get("tail_brief"):
        for slot, key in (("brief", "wrap_brief"), ("retro", "wrap_retro"),
                          ("weekly", "wrap_weekly")):
            v = slots.get(slot) or {}
            when = (T("wrap_off") if v.get("off") else
                    slot_when("weekly", (v["day"], v["time"]))
                    if slot == "weekly" else slot_when(slot, v.get("time")))
            lines.append(T(key, when=when))
    if st.get("tail_diet"):
        pick = st.get("diet_answered")
        nums = st.get("diet_numbers") or (diet_numbers(cx) if pick in
                                          ("start", "set") else None)
        lines.append(T("wrap_diet_skip") if pick == "skip" else
                     T("wrap_diet", kcal=format(nums[0], ","),
                       protein=nums[1]) if nums else T("wrap_diet_set"))
    if st.get("records_answered"):
        lines.append(T("wrap_records_" + ("on" if st["records_answered"] == "yes"
                                          else "off")))
    parts = ["\n".join(lines)]
    cal = calendar_line(cx)
    if cal:
        parts.append(cal)
    if said_brief:
        parts.append(said_brief)
    if st.get("automation_answered"):
        parts.append(T("consent_skipped" if st["automation_answered"] == "skip"
                       else "consent_done"))
    st["tail"] = "closed"
    cx.save()
    return move("done", "wrap", say="\n\n".join(parts),
                first_session=fs or None,
                brief=slots or None, brief_standard=bs or None,
                kit_errors=st.get("kit_errors") or [])


