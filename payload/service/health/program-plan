def ramp_plan(cx, code, items):
    """{lift: [warm-up reps, ...]} of a session under a set style with a
    ramp (rules set_style ramp): rungs per lift class, the reps the session's
    own taper gives them (ax_engine ramp_taper_reps, by position: the weight
    is measured on the day). Never counted as working sets: the working sets
    stay the slot's `sets`. Core, holds and practice rows take none."""
    _style, spec = set_style_spec(cx)
    ramp = (spec or {}).get("ramp")
    if not ramp:
        return {}
    import compose_rank
    import ax_engine
    practice = compose_rank.practice_only_names(_compose_rules())
    out = {}
    for ex, kind in zip(items, lift_kinds(cx, items)):
        d, _w = dose(cx, ex["name"])
        if (kind == KIND_CORE or d is None or d["unit"] == "sec"
                or ex["name"] in practice):
            continue
        n = ramp["rungs"]["isolation" if kind == KIND_SMALL else "compound"]
        rows = [{"rung": "ramp_%d" % (k + 1)} for k in range(n)]
        out[ex["name"]] = ax_engine.ramp_taper_reps(rows, None,
                                                    d["rep_range"][1])
    return out


def style_lines(cx, fd):
    """The set style's line on the sessions card, or []: the working sets,
    their effort and that the warm-up sets are not counted."""
    _style, spec = set_style_spec(cx)
    if not (spec or {}).get("ramp"):
        return []
    working = sorted({sets_for(cx, c, ex["name"], dose(cx, ex["name"])[0]["sets"])
                      for c in cx.st["structure"]["rotation"]
                      for ex in fd.get(c) or ()
                      if (dose(cx, ex["name"])[0] or {}).get("unit") != "sec"})
    lines = [T("sess_style_intensity", sets=_span(working or [2]))]
    if any(g19_class(cx, ex["name"]) for items in fd.values() for ex in items):
        lines.append(T("sess_style_g19"))
    return [" ".join(lines)]


def session_block(cx, fd, code):
    items = fd[code]
    lines = [T("sess_head", code=code, title=session_title(cx, items, code))]

    def add(text):
        lines.append(T("sess_line", text=text))

    blocks = (cx.st.get("practice_blocks") or {}).get(code) or {}
    i = 1
    flow = blocks.get("flow")
    if flow and flow.get("drills") and cx.st.get('trainer_fit'):
        import compose_rank
        drills = MC.distinct_drills(cx.st['prep'][code] + flow['drills'])
        minutes = PREP_MINUTES + flow['minutes'] - compose_rank.prep_overlap(chosen_practices(cx))
        add(T('sess_prep', i=i, minutes=minutes,
              names=', '.join(UL.plan_drill_ko(k) for k in drills)))
    else:
        if flow and flow.get("drills"):
            add(T("sess_flow", i=i, minutes=flow["minutes"],
                  names=", ".join(UL.plan_drill_ko(k) for k in flow["drills"])))
            i += 1
        add(T("sess_prep", i=i, minutes=PREP_MINUTES,
              names=", ".join(UL.plan_drill_ko(k) for k in cx.st["prep"][code])))
    power = blocks.get("power")
    if power and power.get("key"):
        i += 1
        lo, hi = power["rep_range"]
        if power.get("lift"):
            # no explosive move clears the caution sites: speed sets of the
            # first lift, which compose already screened
            ex = next((x["display"] for x in items if x["name"] == power["lift"]),
                      UL.exercise_ko(power["lift"]))
            add(T("sess_power_speed", i=i, minutes=power["minutes"], ex=ex,
                  sets=power["sets"], lo=lo, rest=power["rest_sec"]))
        else:
            add(T("sess_power", i=i, minutes=power["minutes"], ex=power["display"],
                  sets=power["sets"], lo=lo, hi=hi, rest=power["rest_sec"]))
    ramps = ramp_plan(cx, code, items)
    for i, ex in enumerate(items, i + 1):
        d, _w = dose(cx, ex["name"])
        sets = sets_for(cx, code, ex["name"], d["sets"])
        lo, hi = d["rep_range"]
        key = "sess_lift_sec" if d["unit"] == "sec" else "sess_lift_reps"
        if ramps.get(ex["name"]):
            key = "sess_lift_ramp"
        add(T(key, i=i, ex=ex["display"], sets=sets, lo=lo, hi=hi,
              ramp="\u00b7".join(str(r) for r in ramps.get(ex["name"]) or ()),
              muscles=lift_muscles(cx, ex["name"])))
    i += 1
    finisher = blocks.get("finisher")
    if finisher and finisher.get("key"):
        add(T("sess_finisher", i=i, minutes=finisher["minutes"],
              ex=finisher["display"], work=finisher["work_sec"],
              rest=finisher["rest_sec"], rounds=finisher["rounds"]))
        i += 1
    circuit = blocks.get("circuit")
    if circuit and circuit.get("keys") and circuit.get("minutes"):
        add(T("sess_circuit", i=i, minutes=circuit["minutes"],
              names=" → ".join(circuit["display"]), work=circuit["work_sec"],
              rounds=circuit["rounds"]))
        i += 1
    cardio = cx.st.get("cardio")
    if cardio and cardio.get("pick") != "none":
        tp = cx.st.get("time_plan")
        add(cardio_where(tp, "sess_cardio_moved", i=i,
                         minutes=cardio["minutes"], name=cardio["display"])
            or T("sess_cardio", i=i, minutes=cardio["minutes"],
                 name=cardio["display"]))
        i += 1
    add(T("sess_cooldown", i=i, minutes=COOLDOWN_MINUTES,
          names=", ".join(UL.plan_drill_ko(k)
                          for k in MC.distinct_drills(cx.st["cooldown"][code]))))
    return "\n".join(lines)


NATIVE_COUNT = {2: "두", 3: "세", 4: "네", 5: "다섯", 6: "여섯"}


def set_minutes():
    """One more working set with its rest (a compound at the base sets, the
    compose rules' budget): what the extra minutes are counted in."""
    import compose_rank
    b = compose_rank.load_rules()["budget"]
    return b["compound_minutes"] / float(b["base_sets"])


def extend_day(cx, extra):
    """The sessions answer `extend`: the planned day grows by the offered
    minutes (never past the user's own), and the sessions are composed
    again to it."""
    st = cx.st
    total = day_total(cx) + extra
    st["day_minutes"] = total
    tp = st.setdefault("time_plan", {"status": "set", "pick": "fits"})
    tp.update(total=total, decided=True)
    for k in ("compose", "volume_shortfall", "sessions", "time_decision"):
        st.pop(k, None)
    st.setdefault("notes", []).append({"text": T("sess_extended",
                                                 total=total), "at": None})


def _span(values):
    low, high = min(values), max(values)
    return str(low) if low == high else T('trainer_range', low=low, high=high)


def trainer_lines(cx, fd, fit):
    """The three rationale lines of a trainer-fit program, in plain words:
    the day-length range inside the window, the priority, and what the week
    holds (or the named scope reduction)."""
    rot = cx.st["structure"]["rotation"]
    hours, minutes = divmod(int(fit['window']), 60)
    window = (T('trainer_window_hours', hours=hours) if hours and not minutes else
              T('trainer_window_mixed', hours=hours, minutes=minutes) if hours else
              T('trainer_window_minutes', minutes=minutes))
    lines = [T('trainer_time', range=_span([fit['minutes'][c] for c in rot]), window=window),
             T('trainer_priority')]
    if fit.get('adjusted'):
        return lines + [T('trainer_adjusted')]
    # the claim is computed from every main lift the week holds (the first
    # compound of each region, lift_kinds), never from the first lift alone
    # (a "3-4 sets" claim was once said over 2-set mains); "충분히"
    # only when each reaches primary_min_sets
    mains = main_sets(cx, fd)
    import compose_rank
    full = min(mains or [set_level(cx)]) >= compose_rank.primary_min_sets(
        compose_rank.experience_facts(cx, config_value), _compose_rules())
    blocks = any((cx.st.get('practice_blocks') or {}).values())
    key = ('trainer_complete' if full else 'trainer_short') + ('' if blocks else '_plain')
    return lines + [T(key, sets=_span(mains or [set_level(cx)]))]


def main_sets(cx, fd):
    """The working sets of every main lift (lift_kinds KIND_MAIN, loaded,
    core aside) across the rotation, in order."""
    out = []
    for code in cx.st["structure"]["rotation"]:
        items = fd.get(code) or []
        for ex, kind in zip(items, lift_kinds(cx, items)):
            d = dose(cx, ex["name"])[0]
            if kind != KIND_MAIN or d["unit"] == "sec":
                continue
            out.append(sets_for(cx, code, ex["name"], d["sets"]))
    return out


def press_angle_line(cx, fd):
    """The angle of the week's incline press, said once (rules coverage
    pairs press_angle: the low incline is 15-30 degrees; owner live consult
    2026-10-07 15:52-15:54). None when the week holds no incline press."""
    for code in cx.st["structure"]["rotation"]:
        for ex in fd.get(code) or ():
            if "incline" in ex["name"] and "push_up" not in ex["name"] \
                    and "curl" not in ex["name"]:
                return T("press_angle_note", lift=ex["display"],
                         eun=josa(ex["display"], "eun"))
    return None


def sessions_move(cx, fd, lone=()):
    rot = cx.st["structure"]["rotation"]
    checks = self_check(cx)
    paras = [session_block(cx, fd, code) for code in rot]
    fit = cx.st.get('trainer_fit') or {}
    if fit:
        paras.append('\n'.join(trainer_lines(cx, fd, fit)))
    paras.extend(style_lines(cx, fd))
    caution = caution_lines(cx, fd)
    if caution:
        paras.append("\n".join(caution))
    angle = press_angle_line(cx, fd)
    if angle:
        paras.append(angle)
    if lone:
        regions = T("sm_site_sep").join(UL.muscle_ko(r, cx.db) for r in lone)
        paras.append(T("sess_lone", regions=regions,
                       eun=josa(regions, "eun")))
    short = (cx.st.get("volume_shortfall") or []
             if checks.get("goal") is None else [])
    dec = time_decision(cx, checks)
    if checks.get("goal"):
        paras.append(T("sess_volume"))
    elif short or dec:
        # the order line on its own, never glued to the shortfall
        paras.append(T("sess_order"))
    if short and not dec:
        # decided already (or nothing to choose): the numbers, once
        paras.append(T("tc_floor", items=volume_items(cx, short),
                       gap=floor_gap(short)))
    practice = program_practice(cx, fd)
    for said in (practice_line(cx, practice), functional_line(cx, practice)):
        if said:
            paras.append(said)
    if dec and dec["opts"]:
        # ONE decision (owner 2026-10-04 19:05): more time, something less
        # important out, or as it is; the recommendation in the body only
        paras.append(" ".join(dec["lead"]) + " " + T("rc_lead"))
        for i, o in enumerate(dec["opts"]):
            paras.append(T("opt_title", n=i + 1, title=o["title"] + (
                REC if o["pick"] == dec["rec"] else "")) + "\n"
                + T("rc_line", text=o["line"]) + (
                    "\n" + T("rc_line", text=o["detail"])
                    if o.get("detail") else ""))
        paras.append(dec["why"] + "\n" + T("tc_close"))
        choices = [dict(choice(o["pick"], o["title"]),
                        recommended=o["pick"] == dec["rec"])
                   for o in dec["opts"]]
        cx.st["time_decision"] = {
            "picks": [o["pick"] for o in dec["opts"]],
            "extend": next((o["extend"] for o in dec["opts"]
                            if o["pick"] == "extend"), None),
            "stretch_ext": next((o["ext"] for o in dec["opts"]
                                 if o["pick"] == "stretch"), 0),
            "goal": next((o["goal"] for o in dec["opts"]
                          if o["pick"] == "goal"), None),
            "goal_narrow": next((o["goal"] for o in dec["opts"]
                                 if o["pick"] == "goal_narrow"), None),
            "notes": dec.get("notes") or {}, "sig": dec.get("sig"),
            "dec": dec}
    else:
        if dec:
            paras.append(" ".join(dec["lead"]))
        # the accept / edit decision is the last line, trainer fit or not:
        # rationale and caution notes above it never close the message
        paras.append(T("sess_ask", count=NATIVE_COUNT[len(rot)])
                     if len(rot) in NATIVE_COUNT else T("sess_ask_one"))
        choices = [choice("ok", T("c_sess_ok"), True),
                   choice("change", T("c_sess_change"))]
        cx.st.pop("time_decision", None)
    cx.save()
    picks = [c["pick"] for c in choices] + (
        ["change"] if "change" not in [c["pick"] for c in choices] else [])
    flip = ((cx.st.get("time_decision") or {}).get("goal") or {}).get(
        "assumed")
    extra_ans = ({"first_goal": "optional, the goal id the user puts "
                  "first when the order was assumed (said in the goal "
                  "option): " + ", ".join("%d=%s" % (x["id"], x["name"])
                                          for x in flip)} if flip else {})
    return pmove(cx, "propose", "sessions", say="\n\n".join(paras),
                 choices=choices,
                 answer={"stage": "sessions", "payload": dict({
                     "pick": " | ".join(picks),
                     "weekday": "optional, MON..SUN: on cardio_extra / "
                                "add_day, the day the user named when no "
                                "supplementary day was given",
                     "days / prep / cooldown": "on change: ONLY the "
                     "sessions that change, each complete, same shape as "
                     "compose (names only)"}, **extra_ans)})


