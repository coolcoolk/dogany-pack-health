class Refused(Exception):
    pass


def _pick(payload, allowed):
    p = payload.get("pick") if isinstance(payload, dict) else None
    if p not in allowed:
        raise Refused("E-PICK\tpick\texpected one of %s, got %r"
                      % ("|".join(allowed), p))
    return p


def _site_items(payload):
    items = payload.get("items")
    if not isinstance(items, list) or not items:
        raise Refused("E-SAFETY-ITEMS\titems\tname at least one site")
    out = []
    for i, it in enumerate(items):
        if not isinstance(it, dict) or it.get("site") not in UL.SITE_KO:
            raise Refused("E-SAFETY-SITE\titems[%d].site\tone of %s"
                          % (i, ", ".join(sorted(UL.SITE_KO))))
        if it.get("side") not in (None, "l", "r"):
            raise Refused("E-SAFETY-SIDE\titems[%d].side\tl | r | null" % i)
        out.append({"site": it["site"], "side": it.get("side"),
                    "words": str(it.get("words") or "")})
    return out


def apply_patch(cx, payload):
    """C: a correction riding a later answer ("1번, 근데 금요일은 6~8시") is
    applied at once -- never a question back. Today: the daytime."""
    patch = payload.get("patch")
    if patch is None:
        return
    if not isinstance(patch, dict) or set(patch) - {"daytime"}:
        raise Refused("E-PATCH\tpatch\t{daytime: {windows, extra_windows?}}")
    if "daytime" in patch:
        if not cx.st.get("daytime"):
            raise Refused("E-PATCH\tpatch.daytime\tthe days are not set yet")
        record_daytime(cx, parse_daytime(patch["daytime"]))


def apply_answer(cx, stage, payload):
    st = cx.st
    if not isinstance(payload, dict):
        raise Refused("E-SHAPE\t<root>\tpayload must be a JSON object")
    if stage != "automation":
        check_stage_order(cx, stage)
    if payload.get("pick") == "later" and stage != "safety":
        # the user said "later" first: heard, never offered (D5b) -- the
        # state is kept, the next `next` resumes where it stopped
        st["offer"] = "later"
        return
    if st.get("offer") == "later":
        st.pop("offer", None)
    apply_patch(cx, payload)
    if stage == "safety":
        p = _pick(payload, ("none", "some", "same", "changed"))
        rows = [{"site": s, "side": d} for s, d, _k in safety_rows(cx.db)]
        if p == "none":
            items = []
        elif p == "same":
            items = rows
        else:
            items = _site_items(payload)
        st["safety"] = cx.today.isoformat()
        st["safety_items"] = items
        st.pop("safety_noted", None)
        kit_note_safety(cx)
    elif stage == "focus":
        p = _pick(payload, ("even", "other", "keep"))
        if p == "even":
            st["focus_areas"] = []
        else:
            areas = payload.get("areas")
            if p == "keep" and not areas:
                areas = init_mod()._load_rx().load_yaml(cx.program).get(
                    "focus_areas") or []
            if not isinstance(areas, list) or not areas or any(
                    a not in FOCUS_AREAS for a in areas):
                raise Refused("E-FOCUS\tareas\tlist from %s"
                              % ", ".join(FOCUS_AREAS))
            st["focus_areas"] = list(dict.fromkeys(areas))
    elif stage == "place":
        cur = st.get("place")
        known = init_mod().LATTICE_BY_EQUIPMENT
        if cur and cur.get("venue") is None and cur.get("label"):
            p = _pick(payload, ("full", "partial"))
            if p == "full":
                cur.update({"venue": "gym", "equipment": []})
            else:
                eq = payload.get("equipment")
                if not isinstance(eq, list) or any(e not in known for e in eq):
                    raise Refused("E-EQUIPMENT\tequipment\tlist from %s"
                                  % ", ".join(sorted(known)))
                cur.update({"venue": "other", "equipment": eq})
        elif cur and cur.get("venue") == "home" and "equipment" not in cur:
            p = _pick(payload, ("have", "have_not"))
            cur["equipment"] = ["dumbbell"] if p == "have" else []
        elif gym_name_pending(cur):
            p = _pick(payload, ("named", "unnamed"))
            if p == "unnamed":
                cur["name"] = None
            else:
                name = " ".join(str(payload.get("name") or "").split())
                area = " ".join(str(payload.get("area") or "").split())
                if not name:
                    raise Refused("E-PLACE-NAME\tname\tthe gym's name as "
                                  "the user said it")
                try:
                    _copy_gate(name, "place.name")
                except CopyLeak as e:
                    raise Refused("E-PLACE-NAME\tname\t%s" % e)
                cur["name"] = name
                if area:
                    cur["area"] = area
                register_gym(cx, name, area)
        else:
            p = _pick(payload, ("gym", "home", "other"))
            place = {"venue": p, "source": "answer",
                     "words": str(payload.get("words") or "")}
            if p == "other":
                eq = payload.get("equipment")
                if not isinstance(eq, list) or any(e not in known for e in eq):
                    raise Refused("E-EQUIPMENT\tequipment\tlist from %s"
                                  % ", ".join(sorted(known)))
                place["equipment"] = eq
            elif p == "gym":
                place["equipment"] = []
            st["place"] = place
        if 'facilities' in payload:
            from compose_rank import load_rules
            known_facilities = {v for values in load_rules()['availability']['requirements'].values() for v in values}
            facilities = payload['facilities']
            if not isinstance(facilities, list) or any(v not in known_facilities for v in facilities):
                raise Refused('E-EQUIPMENT\tfacilities\tdeclare available equipment and space')
            st['place']['facilities'] = list(dict.fromkeys(facilities))
    elif stage == "experience":
        pending = st.get("experience_pending")
        allowed = (YEARS_BANDS if pending else tuple(EXP_PICKS) + ("ask",))
        p = _pick(payload, allowed)
        if p == "ask":
            # the returner reading was wrong: fall through to the plain ask
            st["experience_record_rejected"] = True
            return
        hist, band = (pending, p) if pending else EXP_PICKS[p]
        record_experience(cx, hist, band)
    elif stage == "frequency":
        n, m = parse_frequency(payload)
        if m is not None and day_parts(cx, m)["strength"] < STRENGTH_MIN:
            parts = day_parts(cx, 0)
            raise Refused("E-FREQUENCY\tminutes\tthe whole day, at least %d "
                          "(prep, cardio and cooldown take %d)"
                          % (STRENGTH_MIN - parts["strength"],
                             -parts["strength"]))
        if n is None:
            # the minutes alone: kept, and the count is asked by itself
            st["day_minutes_pending"] = m
            st.pop("frequency", None)
            return
        m = m or st.pop("day_minutes_pending", None) or \
            day_minutes_rec(cx)["rec"]
        st.pop("day_minutes_pending", None)
        dt = st.get("daytime")
        if dt and len(dt.get("weekdays") or ()) != n:
            # a new count after the days: the days are asked again for it
            for k in ("daytime", "days", "structure", "split_offer",
                      "time_plan"):
                st.pop(k, None)
        if st.get("day_minutes") != m:
            # sessions are built to the minutes: a new length re-splits and
            # is checked against the days again
            for k in ("structure", "split_offer", "time_plan"):
                st.pop(k, None)
        st["frequency"] = n
        st["day_minutes"] = m
    elif stage == "calendar_existing":
        pick = _pick(payload, ("keep", "modify"))
        items = existing_calendar_items(cx)
        st["calendar_existing_answered"] = pick
        st["calendar_existing_items"] = items
        if pick == "keep":
            routines = [x for x in items if x["source"] == "routine" and x["kind"] == "exercise"]
            windows = [{"weekdays": x["weekdays"], "start": x.get("start"), "end": x.get("end")}
                       for x in routines]
            # Manual and migrated blocks are part of the same calendar choice.
            # A dated block contributes its local weekday and clock time.
            for item in items:
                if item["source"] != "block" or item["kind"] != "exercise":
                    continue
                try:
                    local = local_calendar_stamp(item["start_at"])
                    day = UL.WEEKDAY_ORDER[local.weekday()]
                    start = local.strftime("%H:%M")
                    end = (local_calendar_stamp(item["end_at"]).strftime("%H:%M")
                           if item.get("end_at") else None)
                    windows.append({"weekdays": [day], "start": start,
                                    "end": end if end and end > start else None})
                except (ValueError, TypeError):
                    continue
            # Coalesce duplicate schedules before parsing: Mon-Sun represented
            # twice would otherwise become seven accidental training days.
            unique = []
            occupied = set()
            for window in windows:
                remaining = [d for d in window["weekdays"] if d not in occupied]
                if remaining:
                    unique.append(dict(window, weekdays=remaining))
                    occupied.update(remaining)
            if not unique:
                raise Refused("E-CALENDAR\tkeep\tno workout time can be linked; choose modify")
            record_daytime(cx, parse_daytime({"windows": unique}))
    elif stage == "daytime":
        if not st.get("restart_facts_pending") and not st.get("calendar_existing_answered") and existing_calendar_items(cx):
            raise Refused("E-CALENDAR\tdaytime\tconfirm existing calendar first")
        if st.pop("restart_facts_pending", False):
            if payload.get("pick") == "same":
                return
            if payload.get("pick") != "changed":
                raise Refused("E-PICK\tpick\tsame | changed")
            if payload.get("place_changed"):
                st.pop("place", None)
        record_daytime(cx, parse_daytime(payload))
    elif stage == "reconcile":
        apply_reconcile(cx, payload)
    elif stage == "measure":
        m = st.get("measure") or {}
        if m.get("status") != "proposed":
            raise Refused("E-STAGE\tstage\tno measure day is being asked "
                          "(use `next`)")
        p = _pick(payload, ("ok", "other"))
        if p == "other":
            wd = payload.get("weekday")
            if wd not in st["daytime"]["weekdays"]:
                raise Refused("E-WEEKDAYS\tweekday\ta training day: %s"
                              % ", ".join(st["daytime"]["weekdays"]))
            m["weekday"] = wd
        m["status"] = "set"
        st["measure"] = m
    elif stage == "split":
        if not st.get("daytime"):
            raise Refused("E-STAGE\tstage\tthe days come first (use `next`)")
        offer = st.get("split_offer") or {k: o for k, o in
                                          split_options(cx)[0]}
        # The owner may pick ANY eligible shape for his day count, not only
        # the three offered (a dominated shape is hidden, never forbidden).
        import split_model
        n_days = len(st["daytime"]["weekdays"])
        offer = dict({k: {"rotation": r} for k, r in
                      split_model.eligible(n_days)}, **offer)
        p = _pick(payload, tuple(offer) + ("other",))
        if p == "other":
            rot = payload.get("rotation")
            probe = {"rotation": rot, "days": {}}
            errs = []
            init_mod().validate_rotation(probe, errs)
            if errs or not isinstance(rot, list):
                raise Refused("E-ROTATION\trotation\t%s"
                              % "; ".join(e.msg for e in errs))
        else:
            rot = offer[p]["rotation"]
        st["structure"] = {"rotation": list(rot), "source": p}
        st.pop("split_offer", None)
        if len(rot) > 1:
            st.setdefault("notes", []).append({"text": queue_note(cx),
                                               "at": None})
    elif stage == "blocked":
        _pick(payload, ("place",))
        st.pop("place", None)
        st["place_reask"] = True
    elif stage == "compose":
        built = None
        if payload != {"accept": True}:
            # the set level the minutes compose at decides the budget the
            # edited draft is checked against
            built = budget_draft(cx)
            errors = validate_compose(cx, payload)
            if errors:
                raise Refused("\n".join(errors))
        payload = resolve_compose(cx, payload, built)
        errs = validate_compose(cx, payload)
        if errs:
            raise Refused("\n".join(errs))
        accept_compose(cx, payload)
    elif stage == "emphasis":
        p = _pick(payload, ("protect", "grow"))
        st["emphasis"] = p
        if p == "protect":
            st["protected_areas"] = overlap_areas(cx)
    elif stage == "field":
        name, rr = payload.get("name"), payload.get("rep_range")
        unit = payload.get("unit", "reps")
        names = {ex["name"] for c in st["structure"]["rotation"]
                 for ex in final_days(cx)[c]}
        if name not in names:
            raise Refused("E-FIELD\tname\t%r is not a lift in this plan"
                          % name)
        if not (isinstance(rr, list) and len(rr) == 2 and all(
                isinstance(x, int) and 1 <= x <= 300 for x in rr)
                and rr[0] <= rr[1]) or unit not in ("reps", "sec"):
            raise Refused("E-FIELD\trep_range\t[low, high] ints 1..300 with "
                          "unit reps|sec, from the user's answer")
        st.setdefault("fields", {})[name] = {"rep_range": rr, "unit": unit}
    elif stage == "swaps":
        answer_swaps(cx, payload)
    elif stage == "cardio":
        pick = _pick(payload, tuple(CARDIO_OPTIONS))
        tp = st.get("time_plan") or {}
        if tp.get("status") == "set":
            # agreed with the day-total: a different number is the time
            # step's to change, never a second answer here
            minutes = tp["cardio"]
            if payload.get("minutes") not in (None, minutes):
                raise Refused("E-CARDIO-MINUTES\tminutes\tagreed at the "
                              "time step: %d (change it there)" % minutes)
        else:
            minutes = payload.get("minutes", cardio_minutes(cx))
        if isinstance(minutes, bool) or not isinstance(minutes, int) or minutes < 10:
            raise Refused("E-CARDIO-MINUTES\tminutes\t10 or more")
        st["cardio"] = {"pick": pick, "display": CARDIO_OPTIONS[pick],
                        "minutes": minutes}
        st["cardio_preference"] = dict(st["cardio"])
    elif stage == "automation":
        if not st.get("written"):
            raise Refused("E-STAGE\tautomation\tprogram wrap first")
        pick = _pick(payload, ("all", "selected", "skip"))
        groups = tuple(HK_CONSENT_GROUPS) if pick == "all" else payload.get("kinds", [])
        if pick == "selected" and (not isinstance(groups, list) or not groups
                                    or any(k not in HK_CONSENT_GROUPS for k in groups)):
            raise Refused("E-CONSENT\tkinds\tchoose recorded categories")
        if pick != "skip":
            kinds = list(dict.fromkeys(k for group in groups
                                       for k in HK_CONSENT_GROUPS[group]))
            hook = os.environ.get("HK_INGEST_HOOK") or os.path.join(HERE, "hk-ingest")
            proc = subprocess.run([hook, "consent"] + kinds, capture_output=True,
                                  text=True)
            if proc.returncode:
                raise Refused("E-CONSENT\thook\t" + proc.stderr[-300:])
        st["automation_answered"] = pick
    elif stage == "sessions":
        p = _pick(payload, ("ok", "change"))
        if p == "ok":
            st["sessions"] = "ok"
            return
        merged = {"days": dict(st["compose"]), "prep": dict(st["prep"]),
                  "cooldown": dict(st["cooldown"])}
        changed = False
        for key in merged:
            part = payload.get(key)
            if part is None:
                continue
            if not isinstance(part, dict):
                raise Refused("E-SHAPE\t%s\t{<session>: ...}" % key)
            merged[key].update(part)
            changed = changed or bool(part)
        if not changed:
            raise Refused("E-SESSIONS\tdays\ton change: the changed "
                          "sessions (days / prep / cooldown)")
        errs = validate_compose(cx, merged)
        if errs:
            raise Refused("\n".join(errs))
        # a lift the user put into a changed session is theirs: never
        # lightened by the spacing
        pinned = {(c, ex.get("name")) for c, lst in (payload.get("days")
                                                     or {}).items()
                  if isinstance(lst, list) for ex in lst
                  if isinstance(ex, dict) and ex.get("name") not in {
                      e["name"] for e in st["compose"].get(c) or []}}
        # a lightened lift the change kept keeps its reason line
        for c, lst in merged["days"].items():
            was = {e["name"]: e["spaced"] for e in st["compose"].get(c) or []
                   if e.get("spaced")}
            merged["days"][c] = [
                dict(ex, spaced=was[ex["name"]]) if isinstance(ex, dict)
                and ex.get("name") in was and not ex.get("spaced") else ex
                for ex in lst]
        accept_compose(cx, merged, pinned)
        st.pop("sessions", None)
    else:
        raise Refused("E-STAGE\tstage\tunknown stage %r (use `next`)" % stage)


