                         {"pick": "keep | modify"}})


# The answer patterns of the days ask (D12 point 3, owner 2026-10-04): each
# shape the user may answer in, and its handler. The table the agent reads
# is reference/build-flow.md (daytime answer patterns); the code is here.
#   full ranges           -> recorded, no follow-up
#   a start only          -> ONE "until when" follow-up (end)
#   a length only         -> the minutes recorded; WHEN asked once (when /
#                            start) when the days or the times are missing
#   days only             -> ONE range follow-up (range)
#   a vague time word     -> a concrete guess (VAGUE_GUESS), confirmed in
#                            one line, one tap (confirm)
#   per-day mixed         -> per-day windows; "any time" a day with no time
#                            limit (anytime), stated
#   undecidable           -> the recommendation (and DEFAULT_DAYS) planned,
#                            stated as such (unknown)
#   answer + a question   -> recorded first; the next move carries `aside`
#   out of range          -> refused with the reason and ONE narrow re-ask
#                            (RefusedAsk.say)
# Never more than one follow-up per answer: what the follow-up still leaves
# open is planned on the stated default.
VAGUE_GUESS = {"after_work": ("19:00", "21:00"),
               "evening": ("19:00", "21:00"),
               "dawn": ("06:00", "07:30"),
               "morning": ("07:00", "08:30"),
               "lunch": ("12:00", "13:00"),
               "night": ("21:00", "22:30")}
DEFAULT_DAYS = {1: ["MON"], 2: ["MON", "THU"], 3: ["MON", "WED", "FRI"],
                4: ["MON", "TUE", "THU", "FRI"],
                5: ["MON", "TUE", "WED", "THU", "FRI"],
                6: ["MON", "TUE", "WED", "THU", "FRI", "SAT"],
                7: ["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"]}
DAYTIME_WINDOWS = ("[{weekdays: [MON..SUN], start: 'HH:MM' | null, end: "
                   "'HH:MM' | null, vague?: %s, anytime?: true}] -- one "
                   "entry per distinct time window, in the user's words: no "
                   "time said -> start/end null; a vague time word (after "
                   "work, dawn, lunch break, evening) -> `vague`, no clock; "
                   "'any time' / 'when I can' on a day -> anytime: true"
                   % " | ".join(sorted(VAGUE_GUESS)))
DAYTIME_EXTRA = {
    "unknown": "true when the user cannot say ('it varies', 'I don't "
               "know'); the days in `windows` when said",
    "question": "optional: a question the user asked in the same message, "
                "verbatim (the answer is recorded first; you answer it in "
                "one or two lines before the next say)"}


def stage_daytime(cx):
    """A4: an OPEN question (P5 returns: the daytime is not a proposal),
    opened by the calendar sentence read from the user's active routines,
    with GENERIC examples. The base days and the extra (보충) days, each with
    their windows, are read off the ONE answer."""
    items = existing_calendar_items(cx)
    if items and not cx.st.get("calendar_existing_answered"):
        return existing_calendar_move(cx, items)
    n = cx.st.get("frequency")
    # when, as a time range per day (owner 2026-10-04 19:05): the window IS
    # the time a day; no dose hint, no minutes question here
    say = (T("daytime_ask_range", n=n, calendar=calendar_sentence(cx, n))
           if n else T("daytime_ask", calendar=""))
    return pmove(cx, "ask", "daytime", say=say,
                 answer={"stage": "daytime", "payload": dict({
                     "minutes": "optional: minutes a day the user said "
                                "outright ('2 hours', '90 min'; an hour = 60), "
                                "%d..%d; alone (no days) is an answer too; "
                                "a clock end goes in the window"
                                % (SESSION_MIN, SESSION_MAX),
                     "windows": DAYTIME_WINDOWS + " -- the REGULAR days",
                     "extra_windows": "optional, same shape: the days the "
                                      "user comes when there is room (보충) "
                                      "with their hours -- from the SAME "
                                      "answer, never asked again"},
                     **DAYTIME_EXTRA)})


def daytime_followup(st):
    """(kind, windows) of the ONE narrow follow-up the days answer still
    needs, or None. when: the minutes said, no days; confirm: a vague time
    guessed; range: a regular day with no time (and the starts with no
    end); start: the same with the minutes said; end: a start with no end,
    the minutes not said. Once one follow-up was answered, none again."""
    dt = st.get("daytime")
    if not dt:
        return ("when", []) if st.get("daytime_when") else None
    if dt.get("followed_up") or dt.get("ends_open"):
        return None
    wins = dt.get("windows") or []
    guessed = [w for w in wins + (dt.get("extra_windows") or [])
               if w.get("guess")]
    if guessed:
        return "confirm", guessed
    avail = st.get("available_minutes")
    untimed = [w for w in wins if not w.get("start") and not w.get("anytime")]
    open_ = [] if avail else [w for w in wins
                              if w.get("start") and not w.get("end")]
    if untimed:
        return ("start" if avail else "range"), untimed + open_
    if open_:
        return "end", open_
    return None


def open_ends(st):
    """The regular windows the end follow-up asks about (until when)."""
    f = daytime_followup(st)
    return f[1] if f and f[0] == "end" else []


def _clock_ko(t):
    h, m = (int(x) for x in t.split(":"))
    return T("clock_hour", h=h) if m == 0 else t


CLOCK_PARTS = ((7, "dawn"), (12, "morning"), (18, "day"), (22, "evening"),
               (24, "night"))


def _clock_spoken(t):
    """(part of the day, the hour said: o'clock | half | minutes) of HH:MM."""
    h, m = (int(x) for x in t.split(":"))
    part = next(p for top, p in CLOCK_PARTS if h < top)
    h12 = h % 12 or 12
    said = (T("clock_hour", h=h12) if m == 0 else
            T("clock_half", h=h12) if m == 30 else T("clock_hm", h=h12, m=m))
    return part, said


def ko_range(start, end):
    """HH:MM~HH:MM as said: the part of the day once, again at the end only
    across noon (evening 7~9, midday 12~1, morning 11~midday 1)."""
    ps, s = _clock_spoken(start)
    head = T("clock_part_" + ps) + " " + s
    if not end:
        return head
    pe, e = _clock_spoken(end)
    # the end names its part of the day only across noon
    noon = (int(start[:2]) < 12) != (int(end[:2]) < 12)
    return T("clock_range", start=head, end=T("clock_part_" + pe) + " " + e
             if noon else e)


def _plus(t, minutes):
    h, m = (int(x) for x in t.split(":"))
    total = h * 60 + m + minutes
    return None if total > 23 * 60 + 59 else "%02d:%02d" % divmod(total, 60)


def daytime_followup_move(cx, kind, wins):
    """ONE short question; a guess is confirmed with one tap."""
    days = _days_compact([d for w in wins for d in w["weekdays"]])
    choices = None
    if kind == "when":
        say = T("daytime_when_ask", m=cx.st["available_minutes"])
    elif kind == "confirm":
        items = []
        for w in wins:
            word = T("vague_" + w["guess"])
            rng = ko_range(w["start"], w["end"])
            days_ = T("cal_days", days=_days_compact(w["weekdays"]))
            # the word said once: "evening" is already the range's own part
            items.append(T("daytime_guess_plain", days=days_, range=rng)
                         if rng.startswith(word) else
                         T("daytime_guess_item", days=days_, word=word,
                           eun=josa(word, "eun"), range=rng))
        say = T("daytime_guess_ask", guesses=", ".join(items),
                ro=josa(rng, "ro"))
        choices = [dict(choice("ok", T("c_guess_ok")), recommended=True)]
    elif kind == "range":
        say = T("daytime_range_ask", days=days)
    elif kind == "start":
        say = T("daytime_start_ask", days=days)
    elif len({w["start"] for w in wins}) == 1:
        say = T("daytime_end_ask")
    else:
        say = T("daytime_end_ask_many", starts=", ".join(
            T("cal_window", days=T("cal_days", days=_days_compact(
                w["weekdays"])), hours=_clock_ko(w["start"])) for w in wins))
    payload = ({"windows": DAYTIME_WINDOWS + " -- the regular days the user "
                           "named, with their start when said",
                "extra_windows": "optional, same shape"}
               if kind == "when" else dict({
                   "pick": "ok: the guess as it is"} if kind == "confirm"
                   else {}, **{
                   "ranges": "[{weekdays: [MON..SUN], start: 'HH:MM' | "
                             "omitted, end: 'HH:MM' | omitted}] -- the times "
                             "the user said for these days; a start said "
                             "before may be left out",
                   "minutes": "optional, instead: minutes a day said "
                              "outright ('2 hours'), %d..%d"
                              % (SESSION_MIN, SESSION_MAX)}))
    payload.update(DAYTIME_EXTRA)
    return pmove(cx, "ask", "daytime:" + kind, say=say, choices=choices,
                 answer={"stage": "daytime", "payload": payload})


def _check_window(start, end, where):
    """An end before the start, or a window too short to hold a day, is
    refused with the reason and ONE narrow re-ask (D12 point 3)."""
    if end <= start:
        raise RefusedAsk("E-TIME\t%s\tafter the start %s" % (where, start),
                         T("reask_end_before", start=ko_range(start, None)))
    if _minutes(start, end) < SESSION_MIN:
        raise RefusedAsk("E-DAYTIME\t%s\ta window of %d minutes or more"
                         % (where, SESSION_MIN),
                         T("reask_too_short", m=_minutes(start, end)))


def _check_minutes(m):
    if m is not None and not (SESSION_MIN <= m <= SESSION_MAX):
        raise RefusedAsk("E-DAYTIME\tminutes\tminutes a day %d..%d"
                         % (SESSION_MIN, SESSION_MAX),
                         T("reask_minutes", lo=SESSION_MIN, hi=SESSION_MAX))
    return m


def _default_note(cx, key, **kw):
    """A default used is a default stated (D12): said on the next message."""
    cx.st.setdefault("notes", []).append(
        {"text": T(key, m=day_total(cx), **kw), "at": None})


def apply_daytime(cx, payload):
    """The days answer, every shape of the table above."""
    st = cx.st
    m = _check_minutes(_int(payload.get("minutes")))
    unknown = bool(payload.get("unknown"))
    if not payload.get("windows"):
        if unknown:
            # nothing decidable: the count spread over the week, the
            # recommended day; both said
            days = DEFAULT_DAYS[min(max(st.get("frequency") or 3, 1), 7)]
            dt = parse_daytime({"windows": [{"weekdays": list(days)}]})
            dt.update(ends_open=True, default_days=True)
            record_daytime(cx, dt, m)
            _default_note(cx, "daytime_default_days",
                          days=_days_compact(days))
            return
        if m is not None:
            # a length only: kept; WHEN is the one follow-up
            st["available_minutes"] = m
            st["daytime_when"] = True
            for k in ("structure", "split_offer", "time_plan"):
                st.pop(k, None)
            return
    when = st.pop("daytime_when", False)
    dt = parse_daytime(payload)
    if unknown or when:
        # the follow-up was the length's (when) or the user cannot say:
        # nothing is asked again
        dt["followed_up"] = True
    if unknown and not all(w.get("start") and w.get("end")
                           for w in dt["windows"]):
        dt["ends_open"] = True
    record_daytime(cx, dt, m)
    anytime = [d for w in dt["windows"] if w.get("anytime")
               for d in w["weekdays"]]
    if anytime:
        _default_note(cx, "daytime_anytime", days=_days_compact(anytime))
    if dt.get("followed_up") and not st.get("available_minutes") and any(
            not w.get("end") and not w.get("anytime")
            for w in dt["windows"]):
        _default_note(cx, "daytime_default")


def apply_daytime_followup(cx, payload):
    """The follow-up answer: the guess confirmed, the times said, the
    minutes said, or none known -- then nothing is asked again; what is
    still open is planned on the recommendation, stated."""
    st = cx.st
    dt = st["daytime"]
    kind, wins = daytime_followup(st)
    m = _check_minutes(_int(payload.get("minutes")))
    ranges = payload.get("ranges") or payload.get("ends")
    if payload.get("end") and not ranges:
        ranges = [{"weekdays": [d for w in wins for d in w["weekdays"]],
                   "end": payload["end"]}]
    if kind == "confirm" and payload.get("pick") == "ok":
        pass
    elif m is not None:
        st["available_minutes"] = m
    elif payload.get("unknown"):
        dt["ends_open"] = True
    else:
        if not isinstance(ranges, list) or not ranges:
            raise Refused("E-DAYTIME\tranges\t[{weekdays, start?, end?}] for "
                          "the days asked (or pick ok / minutes / unknown)")
        pending = {d: w for w in wins for d in w["weekdays"]}
        said = {}
        for i, e in enumerate(ranges):
            p = "ranges[%d]" % i
            wd = e.get("weekdays") if isinstance(e, dict) else None
            if not isinstance(wd, list) or not wd or any(
                    d not in pending for d in wd):
                raise Refused("E-WEEKDAYS\t%s.weekdays\tthe days asked only"
                              % p)
            for d in wd:
                w = pending[d]
                start = (_clock(e["start"], p + ".start") if e.get("start")
                         else None if w.get("guess") else w.get("start"))
                end = _clock(e["end"], p + ".end") if e.get("end") else None
                if end and not start:
                    raise Refused("E-TIME\t%s.start\tan end needs a start"
                                  % p)
                if start and end:
                    _check_window(start, end, p + ".end")
                said[d] = (start, end)
        out = []
        for key in ("windows", "extra_windows"):
            out = []
            for w in dt.get(key) or []:
                if not any(d in said for d in w["weekdays"]):
                    out.append(w)
                    continue
                groups = {}
                for d in w["weekdays"]:
                    groups.setdefault(said.get(d), []).append(d)
                for se, ds in groups.items():
                    if se is None:
                        out.append(dict(w, weekdays=ds))
                    else:
                        nw = {k: v for k, v in w.items() if k != "guess"}
                        nw.update(weekdays=ds, start=se[0], end=se[1])
                        out.append(nw)
            dt[key] = sorted(out, key=lambda w: UL.WEEKDAY_ORDER.index(
                w["weekdays"][0]))
    for w in (dt.get("windows") or []) + (dt.get("extra_windows") or []):
        # a guess not corrected stands as said in the confirm line
        w.pop("guess", None)
    dt["followed_up"] = True
    if not st.get("available_minutes") and any(
            not w.get("end") and not w.get("anytime")
            for w in dt["windows"]):
        _default_note(cx, "daytime_default")
    # the time each day holds changed: measured and checked again
    for k in ("structure", "split_offer", "time_plan"):
        st.pop(k, None)


def _clock(t, where):
    try:
        h, m = (int(x) for x in str(t).split(":", 1))
        assert 0 <= h < 24 and 0 <= m < 60
    except (ValueError, AssertionError, TypeError):
        raise Refused("E-TIME\t%s\tHH:MM" % where)
    return "%02d:%02d" % (h, m)


def _windows(wins, key, taken=()):
    out, days = [], []
    for i, w in enumerate(wins):
        p = "%s[%d]" % (key, i)
        wd = w.get("weekdays") if isinstance(w, dict) else None
        if not isinstance(wd, list) or not wd or any(
                d not in UL.WEEKDAY_ORDER for d in wd):
            raise Refused("E-WEEKDAYS\t%s.weekdays\tlist of MON..SUN" % p)
        if set(wd) & set(days):
            raise Refused("E-WEEKDAYS\t%s.weekdays\ta day in two windows"
                          % p)
        if set(wd) & set(taken):
            raise Refused("E-WEEKDAYS\t%s.weekdays\ta regular day is not "
                          "an extra day" % p)
        days += wd
        start = _clock(w["start"], p + ".start") if w.get("start") else None
        end = _clock(w["end"], p + ".end") if w.get("end") else None
        vague = w.get("vague")
        if vague is not None and vague not in VAGUE_GUESS:
            raise Refused("E-DAYTIME\t%s.vague\tone of %s"
                          % (p, " | ".join(sorted(VAGUE_GUESS))))
        if end and not start:
            raise Refused("E-TIME\t%s.start\tan end needs a start" % p)
        if start and end:
            _check_window(start, end, p + ".end")
        entry = {"weekdays": [d for d in UL.WEEKDAY_ORDER if d in wd],
                 "start": start, "end": end}
        if vague and not start:
            # a vague word: a concrete guess, confirmed in one line
            entry.update(start=VAGUE_GUESS[vague][0],
                         end=VAGUE_GUESS[vague][1], guess=vague)
        elif w.get("anytime") is True and not start:
            entry["anytime"] = True
        out.append(entry)
    out.sort(key=lambda w: UL.WEEKDAY_ORDER.index(w["weekdays"][0]))
    return out, days


def parse_daytime(payload):
    wins = payload.get("windows")
    if not isinstance(wins, list) or not wins:
        raise Refused("E-DAYTIME\twindows\tat least one {weekdays, start, "
                      "end}")
    out, days = _windows(wins, "windows")
    if len(days) > MAX_DAYS:
        raise Refused("E-WEEKDAYS\twindows\tat most %d regular days"
                      % MAX_DAYS)
    xw = payload.get("extra_windows") or []
    if not isinstance(xw, list):
        raise Refused("E-WEEKDAYS\textra_windows\tlist of {weekdays, start, "
                      "end}")
    xout, xdays = _windows(xw, "extra_windows", taken=days)
    extra = payload.get("extra") or []
    if not isinstance(extra, list) or any(d not in UL.WEEKDAY_ORDER
                                          for d in extra):
        raise Refused("E-WEEKDAYS\textra\tlist of MON..SUN")
    if set(extra) & set(days):
        raise Refused("E-WEEKDAYS\textra\ta regular day is not an extra day")
    xdays = list(dict.fromkeys(xdays + list(extra)))
    return {"windows": out,
            "weekdays": [d for d in UL.WEEKDAY_ORDER if d in days],
            "extra": [d for d in UL.WEEKDAY_ORDER if d in xdays],
            "extra_windows": xout}


def record_daytime(cx, dt, minutes=None):
    st = cx.st
    before = (st.get("daytime") or {}).get("weekdays")
    if minutes is not None and minutes != st.get("available_minutes"):
        # the user's own minutes cap every regular day (as a window does):
        # the time budget the split is measured with changes
        st["available_minutes"] = minutes
        for k in ("structure", "split_offer"):
            st.pop(k, None)
    if (st.get("daytime") or {}).get("extra_windows") != dt.get(
            "extra_windows") or extra_days_missing(cx, dt):
        land_extra_windows(cx, dt)
    st["daytime"] = dt
    st["days"] = {"weekdays": dt["weekdays"], "source": "daytime"}
    n = len(dt["weekdays"])
    if st.get("frequency") and st["frequency"] != n:
        # the days the user named win over the count (never a refusal); the
        # next message says so once
        st.setdefault("notes", []).append({"text": T("freq_updated", n=n),
                                           "at": None})
    st["frequency"] = n
    st.pop("split_offer", None)
    # new days are checked against the day-total again (reconcile)
    st.pop("time_plan", None)
    if before != dt["weekdays"]:
        st.pop("structure", None)
    m = st.get("measure")
    if m and m.get("weekday") and m["weekday"] not in dt["weekdays"]:
        st.pop("measure", None)


# -- reconcile (owner 2026-10-02): the real time against the dose ----------
# Right after the days answer, each training day's window is compared with
# the day-total. All fit: one line, continue. A day short: named, and three
# ways offered in the owner's order -- cardio to the supplementary day, a
# shorter strength part, one more day. The decision is st["time_plan"]:
#   {status: set | need_day, pick: fits | untimed | cardio_extra | shrink |
#    add_day, total, cardio, cardio_off: [weekday], cardio_day: weekday}
# compose_rank.time_budget reads it (the strength budget per day; a day
# whose cardio moved holds no cardio).
RC_PICKS = ("cardio_extra", "shrink", "add_day")


def day_windows(dt, avail=None):
    """{weekday: window minutes | None} of the regular days; the user's own
    minutes a day (avail) cap every one of them."""
    out = {}
    for w in (dt or {}).get("windows") or ():
        m = (_minutes(w["start"], w["end"]) if w.get("start") and
             w.get("end") else None)
        if avail:
            m = min(m, avail) if m is not None else avail
        for d in w["weekdays"]:
            out[d] = m
    return out


def spare_minutes(cx):
    """Minutes every regular day holds past the planned dose (the user's
    own minutes and windows against day_minutes); None when a day's time
    is not known."""
    wins = day_windows(cx.st.get("daytime"), cx.st.get("available_minutes"))
    if not cx.st.get("day_minutes") or not wins or any(
            m is None for m in wins.values()):
        return None
    return min(wins.values()) - day_total(cx)


def time_check(cx):
    """{total, parts, short: {weekday: window}, timed}: the training days
    whose window cannot hold the day-total."""
    total = day_total(cx)
    wins = day_windows(cx.st.get("daytime"), cx.st.get("available_minutes"))
    short = {d: m for d, m in wins.items() if m is not None and m < total}
    return dict(total=total, parts=day_parts(cx, total), short=short,
                timed=any(m is not None for m in wins.values()))


def add_day_total(cx, chk):
    """The day-total with one more day: the same weekly strength spread
    over n + 1 days, never past the shortest window; None when no strength
    part is left. Every day holding the dose: one more day of the same
    length (the week grows)."""
    p = chk["parts"]
    if not chk["short"]:
        return p["total"]
    n = len((cx.st.get("daytime") or {}).get("weekdays") or ())
    care_cardio = p["total"] - p["strength"]
    spread = _round_step(p["strength"] * n / float(n + 1)) + care_cardio
    total = min(spread, _round_step(min(chk["short"].values()), down=True))
    return total if total - care_cardio >= STRENGTH_MIN else None


# -- the time decision (owner 2026-10-04 19:05): at the sessions step -------
# The days answer only records the windows: a window under the dose is
# time_plan pick "shrink", undecided, and the sessions are composed to the
# WHOLE recommended day (never to a window too short to plan anything,
# owner review 2026-10-04). Where the weekly sets are counted, a short
# window or a floor the plan cannot reach is ONE decision taken with the
# user, every option with its numbers (D12 (2)): (a) more time -- the short
# windows lengthened (stretch), a longer day (extend, the floor), one more
# day; (b) something less important out -- every day short: the
# lowest-priority lifts / sets named (pick `short`, composed to the
# window), or the cardio to the supplementary day; (c) as it is -- some
# days short: exactly what those days lose (the shrink, said). Nothing
# holding a plan -> the days asked again (redo). time_plan["decided"]
# closes it.
TC_DECIDED = RC_PICKS + ("extend", "keep", "stretch", "short")


def budget_if(cx, **plan):
    """compose_rank.time_budget with time_plan fields overridden: what a
    pick would give, the state untouched."""
    import compose_rank
    st = dict(cx.st, time_plan=dict(cx.st.get("time_plan") or {}, **plan))
    return compose_rank.time_budget(_StOnly(st), _minutes)


class _StOnly(object):
    def __init__(self, st):
        self.st = st


def worst_strength(cx, budget, chk):
    """The strength a short day holds under a budget (its cap, never past
    the queue's); every day fitting: the queue's."""
    caps = [budget["per_day"][d] for d in chk["short"]
            if d in budget["per_day"]]
    return min([budget["strength"]] + caps)


def week_strength(budget, days):
    """The strength minutes a week: each regular day its queue's, a day
    whose window caps it less."""
    return sum(min(budget["strength"], budget["per_day"].get(d,
                                                             budget["strength"]))
               for d in days) or budget["strength"]


def _isets(x):
    """Weekly sets as the user hears them: whole sets, half up (owner
    2026-10-04: no '6.5 sets'). Every said number and every sum said with
    it come from this rounding, so the sums stay honest."""
    return int(math.floor(float(x) + 0.5))


def floor_gap(short):
    return sum(max(0, s_["floor"] - _isets(s_["weekly_sets"]))
               for s_ in short)


def volume_items(cx, short):
    return T("sm_site_sep").join(
        T("sess_volume_item", muscle=UL.muscle_ko(s_["muscle"], cx.db),
          n=_isets(s_["weekly_sets"]), floor=s_["floor"]) for s_ in short)


def short_muscles(cx, short):
    return T("sm_site_sep").join(UL.muscle_ko(s_["muscle"], cx.db)
                                 for s_ in short)


def fix_line(cx, short, week_minutes):
    """What more strength minutes a week do to the floor: every short
    muscle reached, or part of it (a set with its rest, set_minutes)."""
    if not short or week_minutes <= 0:
        return ""
    key = "tc_fix_full" if fixes(short, week_minutes) else "tc_fix_part"
    return " " + T(key, muscles=short_muscles(cx, short))


def fixes(short, week_minutes):
    return bool(short) and week_minutes // set_minutes() >= floor_gap(short)


def floor_ext(short, n):
    """Minutes a day that fill the floor gap (SESSION_STEP rounded, a set
    with its rest each); 0 with no gap."""
    if not short:
        return 0
    return max(SESSION_STEP, int(-(-floor_gap(short) * set_minutes()
                                   // (n * SESSION_STEP))) * SESSION_STEP)


def _dur(m):
    """A window's length as said: hours, hours and minutes, or minutes."""
    h, r = divmod(int(m), 60)
    if not h:
        return T("dur_m", m=r)
    return T("dur_hm", h=h, m=r) if r else T("dur_h", h=h)


def below_floor(cx):
    """[muscle] the plan holds under its weekly floor (whole sets)."""
    try:
        audit = run_audit(cx, answers_doc(cx, final_days(cx),
                                          provisional=True))
    except Exception:                                       # noqa: BLE001
        return []
    return [m for m, e in sorted((audit.get("per_muscle") or {}).items())
            if e.get("verdict") != "untrained"
            and _isets(e["proposed_weekly_sets"]) < e["band"]["floor"]]


def muscles_said(cx, muscles):
    return T("sm_site_sep").join(UL.muscle_ko(m, cx.db) for m in muscles)


def time_decision(cx, checks):
    """None, or {lead, opts: [{pick, title, line, ...}], rec, why, notes}:
    the one decision the sessions step puts to the user (D12 (2): add a
    resource / adjust the goal / accept the gap, with numbers). opts empty:
    the lead is said alone. Kept on the state while nothing it reads
    changed (the probes compose the plan again)."""
    st = cx.st
    if st.get('trainer_fit'):
        return None
    tp = st.get("time_plan") or {}
    # a pick from before the decision moved here carries no flag: taken
    decided = tp.get("decided", tp.get("pick") in TC_DECIDED)
    if decided or tp.get("status") != "set":
        return None
    sig = json.dumps([st.get(k) for k in (
        "compose", "set_adjust", "time_plan", "daytime", "available_minutes",
        "structure", "day_minutes", "volume_shortfall", "cardio",
        "goal_first")] + [checks.get("goal"), active_goals(cx)],
        sort_keys=True, ensure_ascii=False)
    old = st.get("time_decision") or {}
    if old.get("sig") == sig and "dec" in old:
        return old["dec"]
    dec = _time_decision(cx, checks)
    if dec is not None:
        dec["sig"] = sig
    return dec


# The recommendation (owner 2026-10-04 21:27): a resource option (more
# time, one more day, the cardio moved WITHOUT cuts) is recommended while
# one of them reaches the weekly floor; the goal adjustment only when none
# can. Some days short is "as it is" first (only those days trimmed, said).
REACH_ORDER = ("extend", "cardio_extra", "add_day", "stretch")


def _time_decision(cx, checks):
    import compose_rank
    st = cx.st
    tp = st.get("time_plan") or {}
    chk = time_check(cx)
    short = (st.get("volume_shortfall") or []
             if checks.get("goal") is None else [])
    if not chk["short"] and not short:
        return None
    now = compose_rank.time_budget(cx, _minutes)
    p = chk["parts"]
    dt = st.get("daytime") or {}
    days = list(dt.get("weekdays") or ())
    n = len(days) or 1
    extra = dt.get("extra") or []
    care = p["prep"] + p["cooldown"]
    partial = bool(chk["short"]) and bool(set(days) - set(chk["short"]))
    every = bool(chk["short"]) and not partial
    lead, notes = [], {}
    by_window = {}
    for d, m in chk["short"].items():
        by_window.setdefault(m, []).append(d)
    for m, ds in sorted(by_window.items(), reverse=True):
        lead.append(T("tc_window", days=_days_compact(ds), window=m,
                      total=chk["total"], gap=chk["total"] - m))
    if every:
        # the sessions above hold the whole recommended day; the decision
        # is how to fit it
        lead.append(T("tc_shown_full", total=chk["total"]))
    if short:
        lead.append(T("tc_floor", items=volume_items(cx, short),
                      gap=floor_gap(short)))
    # the weekly strength minutes the whole plan and its floor take
    need_week = n * p["strength"] + floor_gap(short) * set_minutes()

    def reaches(week):
        return week >= need_week

    opts = []
    # (a) more time: the short windows lengthened to the recommended day
    # (every day short: and the floor's minutes on top, so it reaches)
    ext = floor_ext(short, n) if every else 0
    stretch = stretch_plan(cx, chk, ext) if chk["short"] else None
    if stretch is None and ext:
        ext, stretch = 0, stretch_plan(cx, chk)
    if stretch:
        line, note = stretch_lines(cx, chk, stretch, ext, short)
        opts.append(dict(pick="stretch", title=T("tc_title_stretch"),
                         line=line, ext=ext, reaches=not short or bool(ext)))
        notes["stretch"] = note
    # ... a longer day while every window allows it (the floor), else one
    # more day when the week then holds more
    spare = spare_minutes(cx)
    spare = _round_step(spare, down=True) if spare is not None else 0
    total3 = add_day_total(cx, chk)
    if short and spare > 0:
        need = floor_ext(short, n)
        add = min(need, spare)
        opts.append(dict(
            pick="extend", extend=add, full=need <= spare,
            reaches=need <= spare, title=T("c_sess_extend", extra=add),
            line=T("tc_extend", extra=add, total=chk["total"] + add)
            + fix_line(cx, short, add * n)))
    elif len(days) < MAX_DAYS and total3 is not None and (n + 1) * (
            total3 - (p["total"] - p["strength"])) > week_strength(now, days):
        before = week_strength(now, days)
        after = (n + 1) * (total3 - (p["total"] - p["strength"]))
        week = (T("rc_week_same", before=before) if after == before else
                T("rc_week_change", before=before, after=after))
        line = (T("tc_add_day", day=UL.WEEKDAY_KO[extra[0]], n=n + 1,
                  total=total3, week=week) if extra else
                T("tc_add_day_new", n=n + 1, total=total3, week=week))
        if reaches(after):
            line += fix_line(cx, short, after - n * p["strength"])
        else:
            # honest against the whole plan, not the trimmed week
            line += " " + T("tc_week_short", gap=int(math.ceil(
                need_week - after)))
        if not extra:
            line += " " + T("tc_ask_add_day")
        opts.append(dict(pick="add_day", title=T("rc_title_add_day"),
                         line=line, reaches=reaches(after)))
    # ... or the cardio to the supplementary day (off the short days; off
    # every day when the floor is the reason) -- a resource only while it
    # cuts nothing: a cut below what the goal needs is the goal adjustment
    off = ([d for d in UL.WEEKDAY_ORDER if d in chk["short"]] or days)
    worst = worst_strength(cx, now, chk)
    moved = budget_if(cx, cardio_off=off, pick="cardio_extra")
    gain = worst_strength(cx, moved, chk)
    # the sets a week follow the queue's strength, not the worst day's
    queue = (moved["strength"] - now["strength"]) * n
    low = min(chk["short"].values()) if chk["short"] else None
    cardio_cut = None
    if not tp.get("cardio_off") and gain > worst and (
            low is None or low - care >= STRENGTH_MIN):
        kw = dict(short=_days_compact(off), cardio=now["cardio"],
                  before=worst, after=gain)
        day = dict(day=UL.WEEKDAY_KO[extra[0]]) if extra else {}
        if moved["strength"] >= now["strength"]:
            if every:
                line = T("tc_cardio_move" if extra else "tc_cardio_move_ask",
                         **dict(kw, **day))
                line += " " + T("tc_cut_none", s=moved["strength"])
            else:
                line = T("tc_cardio_extra" if extra else
                         "tc_cardio_extra_ask", **dict(kw, **day))
                line += fix_line(cx, short, queue)
            if not extra:
                line += " " + T("tc_ask_cardio_day")
            opts.append(dict(pick="cardio_extra",
                             title=T("rc_title_cardio_extra"), line=line,
                             full=fixes(short, queue),
                             reaches=reaches(week_strength(moved, days)),
                             covers=(gain >= p["strength"] if chk["short"]
                                     else fixes(short, queue))))
        elif every:
            # the moved plan composes every session shorter: kept for the
            # goal adjustment when the cardio staying holds nothing
            cardio_cut = dict(kw=kw, day=day)
    # (b) the goal adjusted, by priority: every day short -> the strength
    # cut to the window is what the lowest-priority goal / branch gives up
    # (the cuts follow what the surviving goal needs: keep)
    adj = goal_adjust_target(cx, short) if every else None
    plan = dict(pick="short", decided=True, keep=(adj or {}).get("keep"))
    if adj and adj["kind"] == "fat":
        # the lower fat goal's cardio gives the strength its minutes (what
        # the shortest window lacks), down to the shortest cardio the plan
        # takes
        cf = now["cardio"]
        ct = max(CARDIO_MIN, _round_step(
            cf - max(0, p["strength"] - worst), down=True))
        adj = dict(adj, cardio_from=cf, cardio_to=ct) if ct < cf else None
        plan["cardio_keep"] = ct
    if adj:
        pr, via = probe_plan(cx, **plan), "short"
        if pr is None and cardio_cut and adj["kind"] != "fat":
            pr, via = probe_plan(cx, pick="cardio_extra", cardio_off=off,
                                 decided=True, keep=adj["keep"]), \
                "cardio_extra"
        if pr is not None:
            for o in goal_options(cx, adj, pr, via, cardio_cut, extra, n):
                notes[o["pick"]] = o.pop("note")
                opts.append(o)
    # (c) as it is: some days short -> exactly what those days lose (the
    # shrink, said); every day holding the dose -> the gap named
    if partial:
        trims = day_trims(cx, chk)
        keep = (trim_sentence(cx, trims) + " "
                + T("tc_cardio_stays", cardio=now["cardio"]) + " "
                + T("tc_shrink_rest", total=chk["total"]))
        notes["keep"] = trim_sentence(cx, trims, done=True)
        if short:
            keep += " " + T("tc_keep_floor", muscles=short_muscles(cx, short),
                            eun=josa(short_muscles(cx, short), "eun"),
                            gap=floor_gap(short))
        opts.append(dict(pick="keep", title=T("tc_title_keep"), line=keep))
    elif not every and opts:
        keep = T("tc_keep", m=now["minutes"]) + " " + T(
            "tc_keep_floor", muscles=short_muscles(cx, short),
            eun=josa(short_muscles(cx, short), "eun"), gap=floor_gap(short))
        opts.append(dict(pick="keep", title=T("tc_title_keep"), line=keep))
    if chk["short"] and len(opts) < 2:
        # nothing else holds a plan in this time: the days asked again
        opts.append(dict(pick="redo", title=T("tc_title_redo"),
                         line=T("tc_redo")))
    if not opts:
        return dict(lead=lead, opts=[], rec=None, why=None, notes={})
    opts = opts[:4]
    rec, key, kw = _time_rec(cx, opts, partial, every, extra, chk, short)
    n_rec = [o["pick"] for o in opts].index(rec) + 1
    why = T(key, n=n_rec, **kw)
    o = next(o for o in opts if o["pick"] == rec)
    under = (o.get("under") if rec == "goal" else
             [] if o.get("reaches") or rec == "redo" else
             [s_["muscle"] for s_ in short])
    if under:
        # the recommended option leaves a muscle under its floor: said
        ms = muscles_said(cx, under)
        why = why.rstrip() + " " + T("tc_rec_under", muscles=ms,
                                     eun=josa(ms, "eun"))
    return dict(lead=lead, opts=opts, rec=rec, why=why, notes=notes)


def _time_rec(cx, opts, partial, every, extra, chk, short):
    """(pick, copy key, kw) of the recommendation, with its real reason."""
    by = {o["pick"]: o for o in opts}
    if partial:
        # some days short: as it is (only those days trimmed, said) unless
        # a resource holds every day at no cost to the rest
        if "extend" in by and by["extend"]["full"]:
            return "extend", "tc_rec_extend", dict(
                extra=by["extend"]["extend"])
        if "cardio_extra" in by and extra and by["cardio_extra"]["covers"]:
            return "cardio_extra", "tc_rec_cardio_extra", dict(
                day=UL.WEEKDAY_KO[extra[0]])
        if "keep" in by:
            return "keep", "tc_rec_shrink", dict(
                short=_days_compact(list(chk["short"])))
    reach = sorted((o for o in opts if o.get("reaches")),
                   key=lambda o: (REACH_ORDER.index(o["pick"]) + (
                       4 if o["pick"] == "cardio_extra" and not extra
                       else 0)))
    if reach:
        o = reach[0]
        if o["pick"] == "extend":
            return "extend", "tc_rec_extend", dict(extra=o["extend"])
        if o["pick"] == "cardio_extra":
            return ("cardio_extra", "tc_rec_cardio_extra", dict(
                day=UL.WEEKDAY_KO[extra[0]])) if extra else (
                "cardio_extra", "tc_rec_cardio_extra_ask", {})
        if o["pick"] == "add_day":
            return "add_day", "tc_rec_add_day", {}
        return "stretch", ("tc_rec_stretch_floor" if o.get("ext")
                           else "tc_rec_stretch_full"), {}
    if "goal" in by:
        return "goal", "tc_rec_goal", {}
    if "extend" in by:
        return "extend", "tc_rec_extend_part", dict(
            extra=by["extend"]["extend"])
    if every and "cardio_extra" in by:
        return "cardio_extra", "tc_rec_cardio_fit", {}
    if "stretch" in by:
        return "stretch", "tc_rec_stretch", {}
    if "keep" in by:
        return "keep", "tc_rec_keep", {}
    return opts[0]["pick"], "tc_rec_redo", {}


def _date_said(d, ref):
    """'Dec 24' said, with the year when it is not the reference year."""
    if d.year != ref.year:
        return T("card_date", y=d.year, m=d.month, d=d.day)
    return T("ga_md", m=d.month, d=d.day)


def _num_said(x):
    """A goal value said: one decimal at most (31.4, 20)."""
    return ("%.1f" % x).rstrip("0").rstrip(".")


GOAL_UNITS = {"skeletal_muscle_kg": "kg", "lift_capacity_kg": "kg",
              "body_weight": "kg", "body_fat_pct": "pct"}


def goal_options(cx, adj, pr, via, cardio_cut, extra, n):
    """[the goal adjustment option, and the target narrowing when its number
    can be computed] (owner 2026-10-04 21:27-21:31, 2026-10-05). The goal
    option says what changes in the GOAL first -- the lowest-priority
    goal's date moved (a strength goal by the weekly sets kept; a fat goal
    whose cardio gives way by the kit's energy model), it leaves the focus
    (no record computes a date), or a cut's muscle-keeping branch eased --
    then the cuts, chosen by what the surviving goal needs (keep), as the
    supporting line. The narrowing keeps the date and scales the target by
    the same rate share; offered only where that share is computed and the
    goal's current value is on record. [] when nothing can be computed."""
    g, first = adj["goal"], adj["first"]
    cut_line, cut_note = plan_cuts(cx, pr)
    wa, wb = weekly_sets(cx), weekly_sets(pr)
    kept = sum(_isets(wb.get(m, 0)) for m in wa)
    whole = sum(_isets(v) for v in wa.values())
    info = dict(kind=adj["kind"], goal_id=g["id"], via=via,
                metric=g["metric"], keep=list(adj["keep"]),
                cardio_keep=adj.get("cardio_to"))
    fname = goal_name(first)
    name = goal_name(g)
    single = len(adj["goals"]) == 1
    common = dict(goal=name, eun=josa(name, "eun"), first=fname,
                  first_eun=josa(fname, "eun"))
    narrow = None       # the share of the rate kept, for the narrowing
    if adj["kind"] == "deadline":
        try:
            end = datetime.date.fromisoformat(str(g["horizon"])[:10])
        except ValueError:
            return []
        left = (end - cx.today).days
        if left <= 0 or not whole or not kept:
            return []
        frac = kept / float(whole)
        to = cx.today + datetime.timedelta(days=int(math.ceil(left / frac)))
        pct = int(math.floor(frac * 100 + 0.5))
        said = dict(common, a=_date_said(end, cx.today),
                    b=_date_said(to, cx.today), pct=pct)
        head = T("ga_deadline_self" if single else "ga_deadline", **said)
        done = T("ga_set_deadline", **said)
        info.update(frm=end.isoformat(), to=to.isoformat(),
                    card=g is first)
        narrow = dict(frac=frac, end=end, why=T("gn_why_sets", pct=pct))
    elif adj["kind"] == "fat":
        cf, ct = adj["cardio_from"], adj["cardio_to"]
        en = fat_energy(cx, g, cf - ct, n)
        said = dict(common, cf=cf, ct=ct)
        if en:
            to = cx.today + datetime.timedelta(
                days=int(math.ceil(en["left"] / en["frac"])))
            less = int(round(en["less"] / 10.0)) * 10
            said.update(a=_date_said(en["end"], cx.today),
                        b=_date_said(to, cx.today), less=less,
                        need=int(round(en["need"] / 10.0)) * 10)
            head = T("ga_fat_deadline", **said)
            done = T("ga_set_fat_deadline", **said)
            info.update(frm=en["end"].isoformat(), to=to.isoformat(),
                        card=False)
            narrow = dict(en, why=T("gn_why_fat", less=less))
        else:
            # no record computes the date (weight, body fat, the cardio
            # type): the goal leaves the focus, said so -- never a date
            head = T("ga_fat_focus", **said)
            done = T("ga_set_fat_focus", **said)
            info.update(kind="fat_focus", frm=g["focus"], to="backlog")
    elif adj["kind"] == "focus":
        head = T("ga_focus", **common)
        done = T("ga_set_focus", **common)
        info.update(frm=g["focus"], to="backlog")
    else:
        branch = goal_name(g, branch=True)
        try:
            end = datetime.date.fromisoformat(str(g["horizon"])[:10])
        except (TypeError, ValueError):
            end = None
        said = dict(first=fname, first_eul=josa(fname, "reul"),
                    branch=branch, branch_eun=josa(branch, "eun"),
                    date=_date_said(end, cx.today) if end else "")
        head = T("ga_branch" if end else "ga_branch_nodate", **said)
        done = T("ga_set_branch", **said)
    head += " " + T("ga_needed")
    if not adj["recorded"]:
        # no priority on record: the order assumed, said, and flippable in
        # the same decision (sessions answer first_goal)
        other = goal_name(adj["goals"][-1])
        head += " " + T("ga_assumed", first=fname,
                        first_eul=josa(fname, "reul"), other=other,
                        other_i=josa(other, "i"))
        info["assumed"] = [dict(id=x["id"], name=goal_name(x))
                           for x in adj["goals"]]
    under = below_floor(pr)
    detail = cut_line
    if via == "cardio_extra":
        kw = dict(cardio_cut["kw"], **cardio_cut["day"])
        detail = T("tc_cardio_move" if extra else "tc_cardio_move_ask",
                   **kw) + " " + detail
    if under:
        ms = muscles_said(cx, under)
        detail += " " + T("ga_under", muscles=ms, i=josa(ms, "i"))
    if via == "cardio_extra" and not extra:
        detail += " " + T("tc_ask_cardio_day")
    note = done + " " + T("ga_reversible") + " " + cut_note
    out = [dict(pick="goal", title=T("ga_title"), line=head, detail=detail,
                goal=info, under=under, note=note)]
    o = narrow_option(cx, g, narrow, info, cut_note) if narrow else None
    if o:
        out.append(o)
    return out


def narrow_option(cx, g, nw, info, cut_note):
    """The target narrowed, the date kept (owner 2026-10-05): the change the
    goal still asks for, scaled by the share of its rate the plan keeps --
    the very share the deadline move reads (the weekly sets kept for a
    strength goal; the kit's energy model for a fat goal). None unless the
    goal's current value and target are on record."""
    unit = GOAL_UNITS.get(g["metric"])
    try:
        target = float(g["target"])
    except (TypeError, ValueError):
        return None
    if g["metric"] == "body_fat_pct" and "fat_now" in nw:
        # fat kg to lose scaled, fat-free mass held (the kit's pace model);
        # rounded toward the easier side
        fat = nw["fat_now"] - (nw["fat_now"] - nw["fat_goal"]) * nw["frac"]
        new = math.ceil(fat / (nw["ffm"] + fat) * 1000.0) / 10.0
        if not target < new:
            return None
    elif g["metric"] in STRENGTH_GOAL_METRICS:
        cur = _latest(cx, (g["metric"],))
        if cur is None or not target > cur:
            return None
        new = math.floor((cur + (target - cur) * nw["frac"]) * 10.0) / 10.0
        if not cur < new < target:
            return None
    else:
        return None
    name = goal_name(g)
    said = dict(goal=name, date=_date_said(nw["end"], cx.today),
                a=T("gn_val_" + unit, v=_num_said(target)),
                b_to=T("gn_to_" + unit, v=_num_said(new)))
    line = T("gn_line", **said) + " " + nw["why"] + " " + T("gn_same")
    done = T("gn_set", **said)
    return dict(pick="goal_narrow", title=T("gn_title"), line=line,
                goal=dict({k: v for k, v in info.items()
                           if k not in ("frm", "to", "card")},
                          kind="target", frm_target=target, to_target=new),
                note=done + " " + T("ga_reversible") + " " + cut_note)


def probe_plan(cx, **plan):
    """A scratch copy composed and accepted under time_plan overrides (the
    state untouched), or None when nothing composes there or the plan fails
    the goal self-check -- a split the minutes cannot hold is never offered,
    so the sessions step cannot loop on it (owner 2026-10-04)."""
    pr = copy.copy(cx)
    pr.st = copy.deepcopy(cx.st)
    pr.save = lambda: None
    pr.st["time_plan"] = dict(pr.st.get("time_plan") or {}, **plan)
    for k in ("compose", "volume_shortfall", "sessions", "time_decision",
              "self_check", "session_sets", "set_adjust"):
        pr.st.pop(k, None)
    try:
        draft = resolve_compose(pr, {"accept": True})
        if validate_compose(pr, draft):
            return None
        accept_compose(pr, draft)
        if self_check(pr).get("goal") is False and not (
                pr.st.get("self_check_lone") and cx.st.get(
                    "self_check_lone")):
            # failing only on "every region twice a week" while the plan
            # shown does too: the split's own shape (the body-part split
            # visits each region once), not this pick's -- offered
            return None
    except (Refused, KeyError, ValueError):
        return None
    return pr


def plan_lifts(cx):
    """{code: [(name, display, sets)]} as the plan would write them."""
    doc = answers_doc(cx, final_days(cx), provisional=True)
    return {c: [(e["name"], e["display"], e["sets"])
                for e in d["exercises"]] for c, d in doc["days"].items()}


def weekly_sets(cx):
    """{muscle: proposed weekly sets} of the plan; {} with no audit."""
    try:
        audit = run_audit(cx, answers_doc(cx, final_days(cx),
                                          provisional=True))
    except Exception:                                       # noqa: BLE001
        return {}
    return {m: e["proposed_weekly_sets"]
            for m, e in (audit.get("per_muscle") or {}).items()}


def _names(names, cap=6):
    if len(names) > cap:
        return T("tc_cut_more", lifts=T("sm_site_sep").join(names[:cap - 1]),
                 n=len(names) - cap + 1)
    return T("sm_site_sep").join(names)


def plan_cuts(cx, pr):
    """(line, note): what plan `pr` takes out of the current one -- the
    lifts out, the sets fewer, the strength minutes it fits, and the weekly
    sets each muscle loses (D12: the trade-off with its numbers). The note
    is the same cut said as done (the next message)."""
    import compose_rank
    a, b = plan_lifts(cx), plan_lifts(pr)
    dropped, fewer, kept = [], {}, set()
    for code, lifts in a.items():
        after = {nm: s for nm, _d, s in b.get(code, [])}
        for nm, d, s in lifts:
            if nm not in after:
                if d not in dropped:
                    dropped.append(d)
                continue
            kept.add(d)
            if after[nm] < s:
                names = fewer.setdefault((s, after[nm]), [])
                if d not in names:
                    names.append(d)
    s = compose_rank.time_budget(pr, _minutes)["strength"]
    if not dropped and not fewer:
        line = T("tc_cut_none", s=s)
        return line, line
    groups = []
    for (s0, s1), names in sorted(fewer.items(), reverse=True):
        if len(fewer) == 1 and set(names) >= kept:
            groups.append(T("tc_cut_sets_all", a=s0, b=s1))
        else:
            ns = _names(names)
            groups.append(T("tc_cut_sets_item", lifts=ns,
                            eun=josa(ns, "eun"), a=s0, b=s1))
    sets = ", ".join(groups)
    lifts = _names(dropped) if dropped else ""
    cut = (T("tc_cut_both", lifts=lifts, reul=josa(lifts, "reul"),
             sets=sets) if dropped and groups else
           T("tc_cut_drop", lifts=lifts, reul=josa(lifts, "reul"))
           if dropped else T("tc_cut_sets", sets=sets))
    line = T("tc_fit_now", cut=cut, s=s)
    wa, wb = weekly_sets(cx), weekly_sets(pr)
    # whole sets before and after, the loss their difference
    loss = sorted(((m, _isets(wa[m]) - _isets(wb.get(m, 0))) for m in wa
                   if _isets(wa[m]) - _isets(wb.get(m, 0)) > 0),
                  key=lambda x: (-x[1], x[0]))[:3]
    if loss:
        items = T("sm_site_sep").join(
            T("tc_cut_effect_item", muscle=UL.muscle_ko(m, cx.db), n=k)
            for m, k in loss)
        line += " " + T("tc_cut_effect", items=items, i=josa(items, "i"))
    return line, T("tc_fit_done", cut=cut, s=s)


def day_trims(cx, chk):
    """{weekday: {code: [display]}}: what session-open takes off a short
    day under the shrink -- session_day_trim.cut_lineup, the very rule it
    runs: the lowest-priority lifts from the end until the day's lift
    minutes hold. Said in the decision, never silent (D12)."""
    import compose_rank
    import session_day_trim
    tb = compose_rank.time_budget(cx, _minutes)
    blocks = tb["strength"] - tb["lift_minutes"]
    doc = answers_doc(cx, final_days(cx), provisional=True)
    rx = init_mod()._load_rx()
    out = {}
    for d in UL.WEEKDAY_ORDER:
        if d not in chk["short"] or d not in tb["per_day"]:
            continue
        cap = max(0, tb["per_day"][d] - blocks)
        out[d] = {}
        for code in cx.st["structure"]["rotation"]:
            _kept, removed = session_day_trim.cut_lineup(
                doc["days"][code]["exercises"], cap, rx)
            out[d][code] = [e["display"] for e in removed]
    return out


def trim_sentence(cx, trims, done=False):
    """Tuesday: on upper A the barbell row is left out, on lower A the leg
    curl -- per short day (the same cut grouped), per session the queue may put
    on it."""
    cut = T("tc_verb_done" if done else "tc_verb_now")
    groups = {}
    for d, per in trims.items():
        key = json.dumps(per, sort_keys=True, ensure_ascii=False)
        groups.setdefault(key, (per, []))[1].append(d)
    out = []
    for per, ds in groups.values():
        days = _days_compact(ds)
        lists = {tuple(v) for v in per.values()}
        if lists == {()}:
            out.append(T("tc_trim_none", days=days))
        elif len(lists) == 1:
            lifts = _names(list(next(iter(lists))))
            out.append(T("tc_trim_same", days=days, lifts=lifts,
                         reul=josa(lifts, "reul"), cut=cut))
        else:
            items = []
            for code, v in per.items():
                if v:
                    ns = _names(v)
                    items.append(T("tc_trim_item", session=code,
                                   i=josa(code, "i"), lifts=ns,
                                   reul=josa(ns, "reul")))
            out.append(T("tc_trim_by", days=days, items=", ".join(items),
                         cut=cut))
    return " ".join(out)


def stretch_plan(cx, chk, ext=0):
    """(windows, minutes a day, [(days, start, end)]): every short day's
    window lengthened to the day-total (D12 (a), more time) plus `ext`
    minutes for the weekly floor, or None when one would run past
    midnight."""
    st = cx.st
    total = chk["total"] + ext
    avail = st.get("available_minutes")
    out, said = [], []
    for w in st["daytime"]["windows"]:
        ds = [d for d in w["weekdays"] if d in chk["short"]]
        if not ds:
            out.append(w)
            continue
        rest = [d for d in w["weekdays"] if d not in ds]
        if rest:
            out.append(dict(w, weekdays=rest))
        if w.get("start") and w.get("end") and \
                _minutes(w["start"], w["end"]) < total:
            end = _plus(w["start"], total)
            if end is None:
                return None
            out.append(dict(w, weekdays=ds, end=end))
            said.append((ds, w["start"], end))
        else:
            out.append(dict(w, weekdays=ds))
    out.sort(key=lambda w: UL.WEEKDAY_ORDER.index(w["weekdays"][0]))
    return out, (total if avail and avail < total else avail), said


def stretch_lines(cx, chk, plan, ext=0, short=()):
    """(line, note) of the stretch: the new windows (or the minutes a day)
    and the whole recommended day (with `ext`: the floor filled too)."""
    _wins, avail, said = plan
    total = chk["total"] + ext
    parts = []
    for ds, start, end in said:
        rng = ko_range(start, end)
        parts.append(T("tc_stretch_win", days=_days_compact(ds), range=rng,
                       ro=josa(rng, "ro")))
    ms = short_muscles(cx, short) if ext else ""
    if parts:
        wins = ", ".join(parts)
        return (T("tc_stretch_ext" if ext else "tc_stretch", wins=wins,
                  total=total, muscles=ms),
                T("tc_set_stretch", wins=wins, total=total))
    gap = total - (cx.st.get("available_minutes") or total)
    return (T("tc_stretch_minutes_ext" if ext else "tc_stretch_minutes",
              gap=gap, total=total, muscles=ms),
            T("sess_extended", total=total))


def apply_stretch(cx, note, ext=0):
    """The stretch pick: the windows (or the minutes a day) hold the whole
    day; the sessions composed to it stand. With `ext` (the weekly floor):
    the day grows by it and the sessions are composed again."""
    st = cx.st
    plan = stretch_plan(cx, time_check(cx), ext)
    if plan is None:
        raise Refused("E-PICK\tpick\tno window holds the day past midnight")
    wins, avail, _said = plan
    st["daytime"]["windows"] = wins
    if avail:
        st["available_minutes"] = avail
    tp = st["time_plan"]
    whole = tp.get("pick") == "shrink" and not ext
    tp.update(pick="fits", decided=True)
    tp.pop("short", None)
    st.pop("time_decision", None)
    if ext:
        st["day_minutes"] = tp["total"] = day_total(cx) + ext
    if whole:
        # composed to the whole day already: the sessions stand
        st["sessions"] = "ok"
    else:
        for k in ("compose", "volume_shortfall", "sessions"):
            st.pop(k, None)
    st.setdefault("notes", []).append({"text": note, "at": None})


def apply_redo(cx):
    """Nothing holds a plan in the time said: the days asked again."""
    for k in ("daytime", "days", "time_plan", "structure", "split_offer",
              "compose", "volume_shortfall", "sessions", "time_decision"):
        cx.st.pop(k, None)


def _goal_detail(cx, gid, **add):
    """The goal's detail JSON with `add` merged (goal-set --detail writes
    the whole field: what is there is kept)."""
    rows = _q(cx.db, "SELECT detail FROM ledger_goal WHERE id=?", (gid,))
    try:
        d = json.loads(rows[0][0]) if rows and rows[0][0] else {}
    except (ValueError, TypeError):
