def volume_lines(cx, audit):
    lines = []
    for m, e in volume_violations(audit):
        name = UL.muscle_ko(m, cx.db)
        n = int(round(e["proposed_weekly_sets"]))
        if e["verdict"] == "below_floor":
            lines.append(T("volume_below", muscle=name, n=n,
                           floor=e["band"]["floor"]))
        else:
            lines.append(T("volume_above", muscle=name, n=n,
                           ceiling=e["band"]["ceiling"]))
    for said in (practice_line(cx, audit.get("practice")),
                 functional_line(cx, audit.get("practice"))):
        if said:
            lines.append(said)
    return lines


def volume_say(cx, path, as_json):
    """The revision lane's renderer: audit a draft card and print the user
    lines for its volume findings -- the same sentences the first build uses,
    so a verdict term never has to be paraphrased by the model (E8)."""
    rx = init_mod()._load_rx()
    try:
        program = rx.load_yaml(path)
        audit = rx.volume_audit(program, cx.db, cx.today.isoformat())
    except Exception as e:                                  # noqa: BLE001
        sys.stderr.write("program-plan: volume-say could not audit %s: %s\n"
                         % (path, e))
        return EXIT_ERR
    unmapped = sorted(audit.get("unmapped_program") or [])
    out = {"lines": volume_lines(cx, audit), "unmapped": unmapped}
    if as_json:
        print(json.dumps(out, ensure_ascii=False, indent=2))
    else:
        for ln in out["lines"]:
            print(ln)
    if unmapped:
        sys.stderr.write("program-plan: UNMAPPED lifts %s -- no muscle map, "
                         "so no verdict for them. Pick a mapped lift; a new "
                         "mapping ships as a reviewed taxonomy row, never a "
                         "runtime write.\n" % ", ".join(unmapped))
        return EXIT_REFUSED
    return EXIT_OK


