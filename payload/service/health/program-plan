                             sorted(init_mod().LATTICE_BY_EQUIPMENT))}})
    if p and p.get("venue") == "home" and "equipment" not in p:
        return pmove(cx, "ask", "place",
                     say=T("home_equipment_ask"),
                     choices=[choice("have", T("c_have")),
                              choice("have_not", T("c_have_not"))],
                     answer={"stage": "place", "payload": {"facilities": facilities,
                         "pick": "have | have_not"}})
    if gym_name_pending(p):
        # owner 17:43: which gym -- registered as the place, the basis for
        # swapping lifts on a day spent somewhere else. A gym the goal part
        # already recorded is stated on the card, never asked (owner
        # rehearsal 2026-10-01): only its name is.
        known = p.get("source") in ("handoff", "record")
        return pmove(cx, "ask", "place:gym_name", fold_card=known,
                     say=T("gym_known_ask" if known else "gym_name_ask"),
                     answer={"stage": "place", "payload": {"facilities": facilities,
                         "pick": "named | unnamed",
                         "name": "on named: the gym's name as the user said "
                                 "it", "area": "optional: the area/동네"}})
    if not cx.st.get("place_no_gym"):
        # owner 2026-10-08 13:56: the plain fact first; "not yet" -> the
        # recommendation ask below (the gym's name comes after "have")
        return pmove(cx, "ask", "place", say=T("place_ask"),
                     choices=[choice("gym", T("c_gym_have")),
                              choice("none", T("c_gym_none")),
                              choice("home", T("c_home"))],
                     answer={"stage": "place", "payload": {"facilities": facilities,
                         "pick": "gym | none | home | other",
                         "words": "the user's words (other)",
                         "equipment": "on other: list from %s" % ", ".join(
                             sorted(init_mod().LATTICE_BY_EQUIPMENT))}})
    return pmove(cx, "propose", "place", say=T("place_reco_ask"),
                 choices=[choice("gym", T("c_gym"), True),
                          choice("home", T("c_home")),
                          choice("other", T("c_other_place"))],
                 answer={"stage": "place", "payload": {"facilities": facilities,
                     "pick": "gym | home | other | later",
                     "words": "the user's words (other)",
                     "equipment": "on other: list from %s" % ", ".join(
                         sorted(init_mod().LATTICE_BY_EQUIPMENT))}})


def gym_name_pending(p):
    """A gym with no name on record or in the answer (P1: '어느 헬스장')."""
    return bool(p) and p.get("venue") == "gym" and "name" not in p and \
        not p.get("label")


def place_open(cx):
    """True while the place still needs a question."""
    p = cx.st.get("place")
    return (p.get("venue") == "home" and "equipment" not in p) or \
        p.get("venue") is None or gym_name_pending(p) or \
        place_near_pending(p)


def register_gym(cx, name, area, cur=None):
    """The gym becomes the stored place (the kit's resource-add, the same
    row venue_record reads), once. 074 kit: the row IS the kit place
    (land_gym, --place) once the place is settled; a pending near question
    defers it (resource-add would ask the same question again)."""
    if cur is not None and kit_anchor_ready():
        if cur.get("place_id"):
            land_gym(cx, cur)
            return
        if place_near_pending(cur):
            return
    detail = {"venue": "gym", "equipment": []}
    if area:
        detail["area"] = area
    rc, _o, e = kit(["resource-add", "--kind", "env", "--name", name,
                     "--detail", json.dumps(detail, ensure_ascii=False),
                     "--source", "interview"] + anchor_args("gym", name))
    if rc != 0:
        cx.st.setdefault("kit_errors", []).append(
            "resource-add: %s" % (e or "").strip()[-200:])


# -- the place as a kit place (gym-place-wire 2026-10-09) ----------------------
# The gym answer used to reach the kit only as a resource row (register_gym)
# and memory: no `place`, so the workout routine had no place and the travel
# engine never put a move / prep block in front of a session. The answer now
# resolves (or registers) a kit place and the workout routines carry it --
# all
# through kit verbs: place-resolve, travel-place-add, near-match-accept,
# routine add place= / routine update place=.
def kit_place(cx, name):
    """place-resolve: ('ok', id, name) | ('near', cands, ask) | ('absent',)
    | ('error', why). cands = [{'id', 'name'}]."""
    rc, out, e = kit(["place-resolve", name])
    if rc != 0:
        return ("error", "place-resolve: %s" % (e or out or "").strip()[-200:])
    lines = (out or "").splitlines()
    head = lines[0].split("\t") if lines else [""]
    if head[0] in ("RESOLVED", "VIA_ANCHOR") and len(head) > 2:
        return ("ok", int(head[1]), head[2])
    if head[0] == "NEAR_MATCH":
        cands, ask = [], ""
        for ln in lines[1:]:
            f = ln.split("\t")
            if f[0] == "ASK":
                ask = f[1] if len(f) > 1 else ""
            elif f[0].isdigit() and len(f) > 1:
                cands.append({"id": int(f[0]), "name": f[1]})
        return ("near", cands, ask)
    return ("absent",)


def ensure_place(cx, name, note=None, confirmed_new=False):
    """The name as a kit place: resolved, else registered (travel-place-add,
    the one place insert path) and resolved again. A near match is returned
    for the one question, never guessed. confirmed_new = the owner said
    "a different place" to that question."""
    r = ("absent",) if confirmed_new else kit_place(cx, name)
    if r[0] != "absent":
        return r
    args = ["travel-place-add", name]
    if note:
        args.append("note=%s" % note)
    if confirmed_new:
        args.append("--new-confirmed")
    rc, out, e = kit(args)
    if rc != 0:
        return ("error", "travel-place-add: %s"
                % (e or out or "").strip()[-200:])
    r = kit_place(cx, name)
    return r if r[0] == "ok" else ("error", "travel-place-add: %s not "
                                   "resolvable after the add" % name)


def home_place(db):
    """(id, name) of the kit's base place (home), or None."""
    rows = _q(db, "SELECT p.id, COALESCE(l.display, p.name) FROM place p "
                  "LEFT JOIN label l ON l.namespace='place' AND "
                  "l.token=p.token AND l.lang='ko' WHERE p.is_base=1 "
                  "ORDER BY p.id LIMIT 1")
    if not rows:
        rows = _q(db, "SELECT id, name FROM place WHERE is_base=1 "
                      "ORDER BY id LIMIT 1")
    return (rows[0][0], rows[0][1]) if rows else None


def _place_settle(cur, r):
    """Fold an ensure_place verdict into a place record."""
    if r[0] == "ok":
        cur["place_id"], cur["place_name"] = r[1], r[2]
        cur.pop("place_near", None)
    elif r[0] == "near":
        cur["place_near"] = {"cands": r[1], "ask": r[2]}
    return r


def link_gym_place(cx, cur):
    """The named gym as a kit place (once). Kit-free / replay: nothing."""
    if not getattr(cx, "side_effects", True) or cur.get("place_id"):
        return None
    name = cur.get("name") or cur.get("label")
    if not name:
        return None
    r = ensure_place(cx, name, note=cur.get("area"))
    if r[0] == "near":
        cur["place_near"] = {"query": name, "cands": r[1], "ask": r[2]}
    elif r[0] == "error":
        cx.st.setdefault("kit_errors", []).append(r[1])
    else:
        _place_settle(cur, r)
    cx.save()
    return r


def place_near_pending(p):
    return bool(p) and bool(p.get("place_near")) and not p.get("place_id")


def answer_place_near(cx, cur, payload):
    """The near-match question's answer: a listed place (the kit learns the
    said name as its alias: near-match-accept) or 'new' (a different place:
    registered as said)."""
    near = cur.get("place_near") or {}
    ids = [str(c["id"]) for c in near.get("cands") or ()]
    p = _pick(payload, tuple(ids) + ("new",))
    query = near.get("query") or cur.get("name") or cur.get("label") or ""
    if p == "new":
        r = ensure_place(cx, query, note=cur.get("area"), confirmed_new=True)
    else:
        rc, _o, e = kit(["near-match-accept", "place", p, query])
        if rc != 0:
            cx.st.setdefault("kit_errors", []).append(
                "near-match-accept: %s" % (e or "").strip()[-200:])
        name = [c["name"] for c in near["cands"] if str(c["id"]) == p][0]
        r = ("ok", int(p), name)
    if r[0] == "error":
        raise Refused("E-PLACE-KIT\tplace\t%s" % r[1])
    if r[0] == "near":
        raise Refused("E-PLACE-KIT\tplace\tstill a near match: %s" % query)
    cur.pop("place_near", None)
    _place_settle(cur, r)
    land_gym(cx, cur)


def routine_place(cx):
    """The place name the workout routines carry, or None: the gym linked to a
    kit place, or home (the base place: no travel)."""
    p = cx.st.get("place") or {}
    if p.get("place_name"):
        return p["place_name"]
    if p.get("venue") == "home":
        h = home_place(cx.db)
        return h[1] if h else None
    return None


def _routine_place_ids(db):
    """{routine id: place_id} of the active routines; {} on a store without
    the column (nothing is updated then)."""
    return {rid: pid for rid, pid in _q(
        db, "SELECT id, place_id FROM routine_def WHERE status='active'")}


def set_routine_place(cx, rid, name):
    """`routine update <id> place=<name>` -> (ok, travel tuple or None)."""
    rc, out, e = kit(["routine", "update", str(rid), "place=%s" % name])
    if rc != 0:
        cx.st.setdefault("kit_errors", []).append(
            "routine update %s place: %s" % (rid, (e or out or "")
                                              .strip()[-200:]))
        return False, None
    travel = None
    for ln in (out or "").splitlines():
        f = ln.split("\t")
        if f[0] == "routine-travel-attach" and len(f) >= 6:
            travel = {"status": f[3], "origin": f[4], "dest": f[5]}
    return True, travel


# -- place-fix: an install whose workout routine has no place (asked once) ---
def place_fix_targets(cx):
    """Active workout routines with no place."""
    pids = _routine_place_ids(cx.db)
    return [w for w in calendar_routines(cx.db, "exercise")
            if w["id"] in pids and pids[w["id"]] is None]


def place_fix_choices(cx):
    """Buttons: the places the records already know for training -- the
    consult's gym, the stored training place, the machine registry's gym --
    then home. Free text answers the rest (pick=named)."""
    seen, out = set(), []

    def add(pid, name):
        if pid is not None and name and pid not in seen:
            seen.add(pid)
            out.append(choice(str(pid), name))
    p = cx.st.get("place") or {}
    add(p.get("place_id"), p.get("place_name"))
    _venue, label = venue_record(cx.db)
    for name in (label, ax_gym_name(cx.db)):
        if name:
            r = kit_place(cx, name)
            if r[0] == "ok":
                add(r[1], r[2])
    h = home_place(cx.db)
    if h:
        add(h[0], h[1])
    return out[:4]


def _place_fix_near_move(pf):
    near = pf["near"]
    cands = near.get("cands") or ()
    return move("ask", "place_fix",
                say=near.get("ask") or T("place_near_ask"),
                choices=[choice(str(c["id"]), c["name"]) for c in cands]
                + [choice("new", T("c_place_near_new"))],
                answer={"stage": "place_fix", "payload": {
                    "pick": " | ".join([str(c["id"]) for c in cands]
                                       + ["new"])}})


def place_fix_move(cx):
    """`program-plan place-fix`: ONE question, once, when a workout routine
    has no place. kind=none when there is nothing to fix or it was asked."""
    targets = place_fix_targets(cx)
    pf = cx.st.get("place_fix") or {}
    if not targets:
        return {"kind": "none", "stage": "place_fix",
                "reason": "no_routine_without_place"}
    if pf.get("near"):
        return _place_fix_near_move(pf)
    if pf.get("asked_at"):
        return {"kind": "none", "stage": "place_fix", "reason": "asked",
                "asked_at": pf["asked_at"]}
    pf["asked_at"] = cx.today.isoformat()
    cx.st["place_fix"] = pf
    cx.save()
    return move("ask", "place_fix", say=T("place_fix_ask"),
                choices=place_fix_choices(cx),
                answer={"stage": "place_fix", "payload": {
                    "pick": "<a listed place id> | named",
                    "name": "on named: the place as the user said it"}},
                routines=[w["id"] for w in targets])


def answer_place_fix(cx, payload):
    """The place-fix answer -> a kit place -> every workout routine without
    one gets it (routine update place=). Returns the closing move."""
    pf = cx.st.get("place_fix") or {}
    if not isinstance(payload, dict):
        raise Refused("E-PLACE\tpick\t<place id> | named")
    pick = str(payload.get("pick") or "")
    if pf.get("near"):
        near = pf["near"]
        ids = [str(c["id"]) for c in near.get("cands") or ()]
        p = _pick(payload, tuple(ids) + ("new",))
        if p == "new":
            r = ensure_place(cx, near["query"], confirmed_new=True)
        else:
            kit(["near-match-accept", "place", p, near["query"]])
            r = ("ok", int(p), [c["name"] for c in near["cands"]
                                if str(c["id"]) == p][0])
    elif pick == "named":
        name = " ".join(str(payload.get("name") or "").split())
        if not name:
            raise Refused("E-PLACE-NAME\tname\tthe place as the user "
                          "said it")
        try:
            _copy_gate(name, "place.name")
        except CopyLeak as e:
            raise Refused("E-PLACE-NAME\tname\t%s" % e)
        r = ensure_place(cx, name)
        if r[0] == "near":
            pf["near"] = {"query": name, "cands": r[1], "ask": r[2]}
            cx.st["place_fix"] = pf
            cx.save()
            return _place_fix_near_move(pf)
    elif pick.isdigit():
        r = None
        for c in place_fix_choices(cx):
            if c["pick"] == pick:
                r = ("ok", int(pick), c["label"])
        if r is None:
            raise Refused("E-PLACE\tpick\tnot a listed place: %s" % pick)
    else:
        raise Refused("E-PLACE\tpick\t<place id> | named")
    if r[0] != "ok":
        raise Refused("E-PLACE-KIT\tplace\t%s" % (r[1] if len(r) > 1
                                                     else r[0]))
    pf.pop("near", None)
    done, travel = [], []
    for w in place_fix_targets(cx):
        ok, t = set_routine_place(cx, w["id"], r[2])
        if ok:
            done.append(w["id"])
            if t:
                travel.append(dict(t, routine=w["id"]))
    pf.update({"answered_at": cx.today.isoformat(), "place_id": r[1],
               "place_name": r[2], "routines": done})
    cx.st["place_fix"] = pf
    cx.save()
    h = home_place(cx.db)
    home = bool(h) and h[0] == r[1]
    out = move("done", "place_fix",
               say=T("place_fix_done_home" if home else "place_fix_done",
                     place=r[2], ro=josa(r[2], "ro")),
               routines=done, errors=cx.st.get("kit_errors") or [])
    owed = [t for t in travel if t["status"] in ("edge_missing",
                                                 "no_duration")]
    if owed:
        # the kit could not time the trip: the agent asks the minutes once
        # and runs travel-edge-add <origin> <dest> <min> (place-manage)
        out["travel"] = owed
        out["do"] = ("ask how many minutes the trip takes, then "
                     "travel-edge-add <origin> <dest> <min>")
    return out


def place_from_record(cx):
    """A stored place is READ, never re-asked -- its filled card line is the
    confirmation. A place stored with no kind (a name only) gets ONE
    equipment confirm -- its name is known, what is in it is not, and a gym
    is never assumed (F7)."""
    venue, label = venue_record(cx.db)
    if venue is None:
        return False
    if venue == "other" and label:
        cx.st["place"] = {"venue": None, "label": label, "source": "record"}
        cx.save()
        return True
    cx.st["place"] = {"venue": venue, "label": label, "source": "record",
                      "equipment": [] if venue != "home" else ["dumbbell"]}
    cx.save()
    return True


# the goal part's activity words naming a gym ("heolseu" in Korean)
GYM_WORDS = re.compile("\ud5ec\uc2a4|gym|fitness", re.I)


def place_from_handoff(cx):
    """The goal part recorded that the user trains at a gym (the kit
    handoff's activity words / card line): the place is the gym, stated on
    the card -- only its name is asked."""
    if not GYM_WORDS.search(_words(handoff(cx).get("activity"))):
        return False
    cx.st["place"] = {"venue": "gym", "source": "handoff", "equipment": []}
    cx.save()
    return True


# -- frequency (owner 2026-10-01: the program's first question) -------------
FREQ_MIN, FREQ_MAX = 1, 7          # any answer in range is the user's own
FREQ_MENU_MIN, FREQ_MENU_MAX = 2, 6
# the kit's activity words: "<week> 3~4 <times>", "<week> 3 <times|days>"
ACTIVITY_FREQ = re.compile(r"\uc8fc\s*(\d)(?:\s*[~\-]\s*(\d))?\s*"
                           r"(?:\ud68c|\ubc88|\uc77c)")


def _words(v):
    if isinstance(v, dict):
        return " ".join(_words(x) for x in v.values())
    if isinstance(v, (list, tuple)):
        return " ".join(_words(x) for x in v)
    return str(v) if v is not None else ""


def frequency_rec(cx):
    """(recommended count, why kind, the user's current frequency words):
    the current frequency from the kit handoff (upper bound of a range),
    else the training band (a beginner 3, otherwise 4)."""
    m = ACTIVITY_FREQ.search(_words(handoff(cx).get("activity")))
    if m:
        lo, hi = int(m.group(1)), int(m.group(2) or m.group(1))
        n = min(max(hi, FREQ_MENU_MIN), FREQ_MENU_MAX)
        now = (T("freq_now_range", a=lo, b=hi) if hi != lo
               else T("freq_now_one", a=lo))
        return n, "now", now
    band = cx.st.get("years_band") or handoff(cx).get("training_band")
    # a never-trained history fixes the band by itself (IMPLIED_BAND)
    if "lt1" in (band, IMPLIED_BAND.get(cx.st.get("experience"))):
        return 3, "beginner", None
    return 4, "goal", None


def frequency_options(rec):
    lo = min(max(rec - 1, FREQ_MENU_MIN), FREQ_MENU_MAX - 2)
    return [lo, lo + 1, lo + 2]


SPACED_MAX = 3      # this many days or fewer fit a week with a rest between


def site_names(st):
    """The safety sites without their side, each once ('knee', 'shoulder')."""
    return list(dict.fromkeys(UL.site_ko(it.get("site"))
                              for it in st.get("safety_items") or ()
                              if it.get("site")))


def frequency_lines(position, n, phase, sites, floor):
    """(good, bad) for the option at `position` (fewest / middle / most
    days of the three) -- a small template table, not a generator."""
    cut = "_cut" if phase == "cut" else ""
    if position == "fewest":
        return (T("freq_pro_fewest" + cut),
                T("freq_con_fewest", floor=floor))
    if position == "middle":
        return (T("freq_pro_middle", floor=floor),
                T("freq_con_middle_spaced" if n <= SPACED_MAX
                  else "freq_con_middle"))
    tail = "_sites" if sites else ""
    return (T("freq_pro_most"),
            T("freq_con_most" + cut + tail, sites=T("sm_site_sep").join(sites)))


# The day's dose (owner 2026-10-02): ONE day-total, the whole gym day --
# prep + strength + cardio + cooldown. Recommended by training history --
# ONE table to tune, (low, high) minutes of the whole day. A returner takes
# the 1-3 year row whatever the years; a beginner the under-a-year row. The
# recommendation is the midpoint rounded to SESSION_STEP. The strength
# budget is what is left: total - care - cardio (cardio_minutes, one rule).
DAY_MINUTES = {"lt1": (45, 60), "1to3": (60, 75), "3plus": (75, 90)}
DAY_MINUTES_BY_KIND = {"beginner": "lt1", "returner": "1to3"}
DAY_MINUTES_DEFAULT = "1to3"     # no history on record
SESSION_STEP = 5
SESSION_MIN, SESSION_MAX = 20, 180   # any answer in range is the user's own
STRENGTH_MIN = 15        # a day-total must leave this much strength time
CARDIO_CUT, CARDIO_OTHER = 20, 10    # phase cardio after the lifts


def _round_step(minutes, down=False):
    if down:
        return int(minutes // SESSION_STEP) * SESSION_STEP
    return int(minutes / float(SESSION_STEP) + 0.5) * SESSION_STEP


def training_history(cx):
    """(history kind, years band) as far as known before the experience
    stage: the state, else the kit config, else the goal handoff."""
    hist = cx.st.get("experience") or config_value(cx.db, EXP_KEY)
    hist = hist if hist in EXPERIENCE else None
    band = (cx.st.get("years_band") or config_value(cx.db, BAND_KEY)
            or handoff(cx).get("training_band"))
    band = band if band in YEARS_BANDS else IMPLIED_BAND.get(hist)
    return hist, band


def cardio_minutes(cx):
    """The phase cardio after the lifts: a cut 20 minutes, else 10. The ONE
    rule the dose, the reconcile and the cardio step read."""
    return CARDIO_CUT if cut_phase_metric(cx.db) else CARDIO_OTHER


def care_split():
    """(prep, cooldown) minutes, from the compose rules' budget."""
    import compose_rank
    b = compose_rank.load_rules()["budget"]
    return b["prep_minutes"], b["cooldown_minutes"]


def day_parts(cx, total):
    """{total, prep, cooldown, cardio, strength} of a day-total."""
    prep, cool = care_split()
    cardio = cardio_minutes(cx)
    return dict(total=total, prep=prep, cooldown=cool, cardio=cardio,
                strength=total - prep - cool - cardio)


def day_minutes_rec(cx):
    """{lo, hi, rec, why}: the history row of DAY_MINUTES and its rounded
    midpoint -- the ideal dose, before the user's real time is asked (the
    reconcile step checks it against the days)."""
    hist, band = training_history(cx)
    row = DAY_MINUTES_BY_KIND.get(hist) or band
    why = "band" if row in DAY_MINUTES else "default"
    lo, hi = DAY_MINUTES[row if why == "band" else DAY_MINUTES_DEFAULT]
    return dict(lo=lo, hi=hi, rec=_round_step((lo + hi) / 2.0), why=why)


def day_total(cx):
    """The dose the day is planned to: st["day_minutes"] (the history
    recommendation, or the day a reconcile pick settled), else the
    recommendation. The user's own minutes are a separate fact, a cap like a
    window (st["available_minutes"], owner 2026-10-04): the reconcile checks
    the dose against it."""
    return cx.st.get("day_minutes") or day_minutes_rec(cx)["rec"]


def planned_minutes(st):
    """The day as planned: the dose, never past the user's own minutes or a
    day's window, without the cardio a day moved off. Composed to the
    tightest day (a short window kept as it is): that day; else the full
    day the longest regular day holds (a shorter day is said apart). The
    cardio moved off every regular day leaves its minutes to strength."""
    avail = st.get("available_minutes")
    dose = st["day_minutes"]
    tp = st.get("time_plan") or {}
    off = set(tp.get("cardio_off") or ())
    wins = day_windows(st.get("daytime"), avail)
    if set(wins) <= off:
        # off every regular day: its minutes went to strength
        off = set()
    days = [min(dose - (tp.get("cardio") or 0 if d in off else 0),
                m if m is not None else dose) for d, m in wins.items()]
    if not days:
        return min(dose, avail) if avail else dose
    return min(days) if tp.get("pick") in ("short", "keep") else max(days)


def answer_minutes(cx, m):
    """The user's minutes a day (their limit) checked like a day-total: it
    must leave a strength part."""
    if m is not None and day_parts(cx, m)["strength"] < STRENGTH_MIN:
        parts = day_parts(cx, 0)
        raise Refused("E-FREQUENCY\tminutes\tthe whole day, at least %d "
                      "(prep, cardio and cooldown take %d)"
                      % (STRENGTH_MIN - parts["strength"],
                         -parts["strength"]))
    return m


def dose_lines(cx, total, why="band"):
    """The day-total line and its breakdown, said once."""
    parts = day_parts(cx, total)
    return T("dose_why_" + why, m=total) + " " + T("dose_parts", **parts)


def rec_label(title, n):
    """The recommended button: its title with the (추천) marker when the
    numbered row fits the bridge's button width -- the kit's rule (kit_life
    2.37.1 _rec_label: CJK counts 1.5, at most 31)."""
    marked = title + REC
    width = sum(1.5 if ord(ch) > 0x2E7F else 1
                for ch in "%d. %s" % (n, marked))
    return marked if width <= BUTTON_WIDTH_MAX else title


BUTTON_WIDTH_MAX = 31


def freq_choices(opts, rec):
