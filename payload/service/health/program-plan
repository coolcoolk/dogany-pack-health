            since = [d for d in (_date_ko(w.get("since") or "") for w in old)
                     if d and d <= cx.today]
            parts.append(T("done_calendar_replaced",
                           what=T("done_what_measure" if measure
                                  else "done_what"),
                           since=(T("measure_since", m=min(since).month)
                                  if since else ""),
                           titles="·".join(titles)))
        else:
            parts.append(T("done_calendar_measure" if measure
                           else "done_calendar"))
    first_line = "첫 세션은 %d월 %d일 %s" % (
        d.month, d.day, UL.WEEKDAY_FULL_KO[wd])
    if start:
        first_line += " %s, %s예요. 전날 밤 9시에 한 번 알려 드리고, " \
                      "당일 %s에 세션을 열어 드릴게요." % (
                          UL.clock_ko(start), first, UL.clock_ko(start))
    else:
        first_line += ", %s예요." % first
    parts.append(first_line)
    brief_say = (cx.st.get("brief_standard") or {}).get("say")
    if brief_say:
        parts.append(brief_say)
    card = program_card(cx)
    return move("done", "done", say="\n\n".join(parts),
                readback=[card], card=card,
                next_session={"date": d.isoformat(), "session": first,
                              "time": start},
                care=cx.st.get("care") or [],
                kit_errors=cx.st.get("kit_errors") or [])


# ---------------------------------------------------------------------------
# the state machine -- ONE journey, declared once
# ---------------------------------------------------------------------------
# The onboarding journey (owner-approved 2026-09-26 23:03; JOURNEY.md 1장 +
# AMENDMENTS A1-A8), in the order the user decides things. `next` walks this
# tuple and nothing else; an answer for a stage while an earlier one is still
# open is refused (E-STAGE); tests/test-journey-order.py reads the SAME
# tuple. The goal part (G1-G8) is the kit's move loop -- its own order is the
# kit's GOAL_JOURNEY, pinned by the same test.
#   goal        G1-G8, the kit's moves passed through; the wrap message ends
#               on the program's first question (A2)
#   safety      fallback only: the kit asks it inside the goal part (G4)
#   place       from records, stated on the card; asked when unknown/unnamed
#   frequency   the program's first question, the dose: the weekly count
#               (3 options) and ONE day-total recommended (owner 2026-10-02)
#   daytime     A4 open question naming the dose: base + extra days with
#               windows, one pass
#   reconcile   each day's window against the day-total: all fit -> one
#               line; a day short -> cardio to the supplementary day /
#               shorter strength / one more day (time_plan)
#   measure     after the schedule, on a training day: stated or one confirm
#   experience  read from the kit (G3); asked only without it
#   split       three structurally different options
#   focus       stated in a cut phase; a decision otherwise
#   emphasis    only when a focus area meets a safety site
#   compose     model lane, silent
#   field       a lift no dose rule covers
#   swaps       confirm safety changes, with optional individual review
#   cardio      the type, before preview so it appears in execution order;
#               the minutes are the reconcile's
#   sessions    all sessions, one confirm
#   done        write, archive the old plan, replace the calendar, close
JOURNEY = ("goal", "safety", "place", "frequency", "daytime", "reconcile",
           "measure",
           "experience",
           "split", "focus", "emphasis", "compose", "field", "swaps",
           "cardio", "sessions", "done")
# Stages that speak with no proposal in front of them (the only open value
# questions): the daytime (A4) and the gym's name. The kit's fact asks are
# the kit's _FACT_ASKS.
FACT_ASKS = ("daytime", "place:gym_name", "reconcile:day")
# A stage asked INSIDE an earlier one (the pack's safety / experience
# questions stand in for the kit's inside the goal part).
ASKED_INSIDE = {"safety": "goal", "experience": "goal"}
# A move that stands in for a journey stage (no lift fits the place: the
# compose step asks for the place again).
STAGE_ALIAS = {"blocked": "compose", "calendar_existing": "daytime"}


