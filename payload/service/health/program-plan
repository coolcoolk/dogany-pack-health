    got = cx.st.get("brief_defaults")
    if got:
        return {"morning": got["morning"], "retro": got["retro"],
                "weekly": tuple(got["weekly"])}
    morning = brief_morning_time(cx)
    retro, weekly = RETRO_FALLBACK, WEEKLY_FALLBACK
    path = brief_standard_path()
    if os.path.isfile(path):
        try:
            r = subprocess.run(["bash", path, "activate", "--morning",
                                morning or MORNING_FALLBACK, "--dry"],
                               capture_output=True, text=True, timeout=60)
            for ln in r.stdout.splitlines():
                f = ln.split("\t")
                if len(f) >= 4 and f[0] == "PLAN" and f[1] == "retro" \
                        and _hhmm(f[3]):
                    retro = _hhmm(f[3])
                if len(f) >= 4 and f[0] == "PLAN" and f[1] == "weekly":
                    dd, _sp, tt = f[3].partition(" ")
                    if dd[:3].upper() in DAY_EN and _hhmm(tt):
                        weekly = (dd[:3].upper(), _hhmm(tt))
        except (OSError, subprocess.SubprocessError):
            pass
    out = {"morning": morning, "retro": retro, "weekly": weekly}
    cx.st["brief_defaults"] = {"morning": morning, "retro": retro,
                               "weekly": list(weekly)}
    cx.save()
    return out


def slot_when(slot, value):
    """The spoken time of a slot value (weekly: (DAY, HH:MM))."""
    if slot == "weekly":
        return "%s %s" % (UL.weekday_full(value[0]), spoken_clock(value[1]))
    return spoken_clock(value)


def slot_open(cx, slot):
    return slot not in (cx.st.get("brief_slots") or {})


def slot_move(cx, slot):
    d = brief_defaults(cx)
    st = cx.st
    other = "slot_c_other_weekly" if slot == "weekly" else "slot_c_other"
    asked_other = (st.get("brief_other") == slot)
    if slot == "brief":
        value = d["morning"]
        head = T("brief_head")
        if value:
            line = T("brief_line_lead", clock=spoken_clock(value),
                     lead=BRIEF_LEAD_MIN)
        else:
            value = MORNING_FALLBACK
            line = T("brief_line_plain", clock=spoken_clock(value))
        ask = T("brief_ask")
    elif slot == "retro":
        value = d["retro"]
        head, line, ask = (T("retro_head"),
                           T("slot_line", when=spoken_clock(value)),
                           T("retro_ask"))
    else:
        value = d["weekly"]
        head, line, ask = (T("weekly_head"),
                           T("slot_line", when=slot_when("weekly", value)),
                           T("weekly_ask"))
    payload = {"pick": "keep | other | off",
               "time": "on other: HH:MM"}
    if slot == "weekly":
        payload["day"] = "on other: MON..SUN"
    if asked_other:
        # "다른 시간" without the time: the same step, the question alone
        return move("ask", slot, say=ask, answer={"stage": slot,
                                                  "payload": payload})
    return move("ask", slot, say="\n".join([head, line, ask]),
                choices=[tail_choice("keep", slot_when(slot, value)
                                     if slot != "brief" else
                                     spoken_clock(value), True),
                         tail_choice("other", T(other)),
                         tail_choice("off", T("slot_c_off"))],
                answer={"stage": slot, "payload": payload})


def record_slot_answer(cx, slot, payload):
    st = cx.st
    pick = _pick(payload, ("keep", "other", "off"))
    d = brief_defaults(cx)
    if pick == "off":
        value = None
    elif pick == "keep":
        value = {"brief": d["morning"] or MORNING_FALLBACK,
                 "retro": d["retro"], "weekly": d["weekly"]}[slot]
    else:
        t = _hhmm(payload.get("time"))
        day = str(payload.get("day") or "").strip().upper()[:3]
        if slot == "weekly":
            day = day if day in DAY_EN else (d["weekly"][0] if t else "")
            value = (day, t) if t else None
        else:
            value = t
        if value is None:
            st["brief_other"] = slot       # the same step asks the time
            return
    st.pop("brief_other", None)
    st.setdefault("brief_slots", {})[slot] = (
        {"off": True} if value is None else
        {"day": value[0], "time": value[1]} if slot == "weekly"
        else {"time": value})
    when = slot_when(slot, value) if value is not None else ""
    st["tail_lead"] = (T("lead_off_" + slot) if value is None else
                       T("lead_" + slot, when=when, ieyo=ieyo(when)))
    if slot == "weekly":
        st["brief_standard"] = apply_brief(cx)


def bundle_ctl_path():
    return (os.environ.get("BUNDLE_ROUTINE_CTL_SH")
            or os.path.join(PROJECT_ROOT, "routines", "lib",
                            "bundle-routine-ctl.sh"))


def kit_conf_set(key, value):
    """Upsert KEY=value in the kit's config/kit_life.conf -- the record the
    framework's per-item off procedure keeps (dogany-lifekit-setup "record
    in kit conf"); brief-standard.sh has no per-slot off."""
    path = (os.environ.get("KIT_LIFE_CONF")
            or os.path.join(PROJECT_ROOT, "config", "kit_life.conf"))
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError:
        lines = []
    out, done = [], False
    for ln in lines:
        if ln.split("=", 1)[0] == key and not done:
            out.append("%s=%s" % (key, value))
            done = True
        else:
            out.append(ln)
    if not done:
        out.append("%s=%s" % (key, value))
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write("\n".join(out) + "\n")


def apply_brief(cx):
    """The three answers, switched through the kit: every slot off ->
    `brief-standard.sh deactivate`; else `activate` with the agreed times
    (an off slot's default only fills the verb's required argument), then
    each off slot `bundle-routine-ctl.sh off <id>` + BUNDLE_<ID>=off. Exit 3
    is the kit refusing (framework too old): its SAY line is said in the
    wrap. Any other failure is recorded and named in the wrap."""
    slots = cx.st.get("brief_slots") or {}
    d = brief_defaults(cx)
    off = [s for s, _k, _i in BRIEF_SLOTS if (slots.get(s) or {}).get("off")]
    if not cx.side_effects:
        return {"status": "skipped"}
    path = brief_standard_path()
    if not os.path.isfile(path):
        return {"status": "absent"}

    def run(args):
        try:
            r = subprocess.run(["bash", path] + args, capture_output=True,
                               text=True, timeout=120)
        except (OSError, subprocess.SubprocessError) as e:
            return None, str(e)
        return r, ""

    if len(off) == len(BRIEF_SLOTS):
        r, err = run(["deactivate"])
        if r is None or r.returncode != 0:
            cx.st.setdefault("kit_errors", []).append(
                "brief-standard deactivate: %s" % (err or (r.stdout + r.stderr)
                                                    .strip()[-200:]))
            return {"status": "error"}
        return {"status": "off"}
    morning = (slots.get("brief") or {}).get("time") or d["morning"] \
        or MORNING_FALLBACK
    retro = (slots.get("retro") or {}).get("time") or d["retro"]
    w = slots.get("weekly") or {}
    weekly = "%s %s" % (DAY_EN[w.get("day") or d["weekly"][0]],
                        w.get("time") or d["weekly"][1])
    r, err = run(["activate", "--morning", morning, "--retro", retro,
                  "--weekly", weekly])
    if r is None:
        cx.st.setdefault("kit_errors", []).append("brief-standard: %s" % err)
        return {"status": "error"}
    say = next((ln.split("\t", 1)[1].strip() for ln in r.stdout.splitlines()
                if ln.startswith("SAY\t")), "")
    status = {0: "on", 3: "refused"}.get(r.returncode, "error")
    if status == "error":
        cx.st.setdefault("kit_errors", []).append(
            "brief-standard rc=%s: %s" % (r.returncode,
                                          (r.stdout + r.stderr).strip()[-200:]))
        return {"status": status, "rc": r.returncode}
    if status == "refused":
        return {"status": status, "rc": 3, "say": say}
    for slot, _k, rid in BRIEF_SLOTS:
        if slot not in off:
            continue
        try:
            rr = subprocess.run(["bash", bundle_ctl_path(), "off", rid],
                                capture_output=True, text=True, timeout=60)
            ok = rr.returncode == 0
            why = (rr.stdout + rr.stderr).strip()[-200:]
        except (OSError, subprocess.SubprocessError) as e:
            ok, why = False, str(e)
        if not ok:
            cx.st.setdefault("kit_errors", []).append(
                "bundle-routine-ctl off %s: %s" % (rid, why))
            status = "error"
            continue
        kit_conf_set("BUNDLE_" + rid.replace("-", "_").upper(), "off")
    return {"status": status, "rc": r.returncode, "off": off}


# -- the order, the wrap -------------------------------------------------------
def tail_step(cx):
    """The first open tail step, or None when every one is answered."""
    if diet_open(cx):
        return "diet"
    if first_open(cx):
        return "first"
    if cx.st.get("tail_brief"):
        for slot, _k, _i in BRIEF_SLOTS:
            if slot_open(cx, slot):
                return slot
    if records_open(cx):
        return "records"
    return None


def tail_ask(cx, step):
    if step == "diet":
        return diet_ask_move(cx)
    if step == "first":
        return first_move(cx)
    if step == "records":
        return records_move(cx)
    return slot_move(cx, step)


