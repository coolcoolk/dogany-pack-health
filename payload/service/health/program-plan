def kit_path():
    return (os.environ.get("KIT_LIFE_SH")
            or os.path.join(PROJECT_ROOT, "database", "kit_life.sh"))


def kit(args):
    """(rc, stdout, stderr); rc None when the kit is not installed."""
    p = kit_path()
    if not os.path.exists(p):
        return None, "", "kit_life.sh not found at %s" % p
    try:
        r = subprocess.run([p] + list(args), capture_output=True, text=True,
                           timeout=120)
    except (OSError, subprocess.SubprocessError) as e:
        return None, "", str(e)
    finally:
        # A kit verb may have written; the DB stamp can miss it (another
        # connection holds the WAL open, the writer rewinds it in place:
        # same size, main file untouched). The 2026-10-07 consult re-run
        # read its just-retired 헬스 routines back as active and added none.
        _READS.clear()
    return r.returncode, r.stdout, r.stderr


# How a kit WITHOUT the move loop answers `goal-interview --next`: no such
# verb (the kit's own "unknown command" line, or argparse's), or a
# goal-interview whose usage line has no --next. Only these, and a kit that
# is not installed, mean "no move loop". Anything else -- a SyntaxError
# while an install overwrites kit_life.py (measured 2026-10-04 07:51), a
# timeout, a traceback -- is a transient failure, never a skip.
KIT_NO_LOOP_SIGNS = ("\uc54c \uc218 \uc5c6\ub294 \uba85\ub839",
                     "invalid choice", "unrecognized arguments",
                     "unknown command")


def kit_goal_move():
    """(move, err, absent). absent=True only when the kit genuinely has no
    move loop (not installed, or older than `goal-interview --next`)."""
    rc, out, err = kit(["goal-interview", "--next", "--domain", "health",
                        "--json"])
    tail = (err or out or "rc=%s" % rc).strip()[-300:]
    if rc is None:
        return None, tail, not os.path.exists(kit_path())
    if rc != 0:
        text = "%s\n%s" % (out or "", err or "")
        if "Traceback" in text or "Error:" in text:
            return None, tail, False
        usage = [ln for ln in text.splitlines()
                 if "goal-interview" in ln and ln.strip()]
        old = (any(sign in text for sign in KIT_NO_LOOP_SIGNS)
               or (usage and not any("--next" in ln for ln in usage)))
        return None, tail, bool(old)
    if not (out or "").strip():
        # an older kit that ignores the flags and prints nothing
        return None, "goal-interview --next printed nothing", True
    try:
        mv = json.loads(out)
    except ValueError:
        return None, "goal-interview --next did not return JSON: %s" % tail, \
            False
    if isinstance(mv, dict) and mv.get("kind"):
        return mv, None, False
    return None, "goal-interview --next returned no move", True


# Kit moves that put a NUMBER in front of the user. The safety check runs
# before the first of them (G6-a: "숫자 확정 전에 안전 체크").
KIT_NUMBER_MOVES = ("propose", "ask_target")


def merge_modules(current, today):
    """consult_modules merge-update: workout -> done@today, others kept."""
    parts = [p for p in (current or "").split(",") if p.strip()]
    kept = [p for p in parts if not p.startswith("workout:")]
    return ",".join(["workout:done@%s" % today] + kept)


