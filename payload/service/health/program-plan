    shutil.copy2(cx.program, dest)
    return dest


def _same_path(a, b):
    return os.path.realpath(a) == os.path.realpath(b)


def workbench_target(cx):
    """None when the workbench pin may be refreshed, else why not.

    The pin is the INSTANCE's chat surface (.telegram_bot/dashboard*), not a
    file beside --db/--state. A run pointed at other data -- a scratch replay
    with a DB copy -- used to pin that scratch program into the owner's chat
    (overnight follow-ups 2026-09-27 item 1). So a refresh needs either this
    instance's own db+state, or an explicit WARG_DASHBOARD_FILE that says
    where the pin of the overridden data should go (workbench.py honours it).
    --no-side-effects skips it outright."""
    if not cx.side_effects:
        return "no-side-effects"
    if os.environ.get("WARG_DASHBOARD_FILE"):
        return None
    if not (_same_path(cx.db, DEFAULT_DB) and
            _same_path(cx.state_path, DEFAULT_STATE)):
        return "overridden-paths"
    return None


def refresh_workbench(cx):
    """Best-effort projection after a goal or program state change."""
    why = workbench_target(cx)
    if why:
        sys.stderr.write("program-plan: workbench refresh skipped (%s)\n"
                         % why)
        return
    try:
        subprocess.run([sys.executable, os.path.join(HERE, "workbench.py"),
                        "--db", cx.db, "--state", cx.state_path],
                       capture_output=True, timeout=20, check=False)
    except (OSError, subprocess.TimeoutExpired):
        pass


