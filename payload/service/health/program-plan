def card_sites_text(st, items):
    """The sites as the user's card names them (the kit's safety card phrase,
    P2: '우측 무릎'), else the display layer's names."""
    parts = [p.strip() for p in str(st.get("safety_card") or "").split(
        T("card_sep").strip()) if p.strip()]
    names = []
    for it in items:
        base = UL.site_ko(it.get("site"), None)
        hit = [p for p in parts if base in p]
        n = hit[0] if hit else UL.site_ko(it.get("site"), it.get("side"))
        if n not in names:
            names.append(n)
    return "·".join(names)


def _hangul(word):
    return bool(word) and all("\uac00" <= ch <= "\ud7a3" for ch in word)


def safety_site_name(key, value):
    """A safety row's site as the user wrote it ('right knee' from
    (e.g. injury_<site>_r, 'right knee is sore')), else the key's site. The kit's
    own naming (lifekit 1bc5756): when ONE sentence names two sites stored
    on two rows, its first words name the FIRST row's site only -- a row
    whose key site the sentence names later is that key site, no side."""
    words = str(value or "").split()
    sides = {w: side for side in ("r", "l", "both")
             for w in T("side_words_" + side).split()}
    side, i = None, 0
    if words and words[0] in sides:
        side, i = sides[words[0]], 1
    site = None
    if len(words) > i:
        w = words[i]
        if len(w) > 1 and w[-1] in T("site_particles"):
            w = w[:-1]
        if len(w) <= 6 and _hangul(w):
            site = w
    key_site, key_side = UL.parse_site_key(key)
    key_name = UL.SITE_KO.get(key_site)
    if site is not None and key_name and site != key_name \
            and key_name in " ".join(words[i + 1:]):
        site, side = None, None
    if site is None:
        site = key_name or str(key_site or "").replace("_", " ") or None
    if side is None and key_side:
        side = key_side
    if not site:
        return None
    return T("card_site_side", side=T("side_" + side), site=site) if side \
        else site


def safety_card_phrase(cx):
    """The kit's safety card phrase (P2, one wording on both cards). A
    phrase that repeats a site was written by the old two-sites-one-sentence
    misread ('right knee . right knee' for knee + shoulder): its sites are
    re-read from the safety records, so no site is hidden."""
    phrase = cx.st.get("safety_card")
    if not phrase:
        return phrase
    sep = T("card_sep")
    parts = [p.strip() for p in str(phrase).split(sep.strip()) if p.strip()]
    if len(set(parts)) == len(parts):
        return phrase
    names = [safety_site_name(k, v) for k, v in _q(
        cx.db, "SELECT key, value FROM ledger_constraint WHERE "
               "class='safety' AND status='active' AND key LIKE 'injury_%' "
               "ORDER BY id")]
    names = [n for n in names if n] or parts
    return sep.join(dict.fromkeys(names))


def card_safety(st, phrase=None):
    items = st.get("safety_items") or []
    if not items:
        return None
    parts = []
    phrase = phrase or st.get("safety_card")
    if phrase:
        # P2: the kit's safety card phrase, word for word (one wording on
        # both cards), never the raw record sentences
        parts.append(phrase)
        items = ()
    for it in items:
        site = UL.site_ko(it.get("site"), it.get("side"))
        words = " ".join(str(it.get("words") or "").split())
        if not words or site in words:
            part = words or site
        else:
            part = T("card_site_words", site=site, words=words)
        if part not in parts:
            parts.append(part)
    return T("card_sep").join(parts)


def program_card(cx, now=None):
    """The program card: the title line, then one line per slot, filled from
    the plan state, the slot asked now in bold. One renderer for every
    program message and the closing one."""
    st = cx.st
    val = {"goal": handoff_goal_line(cx),
           "place": card_place(st.get("place")),
           "frequency": card_frequency(st),
           "daytime": card_daytime(st.get("daytime")),
           "measure": card_measure(st),
           "split": card_split(st),
           "focus": card_focus(cx),
           "safety": card_safety(st, safety_card_phrase(cx)),
           "sessions": (T("card_sessions_done",
                          n=len(st["structure"]["rotation"]))
                        if st.get("sessions") == "ok" else None),
           "extra": card_extra(st.get("daytime")),
           "cardio": ("%s %d분" % (st["cardio"]["display"],
                                      st["cardio"]["minutes"])
                      if st.get("cardio") else None)}
    lines = [T("card_title")]
    for slot in CARD_SLOTS:
        if slot in ("safety", "goal") and not val[slot]:
            continue
        if val[slot]:
            key = "card_line_now" if slot == now else "card_line"
        else:
            key = "card_line_now_empty" if slot == now else "card_line_empty"
        lines.append(T(key, name=T("card." + slot), value=val[slot]))
    return "\n".join(lines)


# Side questions inside a step (a lift's starting amount, protecting a sore
# area) do not carry the statements queued for the next decision message.
NOTE_SKIP = ("field", "emphasis", "cardio", "swaps")


def pmove(cx, kind, stage, **kw):
    """A program move: the card opens it (last readback line), then the
    one-time notes queued for the first program message after a decision
    (the measure day, the queue explanation, the focus statement).

    The FIRST program question rides the goal wrap instead (A2): ONE message
    = the goal card, the wrap line + transition line, a blank line, the
    question -- no program card; the card opens from the next message. The
    fold stays until that question is answered, so a repeated `next`
    renders the same message."""
    base = stage.split(":")[0]
    notes = []
    for n in cx.st.get("notes") or []:
        if n.get("at") is None and base not in NOTE_SKIP:
            n["at"] = base
            cx.save()
        if n["at"] == base:
            notes.append(n["text"])
    rb = list(kw.pop("readback", None) or [])
    say = kw.pop("say", None)
    fold_card = kw.pop("fold_card", False)
    if notes and say:
        say = "\n\n".join(notes + [say])
    fold = cx.st.get("wrap_fold")
    if fold and say:
        if fold_card:
            # a slot filled from the goal part is stated on the card, so the
            # card opens on this first question (owner rehearsal 2026-10-01)
            say = program_card(cx, STAGE_SLOT.get(base)) + "\n\n" + say
        return move(kind, stage, say=fold["say"] + "\n\n" + say, card=None,
                    readback=list(fold.get("readback") or []) + rb, **kw)
    lead = cx.st.get("lead")
    if lead and say:
        # restart --from program: the one restart line, then the question
        # (no card either: it opens from the next message, as after a wrap)
        return move(kind, stage, say=lead + "\n" + say, card=None,
                    readback=rb, **kw)
    card = program_card(cx, STAGE_SLOT.get(base))
    return move(kind, stage, say=say, card=card, readback=rb + [card], **kw)


def drop_notes(cx, stage):
    base = stage.split(":")[0]
    cx.st["notes"] = [n for n in cx.st.get("notes") or []
