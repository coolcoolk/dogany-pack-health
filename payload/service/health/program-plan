# -- goal part ---------------------------------------------------------------
# THE KIT CONTRACT (journey, kit dsp/journey-kit). Every field this pack reads
# off a kit move is read HERE and in handoff_*() below, so the reconcile with
# the kit is one place:
#   * `goal-interview --next --domain health --json` -> a move {kind, say,
#     readback[], card, choices[{pick, label, cmd}], on_answer, ...}.
#   * `ask_safety` with `choices[].cmd` = the kit asks the one safety check
#     itself (records re-check, narrowed); an older kit's `ask_safety` (no
#     cmd) is answered by the pack's own question, as before.
#   * `wrap` -> `say` already holds the wrap line and the A3 transition line;
#     `handoff` = {append, calendar_line, calendar[{id, title, weekdays 0-6,
#     start, end, since, owning_agent}], order_line, first_axis, horizon,
#     safety_card, practice, activity, training_band, measure[]}.
#   * `goal-interview --restart --domain health [--from goal|program] --json`
#     -> {say, archived, kept_goal_ids, next}.
def kit_move_has_cmds(mv):
    return any(isinstance(c, dict) and c.get("cmd")
               for c in mv.get("choices") or ())


def goal_skip_stuck(g):
    """A goal part marked skipped while it was LIVE (a restart, or a kit
    move already spoken) by a transient kit error, before that was refused
    (live state 2026-10-04: strands 2-3, deadline and measure were skipped).
    Not done: the next `next` asks the kit again."""
    return bool(g.get("skipped")
                and (g.get("live") or g.get("restart") == "goal"))


def stage_goal(cx):
    g = cx.st.setdefault("goal", {})
    if goal_skip_stuck(g):
        for k in ("done", "skipped"):
            g.pop(k, None)
        cx.save()
    if g.get("done"):
        return None
    mv, err, absent = kit_goal_move()
    if mv is None and (not absent or g.get("live")
                       or g.get("restart") == "goal"):
        # A kit that HAS the move loop failed this once (an install
        # mid-write, a timeout) -- and a live interview had one a moment
        # ago, whatever this call saw: nothing is marked, the model reports
        # the error, the next `next` asks again.
        return move("error", "goal", say=None, stderr=err)
    if mv is None:
        # No kit move loop (kit absent or older than the move loop): the goal
        # part is not this tool's to run. Record why, never pretend.
        g.update({"done": True, "skipped": err or "no move"})
        cx.save()
        return None
    if mv["kind"] == "ask_safety" and not kit_move_has_cmds(mv):
        # An older kit's safety move (no commands): the kit's move and the
        # pack's are ONE question. The pack asks it (same sentence), and its
        # answer is written back through the kit's own verbs
        # (goal-move-note --safety, constraint-add per site).
        g["safety_why"] = mv.get("why_id")
        cx.save()
        if not cx.st.get("safety"):
            return stage_safety(cx, before="goal",
                                readback=mv.get("readback"))
        if kit_note_safety(cx) and not g.get("safety_requeried"):
            g["safety_requeried"] = True
            cx.save()
            return stage_goal(cx)
    if mv["kind"] in KIT_NUMBER_MOVES and not cx.st.get("safety"):
        return stage_safety(cx, before="goal", readback=mv.get("readback"))
    if mv["kind"] == "ask_experience" and not g.get("exp_requeried"):
        # The training-experience question is the pack's, ONE question for
        # both answers (K9). Ask it here; once both are recorded the kit's
        # rate model reads them and never asks its own. The kit's readback
        # rides the pack's question.
        own = stage_experience(cx, before="goal")
        if own is not None:
            own["readback"] = list(mv.get("readback") or []) + \
                list(own.get("readback") or [])
            return own
        g["exp_requeried"] = True
        cx.save()
        return stage_goal(cx)
    if mv["kind"] != "wrap":
        g["live"] = True
        cx.save()
        mv = dict(mv)
        mv["stage"] = "goal"
        mv["source"] = "kit"
        return mv
    # wrap. Goals are already written and active by the kit's own verbs; the
    # pack finishes its bookkeeping and does NOT summarise or re-confirm.
    g["done"] = True
    book = []
    if not config_value(cx.db, "consult_state") == "done":
        book.append(["config-set", "consult_state=done"])
    if not config_value(cx.db, "consult_modules"):
        book.append(["config-set", "consult_modules=workout:pending,"
                     "diet:pending,supp:pending"])
    errs = []
    for b in book:
        rc, _o, e = kit(b)
        if rc != 0:
            errs.append("%s: %s" % (" ".join(b), (e or "").strip()[-200:]))
    if errs:
        cx.st.setdefault("kit_errors", []).extend(errs)
    if isinstance(mv.get("handoff"), dict):
        cx.st["handoff"] = mv["handoff"]
    adopt_kit_safety(cx)
    care = care_plan(cx)
    if care:
        cx.st["care"] = care
    cx.save()
    refresh_workbench(cx)
    if not g.get("live"):
        # the interview finished in an earlier conversation: nothing to wrap
        return None
    # A2: ONE message. The kit's readback (the filled goal card), its wrap
    # line and the A3 transition line, then -- after a blank line -- the
    # program's FIRST question (the pack's, appended by pmove). The program
    # card opens from the NEXT message. An older kit's wrap (no `handoff`)
    # speaks a summary the goal card already is: the pack's own two lines
    # stand in for it.
    if isinstance(mv.get("handoff"), dict) and mv.get("say"):
        say = str(mv["say"]).strip()
    else:
        say = T("wrap_done") + "\n\n" + T("wrap_transition")
    cx.st["wrap_fold"] = {"readback": list(mv.get("readback") or []),
                          "say": say}
    g["folded"] = True
    cx.save()
    return None


def adopt_kit_safety(cx):
    """The kit asked the one safety check inside the goal part (G4): its
    answer is on record (ledger_constraint), so the program part READS it --
    never a second question. The card phrase is the kit's (P2)."""
    h = cx.st.get("handoff") or {}
    if h.get("safety_card"):
        cx.st["safety_card"] = h["safety_card"]
        # a phrase repeating a site is re-read from the records (P2 fix)
        cx.st["safety_card"] = safety_card_phrase(cx)
    if (cx.st.get("safety") and not safety_stale(cx)) or not h:
        return
    items = []
    for key, value in _q(cx.db, "SELECT key, value FROM ledger_constraint "
                                "WHERE class='safety' AND status='active' "
                                "ORDER BY id"):
        site, side = UL.parse_site_key(key)
        if site:
            items.append({"site": site, "side": side,
                          "words": str(value or "")})
    cx.st["safety"] = cx.today.isoformat()
    cx.st["safety_items"] = items
    cx.st["safety_keys"] = _safety_keys(cx.db)
    cx.st["safety_source"] = "kit"
    cx.st["safety_noted"] = cx.st["safety"]


