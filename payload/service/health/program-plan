def functional_direction(db):
    """True when one of the user's strands is linked to a measure this pack
    computes from the program (the coordination measures, source
    'program') -- the functional direction."""
    return bool(_q(db, "SELECT 1 FROM metric_axis a JOIN goal_metric_source s "
                       "ON s.axis_key = a.axis_key WHERE a.origin='user' "
                       "AND s.source_table='program' LIMIT 1"))


