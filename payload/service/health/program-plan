def restart(cx, from_="goal"):
    """Archive the plan state to files/_archive/restart-<ts>/ (never
    deleted), then either restart the goal consult through the kit (its
    `--restart`: unfinished interview archived, finished goals kept active
    until the new wrap) or, --from program, keep the goal and open the
    program part again. Returns the first move of the new run."""
    root = os.path.dirname(os.path.dirname(os.path.abspath(cx.state_path)))
    if os.path.exists(cx.state_path):
        dest = os.path.join(root, "_archive", "restart-%s" % datetime
                            .datetime.now().strftime("%Y%m%d-%H%M%S"))
        os.makedirs(dest, exist_ok=True)
        shutil.copy2(cx.state_path, dest)
    old = cx.st
    if from_ == "program":
        rc, out, _e = kit(["goal-interview", "--restart", "--domain",
                           "health", "--from", "program", "--json"])
        line = T("restart_program")
        try:
            line = json.loads(out).get("say") or line if rc == 0 else line
        except (ValueError, AttributeError):
            pass
        keep = {k: old[k] for k in ("handoff", "safety", "safety_items",
                                    "safety_card", "safety_source",
                                    "safety_noted", "care", "experience",
                                    "years_band", "frequency",
                                    "day_minutes", "daytime", "time_plan",
                                    "days",
                                    "place", "cardio_preference") if k in old}
        cx.st = dict(keep, goal={"done": True, "restart": "program"},
                     lead=line,
                     restart_facts_pending=bool(keep.get("daytime") and
                                                keep.get("place")))
        cx.save()
        refresh_workbench(cx)
        return next_move(cx)
    rc, out, err = kit(["goal-interview", "--restart", "--domain", "health",
                        "--json"])
    try:
        res = json.loads(out) if rc == 0 else None
    except ValueError:
        res = None
    if not isinstance(res, dict):
        return move("error", "restart", say=None,
                    stderr=(err or out or "rc=%s" % rc).strip()[-500:])
    cx.st = {"goal": {"live": True, "restart": "goal"}}
    cx.save()
    refresh_workbench(cx)
    nxt = res.get("next")
    if isinstance(nxt, dict) and nxt.get("kind"):
        nxt = dict(nxt, stage="goal", source="kit")
        return nxt
    return next_move(cx)


def _with_readback(cx, mv):
    rb = cx.st.pop("readback", None)
    if rb and mv.get("say"):
        mv["readback"] = rb + list(mv.get("readback") or [])
        cx.save()
    elif rb:
        cx.st["readback"] = rb
    return mv


