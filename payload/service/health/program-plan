    where the pin of the overridden data should go (workbench.py honours it).
    --no-side-effects skips it outright."""
    if not cx.side_effects:
        return "no-side-effects"
    if os.environ.get("WARG_DASHBOARD_FILE"):
        return None
    if not (_same_path(cx.db, DEFAULT_DB) and
            _same_path(cx.state_path, DEFAULT_STATE)):
        return "overridden-paths"
    return None


def refresh_workbench(cx):
    """Best-effort projection after a goal or program state change."""
    why = workbench_target(cx)
    if why:
        sys.stderr.write("program-plan: workbench refresh skipped (%s)\n"
                         % why)
        return
    try:
