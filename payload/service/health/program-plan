def kit_care_keys(db):
    """The care items the user accepted in the kit's goal interview (its
    care step fills the health strand, owner 2026-09-26 17:18), or None."""
    raw = config_value(db, KIT_CARE_KEY)
    if not raw:
        return None
    known = [c["key"] for c in CARE_ITEMS]
    keys = [k.strip() for k in str(raw).split(",") if k.strip() in known]
    return keys or None


def care_plan(cx):
    """The CARE_ITEMS as data (joint prep carries the safety sites): the
    items the user accepted in the kit's care step, else all of them on a
    functional direction, else []."""
    keys = kit_care_keys(cx.db)
    if keys is None and not functional_direction(cx.db):
        return []
    sites = [{"site": it.get("site"), "side": it.get("side")}
             for it in cx.st.get("safety_items") or []]
    out = []
    for item in CARE_ITEMS:
        if keys is not None and item["key"] not in keys:
            continue
        it = dict(item)
        if it["key"] == "joint_prep" and sites:
            it["sites"] = sites
        out.append(it)
    return out


def care_lines(care, head="care_head"):
    """The user lines for a care list -- the summary (plan state: sites as
    {site, side}) and session start (the card: sites as injury_<site>[_l|_r]
    keys) both render through here."""
    lines = [T(head)]
    for it in care or ():
        if it.get("key") not in [c["key"] for c in CARE_ITEMS]:
            continue
        key = "care_" + it["key"]
        sites = []
        for x in it.get("sites") or ():
            if isinstance(x, dict):
                sites.append(x)
            else:
                site, side = UL.parse_site_key(x)
                if site:
                    sites.append({"site": site, "side": side})
        if sites:
            key += "_sites"
        lines.append(T(key, minutes=it.get("minutes"),
                       sites=_sites_text(sites)))
    return lines if len(lines) > 1 else []


def care_for_card(care):
    """Plan-state care -> the card's `care:` list (sites as the safety
    ledger's keys)."""
    out = []
    for it in care or ():
        d = {k: it[k] for k in ("key", "when", "minutes") if k in it}
        sites = ["injury_%s%s" % (x["site"], "_" + x["side"]
                                  if x.get("side") else "")
                 for x in it.get("sites") or ()
                 if x.get("site") in UL.SITE_KO
                 and x.get("side") in (None, "", "l", "r")]
        if sites:
            d["sites"] = sites
        out.append(d)
    return out


