def first_calendar(cx, day, start):
    """A first session off the regular days goes on the calendar once
    (appt-add); a regular day is already a routine. No time -> nothing
    added (a time is never picked for the user)."""
    if not cx.side_effects or not start:
        return False
    wd = UL.WEEKDAY_ORDER[day.weekday()]
    if wd in (cx.st.get("days") or {}).get("weekdays", ()):
        return False
    end = None
    for w in ((cx.st.get("daytime") or {}).get("extra_windows") or ()):
        if wd in (w.get("weekdays") or ()) and w.get("start") == start:
            end = w.get("end")
    args = ["appt-add", T("cal_training_title"),
            "%s %s" % (day.isoformat(), start)]
    if end:
        args.append("%s %s" % (day.isoformat(), end))
    rc, _o, e = kit(args + ["--new"])
    if rc != 0:
        cx.st.setdefault("kit_errors", []).append(
            "appt-add (first session): %s" % (e or "").strip()[-200:])
    return rc == 0


