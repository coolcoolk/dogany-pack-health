def kit_note_safety(cx):
    """Write the pack's safety answer back through the kit (goal-move-note
    --safety for the kit's move state, constraint-add per named site).
    Once per answer. True when the kit was told."""
    g = cx.st.get("goal") or {}
    wid = g.get("safety_why")
    if wid is None or cx.st.get("safety_noted") == cx.st.get("safety"):
        return False
    items = cx.st.get("safety_items") or []
    words = "; ".join(it.get("words") or UL.site_ko(it.get("site"),
                                                     it.get("side"))
                      for it in items) or "none"
    calls = [["goal-move-note", "--why-id", str(wid), "--safety", words]]
    known = {k for _s, _d, k in safety_rows(cx.db)}
    for it in items:
        key = "injury_%s%s" % (it["site"], "_" + it["side"]
                               if it.get("side") else "")
        if key in known:
            continue
        calls.append(["constraint-add", "--class", "safety", "--key", key,
                      "--value", it.get("words") or UL.site_ko(
                          it["site"], it.get("side")),
                      "--source", "interview"])
    for c in calls:
        rc, _o, e = kit(c)
        if rc != 0:
            cx.st.setdefault("kit_errors", []).append(
                "%s: %s" % (c[0], (e or "").strip()[-200:]))
    cx.st["safety_noted"] = cx.st.get("safety")
    cx.save()
    return True


def stage_safety(cx, before="program", readback=None):
