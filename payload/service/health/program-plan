def lift_kinds(cx, items):
    """Kind key per lift, in order: a core pattern is core, isolation is
    small-muscle work, the first compound of a region in the session is its
    main lift and later compounds of that region assist."""
    out, mains = [], set()
    for ex in items:
        f = cx.facts().get(ex["name"]) or {}
        pattern, movement = f.get("pattern"), f.get("movement")
        if pattern == "core":
            out.append(KIND_CORE)
            continue
        if movement == "isolation" or (movement is None
                                       and pattern == "isolation"):
            out.append(KIND_SMALL)
            continue
        region = lift_region(cx, ex["name"])
        if region in mains:
            out.append(KIND_ASSIST)
        else:
            mains.add(region)
            out.append(KIND_MAIN)
    return out


# Coarse muscles whose subregions are named muscles on a card: 등 is three
# (광배근 / 승모근 / 척추기립근), and a row reading 「(등)」 says nothing about
# which. The primary map (exercise_muscle) holds only the coarse node for most
# pulls, so the card reads the lift's dominant subregion from
# exercise_subregion instead (overnight follow-ups 2026-09-27 item 3).
CARD_SUBREGION_MUSCLES = ("back",)


def dominant_subregions(cx, name, muscle):
    """[subregion, ...] that drive `name` within coarse `muscle`: the highest
    exercise_subregion weight (grade='group' breaks a tie), every tied one in
    muscle_node sort order (seated cable row: 광배근·승모근 at 0.5/0.5 --
    the data says both). No subregion row -> [muscle] (JIT lifts)."""
    if not hasattr(cx, "_card_subw"):
        cx._card_subw = {}
        for ex, sr, w, g in _q(cx.db, "SELECT exercise_name, subregion, "
                                      "weight, grade FROM exercise_subregion"):
            try:
                w = float(w or 0)
            except (TypeError, ValueError):
                w = 0.0
            cx._card_subw.setdefault(ex, []).append((sr, (w, g == "group")))
        cx._card_sort = {n: s for n, s in _q(
            cx.db, "SELECT node, sort FROM muscle_node")}
    kids = [(sr, k) for sr, k in cx._card_subw.get(name, ())
            if cx._card_nodes.get(sr, (None, None))[0] == muscle]
    if not kids:
        return [muscle]
    top = max(k for _sr, k in kids)
    return sorted((sr for sr, k in kids if k == top),
                  key=lambda sr: (cx._card_sort.get(sr, 0), sr))


def primary_muscles(cx, name):
    """Roll detail nodes up to their muscle parent, never to a body group.

    The back taxonomy labels the whole back as a muscle: preserve its direct
    children (lats, erectors, upper back) as named muscles, and when the map
    names only the coarse back, read the dominant child
    (dominant_subregions). Deduplicate after collapsing, so several heads of
    one muscle earn a set only once.
    """
    if not hasattr(cx, "_card_nodes"):
        cx._card_nodes = {n: (p, k) for n, p, k in _q(
            cx.db, "SELECT node, parent, kind FROM muscle_node")}
    nodes = cx._card_nodes
    result = []
    for node, role in cx.muscle_map().get(name, []):
        if role != "primary":
            continue
        seen = set()
        while node in nodes and node not in seen:
            seen.add(node)
            parent, kind = nodes[node]
            if kind != "subregion" or not parent or parent == "back" or \
                    nodes.get(parent, (None, None))[1] == "group":
                break
            node = parent
        found = (dominant_subregions(cx, name, node)
                 if node in CARD_SUBREGION_MUSCLES else [node])
        for n in found:
            if n not in result:
                result.append(n)
    return result


def lift_muscles(cx, name):
    return "·".join(UL.muscle_ko(m, cx.db) for m in primary_muscles(cx, name))


def session_title(cx, items, code):
    totals = {}
    for ex in items:
        d, _ = dose(cx, ex["name"])
        sets = sets_for(cx, code, ex["name"], d["sets"])
        for m in primary_muscles(cx, ex["name"]):
            if m not in ("abs", "core", "calves"):
                totals[m] = totals.get(m, 0) + sets
    # Python's stable sort retains the first appearance for equal set counts.
    return "·".join(UL.muscle_ko(m, cx.db) for m in
                    sorted(totals, key=lambda m: -totals[m])[:3])


def session_block(cx, fd, code):
    items = fd[code]
    lines = [T("sess_head", code=code, title=session_title(cx, items, code))]

    def add(text):
        lines.append(T("sess_line", text=text))

    blocks = (cx.st.get("practice_blocks") or {}).get(code) or {}
    i = 1
    flow = blocks.get("flow")
    if flow and flow.get("drills"):
        add(T("sess_flow", i=i, minutes=flow["minutes"],
              names=", ".join(UL.plan_drill_ko(k) for k in flow["drills"])))
        i += 1
    add(T("sess_prep", i=i, minutes=PREP_MINUTES,
          names=", ".join(UL.plan_drill_ko(k) for k in cx.st["prep"][code])))
    power = blocks.get("power")
    if power and power.get("key"):
        i += 1
        lo, hi = power["rep_range"]
        if power.get("lift"):
            # no explosive move clears the caution sites: speed sets of the
            # first lift, which compose already screened
            ex = next((x["display"] for x in items if x["name"] == power["lift"]),
                      UL.exercise_ko(power["lift"]))
            add(T("sess_power_speed", i=i, minutes=power["minutes"], ex=ex,
                  sets=power["sets"], lo=lo, rest=power["rest_sec"]))
        else:
            add(T("sess_power", i=i, minutes=power["minutes"], ex=power["display"],
                  sets=power["sets"], lo=lo, hi=hi, rest=power["rest_sec"]))
    for i, ex in enumerate(items, i + 1):
        d, _w = dose(cx, ex["name"])
        sets = sets_for(cx, code, ex["name"], d["sets"])
        lo, hi = d["rep_range"]
        key = "sess_lift_sec" if d["unit"] == "sec" else "sess_lift_reps"
        add(T(key, i=i, ex=ex["display"], sets=sets, lo=lo, hi=hi,
              muscles=lift_muscles(cx, ex["name"])))
    i += 1
    finisher = blocks.get("finisher")
    if finisher and finisher.get("key"):
        add(T("sess_finisher", i=i, minutes=finisher["minutes"],
              ex=finisher["display"], work=finisher["work_sec"],
              rest=finisher["rest_sec"], rounds=finisher["rounds"]))
        i += 1
    circuit = blocks.get("circuit")
    if circuit and circuit.get("keys") and circuit.get("minutes"):
        add(T("sess_circuit", i=i, minutes=circuit["minutes"],
              names=" → ".join(circuit["display"]), work=circuit["work_sec"],
              rounds=circuit["rounds"]))
        i += 1
    cardio = cx.st.get("cardio")
    if cardio and cardio.get("pick") != "none":
        tp = cx.st.get("time_plan")
        add(cardio_where(tp, "sess_cardio_moved", i=i,
                         minutes=cardio["minutes"], name=cardio["display"])
            or T("sess_cardio", i=i, minutes=cardio["minutes"],
                 name=cardio["display"]))
        i += 1
    add(T("sess_cooldown", i=i, minutes=COOLDOWN_MINUTES,
          names=", ".join(UL.plan_drill_ko(k) for k in cx.st["cooldown"][code])))
    return "\n".join(lines)


NATIVE_COUNT = {2: "두", 3: "세", 4: "네", 5: "다섯", 6: "여섯"}


def sessions_move(cx, fd):
    rot = cx.st["structure"]["rotation"]
    checks = self_check(cx)
    paras = [session_block(cx, fd, code) for code in rot]
    caution = caution_lines(cx, fd)
    if caution:
        paras.append("\n".join(caution))
    if checks.get("goal"):
        paras.append(T("sess_volume"))
    elif checks.get("goal") is None and cx.st.get("volume_shortfall"):
        # the soft shortfall (accept_compose), said once, plainly
        names = T("sm_site_sep").join(
            UL.muscle_ko(s_["muscle"], cx.db)
            for s_ in cx.st["volume_shortfall"])
        paras.append(T("sess_volume_short", muscles=names,
                       eun=josa(names, "eun")))
    practice = program_practice(cx, fd)
    for said in (practice_line(cx, practice), functional_line(cx, practice)):
        if said:
            paras.append(said)
    paras.append(T("sess_ask", count=NATIVE_COUNT[len(rot)])
                 if len(rot) in NATIVE_COUNT else T("sess_ask_one"))
    return pmove(cx, "propose", "sessions", say="\n\n".join(paras),
                 choices=[choice("ok", T("c_sess_ok"), True),
                          choice("change", T("c_sess_change"))],
                 answer={"stage": "sessions", "payload": {
                     "pick": "ok | change",
