def read_payload(spec):
    if spec is None:
        raise ValueError("no payload (--json <inline|@file|->)")
    if spec == "-":
        raw = sys.stdin.read()
    elif spec.startswith("@"):
        with open(spec[1:], encoding="utf-8") as f:
            raw = f.read()
    else:
        raw = spec
    return json.loads(raw)


def main(argv=None):
    ap = argparse.ArgumentParser(prog="program-plan")
    ap.add_argument("command", choices=("next", "answer", "status", "reset",
                                        "volume-say", "restart", "handoff",
                                        "reask", "place-fix"))
    ap.add_argument("--from", dest="from_", choices=("goal", "program"),
                    default="goal", help="restart: goal (default) | program")
    ap.add_argument("--draft", help="volume-say: the draft program.yaml")
    ap.add_argument("--db", default=DEFAULT_DB)
    ap.add_argument("--program", default=DEFAULT_PROGRAM)
    ap.add_argument("--state", default=DEFAULT_STATE)
    ap.add_argument("--today")
    ap.add_argument("--stage")
    ap.add_argument("--json", dest="payload")
    ap.add_argument("--json-out", action="store_true")
    ap.add_argument("--no-side-effects", action="store_true",
                    help="replay: no workbench pin, no kit config-set, "
                         "no calendar routines")
    args = ap.parse_args(argv)

    if args.command == "reset":
        if os.path.exists(args.state):
            os.unlink(args.state)
        print("RESET")
        return EXIT_OK
    cx = Ctx(args)
    if args.command == "volume-say":
        return volume_say(cx, args.draft or args.program, args.json_out)
    if args.command == "status":
        print(json.dumps(cx.st, ensure_ascii=False, indent=2))
        return EXIT_OK
    if args.command == "restart":
        mv = restart(cx, args.from_)
        print(json.dumps(mv, ensure_ascii=False, separators=(",", ":") if mv.get("stage") == "compose" else None, indent=None if not
                         args.json_out else 2))
        return EXIT_ERR if mv.get("kind") == "error" else EXIT_OK
    if args.command == "reask":
        # a side question: the open move again in one line, same buttons;
        # the queued readback stays queued for the move that answers it
        mv = reask_move(next_move(cx))
        print(json.dumps(mv, ensure_ascii=False, indent=None if not
                         args.json_out else 2))
        return EXIT_ERR if mv.get("kind") == "error" else EXIT_OK
    if args.command == "handoff":
        mv = _with_readback(cx, handoff_move(cx))
        print(json.dumps(mv, ensure_ascii=False, indent=None if not
                         args.json_out else 2))
        return EXIT_ERR if mv.get("kind") == "error" else EXIT_OK
    if args.command == "place-fix":
        # an install whose workout routine has no place: one question, once
        mv = place_fix_move(cx)
        print(json.dumps(mv, ensure_ascii=False, indent=None if not
                         args.json_out else 2))
        return EXIT_OK
    if args.command == "answer" and args.stage == "place_fix":
        try:
            mv = answer_place_fix(cx, read_payload(args.payload))
        except (ValueError, OSError, Refused) as e:
            sys.stderr.write("program-plan: REFUSED -- nothing recorded\n%s\n"
                             % e)
            print("REFUSED\tplace_fix")
            return EXIT_REFUSED
        print(json.dumps(mv, ensure_ascii=False, indent=None if not
                         args.json_out else 2))
        return EXIT_OK
    if args.command == "answer" and args.stage == "health_link":
        try:
            mv = answer_health_link(cx, read_payload(args.payload))
        except (ValueError, OSError, Refused) as e:
            sys.stderr.write("program-plan: REFUSED -- nothing recorded\n%s\n"
                             % e)
            print("REFUSED\thealth_link")
            return EXIT_REFUSED
        print(json.dumps(mv, ensure_ascii=False, indent=None if not
                         args.json_out else 2))
        return EXIT_OK
    if args.command == "answer" and args.stage == "set_style":
        try:
            mv = answer_set_style(cx, read_payload(args.payload))
        except (ValueError, OSError, Refused) as e:
            sys.stderr.write("program-plan: REFUSED -- nothing recorded\n%s\n"
                             % e)
            print("REFUSED\tset_style")
            return EXIT_REFUSED
        print(json.dumps(mv, ensure_ascii=False, indent=None if not
                         args.json_out else 2))
        return EXIT_ERR if mv.get("kind") == "error" else EXIT_OK
    if args.command == "answer" and args.stage == "reprogram":
        try:
            mv = answer_reprogram(cx, read_payload(args.payload))
        except (ValueError, OSError, Refused) as e:
            sys.stderr.write("program-plan: REFUSED -- nothing recorded\n%s\n"
                             % e)
            print("REFUSED\treprogram")
            return EXIT_REFUSED
        print(json.dumps(mv, ensure_ascii=False, indent=None if not
                         args.json_out else 2))
        return EXIT_ERR if mv.get("kind") == "error" else EXIT_OK
    if args.command == "answer":
        if not args.stage:
            sys.stderr.write("program-plan: answer needs --stage\n")
            return EXIT_ERR
        try:
            payload = read_payload(args.payload)
        except (ValueError, OSError) as e:
            sys.stderr.write("program-plan: unreadable payload: %s\n" % e)
            return EXIT_ERR
        try:
            apply_answer(cx, args.stage, payload)
        except Refused as e:
            sys.stderr.write("program-plan: REFUSED -- nothing recorded\n%s\n"
                             % e)
            if getattr(e, "say", None):
                # the reason and the one narrow re-ask, for the user
                sys.stderr.write("SAY\t%s\n" % e.say)
            print("REFUSED\t%s" % args.stage)
            return EXIT_REFUSED
        drop_notes(cx, args.stage)
        if args.stage.split(":")[0] == "calorie":
            pass        # the step's own fold; its close sets the wrap fold
        elif args.stage != "safety" or (cx.st.get("goal") or {}).get("done"):
            # the first program question is answered: the wrap fold / the
            # restart line were spoken with it, the card opens from here
            cx.st.pop("wrap_fold", None)
            cx.st.pop("lead", None)
        cx.save()
        sys.stderr.write("ANSWERED\t%s\n" % args.stage)
    if args.command == "next" and cx.st.get("offer") == "later":
        # a paused build resumes where it stopped on the next `next`
        # (the answer that paused it returned `paused`, exit 3)
        cx.st.pop("offer", None)
        cx.save()
    if args.command == "answer" and isinstance(payload, dict) and \
            payload.get("question"):
        # an answer with a question riding it (D12): recorded above; the
        # question is answered before the next say
        cx.st["aside"] = str(payload["question"])[:300]
    # an answer already given whose kit side is missing lands now (once)
    filled = kit_backfill(cx)
    if filled:
        cx.save()
        sys.stderr.write("KIT_BACKFILL\t%s\n" % ",".join(filled))
    mv = _with_readback(cx, next_move(cx))
    aside = cx.st.pop("aside", None)
    if aside:
        mv["aside"] = {"question": aside, "do": (
            "answer it in one or two lines first, from the plan's own "
            "facts, then speak the say as is")}
        cx.save()
    print(json.dumps(mv, ensure_ascii=False, separators=(",", ":") if mv.get("stage") == "compose" else None, indent=None if not args.json_out
                     else 2))
    if mv["kind"] == "error":
        return EXIT_ERR
    return EXIT_PAUSED if mv["kind"] == "paused" else EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
