    horizon = handoff(cx).get("horizon")
    return args + (["end=" + horizon] if horizon else []) + ["--new"]


def register_calendar(cx):
    """Reconcile, then replace (D3, P8): the agent's old routines the plan
    replaces are RETIRED through the kit (an end date, then `routine retire`:
    the row stays, only future instances are cancelled -- nothing deleted),
    THEN one routine per time window is added ("운동", its weekdays, start
    and length; no time said -> all-day, a time is never picked for the
    user, E13) plus the measure day. True when the days are on the
    calendar."""
    wins = (cx.st.get("daytime") or {}).get("windows") or []
    if not wins:
        return False
    if cx.st.get("calendar_existing_answered") == "keep":
        cx.st["calendar_linked"] = [x["id"] for x in cx.st.get("calendar_existing_items", [])]
        return True
    today = cx.today.isoformat()
    replaced = []
    for w in replaced_routines(cx):
        rc, _o, e = kit(["routine", "update", str(w["id"]), "end=" + today])
        if rc != 0:
            cx.st.setdefault("kit_errors", []).append(
                "routine update %s: %s" % (w["id"], (e or "").strip()[-200:]))
        rc, _o, e = kit(["routine", "retire", str(w["id"])])
        if rc != 0:
            cx.st.setdefault("kit_errors", []).append(
                "routine retire %s: %s" % (w["id"], (e or "").strip()[-200:]))
            continue
        replaced.append({"id": w["id"], "title": w["title"],
                         "since": w.get("since")})
    cx.st["calendar_replaced"] = replaced
    # Cancel only future manual blocks. The kit verb retains a tombstone and
    # never rewrites a completed historical instance.
    for item in cx.st.get("calendar_existing_items", []):
        if item.get("source") != "block":
            continue
        try:
            if local_calendar_stamp(item["start_at"]).date() < cx.today:
                continue
        except (ValueError, TypeError):
            continue
        verb = {"appointment": "appt-cancel", "presence": "presence-cancel",
                "task": "task-del"}.get(item.get("block_kind"))
        if verb:
            rc, _out, err = kit([verb, str(item["id"])])
            if rc != 0:
                cx.st.setdefault("kit_errors", []).append(
                    "calendar block %s: %s" % (item["id"], (err or "").strip()[-200:]))
    ok = True
    existing_signatures = {(tuple(x["weekdays"]), x.get("start"))
                           for x in calendar_routines(cx.db, "exercise")}
    for w in wins:
        if (tuple(w["weekdays"]), w.get("start")) in existing_signatures:
            continue
        args = ["routine", "add", "헬스", "W:" + ",".join(w["weekdays"])]
        if w.get("start"):
            args.append("time=%s" % w["start"])
            hour, minute = map(int, w["start"].split(":"))
            # The routine engine sends the lead alert and the start alert.
            args.append("notify=%d" % (hour * 60 + minute + 180))
            if w.get("end"):
                args.append("duration=%d" % _minutes(w["start"], w["end"]))
        horizon = handoff(cx).get("horizon")
        if horizon:
            args.append("end=" + horizon)
        rc, out, e = kit(args + ["--new"])
        if rc != 0:
            ok = False
            cx.st.setdefault("kit_errors", []).append(
                "routine add: %s" % ((e or out or "").strip()[-200:]))
    cargs = cardio_routine_args(cx)
    if cargs:
        rc, out, e = kit(cargs)
        if rc != 0:
            ok = False
            cx.st.setdefault("kit_errors", []).append(
                "routine add (cardio): %s" % ((e or out or "").strip()[-200:]))
    margs = measure_routine_args(cx)
    if margs:
        rc, out, e = kit(margs)
        cx.st["calendar_measure"] = rc == 0
        if rc != 0:
            cx.st.setdefault("kit_errors", []).append(
                "routine add (measure): %s" % ((e or out or "").strip()[-200:]))
    return ok


def archive_program(cx):
