def _kit_goal(args):
    rc, _o, e = kit(args)
    if rc != 0:
        raise Refused("E-KIT\tgoal\t%s: %s" % (
            args[0], (e or "kit not reachable").strip()[-200:]))


def apply_goal_adjust(cx, info, note):
    """The goal adjustment picked: written through the kit's goal layer
    (never by hand) -- goal-set --horizon for a moved date, goal-focus
    backlog for a goal leaving the focus, and on every kind the goal's
    detail.plan_adjust (what it was, why, when) so it can be undone when
    the time grows. Said once on the next message, with the way back."""
    gid = info["goal_id"]
    mark = dict(why="time", on=cx.today.isoformat(), kind=info["kind"])
    if info.get("cardio_keep"):
        # the fat goal's cardio gave its minutes: the old length kept too
        mark.update(cardio_from=(cx.st.get("cardio") or {}).get("minutes"),
                    cardio_to=info["cardio_keep"])
    if info["kind"] in ("deadline", "fat"):
        mark.update(from_horizon=info["frm"], to_horizon=info["to"])
        _kit_goal(["goal-set", str(gid), "--horizon", info["to"],
                   "--detail", _goal_detail(cx, gid, plan_adjust=mark)])
    elif info["kind"] == "target":
        mark.update(from_target=info["frm_target"],
                    to_target=info["to_target"])
        _kit_goal(["goal-set", str(gid), "--target",
                   _num_said(info["to_target"]), "--detail",
                   _goal_detail(cx, gid, plan_adjust=mark)])
    elif info["kind"] in ("focus", "fat_focus"):
        mark.update(from_focus=info["frm"])
        _kit_goal(["goal-focus", str(gid), "backlog"])
        _kit_goal(["goal-set", str(gid), "--detail",
                   _goal_detail(cx, gid, plan_adjust=mark)])
    else:
        mark.update(eased_branch="muscle_keep")
        _kit_goal(["goal-set", str(gid), "--detail",
                   _goal_detail(cx, gid, plan_adjust=mark)])
    cx.st["goal_adjust"] = dict(info, on=cx.today.isoformat())
    if note:
        cx.st.setdefault("notes", []).append({"text": note, "at": None})


def apply_goal_first(cx, gid):
    """The user's goal order (the decision said it was assumed): the goal
    named first, the rest in their order, written as priority_rank
    through the kit; the decision is put again on it."""
    goals = active_goals(cx)
    try:
        gid = int(gid)
    except (TypeError, ValueError):
        gid = None
    if gid not in [g["id"] for g in goals]:
        raise Refused("E-GOAL\tfirst_goal\tone of %s" % ", ".join(
            str(g["id"]) for g in goals))
    ordered = sorted(goal_order(cx)[0], key=lambda g: g["id"] != gid)
    for i, g in enumerate(ordered, 1):
        _kit_goal(["goal-set", str(g["id"]), "--priority", str(i)])
    cx.st["goal_first"] = gid
    for k in ("time_decision", "sessions"):
        cx.st.pop(k, None)
    first = goal_name(ordered[0])
    cx.st.setdefault("notes", []).append({"text": T(
        "ga_set_first", goal=first, eul=josa(first, "reul")), "at": None})


def reconcile_day_move(cx):
    tp = cx.st["time_plan"]
    key = ("rc_day_ask_cardio" if tp["pick"] == "cardio_extra"
           else "rc_day_ask_add")
    return pmove(cx, "ask", "reconcile:day",
                 say=T(key, cardio=tp["cardio"]),
                 answer={"stage": "reconcile", "payload": {
                     "weekday": "MON..SUN, the day the user named (not a "
                                "regular day)",
                     "start": "optional HH:MM", "end": "optional HH:MM"}})


def _stage_reconcile(cx):
    """Right after the days: every window holding the day is said in one
    line; a short window is recorded (pick `shrink`, the whole day
    composed) and decided at the sessions step (time_decision)."""
    st = cx.st
    if not st.get("daytime") or st.get("restart_facts_pending"):
        return None
    tp = st.get("time_plan")
    if tp and tp.get("status") == "set":
        return None
    if tp and tp.get("status") == "need_day":
        return reconcile_day_move(cx)
    chk = time_check(cx)
    # a day short: the full queue until the decision (some days short ->
    # trimmed there at session-open, said; every day -> decided)
    pick = ("fits" if not chk["short"] and chk["timed"] else
            "untimed" if not chk["short"] else "shrink")
    st["time_plan"] = dict(status="set", total=chk["total"],
                           cardio=chk["parts"]["cardio"], pick=pick,
                           decided=False)
    if chk["short"]:
        st["time_plan"]["short"] = dict(chk["short"])
    if pick == "fits":
        st.setdefault("notes", []).append({"text": T("rc_fits"),
                                           "key": "rc_fits", "at": None})
    cx.save()
    return None


def _rc_weekday(cx, payload):
    wd = payload.get("weekday")
    if wd is None:
        return None
    if wd not in UL.WEEKDAY_ORDER:
        raise Refused("E-WEEKDAYS\tweekday\tone of MON..SUN")
    if wd in (cx.st.get("daytime") or {}).get("weekdays") or ():
        raise Refused("E-WEEKDAYS\tweekday\ta regular day is not a "
                      "supplementary day")
    return wd


def apply_reconcile(cx, payload):
    """The reconcile answer (stage `reconcile`): the day a time pick waits
    for (status need_day). The pick itself is the sessions answer."""
    tp = cx.st.get("time_plan") or {}
    if tp.get("status") != "need_day":
        raise Refused("E-STAGE\tstage\tthe time is decided with the "
                      "sessions (use `next`)")
    wd = _rc_weekday(cx, payload)
    if wd is None:
        raise Refused("E-WEEKDAYS\tweekday\tthe day the user named")
    win = None
    if payload.get("start"):
        win = _windows([{"weekdays": [wd], "start": payload.get("start"),
                         "end": payload.get("end")}], "weekday")[0][0]
    return _settle(cx, tp["pick"], tp["check"], wd, win)


def decide_time(cx, pick, payload):
    """A sessions answer that changes the plan's time (time_decision): the
    reconcile pick settled (or waiting for its day), the sessions composed
    again."""
    st = cx.st
    chk = time_check(cx)
    wd = _rc_weekday(cx, payload)
    extra = (st.get("daytime") or {}).get("extra") or []
    for k in ("compose", "volume_shortfall", "sessions", "time_decision"):
        st.pop(k, None)
    if pick in ("cardio_extra", "add_day") and wd is None and not extra:
        st["time_plan"] = dict(status="need_day", pick=pick,
                               total=chk["total"],
                               cardio=chk["parts"]["cardio"], check=chk,
                               decided=True)
        return None
    return _settle(cx, pick, chk, wd or (extra[0] if pick != "shrink"
                                         else None), None)


def _settle(cx, pick, chk, wd, win):
    st = cx.st
    dt = st["daytime"]
    p = chk["parts"]
    tp = dict(status="set", pick=pick, total=chk["total"],
              cardio=p["cardio"], short=dict(chk["short"]), decided=True)
    if pick == "cardio_extra":
        # off the short days; every day holding the dose (the weekly floor
        # was the reason): off every regular day
        tp.update(cardio_off=[d for d in UL.WEEKDAY_ORDER
                              if d in chk["short"]] or list(dt["weekdays"]),
                  cardio_day=wd)
        if wd not in dt.get("extra", []):
            dt["extra"] = [d for d in UL.WEEKDAY_ORDER
                           if d in set(dt.get("extra", []) + [wd])]
            if win:
                dt["extra_windows"] = sorted(
                    dt.get("extra_windows", []) + [win],
                    key=lambda w: UL.WEEKDAY_ORDER.index(w["weekdays"][0]))
        note = T("rc_set_cardio_extra", short=_days_compact(tp["cardio_off"]),
                 day=UL.WEEKDAY_KO[wd])
    elif pick == "shrink":
        note = T("rc_set_shrink", short=_days_compact(list(chk["short"])))
    else:
        total = add_day_total(cx, chk)
        win = win or next((dict(w, weekdays=[wd]) for w in
                           dt.get("extra_windows") or ()
                           if wd in w["weekdays"]),
                          {"weekdays": [wd], "start": None, "end": None})
        dt["extra"] = [d for d in dt.get("extra", []) if d != wd]
        dt["extra_windows"] = [
            dict(w, weekdays=[d for d in w["weekdays"] if d != wd])
            for w in dt.get("extra_windows") or ()
            if [d for d in w["weekdays"] if d != wd]]
        dt["windows"] = sorted(
            dt["windows"] + [win],
            key=lambda w: UL.WEEKDAY_ORDER.index(w["weekdays"][0]))
        dt["weekdays"] = [d for d in UL.WEEKDAY_ORDER
                          if d in dt["weekdays"] + [wd]]
        st["days"] = {"weekdays": dt["weekdays"], "source": "daytime"}
        st["frequency"] = len(dt["weekdays"])
        st["day_minutes"] = tp["total"] = total
        tp["added_day"] = wd
        note = T("rc_set_add_day", day=UL.WEEKDAY_KO[wd],
                 n=st["frequency"], total=total)
    st["time_plan"] = tp
    # The sessions are composed again for the decision; one more day is a
    # new count, so the split is measured again too. Shrink preserves the
    # full queue budget and carries the weekday caps to session-open.
    for k in (("structure", "split_offer") if pick == "add_day" else ()) + (
            "compose", "volume_shortfall", "sessions", "time_decision"):
        st.pop(k, None)
    st.setdefault("notes", []).append({"text": note, "at": None})
    return None


# -- measure day (P7: after the schedule, tied to a training day) -------------
# Body-composition cadence: the kit's metric_freshness (weekly = 168h). The
# goal part set the cadence; the weekday is the program's to pick.
BODY_METRICS = ("body_fat_pct", "skeletal_muscle_kg", "weight_kg",
                "body_weight")
WEEKLY_MAX_HOURS = 24 * 8
MONTHLY_MIN_HOURS = 24 * 27


def _measure_hours(cx):
    return [h for (h,) in _q(cx.db, "SELECT stale_after_hours FROM "
                                    "metric_freshness WHERE metric IN (%s)"
                             % ",".join("?" * len(BODY_METRICS)),
                             BODY_METRICS) if h]


def measure_cadence(cx):
    hours = _measure_hours(cx)
    if hours:
        return "monthly" if min(hours) >= MONTHLY_MIN_HOURS else "weekly"
    if handoff(cx).get("measure"):
        return "weekly"
    return None


def after_weekend_day(days, nth=2):
    """The nth training day after the weekend (Monday on), else the first."""
    order = [d for d in UL.WEEKDAY_ORDER if d in days]
    return order[nth - 1] if len(order) >= nth else order[0]


def stage_measure(cx):
    """None when the measure slot is settled (stated or not needed), else the
    ONE narrowed proposal. Rule (P7): this agent's own active measure
    routine on a new training day -> that day, before the session, fasted --
    STATED on the next message; else the second training day after the
    weekend -> proposed with one confirm."""
    st = cx.st
    if not st.get("daytime"):
        return None
    days = st["daytime"]["weekdays"]
    cad = measure_cadence(cx)
    if cad is None:
        st["measure"] = {"status": "set", "cadence": "none"}
        cx.save()
        return None
    if cad == "monthly":
        st["measure"] = {"status": "set", "cadence": "monthly",
                         "weekday": None}
        st.setdefault("notes", []).append({"text": T("measure_monthly"),
                                           "at": None})
        cx.save()
        return None
    old = [w for w in calendar_routines(cx.db, "measure",
                                        owning_agent_hint(cx))
           if set(w["weekdays"]) & set(days)]
    if old:
        w = old[0]
        wd = [d for d in w["weekdays"] if d in days][0]
        since = _date_ko(w["since"]) if w.get("since") else None
        st["measure"] = {"status": "set", "cadence": "weekly",
                         "weekday": wd, "source": "record",
                         "routine": w["id"]}
        st.setdefault("notes", []).append({"text": T(
            "measure_kept", day=UL.WEEKDAY_FULL_KO[wd],
            since=(T("measure_since", m=since.month)
                   if since and since <= cx.today else ""),
            what=T("measure_what_weight" if "체중" in (w["title"] or "")
                   else "measure_what_inbody")), "at": None})
        cx.save()
        return None
    wd = after_weekend_day(days)
    st["measure"] = {"status": "proposed", "cadence": "weekly",
                     "weekday": wd, "source": "rule"}
    cx.save()
    day = UL.WEEKDAY_FULL_KO[wd]
    # the goal part declared the weekly cadence: said first (owner
    # rehearsal 2026-10-01); recommended in the body, never in a label
    agreed = T("measure_agreed_weekly") if _measure_hours(cx) else ""
    return pmove(cx, "propose", "measure",
                 say=T("measure_propose", day=day, agreed=agreed),
                 narrowed=True,
                 choices=[dict(choice("ok", T("c_measure_day", day=day)),
                               recommended=True),
                          choice("other", T("c_measure_other"))],
                 answer={"stage": "measure", "payload": {
                     "pick": "ok | other",
                     "weekday": "on other: one of %s (a training day)"
                                % ", ".join(days)}})


# -- experience --------------------------------------------------------------
def experience_from_record(cx):
    """('continuous', (per_week, span_days)) | ('returner?', last_date) |
    (None, None) ask."""
    dates = workout_dates(cx.db)
    if not dates:
        return None, None
    recent = [d for d in dates if (cx.today - d).days < 28]
    if recent:
        before = [d for d in dates if d < recent[0]]
        if before and (recent[0] - before[-1]).days >= 60:
            return "returner?", before[-1]
        span = (cx.today - dates[0]).days
        if span >= 90:
            return "continuous", (len(recent) / 4.0, span)
        return None, None
    return "returner?", dates[-1]


def record_experience(cx, hist, band):
    """Both answers, in the state and through the kit's config-set."""
    cx.st["experience"], cx.st["years_band"] = hist, band
    cx.st.pop("experience_pending", None)
    for kv in ("%s=%s" % (EXP_KEY, hist), "%s=%s" % (BAND_KEY, band),
               "%s=%s" % (BAND_ASOF_KEY, cx.today.isoformat())):
        rc, _o, e = kit(["config-set", kv])
        if rc != 0:
            cx.st.setdefault("kit_errors", []).append(
                "config-set %s: %s" % (kv.split("=")[0],
                                       (e or "").strip()[-200:]))
    cx.save()


def _band_move(cx, say, hist, before):
    cx.st["experience_pending"] = hist
    cx.save()
    return pmove(cx, "ask", "experience", before=before, say=say,
                choices=[choice(b, T("c_band_" + b)) for b in YEARS_BANDS],
                answer={"stage": "experience", "payload": {
                    "pick": " | ".join(YEARS_BANDS)}})


def stage_experience(cx, before="program"):
    """ONE question at most, recording the history kind AND the years band.
    None when both are already known (stored, or settled by the records)."""
    if cx.st.get("experience") and cx.st.get("years_band"):
        return None
    hist = config_value(cx.db, EXP_KEY)
    hist = hist if hist in EXPERIENCE else None
    band = config_value(cx.db, BAND_KEY)
    band = band if band in YEARS_BANDS else None
    band = band or IMPLIED_BAND.get(hist)
    if band and not hist:
        # The kit's goal interview asked how long they have trained (the
        # follow-up in its 운동 slot, owner 2026-09-26 17:03) and stored the
        # band -- that answer is never asked again here. A history kind it
        # did not store is read off the records, else off the band itself
        # (under a year counts as starting out: the full-body norm is the
        # safe side).
        kind, _val = experience_from_record(cx)
        hist = {"continuous": "continuous",
                "returner?": "returner"}.get(kind) or \
            ("beginner" if band == "lt1" else "continuous")
    if hist and band:
        cx.st["experience"], cx.st["years_band"] = hist, band
        cx.save()
        return None
    kind, val = (None, None) if cx.st.get("experience_record_rejected") \
        else experience_from_record(cx)
    if kind == "continuous":
        per_week, span = val
        n = int(round(per_week)) or 1
        if span >= RECORD_3PLUS_DAYS or band:
            record_experience(cx, "continuous", band or "3plus")
            cx.st.setdefault("readback", []).append(
                T("exp_continuous_readback", n=n))
            cx.save()
            return None
        return _band_move(cx, T("exp_continuous_band", n=n), "continuous",
                          before)
    if kind == "returner?":
        last = "%d월 %d일" % (val.month, val.day)
        if val.year != cx.today.year:
            last = "%d년 %s" % (val.year, last)
        picks = ["back_" + b for b in YEARS_BANDS]
        return pmove(cx, "ask", "experience", before=before,
                    say=T("exp_returner_confirm", last=last),
                    choices=[choice(p, T("c_band_" + p[5:])) for p in picks]
                    + [choice("ask", T("c_not_returner"))],
                    answer={"stage": "experience", "payload": {
                        "pick": " | ".join(picks + ["ask"])}})
    if hist:
        return _band_move(cx, T("exp_band_ask"), hist, before)
    return pmove(cx, "ask", "experience", before=before, say=T("exp_ask"),
                choices=[choice(p, T("c_exp_" + p)) for p in EXP_PICKS],
                answer={"stage": "experience", "payload": {
                    "pick": " | ".join(EXP_PICKS)}})


