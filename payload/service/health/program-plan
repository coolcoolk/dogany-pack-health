def _hangul(word):
    return bool(word) and all("\uac00" <= ch <= "\ud7a3" for ch in word)


def safety_site_name(key, value):
    """A safety row's site as the user wrote it ('right knee' from
    (e.g. injury_<site>_r, 'right knee is sore')), else the key's site. The kit's
    own naming (lifekit 1bc5756): when ONE sentence names two sites stored
    on two rows, its first words name the FIRST row's site only -- a row
    whose key site the sentence names later is that key site, no side."""
    words = str(value or "").split()
    sides = {w: side for side in ("r", "l", "both")
             for w in T("side_words_" + side).split()}
    side, i = None, 0
    if words and words[0] in sides:
        side, i = sides[words[0]], 1
    site = None
    if len(words) > i:
        w = words[i]
        if len(w) > 1 and w[-1] in T("site_particles"):
            w = w[:-1]
        if len(w) <= 6 and _hangul(w):
            site = w
    key_site, key_side = UL.parse_site_key(key)
    key_name = UL.SITE_KO.get(key_site)
    if site is not None and key_name and site != key_name \
            and key_name in " ".join(words[i + 1:]):
        site, side = None, None
    if site is None:
        site = key_name or str(key_site or "").replace("_", " ") or None
    if side is None and key_side:
        side = key_side
    if not site:
        return None
    return T("card_site_side", side=T("side_" + side), site=site) if side \
        else site


def safety_card_phrase(cx):
    """The kit's safety card phrase (P2, one wording on both cards). A
    phrase that repeats a site was written by the old two-sites-one-sentence
    misread ('right knee . right knee' for knee + shoulder): its sites are
    re-read from the safety records, so no site is hidden."""
    phrase = cx.st.get("safety_card")
    if not phrase:
        return phrase
    sep = T("card_sep")
    parts = [p.strip() for p in str(phrase).split(sep.strip()) if p.strip()]
    rows = _q(cx.db, "SELECT key, value FROM ledger_constraint WHERE "
                     "class='safety' AND status='active' AND key LIKE 'injury_%' "
                     "ORDER BY id")
    if len(set(parts)) == len(parts):
        # a site recorded after the goal part (the phrase predates it) is
        # added in the user's words, so the card names every site
        late = []
        for k, v in rows:
            name = safety_site_name(k, v)
            site, _side = UL.parse_site_key(k)
            if name and UL.site_ko(site) not in phrase and name not in phrase:
                late.append(name)
        return sep.join(dict.fromkeys(parts + late)) if late else phrase
    names = [safety_site_name(k, v) for k, v in rows]
    names = [n for n in names if n] or parts
    return sep.join(dict.fromkeys(names))


