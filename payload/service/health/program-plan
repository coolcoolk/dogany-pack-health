EXERCISE_WORDS = re.compile("헬스|운동|세션|웨이트|workout|gym|training",
                            re.I)
MEASURE_WORDS = re.compile("체중|인바디|측정|weigh|inbody", re.I)


def owning_agent_hint(cx=None):
    """This agent's name for routine ownership: the kit's env, else this
    instance's slug (ax_engine.resolve_owning_agent: the mint manifest), else
    (reads only -- cx given) the owner of the routines the kit handed over,
    else None."""
    name = os.environ.get("LIFEKIT_AGENT") or \
        os.environ.get("GOAL_OWNING_AGENT")
    if name:
        return name
    try:
        import ax_engine                                    # noqa: E402
        name = ax_engine.resolve_owning_agent(default=None)
    except Exception:                                       # noqa: BLE001
        name = None
    if name:
        return name
    for w in ((cx.st.get("handoff") or {}).get("calendar") or ()) if cx \
            else ():
        if isinstance(w, dict) and w.get("owning_agent"):
            return w["owning_agent"]
    return None


def cadence_weekdays(cadence):
    """['MON', ...] from 'W:MON,WED!hol'; [] when not weekly."""
    c = str(cadence or "").split("!")[0]
    if not c.startswith("W:"):
        return []
    days = {t.strip().upper() for t in c[2:].split(",")}
    return [d for d in UL.WEEKDAY_ORDER if d in days]


def calendar_routines(db, kind, owner=None):
    """Active routines of one kind -- 'exercise', 'measure' or 'cardio' (the
    supplementary day this plan writes, titled cal_cardio_title) -- as
    [{id, title, weekdays, start, end, since, owning_agent, recurrence_id}].
    Calendar consultation includes every owner of a health item."""
    out = []
    for rid, title, purpose, cad, tod, dur, start, agent, recurrence in _q(
            db, "SELECT id, title, COALESCE(purpose,''), cadence, "
                "time_of_day, duration_min, start_date, owning_agent, recurrence_id FROM "
                "routine_def WHERE status='active' ORDER BY id"):
        is_measure = bool(MEASURE_WORDS.search(title or ""))
        is_ex = not is_measure and bool(EXERCISE_WORDS.search(
            "%s %s" % (title or "", purpose)))
        if (kind == "measure") != is_measure or (kind == "exercise"
                                                 and not is_ex):
            continue
        if kind == "cardio" and (title or "").strip() != T("cal_cardio_title"):
            continue
        days = cadence_weekdays(cad)
        if not days:
            continue
        w = {"id": rid, "title": title, "weekdays": days, "start": None,
             "end": None, "since": str(start or "")[:10],
             "owning_agent": agent, "recurrence_id": recurrence}
        if tod:
            try:
                h, mi = (int(x) for x in str(tod).split(":")[:2])
            except ValueError:
                h = None
            if h is not None:
                e = h * 60 + mi + int(dur or 0)
                w["start"] = "%02d:%02d" % (h, mi)
                w["end"] = "%02d:%02d" % ((e // 60) % 24, e % 60)
        out.append(w)
    return out


def _days_compact(days):
    """['TUE','WED','THU','FRI'] -> '화~금'; ['MON','WED'] -> '월·수'."""
    idx = sorted(UL.WEEKDAY_ORDER.index(d) for d in days)
    runs, cur = [], []
    for i in idx:
        if cur and i == cur[-1] + 1:
            cur.append(i)
        else:
            if cur:
                runs.append(cur)
            cur = [i]
    if cur:
        runs.append(cur)
    out = []
    for r in runs:
        names = [UL.WEEKDAY_KO[UL.WEEKDAY_ORDER[i]] for i in r]
        out.append("%s~%s" % (names[0], names[-1]) if len(r) >= 3
                   else "·".join(names))
    return "·".join(out)


def _hours(start, end):
    h1, m1 = (int(x) for x in start.split(":"))
    h2, m2 = (int(x) for x in end.split(":"))
    if m1 == 0 and m2 == 0:
        return T("cal_hours", h1=h1, h2=h2)
    return T("cal_hm", h1=start, h2=end)


def calendar_windows_of(cx):
    """The user's timed workout windows: the kit handoff's (weekdays 0-6),
    else the pack's own read of the same routine rows. [{weekdays, start,
    end}], week order."""
    wins = []
    for w in handoff(cx).get("calendar") or ():
        if not isinstance(w, dict) or not (w.get("start") and w.get("end")):
            continue
        days = [UL.WEEKDAY_ORDER[d] if isinstance(d, int) else str(d).upper()
                for d in w.get("weekdays") or ()]
        days = [d for d in UL.WEEKDAY_ORDER if d in days]
        if days:
            wins.append({"weekdays": days, "start": w["start"],
                         "end": w["end"]})
    if not wins and "calendar" not in handoff(cx):
        wins = [w for w in calendar_routines(cx.db, "exercise",
                                             owning_agent_hint(cx))
                if w["start"] and w["end"]]
    wins.sort(key=lambda w: (UL.WEEKDAY_ORDER.index(w["weekdays"][0]),
                             w["start"]))
    return wins


def calendar_sentence(cx, n):
    """Screen 3 (owner rehearsal 2026-10-01): the calendar's workout windows
    in one sentence (cal_line) and, when the calendar holds more days than
    the count, the fixed-days / extra-days sentence (cal_more); '' when the
    user has no timed workout routine."""
    wins = calendar_windows_of(cx)
    if not wins:
        return ""
    parts = [T("cal_window", days=T("cal_days", days=_days_compact(
        w["weekdays"])), hours=_hours(w["start"], w["end"])) for w in wins]
    out = T("cal_line", windows=", ".join(parts))
    days = {d for w in wins for d in w["weekdays"]}
    if n and len(days) > n:
        out += T("cal_more", n=n)
    return out


