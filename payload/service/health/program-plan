def _stage_sessions(cx):
    if cx.st.get("sessions") == "ok":
        return None
    fd = final_days(cx)
    checks = self_check(cx)
    failed = [name for name, passed in checks.items() if passed is False]
    if failed:
        sig = json.dumps(fd, sort_keys=True, ensure_ascii=False)
        again = (cx.st.get("self_check_loop") or {}).get("sig") == sig
        cx.st["self_check_loop"] = {"sig": sig}
        tp = cx.st.get("time_plan") or {}
        if again and failed == ["goal"] and cx.st.get("self_check_lone") \
                and tp.get("pick") == "short" and tp.get("decided") \
                and cx.st.get("goal_adjust"):
            # the goal adjusted under a split that visits each region once:
            # the user's decision stands, the split's shape is said
            return sessions_move(cx, fd, lone=cx.st["self_check_lone"])
        if again and failed == ["goal"] and short_window_plan(cx):
            # the same plan failed twice and the window is the reason (a
            # split whose regions the short day cannot hold, owner review
            # 2026-10-04): never a loop -- the whole day is composed and
            # the time decided with the user at the sessions step
            tp = cx.st["time_plan"]
            tp.update(pick="shrink", decided=False)
            tp.pop("cardio_off", None)
            tp.pop("cardio_day", None)
            cx.st.pop("self_check_loop", None)
        elif again and failed == ["goal"] and cx.st.get("self_check_lone"):
            # the same plan again, short only of "every region twice a
            # week": the split's own shape (the body-part split visits each
            # region once).
            # Never a loop: the sessions are shown with it said, and the
            # time decided there when it is short
            return sessions_move(cx, fd, lone=cx.st["self_check_lone"])
        # Return to the silent model lane with the concrete failing plan.
        # No unverified four-session preview is sent to the user.
        cx.st["self_check_issues"] = failed
        cx.st.pop("compose", None)
        cx.save()
        mv = stage_compose(cx)
        mv["for_model"] += (" The previous plan failed the self-check: "
                             + ", ".join(failed) + ". Correct it and "
                             "submit all sessions again.")
        mv["previous_days"] = fd
        return mv
    cx.st.pop("self_check_loop", None)
    return sessions_move(cx, fd)


