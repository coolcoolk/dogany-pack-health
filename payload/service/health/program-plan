SET_STYLE_PICKS = ("volume", "intensity")


def answer_set_style(cx, payload):
    """The user's set style, changed by request (rules set_style, owner
    2026-10-07): never a consult question. Recorded on the plan state (kept
    across a program restart); a composed program follows it: before the
    write the compose runs again on the next `next` (silent, as always);
    after the write the program is composed again on the kept answers,
    archived and rewritten (the request is the owner's approval), and the
    sessions are said. The weekly floors hold in either style: a floor the
    window cannot hold is said as on the first build."""
    import copy
    import compose_rank
    style = _pick(payload, SET_STYLE_PICKS)
    if compose_rank.set_style_of(cx.st) == style:
        cx.st["set_style"] = style
        cx.save()
        return move("done", "set_style", say=T("set_style_same_" + style))
    entered = copy.deepcopy(cx.st)
    cx.st["set_style"] = style
    say = [T("set_style_" + style)]
    drop = [k for k in COMPOSE_KEYS if k != "structure"] + [
        "sessions", "time_decision", "session_sets", "margin_short",
        "self_check_issues", "self_check_loop"]
    if cx.st.get("written"):
        for k in drop:
            cx.st.pop(k, None)
        try:
            draft = resolve_compose(cx, {"accept": True})
            accept_compose(cx, draft)
        except Refused:
            cx.st = entered
            raise
        fd = final_days(cx)
        self_check(cx)
        archived = archive_program(cx)
        rc, out, err = do_write(cx, fd, force=True)
        if rc not in (0, 4):
            cx.st = entered
            cx.save()
            return move("error", "set_style", say=None, program_init_rc=rc,
                        stdout=out[-500:], stderr=err[-1500:])
        cx.st["program_archived"] = archived
        cx.st["sessions"] = "ok"
        rot = cx.st["structure"]["rotation"]
        say.append(T("set_style_rewritten"))
        say.extend(session_block(cx, fd, code) for code in rot)
        say.extend(style_lines(cx, fd))
        short = cx.st.get("volume_shortfall") or []
        if short:
            say.append(T("tc_floor", items=volume_items(cx, short),
                         gap=floor_gap(short)))
        cx.save()
        refresh_workbench(cx)
        return move("done", "set_style", say="\n\n".join(say))
    if cx.st.get("compose"):
        for k in drop:
            cx.st.pop(k, None)
        say.append(T("set_style_next"))
        cx.save()
        return move("done", "set_style", say="\n\n".join(say),
                    for_model="the sessions are composed again with the "
                              "new style: run `program-plan next` and go on")
    cx.save()
    return move("done", "set_style", say="\n\n".join(say))


