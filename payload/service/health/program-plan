    facilities = 'optional, only when stated: ' + ', '.join(sorted({
        v for values in load_rules()['availability']['requirements'].values() for v in values}))
    p = cx.st.get("place")
    if p and p.get("venue") is None and p.get("label"):
        return pmove(cx, "confirm", "place",
                     say=T("place_equipment_confirm", place=p["label"]),
                     choices=[choice("full", T("c_full_kit")),
                              choice("partial", T("c_partial_kit"))],
                     answer={"stage": "place", "payload": {"facilities": facilities,
                         "pick": "full | partial",
                         "equipment": "on partial: list from %s" % ", ".join(
                             sorted(init_mod().LATTICE_BY_EQUIPMENT))}})
    if p and p.get("venue") == "home" and "equipment" not in p:
        return pmove(cx, "ask", "place",
                     say=T("home_equipment_ask"),
                     choices=[choice("have", T("c_have")),
                              choice("have_not", T("c_have_not"))],
                     answer={"stage": "place", "payload": {"facilities": facilities,
                         "pick": "have | have_not"}})
    if gym_name_pending(p):
        # owner 17:43: which gym -- registered as the place, the basis for
        # swapping lifts on a day spent somewhere else. A gym the goal part
        # already recorded is stated on the card, never asked (owner
        # rehearsal 2026-10-01): only its name is.
        known = p.get("source") in ("handoff", "record")
        return pmove(cx, "ask", "place:gym_name", fold_card=known,
                     say=T("gym_known_ask" if known else "gym_name_ask"),
                     answer={"stage": "place", "payload": {"facilities": facilities,
                         "pick": "named | unnamed",
                         "name": "on named: the gym's name as the user said "
                                 "it", "area": "optional: the area/동네"}})
    return pmove(cx, "propose", "place", say=T("place_ask"),
                 choices=[choice("gym", T("c_gym"), True),
                          choice("home", T("c_home")),
                          choice("other", T("c_other_place"))],
                 answer={"stage": "place", "payload": {"facilities": facilities,
                     "pick": "gym | home | other | later",
                     "words": "the user's words (other)",
                     "equipment": "on other: list from %s" % ", ".join(
                         sorted(init_mod().LATTICE_BY_EQUIPMENT))}})


def gym_name_pending(p):
    """A gym with no name on record or in the answer (P1: '어느 헬스장')."""
    return bool(p) and p.get("venue") == "gym" and "name" not in p and \
        not p.get("label")


def place_open(cx):
    """True while the place still needs a question."""
    p = cx.st.get("place")
    return (p.get("venue") == "home" and "equipment" not in p) or \
        p.get("venue") is None or gym_name_pending(p)


def register_gym(cx, name, area):
    """The gym becomes the stored place (the kit's resource-add, the same
    row venue_record reads), once."""
    detail = {"venue": "gym", "equipment": []}
    if area:
        detail["area"] = area
    rc, _o, e = kit(["resource-add", "--kind", "env", "--name", name,
                     "--detail", json.dumps(detail, ensure_ascii=False),
                     "--source", "interview"])
    if rc != 0:
        cx.st.setdefault("kit_errors", []).append(
            "resource-add: %s" % (e or "").strip()[-200:])


def place_from_record(cx):
    """A stored place is READ, never re-asked -- its filled card line is the
    confirmation. A place stored with no kind (a name only) gets ONE
    equipment confirm -- its name is known, what is in it is not, and a gym
    is never assumed (F7)."""
    venue, label = venue_record(cx.db)
    if venue is None:
        return False
    if venue == "other" and label:
        cx.st["place"] = {"venue": None, "label": label, "source": "record"}
        cx.save()
        return True
    cx.st["place"] = {"venue": venue, "label": label, "source": "record",
                      "equipment": [] if venue != "home" else ["dumbbell"]}
    cx.save()
    return True


# the goal part's activity words naming a gym ("heolseu" in Korean)
GYM_WORDS = re.compile("\ud5ec\uc2a4|gym|fitness", re.I)


def place_from_handoff(cx):
    """The goal part recorded that the user trains at a gym (the kit
    handoff's activity words / card line): the place is the gym, stated on
    the card -- only its name is asked."""
    if not GYM_WORDS.search(_words(handoff(cx).get("activity"))):
        return False
    cx.st["place"] = {"venue": "gym", "source": "handoff", "equipment": []}
    cx.save()
    return True


# -- frequency (owner 2026-10-01: the program's first question) -------------
FREQ_MIN, FREQ_MAX = 1, 7          # any answer in range is the user's own
FREQ_MENU_MIN, FREQ_MENU_MAX = 2, 6
# the kit's activity words: "<week> 3~4 <times>", "<week> 3 <times|days>"
ACTIVITY_FREQ = re.compile(r"\uc8fc\s*(\d)(?:\s*[~\-]\s*(\d))?\s*"
                           r"(?:\ud68c|\ubc88|\uc77c)")


def _words(v):
    if isinstance(v, dict):
        return " ".join(_words(x) for x in v.values())
    if isinstance(v, (list, tuple)):
        return " ".join(_words(x) for x in v)
    return str(v) if v is not None else ""


def frequency_rec(cx):
    """(recommended count, why kind, the user's current frequency words):
    the current frequency from the kit handoff (upper bound of a range),
    else the training band (a beginner 3, otherwise 4)."""
    m = ACTIVITY_FREQ.search(_words(handoff(cx).get("activity")))
    if m:
        lo, hi = int(m.group(1)), int(m.group(2) or m.group(1))
        n = min(max(hi, FREQ_MENU_MIN), FREQ_MENU_MAX)
        now = (T("freq_now_range", a=lo, b=hi) if hi != lo
               else T("freq_now_one", a=lo))
        return n, "now", now
    band = cx.st.get("years_band") or handoff(cx).get("training_band")
    # a never-trained history fixes the band by itself (IMPLIED_BAND)
    if "lt1" in (band, IMPLIED_BAND.get(cx.st.get("experience"))):
        return 3, "beginner", None
    return 4, "goal", None


def frequency_options(rec):
    lo = min(max(rec - 1, FREQ_MENU_MIN), FREQ_MENU_MAX - 2)
    return [lo, lo + 1, lo + 2]


SPACED_MAX = 3      # this many days or fewer fit a week with a rest between


def site_names(st):
    """The safety sites without their side, each once ('knee', 'shoulder')."""
    return list(dict.fromkeys(UL.site_ko(it.get("site"))
                              for it in st.get("safety_items") or ()
                              if it.get("site")))


def frequency_lines(position, n, phase, sites, floor):
    """(good, bad) for the option at `position` (fewest / middle / most
    days of the three) -- a small template table, not a generator."""
    cut = "_cut" if phase == "cut" else ""
    if position == "fewest":
        return (T("freq_pro_fewest" + cut),
                T("freq_con_fewest", floor=floor))
    if position == "middle":
        return (T("freq_pro_middle", floor=floor),
                T("freq_con_middle_spaced" if n <= SPACED_MAX
                  else "freq_con_middle"))
    tail = "_sites" if sites else ""
    return (T("freq_pro_most"),
            T("freq_con_most" + cut + tail, sites=T("sm_site_sep").join(sites)))


# The day's dose (owner 2026-10-02): ONE day-total, the whole gym day --
# prep + strength + cardio + cooldown. Recommended by training history --
# ONE table to tune, (low, high) minutes of the whole day. A returner takes
# the 1-3 year row whatever the years; a beginner the under-a-year row. The
# recommendation is the midpoint rounded to SESSION_STEP. The strength
# budget is what is left: total - care - cardio (cardio_minutes, one rule).
DAY_MINUTES = {"lt1": (45, 60), "1to3": (60, 75), "3plus": (75, 90)}
DAY_MINUTES_BY_KIND = {"beginner": "lt1", "returner": "1to3"}
DAY_MINUTES_DEFAULT = "1to3"     # no history on record
SESSION_STEP = 5
SESSION_MIN, SESSION_MAX = 20, 180   # any answer in range is the user's own
STRENGTH_MIN = 15        # a day-total must leave this much strength time
CARDIO_CUT, CARDIO_OTHER = 20, 10    # phase cardio after the lifts


def _round_step(minutes, down=False):
    if down:
        return int(minutes // SESSION_STEP) * SESSION_STEP
    return int(minutes / float(SESSION_STEP) + 0.5) * SESSION_STEP


def training_history(cx):
    """(history kind, years band) as far as known before the experience
    stage: the state, else the kit config, else the goal handoff."""
    hist = cx.st.get("experience") or config_value(cx.db, EXP_KEY)
    hist = hist if hist in EXPERIENCE else None
    band = (cx.st.get("years_band") or config_value(cx.db, BAND_KEY)
            or handoff(cx).get("training_band"))
    band = band if band in YEARS_BANDS else IMPLIED_BAND.get(hist)
    return hist, band


def cardio_minutes(cx):
    """The phase cardio after the lifts: a cut 20 minutes, else 10. The ONE
    rule the dose, the reconcile and the cardio step read."""
    return CARDIO_CUT if cut_phase_metric(cx.db) else CARDIO_OTHER


def care_split():
    """(prep, cooldown) minutes, from the compose rules' budget."""
    import compose_rank
    b = compose_rank.load_rules()["budget"]
    return b["prep_minutes"], b["cooldown_minutes"]


def day_parts(cx, total):
    """{total, prep, cooldown, cardio, strength} of a day-total."""
    prep, cool = care_split()
    cardio = cardio_minutes(cx)
    return dict(total=total, prep=prep, cooldown=cool, cardio=cardio,
                strength=total - prep - cool - cardio)


def day_minutes_rec(cx):
    """{lo, hi, rec, why}: the history row of DAY_MINUTES and its rounded
    midpoint -- the ideal dose, before the user's real time is asked (the
    reconcile step checks it against the days)."""
    hist, band = training_history(cx)
    row = DAY_MINUTES_BY_KIND.get(hist) or band
    why = "band" if row in DAY_MINUTES else "default"
    lo, hi = DAY_MINUTES[row if why == "band" else DAY_MINUTES_DEFAULT]
    return dict(lo=lo, hi=hi, rec=_round_step((lo + hi) / 2.0), why=why)


def day_total(cx):
    """The agreed day-total: the user's own, else the recommendation."""
    return cx.st.get("day_minutes") or day_minutes_rec(cx)["rec"]


def dose_lines(cx, total, why="band"):
    """The day-total line and its breakdown, said once."""
    parts = day_parts(cx, total)
    return T("dose_why_" + why, m=total) + " " + T("dose_parts", **parts)


def rec_label(title, n):
    """The recommended button: its title with the (추천) marker when the
    numbered row fits the bridge's button width -- the kit's rule (kit_life
    2.37.1 _rec_label: CJK counts 1.5, at most 31)."""
    marked = title + REC
    width = sum(1.5 if ord(ch) > 0x2E7F else 1
                for ch in "%d. %s" % (n, marked))
    return marked if width <= BUTTON_WIDTH_MAX else title


BUTTON_WIDTH_MAX = 31


def freq_choices(opts, rec):
    return [dict(choice(str(n), rec_label(T("freq_title", n=n), i + 1)
                        if n == rec else T("freq_title", n=n)),
                 recommended=n == rec) for i, n in enumerate(opts)]


def stage_frequency(cx):
    """Screen 2, the dose proposal (owner 2026-10-02): the count options and
    the day-total recommendation; the user picks the count only (minutes in
    free text still set the day-total)."""
    import split_model
    rec, kind, now = frequency_rec(cx)
    dr = day_minutes_rec(cx)
    pending = cx.st.get("day_minutes_pending")
    opts = frequency_options(rec)
    contract = {"pick": " | ".join([str(n) for n in opts] + ["other"]),
                "count": "on other: the weekly count the user said, as a "
                         "number (said in words too), %d..%d"
                         % (FREQ_MIN, FREQ_MAX),
                "minutes": "on other: the minutes a day the user said (the "
                           "whole gym day), as a number (an hour = 60), "
                           "%d..%d; omit when not said"
                           % (SESSION_MIN, SESSION_MAX),
                "words": "optional: the user's own words; the pack reads "
                         "the count and the minutes / hours from them"}
    if pending:
        # the minutes came alone: only the count is asked
        return pmove(cx, "decide", "frequency",
                     say=T("freq_count_only", m=pending, n=rec),
                     choices=freq_choices(opts, rec), recommend=str(rec),
                     answer={"stage": "frequency", "payload": contract})
    phase = split_model.phase_of(cx, globals())
    floor = split_model.rules()["frequency_floor"].get(phase, 2)
    sites = site_names(cx.st)
    lines = [T("freq_why") + (T("freq_now", now=now) if now else "") + " "
             + floor_why(phase), ""]
    for i, n in enumerate(opts):
        title = T("freq_title", n=n)
        lines.append(T("opt_title", n=i + 1,
                       title=title + (REC if n == rec else "")))
        good, bad = frequency_lines(("fewest", "middle", "most")[i], n, phase,
                                    sites, floor)
        lines.append(T("opt_good", text=good))
        lines.append(T("opt_bad", text=bad))
        lines.append("")
    lines.append(dose_lines(cx, dr["rec"], dr["why"]))
    lines.append("")
    lines.append(T("freq_close_" + kind, n=rec))
    return pmove(cx, "decide", "frequency", say="\n".join(lines),
                 choices=freq_choices(opts, rec), recommend=str(rec),
                 day_minutes=dr["rec"],
                 answer={"stage": "frequency", "payload": contract})


# the user's words for the count and the minutes ("4 times 60 min",
# "4 times an hour"); native Korean numbers one..seven, escaped
NATIVE_NUM = {"\ud55c": 1, "\ub450": 2, "\uc138": 3, "\ub124": 4,
              "\ub2e4\uc12f": 5, "\uc5ec\uc12f": 6, "\uc77c\uacf1": 7}
_NATIVE = "|".join(sorted(NATIVE_NUM, key=len, reverse=True))
# (week) N (times | days)
COUNT_WORDS = re.compile(r"(?:\uc8fc\s*)?(\d|%s)\s*(?:\ud68c|\ubc88|\uc77c(?!\w))"
                         % _NATIVE)
# N hour(s) [half | M minutes]
HOUR_WORDS = re.compile(r"(\d+(?:\.\d+)?|%s)\s*\uc2dc\uac04"
                        r"(?:\s*(\ubc18|\d+\s*\ubd84))?" % _NATIVE)
HALF = "\ubc18"
# N minutes
MINUTE_WORDS = re.compile(r"(\d+)\s*\ubd84")


def _num(word):
    return NATIVE_NUM[word] if word in NATIVE_NUM else float(word)


def parse_count_minutes(words):
    """(count | None, minutes | None) read from the user's words."""
    text = str(words or "")
    minutes = None
    h = HOUR_WORDS.search(text)
    if h:
        minutes = _num(h.group(1)) * 60
        tail = h.group(2) or ""
        minutes += 30 if tail == HALF else int(re.sub(r"\D", "", tail) or 0)
        text = text[:h.start()] + " " + text[h.end():]
    else:
        m = MINUTE_WORDS.search(text)
        if m:
            minutes = int(m.group(1))
            text = text[:m.start()] + " " + text[m.end():]
    c = COUNT_WORDS.search(text)
    count = int(_num(c.group(1))) if c else None
    return count, (int(round(minutes)) if minutes is not None else None)


def _int(raw):
    try:
        return None if isinstance(raw, bool) or raw in (None, "") \
            else int(raw)
    except (TypeError, ValueError):
        return None


def parse_frequency(payload):
    """(count | None, minutes | None). A button pick is the count alone;
    on other, the numbers the agent read, else the user's words. Refused
    when neither is there or one is out of range."""
    p = payload.get("pick")
    other = p in (None, "other")
    words_n, words_m = parse_count_minutes(payload.get("words"))
    n = _int(payload.get("count") if other else p)
    if n is None and other:
        n = words_n
    m = _int(payload.get("minutes"))
    if m is None:
        m = words_m
    if n is None and m is None or n is not None and not (
            FREQ_MIN <= n <= FREQ_MAX):
        raise Refused("E-FREQUENCY\t%s\ta weekly count %d..%d"
                      % ("count" if other else "pick", FREQ_MIN, FREQ_MAX))
    if m is not None and not (SESSION_MIN <= m <= SESSION_MAX):
        raise Refused("E-FREQUENCY\tminutes\tminutes a day %d..%d"
                      % (SESSION_MIN, SESSION_MAX))
    return n, m


# -- daytime (round 3: ONE slot, the days and times; after the weekly count) --
def local_calendar_stamp(raw):
    """UTC kit block timestamp as the owner's Seoul calendar time."""
    stamp = datetime.datetime.fromisoformat(str(raw).replace("Z", "+00:00"))
    if stamp.tzinfo is None:
        stamp = stamp.replace(tzinfo=datetime.timezone.utc)
    return stamp.astimezone(datetime.timezone(datetime.timedelta(hours=9)))


def existing_calendar_items(cx):
    """All active health routines and future manual or migrated blocks."""
    items = []
    for kind in ("exercise", "measure"):
        for routine in calendar_routines(cx.db, kind):
            items.append(dict(routine, source="routine", kind=kind))
    # Blocks generated by an active routine are represented by its rule.
    # Manual and migrated occurrences with no active routine remain separate.
    active_recurrences = {x.get("recurrence_id") for x in items if x.get("recurrence_id")}
    for rid, title, start_at, end_at, kind, status, recurrence in _q(
            cx.db, "SELECT id,title,start_at,end_at,kind,status,recurrence_id "
                   "FROM timeblock WHERE substr(start_at,1,10)>=? "
                   "AND status IN ('open','scheduled') ORDER BY start_at",
            ((cx.today - datetime.timedelta(days=1)).isoformat(),)):
        if recurrence in active_recurrences or not (
                EXERCISE_WORDS.search(title or "") or
                MEASURE_WORDS.search(title or "")):
            continue
        try:
            if local_calendar_stamp(start_at).date() < cx.today:
                continue
        except (ValueError, TypeError):
            continue
        category = "measure" if MEASURE_WORDS.search(title or "") else "exercise"
        items.append({"id": rid, "title": title, "start_at": start_at,
                      "end_at": end_at, "source": "block", "kind": category,
                      "block_kind": kind})
    return items


def existing_calendar_move(cx, items):
    lines = ["캘린더에 기존 운동 일정이 이렇게 있었네요."]
    for item in items[:12]:
        if item["source"] == "routine":
            when = _days_compact(item["weekdays"]) + (" " + item["start"] if item.get("start") else "")
        else:
            when = local_calendar_stamp(item["start_at"]).strftime("%m/%d %H:%M")
        lines.append("• %s · %s" % (item["title"], when))
    if len(items) > 12:
        lines.append("• 그 외 %d건" % (len(items)-12))
    lines.append("이대로 유지할까요, 수정할까요?")
    return pmove(cx, "decide", "calendar_existing", say="\n".join(lines),
                 choices=[choice("keep", "유지할게요", True),
                          choice("modify", "수정할래요")],
                 answer={"stage": "calendar_existing", "payload":
                         {"pick": "keep | modify"}})


def stage_daytime(cx):
    """A4: an OPEN question (P5 returns: the daytime is not a proposal),
    opened by the calendar sentence read from the user's active routines,
    with GENERIC examples. The base days and the extra (보충) days, each with
    their windows, are read off the ONE answer."""
    items = existing_calendar_items(cx)
    if items and not cx.st.get("calendar_existing_answered"):
        return existing_calendar_move(cx, items)
    n = cx.st.get("frequency")
    return pmove(cx, "ask", "daytime",
                 say=(T("daytime_ask_dose", n=n, m=day_total(cx),
                        calendar=calendar_sentence(cx, n)) if n
                      else T("daytime_ask", calendar="")),
                 answer={"stage": "daytime", "payload": {
                     "windows": "[{weekdays: [MON..SUN], start: 'HH:MM' | "
                                "null, end: 'HH:MM' | null}] -- the REGULAR "
                                "days, one entry per distinct time window, "
                                "in the user's words (no time said -> "
                                "start/end null)",
                     "extra_windows": "optional, same shape: the days the "
                                      "user comes when there is room (보충) "
                                      "with their hours -- from the SAME "
                                      "answer, never asked again"}})


def _clock(t, where):
    try:
        h, m = (int(x) for x in str(t).split(":", 1))
        assert 0 <= h < 24 and 0 <= m < 60
    except (ValueError, AssertionError, TypeError):
        raise Refused("E-TIME\t%s\tHH:MM" % where)
    return "%02d:%02d" % (h, m)


def _windows(wins, key, taken=()):
    out, days = [], []
    for i, w in enumerate(wins):
        p = "%s[%d]" % (key, i)
        wd = w.get("weekdays") if isinstance(w, dict) else None
        if not isinstance(wd, list) or not wd or any(
                d not in UL.WEEKDAY_ORDER for d in wd):
            raise Refused("E-WEEKDAYS\t%s.weekdays\tlist of MON..SUN" % p)
        if set(wd) & set(days):
            raise Refused("E-WEEKDAYS\t%s.weekdays\ta day in two windows"
                          % p)
        if set(wd) & set(taken):
            raise Refused("E-WEEKDAYS\t%s.weekdays\ta regular day is not "
                          "an extra day" % p)
        days += wd
        start = _clock(w["start"], p + ".start") if w.get("start") else None
        end = _clock(w["end"], p + ".end") if w.get("end") else None
        if end and not start:
            raise Refused("E-TIME\t%s.start\tan end needs a start" % p)
        if start and end and end <= start:
            raise Refused("E-TIME\t%s.end\tafter the start" % p)
        out.append({"weekdays": [d for d in UL.WEEKDAY_ORDER if d in wd],
                    "start": start, "end": end})
    out.sort(key=lambda w: UL.WEEKDAY_ORDER.index(w["weekdays"][0]))
    return out, days


def parse_daytime(payload):
    wins = payload.get("windows")
    if not isinstance(wins, list) or not wins:
        raise Refused("E-DAYTIME\twindows\tat least one {weekdays, start, "
                      "end}")
    out, days = _windows(wins, "windows")
    if len(days) > MAX_DAYS:
        raise Refused("E-WEEKDAYS\twindows\tat most %d regular days"
                      % MAX_DAYS)
    xw = payload.get("extra_windows") or []
    if not isinstance(xw, list):
        raise Refused("E-WEEKDAYS\textra_windows\tlist of {weekdays, start, "
                      "end}")
    xout, xdays = _windows(xw, "extra_windows", taken=days)
    extra = payload.get("extra") or []
    if not isinstance(extra, list) or any(d not in UL.WEEKDAY_ORDER
                                          for d in extra):
        raise Refused("E-WEEKDAYS\textra\tlist of MON..SUN")
    if set(extra) & set(days):
        raise Refused("E-WEEKDAYS\textra\ta regular day is not an extra day")
    xdays = list(dict.fromkeys(xdays + list(extra)))
    return {"windows": out,
            "weekdays": [d for d in UL.WEEKDAY_ORDER if d in days],
            "extra": [d for d in UL.WEEKDAY_ORDER if d in xdays],
            "extra_windows": xout}


def record_daytime(cx, dt):
    st = cx.st
    before = (st.get("daytime") or {}).get("weekdays")
    st["daytime"] = dt
    st["days"] = {"weekdays": dt["weekdays"], "source": "daytime"}
    n = len(dt["weekdays"])
    if st.get("frequency") and st["frequency"] != n:
        # the days the user named win over the count (never a refusal); the
        # next message says so once
        st.setdefault("notes", []).append({"text": T("freq_updated", n=n),
                                           "at": None})
    st["frequency"] = n
    st.pop("split_offer", None)
    # new days are checked against the day-total again (reconcile)
    st.pop("time_plan", None)
    if before != dt["weekdays"]:
        st.pop("structure", None)
    m = st.get("measure")
    if m and m.get("weekday") and m["weekday"] not in dt["weekdays"]:
        st.pop("measure", None)


# -- reconcile (owner 2026-10-02): the real time against the dose ----------
# Right after the days answer, each training day's window is compared with
# the day-total. All fit: one line, continue. A day short: named, and three
# ways offered in the owner's order -- cardio to the supplementary day, a
# shorter strength part, one more day. The decision is st["time_plan"]:
#   {status: set | need_day, pick: fits | untimed | cardio_extra | shrink |
#    add_day, total, cardio, cardio_off: [weekday], cardio_day: weekday}
# compose_rank.time_budget reads it (the strength budget per day; a day
# whose cardio moved holds no cardio).
RC_PICKS = ("cardio_extra", "shrink", "add_day")


def day_windows(dt):
    """{weekday: window minutes | None} of the regular days."""
    out = {}
    for w in (dt or {}).get("windows") or ():
        m = (_minutes(w["start"], w["end"]) if w.get("start") and
             w.get("end") else None)
        for d in w["weekdays"]:
            out[d] = m
    return out


def time_check(cx):
    """{total, parts, short: {weekday: window}, timed}: the training days
    whose window cannot hold the day-total."""
    total = day_total(cx)
    wins = day_windows(cx.st.get("daytime"))
    short = {d: m for d, m in wins.items() if m is not None and m < total}
    return dict(total=total, parts=day_parts(cx, total), short=short,
                timed=any(m is not None for m in wins.values()))


def lift_unit_minutes():
    """One compound lift at the base sets, with its setup (the compose
    rules' budget): what one fewer lift saves."""
    import compose_rank
    b = compose_rank.load_rules()["budget"]
    return b["compound_minutes"] + b["transition_minutes"]


def reconcile_options(cx, chk):
    """[(pick, title, line)] in the owner's order, the ones that hold."""
    st = cx.st
    p = chk["parts"]
    care = p["prep"] + p["cooldown"]
    low = min(chk["short"].values())
    short_ko = _days_compact(list(chk["short"]))
    extra = (st.get("daytime") or {}).get("extra") or []
    n = len((st.get("daytime") or {}).get("weekdays") or ())
    out = []
    s1 = min(p["strength"], low - care)
    if s1 >= STRENGTH_MIN:
        line = (T("rc_cardio_extra", short=short_ko, strength=s1,
                  cardio=p["cardio"], day=UL.WEEKDAY_KO[extra[0]])
                if extra else
                T("rc_cardio_extra_ask", short=short_ko, strength=s1,
                  cardio=p["cardio"]))
        out.append(("cardio_extra", T("rc_title_cardio_extra"), line))
    s2 = min(p["strength"], low - care - p["cardio"])
    if s2 >= STRENGTH_MIN:
        k = -(-(p["strength"] - s2) // lift_unit_minutes())
        title = (T("rc_title_shrink", k=T("rc_k_%d" % k)) if k <= 3
                 else T("rc_title_shrink_many"))
        out.append(("shrink", title, T("rc_shrink", cardio=p["cardio"],
                                       short=short_ko)))
    total3 = add_day_total(cx, chk)
    if n < MAX_DAYS and total3 is not None:
        before = n * p["strength"]
        after = (n + 1) * (total3 - (p["total"] - p["strength"]))
        week = (T("rc_week_same", before=before) if after >= before else
                T("rc_week_change", before=before, after=after))
        line = (T("rc_add_day", day=UL.WEEKDAY_KO[extra[0]], n=n + 1,
                  total=total3, week=week) if extra else
                T("rc_add_day_ask", n=n + 1, total=total3, week=week))
        out.append(("add_day", T("rc_title_add_day"), line))
    return out


def add_day_total(cx, chk):
    """The day-total with one more day: the same weekly strength spread
    over n + 1 days, never past the shortest window; None when no strength
    part is left."""
    p = chk["parts"]
    n = len((cx.st.get("daytime") or {}).get("weekdays") or ())
    care_cardio = p["total"] - p["strength"]
    spread = _round_step(p["strength"] * n / float(n + 1)) + care_cardio
    total = min(spread, _round_step(min(chk["short"].values()), down=True))
    return total if total - care_cardio >= STRENGTH_MIN else None


def reconcile_rec(cx, chk, picks):
    """(pick, why line): cardio to the supplementary day when there is one
    and the gap is no longer than the cardio; else the shorter strength."""
    p = chk["parts"]
    extra = (cx.st.get("daytime") or {}).get("extra") or []
    gap = p["total"] - min(chk["short"].values())
    if "cardio_extra" in picks and extra and gap <= p["cardio"]:
        return "cardio_extra", T("rc_rec_cardio_extra",
                                 day=UL.WEEKDAY_KO[extra[0]])
    if "shrink" in picks:
        why = ("rc_rec_shrink_no_extra" if not extra
               else "rc_rec_shrink_gap")
        return "shrink", T(why, cardio=p["cardio"],
                           n=picks.index("shrink") + 1)
    return picks[0], None


def reconcile_move(cx, chk):
    by_window = {}
    for d, m in chk["short"].items():
        by_window.setdefault(m, []).append(d)
    lines = [T("rc_short", days=_days_compact(ds), window=m,
               gap=chk["total"] - m)
             for m, ds in sorted(by_window.items(), reverse=True)]
    opts = reconcile_options(cx, chk)
    picks = [k for k, _t, _l in opts]
    rec, why = reconcile_rec(cx, chk, picks)
    paras = [" ".join(lines) + " " + T("rc_lead")]
    for i, (k, title, line) in enumerate(opts):
        paras.append(T("opt_title", n=i + 1,
                       title=title + (REC if k == rec else "")) + "\n"
                     + T("rc_line", text=line))
    paras.append(((why + "\n") if why else "") + T("rc_close"))
    choices = [dict(choice(k, rec_label(title, i + 1) if k == rec else title),
                    recommended=k == rec)
               for i, (k, title, _l) in enumerate(opts)]
    return pmove(cx, "decide", "reconcile", say="\n\n".join(paras),
                 choices=choices, recommend=rec,
                 answer={"stage": "reconcile", "payload": {
                     "pick": " | ".join(picks),
                     "weekday": "optional, MON..SUN: on cardio_extra / "
                                "add_day, the day the user named when no "
                                "supplementary day was given"}})


def reconcile_day_move(cx):
    tp = cx.st["time_plan"]
    key = ("rc_day_ask_cardio" if tp["pick"] == "cardio_extra"
           else "rc_day_ask_add")
    return pmove(cx, "ask", "reconcile:day",
                 say=T(key, cardio=tp["cardio"]),
                 answer={"stage": "reconcile", "payload": {
                     "weekday": "MON..SUN, the day the user named (not a "
                                "regular day)",
                     "start": "optional HH:MM", "end": "optional HH:MM"}})


def _stage_reconcile(cx):
    st = cx.st
    if not st.get("daytime") or st.get("restart_facts_pending"):
        return None
    tp = st.get("time_plan")
    if tp and tp.get("status") == "set":
        return None
    if tp and tp.get("status") == "need_day":
        return reconcile_day_move(cx)
    chk = time_check(cx)
    if not chk["short"]:
        st["time_plan"] = dict(status="set", total=chk["total"],
                               cardio=chk["parts"]["cardio"],
                               pick="fits" if chk["timed"] else "untimed")
        if chk["timed"]:
            st.setdefault("notes", []).append({"text": T("rc_fits"),
                                               "at": None})
        cx.save()
        return None
    if not reconcile_options(cx, chk):
        # no way holds a strength part: the days stand, composition caps
        st["time_plan"] = dict(status="set", total=chk["total"],
                               cardio=chk["parts"]["cardio"], pick="none")
        cx.save()
        return None
    return reconcile_move(cx, chk)


def _rc_weekday(cx, payload):
    wd = payload.get("weekday")
    if wd is None:
        return None
    if wd not in UL.WEEKDAY_ORDER:
        raise Refused("E-WEEKDAYS\tweekday\tone of MON..SUN")
    if wd in (cx.st.get("daytime") or {}).get("weekdays") or ():
        raise Refused("E-WEEKDAYS\tweekday\ta regular day is not a "
                      "supplementary day")
    return wd


def apply_reconcile(cx, payload):
    """The reconcile answer (stage `reconcile`): a pick, or the day a pick
    waits for (status need_day)."""
    st = cx.st
    tp = st.get("time_plan") or {}
    if tp.get("status") == "need_day":
        pick = tp["pick"]
        wd = _rc_weekday(cx, payload)
        if wd is None:
            raise Refused("E-WEEKDAYS\tweekday\tthe day the user named")
        win = None
        if payload.get("start"):
            win = _windows([{"weekdays": [wd], "start": payload.get("start"),
                             "end": payload.get("end")}], "weekday")[0][0]
        return _settle(cx, pick, tp["check"], wd, win)
    chk = time_check(cx)
    if not chk["short"]:
        raise Refused("E-STAGE\tstage\tevery day fits; nothing to reconcile "
                      "(use `next`)")
    picks = [k for k, _t, _l in reconcile_options(cx, chk)]
    pick = _pick(payload, tuple(picks))
    wd = _rc_weekday(cx, payload)
    extra = (st.get("daytime") or {}).get("extra") or []
    if pick in ("cardio_extra", "add_day") and wd is None and not extra:
        st["time_plan"] = dict(status="need_day", pick=pick,
                               total=chk["total"],
                               cardio=chk["parts"]["cardio"], check=chk)
        return None
    return _settle(cx, pick, chk, wd or (extra[0] if pick != "shrink"
                                         else None), None)


def _settle(cx, pick, chk, wd, win):
    st = cx.st
    dt = st["daytime"]
    p = chk["parts"]
    tp = dict(status="set", pick=pick, total=chk["total"],
              cardio=p["cardio"], short=dict(chk["short"]))
    if pick == "cardio_extra":
        tp.update(cardio_off=[d for d in UL.WEEKDAY_ORDER
                              if d in chk["short"]], cardio_day=wd)
        if wd not in dt.get("extra", []):
            dt["extra"] = [d for d in UL.WEEKDAY_ORDER
                           if d in set(dt.get("extra", []) + [wd])]
            if win:
                dt["extra_windows"] = sorted(
                    dt.get("extra_windows", []) + [win],
                    key=lambda w: UL.WEEKDAY_ORDER.index(w["weekdays"][0]))
        note = T("rc_set_cardio_extra", short=_days_compact(tp["cardio_off"]),
                 day=UL.WEEKDAY_KO[wd])
    elif pick == "shrink":
        note = T("rc_set_shrink", short=_days_compact(list(chk["short"])))
    else:
        total = add_day_total(cx, chk)
        win = win or next((dict(w, weekdays=[wd]) for w in
                           dt.get("extra_windows") or ()
                           if wd in w["weekdays"]),
                          {"weekdays": [wd], "start": None, "end": None})
        dt["extra"] = [d for d in dt.get("extra", []) if d != wd]
        dt["extra_windows"] = [
            dict(w, weekdays=[d for d in w["weekdays"] if d != wd])
            for w in dt.get("extra_windows") or ()
            if [d for d in w["weekdays"] if d != wd]]
        dt["windows"] = sorted(
            dt["windows"] + [win],
            key=lambda w: UL.WEEKDAY_ORDER.index(w["weekdays"][0]))
        dt["weekdays"] = [d for d in UL.WEEKDAY_ORDER
                          if d in dt["weekdays"] + [wd]]
        st["days"] = {"weekdays": dt["weekdays"], "source": "daytime"}
        st["frequency"] = len(dt["weekdays"])
        st["day_minutes"] = tp["total"] = total
        tp["added_day"] = wd
        note = T("rc_set_add_day", day=UL.WEEKDAY_KO[wd],
                 n=st["frequency"], total=total)
    st["time_plan"] = tp
    # Rebuild an in-flight split for the new decision. Shrink preserves the
    # full queue budget and carries the weekday caps to session-open.
    for k in ("structure", "split_offer"):
        st.pop(k, None)
    st.setdefault("notes", []).append({"text": note, "at": None})
    return None


# -- measure day (P7: after the schedule, tied to a training day) -------------
# Body-composition cadence: the kit's metric_freshness (weekly = 168h). The
# goal part set the cadence; the weekday is the program's to pick.
BODY_METRICS = ("body_fat_pct", "skeletal_muscle_kg", "weight_kg",
                "body_weight")
WEEKLY_MAX_HOURS = 24 * 8
MONTHLY_MIN_HOURS = 24 * 27


def _measure_hours(cx):
    return [h for (h,) in _q(cx.db, "SELECT stale_after_hours FROM "
                                    "metric_freshness WHERE metric IN (%s)"
                             % ",".join("?" * len(BODY_METRICS)),
                             BODY_METRICS) if h]


def measure_cadence(cx):
    hours = _measure_hours(cx)
    if hours:
        return "monthly" if min(hours) >= MONTHLY_MIN_HOURS else "weekly"
    if handoff(cx).get("measure"):
        return "weekly"
    return None


def after_weekend_day(days, nth=2):
    """The nth training day after the weekend (Monday on), else the first."""
    order = [d for d in UL.WEEKDAY_ORDER if d in days]
    return order[nth - 1] if len(order) >= nth else order[0]


def stage_measure(cx):
    """None when the measure slot is settled (stated or not needed), else the
    ONE narrowed proposal. Rule (P7): this agent's own active measure
    routine on a new training day -> that day, before the session, fasted --
    STATED on the next message; else the second training day after the
    weekend -> proposed with one confirm."""
    st = cx.st
    if not st.get("daytime"):
        return None
    days = st["daytime"]["weekdays"]
    cad = measure_cadence(cx)
    if cad is None:
        st["measure"] = {"status": "set", "cadence": "none"}
        cx.save()
        return None
    if cad == "monthly":
        st["measure"] = {"status": "set", "cadence": "monthly",
                         "weekday": None}
        st.setdefault("notes", []).append({"text": T("measure_monthly"),
                                           "at": None})
        cx.save()
        return None
    old = [w for w in calendar_routines(cx.db, "measure",
                                        owning_agent_hint(cx))
           if set(w["weekdays"]) & set(days)]
    if old:
        w = old[0]
        wd = [d for d in w["weekdays"] if d in days][0]
        since = _date_ko(w["since"]) if w.get("since") else None
        st["measure"] = {"status": "set", "cadence": "weekly",
                         "weekday": wd, "source": "record",
                         "routine": w["id"]}
        st.setdefault("notes", []).append({"text": T(
            "measure_kept", day=UL.WEEKDAY_FULL_KO[wd],
            since=(T("measure_since", m=since.month)
                   if since and since <= cx.today else ""),
            what=T("measure_what_weight" if "체중" in (w["title"] or "")
                   else "measure_what_inbody")), "at": None})
        cx.save()
        return None
    wd = after_weekend_day(days)
    st["measure"] = {"status": "proposed", "cadence": "weekly",
                     "weekday": wd, "source": "rule"}
    cx.save()
    day = UL.WEEKDAY_FULL_KO[wd]
    # the goal part declared the weekly cadence: said first (owner
    # rehearsal 2026-10-01); recommended in the body, never in a label
    agreed = T("measure_agreed_weekly") if _measure_hours(cx) else ""
    return pmove(cx, "propose", "measure",
                 say=T("measure_propose", day=day, agreed=agreed),
                 narrowed=True,
                 choices=[dict(choice("ok", T("c_measure_day", day=day)),
                               recommended=True),
                          choice("other", T("c_measure_other"))],
                 answer={"stage": "measure", "payload": {
                     "pick": "ok | other",
                     "weekday": "on other: one of %s (a training day)"
                                % ", ".join(days)}})


