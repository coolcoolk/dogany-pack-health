CARDIO_OPTIONS = {key: item['ko'] for key, item in MC.CARDIO_CATALOG.items()}


def cardio_move(cx):
    """The cardio TYPE. The minutes were agreed with the day-total
    (time_plan, owner 2026-10-02): stated, never asked again."""
    tp = cx.st.get("time_plan") or {}
    minutes = tp.get("cardio") or cardio_minutes(cx)
    sites = {it.get("site") for it in cx.st.get("safety_items") or []}
    preferred = (cx.st.get("cardio_preference") or {}).get("pick")
    recommend = preferred if preferred in CARDIO_OPTIONS else (
        "bike" if sites & {"foot", "ankle", "knee"} else "stepmill")
    reason = ("발이나 무릎을 조심하셔서 자전거를 먼저 권해요. "
              if recommend == "bike" and sites & {"foot", "ankle", "knee"}
              else "")
    if tp.get("status") == "set":
        say = T("cardio_ask_agreed", minutes=minutes, reason=reason,
                where=cardio_where(tp, "cardio_moved"))
        payload = {"pick": " | ".join(CARDIO_OPTIONS)}
    else:
        say = T("cardio_ask", minutes=minutes, reason=reason)
        payload = {"pick": " | ".join(CARDIO_OPTIONS),
                   "minutes": "optional, 10 or more"}
    return pmove(cx, "decide", "cardio", say=say,
                 choices=[choice(k, v, k == recommend)
                          for k, v in CARDIO_OPTIONS.items()],
                 recommend=recommend,
                 answer={"stage": "cardio", "payload": payload})


def cardio_where(tp, key, **kw):
    """The moved-cardio phrase of the agreed plan, '' when none moved."""
    if (tp or {}).get("pick") != "cardio_extra":
        return ""
    return T(key, short=_days_compact(tp["cardio_off"]),
             day=UL.WEEKDAY_KO[tp["cardio_day"]], **kw)


