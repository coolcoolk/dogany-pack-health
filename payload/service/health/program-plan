        return None
    venue = p.get("venue")
    if venue == "gym":
        return T("card_sep").join(x for x in (T("card_gym"),
                                             p.get("name") or p.get("label"))
                                  if x)
    if venue == "home":
        return T("card_home_db" if "dumbbell" in (p.get("equipment") or [])
                 else "card_home")
    return p.get("label") or p.get("words") or None


def card_daytime(dt):
    if not dt:
        return None
    out = []
    for w in dt.get("windows") or ():
        days = UL.weekdays_ko(w["weekdays"])
        if w.get("start") and w.get("end"):
            out.append(T("card_window", days=days, start=w["start"],
                         end=w["end"]))
        elif w.get("start"):
            out.append(T("card_window_from", days=days, start=w["start"]))
        else:
            out.append(days)
    return T("card_sep").join(out) or None


def card_frequency(st):
    n = st.get("frequency") or len((st.get("daytime") or {}).get("weekdays")
                                   or ())
    if n and st.get("day_minutes"):
        # the whole gym day (owner 2026-10-02), as planned: the dose, never
        # past the user's own minutes (owner 2026-10-04)
        return T("card_frequency_minutes", n=n, m=planned_minutes(st))
    return T("card_frequency", n=n) if n else None


def card_extra(dt):
