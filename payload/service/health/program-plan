def choice(pick, label, rec=False):
    return {"pick": pick, "label": label + (REC if rec else ""),
            "recommended": bool(rec)}


def move(kind, stage, say=None, choices=None, answer=None, readback=None,
         **kw):
    if say:
        _copy_gate(say, "say:%s" % stage)
        if form_error(say):
            raise CopyLeak("%s in a rendered move (%s)"
                           % (form_error(say), stage))
        if kind in FINAL_KINDS:
            if "?" in say:
                raise CopyLeak("the closing move %s asks a question" % stage)
        elif not ends_on_decision(say) and not (
                stage in FACT_ASKS and ends_on_request(say)):
            raise CopyLeak("move %s does not end on the next decision"
                           % stage)
    for c in choices or ():
        _copy_gate(c["label"], "choice:%s" % stage)
        if form_error(c["label"]):
            raise CopyLeak("%s in a button (%s)" % (form_error(c["label"]),
                                                    stage))
    for r in readback or ():
        _copy_gate(r, "readback:%s" % stage)
        if form_error(r):
            raise CopyLeak("%s in a readback (%s)" % (form_error(r), stage))
    out = {"kind": kind, "stage": stage, "readback": list(readback or []),
           "say": say, "choices": list(choices or []), "answer": answer}
    out.update(kw)
    return out


def _sites_text(items, cx=None):
    """The sites, each once; with cx, in the side word the user used."""
    names = []
    for it in items:
        n = (user_site_name(cx, it) if cx else
             UL.site_ko(it.get("site"), it.get("side")))
        if n not in names:
            names.append(n)
    return "·".join(names)


class Ctx(object):
