    if pick == "tomorrow" and not opts["tomorrow"]:
        raise Refused("E-PICK\tpick\tno supplementary slot tomorrow")
    if pick == "other":
        try:
            day = datetime.date.fromisoformat(str(payload.get("date"))[:10])
        except ValueError:
            # the day is not said yet: the same step asks for it
            st["first_session"] = {"pick": "other"}
            return
        if day <= cx.today:
            raise Refused("E-DATE\tdate\tthe first session is after today")
        start = _hhmm(payload.get("time"))
        if not start:
            wd = UL.WEEKDAY_ORDER[day.weekday()]
            for w in ((st.get("daytime") or {}).get("windows") or []) + \
                    ((st.get("daytime") or {}).get("extra_windows") or []):
                if wd in w.get("weekdays") or ():
                    start = w.get("start")
    else:
        day, start = opts[pick]
    st["first_session"] = {"pick": pick, "date": day.isoformat(),
                           "time": start, "session": first,
