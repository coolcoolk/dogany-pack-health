def active_goal_metrics(db):
    """Metric tokens in the earliest selected consult phase or active goals."""
    strands = _q(db, "SELECT axis_key, phase_order FROM metric_axis WHERE "
                     "origin='user' AND role='picture'")
    ordered = [r for r in strands if r[1] is not None]
    if ordered:
        first = min(r[1] for r in ordered)
        keys = {k for k, o in ordered if o == first}
    else:
        keys = set()
        for (detail,) in _q(db, "SELECT detail FROM ledger_goal WHERE "
                                "status='active' AND detail IS NOT NULL"):
            try:
                d = json.loads(detail)
            except (ValueError, TypeError):
                continue
            if isinstance(d, dict) and d.get("axis_key"):
                keys.add(d["axis_key"])
    metrics = set()
    for k in keys:
        metrics.update(m for (m,) in _q(
            db, "SELECT metric_token FROM goal_metric_source WHERE "
                "axis_key=?", (k,)))
    return metrics


CUT_METRICS = ("body_fat_pct", "body_weight")
GROW_METRIC = "skeletal_muscle_kg"


def goal_phase(db):
    """(phase, metric) of the current consult phase, read from the active
    goals' DIRECTION (owner rehearsal 2026-10-01): a body fat / body weight
    goal going down is a cut even when skeletal muscle is linked to the same
    strand; a skeletal muscle goal going up (and no fat-down goal) is grow.
    Goals outside the earliest selected phase are not read while that phase
    has one. No goal with a metric: the linked metrics decide, as before.
    (None, None) when nothing says."""
    rows = [(m, (d or "up")) for m, d in _q(
        db, "SELECT metric, target_dir FROM ledger_goal WHERE "
            "status='active' AND metric IS NOT NULL ORDER BY id")]
    metrics = active_goal_metrics(db)
    current = [r for r in rows if r[0] in metrics] or rows
    for m in CUT_METRICS:
        if (m, "down") in current:
            return "cut", m
    if (GROW_METRIC, "up") in current:
        return "grow", GROW_METRIC
    if current:
        return None, None
    if GROW_METRIC in metrics:
        return "grow", GROW_METRIC
    for m in CUT_METRICS:
        if m in metrics:
            return "cut", m
    return None, None


def cut_phase_metric(db):
    """The metric the current phase reduces, or None outside a cut."""
    phase, metric = goal_phase(db)
    return metric if phase == "cut" else None


def stage_focus(cx):
    prior = None
    if os.path.exists(cx.program):
        try:
            prior = init_mod()._load_rx().load_yaml(cx.program).get(
                "focus_areas")
        except Exception:                                   # noqa: BLE001
            prior = None
    if prior:
        areas = "·".join(UL.muscle_ko(a, cx.db) for a in prior)
        return pmove(cx, "propose", "focus",
                     say=T("focus_keep", areas=areas,
                           reul=josa(areas, "reul")),
                     choices=[choice("keep", T("c_keep_focus"), True),
                              choice("even", T("c_even")),
                              choice("other", T("c_focus_other"))],
                     answer={"stage": "focus", "payload": {
                         "pick": "keep | even | other",
                         "areas": "on other/keep: list from %s" %
                                  ", ".join(FOCUS_AREAS)}},
                     prior=prior)
    cut = cut_phase_metric(cx.db)
    if cut:
        # A1 fill-and-state: a cut phase settles it (keep the whole body
