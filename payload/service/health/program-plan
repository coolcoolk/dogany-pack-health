            if every and circuit else "복합 서킷이 주 1~2회 세션 끝에 들어 있어요."
            if circuit else "고른 동작이 모든 세션에 들어 있어요."))
    if checks.get("cardio"):
        lines.append(cardio_where(cx.st.get("time_plan"), "done_cardio_moved")
                     or T("done_cardio"))
    if checks.get("health"):
        lines.append("• 건강: 모든 세션에 준비운동과 쿨다운 스트레칭이 있어요.")
