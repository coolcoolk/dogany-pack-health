def session_practice_blocks(cx):
    """Per session: the mobility-flow / power / conditioning-finisher /
    mixed-circuit blocks the chosen picks add (compose_rank.practice_blocks;
    data in the rules). The circuit rides compose_rank.circuit_sessions()."""
    import compose_rank
    chosen = chosen_practices(cx)
    caution = [it.get("site") for it in cx.st.get("safety_items") or []]
    rot = cx.st["structure"]["rotation"]
    circuit = set(compose_rank.circuit_sessions(rot, weekly_days(cx)))
    facilities = (cx.st.get("place") or {}).get("facilities") or []
    return {code: compose_rank.practice_blocks(
                chosen, cx.st["prep"][code], caution, allowed_equipment(cx),
                facilities=facilities,
                lifts=[ex["name"] for ex in cx.st["compose"][code]],
                circuit=code in circuit,
                loaded=loaded_sites(cx, [ex["name"] for ex in cx.st["compose"][code]],
                                    caution),
                lower=any(lift_region(cx, ex["name"]) == "legs"
                          for ex in cx.st["compose"][code]))
            for code in rot}


def fit_prep_block(cx):
    """Trainer fit: the mat prep and the flow are one warm-up of at most
    budget.prep_block_max drills (owner 2026-10-06 21:04). The prep's
    general fill leaves first, last-added first; a caution site's drills
    and the flow's drills stay (E-PREP-SITE, the flow checks)."""
    if not cx.st.get("trainer_fit"):
        return
    cap = _compose_rules()["budget"]["prep_block_max"]
    for code, keys in (cx.st.get("prep") or {}).items():
        flow = ((((cx.st.get("practice_blocks") or {}).get(code) or {})
                 .get("flow") or {}).get("drills") or [])
        names = [ex["name"] for ex in (cx.st.get("compose") or {}).get(code) or []]
        site = {k for s, lift in caution_lifts(cx, names) if lift
                for k in site_drills(cx, s)}
        keys = list(keys)
        while len(MC.distinct_drills(keys + flow)) > cap:
            fill = [k for k in keys if k not in site and k not in flow]
            if not fill or len(keys) <= 1:
                break
            keys.remove(fill[-1])
        cx.st["prep"][code] = keys


def shoulder_cuff_week(cx):
    """A shoulder caution's one external-rotation / lower-trapezius movement
    a week (rules shoulder_caution cuff_drills, kimwog 070): when no
    session's prep holds a cuff drill, the first session (rotation order)
    whose lifts load the shoulder takes the first usable one -- in a free
    prep slot, else in place of the last general fill drill (never a site
    drill or the flow's); no room, no drill. A triaged rung is the
    pain-triage skill's, not this rule's."""
    import caution_care
    spec = _compose_rules().get("shoulder_caution") or {}
    profiles = care_profiles(cx)
    sites = [s for s in spec.get("sites", ())
             if s in profiles and not caution_care.intensity(profiles[s]).get("triage")]
    prep = cx.st.get("prep") or {}
    cuff = list(spec.get("cuff_drills", ()))
    if not sites or not prep or any(set(cuff) & set(keys) for keys in prep.values()):
        return
    pick = next((k for k in cuff if drill_usable(cx, k)), None)
    if pick is None:
        return
    budget = _compose_rules()["budget"]
    for code in cx.st["structure"]["rotation"]:
        names = [ex["name"] for ex in (cx.st.get("compose") or {}).get(code) or []]
        if not loaded_sites(cx, names, sites):
            continue
        keys = list(prep.get(code) or [])
        flow = ((((cx.st.get("practice_blocks") or {}).get(code) or {})
                 .get("flow") or {}).get("drills") or [])
        cap = (budget["prep_block_max"] if cx.st.get("trainer_fit")
               else budget["max_prep"])
        room = len(MC.distinct_drills(keys + flow)) < cap and len(keys) < budget["max_prep"]
        if not room:
            site = {k for s, lift in caution_lifts(cx, names) if lift
                    for k in site_drills(cx, s)}
            fill = [k for k in keys if k not in site and k not in flow]
            if not fill:
                return
            keys.remove(fill[-1])
        keys.append(pick)
        cx.st["prep"][code] = keys
        return


def fill_chosen_practices(cx):
    chosen = chosen_practices(cx)
    import compose_rank
    ranked = compose_rank.for_context(cx, candidates(cx), globals())
    for code, items in cx.st["compose"].items():
        allowed = {c["name"] for slot in ranked["sessions"][code]
                   for c in slot["shortlist"]}
        names = {ex["name"] for ex in items}
        for practice in ("unilateral", "core"):
            if practice not in chosen:
                continue
            if any(has_practice(cx, n, practice) for n in names):
                continue
            options = list(PRACTICE_LIFTS.get(practice, ())) + [
                (name, UL.exercise_ko(name)) for name in sorted(allowed)
                if has_practice(cx, name, practice)]
            for name, display in options:
                if name in allowed and name not in names:
                    items.append({"name": name, "display": display})
                    names.add(name)
                    break


def lone_regions(cx, days):
    """Regions a four-session rotation brings back less than twice a week
    (the self-check's "every region twice a week"); compose_draft repairs a
    draft against the same rule before offering it."""
    rot = cx.st["structure"]["rotation"]
    if len(rot) != 4:
        return []
    hits = {}
    for code in rot:
        for region in {lift_region(cx, ex["name"]) for ex in days.get(code) or []} - {None, "core"}:
            hits[region] = hits.get(region, 0) + 1
    weekly = len((cx.st.get("days") or {}).get("weekdays") or [])
    return sorted(r for r, n in hits.items() if n * weekly < 2 * len(rot))


def self_check(cx):
    """Record only checks actually made; the closing copy reads this record."""
    fd = final_days(cx)
    rot = cx.st["structure"]["rotation"]
    audit = None
    try:
        audit = run_audit(cx, answers_doc(cx, fd))
    except Exception as e:  # audit may be unavailable in an older kit
        cx.st["volume_error"] = str(e)[-300:]
    out = {}
    if audit is not None:
        # a floor the session minutes cannot hold was recorded as a soft
        # shortfall at accept (accept_compose): None -- not met, so never
        # claimed, but not a failed check that sends the build back
        soft = {s_["muscle"] for s_ in cx.st.get("volume_shortfall") or []}
        viol = dose_violations(audit)
        hard = [m for m, e in viol if not (
            m in soft and e["proposed_weekly_sets"] < e["band"]["floor"])]
        lone = lone_regions(cx, fd)
        out["goal"] = (False if hard or lone
                       else None if viol else True)
        # what failed, for the loop guard (_stage_sessions)
        cx.st["self_check_lone"] = [] if hard else lone
    out["caution"] = all(
        not (ex.get("replaces") and ex["replaces"] in
             {x["name"] for x in fd[code]})
        and not (ex.get("replaces") and
                 loads_caution_area(cx, ex["name"]))
        for code in rot for ex in fd[code])
    out["spacing"] = (None if (cx.st.get("spacing") or {}).get("skipped")
                      else not (cx.st.get("spacing") or {}).get("left"))
    if cx.st.get("cardio"):
        out["cardio"] = cx.st["cardio"].get("minutes", 0) >= 10
    chosen = chosen_practices(cx)
    blocks = cx.st.get("practice_blocks") or {}
    out["practice"] = all(
        all(any(has_practice(cx, ex["name"], p) for ex in fd[code]) for code in rot
            if p != "core" or core_expected(_compose_rules(), code))
        for p in chosen if p in ("core", "unilateral")
    ) and not compose_rank_errors_for_blocks(chosen, {c: blocks.get(c) for c in rot},
                                             weekly_days(cx))
    out["health"] = all(cx.st.get("prep", {}).get(c) and
                        cx.st.get("cooldown", {}).get(c) for c in rot)
    cx.st["self_check"] = out
    cx.save()
    return out


