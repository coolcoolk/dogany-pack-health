def health_link_apply(cx, pick):
    """yes: the passes on first (a pass skips an unapproved kind), then the
    consent -- a refused consent turns the passes off again, nothing is
    recorded and the step stays open. no: no consent, no schedule. Either
    answer lands as config health_link=linked|declined (+ the day): the
    close-out offer and the recalibration's second offer read it."""
    st = cx.st
    if pick == "yes" and cx.side_effects:
        ctl = routine_ctl_path()
        on = []
        try:
            for rid, script, at in HK_PASSES:
                r = subprocess.run(["bash", ctl, "enable", rid, script, at],
                                   capture_output=True, text=True,
                                   cwd=PROJECT_ROOT, timeout=120)
                if r.returncode:
                    raise Refused("E-RECORDS\troutine\t%s rc=%d %s" % (
                        rid, r.returncode, (r.stderr or "")[-200:]))
                on.append(rid)
            hook = (os.environ.get("HK_INGEST_HOOK")
                    or os.path.join(HERE, "hk-ingest"))
            r = subprocess.run([hook, "consent"] + list(RECORD_KINDS),
                               capture_output=True, text=True, timeout=120)
            if r.returncode:
                raise Refused("E-RECORDS\thook\t" + (r.stderr or "")[-300:])
        except Refused:
            for rid in on:
                subprocess.run(["bash", ctl, "disable", rid],
                               capture_output=True, text=True,
                               cwd=PROJECT_ROOT, timeout=120)
            raise
        st["records_passes"] = [rid for rid, _s, _a in HK_PASSES]
    elif pick == "yes":
        st["records_side_effects"] = "skipped"
    if cx.side_effects:
        rc, _o, e = kit(["config-set", "health_link=%s" % (
            "linked" if pick == "yes" else "declined"),
            "health_link_on=%s" % cx.today.isoformat()])
        if rc not in (0, None):
            st.setdefault("kit_errors", []).append(
                "config-set health_link: %s" % (e or "").strip()[-200:])


