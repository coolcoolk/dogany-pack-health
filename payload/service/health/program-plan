def do_write(cx, fd, force=False):
    doc = answers_doc(cx, fd)
    fd_, tmp = tempfile.mkstemp(prefix=".program-plan-answers-",
                                suffix=".json")
    with os.fdopen(fd_, "w", encoding="utf-8") as f:
        json.dump(doc, f, ensure_ascii=False)
    try:
        cmd = [sys.executable, INIT_PATH, "write", "--answers", "@" + tmp,
               "--db", cx.db, "--program", cx.program]
        if force:
            cmd.append("--force")
        r = subprocess.run(cmd, capture_output=True, text=True)
    finally:
        os.unlink(tmp)
    return r.returncode, r.stdout, r.stderr


def prep_file_text(cx):
    """prep.yaml for the first program: the drills the compose named (display
    from the display layer, every one a mat drill; stretches timed
    cooldown) and each session's prep / cooldown lists, in order. Same
    schema as sot/prep.TEMPLATE.yaml; the pack supplies each drill's dose and
    a short physical instruction."""
    rot = cx.st["structure"]["rotation"]
    # A mobility-flow pick opens the mat prep with its flow drills.
    flows = {code: (((cx.st.get("practice_blocks") or {}).get(code) or {})
                    .get("flow") or {}).get("drills") or [] for code in rot}
    lists = {"prep": {c: flows[c] + cx.st["prep"][c] for c in rot},
             "cooldown": cx.st["cooldown"]}
    keys = []
    for code in rot:
        for k in lists["prep"][code] + cx.st["cooldown"][code]:
            if k not in keys:
                keys.append(k)
    out = ["# prep.yaml -- written by program-plan with the first program "
           "(%s)." % cx.today.isoformat(),
           "# The user's own data from here on: no install and no later "
           "program-plan run overwrites it.",
           "drills:"]
    for k in keys:
        out += ["  %s:" % k, '    name: "%s"' % k,
                '    display: "%s"' % MC.MOVEMENTS[k]['ko'], "    zone: mat"]
        cue = MC.MOVEMENTS[k]['how']
        out += ['    howto: "%s"' % cue]
        if PREP_DRILLS[k]["slot"] == "cooldown":
            out.append("    timing: cooldown")
    out.append("days:")
    for code in rot:
        out.append("  %s:" % code)
        for block in ("prep", "cooldown"):
            out.append("    %s:" % block)
            for k in lists[block][code]:
                dose = MC.MOVEMENTS[k]['dose']
                number = int(re.search(r'\d+', dose).group())
                out.append('      - code: %s' % k)
                if '초' in dose:
                    out.append('        target_reps: 1')
                    out.append('        target_unit: hold_sets')
                    out.append('        hold_sec: %d' % number)
                else:
                    out.append('        target_reps: %d' % number)
                    out.append('        target_unit: %s' %
                               ('per_side' if '좌우' in dose else 'reps'))
    return "\n".join(out) + "\n"




def write_prep_file(cx):
    """Write prep.yaml beside the program when there is none (the mat-prep
    and cooldown slots become what session-open and the morning card read).
    An existing prep.yaml is the user's data and is never touched."""
    path = os.path.join(os.path.dirname(os.path.abspath(cx.program)),
                        "prep.yaml")
    if os.path.exists(path):
        cx.st["prep_file"] = "kept"
        return
    text = prep_file_text(cx)
    rx = init_mod()._load_rx()
    problems = rx.validate_prep(rx._parse_yaml_lines(
        text.splitlines(True)))
    if problems:
        cx.st["prep_file"] = "refused"
        cx.st.setdefault("kit_errors", []).append(
            "prep.yaml: %s" % "; ".join(problems)[-300:])
        return
    fd_, tmp = tempfile.mkstemp(prefix=".prep-", dir=os.path.dirname(path))
    with os.fdopen(fd_, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)
    cx.st["prep_file"] = "written"


def _minutes(start, end):
    h1, m1 = (int(x) for x in start.split(":"))
    h2, m2 = (int(x) for x in end.split(":"))
    return (h2 * 60 + m2) - (h1 * 60 + m1)


def replaced_routines(cx):
    """All active health routines retired when the user changes training time.

    The kit retains past occurrences. Keep links existing rows without adding
    another copy of the same schedule.
    """
    if cx.st.get("calendar_existing_answered") == "keep":
        return []
    owner = owning_agent_hint()
    return (calendar_routines(cx.db, "exercise") +
            calendar_routines(cx.db, "measure"))



def measure_routine_args(cx):
    """`routine add` args for the measure day, or None (no weekly slot)."""
    m = cx.st.get("measure") or {}
    if m.get("status") != "set" or m.get("cadence") != "weekly" or \
            not m.get("weekday"):
        return None
    start = None
    for w in (cx.st.get("daytime") or {}).get("windows") or ():
        if m["weekday"] in w["weekdays"]:
            start = w.get("start")
    args = ["routine", "add", "인바디", "W:" + m["weekday"]]
    if start:
        args += ["time=%s" % start, "duration=10"]
    horizon = handoff(cx).get("horizon")
