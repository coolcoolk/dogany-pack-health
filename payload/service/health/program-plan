# The brief / retro standard (owner 2026-10-02 08:23-08:27). The consult's
# wrap switches the health agent's morning brief, daily retro and weekly
# retro on -- never a separate setup menu, never a question: the wrap STATES
# the times in one line (the kit's SAY line) and the owner changes them only
# if they want to. The morning goes BRIEF_LEAD_MIN before the earliest start
# among the regular training windows just agreed (owner trains 05:00 -> 04:30;
# the optional supplementary days are "if time allows", not a start). The
# daily / weekly clocks are the kit's default: the leader's own day-close
# time (no offsets, CORRECTION 08:28). The kit verb does the switching
# (kit_life 2.38.0 routines/bundle/brief-standard.sh activate); this pack
# only hands it the morning time.
BRIEF_LEAD_MIN = 30


def brief_standard_path():
    return (os.environ.get("BRIEF_STANDARD_SH")
            or os.path.join(PROJECT_ROOT, "routines", "bundle",
                            "brief-standard.sh"))


def brief_morning_time(cx):
    """HH:MM, BRIEF_LEAD_MIN before the earliest regular window start; None
    when no window carries a time (a time is never picked for the user)."""
    starts = sorted(w["start"] for w in
                    (cx.st.get("daytime") or {}).get("windows") or ()
                    if w.get("start"))
    if not starts:
        return None
    h, m = (int(x) for x in starts[0].split(":"))
    x = (h * 60 + m - BRIEF_LEAD_MIN) % (24 * 60)
    return "%02d:%02d" % (x // 60, x % 60)


def activate_brief(cx):
    """Switch the three slots on through the kit; the result (and the one
    line the wrap says) goes to the state. Exit 3 is the kit / framework
    refusing (too old, nothing changed): its SAY line is said and the wrap
    continues. Any other failure is recorded, not said."""
    morning = brief_morning_time(cx)
    if not morning:
        return {"status": "no_time"}
    path = brief_standard_path()
    if not os.path.isfile(path):
        return {"status": "absent", "morning": morning}
    try:
        r = subprocess.run(["bash", path, "activate", "--morning", morning],
                           capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.SubprocessError) as e:
        cx.st.setdefault("kit_errors", []).append("brief-standard: %s" % e)
        return {"status": "error", "morning": morning}
    say = next((ln.split("\t", 1)[1].strip() for ln in r.stdout.splitlines()
                if ln.startswith("SAY\t")), "")
    status = {0: "on", 3: "refused"}.get(r.returncode, "error")
    if status == "error":
        cx.st.setdefault("kit_errors", []).append(
            "brief-standard rc=%s: %s" % (r.returncode,
                                          (r.stdout + r.stderr).strip()[-200:]))
    return {"status": status, "morning": morning, "rc": r.returncode,
            "say": say if status != "error" else ""}


def finish(cx):
    """After the program is written: kit bookkeeping, the calendar, the
    brief / retro switch-on and the prep file, then the one closing
    message."""
    today = cx.today.isoformat()
    if cx.side_effects:
        cur = config_value(cx.db, "consult_modules")
        rc, _o, e = kit(["config-set", "consult_modules=%s"
                         % merge_modules(cur, today)])
        if rc != 0:
            cx.st.setdefault("kit_errors", []).append(
                "config-set: %s" % (e or "").strip()[-200:])
        cx.st["calendar"] = register_calendar(cx)
        cx.st["brief_standard"] = activate_brief(cx)
    else:
        # a replay: the kit's DB and calendar are the instance's, whatever
        # --db says (kit_life.sh binds its own database/kit_life.db)
        cx.st["calendar"] = False
        cx.st["side_effects"] = "skipped"
    write_prep_file(cx)
    cx.st["written"] = today
    cx.save()
    refresh_workbench(cx)
    return finish_move(cx)


def next_session(cx):
    """(date, weekday, start or None, session code): the first regular day
    after today and the session the queue opens with."""
    days = cx.st["days"]["weekdays"]
    for k in range(1, 8):
        d = cx.today + datetime.timedelta(days=k)
        wd = UL.WEEKDAY_ORDER[d.weekday()]
        if wd in days:
            break
    start = None
    for w in (cx.st.get("daytime") or {}).get("windows") or ():
        if wd in w["weekdays"]:
            start = w.get("start")
    return d, wd, start, cx.st["structure"]["rotation"][0]


def finish_move(cx):
    """The closing message (owner 17:48): the full card, what was done, when
    the first session opens, and the cues every session carries. It asks
    nothing -- the one move that does not end on a decision."""
    d, wd, start, first = next_session(cx)
