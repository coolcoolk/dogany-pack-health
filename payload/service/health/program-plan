def answers_doc(cx, fd, provisional=False):
    """The program-init answers doc. provisional: a lift whose dose is still
    to be asked (a `field`) counts at the rule's set floor, so the volume fit
    can run before that question."""
    doc = {"rotation": list(cx.st["structure"]["rotation"]),
           "weekly_frequency": len(cx.st["days"]["weekdays"]),
           "days": {}}
    if cx.st.get("focus_areas"):
        kept = compose_focus(cx)
        if kept:
            doc["focus_areas"] = kept
    if cx.st.get("care"):
        doc["care"] = care_for_card(cx.st["care"])
    if (cx.st.get("time_plan") or {}).get("pick") == "shrink":
        import compose_rank
        timing = compose_rank.time_budget(cx, _minutes)
        blocks = timing["strength"] - timing["lift_minutes"]
        doc["time_plan"] = dict(cx.st["time_plan"], lift_minutes={
            day: max(0, cap - blocks)
            for day, cap in timing["per_day"].items()})
    for code in doc["rotation"]:
        exs = []
        for ex in fd[code]:
            d, _w = dose(cx, ex["name"])
            if d is None and provisional:
                d = {"sets": RX_RULES["compound"]["sets"],
                     "rep_range": [1, 1], "unit": "reps"}
            slot = {"name": ex["name"], "display": ex["display"],
                    "weight_kg": history_weight(cx.db, ex["name"]),
                    "sets": sets_for(cx, code, ex["name"], d["sets"]),
                    "rep_range": d["rep_range"]}
            if d["unit"] == "sec":
                slot["progression"] = "hold"
            if ex.get("safety_note"):
                slot["safety_note"] = ex["safety_note"]
            exs.append(slot)
        doc["days"][code] = {"exercises": exs}
    return doc


def history_weight(db_path, name):
    """Most recent recorded working load for this exact catalog lift.

    A workout note or a different exercise is not load evidence. Older kit
    databases may have no workout_sets table, in which case calibration is
    explicit in the session flow.
    """
    try:
        conn = sqlite3.connect('file:%s?mode=ro' % db_path, uri=True)
        try:
            row = conn.execute(
                "SELECT s.weight_kg FROM workout_sets s JOIN workouts w "
                "ON w.id=s.session_id WHERE s.exercise_name=? "
                "AND s.set_seq>=1 AND s.weight_kg IS NOT NULL "
                "ORDER BY w.date DESC, s.session_id DESC, s.set_seq DESC "
                "LIMIT 1", (name,)).fetchone()
        finally:
            conn.close()
        return row[0] if row else None
    except sqlite3.Error:
        return None


def run_audit(cx, doc):
    im = init_mod()
    program, _n = im.derive_program(doc, cx.facts())
    rx = im._load_rx()
    return rx.volume_audit(program, cx.db, cx.today.isoformat())


def volume_violations(audit):
    out = []
    for m, e in sorted((audit.get("per_muscle") or {}).items()):
        if e.get("verdict") in ("below_floor", "above_ceiling"):
            out.append((m, e))
    return out


def dose_violations(audit):
    """The PROGRAM's own out-of-band muscles: proposed weekly sets against
    the band. The audit's actual-delivery floor (what the records show) is
    not the new program's to fix and is left to the weekly review."""
    out = []
    for m, e in sorted((audit.get("per_muscle") or {}).items()):
        if e.get("verdict") == "untrained":
            continue
        n, band = e["proposed_weekly_sets"], e["band"]
        if n < band["floor"] or n > band["ceiling"]:
            out.append((m, e))
    return out


def fit_volume(cx, fd):
    """Round-robin +/-1 set on the slots whose PRIMARY muscle is short/over,
    inside [set level, MAX_SETS_FIX] and inside the session's lift minutes
    (a set is never added past the user's session length), re-auditing
    after each step. Returns (set_adjust, still_out_of_band, capped): capped
    = the short muscles held below the floor only by the session minutes."""
    import compose_rank
    mmap = cx.muscle_map()
    base = dict(cx.st.get("set_adjust") or {})
    adjust = dict(base)
    viol = []
    floor_sets = set_level(cx)
    ranked = compose_rank.for_context(cx, candidates(cx), globals())
    rules = compose_rank.load_rules()
    practice_only = compose_rank.practice_only_names(rules)
    credit = compose_rank.muscle_credit_table(rules)

    def fits(code, k, n):
        """True when session `code` with slot k at n sets stays inside the
        lift minutes."""
        allowed = {c["name"]: c for s_ in ranked["sessions"].get(code, [])
                   for c in s_["shortlist"]}
        lifts = [dict(allowed.get(ex["name"], {}),
                      sets=n if "%s/%s" % (code, ex["name"]) == k
                      else adjust.get("%s/%s" % (code, ex["name"]), floor_sets))
                 for ex in fd[code]]
        return compose_rank.session_minutes(lifts, rules) <= \
            ranked["profile"]["lift_minutes"]
    capped = set()
    for _round in range(48):
        cx.st["set_adjust"] = adjust
        viol = dose_violations(run_audit(cx, answers_doc(cx, fd, True)))
        if not viol:
            break
        moved = False
        # the short muscles a set could only be added to past the minutes
        capped = set()
        for m, e in viol:
            step = 1 if e["proposed_weekly_sets"] < e["band"]["floor"] else -1
            for code in cx.st["structure"]["rotation"]:
                for ex in fd[code]:
                    if (m, "primary") not in mmap.get(ex["name"], []):
                        continue
                    if ex["name"] in practice_only:
                        continue    # practice dose, not a band lever
                    if not compose_rank.muscle_credit(credit, ex["name"], True):
                        continue    # not band volume (rx-calc)
                    d, _w = dose(cx, ex["name"])
                    if d is not None and d["unit"] == "sec":
                        continue
                    k = "%s/%s" % (code, ex["name"])
                    cur = adjust.get(k, floor_sets)
                    nxt = cur + step
                    precedent = rules['knee_precedents'].get(ex['name'], {})
                    cap = min(precedent.get('max_sets', MAX_SETS_FIX), max(rules['set_caps'].values()))
                    if not floor_sets <= nxt <= cap:
                        continue
                    if step > 0 and not fits(code, k, nxt):
                        capped.add(m)
                        continue
                    adjust[k] = nxt
                    moved = True
                    break
                if moved:
                    break
            if moved:
                break
        if not moved:
            break
    cx.st["set_adjust"] = base
    return adjust, viol, capped


def practice_line(cx, practice):
    """The practice rows' own ledger, said apart from the muscle sets
    (owner 2026-10-04: a different purpose is not measured in the same
    sets). `practice` = rx-calc's {name: {sessions_per_week, ...}}; None
    when the card has none. Rows the band counts in part (loaded functional
    moves, muscle_sets_per_week > 0) are functional_line's."""
    names = sorted(n for n in practice or {}
                   if not practice[n].get("muscle_sets_per_week"))
    if not names:
        return None
    items = ", ".join(
        UL.i18n("health.plan.practice_volume_item", name=UL.exercise_ko(n),
                n="%g" % practice[n]["sessions_per_week"])
        for n in names)
    return UL.i18n("health.plan.practice_volume", items=items)


def functional_line(cx, practice):
    """The loaded functional moves, said with what the band counts of them
    (owner 2026-10-04 11:21: "kettlebell swing 3 sets = 1.5 muscle sets",
    i18n health.plan.functional_volume_item).
    None when the card has none."""
    names = sorted(n for n in practice or {}
