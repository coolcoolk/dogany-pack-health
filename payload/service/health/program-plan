        cx.st.setdefault("notes", []).append({"text": T(
            "focus_even_cut_stated", what=T("cut_" + cut), when=when),
            "at": None})
        cx.save()
        return None
    why = T("focus_even")
    return pmove(cx, "propose", "focus",
                 say=why + "\n\n" + T("ask_ok"),
                 choices=[choice("even", T("c_even"), True),
                          choice("other", T("c_focus_other"))],
                 answer={"stage": "focus", "payload": {
                     "pick": "even | other",
