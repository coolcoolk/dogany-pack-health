def final_days(cx):
    """The session lifts as the plan will write them (focus lifts of a
    protected area never reach compose: the emphasis decision comes first)."""
    out = {}
    for code in cx.st["structure"]["rotation"]:
        lst = []
        names = {ex["name"] for ex in cx.st["compose"][code]}
        for ex in cx.st["compose"][code]:
            e = {"name": ex["name"], "display": ex["display"]}
            for k in ("replaces", "replaces_display", "for_site", "why",
                      "focus", "spaced"):
                if ex.get(k) is not None:
                    e[k] = ex[k]
            if e.get("replaces") in names:
                e.pop("replaces", None)
                e.pop("replaces_display", None)
            if ex.get("for_site"):
                sites = card_sites_text(cx.st, [
                    it for it in cx.st.get("safety_items") or []
                    if it.get("site") == ex.get("for_site")])
                if e.get("replaces"):
