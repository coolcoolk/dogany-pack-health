def _makeup_type_ids(conn, rotation):
    """session_type ids that are NOT part of the rotation queue -- i.e. makeup
    ('보충') session types. A makeup session must never set the rotation basis:
    by design it does not consume the rotation counter (workout-program 주말
    보충세션 규칙), so it is skipped when finding the last regular weight
    session. rotation None/empty -> no exclusion (backward compatible)."""
    if not rotation:
        return []
    try:
        rows = conn.execute("SELECT id, code FROM session_type").fetchall()
    except sqlite3.OperationalError:
        return []
    return [r[0] for r in rows if r[1] not in rotation]


def get_last_weight_session(db_path, rotation=None, exclude_session_id=None):
    """
    Return (session_type_id, date, provisional) for the most recent REGULAR
    weight workout session in the workouts table.
    Returns (None, None, False) if no weight sessions exist.

    Weight-session identity (DGN-388 fix): a session is a weight session if it
    has >=1 workout_sets row. The pre-DGN-388 version only counted tagged rows
    (WHERE session_type_id IS NOT NULL) yet its docstring promised
    provisional=True for NULL tags -- so a MORE RECENT untagged-but-logged
    weight session was silently skipped and an OLDER tagged session was
    returned as "the last session", producing the wrong next rotation day with
    zero warning (incident: sessions 44/45).

    G1 (2026-08-23): the DGN-388 test was "tagged OR has sets"; the tagged-OR
    half is now dropped. session-open writes session_type_id at ROW BIRTH
    (before a single set exists), so a just-opened 0-set session satisfied
    "tagged" and became the rotation basis -- opening a 뒷B session made the
    basis read 뒷B and the calc serve 앞A (2026-08-20 17:35 slot mismatch).
    A birth tag is an INTENT; only a workout_sets row is evidence that the
    session actually happened. Completion is anchored to that fact.

    Makeup exclusion (session 48 fix): a session tagged with a code that is NOT
    in `rotation` is a makeup ('보충') session. It carries real sets but must
    not set the rotation basis (makeup does not consume the rotation counter),
    so it is skipped here -- the last REGULAR session drives the next slot. An
    untagged-but-logged session is still treated as provisional (44/45 guard):
    once makeup sessions carry a '보충' tag, a NULL tag means a regular session
    was left unclosed, not a makeup. rotation None/empty -> no exclusion.

    Contract honored here:
      - Find the MOST RECENT regular weight session (date/created_at/id DESC).
      - Latest regular weight session is TAGGED   -> (session_type_id, date, False).
      - Latest regular weight session is UNTAGGED  -> (None, date, True); provisional=True
        means rotation position is NOT confirmed (caller must not advance / warn).
      - No weight sessions at all          -> (None, None, False).
    A more-recent untagged (non-makeup) weight session is NEVER silently skipped.
    """
    conn = _db_connect(db_path)
    try:
        makeup_ids = _makeup_type_ids(conn, rotation)
        # Exclude makeup-tagged rows from the rotation basis. NULL tags survive
        # this filter (IS NULL branch) so the 44/45 provisional guard still fires.
        excl = ""
        if makeup_ids:
            placeholders = ",".join("?" * len(makeup_ids))
            excl = (" AND (w.session_type_id IS NULL "
                    "OR w.session_type_id NOT IN (%s))" % placeholders)
        # M-B1 / F14+F20: exclude today's OPEN session so calc_rx does not
        # consume it as "last" (which would advance the rotation one day and
        # drop today's slots -> None planned weight). Bound after makeup_ids.
        excl_id = ""
        bind_ids = list(makeup_ids)
        if exclude_session_id is not None:
            excl_id = " AND w.id != ?"
            bind_ids.append(exclude_session_id)
        # G1: a session qualifies as a weight session ONLY when it carries at
        # least one structured set row. A birth tag alone never qualifies (see
        # docstring). The EXISTS subquery is guarded below for DBs predating
        # the workout_sets table (pre-W02), where the tag is the only evidence
        # that exists at all.
        try:
            row = conn.execute(
                """
                SELECT w.session_type_id, w.date
                FROM workouts w
                WHERE EXISTS (SELECT 1 FROM workout_sets ws
                              WHERE ws.session_id = w.id)
                """ + excl + excl_id + """
                ORDER BY w.date DESC, w.created_at DESC, w.id DESC
                LIMIT 1
                """,
                bind_ids,
            ).fetchone()
        except sqlite3.OperationalError:
            # workout_sets not applied yet -> fall back to tag-only detection.
            row = conn.execute(
                """
                SELECT w.session_type_id, w.date
                FROM workouts w
                WHERE w.session_type_id IS NOT NULL
                """ + excl + excl_id + """
                ORDER BY w.date DESC, w.created_at DESC, w.id DESC
                LIMIT 1
                """,
                bind_ids,
            ).fetchone()

        if not row:
            # No weight sessions at all -- rotation cannot be inferred; let
            # select_rotation_day cold-start at rotation[0] (not provisional).
            return None, None, False

        session_type_id, date = row[0], row[1]
        if session_type_id is not None:
            # Latest weight session is tagged -- rotation position confirmed.
            return session_type_id, date, False
        # Latest weight session has sets but no tag -- rotation position is
        # NOT confirmed. Return provisional=True so the caller warns instead of
        # silently advancing off a stale tagged session.
        return None, date, True
    finally:
        conn.close()


def get_session_type_codes(db_path):
    """Return dict of {id: code} from session_type table."""
    conn = _db_connect(db_path)
    try:
        rows = conn.execute("SELECT id, code FROM session_type").fetchall()
        return {r[0]: r[1] for r in rows}
    except sqlite3.OperationalError:
        return {}
    finally:
        conn.close()


def resolve_session_type_id(db_path, rotation_day_code):
    """
    DGN-303: map a rotation_day code -> session_type_id (INTEGER PK).
    session_type UNIQUE = (routine_id, code); the active weight routine
    (routine.status='active') owns the rotation codes. Returns the id of the
    matching row on the active routine, or None if not resolvable.
    Used to feed session_type_id to get_last_session_result /
    get_last_session_stream (5.2/5.6 require the id, not the code).
    """
    conn = _db_connect(db_path)
    try:
        row = conn.execute(
            """
            SELECT st.id
            FROM session_type st
            JOIN routine r ON r.id = st.routine_id
            WHERE st.code = ?
              AND r.status = 'active'
            ORDER BY r.id DESC
            LIMIT 1
            """,
            (rotation_day_code,),
        ).fetchone()
        if row:
            return row[0]
        # fallback: any session_type with this code (no active routine gate)
        row2 = conn.execute(
            "SELECT id FROM session_type WHERE code = ? ORDER BY id DESC LIMIT 1",
            (rotation_day_code,),
        ).fetchone()
        return row2[0] if row2 else None
    except sqlite3.OperationalError:
        return None
    finally:
        conn.close()


def session_code(db_path, session_id):
    """The session's OWN session_type code: a rotation day key ('앞A', '뒷B')
    for a regular session, '보충' for a makeup one, or None when the session is
    untagged / the row or table is missing.

    resolve_session_type_id()'s inverse, and the single home for a query that
    was copy-pasted into five call sites (set-table.find_day_and_slot,
    set-arm.find_slot / derive_next_spec / resolve_current_arm_data,
    session-cursor.resolve_day). Every one of those wrapped it in an
    `if code in program['days']` guard and DROPPED anything else on the floor
    -- which is precisely how the makeup marker went missing from the pin
    title: the answer was in hand at the render layer and thrown away, because
    '보충' is a session CLASS and never a program day key. Callers that want a
    program day keep their own `in days` guard; callers that want the class
    (the card title) read this raw.

    Never raises: any sqlite error -> None."""
    try:
        conn = _db_connect(db_path)
    except sqlite3.Error:
        return None
    try:
        row = conn.execute(
            "SELECT st.code FROM workouts w "
            "JOIN session_type st ON st.id = w.session_type_id "
            "WHERE w.id = ?",
            (session_id,),
        ).fetchone()
        return row[0] if row and row[0] else None
    except sqlite3.Error:
        return None
    finally:
        conn.close()


def get_last_session_result(db_path, slot_name, session_type_id,
                            exclude_session_id=None, machine=None):
    """
    DGN-303 F3b (design-v3 5.2): most recent top-set (reps, weight_kg) for a
    given exercise slot from the structured workout_sets table.

    match key = session_type_id (INTEGER PK) -- NOT session_type.code. Rationale:
    session_type UNIQUE = (routine_id, code), so code alone is not unique across
    routines (DGN-307 routine-rename dup tolerance). Caller passes
    session_type_id (rx-calc rotation loop maps rotation_day -> session_type_id).

    Returns (reps, weight_kg) of the winning top set, or (None, None) if no
    structured result exists. Tie-break: date DESC -> created_at DESC -> id DESC
    (real data: id 32/33 share created_at), then NULL weight last, then heaviest
    working set, then most reps.

    DGN-735 (F7, 2026-08-13): two contamination guards so this reads the true
    PRIOR working result, matching get_last_session_stream (5.6):
      (1) ws.set_seq > 0 -- working sets ONLY. Ramp/primer/warmup sets
          (set_seq <= 0) must never be read as the top set. Without this, a
          today-logged ramp (e.g. 30kg x5) was selected as "last top set",
          its 5 reps fell within rep_range -> spurious HOLD (40.0 instead of
          the correct 42.5 increment).
      (2) session_id != exclude_session_id -- exclude today's open session so
          the prescription reflects the PRIOR session, never self-references
          today's partial sets (M-B1 discipline). Caller passes its session_id.

    `machine` (kit 062): only the sets logged on that machine (see
    _machine_scope).
    """
    conn = _db_connect(db_path)
    try:
        where = ["ws.exercise_name = ?", "w.session_type_id = ?",
                 "ws.set_seq > 0"]
        params = [slot_name, session_type_id]
        if machine is not None:
            where.append("ws.machine_ref = ?")
            params.append(machine)
        if exclude_session_id is not None:
            where.append("ws.session_id != ?")
            params.append(exclude_session_id)
        row = conn.execute(
            "SELECT ws.reps, ws.weight_kg "
            "FROM workout_sets ws "
            "JOIN workouts w ON w.id = ws.session_id "
            "WHERE " + " AND ".join(where) + " "
            "ORDER BY w.date DESC, w.created_at DESC, w.id DESC, "
            "(ws.weight_kg IS NULL), ws.weight_kg DESC, ws.reps DESC "
            "LIMIT 1",
            params,
        ).fetchone()
        return (row[0], row[1]) if row else (None, None)
    except sqlite3.OperationalError:
        # workout_sets not applied yet (pre-W02) -> no data = no change.
        return None, None
    finally:
        conn.close()


# ---------------------------------------------------------------------------
# PROGRAM STATE STEP A (2026-09-30): the per-slot state program.yaml used to
# carry -- weight_kg as the progression base, miss_streak -- is COMPUTED from
# workout_sets, never stored. Nothing wrote either field after program-init
# (the old POST_SESSION write-back was the retired agent hand-editing the
# file), so on a fresh install every lift stayed in calibration for sessions
# 2 and 3, holds / assisted slots never left it, a seeded slot progressed from
# its seed forever, and miss_streak was always 0 so a deload could not fire.
# ---------------------------------------------------------------------------

def _working_top_sets(db_path, name, session_type_id=None,
                      exclude_session_id=None, limit=None, machine=None):
    """[(session_id, reps, weight_kg)] newest session first: the TOP working
    set (set_seq > 0) of each session of this exercise, optionally on one
    session_type. Same ordering get_last_session_result uses (date, created_at,
    id DESC; NULL weight last, heaviest, most reps). `machine`: only the sets
    logged on that machine (kit 062). Unreadable -> []."""
    where = ["ws.exercise_name = ?", "ws.set_seq > 0"]
    params = [name]
    if machine is not None:
        where.append("ws.machine_ref = ?")
        params.append(machine)
    if session_type_id is not None:
        where.append("w.session_type_id = ?")
        params.append(session_type_id)
    if exclude_session_id is not None:
        where.append("ws.session_id != ?")
        params.append(exclude_session_id)
    try:
        conn = _db_connect(db_path)
    except sqlite3.Error:
        return []
    try:
        rows = conn.execute(
            "SELECT ws.session_id, ws.reps, ws.weight_kg "
            "FROM workout_sets ws JOIN workouts w ON w.id = ws.session_id "
            "WHERE " + " AND ".join(where) + " "
            "ORDER BY w.date DESC, w.created_at DESC, w.id DESC, "
            "(ws.weight_kg IS NULL), ws.weight_kg DESC, ws.reps DESC",
            params).fetchall()
    except sqlite3.OperationalError:
        return []
    finally:
        conn.close()
    out, seen = [], set()
    for sid, reps, w in rows:
        if sid in seen:
            continue
        seen.add(sid)
        out.append((sid, reps, w))
        if limit and len(out) >= limit:
            break
    return out


def resolve_base_weight(db_path, name, session_type_id, exclude_session_id=None,
                        seed=None, machine=None):
    """(base_kg, source) -- the load the progression arithmetic starts from.

      1. the last LOGGED working load of this exercise on this session type
         (source 'logged');
      2. else its last logged working load on any day (source 'logged_any' --
         the same evidence program-plan.history_weight reads);
      3. else the slot's seed, the owner-declared starting weight, which is
         read ONLY while no working load was ever logged (source 'seed');
      4. else (None, 'none') -> calibration.

    A top set with no weight (a calibration set logged reps-only) is not load
    evidence; the next rung down answers. `machine`: rungs 1-2 read only the
    sets logged on that machine (kit 062)."""
    for stid in ((session_type_id, None) if session_type_id is not None
                 else (None,)):
        for _sid, _reps, w in _working_top_sets(
                db_path, name, stid, exclude_session_id, machine=machine):
            if w is not None:
                return float(w), ('logged' if stid is not None
                                  else 'logged_any')
    if seed is not None:
        return seed, 'seed'
    return None, 'none'


def derive_miss_streak(db_path, name, session_type_id, rep_range,
                       exclude_session_id=None, machine=None):
    """Consecutive most-recent sessions (this exercise, this session type)
    whose top working set fell below rep_range's floor AT THE SAME LOAD as the
    newest one. A load change (a deload, more assist) ends the run, so the
    streak resets naturally. No history / no floor -> 0."""
    try:
        lo = int(rep_range[0])
    except (TypeError, ValueError, IndexError, KeyError):
        return 0
    streak, load = 0, None
    for i, (_sid, reps, w) in enumerate(_working_top_sets(
            db_path, name, session_type_id, exclude_session_id,
            machine=machine)):
        if i == 0:
            load = w
        elif w != load:
            break
        if reps is None or reps >= lo:
            break
        streak += 1
    return streak


# ---------------------------------------------------------------------------
# PER MACHINE (ticket 2026-09-30 per-machine cable lattice, kit 062). Once the
# lift's machine is CONFIRMED (machine_capture.confirmed_machine: chosen this
# session, or the machine of the newest logged set), its load reads only the
# sets logged on THAT machine: base, last result, miss streak and the e1RM
# (e1rm_rx.machine_estimate). Two stacks, two histories.
#   state 'own'        the machine has a logged working set before today.
#   state 'calibrate'  it has none: today is its calibration. The pooled last
#                      load (unattributed history, other machines) is only the
#                      SEED of the check set -- no progression step is taken
#                      on it, no miss streak carried, and rx_basis says so.
# Unconfirmed (no pick, only a static binding), a free-weight lift, a pre-062
# DB, or rules machine.enabled false -> None: the pooled history as before.
# ---------------------------------------------------------------------------

def _machine_scope(db_path, name, session_id):
    """(ulid, state) per the block above, or (None, None)."""
    if _E1 is not None and not _E1.machine_rules().get('enabled'):
        return None, None
    mc = _machine_capture()
    if mc is None:
        return None, None
    try:
        ulid = mc.confirmed_machine(db_path, session_id, name)
    except Exception:  # noqa: BLE001 -- a scope miss never breaks rx
        return None, None
    if not ulid:
        return None, None
    own = _working_top_sets(db_path, name, None, session_id, limit=1,
                            machine=ulid)
    return ulid, ('own' if own else 'calibrate')


# ---------------------------------------------------------------------------
# DGN-303 design-v3 5.6: get_last_session_stream -- WARG strategy B companion.
# Aggregates the PRIOR session's set stream for one exercise/session_type.
# M-B1 (design-v3 14): exclude_session_id excludes today's session so the
# volume arm compares against the TRUE prior session, never self-references.
# F-B2 (design-v3 14): volume + last-working-set are working-sets-only
# (set_seq >= 1 AND weight_kg IS NOT NULL) so neither a ramp/warm-up set nor a
# calibration set distorts the prior volume.
# ---------------------------------------------------------------------------

def get_last_session_stream(db_path, slot_name, session_type_id,
                            exclude_session_id=None):
    """
    WARG B (design-v3 5.6): prior (before-today) same-exercise/same-
    session_type stream aggregate.
    returns {volume_load, top_reps, top_w, last_set_reps, set_count} or None.
    match key = session_type_id (INTEGER PK; same rationale as 5.2).
    exclude_session_id (M-B1): when set, `AND ws.session_id != ?` excludes
    today's just-stored session from the "prior" search.
    Two steps: (1) resolve prior session id, (2) aggregate that session's
    working sets for this exercise. No prior -> None (B degrades to top-set).
    """
    conn = _db_connect(db_path)
    try:
        # (1) resolve the prior session id (today excluded via M-B1 filter).
        if exclude_session_id is not None:
            sid = conn.execute(
                """
                SELECT ws.session_id
                FROM workout_sets ws
                JOIN workouts w ON w.id = ws.session_id
                WHERE ws.exercise_name = ?
                  AND w.session_type_id = ?
                  AND ws.session_id != ?
                ORDER BY w.date DESC, w.created_at DESC, w.id DESC
                LIMIT 1
                """,
                (slot_name, session_type_id, exclude_session_id),
            ).fetchone()
        else:
            sid = conn.execute(
                """
                SELECT ws.session_id
                FROM workout_sets ws
                JOIN workouts w ON w.id = ws.session_id
                WHERE ws.exercise_name = ?
                  AND w.session_type_id = ?
                ORDER BY w.date DESC, w.created_at DESC, w.id DESC
                LIMIT 1
                """,
                (slot_name, session_type_id),
            ).fetchone()
        if not sid:
            return None
        session_id = sid[0]

        # (2) aggregate that session's WORKING sets. TWO independent guards --
        # they drop different rows and BOTH are required:
        #   - set_seq >= 1 : working sets only. Ramp/warm-up sets (set_seq <= 0)
        #     are prescribed at RIR 4+ (ax_engine RAMP_RIR; measured live avg RIR
        #     3.89 vs 1.33 for working sets), i.e. nowhere near failure, so they
        #     are not a legitimate volume unit (kimwog exercise/set-counting-
        #     volume-unit-009, grade B, Baz-Valle 2021). A WEIGHTED ramp (40kg x4,
        #     60kg x2) passes the NULL check below, so only this clause removes it.
        #   - weight_kg IS NOT NULL : drops empty-bar / calibration rows.
        # Matches get_last_session_result (5.2) and exercise-enter's volume query.
        # ASSIST INVERSION (assist_load): on an assist stack weight_kg is the
        # counterweight, so the volume sum needs (bodyweight - counterweight)
        # and top_w must take the LOWEST stack number (the hardest set), not
        # the highest. Both expressions degrade to the original SQL text when
        # this DB carries no assist taxonomy.
        _ctx = _assist_ctx(db_path)
        _assisted = bool(_ctx and _ctx.is_assisted(slot_name))
        if _AL is not None:
            _vol_expr = _AL.volume_sql(db_path, "workout_sets")
            _topw_expr = _AL.top_weight_sql(db_path, "workout_sets",
                                            assisted=_assisted)
        else:
            _vol_expr = "COALESCE(workout_sets.weight_kg, 0) * workout_sets.reps"
            _topw_expr = "MAX(COALESCE(workout_sets.weight_kg, 0))"
        agg = conn.execute(
            """
            SELECT
                SUM(%s)                              AS volume_load,
                MAX(reps)                            AS top_reps,
                %s                                   AS top_w,
                COUNT(*)                             AS set_count
            FROM workout_sets
            WHERE session_id = ? AND exercise_name = ?
              AND set_seq >= 1
              AND weight_kg IS NOT NULL
            """ % (_vol_expr, _topw_expr),
            (session_id, slot_name),
        ).fetchone()
        # last working set reps: highest set_seq among weighted WORKING sets
        # (m-B1: set_seq is the canonical order, robust to F3a correction
        # reordering). Ramps sort below seq 1 so they could never win here, but
        # the guard is kept explicit so this row set matches the aggregate above.
        last = conn.execute(
            """
            SELECT reps FROM workout_sets
            WHERE session_id = ? AND exercise_name = ?
              AND set_seq >= 1 AND weight_kg IS NOT NULL
            ORDER BY set_seq DESC LIMIT 1
            """,
            (session_id, slot_name),
        ).fetchone()
        return {
            'volume_load':   agg[0] or 0,
            'top_reps':      agg[1],
            'top_w':         agg[2],
            'last_set_reps': last[0] if last else 0,
            'set_count':     agg[3] or 0,
        }
    except sqlite3.OperationalError:
        return None
    finally:
        conn.close()


def check_trip_today(db_path, today):
    """
    Return True if there is an all_day trip-class event today (M5).
    Checks the events table for events where:
      - all_day = 1 (or true)
      - trip class (event_class or category contains 'trip' or 'travel')
      - the event spans today (start_date <= today <= end_date or date == today)
    Returns False on any table/column error (safe default = no suppression).
    """
    conn = _db_connect(db_path)
    try:
        # Probe table structure
        cols_rows = conn.execute("PRAGMA table_info(events)").fetchall()
        col_names = {r[1] for r in cols_rows}
        if not col_names:
            return False

        # Build a query that checks for trip-class all-day events
        # The spec says "all_day trip-class event containing today"
        # Column names observed in a live instance: date, all_day, title, event_class, status
        if 'event_class' in col_names and 'all_day' in col_names:
            rows = conn.execute(
                """
                SELECT id FROM events
                WHERE all_day = 1
                  AND LOWER(event_class) LIKE '%trip%'
                  AND date = ?
                  AND (status IS NULL OR status != 'cancelled')
                LIMIT 1
                """,
                (today,)
            ).fetchall()
            return len(rows) > 0
        elif 'all_day' in col_names:
            rows = conn.execute(
                """
                SELECT id FROM events
                WHERE all_day = 1
                  AND (LOWER(title) LIKE '%trip%' OR LOWER(title) LIKE '%travel%'
                       OR LOWER(title) LIKE '%여행%')
                  AND date = ?
                  AND (status IS NULL OR status != 'cancelled')
                LIMIT 1
                """,
                (today,)
            ).fetchall()
            return len(rows) > 0
        return False
    except sqlite3.OperationalError:
        return False
    finally:
        conn.close()


def check_workout_event_today(db_path, today):
    """
    Return True if there is an open timed '운동 -- ' prefixed event today.
    Used by rx-gen.sh; rx-calc just exposes this check.
    """
    conn = _db_connect(db_path)
    try:
        rows = conn.execute(
            """
            SELECT id FROM events
            WHERE date = ?
              AND (all_day IS NULL OR all_day = 0)
              AND LOWER(title) LIKE '운동 -- %'
              AND (status IS NULL OR status = 'open')
            LIMIT 1
            """,
            (today,)
        ).fetchall()
        return len(rows) > 0
    except sqlite3.OperationalError:
        return False
    finally:
        conn.close()


