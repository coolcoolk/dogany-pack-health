# ---- DGN-316 3.3: proposed weekly sets per muscle (program arithmetic) ----

def proposed_sets(program, muscle_map, vocab=None):
    """Proposed weekly effective sets per muscle from a program.yaml dict.
    proposed(m) = SUM(slot sets * role_weight * F/R). Unmapped program
    exercises count toward NO muscle -- never guessed -- and are returned in
    unmapped_program. Returns (per_muscle, unmapped_program, freq, freq_defaulted).

    VOLUME GUARD (2026-08-22): reads the day through day_work_items(), the one
    volume-eligible collection. Prep and cooldown are peer blocks in the day
    schema but are `volume: false` and live in prep.yaml, which this function
    never opens -- so a drill cannot reach a weekly prescription number.
    `vocab` = the DB's muscle vocabulary (muscle_vocab); None -> fallback."""
    out = {m: 0.0 for m in (vocab or MUSCLE_VOCAB)}
    unmapped = []
    rotation = program.get('rotation') or []
    freq, defaulted = program_weekly_frequency(program)
    factor = (freq / len(rotation)) if rotation else 1.0
    for day in rotation:
        for ex, credit in volume_work_items(program, day):
            name = ex.get('name', '')
            sets = ex.get('sets', 3) * credit
            pairs = muscle_map.get(name)
            if not pairs:
                if name and name not in unmapped:
                    unmapped.append(name)
                continue
            for muscle, role in pairs:
                if muscle not in out:
                    continue
                w = 1.0 if role == 'primary' else MUSCLE_SET_WEIGHT_SECONDARY
                out[muscle] += sets * w * factor
    return out, unmapped, freq, defaulted


def programmed_muscles(program, muscle_map):
    """Muscles that appear as PRIMARY in >= 1 program slot (floor scope,
    spec 4.3). Work block only -- see day_work_items()."""
    prog = set()
    rotation = program.get('rotation') or []
    for day in rotation:
        for ex, _credit in volume_work_items(program, day):
            for muscle, role in muscle_map.get(ex.get('name', ''), []):
                if role == 'primary':
                    prog.add(muscle)
    return prog


# ---- DGN-316 3.4: per-muscle per-set volume-load (fatigue input) ----

def muscle_session_stats(db_path, session_id, muscle, muscle_map):
    """(wsets, muscle_vol, per_set_vol) for one logged session and muscle,
    over PRIMARY exercises only, working sets only (set_seq >= 1 AND
    weight_kg IS NOT NULL). per_set_vol is None when wsets == 0 (guards in 5.1).

    set_seq >= 1 excludes ramp/warm-up sets: they are prescribed at RIR 4+
    (ax_engine RAMP_RIR) so they are not a volume unit, and -- because this
    returns a PER-SET average -- a variable number of light ramps between the
    K / K' sessions compared in 5.1 S2 would move per_set_vol on its own and
    fire (or mask) a performance-drop signal that never happened."""
    primaries = {name for name, pairs in muscle_map.items()
                 for (m, role) in pairs if m == muscle and role == 'primary'}
    if not primaries:
        return 0, 0.0, None
    conn = _db_connect(db_path)
    try:
        rows = conn.execute(
            "SELECT exercise_name, weight_kg, reps FROM workout_sets "
            "WHERE session_id = ? AND set_seq >= 1 AND weight_kg IS NOT NULL",
            (session_id,),
        ).fetchall()
    except sqlite3.OperationalError:
        return 0, 0.0, None
    finally:
        conn.close()
    # ASSIST INVERSION: an assisted set's volume unit is
    # (bodyweight - counterweight) x reps, not stack x reps. ctx is None on a
    # DB with no assist taxonomy -> effective_load is the identity.
    ctx = _assist_ctx(db_path)
    date = ctx.session_date(session_id) if ctx else None
    wsets = 0
    vol = 0.0
    for name, weight, reps in rows:
        if name in primaries:
            wsets += 1
            if _AL is None:
                vol += weight * reps
            else:
                unit = _AL.set_volume(ctx, name, weight, reps, date)
                # None = unmeasurable assisted set (no bodyweight reading at
                # all). It still counted as a working SET; it just cannot
                # contribute a volume number -- same treatment a NULL
                # weight_kg row already gets from the query above.
                vol += unit or 0.0
    return wsets, vol, (vol / wsets if wsets else None)


def _latest_session_for(db_path, exercise_names, exclude_session_id=None):
    """Most recent structured session (id, date, created_at, session_type_id)
    containing >= 1 set of any of exercise_names, or None."""
    if not exercise_names:
        return None
    names = sorted(exercise_names)
    conn = _db_connect(db_path)
    try:
        q = (
            "SELECT DISTINCT w.id, w.date, w.created_at, w.session_type_id "
            "FROM workout_sets s JOIN workouts w ON w.id = s.session_id "
            "WHERE s.exercise_name IN (%s) "
            "AND (? IS NULL OR w.id != ?) "
            "ORDER BY w.date DESC, w.created_at DESC, w.id DESC LIMIT 1"
            % ','.join('?' * len(names)))
        row = conn.execute(
            q, (*names, exclude_session_id, exclude_session_id)).fetchone()
        return row
    except sqlite3.OperationalError:
        return None
    finally:
        conn.close()


def _prior_same_type_session(db_path, k_row, exclude_session_id=None):
    """K' (spec 5.1 S2): most recent structured session strictly before K
    with the SAME session_type_id. K untagged -> caller returns S2=false."""
    k_id, k_date, k_created, k_type = k_row
    if k_type is None:
        return None
    conn = _db_connect(db_path)
    try:
        row = conn.execute(
            "SELECT DISTINCT w.id "
            "FROM workout_sets s JOIN workouts w ON w.id = s.session_id "
            "WHERE w.session_type_id = ? AND w.id != ? "
            "AND (? IS NULL OR w.id != ?) "
            "AND (w.date < ? OR (w.date = ? AND (w.created_at < ? "
            "  OR (w.created_at = ? AND w.id < ?)))) "
            "ORDER BY w.date DESC, w.created_at DESC, w.id DESC LIMIT 1",
            (k_type, k_id, exclude_session_id, exclude_session_id,
             k_date, k_date, k_created, k_created, k_id),
        ).fetchone()
        return row[0] if row else None
    except sqlite3.OperationalError:
        return None
    finally:
        conn.close()


# ---- DGN-316 5.1: fatigue signals + state (stateless, computed on read) ----

def muscle_fatigue(program, db_path, today, exclude_session_id=None,
                   muscle_map=None, focus_muscles=None):
    """Per-muscle fatigue state {muscle: {state, signals, actual_sets_7d}}.
    Signals: S1 overreach (density-normalized ceiling), S2 per-set
    performance drop (same-type pair), S3 stall (MAX per-exercise
    miss_streak). Same-session S2+S3 dedup; ramp guard forces S1/S2 false
    below MUSCLE_RAMP_MIN_SESSIONS structured sessions; S3 always live."""
    if muscle_map is None:
        muscle_map = get_muscle_map(db_path)
    if focus_muscles is None:
        focus_muscles, _ = get_focus_muscles(db_path, program)
    actual = actual_sets(db_path, today, exclude_session_id)
    w_count = window_session_count(db_path, today, exclude_session_id)
    total = total_structured_sessions(db_path)
    ramp_active = total < MUSCLE_RAMP_MIN_SESSIONS
    freq, _ = program_weekly_frequency(program)

    # S3 inputs: program.yaml slots (all days) primary to each muscle.
    rotation = program.get('rotation') or []
    days = program.get('days') or {}
    vocab = muscle_vocab(db_path)
    miss_by_muscle = {m: [] for m in vocab}   # (exercise, miss_streak)
    for day in rotation:
        day_plan = days.get(day) or {}
        # A3 (2026-09-30): the streak is DERIVED from history per (exercise,
        # session type). The yaml key was written by nothing, so S3 could
        # never fire.
        day_type_id = resolve_session_type_id(db_path, day)
        for ex in (day_plan.get('exercises') or []):
            if not isinstance(ex, dict):
                continue
            name = ex.get('name', '')
            miss = (derive_miss_streak(db_path, name, day_type_id,
                                       ex.get('rep_range') or [6, 10],
                                       exclude_session_id)
                    if day_type_id is not None else 0)
            for muscle, role in muscle_map.get(name, []):
                if role == 'primary' and muscle in miss_by_muscle:
                    miss_by_muscle[muscle].append((name, miss))

    out = {}
    for m in vocab:
        band = resolve_band(m, program, focus_muscles)

        # S1 OVERREACH (density-normalized ceiling, grill M-3).
        ceiling_eff = band['ceiling'] * max(1.0, w_count / freq)
        s1 = (not ramp_active) and actual[m] > ceiling_eff

        # S2 PERFORMANCE DROP (per-set normalized, same-type pair).
        s2 = False
        k_id = None
        if not ramp_active:
            primaries = {name for name, pairs in muscle_map.items()
                         for (mm, role) in pairs
                         if mm == m and role == 'primary'}
            k_row = _latest_session_for(db_path, primaries,
                                        exclude_session_id)
            if k_row is not None and k_row[3] is not None:
                k_id = k_row[0]
                kp_id = _prior_same_type_session(db_path, k_row,
                                                 exclude_session_id)
                if kp_id is not None:
                    wk, vk, psk = muscle_session_stats(
                        db_path, k_id, m, muscle_map)
                    wkp, vkp, pskp = muscle_session_stats(
                        db_path, kp_id, m, muscle_map)
                    # guards (5.1 + m-4): all-NULL K must not read as crash
                    if wk > 0 and wkp > 0 and vkp > 0:
                        s2 = psk < (1 - MUSCLE_VOL_DROP) * pskp

        # S3 STALL: MAX per-exercise miss_streak among primary slots >= 2.
        qualifying = [name for name, miss in miss_by_muscle[m]
                      if miss >= MUSCLE_MISS_MAX]
        s3 = len(qualifying) > 0

        # Same-session dedup (grill M-3): S2+S3 sharing the same evidence
        # session K count as ONE signal.
        deduped = False
        if s2 and s3 and k_id is not None:
            all_same = True
            for name in set(qualifying):
                latest = _latest_session_for(db_path, {name},
                                             exclude_session_id)
                if latest is None or latest[0] != k_id:
                    all_same = False
                    break
            deduped = all_same

        n_signals = int(s1) + int(s2) + int(s3) - int(deduped)
        state = ('fresh' if n_signals == 0
                 else 'loaded' if n_signals == 1 else 'fatigued')
        out[m] = {
            'state': state,
            'signals': {'overreach': s1, 'perf_drop': s2, 'stall': s3,
                        'deduped': deduped},
            'actual_sets_7d': actual[m],
        }
    return out


# ---------------------------------------------------------------------------
# Sub-region effective-set layer (2026-07-18). Sits ALONGSIDE the group layer
# (per_muscle) -- never replaces it. Fractional effective sets (direct 1.0 /
# synergist 0.5, Pelland 2025) are further split within a muscle by an
# evidence-graded bias fraction that SUMS TO 1.0, so a banding UNIT total
# never inflates above the validated group effective-set count.
# Independent tracking is claimed only where longitudinal evidence exists
# (triceps long head = B; distal biceps = C); all other splits roll up to
# their group/banding unit for scoring.
# ---------------------------------------------------------------------------

# sub-region -> banding unit (the unit that carries a band). Units NOT in
# GROUP_BANDS_4 (front_delt, adductors, abs, forearms) are tracked but
# unbanded (info only -- pressing/incidental coverage, no researched target).
#
# DB-BACKED since 030_muscle_node: `muscle_node.band_unit`. This is a
# PRESCRIPTION BANDING map, NOT a display parent map -- front_delt / side_delt
# / rear_delt band to THEMSELVES because each carries its own researched band,
# while exercise-enter's CARD_SUBREGION_PARENT rolls all three up to 어깨 for
# display. Same three names, two different questions, so 030 keeps them in two
# columns (`band_unit` vs `parent`) and this map reads only the first.
#
# The seeded values reproduce the old literal EXACTLY, including its
# `.get(sub, sub)` fallback: abs_lower bands to `abs_lower`, not to `abs`. That
# is the pre-030 runtime behaviour, deliberately preserved -- a data-unification
# refactor must not move a prescription. Correcting it is a separate ticket.
# The DB map's domain is the whole subregion vocabulary, so `abs_lower` is now
# a present key rather than a fallback hit; the value it resolves to is
# unchanged, and the only place the key SET is read (the union in
# subregion_layer) exists precisely to not lose a known subregion.
SUBREGION_GROUP = _tax()["SUBREGION_GROUP"]

# sub-regions with independent longitudinal tracking evidence (shown as
