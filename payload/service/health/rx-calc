# Muscle vocabulary (spec 2.3; closed set, English snake_case).
# THE VOCABULARY LIVES IN THE KIT'S TREE (kit 063): muscle_node rows of kind
# 'muscle' -- `kit_life.sh muscle-vocab --kind muscle`. muscle_vocab(db) below
# is how a DB-aware reader takes it. The tuples here are the BAND-TABLE key set
# (MAJOR/MINOR decide a band class) and the offline fallback for a DB whose
# tree was never seeded; test-program-plan P8 pins them equal to the pack's
# seeded tree, so the two cannot drift silently.
MUSCLES_MAJOR = ('chest', 'back', 'shoulders', 'quads', 'hamstrings', 'glutes')
MUSCLES_MINOR = ('biceps', 'triceps', 'abs', 'calves', 'forearms')
MUSCLE_VOCAB  = MUSCLES_MAJOR + MUSCLES_MINOR

# focus_areas label -> muscles is READ FROM THE TREE (kit 063 muscle-focus),
# not a code dict: the old dict said arms = biceps + triceps and legs = quads
# + hamstrings + glutes while the tree has forearms under arms and calves
# under legs. Free text / a label the tree does not know = NO expansion,
# flagged for a main-session mapping decision, never guessed.


def _muscle_tree(db_path):
    """{node: (parent, kind, sort)} from muscle_node, or {} (no table / an
    unseeded tree)."""
    try:
        conn = _db_connect(db_path)
    except sqlite3.Error:
        return {}
    try:
        return dict((n, (p, k, srt)) for n, p, k, srt in conn.execute(
            'SELECT node, parent, kind, sort FROM muscle_node'))
    except sqlite3.OperationalError:
        return {}
    finally:
        conn.close()


def muscle_vocab(db_path):
    """The closed muscle vocabulary for this DB: the tree's `muscle` nodes
    (kit muscle-vocab --kind muscle). Pack order first so every ordered
    output stays byte-stable, then any muscle the tree adds; a muscle the tree
    does not carry is dropped. Unseeded tree -> the pack fallback tuple."""
    tree = _muscle_tree(db_path) if db_path else {}
    have = [n for n, (_p, k, _s) in tree.items() if k == 'muscle']
    if not have:
        return MUSCLE_VOCAB
    extra = sorted((n for n in have if n not in MUSCLE_VOCAB),
                   key=lambda n: (tree[n][2], n))
    return tuple(m for m in MUSCLE_VOCAB if m in have) + tuple(extra)


def _resolve_area(db_path, area, tree=None):
    """area -> [muscles] or None. Mirrors kit training_axis.resolve_area
    (muscle-focus): a node key first, else a muscle_label text naming exactly
    one node; group -> its descendant `muscle` nodes, muscle -> itself,
    subregion -> the muscle above it. test-program-plan P8 holds the two
    equal on the seeded tree."""
    tree = _muscle_tree(db_path) if tree is None else tree
    if not tree:
        return None
    node = area if area in tree else None
    if node is None:
        try:
            conn = _db_connect(db_path)
            try:
                hits = sorted(set(r[0] for r in conn.execute(
                    'SELECT node FROM muscle_label WHERE text = ?', (area,))))
            finally:
                conn.close()
        except sqlite3.Error:
            return None
        if len(hits) != 1 or hits[0] not in tree:
            return None
        node = hits[0]
    parent, kind, _s = tree[node]
    if kind == 'muscle':
        return [node]
    if kind == 'subregion':
        up, seen = parent, set()
        while up is not None and up in tree and up not in seen:
            seen.add(up)
            if tree[up][1] == 'muscle':
                return [up]
            up = tree[up][0]
        return None
    out, stack, seen = [], [node], set()
    while stack:
        cur = stack.pop()
        for n, (p, k, _s) in tree.items():
            if p == cur and n not in seen:
                seen.add(n)
                if k == 'muscle':
                    out.append(n)
                elif k == 'group':
                    stack.append(n)
    out.sort(key=lambda n: (tree[n][2], n))
    return out or None


def get_muscle_map(db_path):
    """exercise_muscle mapping: {exercise_name: [(muscle, role), ...]}.
    Empty dict when the W03 table does not exist (pre-migration / older
    instance) -- every DGN-316 stage degrades to a no-op on an empty map."""
    conn = _db_connect(db_path)
    try:
        rows = conn.execute(
            "SELECT exercise_name, muscle, role FROM exercise_muscle"
        ).fetchall()
    except sqlite3.OperationalError:
        return {}
    finally:
        conn.close()
    out = {}
    for name, muscle, role in rows:
        out.setdefault(name, []).append((muscle, role))
    return out


def _expand_focus(areas, db_path):
    muscles = set()
    unexpanded = []
    tree = _muscle_tree(db_path)
    for item in areas:
        label = item.get('area') if isinstance(item, dict) else item
        if not isinstance(label, str):
            continue
        got = _resolve_area(db_path, label, tree)
        if got:
            muscles.update(got)
        else:
            unexpanded.append(label)
    return muscles, unexpanded


def get_focus_muscles(db_path, program=None):
    """Focus muscles, expanded per the spec 2.3 table. Returns
    (set_of_muscles, unexpanded_labels). Free-text labels are returned
    unexpanded (flagged), never guessed.

    SOURCE ORDER (2026-09-26, goal-interview round 2). The card first: a
    program built through service/health/program-plan carries the owner's
    chosen areas as program.yaml `focus_areas`. The round-2 goal interview
    registers no long-goal row, so the old home -- the active long-layer
    ledger_goal detail.focus_areas -- is read only as the LEGACY fallback,
    for cards built before the move. A card that carries the key (even
    empty) answers alone: an owner who chose "evenly" must not inherit an
    old long row's areas."""
    if isinstance(program, dict) and 'focus_areas' in program:
        return _expand_focus(program.get('focus_areas') or [], db_path)
    conn = _db_connect(db_path)
    try:
        row = conn.execute(
            "SELECT detail FROM ledger_goal "
            "WHERE layer = 'long' AND status = 'active' "
            "ORDER BY id DESC LIMIT 1"
        ).fetchone()
    except sqlite3.OperationalError:
        return set(), []
    finally:
        conn.close()
    if not row or not row[0]:
        return set(), []
    try:
        detail = json.loads(row[0])
    except (json.JSONDecodeError, TypeError):
        return set(), []
    return _expand_focus(detail.get('focus_areas') or [], db_path)


def resolve_band(muscle, program, focus_muscles):
    """Band resolution (spec 4.2): program.yaml volume_bands override wins,
    else class band; focus muscles get target/ceiling + MUSCLE_FOCUS_BONUS.
    Returns {'floor': n, 'target': n, 'ceiling': n, 'focus': bool}."""
    if muscle in GROUP_MUSCLE_BANDS:            # 2026-07-18 researched group bands
        base = GROUP_MUSCLE_BANDS[muscle]
    else:
        base = MUSCLE_BAND_MAJOR if muscle in MUSCLES_MAJOR else MUSCLE_BAND_MINOR
    floor_v, target_v, ceiling_v = base
    overrides = program.get('volume_bands') or {}
    ov = overrides.get(muscle)
    if isinstance(ov, dict):
        floor_v = ov.get('floor', floor_v)
        target_v = ov.get('target', target_v)
        ceiling_v = ov.get('ceiling', ceiling_v)
    focus = muscle in focus_muscles
    if focus:
        target_v += MUSCLE_FOCUS_BONUS
        ceiling_v += MUSCLE_FOCUS_BONUS
    return {'floor': floor_v, 'target': target_v, 'ceiling': ceiling_v,
            'focus': focus}


def program_weekly_frequency(program):
    """weekly_frequency (spec 2.5): program.yaml key, else default =
    len(rotation) with a defaulted flag. Returns (freq, defaulted)."""
    wf = program.get('weekly_frequency')
    if isinstance(wf, (int, float)) and wf > 0:
        return wf, False
    rotation = program.get('rotation') or []
    return (len(rotation) or 1), True


# ---- DGN-316 3.2: actual weekly effective sets per muscle (rolling 7d) ----
# M-5 / M-B1 pattern: every computation takes exclude_session_id = today's
# open placeholder session so mid-day recomputation never reads its own
# partial session as evidence. Callers with no open session pass None.

_WINDOW_PRED = ("w.date >= date(?, '-6 days') AND w.date <= ? "
                "AND (? IS NULL OR w.id != ?)")


def actual_sets(db_path, today, exclude_session_id=None):
    """{muscle: effective sets over rolling 7d ending today}. Calibration
    sets (weight_kg IS NULL) COUNT for set credit (spec 3.1 -- set COUNT and
    volume LOAD have different NULL semantics). All vocab muscles present."""
    out = {m: 0.0 for m in muscle_vocab(db_path)}
    credit, cargs = _credit_sql()      # functional / practice set factor
    conn = _db_connect(db_path)
    try:
        rows = conn.execute(
            "SELECT em.muscle, SUM(CASE em.role WHEN 'primary' THEN 1.0 "
            "ELSE ? END * " + credit + ") "
            "FROM workout_sets s "
            "JOIN workouts w ON w.id = s.session_id "
            "JOIN exercise_muscle em ON em.exercise_name = s.exercise_name "
            "WHERE " + _WINDOW_PRED + " "
            "GROUP BY em.muscle",
            (MUSCLE_SET_WEIGHT_SECONDARY,) + cargs + (today, today,
             exclude_session_id, exclude_session_id),
        ).fetchall()
    except sqlite3.OperationalError:
        return out
    finally:
        conn.close()
    for muscle, credit in rows:
        if muscle in out:
            out[muscle] = float(credit or 0.0)
    return out


def unmapped_actual(db_path, today, exclude_session_id=None):
    """Coverage guard (spec 3.2 / M-4): exercises logged in the window with
    NO exercise_muscle rows. Non-empty = audit verdicts unreliable."""
    conn = _db_connect(db_path)
    try:
        rows = conn.execute(
            "SELECT DISTINCT s.exercise_name "
            "FROM workout_sets s "
            "JOIN workouts w ON w.id = s.session_id "
            "LEFT JOIN exercise_muscle em "
            "  ON em.exercise_name = s.exercise_name "
            "WHERE " + _WINDOW_PRED + " "
            "AND em.exercise_name IS NULL "
            "ORDER BY s.exercise_name",
            (today, today, exclude_session_id, exclude_session_id),
        ).fetchall()
    except sqlite3.OperationalError:
        return []
    finally:
        conn.close()
    return [r[0] for r in rows]


def window_session_count(db_path, today, exclude_session_id=None):
    """W = COUNT(DISTINCT structured sessions in the rolling 7d window,
    excluding exclude_session_id) -- S1 normalization + attendance gate."""
    conn = _db_connect(db_path)
    try:
        row = conn.execute(
            "SELECT COUNT(DISTINCT s.session_id) "
            "FROM workout_sets s "
            "JOIN workouts w ON w.id = s.session_id "
            "WHERE " + _WINDOW_PRED,
            (today, today, exclude_session_id, exclude_session_id),
        ).fetchone()
        return row[0] if row else 0
    except sqlite3.OperationalError:
        return 0
    finally:
        conn.close()


def total_structured_sessions(db_path):
    """All-time DISTINCT workout_sets.session_id count (ramp guard, 5.1)."""
    conn = _db_connect(db_path)
    try:
        row = conn.execute(
            "SELECT COUNT(DISTINCT session_id) FROM workout_sets").fetchone()
