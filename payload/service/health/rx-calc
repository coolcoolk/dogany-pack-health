# Band check helper (M3: ±15% guard for logging turn)
# ---------------------------------------------------------------------------

def band_check(old_kg, new_kg):
    """
    Return True if new_kg is within ±15% of old_kg.
    Returns True (pass) if old_kg is None or zero.
    """
    if old_kg is None or old_kg == 0:
        return True
    ratio = abs(new_kg - old_kg) / abs(old_kg)
    return ratio <= 0.15


