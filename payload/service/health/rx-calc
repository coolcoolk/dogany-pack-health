def proposed_subregion_sets(program, submap, muscle_map):
    """Proposed weekly effective sets per sub-region from a program.yaml dict.
    Same slot*sets*F/R arithmetic as proposed_sets, but the credit is the
    exercise_subregion weight (role x bias). Returns
    (per_subregion, unmapped_subregion) where unmapped_subregion lists
    exercises that HAVE a group mapping but NO sub-region rows (would silently
    under-count; should be empty once the table is fully populated)."""
    out = {}
    unmapped = []
    rotation = program.get('rotation') or []
    days = program.get('days') or {}
    freq, _ = program_weekly_frequency(program)
    factor = (freq / len(rotation)) if rotation else 1.0
    for day in rotation:
        day_plan = days.get(day) or {}
        for ex in (day_plan.get('exercises') or []):
            if not isinstance(ex, dict):
                continue
            name = ex.get('name', '')
            credit = slot_credit(ex)   # functional / practice factor
            if not name or not credit > 0:
                continue
            sets = ex.get('sets', 3) * credit
            subs = submap.get(name)
            if not subs:
                # only a coverage HOLE if the exercise is group-mapped
                if muscle_map.get(name) and name not in unmapped:
                    unmapped.append(name)
                continue
            for sub, weight, _grade in subs:
                out[sub] = out.get(sub, 0.0) + sets * weight * factor
    return out, unmapped


def actual_subregion_sets(db_path, today, exclude_session_id=None):
    """{subregion: effective sets over rolling 7d ending today}. Fractional
    credit = exercise_subregion.weight (role x bias). Calibration sets
    (weight_kg NULL) COUNT for set credit, mirroring actual_sets."""
    out = {}
    credit, cargs = _credit_sql()      # functional / practice set factor
    conn = _db_connect(db_path)
    try:
        rows = conn.execute(
            "SELECT es.subregion, SUM(es.weight * " + credit + ") "
            "FROM workout_sets s "
            "JOIN workouts w ON w.id = s.session_id "
            "JOIN exercise_subregion es ON es.exercise_name = s.exercise_name "
            "WHERE " + _WINDOW_PRED + " "
            "GROUP BY es.subregion",
            cargs + (today, today, exclude_session_id, exclude_session_id),
        ).fetchall()
    except sqlite3.OperationalError:
        return out
    finally:
        conn.close()
    for sub, credit in rows:
        out[sub] = float(credit or 0.0)
    return out


def _band4_verdict(prop, act, band4, insufficient):
    """The 4-tuple MEV/MAV/MRV verdict ladder, factored out so the group layer
    and the sub-region layer cannot drift apart. Unchanged semantics."""
    mev, mav_lo, mav_hi, mrv = band4
    if not prop > 0:
        return 'untrained'
    if prop > mrv:
        return 'above_ceiling'          # design-time over-dose (MRV)
    if prop < mev:
        return 'below_floor'            # design-time under-dose (MEV)
    if act < mev:
        return 'insufficient_data' if insufficient else 'below_floor'
    if prop < mav_lo:
        return 'below_mav'              # in floor..MAV -- adequate, low
    if prop > mav_hi:
        return 'above_mav'              # MAV..MRV -- high but recoverable
    return 'in_mav'                     # in the primary adaptive range


# ---------------------------------------------------------------------------
# WHERE THE VERDICT IS FORMED (2026-08-25, owner ruling)
#
#   Ruling: manage volume by drilling down to the TARGET sub-muscle, not by
#   judging the coarse parent group.
#
# Until today the verdict was formed on the PARENT sum: back_erectors +
# back_lats + back_upper were added up and the total was judged against the
# `back` band. That lets a program pass while a member is starved -- which is
# not hypothetical, it is the shoulder finding in the 08-22 briefing (어깨
# 12.5 총량 통과, but 측면 3.0 / 후면 3.0, both under their own floors). The
# only reason that one was caught is that side_delt / rear_delt happen to band
# to THEMSELVES. Every sub-region that rolls up to a parent was invisible.
#
# So: THE BAND ATTACHES TO THE SUB-REGION. The parent group becomes a DISPLAY
# rollup and is no longer where a verdict forms.
#
# The rollup LABEL follows the rule the owner already set for pin display on
# 2026-08-22 -- one rule, not a second one invented here:
#   "핀의 부위 표시는 하위부위 단위로 표시하되, 한 상위부위의 하위부위가 여러 개
#    훈련되면 상위부위 이름으로 묶는다 (예: 승모+광배->등이지만 카프레이즈처럼
#    가자미근만 훈련되면 종아리로 묶지 않고 가자미로 유지)."
# That rule lived only in the display layer. `rollup_label` applies it here.
#
# WHERE THE SUB-REGION BANDS COME FROM (and their honest grade)
# -------------------------------------------------------------
#   * A unit that IS a single sub-region (side_delt, rear_delt, quads,
#     hamstrings) already carries a researched band -- used as-is.
#   * A unit with N members (back 3, chest 3, biceps 2, calves 2, glutes 2,
#     triceps 2) gets the parent 4-tuple divided by N.
#
# The uniform split is not a new invented number: it is the assumption the
# parent band was ALREADY making. "10 sets of back" is only a valid dose
# statement if the dose is spread over the back; a parent band that passes on
# a lopsided distribution is asserting the split without checking it. Dividing
# makes the assumption explicit at the layer where the decision happens. It is
# also arithmetically closed -- exercise_subregion weights are bias fractions
# summing to 1.0 within a muscle, so sum(members) == parent, and every member
# hitting its split band implies the parent hits its band. Graded D and echoed
# in `band_source` so the owner can reject the split itself.
#
# MANAGEMENT GRANULARITY IS A PARAMETER, NOT A HARDCODE
# ------------------------------------------------------
# Owner, same ruling: beginners and intermediate-plus lifters split here too. A
# beginner is served by parent-group management (등 10 sets is enough; the
# sub-region breakdown is noise). Intermediate-and-up needs the drill-down.
# So the judging layer is selected by `judge_layer` (program.yaml key or
# --judge-layer), NOT decided in code. Default = 'subregion'. The level MODEL
# (owner-selected vs auto-promoted from history) is deliberately NOT built
# here -- it is an open question with the owner.
# ---------------------------------------------------------------------------

JUDGE_LAYERS = ('subregion', 'group')
JUDGE_LAYER_DEFAULT = 'subregion'
SUBREGION_SPLIT_GRADE = 'D'      # uniform split: derived, not researched


def resolve_judge_layer(program, override=None):
    """Which layer forms the verdict. override (CLI) > program.yaml > default.
    An unrecognised value falls back to the default rather than crashing --
    a typo must not silently switch the owner's management granularity."""
    for cand in (override, (program or {}).get('judge_layer')):
        if isinstance(cand, str) and cand in JUDGE_LAYERS:
            return cand
    return JUDGE_LAYER_DEFAULT


def subregion_bands():
    """{subregion: (band4, source, n_members)} for every BANDED sub-region.
    Sub-regions whose unit carries no researched band are absent."""
    out = {}
    for unit, band4 in GROUP_BANDS_4.items():
        members = sorted(s for s, u in SUBREGION_GROUP.items() if u == unit)
        if not members:
            continue
        n = len(members)
        if n == 1:
            for s in members:
                out[s] = (band4, 'researched_unit', 1)
        else:
            split = tuple(round(v / n, 2) for v in band4)
            for s in members:
                out[s] = (split, 'derived_uniform_split', n)
    return out


def rollup_label(unit, members, trained):
    """Owner's 2026-08-22 pin rule, applied to the judgement rollup: name the
    PARENT when 2+ of its sub-regions are trained, otherwise keep the single
    trained sub-region's own name (카프레이즈로 가자미근만 훈련되면 '종아리'로
    묶지 않는다). `trained` = the subset of members carrying dose."""
    hit = [m for m in members if m in trained]
    if len(hit) == 1 and len(members) > 1:
        return hit[0]
    return unit


def judge_layer_source(program, override=None):
    """Where the active judging layer came from, for the audit's provenance
    line. The owner must be able to see WHY their program was judged at the layer
    it was judged at without re-deriving the precedence rule."""
    if isinstance(override, str) and override in JUDGE_LAYERS:
        return 'cli_override'
    declared = (program or {}).get('judge_layer')
    if isinstance(declared, str) and declared in JUDGE_LAYERS:
        return 'program_yaml'
    return 'default'


def subregion_layer(program, db_path, today, exclude_session_id,
                    muscle_map, insufficient, judge_layer=None):
    """Build the sub-region + banding-unit audit block (2026-07-18; judgement
    moved to the sub-region layer 2026-08-25).

    Returns (per_subregion, per_group, unmapped_subregion, judgement).
    per_subregion now carries its OWN band and verdict -- that is the
    judgement layer. per_group keeps its numbers and its legacy `verdict` key
    byte-for-byte (consumers depend on it) but is tagged `role:
    display_rollup`; when judge_layer == 'subregion' its `judgement` flag is
    False, i.e. it is a readability aggregate, not a decision."""
    _use_tax_db(db_path)       # SUBREGION_GROUP is DB-backed -- bind it here
    layer = resolve_judge_layer(program, judge_layer)
    submap = get_subregion_map(db_path)
    if not submap:
        return {}, {}, [], {'layer': layer, 'active': False, 'violations': []}
    proposed, unmapped = proposed_subregion_sets(program, submap, muscle_map)
    actual = actual_subregion_sets(db_path, today, exclude_session_id)
    sub_bands = subregion_bands()

    all_subs = set(proposed) | set(actual) | set(SUBREGION_GROUP)
    trained = {s for s in all_subs if proposed.get(s, 0.0) > 0}
    per_subregion = {}
    for sub in sorted(all_subs):
        unit = SUBREGION_GROUP.get(sub, sub)
        prop = round(proposed.get(sub, 0.0), 2)
        act = round(actual.get(sub, 0.0), 2)
        entry = {
            'proposed_weekly_sets': prop,
            'actual_sets_7d':       act,
            'banding_unit':         unit,
            'banded':               unit in GROUP_BANDS_4,
            'independent_tracking': sub in INDEPENDENT_SUBREGIONS,
            'evidence_grade':       INDEPENDENT_SUBREGIONS.get(sub),
        }
        bs = sub_bands.get(sub)
        if bs:
            band4, source, n = bs
            mev, mav_lo, mav_hi, mrv = band4
            entry['band'] = {'mev': mev, 'mav_low': mav_lo,
                             'mav_high': mav_hi, 'mrv': mrv}
            entry['band_source'] = source
            entry['band_evidence_grade'] = (
                SUBREGION_SPLIT_GRADE if source == 'derived_uniform_split'
                else 'researched')
            entry['unit_members'] = n
            entry['verdict'] = _band4_verdict(prop, act, band4, insufficient)
        else:
            entry['band'] = None
            entry['band_source'] = 'unbanded'
            entry['verdict'] = None
        per_subregion[sub] = entry

    # banding units: sum member sub-regions, score vs the 4-tuple band.
    # KEPT VERBATIM for backward compatibility, DEMOTED to a display rollup.
    per_group = {}
    for unit, band4 in GROUP_BANDS_4.items():
        members = sorted(s for s, u in SUBREGION_GROUP.items() if u == unit)
        mev, mav_lo, mav_hi, mrv = band4
        prop = round(sum(proposed.get(s, 0.0) for s in members), 2)
        act = round(sum(actual.get(s, 0.0) for s in members), 2)
        per_group[unit] = {
            'proposed_weekly_sets': prop,
            'actual_sets_7d':       act,
            'band': {'mev': mev, 'mav_low': mav_lo, 'mav_high': mav_hi,
                     'mrv': mrv},
            'members': members,
            'verdict': _band4_verdict(prop, act, band4, insufficient),
            'role': ('judgement' if layer == 'group' else 'display_rollup'),
            'judgement': (layer == 'group'),
            'display_label': rollup_label(unit, members, trained),
        }

    # The judgement block: ONE place that says which layer decided and what it
    # found, so no consumer has to guess which number is the verdict.
    violations = []
    if layer == 'subregion':
        for sub, e in sorted(per_subregion.items()):
            if e.get('verdict') in ('below_floor', 'above_ceiling',
                                    'above_mav', 'below_mav'):
                violations.append({
                    'unit': sub, 'layer': 'subregion',
                    'rollup': SUBREGION_GROUP.get(sub, sub),
                    'verdict': e['verdict'],
                    'proposed_weekly_sets': e['proposed_weekly_sets'],
                    'actual_sets_7d': e['actual_sets_7d'],
                    'band': e['band'],
                    'band_source': e['band_source'],
                    'hidden_by_rollup': (
                        per_group.get(SUBREGION_GROUP.get(sub, sub), {})
                        .get('verdict') == 'in_mav'),
                })
    else:
        for unit, e in sorted(per_group.items()):
            if e['verdict'] in ('below_floor', 'above_ceiling',
                                'above_mav', 'below_mav'):
                violations.append({
                    'unit': unit, 'layer': 'group',
                    'verdict': e['verdict'],
                    'proposed_weekly_sets': e['proposed_weekly_sets'],
                    'actual_sets_7d': e['actual_sets_7d'],
                    'band': e['band'],
                    'band_source': 'researched_unit',
                })
    judgement = {
        'layer': layer,
        'active': True,
        'available_layers': list(JUDGE_LAYERS),
        'selected_by': judge_layer_source(program, judge_layer),
        'violations': violations,
        'note': ('bands attach to sub-regions; parent groups are a display '
                 'rollup (owner ruling 2026-08-25). `group` layer is the '
                 'beginner-granularity setting and is NOT auto-selected -- '
                 'the level model is an open question with the owner.'),
        'split_grade': SUBREGION_SPLIT_GRADE,
    }
    return per_subregion, per_group, unmapped, judgement


# ---------------------------------------------------------------------------
# LOAD AXES (2026-08-25). Two NEW numbers. Zero change to any band verdict.
#
# WHY THIS EXISTS
# ---------------
# The 2026-08-22 consult briefing measured three holes in this instrument and
# proved them by running it:
#   (a) back_squat and v_squat were IDENTICAL on every volume number -- same
#       sub-regions, same weights, same set count. Moving one to the other day
#       changed nothing the audit prints, so the owner's proposal could be
#       neither confirmed nor disproven by the machine.
#   (b) no squat-family exercise carried a back_erectors row, so the spinal-
#       erector load the owner actually reasons about was not modelled at all.
#   (c) volume is sets x role-weight x frequency. kg never enters. A 60kg set
#       and a 140kg set score identically.
# All three are ONE hole seen from three sides: THE INSTRUMENT CANNOT SEE LOAD.
# So the fix is one axis, not three patches.
#
# WHY NOT JUST ADD back_erectors ROWS TO THE SQUATS (the obvious fix)
# ------------------------------------------------------------------
# Because back_erectors bands to `back` (muscle_node.band_unit), and `back` is
# the owner's FOCUS muscle. Squat erector load is ISOMETRIC AXIAL BRACING -- a
# fatigue/recovery quantity. The `back` band (MEV 10 / MAV 14-22 / MRV 25) is a
# HYPERTROPHY SET-DOSE band. Pouring bracing load into it makes a fatigue
# number move a growth verdict: a unit error, not a refinement.
# MEASURED (2026-08-25, live DB copy, back_erectors 0.35 on back_squat /
# v_squat / bulgarian_split_squat): `back` proposed 18.50 -> 21.65, actual_7d
# 42.50 -> 47.40. The verdict string survives (in_mav), but MAV-high headroom
# goes 3.50 -> 0.35 -- one extra squat set anywhere then flips the owner's
# FOCUS muscle to above_mav for a reason that has nothing to do with back
# training, and a dose-trim recommendation would follow. Rejected.
#
# WHY NOT PUT kg INSIDE THE EXISTING VOLUME METRIC
# ------------------------------------------------
# The MEV/MAV/MRV constants are literature values counted in SETS. Redefine the
# unit and every band constant silently becomes meaningless, and every audit
# recorded in program-history / the worklogs stops being comparable. The
# owner's own model (2026-08-25) already names two roles: set count is the
# FLOOR indicator ("below this you don't grow"), weight x reps is the CEILING
# indicator ("grow this to grow"). Two roles want two numbers. So load lands
# ALONGSIDE, never inside.
#
# WHAT LANDS
# ----------
#   axial  -- spinal/axial exposure: coeff x sets x kg, aggregated per rotation
#             day, then scored across the MEASURED calendar seam between
#             consecutive days. This is the number that answers "did moving
#             back_squat to 앞A help?".
#   load   -- tonnage (kg x reps x sub-region weight) per sub-region and per
#             banding unit, UNBANDED, printed next to the set counts. This is
#             the owner's ceiling indicator.
#
# Both are additive top-level keys. per_muscle / per_subregion / per_group /
# unmapped_* / flags stay byte-identical (verified by diff).
#
# THE AXIAL COEFFICIENT IS DERIVED, NOT HAND-TABULATED
# ----------------------------------------------------
# The redesign DESIGN doc's rule for this axis is explicit: "종목 축부하 등급 ...
# 하드코딩 금지, 이력에서 파생". The briefing's own attempt was a 7-entry
# per-exercise constant table it graded D and then disowned. So instead:
#
#     coeff(ex) = PATTERN_AXIAL[exercise_pattern.pattern]
#                 x AXIAL_SUPPORT[ax_exercise.load_type]
#                 x (0 if ax_exercise.movement == 'isolation')
#
# Both inputs are already in the DB and were authored for other purposes, so
# the per-exercise coefficient is DERIVED from data rather than asserted. The
# irreducible judgement is 8 pattern anchors + 4 support anchors, declared
# below at evidence grade C and echoed in the output so the owner can reject
# the yardstick itself.
#
# Cross-check against the briefing's independently hand-assigned values:
#   deadlift 1.00 = 1.00 | back_squat 0.85 = 0.85 | barbell/pendlay_row 0.45 =
#   0.45 | overhead_press 0.30 = 0.30 | v_squat 0.17 vs 0.15.
# Five of seven reproduce from data the hand-table never consulted. The two
# that differ (rdl 1.00 vs 0.75, bulgarian 0.85 vs 0.20) are exactly the two
# the briefing flagged as undecidable -- and both are now carried by kg instead
# of by a coefficient guess: rdl 110kg x 4 vs deadlift 135kg x 3, bulgarian
# 20kg x 3 vs back_squat 100kg x 3.
#
# WHY sets x kg AND NOT sets x reps x kg FOR THE AXIAL AXIS
# ---------------------------------------------------------
# Peak spinal compression is set by what is on the bar, not by how many times
# it went up. Axial exposure therefore scales with (peak load) x (number of
# exposures). Rep count is muscular work, and that is what the `load` tonnage
# axis measures. Keeping them apart is the whole point of having two axes.
# ---------------------------------------------------------------------------

# pattern -> axial (spinal) involvement anchor. Evidence grade C (practice
# judgement, not measured). Domain = the exercise_pattern vocabulary.
PATTERN_AXIAL = {
    'hinge':           1.00,   # the loaded spine IS the movement
    'squat':           0.85,   # spine braces under the bar
    'horizontal_pull': 0.45,   # bent-over row: spine holds the torso angle
    'vertical_push':   0.30,   # bar above the spine, but light by comparison
    'vertical_pull':   0.10,   # hanging / pulldown: spine largely unloaded
    'core':            0.15,
    'horizontal_push': 0.00,
    'isolation':       0.00,
}

# ax_exercise.load_type -> how much of that involvement the EQUIPMENT removes.
# A back-supported machine takes the axial component off the spine; a cable is
# in between; a barbell takes nothing off. Evidence grade C.
AXIAL_SUPPORT = {
    'freeweight': 1.00,
    'bodyweight': 1.00,
    'cable':      0.50,
    'machine':    0.20,
}

AXIAL_GRADE = 'C'      # both anchor tables: practice judgement, not measured
AXIAL_DEFAULT_SUPPORT = 'freeweight'   # no ax_exercise row -> assume UNsupported
                                       # (over-reports rather than hides load)


def get_ax_exercise_props(db_path):
    """{exercise_name: (movement, load_type)} from ax_exercise (active rows).
    Empty dict when the table is absent -- the axial layer then falls back to
    AXIAL_DEFAULT_SUPPORT for every exercise and says so in `basis`."""
    conn = _db_connect(db_path)
    try:
        rows = conn.execute(
            "SELECT exercise_name, movement, load_type FROM ax_exercise "
            "WHERE status = 'active'"
        ).fetchall()
    except sqlite3.OperationalError:
        return {}
    finally:
        conn.close()
    return {name: (mv, lt) for name, mv, lt in rows}


def axial_coeffs(db_path):
    """{exercise_name: {coeff, pattern, load_type, movement, basis}} derived
    from exercise_pattern x ax_exercise. Exercises with no pattern row are
    absent from the result (reported as axial.unmapped, advisory only)."""
    pattern_map = get_pattern_map(db_path)
    ax_props = get_ax_exercise_props(db_path)
    out = {}
    for name, pattern in pattern_map.items():
        base = PATTERN_AXIAL.get(pattern)
        if base is None:
            continue                      # unknown pattern -> not scored
        movement, load_type = ax_props.get(
            name, (None, AXIAL_DEFAULT_SUPPORT))
        support = AXIAL_SUPPORT.get(
            load_type, AXIAL_SUPPORT[AXIAL_DEFAULT_SUPPORT])
        coeff = base * support
        if movement == 'isolation':
            # a single-joint movement does not load the spine axially even when
            # its pattern family does (wall_sit is `squat` + isolation).
            coeff = 0.0
        out[name] = {
            'coeff':     round(coeff, 4),
            'pattern':   pattern,
            'load_type': load_type,
            'movement':  movement,
            'basis':     ('pattern x support' if name in ax_props
                          else 'pattern x support(defaulted)'),
        }
    return out


def _with_resolved_base(ex, db_path, session_type_id,
                        exclude_session_id=None):
    """A copy of the slot whose weight_kg is the progression BASE calc_rx
    starts from (resolve_base_weight: last logged working load, else the
    card seed). Program state step B (2026-10-03): the week audits below
    used to read the card's weight_kg as 'the prescribed load', but since
    step A that field is only a seed -- on a fresh install every slot
    carries null, so the axial and tonnage axes read zero load for lifts
    the owner has been loading for weeks. No DB / no name -> the slot as is."""
    if not isinstance(ex, dict) or not db_path or not ex.get('name'):
        return ex
    try:
        base, _src = resolve_base_weight(
            db_path, ex['name'], session_type_id,
            exclude_session_id=exclude_session_id, seed=ex.get('weight_kg'))
    except Exception:  # noqa: BLE001 -- an audit read never breaks the audit
        return ex
    return dict(ex, weight_kg=base)


def _slot_load_kg(ex):
    """Prescribed working load for a slot, or None when the slot carries no
    weight (bodyweight / hold / calibration). None is NOT 0 -- it is 'unknown',
    and the axial layer reports which slots those are instead of pretending
    they contribute nothing."""
    if not isinstance(ex, dict):
        return None
    w = ex.get('weight_kg')
    if isinstance(w, bool):
        return None
    if isinstance(w, (int, float)) and w > 0:
        return float(w)
    return None


def measured_transition_gaps(db_path, rotation, lookback_days=60, today=None):
    """Measured CALENDAR gap in days for each consecutive rotation transition,
    from the owner's real session history.

    This is the unit the owner reasons in, and the unit the 08-22 briefing had
    to compute by hand: two sessions that are neighbours in the 4-day queue are
    NOT the same distance apart on the calendar, because the weekend rest lands
    on one seam and not the others. Sessions whose type is outside `rotation`
    (보충 / ad-hoc) are skipped rather than treated as a transition, so a
    make-up session cannot fabricate a 0-day seam.

    Returns {(from_code, to_code): {'n', 'mean_days', 'observed'}}.
    """
    out = {}
    if not rotation:
        return out
    conn = _db_connect(db_path)
    try:
        params = []
        where = ["w.session_type_id IS NOT NULL"]
        if today:
            where.append("w.date <= ?")
            params.append(today)
            where.append("w.date >= date(?, '-' || ? || ' days')")
            params.extend([today, int(lookback_days)])
        rows = conn.execute(
            "SELECT w.date, st.code FROM workouts w "
            "JOIN session_type st ON st.id = w.session_type_id "
            "WHERE " + " AND ".join(where) + " "
            "ORDER BY w.date ASC, w.id ASC",
            params,
        ).fetchall()
    except sqlite3.OperationalError:
        return out
    finally:
        conn.close()

    seq = [(d, c) for d, c in rows if c in rotation]
    for (d1, c1), (d2, c2) in zip(seq, seq[1:]):
        try:
            y1, m1, dd1 = (int(x) for x in d1.split('-'))
            y2, m2, dd2 = (int(x) for x in d2.split('-'))
            gap = (datetime.date(y2, m2, dd2)
                   - datetime.date(y1, m1, dd1)).days
        except (ValueError, TypeError):
            continue
        if gap <= 0:
            continue
        out.setdefault((c1, c2), []).append(gap)
    return {k: {'n': len(v), 'mean_days': round(sum(v) / len(v), 2),
                'observed': v}
            for k, v in out.items()}


def axial_layer(program, db_path, today, exclude_session_id=None):
    """Spinal/axial exposure axis. ADDITIVE -- reads nothing the band layers
    write and writes nothing they read.

    per_exercise : coeff (+ full derivation) x prescribed sets x prescribed kg
    per_day      : summed axial units for each rotation day
    seams        : for every consecutive rotation transition,
                     pressure = sqrt(units_from x units_to) / measured_gap_days
                   Geometric mean, so one very heavy day cannot be cancelled by
                   an empty neighbour, and monotone in the same direction as
                   the briefing's product-over-gap so the two stay comparable.
    worst_seam   : "the hardest single joint in the week" -- the number the
                   owner said they actually cares about.
    total        : sum of seam pressures (whole-cycle summary).

    Degrades to an inert block (active=False) when exercise_pattern is absent.
    """
    import math
    inert = {
        'active': False, 'per_exercise': {}, 'per_day': {}, 'seams': {},
        'worst_seam': None, 'total': 0.0, 'unmapped': [],
        'slots_without_load': [], 'coefficient_basis': {},
    }
    coeffs = axial_coeffs(db_path)
    if not coeffs:
        return inert

    rotation = list(program.get('rotation') or [])
    days = program.get('days') or {}
    per_exercise = {}
    per_day = {}
    unmapped = []
    no_load = []

    for day in rotation:
        day_plan = days.get(day) or {}
        day_total = 0.0
        type_id = resolve_session_type_id(db_path, day)
        for ex in (day_plan.get('exercises') or []):
            if not isinstance(ex, dict):
                continue
            name = ex.get('name', '')
            if not name:
                continue
            ex = _with_resolved_base(ex, db_path, type_id, exclude_session_id)
            info = coeffs.get(name)
            if info is None:
                if name not in unmapped:
                    unmapped.append(name)
                continue
            sets = ex.get('sets', 3)
            kg = _slot_load_kg(ex)
            if kg is None:
                if info['coeff'] > 0 and name not in no_load:
                    no_load.append(name)
                kg = 0.0
            units = info['coeff'] * float(sets) * kg
            day_total += units
            per_exercise['%s/%s' % (day, name)] = {
                'day':        day,
                'exercise':   name,
                'coeff':      info['coeff'],
                'sets':       sets,
                'load_kg':    kg,
                'axial_units': round(units, 2),
                'derivation': {
                    'pattern':        info['pattern'],
                    'pattern_axial':  PATTERN_AXIAL.get(info['pattern']),
                    'load_type':      info['load_type'],
                    'support_factor': AXIAL_SUPPORT.get(
                        info['load_type'],
                        AXIAL_SUPPORT[AXIAL_DEFAULT_SUPPORT]),
                    'movement':       info['movement'],
                    'basis':          info['basis'],
                },
            }
        per_day[day] = round(day_total, 2)

    gaps = measured_transition_gaps(db_path, rotation, today=today)
    cycle_default = None
    allobs = [g for v in gaps.values() for g in v['observed']]
    if allobs:
        cycle_default = round(sum(allobs) / len(allobs), 2)

    seams = {}
    total = 0.0
    worst = None
    n = len(rotation)
    for i in range(n):
        a = rotation[i]
        b = rotation[(i + 1) % n]
        if a == b:
            continue
        g = gaps.get((a, b))
        gap_days = g['mean_days'] if g else cycle_default
        gap_source = 'measured' if g else (
            'cycle_mean' if cycle_default else 'unavailable')
        if not gap_days:
            gap_days = 1.0
        ua, ub = per_day.get(a, 0.0), per_day.get(b, 0.0)
        pressure = round(math.sqrt(ua * ub) / gap_days, 2)
        key = '%s->%s' % (a, b)
        seams[key] = {
            'from': a, 'to': b,
            'from_axial': ua, 'to_axial': ub,
            'gap_days': gap_days,
            'gap_source': gap_source,
            'gap_n': (g['n'] if g else 0),
            'pressure': pressure,
        }
        total += pressure
        if worst is None or pressure > seams[worst]['pressure']:
            worst = key

    return {
        'active': True,
        'per_exercise': per_exercise,
        'per_day': per_day,
        'seams': seams,
        'worst_seam': ({'seam': worst, 'pressure': seams[worst]['pressure']}
                       if worst else None),
        'total': round(total, 2),
        'unmapped': unmapped,
        'slots_without_load': no_load,
        'coefficient_basis': {
            'formula': ('PATTERN_AXIAL[pattern] x AXIAL_SUPPORT[load_type], '
                        'forced to 0 when ax_exercise.movement = isolation'),
            'pattern_axial':  dict(PATTERN_AXIAL),
            'support_factor': dict(AXIAL_SUPPORT),
            'evidence_grade': AXIAL_GRADE,
            'unit': 'coeff x sets x kg (peak load x exposures, NOT reps)',
            'seam_metric': 'sqrt(axial_from x axial_to) / measured_gap_days',
        },
    }


def session_overlap_layer(program, db_path, today, pattern_map, cost_map,
                          muscle_map, axial=None):
    """Adjacent-session fatigue overlap (fatigue_overlap, owner 2026-10-06
    21:50). ADDITIVE like the axial axis: reads the prescribed program, the
    per-lift fatigue grade (resolve_fatigue_cost), the movement pattern and
    the primary muscles; writes nothing a band reads. Every neighbouring pair
    of the rotation (the last wraps to the first) is checked at the tightest
    plausible gap (rules fatigue_overlap.gap_days_tightest -- the owner
    trains flexibly, so neighbours can fall on back-to-back days), the
    measured gap and both days' axial units said beside it when known; plus
    same-session stacking. The numbers an agent explains an overlap with."""
    try:
        import fatigue_overlap
    except ImportError:
        return {'active': False}
    rotation = list(program.get('rotation') or [])
    days = {}
    for day in rotation:
        days[day] = [dict(name=ex.get('name'), sets=ex.get('sets', 3))
                     for ex in ((program.get('days') or {}).get(day) or {}).get('exercises') or []
                     if isinstance(ex, dict) and ex.get('name')]

    def facts(name):
        return dict(pattern=pattern_map.get(name),
                    fatigue=resolve_fatigue_cost(name, cost_map, pattern_map)[0],
                    primary=[m for m, role in muscle_map.get(name, []) if role == 'primary'])
    gaps = {}
    for (a, b), g in measured_transition_gaps(db_path, rotation, today=today).items():
        gaps[(a, b)] = {'days': g['mean_days'], 'source': 'measured', 'n': g['n']}
    units = (axial or {}).get('per_day') if (axial or {}).get('active') else None
    out = fatigue_overlap.overlaps(rotation, days, facts, gaps=gaps, units=units)
    out['stacking'] = fatigue_overlap.stacking(days, facts)
    out['active'] = True
    return out


# ---- load (tonnage) axis: the owner's CEILING indicator --------------------
# Set count is the floor indicator ("below this you don't grow"); weight x reps
# is the ceiling indicator ("grow this to grow"). They were one word until now.
# This block prints the second number NEXT TO the first. It carries no band --
# there is no researched tonnage landmark to band against, and inventing one
# would be exactly the grade-D overreach the briefing already disowned.

def _rep_mid(ex):
    """Mid-point of a slot's prescribed rep range, for the PROPOSED side."""
    rr = ex.get('rep_range') if isinstance(ex, dict) else None
    if isinstance(rr, (list, tuple)) and len(rr) == 2:
        try:
            return (float(rr[0]) + float(rr[1])) / 2.0
        except (TypeError, ValueError):
            return None
    return None


def _slot_volume_load_kg(ex, ctx=None):
    """Prescribed load for the TONNAGE axis.

    Separate from `_slot_load_kg` on purpose: that one also feeds the AXIAL
    (spinal) axis, where an assist counterweight means something else again.
    Here the question is "how much did the owner move", so an assisted slot
    resolves to bodyweight - prescribed counterweight. None stays None
    (unmeasurable, declared in `skipped` by the caller)."""
    kg = _slot_load_kg(ex)
    if kg is None or ctx is None or not ex.get('assisted'):
        return kg
    bw = ctx.bodyweight(None)          # prescription side -> latest weigh-in
    if bw is None:
        return None                    # unmeasurable, not zero
    return max(float(bw) - kg, 0.0)


def proposed_subregion_tonnage(program, submap, db_path=None,
                               exclude_session_id=None):
    """{subregion: prescribed weekly kg x reps x sub-region weight}. Slots with
    no weight_kg or no rep_range contribute nothing and are listed in
    `skipped` -- an unmeasurable slot is declared, never silently zeroed.

    ASSIST INVERSION: an assisted slot's prescribed load is
    (bodyweight - counterweight), so the proposed side speaks the same unit as
    the measured side below."""
    ctx = _assist_ctx(db_path)
    out = {}
    skipped = []
    rotation = program.get('rotation') or []
    days = program.get('days') or {}
    freq, _ = program_weekly_frequency(program)
    factor = (freq / len(rotation)) if rotation else 1.0
    for day in rotation:
        type_id = resolve_session_type_id(db_path, day) if db_path else None
        for ex in ((days.get(day) or {}).get('exercises') or []):
            if not isinstance(ex, dict):
                continue
            name = ex.get('name', '')
            subs = submap.get(name)
            if not name or not subs:
                continue
            ex = _with_resolved_base(ex, db_path, type_id, exclude_session_id)
            kg = _slot_volume_load_kg(ex, ctx)
            reps = _rep_mid(ex)
            if kg is None or reps is None:
                if name not in skipped:
                    skipped.append(name)
                continue
            work = float(ex.get('sets', 3)) * kg * reps * factor
            for sub, weight, _grade in subs:
                out[sub] = out.get(sub, 0.0) + work * weight
    return out, skipped


def actual_subregion_tonnage(db_path, today, exclude_session_id=None):
    """{subregion: kg x reps x sub-region weight over the rolling 7d window}.
    WORKING SETS ONLY (set_seq >= 1): the owner's 2026-08-22 ruling is that
    ramp/warm-up sets are excluded from volume and progression. The legacy
    actual_sets / actual_subregion_sets queries still count every row -- that
    is a KNOWN, separately-ticketed defect (briefing 6-(a): +10.0 sets on 등).
    This is a NEW axis, so it starts on the correct side of that ruling rather
    than inheriting the bug for symmetry."""
    out = {}
    conn = _db_connect(db_path)
    try:
        # ASSIST INVERSION: an assisted set's tonnage unit is
        # (bodyweight_at_the_time - counterweight) x reps. Degrades to the
        # original expression on a DB with no assist taxonomy.
        _load = (_AL.effective_load_sql(db_path, "s") if _AL is not None
                 else "COALESCE(s.weight_kg, 0)")
        rows = conn.execute(
            "SELECT es.subregion, SUM((%s) * s.reps * es.weight) " % _load +
            "FROM workout_sets s "
            "JOIN workouts w ON w.id = s.session_id "
            "JOIN exercise_subregion es ON es.exercise_name = s.exercise_name "
            "WHERE " + _WINDOW_PRED + " "
            "  AND s.set_seq >= 1 AND s.weight_kg IS NOT NULL "
            "GROUP BY es.subregion",
            (today, today, exclude_session_id, exclude_session_id),
        ).fetchall()
    except sqlite3.OperationalError:
        return out
    finally:
        conn.close()
    for sub, kg in rows:
        out[sub] = float(kg or 0.0)
    return out


def load_layer(program, db_path, today, exclude_session_id=None):
    """Tonnage axis, UNBANDED, alongside the set-count axis. Returns
    (per_subregion, per_group, skipped). Empty when the sub-region table is
    absent (the whole layer then degrades to a no-op, like subregion_layer)."""
    submap = get_subregion_map(db_path)
    if not submap:
        return {}, {}, []
    _use_tax_db(db_path)          # SUBREGION_GROUP is DB-backed -- bind it here
    proposed, skipped = proposed_subregion_tonnage(program, submap, db_path,
                                                   exclude_session_id)
    actual = actual_subregion_tonnage(db_path, today, exclude_session_id)
    per_subregion = {}
    for sub in sorted(set(proposed) | set(actual) | set(SUBREGION_GROUP)):
        per_subregion[sub] = {
            'proposed_weekly_kg': round(proposed.get(sub, 0.0), 1),
            'actual_kg_7d':       round(actual.get(sub, 0.0), 1),
            'banding_unit':       SUBREGION_GROUP.get(sub, sub),
        }
    per_group = {}
    for unit in GROUP_BANDS_4:
        members = [s for s, u in SUBREGION_GROUP.items() if u == unit]
        per_group[unit] = {
            'proposed_weekly_kg': round(
                sum(proposed.get(s, 0.0) for s in members), 1),
            'actual_kg_7d': round(
                sum(actual.get(s, 0.0) for s in members), 1),
            'members': sorted(members),
            'banded': False,      # deliberate: no researched tonnage landmark
        }
    return per_subregion, per_group, skipped


