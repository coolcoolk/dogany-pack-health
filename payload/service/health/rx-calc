def calc_rx(program_yaml_path, today, db_path, exclude_session_id=None,
            hydrate=False, rotation_day_override=None):
    """
    Run the full deterministic rx calculation.
    Returns the output JSON dict (not serialized).
    Raises SystemExit on fatal errors.
    exclude_session_id (DGN-316 M-5): today's open placeholder session id,
    when one exists -- excluded from every fatigue/aggregation read so a
    mid-day re-derivation never consumes its own partial session.
    hydrate (DGN-773): when True, re-attach full safety_note prose from the
    program-history.json sidecar to the resolved day's slots so the emitted
    JSON carries the injury/safety context (the SESSION_START path + CLI).
    Left False on the per-set hot path (set-arm/set-table) which never reads
    safety_note, so those calls do not pay the sidecar load.

    rotation_day_override (2026-08-23, the MAKEUP blank-WT defect): the split
    the caller is ACTUALLY serving. select_rotation_day() is a pure queue
    advance -- it answers "which REGULAR day comes next", which is the right
    answer for SESSION_START and the WRONG answer for a 보충 session, where the
    lifter is training some other split entirely. The render layer (set-table
    find_day_and_slot / set-arm find_slot) already resolves the trained split
    from workouts.session_type_id, but had no way to TELL this function, so
    calc_rx prescribed 앞A while the card rendered 뒷B: every name -> slot
    lookup missed, weight_kg came back None, the 표2 WT column went blank, the
    armed argv carried no --weight, set-add refused the write and 세트볼륨 read
    0 -- while the prose layer (which reads program.yaml directly) quoted the
    correct numbers. Supplying the served day here makes the whole downstream
    chain follow it: day_plan, rotation_type_id and therefore
    get_last_session_result -- which is intended, a makeup session training 뒷B
    SHOULD progress from the last 뒷B, not from the last 앞A.

    Ignored when it is not a key of program['days'] (unknown/garbage day, and
    notably the literal '보충' session_type code, which is a session CLASS and
    never a program day) -- the queue answer stands.

    CONTRACT (workout-session SKILL.md 527-532 / workout-program SKILL.md
    698-702): the EMITTED 'rotation_day' key keeps carrying the QUEUE answer
    even when the override applies. That key plus 'session_class' is what
    SESSION_START routes makeup detection off; letting the override rewrite it
    would invert the very verdict that produced the override.

    A 'served_day' key was added here the same day and carried the resolved
    day back out. It was dropped again on 2026-08-23 with NO reader anywhere in
    the pack: the override value is produced by exactly one resolver
    (set-table.find_day_and_slot, which set-arm now delegates to), and that
    resolver returns either a key of program['days'] or None -- so the served
    day is always, by construction, the day the caller just passed in, and the
    receipt carried no information the caller did not already hold. Re-add it
    the day a caller exists that cannot know its own override.
    """
    from free_session import effective_path
    program_yaml_path = effective_path(program_yaml_path, db_path, exclude_session_id)
    if not os.path.exists(program_yaml_path):
        print(f'[rx-calc] ERROR: program.yaml not found: {program_yaml_path}', file=sys.stderr)
        sys.exit(1)

    program = load_yaml(program_yaml_path)
    if not isinstance(program, dict):
        print(f'[rx-calc] ERROR: program.yaml did not parse as a dict', file=sys.stderr)
        sys.exit(1)

    # Rotation selection
    rotation_day, rotation_basis, provisional = select_rotation_day(
        program, db_path, exclude_session_id=exclude_session_id)
    if rotation_day is None:
        print(f'[rx-calc] ERROR: {rotation_basis}', file=sys.stderr)
        sys.exit(1)

    # The QUEUE answer, kept verbatim for the emitted 'rotation_day' key (see
    # the CONTRACT paragraph in the docstring). Everything else below follows
    # the SERVED day.
    queue_rotation_day = rotation_day
    _days_probe = program.get('days')
    if (rotation_day_override
            and isinstance(_days_probe, dict)
            and rotation_day_override in _days_probe):
        rotation_day = rotation_day_override
        rotation_basis = (
            f'served day supplied by the caller: {rotation_day} '
            f'(the split this session is actually training; the rotation '
            f'queue is at {queue_rotation_day})')
        provisional = False

    # DGN-773: on-demand injury/safety context -- only the resolved rotation
    # day's slots need it, so hydrate after rotation is known.
    if hydrate:
        hydrate_safety_notes(
            program, rotation_day, load_history_sidecar(program_yaml_path))

    # Get the exercises for this rotation day
    days = program.get('days', {})
    if not isinstance(days, dict):
        print(f'[rx-calc] ERROR: program.yaml "days" must be a mapping', file=sys.stderr)
        sys.exit(1)

    day_plan = days.get(rotation_day)
    if day_plan is None:
        print(f'[rx-calc] ERROR: rotation day {rotation_day!r} not in program.yaml days',
              file=sys.stderr)
        sys.exit(1)

    exercises_raw = day_plan.get('exercises', [])
    if not isinstance(exercises_raw, list):
        exercises_raw = []

    # Process each exercise: apply progression from last session results
    exercises_out = []
    all_calibration = True
    progression_modes = []   # parallel to exercises_out (DGN-316 hold exempt)
    needs_lattice_out = []   # F17: discrete-load slots with an unstamped grid

    # DGN-303 5.2: get_last_session_result matches on session_type_id (INTEGER
    # PK), not the rotation_day code. Resolve it once for this rotation day.
    rotation_type_id = resolve_session_type_id(db_path, rotation_day)

    # DGN-388 rest factor model: resolve the fatigue_cost + pattern maps ONCE
    # (not per slot). Empty dicts when the tables are absent -> resolve_rest_sec
    # degrades fatigue_adj to 0 gracefully.
    rest_cost_map = get_fatigue_cost_map(db_path)
    rest_pattern_map = get_pattern_map(db_path)

    for ex_raw in exercises_raw:
        if not isinstance(ex_raw, dict):
            continue

        # Look up top-set result for this slot from the structured workout_sets.
        # DGN-735 (F7): pass exclude_session_id so a mid-session lookup skips
        # today's own (ramp/partial) sets -- the set_seq>0 guard filters ramps,
        # this guard filters today's session entirely.
        # Kit 062: the confirmed machine scopes every history read below.
        _mach, _mach_state = (
            _machine_scope(db_path, ex_raw.get('name', ''), exclude_session_id)
            if program.get('session_mode') != 'free' else (None, None))
        _hist_mach = _mach if _mach_state == 'own' else None
        top_set_reps, reported_weight = get_last_session_result(
            db_path, ex_raw.get('name', ''), rotation_type_id,
            exclude_session_id=exclude_session_id, machine=_hist_mach
        )
        if _mach_state == 'calibrate':
            # no result on this machine: no progression step on another one's
            top_set_reps, reported_weight = None, None

        if program.get('session_mode') == 'free':
            from free_session import history_result
            top_set_reps, reported_weight = history_result(
                db_path, ex_raw.get('name', ''), exclude_session_id)
            ex_raw = dict(ex_raw, weight_kg=reported_weight)
        else:
            # A1 before A2: fix the hold class on the slot BEFORE its weight
            # is filled, so a hold that gets a logged load stays a hold for
            # every reader of the processed dict below (target RIR, rest).
            if (not ex_raw.get('rep_unit')
                    and _is_isometric_hold(ex_raw, db_path)):
                ex_raw = dict(ex_raw, rep_unit='sec')
            # A2: the base is the last LOGGED working load; the card's
            # weight_kg is only the seed before anything was logged.
            base, base_src = resolve_base_weight(
                db_path, ex_raw.get('name', ''), rotation_type_id,
                exclude_session_id=exclude_session_id,
                seed=ex_raw.get('weight_kg'), machine=_hist_mach)
            # A3: the streak BEFORE the last session (apply_progression adds
            # the last session's own miss).
            streak = derive_miss_streak(
                db_path, ex_raw.get('name', ''), rotation_type_id,
                ex_raw.get('rep_range') or [6, 10],
                exclude_session_id=exclude_session_id,
                machine=_hist_mach) if _mach_state != 'calibrate' else 0
            if _mach_state == 'calibrate' and base_src != 'seed':
                base_src = 'machine_seed' if base is not None else base_src
            ex_raw = dict(ex_raw, weight_kg=base, base_source=base_src,
                          miss_streak=max(streak - 1, 0))
            if _mach:
                ex_raw['machine_state'] = _mach_state
        # A5: the grid this slot snaps to -- card override, else the
        # session's machine (kit 062), else the equipment class.
        _lat, _lat_src = resolve_lattice(ex_raw, db_path, exclude_session_id)
        if _lat_src in ('machine', 'class'):
            ex_raw = dict(ex_raw, lattice=_lat, lattice_source=_lat_src)
        ex_processed = apply_progression(ex_raw, top_set_reps)
        # DGN-387: snap the prescribed weight onto the slot's equipment lattice
        # so the card never shows a load the machine cannot physically hold.
        ex_processed = snap_exercise_weight(ex_processed)
        # Owner ruling 2026-09-30: sufficient observed data -> e1RM-based
        # weight + rep target; otherwise the progression above, untouched.
        ex_processed = apply_rx_basis(ex_processed, db_path,
                                      exclude_session_id=exclude_session_id,
                                      today=today, machine=_mach)

        # Build output exercise entry
        out_ex = {
            'slot':               ex_processed.get('slot', 0),
            'name':               ex_processed.get('name', ''),
            'display':            ex_processed.get('display', ex_processed.get('name', '')),
            'weight_kg':          ex_processed.get('weight_kg'),
            'sets':               ex_processed.get('sets', 3),
            'rep_range':          ex_processed.get('rep_range', [6, 10]),
            'target_rir':         resolve_target_rir(ex_processed),  # RC1: [lo,hi]|None
            # G19: the declared safety cap itself, carried alongside the band it
            # already shaped. target_rir says "aim here"; rir_floor says "and
            # this is a floor, not a suggestion" -- a consumer that wants to flag
            # a BREACH (owner logged below the cap) needs the cap as a number,
            # and re-deriving it downstream is how the two drift apart.
            'rir_floor':          resolve_rir_floor(ex_processed),   # G19: int|None
            'safety_note':        ex_processed.get('safety_note'),
            'focus_slot':         bool(day_plan.get('focus_slot') and
                                       ex_processed.get('slot') == day_plan.get('focus_slot')),
            'calibration':        ex_processed.get('calibration', False),
            'progression_applied': ex_processed.get('progression_applied', 'none'),
            'inc_override':       ex_processed.get('inc_override'),
            'loading':            ex_processed.get('loading'),  # DGN-387 per_side|total|None
            # 2026-09-30: the rep target moves with the load (e1RM path: reps
            # at the rounded load; progression 'up': rep_range bottom).
            'target_reps':        ex_processed.get('target_reps'),
            'rx_basis':           ex_processed.get('rx_basis'),
        }
        # DGN-388: authoritative rest (designated sec) + basis for this slot.
        rest_sec, rest_basis = resolve_rest_sec(
            ex_processed, program, rest_cost_map, rest_pattern_map)
        out_ex['rest_sec'] = rest_sec
        out_ex['rest_basis'] = rest_basis

        # F17: discrete-load machine with an unstamped/malformed lattice. The
        # snap above was a no-op (no usable lattice), so weight_kg is the raw
        # math -- possibly not physically loadable. Flag the slot so the card
        # does not present a false-precise weight as authoritative, and record
        # the JIT ask (missing type/base/step). Additive, non-breaking: no key
        # is added to slots that do not trigger.
        if needs_lattice(ex_processed):
            out_ex['lattice_unstamped'] = True
            ask = {
                'slot':    out_ex['name'],
                'display': out_ex['display'],
                'loading': out_ex['loading'],
                'need':    ['type', 'base', 'step'],
            }
            # A5 / kit 062: when the lift runs on a known machine, the stated
            # stack belongs to THAT machine (lattice-set --machine).
            _mc = _machine_capture()
            try:
                _hit = (_mc.machine_for(db_path, exclude_session_id,
                                        out_ex['name']) if _mc else None)
            except Exception:  # noqa: BLE001
                _hit = None
            if _hit:
                ask['machine'] = _hit[0]
            needs_lattice_out.append(ask)

        exercises_out.append(out_ex)
        progression_modes.append(ex_raw.get('progression', 'double'))

        if not out_ex['calibration']:
            all_calibration = False

    # All exercises are calibration mode if every slot has weight_kg=null
    if not exercises_out:
        all_calibration = True

    # ------------------------------------------------------------------
    # DGN-316 6.3: per-muscle fatigue stage (volume-side only). Runs AFTER
    # the per-exercise progression processing -- sets is not a progression
    # output, so ordering is safe (OQ-V9b confirmed). The trim never
    # touches weight_kg. Degrades to a no-op when the W03 exercise_muscle
    # table is absent (older instances): no trim, no muscle_state key,
    # output byte-identical to pre-DGN-316.
    # ------------------------------------------------------------------
    muscle_map = get_muscle_map(db_path)
    if muscle_map:
        fatigue = muscle_fatigue(program, db_path, today,
                                 exclude_session_id, muscle_map=muscle_map)
        fatigued = {m for m, v in fatigue.items() if v['state'] == 'fatigued'}
        for out_ex, mode in zip(exercises_out, progression_modes):
            if mode == 'hold':
                continue    # F-B1 lesson at volume scope: rehab inviolable
            prim = {mu for (mu, role) in muscle_map.get(out_ex['name'], [])
                    if role == 'primary'}
            if prim & fatigued:
                # ONE TRIM PER EXERCISE (m-3): max of fatigued muscles,
                # never additive per muscle. Secondary roles NOT trimmed.
                orig = out_ex['sets']
                trimmed = max(orig - MUSCLE_FATIGUE_TRIM,
                              MUSCLE_TRIM_FLOOR_SETS)
                if trimmed < orig:
                    out_ex['sets'] = trimmed
                    out_ex['fatigue_trim'] = True
                    out_ex['sets_untrimmed'] = orig
        # muscle_state: non-fresh muscles + all of today's-day muscles
        # (keeps JSON small, spec 6.3 item 3).
        today_muscles = set()
        for out_ex in exercises_out:
            today_muscles |= {mu for (mu, _role)
                              in muscle_map.get(out_ex['name'], [])}
        muscle_state = {}
        for m in fatigue:
            v = fatigue[m]
            if v['state'] != 'fresh' or m in today_muscles:
                muscle_state[m] = {
                    'state': v['state'],
                    'signals': v['signals'],
                    'actual_sets_7d': v['actual_sets_7d'],
                }

    # ------------------------------------------------------------------
    # Session warmup / mobility prep, read from prep.yaml -- THE canonical prep
    # source of truth (2026-08-21 collapse; was warmup.yaml, which was one of
    # three disagreeing copies). The emitted shape is UNCHANGED:
    #   warmup.mat_prep       = session-start bodyweight/band drills
    #   warmup.equipment_prep = needs equipment (bench/chair/band) but is NOT
    #                           bound to one slot -- its own unbound block,
    #                           never folded into mat_prep
    #   <exercise>.pre_slot_prep = that slot's card drills joined into one
    #                           string (sparse: absent on slots with no entry)
    # Optional enrichment: prep.yaml missing or rotation_day not declared ->
    # no 'warmup' key, no stamping, output identical to pre-prep consumers.
    # ------------------------------------------------------------------
    prep = load_prep(program_yaml_path)
    warmup_out = None
    card_blocks = prep_card_blocks(prep, rotation_day)
    mat_prep = card_blocks.get('mat_prep')
    if mat_prep:
        warmup_out = {'mat_prep': mat_prep}
    equipment_prep = card_blocks.get('equipment_prep')
    if equipment_prep:
        if warmup_out is None:
            warmup_out = {}
        warmup_out['equipment_prep'] = equipment_prep
    slot_strings = prep_card_slot_strings(prep, rotation_day)
    if slot_strings:
        for out_ex in exercises_out:
            val = slot_strings.get(_prep_slot_int(out_ex.get('slot')))
            if val:
                out_ex['pre_slot_prep'] = val

    # ------------------------------------------------------------------
    # Cooldown block (NEW 2026-08-22). Peer of prep and work, `volume: false`
    # -- nothing here is a set, and it is emitted on its own top-level key
    # rather than inside `warmup` because the two render at opposite ends of
    # the card. Sparse in the same way as `warmup`: no cooldown declared for
    # the day -> no 'cooldown' key -> a consumer that predates this block sees
    # byte-identical output.
    #   cooldown.session   = performed at closeout, after every slot
    #   <exercise>.post_slot_cooldown = that slot's cooldown drills, joined
    #                        (empty today; no item carries a card_slot)
    # ------------------------------------------------------------------
    cooldown_session = cooldown_card_items(prep, rotation_day)
    cooldown_out = {'session': cooldown_session} if cooldown_session else None
    cd_slot_strings = cooldown_card_slot_strings(prep, rotation_day)
    if cd_slot_strings:
        for out_ex in exercises_out:
            val = cd_slot_strings.get(_prep_slot_int(out_ex.get('slot')))
            if val:
                out_ex['post_slot_cooldown'] = val

    # C1 (2026-08-01): deterministic regular/makeup verdict from measured
    # weekly state. rotation_day above stays the next-in-queue slot (used when
    # regular resumes); session_class is what SESSION_START routes off.
    # G1 (2026-08-23): forward exclude_session_id -- the open session we are
    # serving must not be counted as one of the week's already-done splits, or
    # it flips its own label to '보충' as soon as it records its first set.
    week_status = week_regular_status(program, db_path, today,
                                      exclude_session_id=exclude_session_id)

    result = {
        # NOT the served day -- see calc_rx's CONTRACT paragraph. This stays the
        # rotation QUEUE's answer so SESSION_START's makeup detection cannot be
        # inverted by the override that makeup detection itself produced.
        'rotation_day':     queue_rotation_day,
        'rotation_basis':   rotation_basis,
        'provisional_tag':  provisional,
        'session_class':    ('free' if program.get('session_mode') == 'free'
                             else week_status['session_class']),
        'week_regular':     {
            'done':       week_status['week_regular_done'],
            'target':     week_status['week_regular_target'],
            'done_codes': week_status['done_codes'],
            'week_start': week_status['week_start'],
            'week_end':   week_status['week_end'],
        },
        'exercises':        exercises_out,
        # F17: JIT lattice asks. Empty list when every discrete-load slot has a
        # usable lattice -- always present, always a list (additive, stable key).
        'needs_lattice':    needs_lattice_out,
        'flags': {
            'all_calibration':      all_calibration,
            'needs_reconcile':      False,  # set by rx-gen if new safety rows detected
            'provisional_rotation': provisional,
        },
    }
    if muscle_map:
        result['muscle_state'] = muscle_state   # DGN-316 6.3 item 3
    if warmup_out:
        result['warmup'] = warmup_out
    if cooldown_out:
        result['cooldown'] = cooldown_out
    return result


