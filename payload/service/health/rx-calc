def get_subregion_map(db_path):
    """exercise_subregion mapping: {exercise_name: [(subregion, weight, grade)]}.
    Empty dict when the table is absent -- the whole sub-region layer then
    degrades to a no-op (group layer + backward-compat output unchanged)."""
    conn = _db_connect(db_path)
    try:
        rows = conn.execute(
            "SELECT exercise_name, subregion, weight, grade "
            "FROM exercise_subregion"
        ).fetchall()
    except sqlite3.OperationalError:
        return {}
    finally:
        conn.close()
    out = {}
    for name, sub, weight, grade in rows:
        out.setdefault(name, []).append((sub, float(weight), grade))
