# ---------------------------------------------------------------------------
# Minimal YAML loader (stdlib only -- handles program.yaml superset needed)
# Supports: key: value, key: null, key: [a, b], nested dicts, lists of dicts,
# block sequences (  - key: val), quoted strings, inline lists, inline dicts.
# Does NOT support multi-line strings, anchors, or tags.
# ---------------------------------------------------------------------------

def _yaml_value(s):
    """Parse a scalar YAML value string into a Python object."""
    s = s.strip()
    if s == 'null' or s == '~' or s == '':
        return None
    if s == 'true':
        return True
    if s == 'false':
        return False
    # inline list [a, b, c]
    if s.startswith('[') and s.endswith(']'):
        inner = s[1:-1].strip()
        if not inner:
            return []
        items = [_yaml_value(x.strip()) for x in _split_csv(inner)]
        return items
    # inline dict {k: v}
    if s.startswith('{') and s.endswith('}'):
        try:
            return json.loads(s)
        except ValueError:
            pass
        inner = s[1:-1].strip()
        if not inner:
            return {}
        result = {}
        for pair in _split_csv(inner):
            k, _, v = pair.partition(':')
            result[k.strip()] = _yaml_value(v)
        return result
    # quoted string
    if (s.startswith('"') and s.endswith('"')) or \
       (s.startswith("'") and s.endswith("'")):
        return s[1:-1]
    # number
    try:
        if '.' in s:
            return float(s)
        return int(s)
    except ValueError:
        pass
    return s  # bare string


def _split_csv(s):
    """Split on commas, respecting brackets and quotes."""
    items = []
    depth = 0
    current = []
    in_quote = None
    for ch in s:
        if in_quote:
            current.append(ch)
            if ch == in_quote:
                in_quote = None
        elif ch in ('"', "'"):
            in_quote = ch
            current.append(ch)
        elif ch in ('[', '{'):
            depth += 1
            current.append(ch)
        elif ch in (']', '}'):
            depth -= 1
            current.append(ch)
        elif ch == ',' and depth == 0:
            items.append(''.join(current).strip())
            current = []
        else:
            current.append(ch)
    if current:
        items.append(''.join(current).strip())
    return items


# ---------------------------------------------------------------------------
# SLOT ORDERING -- `priority` is the single order authority (2026-08-24).
#
# Rule, approved 2026-08-24 (rehab slots go first; folded into the program
# setup rules), extending 2026-08-21 (what sits in front matters more than
# whatever gets cut off the back). A session ends when it ends, so the only
# way to protect a rehab / focus slot from the cut line is to place it ahead of
# that line at program-design time.
#
# The rule used to live in prose and cost real training (08-20 ate the knee
# rehab slot, 08-21 ate the day's back focus slot). It now lives in DATA
# (program.yaml `priority` / `role`, band contract in that file's header) and
# is applied HERE, in the one place every consumer already funnels through:
# load_yaml. set-table / set-arm / exercise-enter / session-open /
# session-cursor all call rx.load_yaml, so none of them can see -- or invent --
# a different order. There is exactly ONE ordering, and it is this sort.
#
# File order is kept in sync with priority order deliberately (a human reading
# program.yaml must see the true order), and tests/test-slot-priority.py fails
# if the two ever disagree. That test is the anti-drift guard, not this sort.
# ---------------------------------------------------------------------------

# A slot with no declared priority sinks BELOW every declared one while keeping
# its relative file position (the +index tiebreak). Production program.yaml
# declares priority on every slot, so this only ever fires for a synthetic /
# partial day dict built in a test -- where it degrades to "leave the order
# alone" rather than silently shuffling.
UNPRIORITIZED_BASE = 100000


def slot_priority(ex, index=0):
    """This slot's ordering key. Lower = performed earlier."""
    if isinstance(ex, dict):
        p = ex.get('priority')
        if isinstance(p, bool):
            p = None
        if isinstance(p, int):
            return p
        if isinstance(p, float):
            return int(p)
        if isinstance(p, str):
            try:
                return int(p.strip())
            except ValueError:
                pass
    return UNPRIORITIZED_BASE + index


def order_day_exercises(exercises):
    """Return the day's exercises in PRIORITY order (stable; never raises).

    Non-dict entries keep their position via the index tiebreak, so a malformed
    line can never reshuffle the day."""
    if not isinstance(exercises, list):
        return exercises
    indexed = list(enumerate(exercises))
    indexed.sort(key=lambda pair: (slot_priority(pair[1], pair[0]), pair[0]))
    return [ex for _i, ex in indexed]


def apply_slot_priority_order(data):
    """In-place: sort every `days.<day>.exercises` list by `priority`.

    Scoped to PROGRAM-shaped data on purpose -- load_yaml is also the loader
    for prep.yaml, whose `days.<day>` blocks carry prep/cooldown lists and no
    `exercises` key, so they are untouched."""
    if not isinstance(data, dict):
        return data
    days = data.get('days')
    if not isinstance(days, dict):
        return data
    for _day, day_plan in days.items():
        if not isinstance(day_plan, dict):
            continue
        items = day_plan.get('exercises')
        if isinstance(items, list):
            day_plan['exercises'] = order_day_exercises(items)
    return data


def load_yaml(path):
    """Load program.yaml into a Python dict. Hand-rolled for stdlib-only.

    The day's `exercises` come back in `priority` order -- see
    apply_slot_priority_order. This is the fleet's single ordering choke
    point; do not re-sort downstream."""
    with open(path, 'r', encoding='utf-8') as f:
        lines = f.readlines()
    if ''.join(lines).lstrip().startswith('{'):
        return apply_slot_priority_order(json.loads(''.join(lines)))
    return apply_slot_priority_order(_parse_yaml_lines(lines))


