_PREP_CACHE = {}


def load_prep(program_yaml_path):
    """Load prep.yaml (the canonical prep SoT) from the program.yaml directory.

    Cached by (path, mtime, size) -- the card path must never re-parse per
    render. Optional enrichment: a missing file or any parse error returns {}
    so rx output degrades to the pre-prep shape with no crash.

    A FREE-SESSION file (files/program/.free-sessions/*.json) carries its
    own composed prep/cooldown day: the owner's prep.yaml with that day
    merged in (free_session.free_prep), so every prep surface -- PREP_ENTRY,
    the F14 gate, the tables, the pin's prep cell, the cooldown -- serves a
    free session through this same reader."""
    try:
        from free_session import free_prep
        free = free_prep(program_yaml_path, load_yaml)
    except Exception:  # noqa: BLE001 -- a free-prep miss degrades to none
        free = None
    if free is not None:
        return free
    from session_day_trim import source_path
    path = os.path.join(os.path.dirname(os.path.abspath(source_path(program_yaml_path))),
                        'prep.yaml')
    try:
        st = os.stat(path)
        key = (path, st.st_mtime_ns, st.st_size)
    except OSError:
        return {}
    hit = _PREP_CACHE.get(path)
    if hit is not None and hit[0] == key:
        return hit[1]
    try:
        data = load_yaml(path)
    except Exception:  # noqa: BLE001 -- a bad edit degrades, never crashes
        return {}
    if not isinstance(data, dict):
        data = {}
    _PREP_CACHE[path] = (key, data)
    return data


# ---------------------------------------------------------------------------
# BLOCK REGISTRY (2026-08-22) -- a training day is THREE PEER COLLECTIONS.
#
# Owner ruling 2026-08-21: prep and cooldown are SLOT-EQUAL with work
# exercises, their drills SET-EQUAL with working sets. So the day's shape is
#     day -> [prep block] [work block] [cooldown block]
# not "a work list with warmup annotations hanging off some of its items".
#
# SLOT-EQUAL IS A SCHEMA STATEMENT, NOT A VOLUME STATEMENT. Being a peer of
# `work` does not make a drill training volume, and this is the file where that
# line is enforced rather than assumed:
#
#   * NON_VOLUME_KINDS is FORCED. block_registry() overrides whatever
#     prep.yaml says for those kinds, so a bad edit (`volume: true` under
#     cooldown) cannot leak a drill into an aggregate.
#   * day_work_items() is the ONE accessor every aggregation path uses, and it
#     serves the work block only. proposed_sets / programmed_muscles (and thus
#     --volume-audit, the muscle-volume tables and the weekly prescription)
#     route through it. Nothing else is volume-eligible.
#   * The pre-existing accidental protections still hold and are unchanged:
#     set-arm's resolve_hold_slot_num() returns None for a non-slot exercise
#     (hold chain terminates inert, no workout_sets row) and a prep drill has
#     no exercise_muscle mapping to join on. Those were accidents; the two
#     rules above are the deliberate version.
#
# WHY WORK ITEMS STILL LIVE IN program.yaml: physically relocating
# `days.<day>.exercises` into a blocks list is the change the slotting spec
# flagged as the highest-risk item in the whole design -- 8 direct consumers
# index that key, set-add's two line-based regex scanners (`_slot_display`,
# `_lattice_type`) silently return empty on an indentation change, and
# health_metrics._program_key_lifts() falls back to a hardcoded list without
# erroring. This wave keeps that key exactly where it is and expresses the peer
# relationship through the registry + day_blocks() instead, so the schema is in
# place with a provable zero-output-delta. Moving the bytes is a later wave
# with its own regression budget.
# ---------------------------------------------------------------------------

WORK_BLOCK_KIND = 'work'

# Kinds that can NEVER be training volume, whatever prep.yaml claims.
NON_VOLUME_KINDS = frozenset(('prep', 'cooldown'))

# Fallback used when prep.yaml is missing/unparseable. Must keep work
# volume-eligible so a degraded prep.yaml never silently zeroes the weekly
# prescription.
DEFAULT_BLOCK_REGISTRY = (
    {'kind': 'prep',     'order': 1, 'volume': False,
     'source': 'prep.yaml days.<day>.prep'},
    {'kind': 'work',     'order': 2, 'volume': True,
     'source': 'program.yaml days.<day>.exercises'},
    {'kind': 'cooldown', 'order': 3, 'volume': False,
     'source': 'prep.yaml days.<day>.cooldown'},
)


def block_registry(prep):
    """The day's peer blocks in performance order: [{kind, order, volume,
    source}, ...].

    Reads prep.yaml `blocks:`; falls back to DEFAULT_BLOCK_REGISTRY when that
    key is absent or malformed (same degrade-never-raise contract as the rest
    of the prep loader). `volume` is FORCED False for NON_VOLUME_KINDS -- the
    aggregation guard is not negotiable by data."""
    raw = (prep or {}).get('blocks')
    if not isinstance(raw, list) or not raw:
        raw = DEFAULT_BLOCK_REGISTRY
    out = []
    seen = set()
    for b in raw:
        if not isinstance(b, dict):
            continue
        kind = b.get('kind')
        if not kind or kind in seen:
            continue
        seen.add(kind)
        vol = bool(b.get('volume'))
        if kind in NON_VOLUME_KINDS:
            vol = False          # forced -- see NON_VOLUME_KINDS above
        try:
            order = int(b.get('order'))
        except (TypeError, ValueError):
            order = len(out) + 1
        out.append({'kind': kind, 'order': order, 'volume': vol,
                    'source': b.get('source')})
    if not any(b['kind'] == WORK_BLOCK_KIND and b['volume'] for b in out):
        # A registry that lost the work block (or its volume flag) would zero
        # every aggregate. Refuse it and use the built-in.
        return [dict(b) for b in DEFAULT_BLOCK_REGISTRY]
    out.sort(key=lambda b: b['order'])
    return out


def day_work_items(program, day):
    """The day's WORK items -- program.yaml `days.<day>.exercises`.

    THE single volume-eligible collection. Every aggregation path goes through
    here; a prep or cooldown drill can never appear in the result, because this
    function does not read prep.yaml at all. [] when absent/malformed."""
    days = (program or {}).get('days')
    if not isinstance(days, dict):
        return []
    day_plan = days.get(day)
    if not isinstance(day_plan, dict):
        return []
    items = day_plan.get('exercises')
    if not isinstance(items, list):
        return []
    return [e for e in items if isinstance(e, dict)]


# -- Practice rows are not hypertrophy volume (owner ruling 2026-10-04). ------
# A set's PURPOSE decides its ledger: a goal-strand practice row (roll-down for
# breath+trunk control, bear crawl / get-up for whole-body linking) is control /
# connection work, not muscle-growth volume, so it never counts toward the
# weekly-set band (proposed or actual). Loaded functional moves straddle both
# purposes (owner ruling 2026-10-04 11:21): a kettlebell swing, a loaded get-up
# count HALF a set toward their mapped muscles. The factor is data --
# compose_rank_rules.json `muscle_credit`, read through
# compose_rank.muscle_credit_table() (a practice-only row left unlisted counts
# 0) -- and loaded vs bodyweight is the slot's load (compose_rank.slot_loaded;
# a logged set: weight_kg > 0). Every listed row is also reported apart
# (volume_audit()['practice']). Import failure -> empty table, i.e. the
# pre-ruling arithmetic, never a crash.
_MUSCLE_CREDIT = None
_CR = None


def muscle_credit_table():
    global _MUSCLE_CREDIT, _CR
    if _MUSCLE_CREDIT is None:
        try:
            import compose_rank as _CR
            _MUSCLE_CREDIT = _CR.muscle_credit_table(_CR.load_rules())
        except Exception:      # noqa: BLE001 -- degrade to pre-ruling count
            _MUSCLE_CREDIT = {}
    return _MUSCLE_CREDIT


def slot_credit(ex):
    """The muscle-set factor of one work slot (1.0 for a hypertrophy lift)."""
    table = muscle_credit_table()
    name = ex.get('name')
    if name not in table:
        return 1.0
    return _CR.muscle_credit(table, name, _CR.slot_loaded(ex))


def volume_work_items(program, day):
    """[(ex, credit)]: the day's work items that count toward the muscle-set
    band, with their factor (slot_credit); zero-credit rows are left out."""
    out = []
    for e in day_work_items(program, day):
        credit = slot_credit(e)
        if credit > 0:
            out.append((e, credit))
    return out


def practice_volume(program):
    """{name: {'sessions_per_week', 'sets_per_week', 'muscle_sets_per_week'}}
    for the functional / practice rows on the card (every muscle_credit row):
    the separate ledger. muscle_sets_per_week = what the band counts of them
    (0 for bodyweight practice, half the sets for a loaded functional move)."""
    table = muscle_credit_table()
    rotation = program.get('rotation') or []
    freq, _ = program_weekly_frequency(program)
    factor = (freq / len(rotation)) if rotation else 1.0
    out = {}
    for day in rotation:
        for ex in day_work_items(program, day):
            name = ex.get('name')
            if name not in table:
                continue
            e = out.setdefault(name, {'sessions_per_week': 0.0,
                                      'sets_per_week': 0.0,
                                      'muscle_sets_per_week': 0.0})
            sets = ex.get('sets', 3)
            e['sessions_per_week'] += factor
            e['sets_per_week'] += sets * factor
            e['muscle_sets_per_week'] += sets * slot_credit(ex) * factor
    return {n: {k: round(v, 2) for k, v in e.items()} for n, e in out.items()}


def _credit_sql():
    """(sql, args): the per-set muscle_credit factor of a logged set `s` --
    a CASE on the exercise name, loaded = weight_kg > 0. ('1.0', ()) when
    the table is empty."""
    table = muscle_credit_table()
    if not table:
        return '1.0', ()
    parts, args = [], []
    for name in sorted(table):
        e = table[name]
        if e['loaded'] == e['bodyweight']:
            parts.append('WHEN ? THEN ?')
            args += [name, e['loaded']]
        else:
            parts.append('WHEN ? THEN (CASE WHEN COALESCE(s.weight_kg, 0) > 0 '
                         'THEN ? ELSE ? END)')
            args += [name, e['loaded'], e['bodyweight']]
    return ('(CASE s.exercise_name %s ELSE 1.0 END)' % ' '.join(parts),
            tuple(args))


def day_blocks(program, prep, day):
    """The day as its three peer collections, in performance order:
        [{'kind': 'prep',     'volume': False, 'items': [...]},
         {'kind': 'work',     'volume': True,  'items': [...]},
         {'kind': 'cooldown', 'volume': False, 'items': [...]}]

    Blocks with no items are still returned (empty `items`) so a caller can
    render/iterate the full day shape without special-casing. This is the
    read-path for anything that needs to see prep/work/cooldown as siblings;
    aggregation must NOT use it -- use day_work_items()."""
    out = []
    for b in block_registry(prep):
        kind = b['kind']
        if kind == WORK_BLOCK_KIND:
            items = day_work_items(program, day)
        elif kind == 'cooldown':
            items = cooldown_day_items(prep, day)
        elif kind == 'prep':
            items = prep_day_items(prep, day)
        else:
            items = _prep_block_items(prep, day, kind)
        out.append({'kind': kind, 'order': b['order'], 'volume': b['volume'],
                    'source': b.get('source'), 'items': items})
    return out


# ---------------------------------------------------------------------------
# THE DRILL CATALOG -- prep.yaml `drills.<code>` is the SoT for a drill's
# INTRINSIC properties; the day list carries only what varies BY DAY.
# (Back-ported from the live engine, 2026-09-11. Round 3, prep-catalog seam.)
# ---------------------------------------------------------------------------
# Measured root of the 2026-09-02 structure wave: every intrinsic property of a
# drill -- what you hold, what it requires, where it is performed, what it
# should feel like -- had NO FIELD, so it was written as free text inside
# `display` and differed day to day for the SAME code. The model could only
# echo the string; it was not being unhelpful, it had nothing to say.
#
# WHY THIS BLOCK HAD TO COME BACK INTO THE PACK. Without it, `_prep_block_items`
# skips any day item that carries no `display` -- and in a catalog-form
# prep.yaml a day item normally carries NO display, because the catalog owns
# the name. So the pack's loader read a modern prep.yaml as an EMPTY prep
# block: no drills, no zones, no requirements, on every surface. Every
# downstream field this pack surfaces (zone, requires, cue, implement) is
# unreachable until resolution happens here.
#
# ROUND 4 (2026-09-11) CLOSES THE HALF ROUND 3 LEFT OPEN. Round 3 back-ported
# the READ half and recorded that `validate_prep` (the BUILD gate that refuses
# an uncatalogued code) and its cue-traceability helpers were deliberately left
# out. They are here now -- the gate below, and cue_source_* above it. The
# runtime policy does NOT change: it stays fail-OPEN but fail-VISIBLE (an
# unresolvable drill still renders, carrying an explicit `schema_violation`
# marker, instead of quietly defaulting into a bucket). The gate is a BUILD
# time refusal and is reachable only through `rx-calc --validate-prep`, so a
# bad edit is caught before a session, never during one.
# ---------------------------------------------------------------------------
# ===========================================================================
# CUE PROVENANCE -- the forcing point for a rule that failed four times.
# ===========================================================================
# THE RULE: a drill cue is QUOTED from stretch-matrix.md, never summarised.
# Standing since 2026-08-07, re-broken 08-10, and broken again by the first cut
# of the 2026-09-02 structure wave, which authored all 32 cue fields from the
# model's own knowledge. K1 came out describing a DIFFERENT MOVEMENT (sitting,
# with the hands-on-tibia rotational torque -- the entire point of a screw-home
# drill -- absent). It reached live.
#
# It failed four times because it lived only in prose. Per the owner's
# 2026-09-02 07:27 prescription rule (instructions are followed ~3.4% of the
# time regardless of forcefulness; only (a) a gate that blocks, (b) code fills
# it in, (c) observe and revert are accepted), a fifth restatement is a
# REJECTED prescription. This is prescription (a).
#
# WHY THIS IS NOT A VIOLATION OF "코드는 이 파일을 절대 읽지 않는다".
# stretch-matrix.md's header demotes it to prose reference and forbids the
# DATA PATH from reading it. That still holds and is unchanged: load_prep(),
# the card path and the live path never open it. This reader runs ONLY inside
# validate_prep() -- the build gate -- where the source document is not data
# being served, it is the thing the data is being checked AGAINST. A checker
# reading the document it checks against is the opposite of a second data path.
#
# THE MATCH RULE, and it is deliberately crude and strict:
#   every content token of a cue string must occur inside that drill's own
#   `### <CODE>.` section of stretch-matrix.md.
# A token is a run of Hangul/latin/digits; tokens shorter than 2 characters are
# skipped (one-syllable Korean stems carry particles that no substring rule can
# strip reliably, and a 1-char token discriminates nothing). A token matches if
# ANY prefix of it of length >= 2 occurs in the section -- that is what absorbs
# Korean particles and endings (정강이를 -> 정강이, 벤치나 -> 벤치) without a
# morphological analyser.
#
# THERE IS NO STOPLIST AND NO SIMILARITY THRESHOLD, on purpose. A threshold is
# a dial someone tunes until the check passes. Measured: the 12 corrected cues
# pass with the stoplist EMPTY, because they were lifted from the source --
# which is the behaviour the gate exists to force. If a future cue needs a word
# the source does not contain, the answer is to put the word in the source (it
# is the owner's document) or to leave the cue absent, not to widen the gate.
#
# WHAT IT CANNOT CATCH, stated rather than discovered later:
#   1. Token-legal nonsense. Real source words reassembled into a sentence the
#      source does not say would pass. It checks WHERE the words came from, not
#      that the meaning survived.
#   2. A wrong source. If stretch-matrix.md itself is wrong, a faithful quote
#      of it passes -- correctly: that content is the owner's to fix.
#   3. Omission. A cue that quotes only half of a load-bearing 실행 line passes.
# It closes exactly one failure mode: text authored from the model's knowledge
# instead of from the file. That is the mode that fired all four times.

CUE_SOURCE_FILENAME = 'stretch-matrix.md'
_CUE_HEADING = re.compile(r'^###\s+(.+?)\s*$')
_CUE_CODE = re.compile(r'\b([A-Z]{1,3}\d[a-z]?)\b')
_CUE_TOKEN = re.compile(r'[0-9A-Za-z가-힣]+')
_CUE_MIN_TOKEN = 2


def cue_source_path(prep_path):
    """stretch-matrix.md beside prep.yaml. Same directory resolution as
    load_prep(), so an isolated tree checks its OWN source and never reaches
    across into live."""
    return os.path.join(os.path.dirname(os.path.abspath(prep_path)),
                        CUE_SOURCE_FILENAME)


def cue_source_sections(text):
    """{drill code: the text of its `### <CODE>.` section}.

    A heading may name several codes ("### U1d / U1e / U1f. 어깨 모빌리티 3종"),
    in which case all of them share the section -- which is honest, because in
    the source they genuinely share one description."""
    out = {}
    codes = []
    buf = []

    def flush():
        for c in codes:
            out.setdefault(c, [])
            out[c].extend(buf)

    for line in (text or '').splitlines():
        m = _CUE_HEADING.match(line)
        if m:
            flush()
            head = m.group(1)
            codes = _CUE_CODE.findall(head.split('.')[0]) or _CUE_CODE.findall(head)
            buf = [line]
        else:
            buf.append(line)
    flush()
    return dict((c, '\n'.join(v)) for c, v in out.items())


def cue_untraced_tokens(cue_text, section_text):
    """The content tokens of `cue_text` that do NOT occur in `section_text`.

    Empty list == every word of the cue came from the source section."""
    bad = []
    for tok in _CUE_TOKEN.findall(cue_text or ''):
        if len(tok) < _CUE_MIN_TOKEN:
            continue
        for n in range(len(tok), _CUE_MIN_TOKEN - 1, -1):
            if tok[:n] in section_text:
                break
        else:
            if tok not in bad:
                bad.append(tok)
    return bad


# PLACEMENT NOTE. This block sits ABOVE the resolution section on
# purpose. It is GATE code, not resolution code, and the artifact suite's
# NOPARSE probe scans the resolution section (ZONE_MAT -> _drill_display)
# for any sign that structure is being recovered from the `display` string.
# The regexes below tokenise a CUE and a MARKDOWN HEADING -- they never
# touch `display` -- but a probe that has to reason about which regex is
# innocent is a probe that gets silenced. Keeping gate code out of the
# scanned span keeps that probe a clean yes/no. The suite asserts
# separately that this block never reads `display`.
ZONE_MAT = 'mat'
ZONE_EQUIPMENT = 'equipment'
PREP_ZONES = (ZONE_MAT, ZONE_EQUIPMENT)

# zone -> the phase it derives. Owner ruling 2026-09-02: the axis is WHERE the
# drill is performed, not whether equipment is involved. A band is portable, so
# a band drill is mat; lying on the floor is mat; a fixed station (machine,
# rack, bench, cable) is equipment. This map is the entire classification rule;
# there is no second place that decides it and no model judgement in the path.
ZONE_PHASE = {ZONE_MAT: 'mat_prep', ZONE_EQUIPMENT: 'equipment_prep'}

# `timing` overrides the zone-derived phase. These are the phases that answer
# WHEN rather than WHERE, and they are the only legal values for the field.
DRILL_TIMINGS = ('immediate_primer', 'cooldown')

# Retired vocabulary. Owner ruling 2026-09-02 06:12, verbatim: "라운드라는 말을
# 만든 게 이상해. 세트가 있는데." The gate refuses it so it cannot return by edit.
RETIRED_TARGET_UNITS = ('rounds',)
LEGAL_TARGET_UNITS = ('reps', 'per_side', 'hold_sets')


def drill_entry(prep, code):
    """The catalog row for `code`, or None. The catalog is the SoT for every
    intrinsic property; a day item may override, it may not originate."""
    glossary = (prep or {}).get('drills')
    if not isinstance(glossary, dict):
        return None
    row = glossary.get(code)
    return row if isinstance(row, dict) else None


def _resolved(prep, code, item, key):
    """Catalog value for `key`, overridden by the day item when the DAY
    DECLARES it. Same glossary-then-override order, and the same
    declared-only rule, as drill_equipment(): a day item that is silent about a
    key inherits the catalog's, it does not blank it."""
    out = None
    src = drill_entry(prep, code)
    for layer in (src, item):
        if isinstance(layer, dict) and layer.get(key) is not None:
            out = layer.get(key)
    return out


def drill_zone(prep, code, item=None):
    """WHERE this drill is performed: 'mat' | 'equipment' | None.

    None means UNDECLARED, and undeclared is a schema violation, not a default.
    Defaulting is precisely what produced the 2026-09-02 D5 defect: two drills
    had no catalog entry at all and the only thing classifying them was a
    hand-typed phase on the day item, typed wrong. A silent default would have
    hidden that exactly as long."""
    z = _resolved(prep, code, item, 'zone')
    return z if z in PREP_ZONES else None


def drill_timing(prep, code, item=None):
    """WHEN this drill fires, when that is not simply "in its zone's block":
    'immediate_primer' | 'cooldown' | None."""
    t = _resolved(prep, code, item, 'timing')
    return t if t in DRILL_TIMINGS else None


def drill_phase(prep, code, item=None):
    """The drill's phase -- DERIVED, not read.

    Order: an explicit day-item `phase` (kept for override and for backward
    compatibility with un-migrated data) -> `timing` -> zone-derived. Returns
    None when nothing decides it, which the fail-visible unknown-phase bucket in
    exercise-enter/set-table already sorts LAST rather than drops."""
    if isinstance(item, dict) and item.get('phase'):
        return item.get('phase')
    timing = drill_timing(prep, code, item)
    if timing:
        return timing
    return ZONE_PHASE.get(drill_zone(prep, code, item))


def drill_cue(prep, code, item=None):
    """{'setup': str, 'sensation': str} with ONLY the keys the data declares.

    `sensation` is the "what it should feel like" field. The knowledge was
    always present and there was nowhere to keep it, so it only ever surfaced
    when the owner asked for it mid-drill.

    {} IS A VALID AND COMMON ANSWER. Never invented, never generated from the
    drill name, never borrowed from a similar drill -- an invented sensation is
    the invented-implement defect one column over, and a confidently wrong
    instruction about how a rehab drill should feel is worse than silence."""
    out = {}
    src = drill_entry(prep, code)
    for layer in (src, item):
        cue = layer.get('cue') if isinstance(layer, dict) else None
        if not isinstance(cue, dict):
            continue
        for key in ('setup', 'sensation'):
            val = cue.get(key)
            if isinstance(val, str) and val.strip():
                out[key] = val.strip()
    return out


def drill_requires(prep, code, item=None):
    """[str, ...] inventory tokens this drill needs, or [].

    THE CONDITION, AS DATA. A condition written inside a display string ("...
    (벤치 시)") could only be read out loud, with ONE completion button behind
    it, leaving the owner nothing to press when the condition was not met. A
    condition stated in prose is a condition that cannot be resolved and cannot
    be answered.

    As a field it can be CHECKED against the inventory before the drill is ever
    spoken. See requirements_unmet()."""
    req = _resolved(prep, code, item, 'requires')
    if isinstance(req, str):
        req = [req]
    if not isinstance(req, list):
        return []
    return [str(r).strip() for r in req if str(r).strip()]


def drill_sets(item):
    """How many times the day performs this drill. Default 1, never 0.

    Owner ruling 2026-09-02: the progression unit is 세트 and 라운드 is retired.
    `sets: 2` means TWO announced steps, TWO taps, TWO rows -- the same
    treatment a working set gets."""
    val = (item or {}).get('sets') if isinstance(item, dict) else None
    try:
        n = int(val)
    except (TypeError, ValueError):
        return 1
    return n if n >= 1 else 1


# ---------------------------------------------------------------------------
# THE INVENTORY CHECK -- a requirement is RESOLVED, never narrated.
# ---------------------------------------------------------------------------
# `ax_machine` is the registered-equipment table. Anything NOT in it is either
# absent from the gym or absent from the record, and those two are not
# distinguishable from here -- which is why an unmet requirement produces a
# BRANCH the owner can answer, not an assertion about their gym. An inventory
# is known to be incomplete in practice (a bench can be real and unregistered),
# so an unmet requirement must never skip a drill silently.
#
# PORTABLE EQUIPMENT IS NOT A STATION. A band is not in ax_machine and never
# will be; it is not a machine. Tokens in PORTABLE_EQUIPMENT are treated as
# always available, which is the same judgement that puts them in the mat zone.
#
# ** THIS SET IS THE SOFT/HARD AXIS, AND IT NEEDED NO NEW FIELD. ** A
# requirement is HARD when only a specific station satisfies it (bench, a named
# machine): absent from the inventory, it must produce a branch. It is SOFT when
# any ubiquitous object satisfies it, in which case an unmet branch is pure
# manufactured friction. That distinction is a property of the TOKEN, and the
# token list is here. `seat` is separate from `bench` for exactly that reason --
# one drill needs a real bench to lie on, another needs something to sit on.
PORTABLE_EQUIPMENT = frozenset(('band', 'mat', 'bodyweight', 'seat'))


def registered_equipment(db_path):
    """The set of ax_machine labels that are currently ACTIVE. Empty set on any
    failure -- and an empty set means every requirement reads as unmet, i.e.
    every conditional drill offers its skip branch. That is the safe direction:
    a missing branch is the defect; an extra one is a keystroke."""
    out = set()
    if not db_path:
        return out
    try:
        import sqlite3
        conn = _db_connect(db_path)
        try:
            for (lab,) in conn.execute(
                    "SELECT label FROM ax_machine WHERE status = 'active'"):
                if isinstance(lab, str) and lab.strip():
                    out.add(lab.strip())
        finally:
            conn.close()
    except Exception:  # noqa: BLE001 -- inventory is advisory, never a gate
        return set()
    return out


def requirements_unmet(prep, code, item=None, db_path=None, inventory=None):
    """Which of this drill's requirements the inventory does NOT satisfy.

    [] means "announce it plainly, with no condition attached" -- the normal
    case, and the one a condition-in-a-string could never reach, because a
    condition living in prose is stated whether or not it is satisfied.

    A non-empty list means the SPEAKING PATH MUST OFFER A SECOND AFFORDANCE
    (완료 / 장비 없음 -- 건너뛰기). It must NOT mean "invent a substitute
    drill": there is no data for one and the model would have to make it up."""
    need = drill_requires(prep, code, item)
    if not need:
        return []
    have = inventory if inventory is not None else registered_equipment(db_path)
    return [r for r in need
            if r not in PORTABLE_EQUIPMENT and r not in have]


# ---------------------------------------------------------------------------
# THE BUILD GATE. Prescription (a): a gate that BLOCKS.
# ---------------------------------------------------------------------------
# The 2026-09-02 prescription rule, ratified by the owner that morning after
# measuring instruction-following at ~3.4% regardless of forcefulness:
#     (a) a gate that blocks   (b) code fills it in   (c) observe and revert
# "Write a stronger instruction" is a REJECTED prescription. So the rule that
# every drill must be catalogued is not written as a warning anywhere -- it is
# this function, and `rx-calc --validate-prep` exits 1 when it is broken.
#
# WHERE THE GATE SITS, AND WHY NOT AT RUNTIME. load_prep() is
# degrade-never-raise on purpose: a bad edit must not be able to block the
# owner's morning session or their push. So the gate runs at BUILD time (the
# test suite, and any edit to prep.yaml), while the runtime path stays
# fail-OPEN but fail-VISIBLE -- an unresolvable drill still renders, carrying
# an explicit violation line, instead of quietly defaulting into the wrong
# bucket the way an uncatalogued drill did.
# ---------------------------------------------------------------------------

def validate_prep(prep, cue_source=None):
    """Every schema violation in a parsed prep.yaml, as a list of strings.

    Empty list == the file is buildable. This is the whole gate; there is no
    severity axis, because every rule below is one that has already produced a
    live defect.

    `cue_source` is the TEXT of stretch-matrix.md. When it is None and any
    drill declares a cue, the gate FAILS CLOSED (PREP-CUE-SOURCE-MISSING)
    rather than skipping the provenance check -- a check that silently
    disappears when its input is absent is AGENT-DISPATCH item 6, the guard
    that reported clean because it could not see. A prep with NO cues anywhere
    needs no source and does not trip it."""
    problems = []
    if not isinstance(prep, dict):
        return ['PREP-PARSE: prep.yaml did not parse to a mapping']
    glossary = prep.get('drills')
    if not isinstance(glossary, dict):
        return ['PREP-CATALOG-MISSING: no `drills:` catalog']

    # CUE PROVENANCE -- resolved once, then applied per drill below.
    has_cue = any(isinstance(r, dict) and isinstance(r.get('cue'), dict) and r['cue']
                  for r in glossary.values())
    cue_sections = None
    if has_cue:
        if cue_source is None:
            problems.append(
                'PREP-CUE-SOURCE-MISSING: drills declare cues but %s was not '
                'readable, so cue provenance could not be checked. The gate '
                'fails closed here on purpose -- an unverifiable cue is the '
                'state that let a summarised K1 reach live.'
                % CUE_SOURCE_FILENAME)
        else:
            cue_sections = cue_source_sections(cue_source)

    for code, row in sorted(glossary.items()):
        if not isinstance(row, dict):
            problems.append('PREP-CATALOG-SHAPE: drills.%s is not a mapping'
                            % code)
            continue
        if row.get('howto') is not None:
            try:
                from first_plan_prep import PREP_DOSES
                approved = PREP_DOSES.get(code)
            except ImportError:
                approved = None
            if not approved or row['howto'] != approved[2]:
                problems.append('PREP-HOWTO-UNTRACED: drills.%s howto must '
                                'match the pack first-plan instruction' % code)
        if not row.get('name'):
            problems.append('PREP-CATALOG-NONAME: drills.%s has no `name`'
                            % code)
        timing = row.get('timing')
        if timing is not None and timing not in DRILL_TIMINGS:
            problems.append('PREP-TIMING-UNKNOWN: drills.%s timing=%r; legal: %s'
                            % (code, timing, ', '.join(DRILL_TIMINGS)))
        zone = row.get('zone')
        if zone is None:
            # THE D5 RULE. Undeclared is not "equipment by default"; it is
            # unbuildable. The two drills that produced D5 reached the owner's
            # live session with no catalog row at all.
            problems.append(
                'PREP-ZONE-UNDECLARED: drills.%s declares no `zone`; legal: %s '
                '(the axis is WHERE the drill is performed, not whether it '
                'uses equipment -- owner ruling 2026-09-02)'
                % (code, ', '.join(PREP_ZONES)))
        elif zone not in PREP_ZONES:
            problems.append('PREP-ZONE-UNKNOWN: drills.%s zone=%r; legal: %s'
                            % (code, zone, ', '.join(PREP_ZONES)))
        cue = row.get('cue')
        if cue is not None and not isinstance(cue, dict):
            problems.append('PREP-CUE-SHAPE: drills.%s cue is not a mapping '
                            '(want {setup:, sensation:})' % code)
        elif isinstance(cue, dict) and cue and cue_sections is not None:
            section = cue_sections.get(code)
            if section is None:
                # A cue with nowhere to check it against. This is the weakest
                # rung of the gate and the one that always applies: whatever
                # else it can or cannot prove, a drill may not carry
                # instruction text that has no section in the owner's document.
                problems.append(
                    'PREP-CUE-NOSOURCE: drills.%s declares a cue but %s has no '
                    '`### %s.` section to quote it from. A cue is QUOTED from '
                    'the source, never authored -- absent is the correct value '
                    'when the source is silent.'
                    % (code, CUE_SOURCE_FILENAME, code))
            else:
                for field in sorted(cue):
                    text = cue.get(field)
                    if not isinstance(text, str) or not text.strip():
                        continue
                    untraced = cue_untraced_tokens(text, section)
                    if untraced:
                        problems.append(
                            'PREP-CUE-UNTRACED: drills.%s cue.%s uses %d '
                            'token(s) absent from its %s section: %s. A cue is '
                            'QUOTED, not summarised (rule 2026-08-07, broken '
                            '08-10 and twice on 09-02 -- this gate replaces it).'
                            % (code, field, len(untraced),
                               CUE_SOURCE_FILENAME, ', '.join(untraced)))

    days = prep.get('days')
    if not isinstance(days, dict):
        return problems + ['PREP-DAYS-MISSING: no `days:` mapping']

    for day, day_obj in sorted(days.items()):
        blocks = ({'prep': day_obj} if isinstance(day_obj, list)
                  else day_obj if isinstance(day_obj, dict) else {})
        for block, items in sorted(blocks.items()):
            if not isinstance(items, list):
                continue
            seen = {}
            for idx, item in enumerate(items):
                if not isinstance(item, dict):
                    problems.append('PREP-ITEM-SHAPE: %s.%s[%d] is not a '
                                    'mapping' % (day, block, idx))
                    continue
                code = item.get('code')
                where = '%s.%s[%d] code=%s' % (day, block, idx, code)
                if not code:
                    problems.append('PREP-ITEM-NOCODE: %s has no `code`'
                                    % where)
                    continue
                if code not in glossary:
                    # THE HARD ONE. This is the rule the ticket asked for in
                    # so many words: a drill with no catalog entry FAILS THE
                    # BUILD rather than silently defaulting.
                    problems.append(
                        'PREP-UNCATALOGUED: %s has no entry in `drills:`; a '
                        'day list cannot originate a drill, only prescribe a '
                        'catalogued one' % where)
                unit = item.get('target_unit')
                if unit in RETIRED_TARGET_UNITS:
                    problems.append(
                        'PREP-UNIT-RETIRED: %s uses target_unit=%r, which is '
                        'retired (owner ruling 2026-09-02: the progression '
                        'unit is 세트). Use `sets: N` on the day item.'
                        % (where, unit))
                elif unit is not None and unit not in LEGAL_TARGET_UNITS:
                    problems.append('PREP-UNIT-UNKNOWN: %s target_unit=%r; '
                                    'legal: %s'
                                    % (where, unit,
                                       ', '.join(LEGAL_TARGET_UNITS)))
                if item.get('target_reps') is not None and unit is None:
                    problems.append('PREP-UNIT-UNDECLARED: %s states '
                                    'target_reps but no target_unit' % where)
                sets = item.get('sets')
                if sets is not None:
                    try:
                        if int(sets) < 1:
                            raise ValueError
                    except (TypeError, ValueError):
                        problems.append('PREP-SETS-INVALID: %s sets=%r; want '
                                        'an integer >= 1' % (where, sets))
                # DUPLICATE RULE, and the reason it is written this way.
                # The 2026-09-02 batch reported "U1c appears twice in 앞A" as a
                # duplicate to delete. MEASURED: the two entries carry
                # live_slot 1 and live_slot 5 -- the same shoulder guardrail
                # performed before EACH press slot, which the original
                # `# H3: same slot as the card row above` comment was
                # recording. Deleting one would have removed a rehab drill in
                # front of the second press.
                # So the gate refuses a repeat on the SAME slot (which is a
                # genuine copy-paste) and permits a repeat on DIFFERENT slots
                # (which is a prescription). The distinction is enforced here
                # rather than left to whoever reads the file next.
                key = (code, item.get('live_slot'), item.get('card_slot'))
                if key in seen:
                    problems.append(
                        'PREP-DUPLICATE: %s duplicates %s.%s[%d] -- same code, '
                        'same live_slot(%r), same card_slot(%r). A drill '
                        'repeated on the SAME slot is a copy-paste; repeating '
                        'it on a DIFFERENT slot is legal and is how a drill is '
                        'prescribed before two lifts.'
                        % (where, day, block, seen[key],
                           item.get('live_slot'), item.get('card_slot')))
                seen[key] = idx
    return problems


def _expand_sets(item):
    """One resolved day item -> the list of per-set items it stands for.

    `sets: 1` (the default) returns the item unchanged in shape, with
    set_index/set_total attached so every consumer can say "2/3" without
    re-deriving it. The card path collapses these back (_collapse_set_repeats);
    the live path wants them expanded, which is the whole point -- two items
    become two prep rows, two completion taps and two cells in the progress
    table, with no downstream cooperation required (set-table's
    prep_plan_ordered assigns p1..pN by POSITION)."""
    total = drill_sets(item)
    out = []
    for i in range(total):
        one = dict(item)
        one['set_index'] = i + 1
        one['set_total'] = total
        out.append(one)
    return out


def _resolve_drill_item(prep, item):
    """A raw day item -> the SAME item with every catalog-owned field filled in.

    THE ONE RESOLUTION POINT. Callers see a complete drill: display, phase,
    zone, cue, requires, implement, load_kg. A field the data does not declare
    is simply absent from the result -- resolution never fabricates, it only
    locates.

    The item is COPIED before anything is written. `prep` is a cached parse
    shared across every render in the process (_PREP_CACHE), so mutating an item
    in place would rewrite the cache and make the resolution permanent and
    un-diagnosable from the second call onward."""
    code = item.get('code')
    out = dict(item)
    entry = drill_entry(prep, code)
    # A first program written before doses shipped has catalogued drill names
    # but no prescription. Fill only absent fields from the pack's first-plan
    # rules; owner-authored values always win.
    if entry:
        try:
            from first_plan_prep import PREP_DOSES
            dose = PREP_DOSES.get(code)
        except ImportError:
            dose = None
        if dose:
            amount, unit, howto = dose
            out.setdefault('target_reps', amount if unit == 'reps' else 1)
            out.setdefault('target_unit', 'reps' if unit == 'reps' else 'hold_sets')
            if unit != 'reps':
                out.setdefault('hold_sec', amount)
            out.setdefault('howto', howto)
    if not out.get('display'):
        # display, then name. `display` is the owner-facing half of the split:
        # an internal coinage may survive in `name` (an identifier the owner
        # never reads) but never in what is spoken.
        if entry:
            out['display'] = entry.get('display') or entry.get('name')
    if code == 'adductor_squeeze' and out.get('display') == \
            '허벅지 안쪽 깨우기(무릎 사이 폼롤러 조이기 15초)':
        out['display'] = '허벅지 안쪽 깨우기'
    phase = drill_phase(prep, code, item)
    if phase:
        out['phase'] = phase
    zone = drill_zone(prep, code, item)
    if zone:
        out['zone'] = zone
    cue = drill_cue(prep, code, item)
    if cue:
        out['cue'] = cue
    if entry and entry.get('howto') and not out.get('howto'):
        out['howto'] = entry['howto']
    # 2026-10-08: the owner's own cue fields (prep_cues.py reads them ahead of
    # the pack's data): ordered steps, the one common mistake, and what ONE
    # counted rep is. Carried, never generated.
    for key in ('steps', 'fault', 'rep_unit'):
        if entry and entry.get(key) and not out.get(key):
            out[key] = entry[key]
    req = drill_requires(prep, code, item)
    if req:
        out['requires'] = req
    equip = drill_equipment(prep, code, item)
    for key, val in equip.items():
        out.setdefault(key, val)
    if entry is None:
        # FAIL-VISIBLE, never fail-silent. A build gate should refuse this file,
        # but the runtime path must still render -- a schema error must not be
        # able to stop a session. So the drill goes through carrying an explicit
        # marker instead of quietly inheriting whatever bucket it landed in.
        out['schema_violation'] = 'uncatalogued'
    return out


def _collapse_set_repeats(items):
    """Expanded per-set items -> one entry per drill, for the MORNING CARD.

    The card is a plan, not a progress surface: it should read "<드릴> x3세트",
    not list the same line three times. The live path is the opposite and keeps
    every set, because that is where the owner is told one thing at a time. Both
    read the same expanded list, so they cannot disagree about the count."""
    out = []
    for d in items:
        if d.get('set_index', 1) != 1:
            continue
        total = d.get('set_total') or 1
        if total > 1:
            d = dict(d)
            d['display'] = '%s x%d세트' % (str(d.get('display')).rstrip(), total)
        out.append(d)
    return out


def _drill_display(code, display):
    """H4: raw prep.yaml `display` -> the name the owner should read.

    DEGRADE, never raise, in the _tax() style: a tree without ui_labels.py (a
    sandboxed copy of a subset of service/health) returns the raw string, which
    is exactly today's behaviour. A display fix must never be able to block a
    live entry or the morning push."""
    try:
        if HERE not in sys.path:
            sys.path.insert(0, HERE)
        import ui_labels
        return ui_labels.resolve_drill_display(code, display)
    except Exception:  # noqa: BLE001 -- module absent -> raw string, not a crash
        return display


def drill_equipment(prep, code, item=None):
    """H2: what the owner picks up for drill `code` -> {'implement': str,
    'load_kg': num} with ONLY the keys the data actually declares.

    Resolution order is glossary-then-override, because an implement is a
    property of the DRILL and not of the day: prep.yaml `drills.<code>` is the
    normal home, and a day item may override either field when that day
    genuinely differs. An override is only honoured when the item DECLARES the
    key -- a day item that is simply silent about equipment inherits the
    glossary's, it does not blank it.

    ABSENT KEYS STAY ABSENT. There is no default implement and no default load,
    and adding one would re-open the exact hole this closes (the model narrated
    헤일로 as "원판(6kg)" precisely because a blank had to be filled with
    something). {} is a valid, common, correct answer. Never raises."""
    out = {}
    glossary = (prep or {}).get('drills')
    src = glossary.get(code) if isinstance(glossary, dict) else None
    for layer in (src, item):
        if not isinstance(layer, dict):
            continue
        for key in ('implement', 'load_kg'):
            if layer.get(key) is not None:
                out[key] = layer.get(key)
    return out


def _with_equipment(display, equip):
    """`display` + its equipment parenthetical, rendered by the ONE owner-facing
    resolver (ui_labels). Same degrade contract as _drill_display: no
    ui_labels.py in the tree -> the raw display, never a crash. Empty `equip`
    -> the display unchanged, which is the silent-absence case."""
    if not equip:
        return display
    try:
        if HERE not in sys.path:
            sys.path.insert(0, HERE)
        import ui_labels
        return ui_labels.with_equipment(display, equip.get('implement'),
                                        equip.get('load_kg'))
    except Exception:  # noqa: BLE001 -- module absent -> raw string, not a crash
        return display


def _prep_block_items(prep, day, block):
    """Ordered items of one prep.yaml-hosted block for `day`.

    Accepts BOTH day shapes:
      - days.<day>.<block>  (current: prep/cooldown peer collections)
      - days.<day>          (pre-2026-08-22 flat list == the prep block)
    The legacy branch keeps an old/rolled-back prep.yaml readable rather than
    silently rendering an empty prep section. [] when absent/malformed.

    H4 (2026-08-24 -- a rendered drill name was not readable as speech):
    this is where a drill's owner-facing name is resolved, and it is the ONLY
    place. Every surface that shows the owner a drill name reaches it through
    this one function --
        morning card  : prep_card_blocks / prep_card_slot_strings /
                        cooldown_card_items / cooldown_card_slot_strings
        live session  : prep_slot_drills / cooldown_slot_drills ->
                        exercise-enter PREP_ENTRY / PREP_IMMEDIATE /
                        COOLDOWN_ENTRY
        block view    : day_blocks
    -- so one resolution point covers all of them and the card and the live
    plan cannot disagree about what a drill is called. Resolving per-consumer
    instead would have been three copies of the same decision, which is the
    exact shape of the bug that made prep.yaml necessary in the first place
    (three disagreeing prep sources, 2026-08-21 collapse).

    The item dict is COPIED before its display is rewritten. `prep` is a cached
    parse shared across every render in the process (_PREP_CACHE), so mutating
    an item in place would rewrite the cache and make the override permanent
    and un-diagnosable from the second call onward."""
    days = (prep or {}).get('days')
    if not isinstance(days, dict):
        return []
    day_obj = days.get(day)
    if isinstance(day_obj, list):
        items = day_obj if block == 'prep' else None
    elif isinstance(day_obj, dict):
        items = day_obj.get(block)
    else:
        items = None
    if not isinstance(items, list):
        return []
    out = []
    for d in items:
        if not isinstance(d, dict) or not d.get('code'):
            continue
        # 2026-09-02 (back-ported 2026-09-11): RESOLVE FROM THE CATALOG FIRST.
        # `display` is no longer required on a day item and is normally ABSENT
        # -- the catalog is the SoT for a drill's name, zone, phase, cue,
        # requirement and implement, and the day item carries only what varies
        # by day. The old guard (`not d.get('display')` -> skip) silently
        # dropped EVERY migrated item, i.e. read a modern prep.yaml as an empty
        # prep block, which is why this guard is now keyed on `code`.
        d = _resolve_drill_item(prep, d)
        if not d.get('display'):
            continue
        resolved = _drill_display(d.get('code'), d.get('display'))
        # H2 (2026-08-24): equipment is resolved HERE, beside the name, for the
        # same reason the name is -- so every surface that shows the owner a
        # drill gets the same answer about what they pick up. Resolving it in
        # the live path only would have left the morning card saying 헤일로 with
        # no implement while the session said 케틀벨, which is the two-ledgers
        # shape this file was written to end. Note that U1a/"어깨 트리오" never
        # reached the live path at all (no live_slot) -- the card W row was the
        # ONLY surface it had, which is exactly why the equipment could not be
        # fixed in the live path alone.
        # A drill with no recorded equipment leaves `resolved` untouched, so
        # its output is byte-identical to before this line existed.
        equip = drill_equipment(prep, d.get('code'), d)
        picked = _pick_alternative(resolved, equip.get('implement'))
        if picked != resolved:
            # the catalog name offered "A (or B)" and the owner's implement
            # is on record: name it once, in place (owner 2026-10-08, halo)
            resolved = picked
            if equip.get('load_kg') is not None:
                resolved = _with_equipment(resolved, equip)
        else:
            resolved = _with_equipment(resolved, equip)
        if resolved != d.get('display'):
            d = dict(d)
            d['display'] = resolved
        # SETS EXPANSION -- one place, so the card and the live plan cannot
        # disagree about how many times a drill is performed. A drill with
        # `sets: 2` becomes TWO items carrying set_index / set_total.
        out.extend(_expand_sets(d))
    return out


# MAT FIRST, EQUIPMENT LAST (owner, live 2026-10-08 session 1). The owner is
# on the mat for the floor/bodyweight drills; a drill that needs something in
# the hands (the halo's kettlebell, a band) means getting up and fetching it,
# so those go to the END of the prep, in declared order among themselves.
# `drill_equipment` classes in compose_rank_rules.json (caution_policy) say
# which catalog drills need a tool; a recorded `implement` or `zone:
# equipment` says the same for anything else.
_DRILL_EQUIPMENT = None


def _drill_equipment_classes():
    global _DRILL_EQUIPMENT
    if _DRILL_EQUIPMENT is None:
        try:
            with open(os.path.join(HERE, 'compose_rank_rules.json'),
                      encoding='utf-8') as fh:
                _DRILL_EQUIPMENT = (json.load(fh).get('caution_policy') or {}
                                    ).get('drill_equipment') or {}
        except (OSError, ValueError):
            _DRILL_EQUIPMENT = {}
    return _DRILL_EQUIPMENT


def prep_needs_tool(item):
    """True when the drill needs something in the hands or a station."""
    d = item if isinstance(item, dict) else {}
    if isinstance(d.get('implement'), str) and d['implement'].strip():
        return True
    if d.get('zone') == ZONE_EQUIPMENT:
        return True
    return _drill_equipment_classes().get(d.get('code'), 'none') != 'none'


_ALT_RE = re.compile(r"(\S+)\(\uB610\uB294 ([^)]+)\)")    # "A(or B)"


def _pick_alternative(display, implement):
    """'<A>(or <B>) <name>' -> '<implement> <name>' when the recorded
    implement is A or B; anything else unchanged."""
    if not (isinstance(display, str) and isinstance(implement, str)
            and implement.strip()):
        return display
    imp = implement.strip()
    m = _ALT_RE.search(display)
    if not m or imp not in (m.group(1).strip(), m.group(2).strip()):
        return display
    return display[:m.start()] + imp + display[m.end():]


def _is_session_mat_prep(item):
    """The session-level mat prep block: no live_slot, no card_slot, phase
    mat_prep (set-table.is_session_prep's live test plus the card's)."""
    return (isinstance(item, dict) and item.get('live_slot') is None
            and item.get('card_slot') is None
            and item.get('phase') == 'mat_prep')


def prep_day_items(prep, day):
    """Ordered PREP-block items declared for `day`. [] when absent/malformed.

    Declaration order IS render order, with one rule on top: INSIDE the
    session-level mat prep block, drills that need a tool sort after the
    bodyweight drills, stable on both sides. The sort is confined to that
    block (0.36 full-suite ruling): lift-specific prep keeps its phase
    order -- entry/equipment drills first, the immediate primer LAST, right
    before the working lift. Every other item keeps its declared position.
    The live path's phase sort is stable, so it preserves this order within a
    phase -- callers must not re-sort."""
    items = _prep_block_items(prep, day, 'prep')
    pos = [i for i, d in enumerate(items) if _is_session_mat_prep(d)]
    mat = sorted((items[i] for i in pos),
                 key=lambda d: 1 if prep_needs_tool(d) else 0)
    out = list(items)
    for i, d in zip(pos, mat):
        out[i] = d
    return out


def cooldown_day_items(prep, day):
    """Ordered COOLDOWN-block items declared for `day`. [] when absent.

    Same item schema as a prep item (code/display/phase/card_slot/live_slot/
    hold_sec) -- cooldown is a peer collection, not a lesser one."""
    return _prep_block_items(prep, day, 'cooldown')


def _prep_slot_int(val):
    """card_slot/live_slot -> int, or None when absent/unparseable."""
    if val is None:
        return None
    try:
        return int(val)
    except (TypeError, ValueError):
        return None


def prep_card_blocks(prep, day):
    """Session-level card blocks: {'mat_prep': [str, ...],
    'equipment_prep': [str, ...]}. A phase with no drills is simply absent, so
    the caller emits no block (same sparse contract as before the collapse).

    Session-level = no card_slot. A drill WITH a card_slot belongs to that
    slot's W row (prep_card_slot_strings), not to a session block."""
    out = {}
    # COLLAPSED: the card lists a drill once, with its set count, not N
    # times. The live path keeps the expansion; both read the same list.
    for d in _collapse_set_repeats(prep_day_items(prep, day)):
        if _prep_slot_int(d.get('card_slot')) is not None:
            continue
        phase = d.get('phase')
        if phase not in PREP_CARD_PHASES:
            continue
        out.setdefault(phase, []).append(str(d.get('display')))
    return out


def prep_card_slot_strings(prep, day):
    """Per-slot card W rows: {slot_int: '<drill> + <drill> + ...'}.

    Sparse -- a slot with no card drills has no key, so it gets no W row."""
    acc = {}
    # COLLAPSED: the card lists a drill once, with its set count, not N
    # times. The live path keeps the expansion; both read the same list.
    for d in _collapse_set_repeats(prep_day_items(prep, day)):
        slot_num = _prep_slot_int(d.get('card_slot'))
        if slot_num is None:
            continue
        acc.setdefault(slot_num, []).append(str(d.get('display')))
    return {k: PREP_JOIN.join(v) for k, v in acc.items()}


def prep_slot_drills(prep, day, slot_num):
    """Live in-session drills for one slot, in the exact dict shape
    exercise-enter's extract_prep_plan() consumes:
        [{'code':..., 'phase':..., 'display':..., 'hold_sec':<opt>}, ...]
    Only items carrying a matching live_slot are returned; [] otherwise.
    hold_sec is omitted (not None) when the drill is untimed, so the emitted
    PREP_* line keeps its pre-collapse key set exactly.

    Phase order wins here (stable): equipment/entry drills first, the
    immediate primer LAST, right before the working lift."""
    return sorted(_live_slot_drills(prep_day_items(prep, day), slot_num),
                  key=lambda d: _PREP_SLOT_PHASE_RANK.get(
                      d.get('phase'), len(_PREP_SLOT_PHASE_RANK)))


# exercise-enter.PREP_PHASE_ORDER, as a rank.
_PREP_SLOT_PHASE_RANK = {'mat_prep': 0, 'equipment_prep': 1,
                         'immediate_primer': 2}


def _live_slot_drills(items, slot_num):
    """Shared live-plan projection for a block's items: keep those whose
    live_slot matches, in declaration order, in the dict shape the live
    consumers take. hold_sec is OMITTED (not None) when the drill is untimed,
    so an emitted line keeps its pre-collapse key set exactly."""
    want = _prep_slot_int(slot_num)
    if want is None:
        return []
    out = []
    for d in items:
        if _prep_slot_int(d.get('live_slot')) != want:
            continue
        item = {
            'code': d.get('code'),
            'phase': d.get('phase'),
            'display': d.get('display'),
        }
        if d.get('hold_sec') is not None:
            item['hold_sec'] = d.get('hold_sec')
        out.append(item)
    return out


