# DGN-773 / P0 per-turn-load diet (2026-08-19): the full safety_note prose and
# the program changelog were moved OUT of program.yaml into an on-demand JSON
# sidecar (program-history.json). set-arm / set-table parse program.yaml on
# EVERY set but never read those fields, so keeping ~24KB of prose inline was
# pure per-turn parse weight. They are re-hydrated here ONLY when a caller asks
# (calc_rx(hydrate=True) -- the SESSION_START rx path -- and exercise-enter),
# never on the per-set hot path.
#
# JSON (not the hand-rolled YAML loader) because the prose contains ': ', '|',
# '{...}' etc. that the minimal YAML parser misreads; stdlib json is exact.
# ---------------------------------------------------------------------------

HISTORY_SIDECAR = 'program-history.json'


def load_history_sidecar(program_yaml_path):
    """Load program-history.json from the program.yaml directory. Missing file
    or any parse error -> {} so rx output degrades to the sidecar-absent shape
    (safety_note stays None) with no crash -- same defensive style as
    load_prep / get_muscle_map."""
    from session_day_trim import source_path
    path = os.path.join(os.path.dirname(os.path.abspath(source_path(program_yaml_path))),
                        HISTORY_SIDECAR)
    if not os.path.exists(path):
        return {}
    try:
        with open(path, 'r', encoding='utf-8') as f:
            data = json.load(f)
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


def safety_note_key(rotation_day, slot, name):
    """Sidecar key for a slot's safety_note prose: '<day>.<slot>.<name>'."""
    return '%s.%s.%s' % (rotation_day, slot, name)


def hydrate_safety_notes(program, rotation_day, sidecar):
    """In-place: for each exercise slot of rotation_day, fill slot['safety_note']
    with the full prose from the sidecar when the slot has no inline note (the
    on-demand path). A slot that still carries an inline note is left untouched
    (backward compatible if any note was left inline). Best-effort / never
    raises."""
    if not sidecar:
        return program
    notes = sidecar.get('safety_notes') or {}
    if not isinstance(notes, dict):
        return program
    day_plan = (program.get('days') or {}).get(rotation_day)
    if not isinstance(day_plan, dict):
        return program
    for ex in day_plan.get('exercises', []) or []:
        if not isinstance(ex, dict):
            continue
        if ex.get('safety_note'):
            continue  # inline note present -- keep it
        key = safety_note_key(rotation_day, ex.get('slot'), ex.get('name'))
        prose = notes.get(key)
        if prose:
            ex['safety_note'] = prose
    return program


def _strip_inline_comment(s):
    """Remove a trailing inline comment: cut at the first ' #' that sits OUTSIDE
    any quoted string. Quote-aware so a comment BODY may itself contain quotes
    (the old regex r'\\s+#[^"\\']*$' failed whenever the comment held a quote,
    leaving the whole 'value # comment' as a bare string). A '#' inside a quoted
    value, or one not preceded by whitespace (e.g. a URL fragment), is kept."""
    in_quote = None
    for i, ch in enumerate(s):
        if in_quote:
            if ch == in_quote:
                in_quote = None
        elif ch in ('"', "'"):
            in_quote = ch
        elif ch == '#' and i > 0 and s[i - 1] in (' ', '\t'):
            return s[:i].rstrip()
    return s


def _parse_yaml_lines(lines):
    """Parse YAML lines into nested dicts/lists."""
    # Strip comments and trailing whitespace
    cleaned = []
    for line in lines:
        # Remove inline comments (but not inside strings -- good enough for our schema)
        stripped = line.rstrip()
        # skip pure comment lines
        if stripped.lstrip().startswith('#'):
            cleaned.append('')
            continue
        # strip inline comments (quote-aware; comment body may contain quotes)
        stripped = _strip_inline_comment(stripped)
        cleaned.append(stripped)
    return _parse_block(cleaned, 0)[0]


def _parse_block(lines, base_indent):
    """Recursively parse a YAML block at the given base indentation."""
    result = {}
    result_is_list = False
    result_list = []
    i = 0
    while i < len(lines):
        line = lines[i]
        if not line.strip():
            i += 1
            continue
        indent = len(line) - len(line.lstrip())
        if indent < base_indent:
            break  # dedent: return to parent

        content = line.lstrip()

        # Block list item
        if content.startswith('- '):
            result_is_list = True
            item_content = content[2:].strip()
            if ':' in item_content:
                # inline key: value -- treat as dict start for this item
                item_lines = [' ' * (indent + 2) + item_content]
                # collect continuation lines at deeper indent
                j = i + 1
                while j < len(lines):
                    nxt = lines[j]
                    if not nxt.strip():
                        j += 1
                        continue
                    nxt_indent = len(nxt) - len(nxt.lstrip())
                    if nxt_indent > indent:
                        item_lines.append(nxt)
                        j += 1
                    else:
                        break
                item_obj, _ = _parse_block(item_lines, indent + 2)
                result_list.append(item_obj)
                i = j
            else:
                result_list.append(_yaml_value(item_content))
                i += 1
            continue

        # Key: value
        if ':' in content:
            colon_pos = content.index(':')
            key = content[:colon_pos].strip()
            rest = content[colon_pos+1:].strip()
            if rest:
                # Check if next lines are deeper (block value follows scalar line)
                # For our schema, if rest is non-empty it's the value
                result[key] = _yaml_value(rest)
                i += 1
            else:
                # Block value: collect deeper-indented lines
                deeper = []
                j = i + 1
                while j < len(lines):
                    nxt = lines[j]
                    if not nxt.strip():
                        deeper.append('')
                        j += 1
                        continue
                    nxt_indent = len(nxt) - len(nxt.lstrip())
                    if nxt_indent > indent:
                        # Normalize to relative indent
                        deeper.append(nxt)
                        j += 1
                    else:
                        break
                if deeper:
                    child, _ = _parse_block(deeper, indent + 2)
                    result[key] = child
                    i = j
                else:
                    result[key] = None
                    i += 1
            continue
        i += 1

    if result_is_list:
        return result_list, i
    return result, i


