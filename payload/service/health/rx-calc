# Entrypoint
# ---------------------------------------------------------------------------

def main():
    # DGN-316 6.1: --volume-audit mode flag (additive; the existing
    # stdin/argv rx contract is untouched). Pinned audit exit codes:
    #   0 = audit ran, unmapped_program and unmapped_actual both empty
    #   3 = audit ran, unmapped nonempty (either side) -- verdicts unreliable
    #   1 = fatal (missing files / parse errors)
    #   never 2 (the rx-mode all_calibration semantic is NOT inherited)
    argv = list(sys.argv[1:])

    # --validate-prep <program.yaml> : THE BUILD GATE (2026-09-02).
    #
    # Prescription (a) -- a gate that BLOCKS. Not a warning, not a comment, not
    # a line in a skill file: a non-zero exit. The owner's measurement that
    # morning was that written instructions are followed ~3.4% of the time
    # regardless of how forcefully they are written, so "remember to catalogue
    # your drills" is a rejected prescription and this is what replaces it.
    #
    #   0  prep.yaml is buildable
    #   1  one or more schema violations, each printed on its own line
    #
    # Deliberately its own mode and deliberately EARLY: it must run without a
    # DB, without a session, and without any of the rx machinery below, so that
    # a broken prep.yaml is caught by something that cannot itself be broken by
    # the same edit.
    if '--validate-prep' in argv:
        argv = [a for a in argv if a != '--validate-prep']
        path = argv[0] if argv else os.path.join(HERE, 'program.yaml')
        prep = load_prep(path)
        if not prep:
            sys.stderr.write('PREP-LOAD-FAILED: %s\n' % path)
            sys.exit(1)
        # THE CUE SOURCE IS READ HERE, at the gate, and nowhere else in this
        # file. Unreadable -> passed as None -> validate_prep FAILS CLOSED with
        # PREP-CUE-SOURCE-MISSING. It is never swallowed into a silent skip.
        cue_src = None
        try:
            with open(cue_source_path(path), encoding='utf-8') as fh:
                cue_src = fh.read()
        except OSError:
            cue_src = None
        problems = validate_prep(prep, cue_source=cue_src)
        for p in problems:
            sys.stderr.write(p + '\n')
        if problems:
            sys.stderr.write('prep.yaml FAILED validation: %d violation(s)\n'
                             % len(problems))
            sys.exit(1)
        sys.stdout.write('prep.yaml OK: %d drills, %d days\n'
                         % (len(prep.get('drills') or {}),
                            len(prep.get('days') or {})))
        sys.exit(0)

    # --progression-audit <program.yaml> <db> : D22, now an INVARIANT.
    #
    # D22 (2026-09-02) found the progression verdict had TWO homes: the base
    # weight came from program.yaml `weight_kg` (a write-back cache nothing
    # wrote) while the reps came from the DB. Live: single_leg_extension
    # yaml=25.0 vs DB=30.0 -> "up" -> 30kg, the weight the owner was ALREADY
    # using. It stayed a detector then because moving the base moved 22 of 31
    # slots on the old history, and that was the owner's call.
    #
    # The owner made it 2026-09-30 ("otherwise keep the last-load progression
    # exactly") and program state step A2 moved the base: calc_rx now starts
    # from resolve_base_weight() -- the last LOGGED working load, the card's
    # weight_kg only as a seed before anything was logged. So the check turned
    # around. A card seed that differs from the DB is EXPECTED and silent; what
    # fails now is the base NOT being the DB when the DB has a load:
    #   PROGRESSION-BASE-NOT-DB  a slot with a logged working load whose
    #                            resolved base is not that load.
    # (2) THE STRATEGY finding is unchanged: program.yaml may declare
    # `progression_strategy: warg` (strategy B) while calc_rx always runs estate-scrub:allow(program.yaml progression_strategy value, a config contract)
    # apply_progression (strategy A) -- still the owner's call, still named.
    # test-progression-base A6 holds the invariant on a fixture.
    if '--progression-audit' in argv:
        argv = [a for a in argv if a != '--progression-audit']
        prog_path = argv[0] if argv else os.path.join(HERE, 'program.yaml')
        db_path = argv[1] if len(argv) > 1 else os.path.join(
            HERE, '..', '..', 'database', 'kit_life.db')
        program = load_yaml(prog_path)
        if not isinstance(program, dict):
            sys.stderr.write('PROGRESSION-AUDIT: program.yaml did not parse\n')
            sys.exit(1)
        findings = []
        declared = program.get('progression_strategy') or 'core'
        # calc_rx's own call, not a claim about it: the live path is
        # apply_progression(), i.e. strategy A ("core"), unconditionally.
        applied = 'core'
        if declared != applied:
            findings.append(
                'PROGRESSION-STRATEGY-UNWIRED: program.yaml declares '
                'progression_strategy=%s; calc_rx runs %s '
                '(apply_progression_dispatch is never called)'
                % (declared, applied))
        for day, plan in (program.get('days') or {}).items():
            if not isinstance(plan, dict):
                continue
            type_id = resolve_session_type_id(db_path, day)
            for ex in (plan.get('exercises') or []):
                if not isinstance(ex, dict):
                    continue
                name = ex.get('name', '')
                db_reps, db_w = get_last_session_result(db_path, name, type_id)
                if db_w is None:
                    continue        # no logged working load -> seed is right
                base, src = resolve_base_weight(db_path, name, type_id,
                                                seed=ex.get('weight_kg'))
                if (src != 'logged' or base is None
                        or abs(float(base) - float(db_w)) > 1e-6):
                    findings.append(
                        'PROGRESSION-BASE-NOT-DB: %s %s base=%s source=%s '
                        'db_last_working_kg=%s db_top_reps=%s'
                        % (day, name, base, src, db_w, db_reps))
        for f in findings:
            sys.stderr.write(f + '\n')
        if findings:
            sys.stderr.write('progression audit FAILED: %d finding(s)\n'
                             % len(findings))
            sys.exit(1)
        sys.stdout.write('progression audit OK: one base ledger, '
                         'declared strategy == applied strategy\n')
        sys.exit(0)

    # --rest-audit <program.yaml> : D28 DETECTOR (2026-09-02).
    #
    # THE REPORT, first: the 75s is NOT a computation error. Measured against
    # the documented DGN-388 model, wall_sit resolves exactly as written --
    # isolation base 90 (movement_class matches no COMPOUND keyword and falls
    # to the documented isolation default) + isometric 0 (the intensity term is
    # deliberately skipped: rep_range [20,45] is SECONDS, and reading 45 as "45
    # reps = light" is the bug _is_isometric_hold exists to prevent) + lowfatigue
    # -15 = 75. The owner-facing grounds fold decomposes it correctly too. Every
    # factor is the stated rule, applied correctly.
    #
    # WHAT IS ACTUALLY WRONG is a thing no arithmetic can settle: the model has
    # no term for what a slot is FOR. `role` (warmup|main|focus|rehab|prehab|
    # accessory) is declared on every slot and read only by the ordering guard.
    # So a 45-second patellar-tendon prehab hold rests LONGER than the knee
    # rehab slot before it (60s) -- because skipping the intensity term also
    # withholds the -30 that every other isolation slot in the program receives.
    # Owner, 07:28: a wall sit judged as a warm-up should not rest 60 seconds.
    #
    # WHY THIS IS A DETECTOR AND NOT A FIX. Every available repair prescribes:
    # a role x progression rest table needs numbers the owner has never stated;
    # a per-slot `rest_sec` override (which the model documents as the intended
    # escape hatch, and which already wins over everything) IS a prescription
    # and is the owner's to set. Inventing either is the exact failure this
    # batch spent a day reverting, so nothing here changes a single resolved
    # second.
    #
    # What it CAN do without deciding anything is name the one comparison that
    # needs no new number: an isometric hold whose prescribed REST exceeds its
    # own prescribed WORK. Both values are already the owner's; only the
    # inequality between them is reported. Exit 1 when any slot is in that
    # state, exit 0 when none is.
    if '--rest-audit' in argv:
        argv = [a for a in argv if a != '--rest-audit']
        prog_path = argv[0] if argv else os.path.join(HERE, 'program.yaml')
        db_path = argv[1] if len(argv) > 1 else os.path.join(
            HERE, '..', '..', 'database', 'kit_life.db')
        program = load_yaml(prog_path)
        if not isinstance(program, dict):
            sys.stderr.write('REST-AUDIT: program.yaml did not parse\n')
            sys.exit(1)
        # Same one-shot map resolution calc_rx uses; absent tables degrade the
        # fatigue term to 0 exactly as the live path would.
        cost_map = get_fatigue_cost_map(db_path)
        pattern_map = get_pattern_map(db_path)
        findings = []
        for day, plan in (program.get('days') or {}).items():
            if not isinstance(plan, dict):
                continue
            for ex in (plan.get('exercises') or []):
                if not isinstance(ex, dict):
                    continue
                if not _is_isometric_hold(ex):
                    continue        # rep_range is reps; no work-seconds to compare
                rr = ex.get('rep_range')
                if not (isinstance(rr, (list, tuple)) and rr):
                    continue
                try:
                    work_sec = int(rr[-1])
                except (TypeError, ValueError):
                    continue
                rest_sec, basis = resolve_rest_sec(ex, program, cost_map,
                                                   pattern_map)
                if rest_sec > work_sec:
                    findings.append(
                        'REST-EXCEEDS-HOLD: %s %s role=%s hold_sec=%s '
                        'rest_sec=%s basis=%s'
                        % (day, ex.get('name', ''), ex.get('role'),
                           work_sec, rest_sec, basis))
        for f in findings:
            sys.stderr.write(f + '\n')
        if findings:
            sys.stderr.write(
                'rest audit FAILED: %d finding(s). NOT auto-corrected -- a rest '
                'duration is a prescription. Set a per-slot `rest_sec` (it wins '
                'over the whole model) if these should differ.\n' % len(findings))
            sys.exit(1)
        sys.stdout.write('rest audit OK: no isometric hold rests longer than '
                         'it holds\n')
        sys.exit(0)

    audit_mode = '--volume-audit' in argv
    if audit_mode:
        argv = [a for a in argv if a != '--volume-audit']

    # --judge-layer subregion|group : management granularity (2026-08-25).
    # NOT a level model -- just the knob. Default lives in resolve_judge_layer.
    judge_layer = None
    for a in list(argv):
        if a.startswith('--judge-layer='):
            judge_layer = a.split('=', 1)[1]
            argv.remove(a)
        elif a == '--judge-layer':
            i = argv.index(a)
            if i + 1 < len(argv):
                judge_layer = argv[i + 1]
                del argv[i:i + 2]
            else:
                argv.remove(a)
    if judge_layer is not None and judge_layer not in JUDGE_LAYERS:
        print('[rx-calc] ERROR: --judge-layer must be one of %s'
              % ', '.join(JUDGE_LAYERS), file=sys.stderr)
        sys.exit(1)

    exclude_session_id = None

    # Accept stdin JSON or positional args
    if not sys.stdin.isatty():
        raw = sys.stdin.read().strip()
        if raw:
            try:
                args = json.loads(raw)
                program_yaml = args['program_yaml']
                today = args['today']
                db_path = args['workouts_db']
                # DGN-316 M-5: optional key (both modes)
                exclude_session_id = args.get('exclude_session_id')
            except (json.JSONDecodeError, KeyError) as e:
                print(f'[rx-calc] ERROR: bad stdin JSON: {e}', file=sys.stderr)
                sys.exit(1)
        else:
            # Empty stdin -- fall through to argv
            raw = None
    else:
        raw = None

    if raw is None:
        if len(argv) < 3:
            print(
                'Usage: rx-calc [--volume-audit] '
                '[--judge-layer subregion|group] <program_yaml_path> '
                '<today_YYYY-MM-DD> <workouts_db_path> [<exclude_session_id>]',
                file=sys.stderr
            )
            print('  or:  echo \'{"program_yaml":"...","today":"...","workouts_db":"..."}\' | rx-calc',
                  file=sys.stderr)
            sys.exit(1)
        program_yaml = argv[0]
        today = argv[1]
        db_path = argv[2]
        if len(argv) >= 4:
            # DGN-316 M-5: optional 4th positional arg
            try:
                exclude_session_id = int(argv[3])
            except ValueError:
                print(f'[rx-calc] ERROR: exclude_session_id must be an '
                      f'integer: {argv[3]!r}', file=sys.stderr)
                sys.exit(1)

    if audit_mode:
        if not os.path.exists(program_yaml):
            print(f'[rx-calc] ERROR: program.yaml not found: {program_yaml}',
                  file=sys.stderr)
            sys.exit(1)
        program = load_yaml(program_yaml)
        if not isinstance(program, dict):
            print('[rx-calc] ERROR: program.yaml did not parse as a dict',
                  file=sys.stderr)
            sys.exit(1)
        if not os.path.exists(db_path):
            print(f'[rx-calc] ERROR: workouts db not found: {db_path}',
                  file=sys.stderr)
            sys.exit(1)
        audit = volume_audit(program, db_path, today, exclude_session_id,
                             judge_layer=judge_layer)
        print(json.dumps(audit, ensure_ascii=False, indent=2))
        if audit['unmapped_program'] or audit['unmapped_actual']:
            sys.exit(3)
        sys.exit(0)

    # CLI = the SESSION_START rx path -- hydrate full safety_note prose from the
    # program-history.json sidecar (DGN-773) so the model gets injury context.
    result = calc_rx(program_yaml, today, db_path, exclude_session_id,
                     hydrate=True)

    print(json.dumps(result, ensure_ascii=False, indent=2))

    # Exit 2 if full calibration mode (all weights null)
    if result['flags']['all_calibration']:
        sys.exit(2)
    sys.exit(0)


if __name__ == '__main__':
    main()
