# Blind-axes fix (2026-07-31): movement-pattern balance (AXIS 1), per-exercise
# fatigue cost (AXIS 2), focus-slot protection (AXIS 3). ALL ADDITIVE -- these
# layers add NEW top-level keys to the audit output and never touch the stable
# keys (per_muscle / per_subregion / per_group / unmapped_program /
# unmapped_actual / flags). Motivation: the count+fatigue engine was blind to
# (a) push/pull movement-plane balance and (b) systemic/spinal fatigue cost,
# so a low-fatigue back FOCUS slot (chest_supported_t_bar_row) was flagged as
# trimmable "redundant" volume. These layers expose the missing signals; the
# trim DECISION stays in the skill (rx-calc never rewrites program.yaml).
# ---------------------------------------------------------------------------

# AXIS 1 movement_pattern closed vocabulary (mirror MUSCLE_VOCAB discipline).
PATTERN_VOCAB = (
    'horizontal_pull', 'vertical_pull', 'hinge', 'squat',
    'horizontal_push', 'vertical_push', 'isolation', 'core', 'carry',
)
# Patterns that participate in same-training-day doubling detection: only the
# major compound push/pull planes (doubling a squat/hinge/isolation in a day
# is normal programming, not a balance fault).
PATTERN_DOUBLING = (
    'horizontal_pull', 'vertical_pull', 'horizontal_push', 'vertical_push',
)
# Weekly horizontal:vertical balance axes (advisory). Threshold justification:
# balanced structural back / shoulder development and shoulder-joint health
# want horizontal and vertical pulling (and pushing) volume within roughly a
# 2:1 ratio; beyond ~2:1 one plane is materially under-stimulated relative to
# the other. Set deliberately loose (2.0) so it flags only real skew, and it
# is ADVISORY -- never a hard error, never promoted to an exit code.
PATTERN_HV_RATIO_MAX = 2.0
PATTERN_HV_AXES = {
    'pull': ('horizontal_pull', 'vertical_pull'),
    'push': ('horizontal_push', 'vertical_push'),
}

# AXIS 2 fatigue_cost closed vocabulary + heuristic-fallback signals.
FATIGUE_COST_VOCAB = ('high', 'med', 'low')
# Name substrings that signal a SUPPORTED / machine / cable movement (spine
# unloaded -> lower systemic cost).
FATIGUE_SUPPORTED_SIGNALS = (
    'machine', 'smith', 'cable', 'seated', 'supported', 'pushdown',
    'pulldown', 'pec', 'preacher', 'chest_press', 'leg_curl',
    'leg_extension', 'lat_pull',
)
# Name substrings that signal a free-standing spinal-loaded heavy compound.
FATIGUE_HEAVY_SIGNALS = (
    'barbell', 'deadlift', 'pendlay', 'back_squat', 'overhead_press', 'row',
)


def get_pattern_map(db_path):
    """exercise_pattern mapping: {exercise_name: pattern}. Empty dict when the
    table is absent (pre-migration / older instance) -- the whole pattern
    layer then degrades to a no-op (advisory only, never an exit-code driver)."""
    conn = _db_connect(db_path)
    try:
        rows = conn.execute(
            "SELECT exercise_name, pattern FROM exercise_pattern"
        ).fetchall()
    except sqlite3.OperationalError:
        return {}
    finally:
        conn.close()
    return {name: pat for name, pat in rows}


def get_fatigue_cost_map(db_path):
    """exercise_fatigue_cost mapping: {exercise_name: (cost, source)}.
    Empty dict when the table is absent -- resolve_fatigue_cost then falls to
    the deterministic heuristic for every exercise."""
    conn = _db_connect(db_path)
    try:
        rows = conn.execute(
            "SELECT exercise_name, cost, source FROM exercise_fatigue_cost"
        ).fetchall()
    except sqlite3.OperationalError:
        return {}
    finally:
        conn.close()
    return {name: (cost, source) for name, cost, source in rows}


def fatigue_cost_heuristic(name, pattern):
    """Deterministic fatigue_cost fallback for exercises with no explicit row.
    Systemic/spinal-load proxy from name signals + movement_class + pattern:
      supported/machine/seated/cable signal -> 'low'
      single-joint isolation                -> 'low'
      free hinge                            -> 'high'
      free-standing barbell squat/press/row -> 'high'
      any other compound                    -> 'med'."""
    n = (name or '').lower()
    if any(s in n for s in FATIGUE_SUPPORTED_SIGNALS):
        return 'low'
    if movement_class(name) == 'isolation':
        return 'low'
    if pattern == 'hinge':
        return 'high'
    if pattern in ('squat', 'vertical_push', 'horizontal_pull',
                   'horizontal_push') and \
       any(b in n for b in FATIGUE_HEAVY_SIGNALS):
        return 'high'
    return 'med'


def resolve_fatigue_cost(name, cost_map, pattern_map):
    """(cost, source) for one exercise. Explicit table row wins; otherwise the
    heuristic fallback (source='heuristic')."""
    hit = cost_map.get(name)
    if hit is not None:
        return hit[0], hit[1]
    return fatigue_cost_heuristic(name, pattern_map.get(name)), 'heuristic'


def proposed_pattern_sets(program, pattern_map):
    """Proposed weekly sets per movement_pattern from a program.yaml dict.
    proposed(p) = SUM(slot sets * F/R) over slots whose exercise maps to p
    (one pattern per exercise -- no role split). Returns (per_pattern,
    unmapped_pattern) where unmapped_pattern lists PROGRAMMED exercises with no
    exercise_pattern row (advisory coverage hole, NEVER an exit-3 driver)."""
    out = {}
    unmapped = []
    rotation = program.get('rotation') or []
    days = program.get('days') or {}
    freq, _ = program_weekly_frequency(program)
    factor = (freq / len(rotation)) if rotation else 1.0
    for day in rotation:
        day_plan = days.get(day) or {}
        for ex in (day_plan.get('exercises') or []):
            if not isinstance(ex, dict):
                continue
            name = ex.get('name', '')
            if not name:
                continue
            sets = ex.get('sets', 3)
            pat = pattern_map.get(name)
            if not pat:
                if name not in unmapped:
                    unmapped.append(name)
                continue
            out[pat] = out.get(pat, 0.0) + sets * factor
    return out, unmapped


def actual_pattern_sets(db_path, today, exclude_session_id=None):
    """{pattern: sets over rolling 7d ending today}. One pattern per exercise
    -> each logged set contributes 1.0 to its pattern."""
    out = {}
    conn = _db_connect(db_path)
    try:
        rows = conn.execute(
            "SELECT ep.pattern, COUNT(*) "
            "FROM workout_sets s "
            "JOIN workouts w ON w.id = s.session_id "
            "JOIN exercise_pattern ep ON ep.exercise_name = s.exercise_name "
            "WHERE " + _WINDOW_PRED + " "
            "GROUP BY ep.pattern",
            (today, today, exclude_session_id, exclude_session_id),
        ).fetchall()
    except sqlite3.OperationalError:
        return out
    finally:
        conn.close()
    for pat, cnt in rows:
        out[pat] = float(cnt or 0.0)
    return out


def pattern_layer(program, db_path, today, exclude_session_id, pattern_map):
    """AXIS 1 -- movement-pattern balance block. Returns
    (per_pattern, pattern_balance). Advisory only: NEVER changes the exit code.
    per_pattern      : {pattern: {proposed_weekly_sets, actual_sets_7d}}
    pattern_balance  : {active, unmapped_pattern, same_day_doubling,
                        hv_imbalance}."""
    if not pattern_map:
        return {}, {'active': False, 'unmapped_pattern': [],
                    'same_day_doubling': [], 'hv_imbalance': []}
    proposed, unmapped = proposed_pattern_sets(program, pattern_map)
    actual = actual_pattern_sets(db_path, today, exclude_session_id)

    all_pats = set(proposed) | set(actual)
    per_pattern = {}
    for p in sorted(all_pats):
        per_pattern[p] = {
            'proposed_weekly_sets': round(proposed.get(p, 0.0), 2),
            'actual_sets_7d':       round(actual.get(p, 0.0), 2),
        }

    # (a) same-training-day pattern doubling: a day with >= 2 slots sharing the
    # same compound push/pull pattern (e.g. 뒷B pendlay_row + t_bar_row = 2x
    # horizontal_pull). Squat/hinge/isolation doubling is normal, not flagged.
    same_day = []
    rotation = program.get('rotation') or []
    days = program.get('days') or {}
    for day in rotation:
        day_plan = days.get(day) or {}
        by_pat = {}
        for ex in (day_plan.get('exercises') or []):
            if not isinstance(ex, dict):
                continue
            name = ex.get('name', '')
            pat = pattern_map.get(name)
            if pat in PATTERN_DOUBLING:
                by_pat.setdefault(pat, []).append(
                    {'slot': ex.get('slot'), 'name': name})
        for pat, slots in by_pat.items():
            if len(slots) >= 2:
                same_day.append({'day': day, 'pattern': pat,
                                 'slots': slots})

    # (b) weekly horizontal:vertical imbalance for pull and for push. Both
    # planes trained -> flag when ratio > PATTERN_HV_RATIO_MAX. Exactly one
    # plane trained (other == 0) with the trained side substantial (>= floor
    # 4 sets) -> flag as plane_absent. Advisory.
    hv = []
    for axis, (h_pat, v_pat) in PATTERN_HV_AXES.items():
        h = proposed.get(h_pat, 0.0)
        v = proposed.get(v_pat, 0.0)
        if h > 0 and v > 0:
            hi, lo = (h, v) if h >= v else (v, h)
            ratio = hi / lo
            if ratio > PATTERN_HV_RATIO_MAX:
                hv.append({
                    'axis': axis, 'horizontal': round(h, 2),
                    'vertical': round(v, 2), 'ratio': round(ratio, 2),
                    'threshold': PATTERN_HV_RATIO_MAX,
                    'direction': ('horizontal_heavy' if h >= v
                                  else 'vertical_heavy'),
                })
        elif (h > 0) != (v > 0) and max(h, v) >= 4:
            hv.append({
                'axis': axis, 'horizontal': round(h, 2),
                'vertical': round(v, 2), 'ratio': None,
                'threshold': PATTERN_HV_RATIO_MAX,
                'direction': ('vertical_absent' if v == 0
                              else 'horizontal_absent'),
            })

    return per_pattern, {
        'active': True,
        'unmapped_pattern': unmapped,
        'same_day_doubling': same_day,
        'hv_imbalance': hv,
    }


def focus_layer(program, db_path, muscle_map, focus_muscles, fatigue,
                per_muscle, per_group, pattern_map, cost_map):
    """AXIS 2 + AXIS 3 -- per-slot fatigue_cost exposure + focus-slot
    protection. Returns (per_slot, focus). Analysis only: rx-calc EXPOSES these
    signals; it NEVER rewrites program.yaml (program writes stay owner-confirmed
    in the skill).
    per_slot : [{day, slot, name, sets, movement_pattern, fatigue_cost,
                 fatigue_cost_source, is_focus_slot, primary_muscles}]
    focus    : {focus_muscles, focus_slots, focus_conflicts}."""
    rotation = program.get('rotation') or []
    days = program.get('days') or {}

    # banding-unit verdict lookup for a muscle (per_group is keyed by unit).
    def group_verdict(muscle):
        g = per_group.get(muscle)
        return g['verdict'] if isinstance(g, dict) else None

    per_slot = []
    focus_slots = []
    focus_conflicts = []
    for day in rotation:
        day_plan = days.get(day) or {}
        focus_slot_num = day_plan.get('focus_slot')
        for ex in (day_plan.get('exercises') or []):
            if not isinstance(ex, dict):
                continue
            name = ex.get('name', '')
            if not name:
                continue
            slot_num = ex.get('slot')
            pat = pattern_map.get(name)
            cost, cost_src = resolve_fatigue_cost(name, cost_map, pattern_map)
            primaries = [m for (m, role) in muscle_map.get(name, [])
                         if role == 'primary']
            is_focus = (focus_slot_num is not None
                        and slot_num == focus_slot_num)
            per_slot.append({
                'day': day, 'slot': slot_num, 'name': name,
                'sets': ex.get('sets', 3),
                'movement_pattern': pat,
                'fatigue_cost': cost,
                'fatigue_cost_source': cost_src,
                'is_focus_slot': is_focus,
                'primary_muscles': primaries,
            })
            if not is_focus:
                continue

            # This slot is the day's designated focus reinforcement slot.
            focus_prim = [m for m in primaries if m in focus_muscles]
            focus_slots.append({
                'day': day, 'slot': slot_num, 'name': name,
                'movement_pattern': pat, 'fatigue_cost': cost,
                'primary_muscles': primaries,
                'focus_primary_muscles': focus_prim,
            })
            # focus_conflicts: flag when this focus_slot would plausibly be a
            # trim candidate. Two triggers, both advisory:
            #  (1) focus_above_ceiling -- a focus primary muscle is at/above
            #      ceiling (over-dosed focus; a dose trim would target it).
            #  (2) focus_slot_trim_risk -- a focus primary muscle carries a
            #      fatigue signal (state loaded/fatigued), so the fatigue-driven
            #      trim pass could cut a set from this muscle's primary slots --
            #      and THIS is a focus reinforcement slot. The slot's own
            #      fatigue_cost is reported so the skill can prefer trimming a
            #      HIGH-fatigue non-focus slot instead of this one.
            for m in focus_prim:
                mv = per_muscle.get(m, {})
                verdict = mv.get('verdict')
                state = mv.get('fatigue_state')
                gverd = group_verdict(m)
                if verdict == 'above_ceiling':
                    focus_conflicts.append({
                        'day': day, 'slot': slot_num, 'name': name,
                        'type': 'focus_above_ceiling', 'muscle': m,
                        'muscle_verdict': verdict,
                        'muscle_fatigue_state': state,
                        'group_verdict': gverd,
                        'fatigue_cost': cost,
                        'note': ('focus muscle at/above ceiling -- resolve dose '
                                 'before touching the focus reinforcement slot'),
                    })
                elif state in ('loaded', 'fatigued'):
                    focus_conflicts.append({
                        'day': day, 'slot': slot_num, 'name': name,
                        'type': 'focus_slot_trim_risk', 'muscle': m,
                        'muscle_verdict': verdict,
                        'muscle_fatigue_state': state,
                        'group_verdict': gverd,
                        'fatigue_cost': cost,
                        'note': ('focus muscle carries a fatigue signal; this '
                                 'is the focus reinforcement slot (fatigue_cost='
                                 + str(cost) + ') -- prefer trimming a HIGH '
                                 'fatigue_cost non-focus slot first'),
                    })

    focus = {
        'focus_muscles': sorted(focus_muscles),
        'focus_slots': focus_slots,
        'focus_conflicts': focus_conflicts,
    }
    return per_slot, focus


# ---- DGN-316 6.1: --volume-audit (allocation check) ----

def volume_audit(program, db_path, today, exclude_session_id=None,
                 judge_layer=None):
    """Deterministic allocation audit of a program.yaml (proposed or live)
    against per-muscle bands + rolling actuals + fatigue states.
    Returns the 6.1 output dict; CLI maps unmapped -> exit 3.
    Verdict basis (implementation note): ceiling side = PROPOSED dose
    (spec 4.2: proposed > ceiling is the allocation violation; actual-side
    overreach is S1's job). Floor side = PROPOSED (design-time under-dose,
    always live) OR ACTUAL delivery (attendance-gated per M-6)."""
    muscle_map = get_muscle_map(db_path)
    focus_muscles, unexpanded = get_focus_muscles(db_path, program)
    vocab = muscle_vocab(db_path)
    proposed, unmapped_prog, freq, freq_defaulted = proposed_sets(
        program, muscle_map, vocab)
    actual = actual_sets(db_path, today, exclude_session_id)
    unmapped_act = unmapped_actual(db_path, today, exclude_session_id)
    w_count = window_session_count(db_path, today, exclude_session_id)
    total = total_structured_sessions(db_path)
    ramp_active = total < MUSCLE_RAMP_MIN_SESSIONS
    insufficient = w_count < freq - 1          # attendance gate (M-6)
    fatigue = muscle_fatigue(program, db_path, today, exclude_session_id,
                             muscle_map=muscle_map,
                             focus_muscles=focus_muscles)
    prog_muscles = programmed_muscles(program, muscle_map)

    per_muscle = {}
    for m in vocab:
        band = resolve_band(m, program, focus_muscles)
        if m not in prog_muscles and m not in focus_muscles:
            verdict = 'untrained'              # 4.3 scope rule (info line)
        elif proposed[m] > band['ceiling']:
            verdict = 'above_ceiling'          # dose signal: gate-immune
        elif proposed[m] < band['floor']:
            verdict = 'below_floor'            # program-side under-dose
        elif actual[m] < band['floor']:
            # actual-delivery floor check: attendance-gated (M-6)
            verdict = 'insufficient_data' if insufficient else 'below_floor'
        else:
            verdict = 'in_band'
        per_muscle[m] = {
            'proposed_weekly_sets': round(proposed[m], 2),
            'actual_sets_7d':       round(actual[m], 2),
            'band': band,
            'verdict': verdict,
            'fatigue_state': fatigue[m]['state'],
            'signals': fatigue[m]['signals'],
        }

    # Sub-region + banding-unit layer (2026-07-18). ALONGSIDE per_muscle; the
    # top-level backward-compat keys (per_muscle, unmapped_program,
    # unmapped_actual, flags) are untouched. Degrades to empty on absent table.
    per_subregion, per_group, unmapped_sub, judgement = subregion_layer(
        program, db_path, today, exclude_session_id, muscle_map, insufficient,
        judge_layer=judge_layer)

    # Blind-axes layers (2026-07-31). ALL ADDITIVE new top-level keys; the
    # stable keys above (per_muscle / per_subregion / per_group /
    # unmapped_program / unmapped_actual / flags) stay byte-identical. Pattern
    # coverage is ADVISORY (pattern_balance.unmapped_pattern), never promoted
    # to exit 3. Degrades to inert defaults on absent tables.
    pattern_map = get_pattern_map(db_path)
    cost_map = get_fatigue_cost_map(db_path)
    per_pattern, pattern_balance = pattern_layer(
        program, db_path, today, exclude_session_id, pattern_map)
    per_slot, focus = focus_layer(
        program, db_path, muscle_map, focus_muscles, fatigue,
        per_muscle, per_group, pattern_map, cost_map)

    # Load axes (2026-08-25). ADDITIVE new top-level keys. Nothing above this
    # line reads them, so no band verdict can move because they exist -- that
    # independence is the design, and tests/test-load-axes.py pins it.
    axial = axial_layer(program, db_path, today, exclude_session_id)
    load_sub, load_group, load_skipped = load_layer(
        program, db_path, today, exclude_session_id)
    overlap = session_overlap_layer(program, db_path, today, pattern_map,
                                    cost_map, muscle_map, axial)

    result = {
        'per_muscle': per_muscle,
        # ADDITIVE (owner 2026-10-04): the practice / functional rows, said
        # apart (muscle_sets_per_week = what the band counts of them)
        'practice': practice_volume(program),
        'per_subregion': per_subregion,
        'per_group': per_group,
        'unmapped_program': unmapped_prog,
        'unmapped_actual':  unmapped_act,
        'flags': {
            'weekly_frequency_defaulted': freq_defaulted,
            'ramp_guard_active': ramp_active,
            'window_sessions': w_count,
            'insufficient_attendance': insufficient,
            'subregion_layer_active': bool(per_group),
            'unmapped_subregion': unmapped_sub,
            'axial_layer_active': axial.get('active', False),
            'load_layer_active': bool(load_group),
            'judge_layer': judgement.get('layer'),
        },
        # Which layer formed the verdicts, and what it found. Read THIS rather
        # than guessing between per_group and per_subregion.
        'judgement': judgement,
        # ADDITIVE (blind-axes fix) -- new top-level keys only.
        'per_pattern':     per_pattern,
        'pattern_balance': pattern_balance,
        'per_slot':        per_slot,
        'focus':           focus,
        # ADDITIVE (load axes) -- see the LOAD AXES header block for why these
        # are two numbers alongside the bands rather than one redefined one.
        'axial':           axial,
        # ADDITIVE (owner 2026-10-06 21:50): neighbouring sessions sharing a
        # stressor at the tightest gap, and same-session stacking
        'session_overlap': overlap,
        'load': {
            'per_subregion': load_sub,
            'per_group':     load_group,
            'skipped':       load_skipped,
            'unit':          'kg x reps x subregion_weight',
            'banded':        False,
            'note':          ('ceiling indicator (grow this to grow). The set '
                              'counts in per_group are the floor indicator '
                              '(below this you do not grow). Two roles, two '
                              'numbers -- neither is a band.'),
        },
    }
    if unexpanded:
        # free-text focus label: flagged, never guessed (spec 2.3)
        result['flags']['unexpanded_focus_labels'] = unexpanded
    return result


# ---------------------------------------------------------------------------
# Core progression arithmetic ([DET] -- spec section 3.1)
# ---------------------------------------------------------------------------

def apply_progression(exercise, top_set_reps):
    """
    Apply double-progression arithmetic to one exercise slot.
    exercise: dict from program.yaml exercises list.
    top_set_reps: int or None (None = no data = no change).

    Returns updated exercise dict (copy) + progression_applied label.
    Does NOT mutate the input.
    """
    ex = dict(exercise)  # shallow copy
    weight = ex.get('weight_kg')
    sets = ex.get('sets', 3)
    rep_range = ex.get('rep_range', [6, 10])
    miss_streak = ex.get('miss_streak', 0)
    inc_override = ex.get('inc_override')
    name = ex.get('name', '')
    progression_mode = ex.get('progression', 'double')

    # Calibration mode: weight not yet seeded
    if weight is None:
        ex['progression_applied'] = 'calibration'
        ex['calibration'] = True
        return ex

    ex['calibration'] = False

    # Hold slots (rehab / maintenance): never progress
    if progression_mode == 'hold':
        ex['progression_applied'] = 'hold'
        return ex

    # No result data: no change (spec 3.1: "결과 데이터 없음 -> 상태 불변")
    if top_set_reps is None:
        ex['progression_applied'] = 'none'
        return ex

    lo, hi = rep_range[0], rep_range[1]
    inc = inc_override if (inc_override is not None) else default_inc(name)

    # ASSISTED slots (assisted-machine pull-up / chin-up): weight_kg is the
    # ASSIST load (counterweight), so MORE weight = EASIER, LESS weight =
    # HARDER. Progression direction is therefore INVERTED vs a normal loaded
    # slot: reaching the top of the rep range must REDUCE assist (make it
    # harder), and a deload must ADD assist (make it easier). Same increment
    # logic (inc_override / default step), applied in reverse. Non-assisted
    # slots take the original branches unchanged. Never drive assist below 0.
    assisted = bool(ex.get('assisted'))

    if top_set_reps >= hi:
        # Top of range reached -- progress (advance difficulty).
        if assisted:
            ex['weight_kg'] = max(weight - inc, 0.0)  # less assist = harder
        else:
            ex['weight_kg'] = weight + inc            # more load = harder
        ex['miss_streak'] = 0
        ex['progression_applied'] = 'up'
    elif lo <= top_set_reps < hi:
        # Within range -- hold weight, reset streak
        ex['miss_streak'] = 0
        ex['progression_applied'] = 'hold'
    else:
        # Below floor -- miss
        new_streak = miss_streak + 1
        if new_streak >= MISS_STREAK_DELOAD:
            if assisted:
                # Deload = make it EASIER = ADD assist (reversed direction).
                ex['weight_kg'] = weight + inc
            else:
                # Deload: weight * 0.9, round down to 2.5kg step
                deloaded = round_down_to_step(weight * DELOAD_FACTOR, DELOAD_ROUND_KG)
                ex['weight_kg'] = max(deloaded, DELOAD_ROUND_KG)  # floor at 2.5kg
            ex['miss_streak'] = 0
            ex['progression_applied'] = 'deload'
        else:
            ex['miss_streak'] = new_streak
            ex['progression_applied'] = 'hold'

    return ex


# ---------------------------------------------------------------------------
# DGN-303 design-v3 5.3: strategy A (PORTABLE CORE) -- top-set inheritance.
# Extract the top set from the stream, reuse the existing apply_progression.
# [DET] only. This is the CORE engine -- do NOT modify (invariant, design-v3
# 5.5). Main/HAND-lite agents (no domain split) run this degraded path.
# ---------------------------------------------------------------------------

def _top_set(sets, ex_yaml):
    """The HARDEST set in the stream.

    ASSIST INVERSION: on an assisted slot weight_kg is the counterweight, so
    the hardest set is the one with the LOWEST number. `max(weight)` picked
    the most-assisted -- i.e. the EASIEST -- set and handed its rep count to
    the progression arithmetic. The flag is read from the slot itself, which
    is the same source apply_progression already reads, so this needs no DB
    and cannot disagree with the direction flip below. Non-assisted slots
    keep the original key exactly.
    """
    if ex_yaml.get('assisted'):
        return max(sets, key=lambda s: (-(s.weight_kg or 0), s.reps))
    return max(sets, key=lambda s: (s.weight_kg or 0, s.reps))


def _stream_session_date(ctx, sets):
    """`workouts.date` for the session these sets belong to, when the records
    carry a session id. None -> the caller uses the latest bodyweight."""
    if ctx is None:
        return None
    for s in sets:
        sid = getattr(s, 'session_id', None)
        if sid is not None:
            date = ctx.session_date(sid)
            if date:
                return date
    return None


def _stream_volume(working, ex_yaml, db_path=None):
    """Volume load of this session's working sets, on the SAME basis
    get_last_session_stream reports for the prior session.

    ASSIST INVERSION: an assisted set's unit is
    (bodyweight_at_the_time - counterweight) x reps. Both sides of the (4a)/
    (4b) delta must speak this unit or an assist REDUCTION -- which is
    progress -- reads as a volume crash and fires a phantom hold/deload.
    No assist_load module, or a non-assisted slot -> the original sum."""
    if _AL is None or not ex_yaml.get('assisted'):
        return sum(s.weight_kg * s.reps for s in working)
    ctx = _assist_ctx(db_path)
    if ctx is None:
        return sum(s.weight_kg * s.reps for s in working)
    name = ex_yaml.get('name', '')
    date = _stream_session_date(ctx, working)
    total = 0.0
    for s in working:
        # None = unmeasurable (no bodyweight reading anywhere). Contributing 0
        # would understate; the honest reading is that this set carries no
        # volume number, exactly like a NULL weight_kg row.
        total += _AL.set_volume(ctx, name, s.weight_kg, s.reps, date) or 0.0
    return total


def apply_progression_from_sets(sets, ex_yaml):
    """
    Strategy A (PORTABLE CORE): top-set from the set stream -> apply_progression.
    [DET] only. DGN-301 top-set arithmetic inherited unchanged.
    """
    if not sets:
        return dict(ex_yaml)                                # no data = no change
    top = _top_set(sets, ex_yaml)
    return apply_progression(ex_yaml, top.reps)


# ---------------------------------------------------------------------------
# DGN-303 design-v3 5.4: strategy B (WARG) -- full-stream progression engine.
# [DET] only. Consumes this session's full set stream + the prior session's
# stream aggregate to produce ONE progression decision. B REFINES A: it only
# suppresses (up -> hold) or fires an early deload; it NEVER makes A more
# aggressive (safety bias: cut phase + M1 no-invent). Includes design-v3 14
# FINAL FIX-ROUND: F-B1 hold-slot guard, F-B2 working-set-only volume,
# m-B1 set_seq sort.
# ---------------------------------------------------------------------------

# Strategy B progression constants (named; program.yaml per-exercise override).
STREAM_VOLUME_DROP_HOLD   = 0.10   # vol drop > 10% vs prior -> suppress up (hold)
STREAM_LASTSET_DROP_FLOOR = 0.60   # last working set < rep_range.lo * 0.60 = collapse
STREAM_SETCOUNT_SHORTFALL = 1      # achieved short of prescribed by this -> unfinished
STREAM_DELOAD_VOLUME_DROP = 0.20   # vol drop > 20% + collapse/short -> early deload


def apply_progression_stream(sets, prev, ex_yaml, rx_ex=None, db_path=None):
    """
    Strategy B (WARG): full-stream [DET] progression engine.
    sets:    this session's SetRecord list for this exercise (all sets).
    prev:    prior session aggregate dict (get_last_session_stream, 5.6) or None.
    ex_yaml: program.yaml dict for this exercise.
    returns: updated ex_yaml (same shape as apply_progression: weight_kg /
             miss_streak / progression_applied in
             {up, hold, deload, calibration, none}).

    RIR is an OPTIONAL enrichment (5.4.1), consumed only when present; absent
    it is ignored and the rules complete. All thresholds are the named
    constants above (or ex_yaml override) -- no runtime invention.

    rx_ex (DGN-316 5.3, COMPATIBLE EXTENSION of this DGN-303 surface):
    optional dict {"sets_effective": int, "fatigue_trim": bool} -- today's rx
    trim context for this exercise, passed by POST_SESSION from ctx. ONLY
    when present AND fatigue_trim is true: (a) short_session uses the trimmed
    effective prescription, (b) the volume arms (4a)/(4b) compare PER-SET
    volume-load (a faithful trimmed session is not evidence; a REAL per-set
    collapse still fires). Default None = byte-identical pre-DGN-316 path.
    """
    ex = dict(ex_yaml)
    trim_ctx = bool(rx_ex) and bool(rx_ex.get('fatigue_trim'))

    # (0) no data = no change (mirrors A).
    if not sets:
        ex['progression_applied'] = 'none'
        return ex

    # (1) calibration: every set weightless -> progression state unchanged.
    if all(s.weight_kg is None for s in sets):
        ex['progression_applied'] = 'calibration'
        ex['calibration'] = True
        return ex

    # (2) stream aggregate [DET]. F-B2: volume + last-working-set are
    # working-sets-only so mid-stream calibration sets never deflate volume.
    rep_range = ex.get('rep_range', [6, 10])
    lo, hi = rep_range[0], rep_range[1]
    prescribed_sets = ex.get('sets', 3)
    if trim_ctx:
        # DGN-316 5.3 item 3: a faithful trimmed session is not "short".
        prescribed_sets = rx_ex.get('sets_effective', prescribed_sets)

    # per-exercise threshold overrides (design-v3 5.4; DGN-301 inc_override kin).
    vol_drop_hold = ex.get('stream_volume_drop_hold', STREAM_VOLUME_DROP_HOLD)
    lastset_floor = ex.get('stream_lastset_drop_floor', STREAM_LASTSET_DROP_FLOOR)
    setcount_short = ex.get('stream_setcount_shortfall', STREAM_SETCOUNT_SHORTFALL)
    vol_drop_deload = ex.get('stream_deload_volume_drop', STREAM_DELOAD_VOLUME_DROP)

    # m-B1: sort working sets by set_seq so "last working set" is well-defined
    # even after F3a UPSERT correction / OQ-N out-of-order arrival.
    # set_seq >= 1 mirrors get_last_session_stream (5.6): TODAY's volume must be
    # measured on the same working-sets-only basis as `prev`, or the delta below
    # compares a ramp-inflated numerator against a ramp-free denominator and
    # manufactures a phantom volume drop (-> spurious hold/deload in 4a/4b).
    working = sorted((s for s in sets
                      if s.weight_kg is not None and s.set_seq >= 1),
                     key=lambda s: s.set_seq)
    # ASSIST INVERSION: `vol` is compared against prev['volume_load'], which
    # get_last_session_stream now emits on the effective-load basis -- both
    # sides of the delta must speak the same unit or an assist REDUCTION
    # reads as a volume crash and fires a phantom hold/deload (4a/4b below).
    vol = _stream_volume(working, ex, db_path=db_path)
    top = _top_set(sets, ex)
    top_reps = top.reps
    last_set_reps = working[-1].reps if working else 0
    achieved_sets = len(sets)

    # (3) stream signals [DET].
    collapsed = last_set_reps < lo * lastset_floor
    short_session = achieved_sets <= (prescribed_sets - setcount_short)

    # RIR enrichment (5.4.1): if the last WORKING set reported rir <= 0
    # (trained to failure), strengthen the collapse signal. Present-only;
    # absent -> ignored. Makes the decision MORE conservative only.
    if working and working[-1].rir is not None and working[-1].rir <= 0:
        collapsed = True

    vol_dropped_hold = False
    vol_dropped_deload = False
    if prev and prev.get('volume_load'):
        prev_vol = prev['volume_load']
        if trim_ctx:
            # DGN-316 5.3 item 3: PER-SET volume comparison under a trim --
            # the trim itself (-25..-33% total by construction) is not
            # evidence; a genuine per-set collapse still fires both arms.
            # Both quantities already available (get_last_session_stream
            # returns set_count; no new query).
            prev_sc = prev.get('set_count') or 0
            if prev_vol > 0 and prev_sc > 0 and working:
                this_per_set = vol / len(working)
                prev_per_set = prev_vol / prev_sc
                delta = (this_per_set - prev_per_set) / prev_per_set
                vol_dropped_hold = delta < -vol_drop_hold      # < -10%
                vol_dropped_deload = delta < -vol_drop_deload  # < -20%
        elif prev_vol > 0:
            delta = (vol - prev_vol) / prev_vol
            vol_dropped_hold = delta < -vol_drop_hold          # < -10%
            vol_dropped_deload = delta < -vol_drop_deload      # < -20%

    # (4) decision rules (priority order; all [DET]).
    #   base = core A's top-set verdict first, then stream refinement.
    base = apply_progression(ex, top_reps)
    applied = base.get('progression_applied')

    # F-B1 (design-v3 14): if A held (rehab/maintenance hold slot) or is in
    # calibration, the slot weight is inviolable -- B must NOT cut it. Skip
    # (4a)/(4b) entirely and return A's verdict.
    if applied in ('hold', 'calibration'):
        return base

    # (4a) early deload: volume crash > 20% + (collapse OR unfinished) ->
    #      deload now (A waits for miss_streak==2; B fires on the crash).
    if vol_dropped_deload and (collapsed or short_session):
        weight = ex.get('weight_kg') or 0
        if bool(ex.get('assisted')):
            # ASSISTED slot: an early deload must ADD assist (make it easier),
            # the reverse of a loaded slot's weight cut. Same increment logic.
            inc = ex.get('inc_override')
            if inc is None:
                inc = default_inc(ex.get('name', ''))
            ex['weight_kg'] = weight + inc
        else:
            deloaded = round_down_to_step(weight * DELOAD_FACTOR, DELOAD_ROUND_KG)
            ex['weight_kg'] = max(deloaded, DELOAD_ROUND_KG)
        ex['miss_streak'] = 0
        ex['progression_applied'] = 'deload'
        return ex

    # (4b) suppress up: A said up but the stream shows collapse/vol-drop/
    #      unfinished -> downgrade to hold (ceiling hit, so not a miss).
    if applied == 'up' and (collapsed or vol_dropped_hold or short_session):
        ex['miss_streak'] = 0
        ex['progression_applied'] = 'hold'
        return ex

    # (4c) otherwise: core A verdict verbatim (up / hold / deload / none).
    return base


# ---------------------------------------------------------------------------
# DGN-303 design-v3 5.5: SEAM -- strategy dispatcher. One parameter selects
# A vs B. Core A stays byte-identical; B wraps A. Strategy is deployment
# config (agent identity), not a per-session judgement -- read from
# program.yaml progression_strategy (default "core").
# ---------------------------------------------------------------------------

def apply_progression_dispatch(sets, ex_yaml, db_path, session_type_id,
                               strategy, exclude_session_id=None, rx_ex=None):
    """
    Progression strategy dispatcher [DET]. seam.
    strategy: "core" (strategy A) | "warg" (strategy B).  # estate-scrub:allow(program.yaml progression_strategy value, a config contract)
    exclude_session_id (M-B1): passed to get_last_session_stream so the prior
    lookup excludes today's just-stored session (self-reference guard).
    rx_ex (DGN-316 5.3): optional per-exercise rx trim context
    {"sets_effective": int, "fatigue_trim": bool} from ctx, POST_SESSION
    only. Default None = pre-DGN-316 behavior, byte-identical. Strategy A
    (core) ignores it -- A is top-set-only, no set-count/volume arms.
    """
    if strategy == "warg":  # estate-scrub:allow(program.yaml progression_strategy value, a config contract)
        prev = get_last_session_stream(
            db_path, ex_yaml.get('name', ''), session_type_id,
            exclude_session_id=exclude_session_id)
        return apply_progression_stream(sets, prev, ex_yaml,
                                        rx_ex=rx_ex,
                                        db_path=db_path)         # strategy B
    # default = "core" (degraded/portable)
    return apply_progression_from_sets(sets, ex_yaml)            # strategy A


# ---------------------------------------------------------------------------
# Rotation selection ([DET] -- spec section 1.5)
# ---------------------------------------------------------------------------

def select_rotation_day(program, db_path, exclude_session_id=None):
    """
    Determine the next rotation day from program.yaml and workouts DB.

    Returns (rotation_day_code, basis_text, provisional_flag).
    rotation_day_code: one of the strings in program['rotation'] list.
    basis_text: human-readable one-liner for the rx header.
    provisional_flag: True if rotation could not be confirmed from tagged sessions.
    """
    rotation = program.get('rotation', [])
    if not rotation:
        return None, 'rotation list empty in program.yaml', False

    last_type_id, last_date, provisional = get_last_weight_session(
        db_path, rotation, exclude_session_id=exclude_session_id)

    if last_type_id is None and last_date is None:
        # No weight sessions at all -- start at rotation[0]
        day = rotation[0]
        return day, f'no weight sessions found; starting rotation at {day}', False

    if provisional:
        # Weight sessions exist but none are tagged -- provisional inference
        # We cannot determine current rotation position; default to rotation[0]
        # and flag for confirmation (m7)
        day = rotation[0]
        basis = (f'last weight session {last_date} has no session_type_id tag; '
                 f'rotation position provisional -- starting at {day} pending confirmation')
        return day, basis, True

    # Look up the code of the last session type
    type_codes = get_session_type_codes(db_path)
    last_code = type_codes.get(last_type_id)

    if last_code and last_code in rotation:
        current_idx = rotation.index(last_code)
        next_idx = (current_idx + 1) % len(rotation)
        day = rotation[next_idx]
        basis = f'last session was {last_code} on {last_date}; next in rotation: {day}'
        return day, basis, False
    else:
        # Code not in rotation list -- provisional fallback
        day = rotation[0]
        basis = (f'last session type code {last_code!r} not found in rotation list; '
                 f'defaulting to {day} -- confirm rotation position')
        return day, basis, True


# ---------------------------------------------------------------------------
# C1 (2026-08-01): deterministic regular-vs-makeup session gate.
# The rotation selector above is queue-based (no weekday concept), so a
# Sat/Sun "운동 시작" would serve the next rotation slot as if it were a
# regular session (incident: session 48 wrongly tagged 앞A). This gate
# decides session_class from MEASURED weekly state, not inference: count the
# DISTINCT regular splits already tagged in the current training week
# (Mon-Sun, KST) vs the rotation target. Quota met -> makeup; quota short ->
# regular (serve the next rotation slot -- catch the queue up first, even on
# a weekend). SESSION_START consumes result['session_class'] so both
# workout-session and workout-program route off the SAME verdict (no per-skill
# re-judgment). today is passed in (never now()) so this stays deterministic.
# ---------------------------------------------------------------------------

def _week_bounds(today_str):
    """Monday..Sunday (ISO date strings) of the training week containing
    today_str (YYYY-MM-DD). Week starts Monday (date.weekday(): Mon=0)."""
    d = datetime.date.fromisoformat(today_str)
    monday = d - datetime.timedelta(days=d.weekday())
    sunday = monday + datetime.timedelta(days=6)
    return monday.isoformat(), sunday.isoformat()


def week_regular_status(program, db_path, today, exclude_session_id=None):
    """Deterministic regular/makeup verdict for `today`.

    Returns a dict:
      session_class      'regular' | 'makeup'
      week_regular_done  count of DISTINCT regular splits tagged this week
      week_regular_target len(rotation) (e.g. 4)
      done_codes         the distinct regular split codes done this week
      week_start/week_end Mon/Sun ISO dates of the training week

    A split counts only when a workouts row this week is session_type_id-
    tagged AND that type's code is in program['rotation'] AND the row has at
    least one real workout_sets set (untagged makeup rows never count; a
    birth-tagged but empty 0-set row is NOT complete). Same split done twice
    -> counts once (DISTINCT). Quota met (done >= target) -> makeup; else
    regular.

    exclude_session_id (G1, 2026-08-23): the session THIS verdict is being
    computed FOR. The tally answers "which splits have I ALREADY completed
    this week", so the session being opened/served must never count itself.
    Without this the label self-poisoned the moment the first set landed: a
    뒷B session with 앞A/뒷A/앞B already done sat at done=3 ('정규') while
    empty, then its own first set pushed done to 4 -> the SAME open session
    re-labelled itself '보충' mid-training and the serving rules refused to
    serve it as a regular rotation slot. calc_rx already receives this id
    (every hot caller passes the open session); it just was not forwarded
    here -- which is exactly why the "exclude this session" workaround
    restored the exercise list (select_rotation_day honors the id) but left
    the 정규/보충 label wrong.
    """
    rotation = program.get('rotation', []) or []
    target = len(rotation)
    monday, sunday = _week_bounds(today)
    type_codes = get_session_type_codes(db_path)  # {id: code}
    done_codes = []
    excl_id = ""
    params = [monday, today]
    if exclude_session_id is not None:
        excl_id = " AND w.id != ?"
        params.append(exclude_session_id)
    try:
        conn = _db_connect(db_path)
        try:
            # Count splits DONE SO FAR this week: lower bound = Monday, upper
            # bound = today (NOT Sunday) -- a session dated later in the same
            # week has not happened yet at `today` and must not count.
            rows = conn.execute(
                "SELECT DISTINCT session_type_id FROM workouts w "
                "WHERE date >= ? AND date <= ? "
                "AND session_type_id IS NOT NULL "
                "AND EXISTS (SELECT 1 FROM workout_sets ws "
                "WHERE ws.session_id = w.id)" + excl_id,
                params,
            ).fetchall()
        finally:
            conn.close()
    except sqlite3.OperationalError:
        rows = []
    for (tid,) in rows:
        code = type_codes.get(tid)
        if code in rotation and code not in done_codes:
            done_codes.append(code)
    done_count = len(done_codes)
    session_class = 'makeup' if (target and done_count >= target) else 'regular'
    return {
        'session_class':      session_class,
        'week_regular_done':  done_count,
        'week_regular_target': target,
        'done_codes':         done_codes,
        'week_start':         monday,
        'week_end':           sunday,
    }


