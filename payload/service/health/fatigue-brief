OFFERS = ".fatigue-retro-offers.json"


def _codes_of(conn, wids):
    out = {}
    for wid in wids:
        row = conn.execute("SELECT st.code FROM workouts w JOIN session_type "
                           "st ON st.id = w.session_type_id WHERE w.id=?",
                           (wid,)).fetchone()
        if row:
            out[wid] = row[0]
    return out


def build_retro(db, prog, week, today, state_dir, record=True, facts_only=False):
    M = mf()
    if M is None:
        return []
    conn = ro_conn(db)
    try:
        w = M.compute_week(conn, week, today)
        if not w["sessions"]:
            return []
        tax = M.Taxonomy(conn)
        lib = M.Library(conn, tax)
        labels = joined([t["label"] for t in w["top"][:2]])
        lines = []
        ov = [o for o in w["overlaps"]]
        if ov:
            count = {}
            for o in ov:
                count[o["node"]] = count.get(o["node"], 0) + 1
            node = max(sorted(count), key=lambda n: count[n])
            lab = tax.label(node)
            lines.append(T("retro_top_overlap", labels_reul=J(labels, "reul"),
                           olabel_i=J(lab, "i"), n=count[node]))
        elif labels:
            lines.append(T("retro_top", labels_reul=J(labels, "reul")))
        offers = {} if facts_only else _read_offers(state_dir)
        proposal = None
        fd = w.get("function_direction") or {}
        if fd.get("on"):
            missing = [f for f in w["functional"] if f["sets"] == 0
                       and (facts_only or not (not f["library_has"] and _closed(
                           offers, "new:%s" % f["item"], w["week"])))]
            if missing:
                nm = [FUNCTIONAL[f["item"]]["name"] for f in missing[:2]]
                names = nm[0] if len(nm) == 1 else "%s %s" % (
                    J(nm[0], "irang"), nm[1])
                lines.append(T("retro_missing", items_i=J(names, "i")))
            for f in ([] if facts_only else missing):
                cand = _functional_candidate(M, conn, tax, lib, prog,
                                             f["item"])
                if cand:
                    key = "add:%s" % cand
                    s = T("retro_add_existing",
                          ex_reul=J(ex_ko(cand, prog), "reul"))
                else:
                    add = FUNCTIONAL[f["item"]]["add"]
                    key = "new:%s" % f["item"]
                    s = T("retro_add_new",
                          item_i=J(FUNCTIONAL[f["item"]]["name"], "i"),
                          ex_reul=J(add, "reul"))
                if _closed(offers, key, w["week"]):
                    continue
                proposal = (key, s)
                break
        if not facts_only and proposal is None and ov:
            sp = _spacing(M, conn, tax, lib, w, ov)
            if sp:
                a_code, b_code = sp
                key = "space:%s:%s" % (a_code, b_code)
                if not _closed(offers, key, w["week"]):
                    proposal = (key, T("retro_space", a_wa=J(a_code, "wa"),
                                       b=b_code))
        if proposal:
            lines.append(proposal[1])
            if record:
                weeks = offers.setdefault(proposal[0], [])
                if w["week"] not in weeks:
                    weeks.append(w["week"])
                write_json(os.path.join(state_dir, OFFERS), offers)
    finally:
        conn.close()
    lines = lines[:3]
    for s in lines:
        gate(s, "retro")
    return lines


def _closed(offers, key, week):
    """Spec A5 offer decay: offered OFFER_CLOSE_AFTER times in other weeks
    -> silently closed (re-running the same week does not count)."""
    weeks = offers.get(key, [])
    return len(weeks) >= OFFER_CLOSE_AFTER and week not in weeks


def _read_offers(state_dir):
    try:
        with open(os.path.join(state_dir, OFFERS), encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def _functional_candidate(M, conn, tax, lib, prog, item):
    """An exercise this user already has that covers `item`: used before,
    else in their program, else registered."""
    have = [ex for ex in sorted(lib.names())
            if item in M.functional_flags(lib, tax, ex)]
    if not have:
        return None
    used = {r[0] for r in conn.execute(
        "SELECT DISTINCT exercise_name FROM workout_sets")}
    for pool in (used, prog.names(), set(lib.ax)):
        for ex in have:
            if ex in pool:
                return ex
    return None


def _spacing(M, conn, tax, lib, w, ov):
    """(earlier code, later code) of the worst overlap: the session that
    re-loaded the region and the one that left it loaded."""
    worst = max(ov, key=lambda o: o["pre_ratio"])
    t = _dt(worst["at"])
    sessions = M.load_sessions(conn, tax, lib, t - datetime.timedelta(days=4),
                               t + datetime.timedelta(minutes=1))
    prior = [s for s in sessions if s.t < t and any(
        (tax.muscle_of(n) or n) == worst["node"] for n in s.load)]
    if not prior:
        return None
    codes = _codes_of(conn, [prior[-1].workout_id, worst["workout_id"]])
    a_code = codes.get(prior[-1].workout_id)
    b_code = codes.get(worst["workout_id"])
    if not a_code or not b_code or a_code == b_code:
        return None
    return a_code, b_code


def cmd_retro(a):
    if a.lane != "weekly":
        return EXIT_NOTHING
    try:
        raw_today = a.today or os.environ.get("KIT_RETRO_TODAY")
        today = (datetime.datetime.strptime(raw_today, "%Y-%m-%d")
                 if raw_today else datetime.datetime.now())
        week = a.week
        # An explicit date selects its own week; otherwise use the kit's
        # review window, including Monday reviews of a historical week.
        start = os.environ.get("KIT_RETRO_WEEK_START")
        if not week and not a.today and start:
            week = datetime.datetime.strptime(start, "%Y-%m-%d").strftime("%G-W%V")
        if not week and today.weekday() == 0:
            # a Monday retro looks back on the week that just ended
            week = (today - datetime.timedelta(days=7)).strftime("%G-W%V")
        lines = build_retro(a.db, Program(a.program), week, today,
                            a.state_dir, record=(a.mode == "section"),
                            facts_only=a.facts_only)
    except Exception as exc:  # noqa: BLE001 -- a provider never fails a retro
        print("fatigue-brief retro: %s" % exc, file=sys.stderr)
        return EXIT_NOTHING
    if not lines:
        return EXIT_NOTHING
    print(lines[0] if a.mode == "line" else "\n".join(lines))
    return EXIT_OK


