def render_photo(rd, rows, out_path):
    """The heatmap photo, or (None, why). In-process when this interpreter
    has numpy + Pillow; otherwise the render interpreter (RENDER_PYTHON, the
    shared render venv, python3 on PATH) runs fatigue_heatmap.py."""
    payload = {"node_ratio": rd.node_ratio(),
               "rows": [[l, p, r] for l, p, r in rows], "out": out_path,
               "title": COPY["photo_title"],
               "legend": {"front": COPY["photo_front"],
                          "back": COPY["photo_back"],
                          "scale_high": COPY["photo_high"],
                          "scale_low": COPY["photo_low"],
                          "empty": COPY["photo_empty"]}}
    import fatigue_heatmap as FH
    ok, why = FH.available()
    # FATIGUE_RENDER_INPROCESS=0 forces the render interpreter (tests pin a
    # stub renderer that way on hosts that also have numpy + Pillow).
    if ok and os.environ.get("FATIGUE_RENDER_INPROCESS", "1") != "0":
        r = FH.render(payload["node_ratio"], payload["rows"], out_path,
                      title=payload["title"], legend=payload["legend"])
        return r, None
    for py in _render_pythons():
        try:
            p = subprocess.run([py, os.path.join(HERE, "fatigue_heatmap.py")],
                               input=json.dumps(payload), text=True,
                               capture_output=True, timeout=20)
        except (OSError, subprocess.TimeoutExpired) as exc:
            why = "%s: %s" % (py, exc)
            continue
        if p.returncode == 0:
            return json.loads(p.stdout), None
        why = "%s: %s" % (py, (p.stderr or "").strip()[-200:])
    return None, why


def _render_pythons():
    out = []
    env = os.environ.get("RENDER_PYTHON")
    if env:
        out.append(env)
    venv = os.path.expanduser("~/dogany/.venvs/render/bin/python")
    if os.path.exists(venv):
        out.append(venv)
    for c in ("python3",):
        out.append(c)
    return out


