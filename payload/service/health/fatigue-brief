class Reading(object):
    """One kit muscle-state reading plus what the copy needs from it."""

    def __init__(self, db, at, prog):
        self.M = mf()
        if self.M is None:
            raise RuntimeError("kit read model (muscle_fatigue.py) not found "
                               "under %s" % kit_db_dir())
        self.db, self.at, self.prog = db, at, prog
        self.conn = ro_conn(db)
        self.st = self.M.compute_state(self.conn, at)
        self.tax = self.st["tax"]
        self.lib = self.st["lib"]
        self.items = self.M.display_items(self.st)

    def close(self):
        self.conn.close()

    def root(self, node):
        cur, seen = node, set()
        while self.tax.parent(cur) and cur not in seen:
            seen.add(cur)
            cur = self.tax.parent(cur)
        return cur

    def cause(self, item):
        parts = []
        prov = item.get("provenance") or []
        if prov and item["ratio"] >= self.M.STATE_RECOVERING:
            top = prov[0]
            when = past_when(top["at"], self.at)
            names = [e["name"] for e in top["exercises"]]
            decl = [n for n in names if n.startswith("(declared:")]
            real = [n for n in names if not n.startswith("(declared:")]
            if real:
                parts.append(T("cause_ex", when=when, exercises=joined(
                    [ex_ko(n, self.prog) for n in real[:MAX_CAUSE_EX]])))
            elif decl:
                node = decl[0][len("(declared:"):-1]
                parts.append(T("cause_declared", when=when,
                               region=self.tax.label(node)))
        for sid in item.get("signals") or []:
            sg = next((s for s in self.st["signals"] if s["id"] == sid), None)
            if sg and sg["sensation"] in SENSATION:
                parts.append(T("cause_signal",
                               when=past_when(sg["observed_at"], self.at),
                               sensation=SENSATION[sg["sensation"]][0]))
                break
        return " / ".join(parts)

    def top_items(self):
        """<= MAX_LINES display items: the most fatigued, grouped by body
        flow -- groups ordered by their most fatigued member, members by
        fatigue inside a group."""
        top = [it for it in self.items if it.get("top")]
        groups = {}
        for it in top:
            groups.setdefault(self.root(it["node"]), []).append(it)
        ordered = sorted(groups.values(),
                         key=lambda g: -max(i["ratio"] for i in g))
        out = []
        for g in ordered:
            out.extend(sorted(g, key=lambda i: -i["ratio"]))
        return out[:MAX_LINES]

    def line(self, it):
        cause = self.cause(it)
        if cause:
            return T("line", label=it["label"], pct=it["pct"], cause=cause)
        return T("line_bare", label=it["label"], pct=it["pct"])

    def all_rows(self):
        """Every muscle with anything left, body-flow order ('see all')."""
        rows = []
        shown = set()
        for it in self.items:
            rows.append((it["label"], it["pct"], it["node"]))
            shown.update(it.get("members") or [it["node"]])
        for n, r in sorted(self.st["nodes"].items(),
                           key=lambda kv: self.tax.order(kv[0])):
            if n in shown or r["pct"] < 1:
                continue
            if self.tax.kind(n) != "muscle":
                continue
            if any(s in shown for s in self.tax.subregions(n)):
                continue
            rows.append((r["label"], r["pct"], n))
        rows.sort(key=lambda x: self.tax.order(x[2]))
        return rows

    def node_ratio(self):
        return dict((n, r["ratio"]) for n, r in self.st["nodes"].items())

    def plan(self, exercises):
        targets, planned, unknown = self.M.plan_targets(
            self.conn, self.tax, self.lib, exercises=exercises)
        g = self.M.grade(self.st, targets)
        g["unknown"] = unknown
        g["planned"] = planned
        return g


