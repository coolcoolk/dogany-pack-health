def session_code(db, session_id):
    try:
        conn = ro_conn(db)
        try:
            row = conn.execute(
                "SELECT st.code FROM workouts w JOIN session_type st "
                "ON st.id = w.session_type_id WHERE w.id = ?",
                (session_id,)).fetchone()
        finally:
            conn.close()
        return row[0] if row else None
    except sqlite3.Error:
        return None


def build_open(db, prog, code, at, photo_path=None):
    rd = Reading(db, at, prog)
    try:
        top = rd.top_items()
        lines = [rd.line(it) for it in top]
        exs = prog.planned(code) if code else []
        g = rd.plan(exs) if exs else None
        level = g["level"] if g else "none"
        move = {"kind": "brief", "day": code, "level": level,
                "lines": lines, "say": None, "choices": [],
                "proposal": {"action": "none"},
                "numbers": [{"label": it["label"], "pct": it["pct"],
                             "node": it["node"], "source": "muscle-state"}
                            for it in top]}
        drivers = [d for d in (g["targets"] if g else []) if d["hit"]]
        hard = [d for d in drivers if d["ratio"] >= rd.M.LEVEL_MODERATE]
        expand = {"pick": "expand", "label": gate(COPY["c_expand"], "expand"),
                  "lines": [T("expand_head")]}
        move["expand"] = expand

        def light_move():
            sig = [d for d in drivers if d["signal_nodes"]
                   and d["ratio"] < rd.M.LEVEL_HIT]
            fat = [d for d in drivers if d not in sig]
            says = []
            if fat:
                # name the part the lines show (front delts, not "shoulders")
                labels = joined(_dedupe([d["worst_label"] or d["label"]
                                         for d in fat]))
                says.append(T("light", labels_eun=J(labels, "eun"),
                              labels_reul=J(labels, "reul")))
            for d in sig[:1]:
                node = d["signal_nodes"][0]
                sg = next(s for s in rd.st["signals"]
                          if s["node"] == node and not s["pain_gate"])
                lab = rd.tax.label(node)
                says.append(T("light_signal",
                              when=past_when(sg["observed_at"], at),
                              label=lab, label_reul=J(lab, "reul"),
                              sensation=SENSATION[sg["sensation"]][0]))
            move["say"] = " ".join(says) if says else None
            move["proposal"] = {
                "action": "prep_bump",
                "regions": [d["target"] for d in drivers],
                "nodes": sorted({d["worst_node"] or d["target"]
                                 for d in drivers}
                                | {n for d in drivers
                                   for n in d["signal_nodes"]})}
            move["level_served"] = "light"

        def swap_move():
            pkg = swap_package(rd, code, g)
            if not pkg:
                return False
            labels = joined(_labels(rd, hard or drivers))
            move["say"] = "\n".join(
                [T("moderate", day=code, labels_reul=J(labels, "reul"))]
                + [T("swap_line", orig=p["orig_display"], new=p["new_display"])
                   for p in pkg])
            move["choices"] = [choice("swap", COPY["c_swap"], True),
                               choice("keep", COPY["c_keep"])]
            move["proposal"] = {"action": "swap_package", "package": pkg}
            move["level_served"] = "moderate"
            return True

        def care_move():
            labels = joined(_dedupe([d["worst_label"] or d["label"]
                                     for d in hard or drivers])[:3])
            options = cardio_options(prog)
            first = options[0][1]
            move["say"] = T("care", labels_eun=J(labels, "eun"),
                            cardio=first)
            move["choices"] = [choice("cardio:%s" % options[0][0],
                                      T("c_cardio", cardio=options[0][1]), True)]
            move["choices"] += [choice("small", COPY["c_small"]),
                                choice("mobility", COPY["c_mobility"]),
                                choice("keep", COPY["c_keep"])]
            move["proposal"] = {"action": "lighter_care",
                                "regions": [d["target"] for d in hard or drivers],
                                "cardio_options": [key for key, _ in options],
                                "regular_day": code}
            move["level_served"] = level

        if level == "heavy":
            care_move()
        elif level == "moderate":
            if accumulated(rd, drivers):
                care_move()
            elif not swap_move():
                light_move()
        elif level == "light":
            light_move()
        else:
            if lines:
                move["say"] = T("none_today") if exs else None
            else:
                move["say"] = T("all_clear")
            move["level_served"] = "none"
        if move["choices"]:
            move["answer"] = {"verb": "fatigue-brief pick --session <id> "
                                      "--pick <pick>"}
        # live 2026-10-08 06:19: level=none / pct 0 still said the "still very
        # tired" line. The tired line is the photo's caption for a day the plan
        # actually hits fatigue -- gated on the level AND a non-zero pct.
        tired = (level != "none"
                 and any((it.get("pct") or 0) > 0 for it in top[:2]))
        if lines and tired:
            labels = joined(_dedupe([it['label'] for it in top[:2]]))
            move['lines'] = []
            move['say'] = '%s 아직 많이 지쳐 있어요.' % J(labels, 'eun')
        for s in lines + ([move["say"]] if move["say"] else []):
            gate(s, "open")
        if photo_path and lines:
            rows = [(it["label"], it["pct"], it["ratio"]) for it in top]
            res, why = render_photo(rd, rows, photo_path)
            move["photo"] = res["path"] if res else None
            move["photo_ms"] = res["ms"] if res else None
            move["photo_cpu_ms"] = res.get("cpu_ms") if res else None
            if why:
                move["photo_error"] = why
        else:
            move["photo"] = None
        return move
    finally:
        rd.close()


def print_move(mv, as_json):
    if as_json:
        print(json.dumps(mv, ensure_ascii=False, indent=1))
        return
    if mv.get("photo"):
        print("PHOTO\t%s" % mv["photo"])
    for l in mv.get("lines") or []:
        print(l)
    if mv.get("say"):
        if mv.get("lines"):
            print("")
        print(mv["say"])
    if mv.get("choices"):
        print("CHOICES\t%s" % " | ".join(c["label"] for c in mv["choices"]))
    elif mv.get("expand"):
        print("EXPAND\t%s" % mv["expand"]["label"])


def cmd_open(a):
    at = _dt(a.at) if a.at else datetime.datetime.now().replace(
        second=0, microsecond=0)
    prog = Program(a.program)
    code = a.day or (session_code(a.db, a.session) if a.session else None)
    photo = None
    if not a.no_photo:
        photo = a.photo or os.path.join(
            OUTBOX, "fatigue-%s.jpg" % (a.session or at.strftime("%Y%m%d%H%M")))
        os.makedirs(os.path.dirname(os.path.abspath(photo)), exist_ok=True)
    try:
        mv = build_open(a.db, prog, code, at, photo)
    except RuntimeError as exc:
        print("fatigue-brief: %s" % exc, file=sys.stderr)
        return EXIT_ERR
    if a.session:
        st = read_state(a.state_dir, a.session)
        st["open"] = mv
        write_json(state_path(a.state_dir, a.session), st)
    print_move(mv, a.json)
    return EXIT_OK


