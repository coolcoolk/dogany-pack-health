def cmd_pick(a):
    st = read_state(a.state_dir, a.session)
    mv = st.get("open")
    if not mv:
        print("fatigue-brief pick: no briefing for session %s (run open "
              "first)" % a.session, file=sys.stderr)
        return EXIT_REFUSED
    picks = {c["pick"] for c in mv.get("choices") or []} | {"expand"}
    if a.pick not in picks:
        print("fatigue-brief pick: %r is not one of %s"
              % (a.pick, sorted(picks)), file=sys.stderr)
        return EXIT_REFUSED
    out = {"kind": "ack", "pick": a.pick, "lines": [], "say": None,
           "choices": []}
    if a.pick == "expand":
        out["lines"] = mv["expand"]["lines"]
        out["choices"] = [c for c in mv.get("choices") or []
                          if c["pick"] != "expand"]
        out["kind"] = "expand"
    elif a.pick == "keep":
        st["decision"] = "keep"
        st.pop("swaps", None)
        out["say"] = T("ack_keep")
        out["day"] = mv["day"]
    elif a.pick.startswith("cardio:") or a.pick in ("small", "mobility"):
        # 보충 is outside program.rotation, so this session cannot advance it.
        rc = retag(a.db, a.session, "보충")
        if rc != 0:
            return EXIT_REFUSED
        st["decision"] = a.pick
        st.pop("swaps", None)
        out["regular_day_next"] = mv["day"]
        if a.pick.startswith("cardio:"):
            key = a.pick.split(":", 1)[1]
            out["activity"] = {"kind": "cardio", "method": key}
            out["say"] = T("ack_cardio", cardio_ro=J(CARDIO[key], "ro"))
        elif a.pick == "small":
            out["activity"] = {"kind": "small_muscle"}
            out["say"] = T("ack_small")
        else:
            out["activity"] = {"kind": "mobility"}
            out["say"] = T("ack_mobility")
    elif a.pick == "swap":
        st["decision"] = "swap"
        st["swaps"] = [dict(p, reverted=False)
                       for p in mv["proposal"]["package"]]
        out["say"] = T("ack_swap")
    elif a.pick.startswith("routine:"):
        alt = a.pick.split(":", 1)[1]
        rc = retag(a.db, a.session, alt)
        if rc != 0:
            return EXIT_REFUSED
        st["decision"] = a.pick
        out["say"] = T("ack_routine", alt_ro=J(alt, "ro"))
        out["day"] = alt
    write_json(state_path(a.state_dir, a.session), st)
    print_move(out, a.json)
    return EXIT_OK


def retag(db, session_id, code):
    """The routine change IS the session's day: the canonical tag write
    (session-closeout.tag_session_type), not a note beside it."""
    sc = _load("session_closeout_fb", os.path.join(HERE, "session-closeout"))
    conn = sqlite3.connect(db)
    try:
        rc, _ = sc.tag_session_type(conn, session_id, code, birth_only=False,
                                    stream=sys.stderr)
        if rc == 0:
            conn.commit()
        return rc
    finally:
        conn.close()


def _swap_for(st, exercise):
    for p in st.get("swaps") or []:
        if p["orig"] == exercise and not p.get("reverted"):
            return p
    return None


def slot_move(state_dir, session_id, exercise):
    """The exercise to enter for a planned one (exercise-enter calls this)."""
    st = read_state(state_dir, session_id)
    p = _swap_for(st, exercise)
    if not p:
        return {"kind": "slot", "exercise": exercise, "say": None,
                "choices": []}
    return {"kind": "slot", "exercise": p["new"], "planned": p["orig"],
            "say": T("slot_swapped", orig=p["orig_display"],
                     new_ro=J(p["new_display"], "ro")),
            "choices": [choice("revert", COPY["c_revert"])],
            "answer": {"verb": "fatigue-brief revert --session %s "
                               "--exercise %s" % (session_id, p["orig"])}}


def cmd_slot(a):
    out = slot_move(a.state_dir, a.session, a.exercise)
    if a.json:
        print(json.dumps(out, ensure_ascii=False, indent=1))
    else:
        print("EXERCISE\t%s" % out["exercise"])
        if out["say"]:
            print(out["say"])
            print("CHOICES\t%s" % out["choices"][0]["label"])
    return EXIT_OK


def cmd_revert(a):
    st = read_state(a.state_dir, a.session)
    p = _swap_for(st, a.exercise)
    if not p:
        print("fatigue-brief revert: %s is not swapped in session %s"
              % (a.exercise, a.session), file=sys.stderr)
        return EXIT_REFUSED
    p["reverted"] = True
    write_json(state_path(a.state_dir, a.session), st)
    print("EXERCISE\t%s" % p["orig"])
    print(T("ack_revert", orig_ro=J(p["orig_display"], "ro")))
    return EXIT_OK


