def cmd_signal(a):
    if a.sensation == "pain":
        print("ROUTE\tpain-triage")
        return EXIT_ROUTED
    args = ["body-signal-add", "--site", a.site, "--sensation", a.sensation]
    if a.side:
        args += ["--side", a.side]
    if a.exercise:
        args += ["--exercise", a.exercise]
    rc, out, err = kit(args)
    if rc != 0:
        sys.stderr.write(err)
        return EXIT_REFUSED
    M = mf()
    label = a.site
    if M is not None and os.path.exists(a.db):
        conn = ro_conn(a.db)
        try:
            label = M.Taxonomy(conn).label(a.site)
        finally:
            conn.close()
    if label == a.site:
        label = UL.site_ko(a.site)
    sens = SENSATION[a.sensation][1]
    if "SITE_NOT_A_MUSCLE" in out:
        print(T("signal_free", label=label, sensation=sens))
    else:
        print(T("signal_ok", label=label, sensation=sens,
                label_reul=J(label, "reul")))
    return EXIT_OK


# ---------------------------------------------------------------------------
def main(argv=None):
    p = argparse.ArgumentParser(prog="fatigue-brief")
    sub = p.add_subparsers(dest="cmd", required=True)

    def common(sp):
        sp.add_argument("--db", default=DEFAULT_DB)
        sp.add_argument("--program", default=DEFAULT_PROGRAM)
        sp.add_argument("--state-dir", dest="state_dir", default=STATE_DIR)
        sp.add_argument("--json", action="store_true")

    o = sub.add_parser("open")
    common(o)
    o.add_argument("--session", type=int)
    o.add_argument("--day")
    o.add_argument("--at")
    o.add_argument("--photo")
    o.add_argument("--no-photo", dest="no_photo", action="store_true")
    k = sub.add_parser("pick")
    common(k)
    k.add_argument("--session", type=int, required=True)
    k.add_argument("--pick", required=True)
    s = sub.add_parser("slot")
    common(s)
    s.add_argument("--session", type=int, required=True)
    s.add_argument("--exercise", required=True)
    r = sub.add_parser("revert")
    common(r)
    r.add_argument("--session", type=int, required=True)
    r.add_argument("--exercise", required=True)
    c = sub.add_parser("close")
    common(c)
    c.add_argument("--session", type=int, required=True)
    c.add_argument("--at")
    t = sub.add_parser("retro")
    common(t)
    t.add_argument("--lane", choices=("daily", "weekly"), required=True)
    t.add_argument("--mode", choices=("line", "section"), default="section")
    t.add_argument("--week")
    t.add_argument("--today")
    t.add_argument("--facts-only", action="store_true",
                   help="emit facts without proposals or offer-history writes")
    g = sub.add_parser("signal")
    common(g)
    g.add_argument("--site", required=True)
    g.add_argument("--sensation", required=True,
                   choices=("stiff", "tight", "sore", "pain"))
    g.add_argument("--side", choices=("L", "R", "both"))
    g.add_argument("--exercise")
    a = p.parse_args(argv)
    if a.cmd == "open" and not (a.session or a.day):
        p.error("open needs --session or --day")
    return {"open": cmd_open, "pick": cmd_pick, "slot": cmd_slot,
            "revert": cmd_revert, "close": cmd_close, "retro": cmd_retro,
            "signal": cmd_signal}[a.cmd](a)


if __name__ == "__main__":
    sys.exit(main())
