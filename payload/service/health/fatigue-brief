DRAFTS_ASKED = ".fatigue-drafts-asked.json"


def _session_of(M, conn, tax, lib, session_id):
    row = conn.execute("SELECT date FROM workouts WHERE id=?",
                       (session_id,)).fetchone()
    if not row:
        return None
    d = datetime.datetime.strptime(row[0], "%Y-%m-%d")
    for s in M.load_sessions(conn, tax, lib, d - datetime.timedelta(days=1),
                             d + datetime.timedelta(days=2)):
        if s.workout_id == session_id:
            return s
    return None


def _close_facts(db, session_id, at):
    """The session-end facts both close surfaces phrase: (declared, top
    labels most-used first, slowest (label, when) or None, since), or None
    when the kit read model / the session is missing."""
    M = mf()
    if M is None:
        return None
    conn = ro_conn(db)
    try:
        tax = M.Taxonomy(conn)
        lib = M.Library(conn, tax)
        sess = _session_of(M, conn, tax, lib, session_id)
        if sess is None:
            return None
        per = {}
        for leaf, ld in sess.load.items():
            m = tax.muscle_of(leaf) or leaf
            if tax.nodes and tax.kind(m) != "muscle":
                continue
            per[m] = per.get(m, 0.0) + ld
        trained = sorted(((ld / tax.dose(m), m) for m, ld in per.items()
                          if ld >= M.PLAN_TARGET_SHARE * tax.dose(m)),
                         reverse=True)
        st = M.compute_state(conn, max(at, sess.t))
        slow = None
        for _, m in trained:
            r = st["nodes"].get(m)
            if r and r["eta"] and (slow is None or r["eta"] > slow[1]["eta"]):
                slow = (m, r)
        since = conn.execute(
            "SELECT MIN(recorded_at) FROM workout_sets WHERE session_id=?",
            (session_id,)).fetchone()[0]
        if not since:
            since = conn.execute("SELECT created_at FROM workouts WHERE id=?",
                                 (session_id,)).fetchone()[0]
        return {"declared": sess.lane == "declared",
                "top": [tax.label(m) for _, m in trained],
                "slow": ((slow[1]["label"], future_when(slow[1]["eta"], at))
                         if slow else None),
                "since": since}
    finally:
        conn.close()


def build_close(db, prog, session_id, at, state_dir, drafts=True):
    """(lines, extra) -- 2 lines, no question; `extra` = the one-time draft
    confirmation (or [])."""
    f = _close_facts(db, session_id, at)
    if f is None:
        return [], []
    lines = []
    if f["declared"]:
        lines.append(T("close_declared"))
    elif f["top"]:
        labels = joined(f["top"][:2])
        lines.append(T("close_top", labels_reul=J(labels, "reul")))
    if f["slow"]:
        lab, when = f["slow"]
        lines.append(T("close_eta", label_eun=J(lab, "eun"), when=when))
    since = f["since"]
    extra = draft_confirm(prog, since, state_dir) if drafts and since else []
    for s in lines + extra:
        gate(s, "close")
    return lines, extra


def build_close_line(db, prog, session_id, at, state_dir, drafts=True):
    """(line, extra) -- the closeout CARD's last line (owner 2026-10-02: the
    fatigue tail folded into the card, one line) + the same one-time draft
    confirmation build_close returns. Slowest recovery first; else the most
    used regions; else the declared-session note. '' when nothing to say."""
    f = _close_facts(db, session_id, at)
    if f is None:
        return "", []
    if f["slow"]:
        line = T("close_slow_line", label=f["slow"][0], when=f["slow"][1])
    elif f["top"] and not f["declared"]:
        line = T("close_top_line", labels=joined(f["top"][:2]))
    elif f["declared"]:
        line = T("close_declared")
    else:
        line = ""
    since = f["since"]
    extra = draft_confirm(prog, since, state_dir) if drafts and since else []
    for s in extra:
        gate(s, "close")
    return line, extra


def draft_confirm(prog, since, state_dir):
    """Exercises created mid-session with a drafted map: ONE confirmation,
    once (spec G / A5). Drafts already asked at an earlier close are
    promoted silently (silence = kept) and never asked again."""
    asked_path = os.path.join(state_dir, DRAFTS_ASKED)
    try:
        with open(asked_path, encoding="utf-8") as fh:
            asked = json.load(fh)
    except (OSError, ValueError):
        asked = {}
    rc, out, _ = kit(["exercise-drafts", "--json"])
    if rc != 0:
        return []
    try:
        drafts = json.loads(out)
    except ValueError:
        return []
    # silence promotion for drafts asked at an earlier close
    for d in drafts:
        if d["name"] in asked and d["name"] not in _just(since, drafts):
            kit(["exercise-confirm", "--name", d["name"]])
    fresh = [d for d in drafts if d["name"] in _just(since, drafts)
             and d["name"] not in asked]
    if not fresh:
        return []
    now = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
    for d in fresh:
        asked[d["name"]] = now
    write_json(asked_path, asked)
    cost = {"high": COPY["cost_high"], "med": COPY["cost_med"],
            "low": COPY["cost_low"]}

    def musc(d):
        prim = [m["label"] for m in d["muscles"] if m["role"] == "primary"]
        return joined(prim or [m["label"] for m in d["muscles"]])
    if len(fresh) == 1:
        d = fresh[0]
        name = ex_ko(d["name"], prog)
        return [T("draft_one", ex_eun=J(name, "eun"),
                  muscles_reul=J(musc(d), "reul"),
                  cost=cost.get(d["cost"], COPY["cost_med"]))]
    return [T("draft_many")] + [
        T("draft_line", ex=ex_ko(d["name"], prog), muscles=musc(d),
          cost=cost.get(d["cost"], COPY["cost_med"])) for d in fresh]


def _just(since, drafts):
    """names created at/after the session start (created_at is UTC 'Z')."""
    M = mf()
    try:
        z = M._local_to_z(since)
    except Exception:  # noqa: BLE001 -- an unreadable start: none are 'new'
        return set()
    return {d["name"] for d in drafts if (d.get("created_at") or "") >= z}


def close_tail(db, session_id, program=None, state_dir=None, at=None):
    """For session-closeout: the text to append after its card, or ''.
    Never raises (a close-out must not fail on a render)."""
    try:
        if mf() is None:
            return ""
        lines, extra = build_close(
            db, Program(program or DEFAULT_PROGRAM), session_id,
            at or datetime.datetime.now().replace(second=0, microsecond=0),
            state_dir or STATE_DIR)
        return "\n".join(lines + extra)
    except Exception as exc:  # noqa: BLE001
        print("fatigue-brief close_tail: %s" % exc, file=sys.stderr)
        return ""


def close_card_line(db, session_id, program=None, state_dir=None, at=None):
    """For session-closeout's card: (line, extra_lines). Never raises."""
    try:
        if mf() is None:
            return "", []
        return build_close_line(
            db, Program(program or DEFAULT_PROGRAM), session_id,
            at or datetime.datetime.now().replace(second=0, microsecond=0),
            state_dir or STATE_DIR)
    except Exception as exc:  # noqa: BLE001
        print("fatigue-brief close_card_line: %s" % exc, file=sys.stderr)
        return "", []


def cmd_close(a):
    at = _dt(a.at) if a.at else datetime.datetime.now().replace(
        second=0, microsecond=0)
    if mf() is None:
        print("fatigue-brief: kit read model not found", file=sys.stderr)
        return EXIT_ERR
    lines, extra = build_close(a.db, Program(a.program), a.session, at,
                               a.state_dir)
    if a.json:
        print(json.dumps({"kind": "close", "lines": lines, "confirm": extra},
                         ensure_ascii=False, indent=1))
