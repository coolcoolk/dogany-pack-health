# proposals
# ---------------------------------------------------------------------------
def _driver_load(rd, ex, drivers):
    """planned-set load `ex` puts on the driver regions (credit x cost)."""
    cw = rd.M.COST_W.get(rd.lib.cost_of(ex)[0], 1.0)
    tot = 0.0
    for node, w in rd.lib.credit(ex).items():
        m = rd.tax.muscle_of(node) or node
        if m in drivers:
            tot += w * cw
    return tot


def swap_package(rd, code, grade):
    """ONE package: each planned exercise that loads a hard region gets the
    same-pattern substitute that loads it least (08-24 rule: substitutes
    come from the same movement pattern; nothing is applied until the user
    confirms the package, 11:29). Candidates: mapped, not already in today's
    plan, and known to this user (in their program or registered)."""
    drivers = {d["target"] for d in grade["targets"]
               if d["ratio"] >= rd.M.LEVEL_MODERATE}
    planned = [n for n, _ in rd.prog.planned(code)]
    known = rd.prog.names() | set(rd.lib.ax)
    used, pkg = set(planned), []
    for ex in planned:
        if not rd.lib.mapped(ex):
            continue
        base = _driver_load(rd, ex, drivers)
        if base < 0.5:
            continue
        pat = rd.lib.pattern.get(ex)
        if not pat or pat == "isolation":
            continue
        best = None
        for cand in sorted(rd.lib.names()):
            if cand in used or cand not in known:
                continue
            if rd.lib.pattern.get(cand) != pat or not rd.lib.mapped(cand):
                continue
            load = _driver_load(rd, cand, drivers)
            if load >= base:
                continue
            key = (load, cand not in rd.prog.names(), cand)
            if best is None or key < best[0]:
                best = (key, cand)
        if best:
            used.add(best[1])
            pkg.append({"orig": ex, "new": best[1],
                        "orig_display": ex_ko(ex, rd.prog),
                        "new_display": ex_ko(best[1], rd.prog)})
    return pkg


def routine_alt(rd, code, grade):
    """The rotation day that overlaps least with what is still loaded: the
    lowest level, then the lowest peak. Only a day graded strictly below
    today's level is offered (a routine change must actually route around
    the load); None -> no routine proposal."""
    best = None
    for alt in rd.prog.rotation:
        if alt == code:
            continue
        exs = rd.prog.planned(alt)
        if not exs:
            continue
        g = rd.plan(exs)
        key = (LEVEL_RANK[g["level"]], g["max_ratio"], alt)
        if best is None or key < best[0]:
            best = (key, alt, g)
    if best is None or \
            LEVEL_RANK[best[2]["level"]] >= LEVEL_RANK[grade["level"]]:
        return None
    return best[1], best[2]


def _labels(rd, drivers):
    return [d["label"] for d in drivers]


def _dedupe(seq):
    out = []
    for x in seq:
        if x not in out:
            out.append(x)
    return out


from movement_catalog import CARDIO_CATALOG
CARDIO = {key: item['ko'] for key, item in CARDIO_CATALOG.items()}


def cardio_options(prog):
    pref = prog.cardio_preference
    if isinstance(pref, dict):
        pref = pref.get("pick")
    if isinstance(pref, str):
        for key, label in CARDIO.items():
            if pref in (key, label, "stairs" if key == "stepmill" else ""):
                return [(key, label)]
    return list(CARDIO.items())


def accumulated(rd, drivers):
    """Two preceding training days both contributed to loaded planned areas."""
    targets = {d["target"] for d in drivers
               if d["ratio"] >= rd.M.LEVEL_MODERATE}
    days = set()
    for s in rd.st["sessions"]:
        if any((rd.tax.muscle_of(n) or n) in targets for n in s.load):
            days.add(s.t.date())
    today = rd.at.date()
    return all(today - datetime.timedelta(days=i) in days for i in (1, 2))


