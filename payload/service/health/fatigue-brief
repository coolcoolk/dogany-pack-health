class Program(object):
    def __init__(self, path):
        self.path = path
        self.data = {}
        if path and os.path.exists(path):
            rx = _load("rx_calc_fatigue", os.path.join(HERE, "rx-calc"))
            self.data = rx.load_yaml(path) or {}
        self.days = self.data.get("days") or {}
        self.rotation = [c for c in (self.data.get("rotation") or [])
                         if c in self.days]
        # Optional owner setting in program.yaml; absent on older installs.
        self.cardio_preference = self.data.get("cardio_preference")
        self.display = {}
        for code, day in self.days.items():
            for ex in (day or {}).get("exercises") or []:
                if ex.get("name") and ex.get("display"):
                    self.display.setdefault(ex["name"], ex["display"])

    def planned(self, code):
        out = []
        for ex in ((self.days.get(code) or {}).get("exercises") or []):
            if not ex.get("name"):
                continue
            try:
                n = float(ex.get("sets") or PLAN_DEFAULT_SETS)
            except (TypeError, ValueError):
                n = float(PLAN_DEFAULT_SETS)
            out.append((ex["name"], n))
        return out

    def names(self):
        return set(self.display) | {n for c in self.days
                                     for n, _ in self.planned(c)}


def ex_ko(name, prog=None):
    if prog is not None and name in prog.display:
        return prog.display[name]
    return EX_KO.get(name) or COPY["generic_ex"]


# ---------------------------------------------------------------------------
# time words
# ---------------------------------------------------------------------------
def _dt(s):
    return datetime.datetime.strptime(s[:16], "%Y-%m-%d %H:%M")


def tod_word(t):
    h = t.hour
    if h < 6:
        return WHEN["dawn"]
    if h < 11:
        return WHEN["morning"]
    if h < 17:
        return WHEN["noon"]
    if h < 21:
        return WHEN["evening"]
    return WHEN["night"]


def day_word(t, now, future=False):
    dd = (t.date() - now.date()).days
    if dd == 0:
        return WHEN["today"]
    if not future:
        if dd == -1:
            return WHEN["yesterday"]
        if dd == -2:
            return WHEN["day_before"]
        if -6 <= dd < -2:
            return WHEN["weekday"].format(wd=WHEN["weekdays"][t.weekday()])
    else:
        if dd == 1:
            return WHEN["tomorrow"]
        if dd == 2:
            return WHEN["day_after"]
        if 2 < dd <= 6:
            return WHEN["weekday"].format(wd=WHEN["weekdays"][t.weekday()])
    return WHEN["date"].format(m=t.month, d=t.day)


def past_when(ts, now):
    t = _dt(ts)
    w = day_word(t, now)
    if w in (WHEN["today"], WHEN["yesterday"]):
        return "%s %s" % (w, tod_word(t))
    return w


def future_when(ts, now):
    t = _dt(ts)
    return "%s %s" % (day_word(t, now, future=True), tod_word(t))


