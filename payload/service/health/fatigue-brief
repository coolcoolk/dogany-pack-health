# Internal vocabulary that must never reach the user, and the words that
# would propose skipping a session (the level table has no such move; the
# copy cannot grow one either). Checked on every template at import and on
# every rendered line at runtime.
INTERNAL_TERMS = (
    "fatigue", "residual", "dose", "ratio", "node", "draft", "level",
    "light", "moderate", "heavy", "swap", "package", "coverage",
    "provenance", "muscle", "state", "eta", "declared", "program.yaml",
    "rotation", "slot", "tag", "map", "kit", "prep",
    # Korean: fatigue-score, residual, node, muscle-map, tag, draft, slot,
    # rotation, card
    "\ud53c\ub85c\ub3c4", "\uc794\uc5ec", "\ub178\ub4dc",
    "\uadfc\uc721\ub9f5", "\ud0dc\uadf8", "\ucd08\uc548", "\uc2ac\ub86f",
    "\ub85c\ud14c\uc774\uc158", "\uce74\ub4dc",
)
# rest, rest (noun), skip (x2), skip (loanword), omit, leave out, postpone,
# "do it next time", "not today"
SKIP_TERMS = ("\uc26c", "\ud734\uc2dd", "\uac74\ub108\ub6f0", "\uac74\ub108 \ub6f0",
              "\uc2a4\ud0b5", "\uc0dd\ub7b5", "\ube7c\uace0", "\ubbf8\ub8e8",
              "\ub2e4\uc74c\uc5d0 \ud558", "\uc624\ub298\uc740 \uc548")
_SNAKE = re.compile(r"[a-z]+_[a-z0-9_]+")


class CopyLeak(Exception):
    pass


def gate(text, where):
    if "--" in text or any(ch in text for ch in ("👋", "👊", "✋", "👉", "👍")):
        raise CopyLeak("punctuation or hand emoji in user copy (%s): %s" % (where, text))
    low = text.lower()
    for t in INTERNAL_TERMS:
        if t in low:
            raise CopyLeak("internal term %r in user copy (%s): %s"
                           % (t, where, text))
    for t in SKIP_TERMS:
        if t in text:
            raise CopyLeak("skip/rest wording %r in user copy (%s): %s"
                           % (t, where, text))
    if _SNAKE.search(text):
        raise CopyLeak("machine token in user copy (%s): %s" % (where, text))
    return text


_FIELD = re.compile(r"\{[^}]*\}")
for _k, _v in list(COPY.items()) + [("ex:" + k, v) for k, v in EX_KO.items()]:
    gate(_FIELD.sub("", _v), "copy[%s]" % _k)
for _k, _v in FUNCTIONAL.items():
    gate(_v["name"], "functional[%s]" % _k)
    gate(_v["add"], "functional[%s]" % _k)


def T(key, **kw):
    return gate(COPY[key].format(**kw), key)


def _josa_pair(kind):
    return {"i": ("\uc774", "\uac00"), "eun": ("\uc740", "\ub294"),
            "reul": ("\uc744", "\ub97c"), "wa": ("\uacfc", "\uc640")}[kind]


def J(word, kind):
    """word + the agreeing particle (i / eun / reul / wa / ro)."""
    if kind == "irang":
        return word + ("\uc774\ub791" if UL._has_final(word) else "\ub791")
    if kind == "ro":
        # (eu)ro: a final consonant other than rieul takes the 'eu' form
        w = (word or "").strip()
        ch = w[-1] if w else ""
        fin = 0
        if "\uac00" <= ch <= "\ud7a3":
            fin = (ord(ch) - 0xAC00) % 28
        elif UL._has_final(w):
            fin = 1
        return word + ("\uc73c\ub85c" if fin not in (0, 8) else "\ub85c")
    a, b = _josa_pair(kind)
    return UL.josa(word, a, b)


def joined(labels):
    return "\u00b7".join(labels)


