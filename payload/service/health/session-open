def install_gaps(db_path, program_path):
    """(taxonomy report, [gap, ...]) -- every unmet post-install step we can see.

    Best-effort and read-only: a probe that cannot run returns no gap rather
    than inventing one, because a false 'your install is broken' at session
    birth is its own defect."""
    gaps = []
    try:
        tax_report = TX.taxonomy_probe(db_path)
    except Exception:  # noqa: BLE001 -- never break the open over a diagnostic
        tax_report = {"verdict": TX.UNKNOWN, "empty": [], "tables": {}}
    if tax_report.get("verdict") in TX.BAD_VERDICTS:
        gaps.append({
            "what": "pack_health taxonomy seed has not run on this DB "
                    "(ax_projection_rule and 10 sibling tables)",
            "why_it_matters":
                "every weight is served UNROUNDED and the empty-bar ramp is "
                "dropped; ax-project now refuses with exit 3 instead",
            "fix": TX.taxonomy_seed_command(tax_report),
        })
    # session_type: the rotation-day registry the BIRTH TAG writes into. Empty
    # on every fresh kit_life mint. Until 2026-09-14 NOTHING filled it -- the
    # kit ships no verb, the rows carry a routine_id FK, and the codes are the
    # OWNER's (program.yaml `rotation:`), not product knowledge the pack could
    # seed -- so the visible symptom was this script's own `tag=failed` plus
    # one line naming a code against an empty valid-list, which explains
    # nothing on its own. It now HAS a writer: service/health/program-init
    # derives the rows from the same `rotation:` list it writes into the card,
    # in the same call. This probe stays, unchanged in its trigger, because the
    # registry can still be empty for reasons the writer cannot see -- the card
    # was hand-authored, the DB was replaced underneath, a sync failed. What
    # changed is the `fix` line below: it now names a command instead of
    # reporting a gap.
    # TWO conditions, not one. "count == 0" was the whole probe while nothing
    # could fill the table; now that a writer exists, the interesting failure
    # is no longer an EMPTY registry but a STALE one -- the card gained a
    # rotation day and the sync was never re-run, so that one day tags as
    # failed while its siblings tag fine. That is quieter than an empty table
    # and it is the shape this probe has to keep catching.
    _missing = []
    try:
        import sqlite3 as _sq3
        _c = _sq3.connect("file:%s?mode=ro" % os.path.abspath(db_path), uri=True)
        try:
            _n = _c.execute("SELECT COUNT(*) FROM session_type;").fetchone()[0]
            if _n:
                _have = set(r[0] for r in _c.execute(
                    "SELECT code FROM session_type;").fetchall())
                _prog = _load_module("rx_calc", "rx-calc").load_yaml(
                    program_path) or {}
                for _code in list(_prog.get("rotation") or []):
                    if _code not in _have:
                        _missing.append(_code)
        finally:
            _c.close()
    except Exception:  # noqa: BLE001 -- a diagnostic must not break the open
        _n = None
    if _missing:
        gaps.append({
            "what": "session_type does not carry every rotation day the card "
                    "declares -- missing: %s" % ", ".join(_missing),
            "why_it_matters":
                "those days tag=failed at session birth while the rest tag "
                "fine, so the wrap-up card labels exactly those sessions by "
                "muscle instead of by rotation code and rx-calc reads them as "
                "untagged. The card and the registry have drifted",
            "fix": "service/health/program-init sync -- re-derives the "
                   "registry from the card's own `rotation:` list. Idempotent; "
                   "existing rows keep their id and everything joined to them.",
        })
    if _n == 0:
        gaps.append({
            "what": "session_type holds no rotation days (the birth tag has "
                    "nothing to point at -- this is why tag=failed)",
            "why_it_matters":
                "workouts.session_type_id stays NULL, so the wrap-up card "
                "labels the session by muscle instead of by rotation code and "
                "rx-calc reads the latest session as untagged",
            "fix": "service/health/program-init sync -- derives one "
                   "session_type row per code in program.yaml `rotation:` "
                   "(plus the makeup class at sort 99), reconcile-first and "
                   "idempotent. Do NOT invent codes: they are the owner's and "
                   "program.yaml is where they are declared, which is exactly "
                   "why the derivation reads them from there. If the card "
                   "itself is absent, `program-init next` builds it with him "
                   "and the last answer runs this sync automatically.",
        })

    data_dir = os.path.dirname(os.path.abspath(program_path))
    sot_dir = os.path.join(HERE, "sot")
    for name, template, why, fix in SOT_SEEDS:
        if os.path.exists(os.path.join(data_dir, name)):
            continue
        if not os.path.exists(os.path.join(sot_dir, template)):
            # The pack does not ship the template on this tree -- then this is
            # not a post-install step, and claiming one would be a false alarm.
            continue
        gaps.append({
            "what": "files/program/%s is absent (the pack ships only the "
                    "template, sot/%s -- no lane installs it)" % (name, template),
            "why_it_matters": why,
            "fix": fix,
        })
    return tax_report, gaps


def reconcile_us_steps(db_path, program_path):
    """G17: re-derive the us_step rows `ax-project serve` resolves from the
    card on disk, at every birth. program-init writes them with the card; this
    catches a card edited by hand (or a DB swapped underneath) before the first
    working weight is realized, so serve can never answer from a stale slot.
    Idempotent (an unchanged card writes nothing). Best-effort: returns a
    status token for the OPENED line and never fails the open.
      ok            rows already matched the card
      synced:N      N slot rows written or removed
      unresolved:N  N slots have no catalog row yet (machine/cable, JIT)
      collision     another agent owns rows under this day code
      failed        the derivation could not run"""
    try:
        pi = _load_module("program_init", "program-init")
        rx = _load_module("rx_calc", "rx-calc")
        program = rx.load_yaml(program_path) or {}
        rep = pi.sync_us_steps(db_path, program)
    except Exception as e:  # noqa: BLE001 -- never break the open
        print("WARN us_step reconcile failed: %s" % e, file=sys.stderr)
        return "failed"
    if rep.get("error"):
        print("WARN us_step reconcile failed: %s" % rep["error"],
              file=sys.stderr)
        return "failed"
    if rep.get("collisions"):
        return "collision"
    n = len(rep.get("changed") or []) + len(rep.get("removed") or [])
    tok = "synced:%d" % n if n else "ok"
    if rep.get("unresolved"):
        tok += ",unresolved:%d" % len(rep["unresolved"])
    return tok


def do_open(db_path, program_path, marker_path, kit_life_sh, date, subtype,
            minutes, kcal, note, dry_run, tombstone_path=DEFAULT_TOMBSTONE,
            start_over=False):
    # 1. SAME-DAY 2ND-SESSION detection FIRST (read-only, no write). If today
    #    ALREADY has a CLOSED strength row, a plain reconcile would reuse it
    #    (wrong day, closed-but-active contradiction) -> switch to force-new.
    #    We NEVER hard-block -- surface an overtraining note and proceed.
    #    G1: this probe moved AHEAD of the rotation verdict because the verdict
    #    needs to know which of today's rows is the session being (re)opened.
    force_new = False
    overtrain_note = None
    existing_ids = probe_existing_strength_ids(db_path, date)
    from free_session import is_free
    # A planned open must never reconcile into an off-plan birth.
    force_new = any(is_free(db_path, sid) for sid in existing_ids)
    closed_today = [sid for sid in existing_ids
                    if _row_is_closed(db_path, sid, tombstone_path,
                                      marker_path)]
    open_today = [sid for sid in existing_ids if sid not in closed_today]
    if closed_today:
        force_new = True
        # Korean user-facing: an overtraining consideration surfaced, not a block.
        overtrain_note = ("오늘 이미 완료한 세션이 있어요 (2세션째). "
                          "과훈련 주의 -- 그대로 진행합니다.")
    # A reopen of the LIVE session (marker names an open row of today) is a
    # continuation, reported as such. `--new` is the explicit "start over".
    live_today = [sid for sid in open_today
                  if _marker_names(marker_path, sid)]
    if start_over and open_today:
        force_new = True
    resumed = bool(live_today) and not force_new

    # 2. Resolve the AUTHORITATIVE rotation verdict (read-only). We need it to
    #    pick the birth subtype default (rotation code) and to know the tag.
    #    A CLOSED same-day session is NEVER excluded: it IS the correct rotation
    #    basis (앞B closed -> next 뒷B), and excluding it would re-serve the
    #    SAME day.
    #    G1: an OPEN same-day row is a different animal -- it is the very
    #    session this open call is about to reconcile into, so it must not be
    #    its own basis. Left in, its birth tag made the calc advance one slot
    #    past the day the owner was about to train (open 뒷B -> served 앞A) and
    #    made the weekly tally count the session as already done. Newest open
    #    row wins (probe returns id DESC).
    reopen_id = open_today[0] if open_today and not force_new else None
    verdict, err = rotation_verdict(program_path, db_path, date,
                                    exclude_session_id=reopen_id)
    if verdict is None:
        # rx-calc unusable is a hard error only for the TAG; we can still create
        # the row + marker untagged (closeout will tag). Degrade, do not abort.
        print("WARN rotation verdict unavailable (%s) -- opening untagged"
              % err, file=sys.stderr)
        verdict = {"session_class": "regular", "rotation_day": None,
                   "provisional": True, "rotation_type_id": None,
                   "makeup_type_id": None}

    # Birth subtype default: the rotation code (self-describing at birth). For a
    # makeup session, 보충. Muscle classifications are refined at workout-log.
    if not subtype:
        if verdict["session_class"] == "makeup":
            subtype = MAKEUP_CODE
        else:
            subtype = verdict["rotation_day"] or STRENGTH_CATEGORY

    if dry_run:
        print("DRYRUN session_class=%s rotation_day=%s provisional=%s "
              "subtype=%s date=%s force_new=%s closed_today=%s reopen_id=%s"
              % (verdict["session_class"], verdict["rotation_day"],
                 verdict["provisional"], subtype, date,
                 "yes" if force_new else "no",
                 ",".join(str(s) for s in closed_today) or "none",
                 reopen_id if reopen_id is not None else "none"))
        if overtrain_note:
            print("NOTE %s" % overtrain_note)
        return 0

    # 3. Row BIRTH (critical path) -- via workout-add (framework, DGN-231).
    #    force_new bypasses the reconcile so a same-day 2nd session gets a fresh
    #    row instead of reviving the closed one.
    session_id, created, err = open_workout_row(
        kit_life_sh, date, subtype, minutes, kcal, note, force_new=force_new)
    if session_id is None:
        print("ERROR %s" % err, file=sys.stderr)
        return 1

    # Freeze before activation so a failed snapshot can be retried. An already
    # live session without a snapshot predates this decision; do not replan it.
    from session_day_trim import prepare
    try:
        session_program = prepare(
            program_path, db_path, session_id, date, verdict,
            _load_module('trim_rx', 'rx-calc'),
            allow_new=not (resumed and created == 'existing'))
    except (OSError, ValueError, KeyError, TypeError) as exc:
        print('ERROR session day trim failed: %s' % exc, file=sys.stderr)
        return 1

    # 4. Birth tag (best-effort, birth_only, provisional-skip). A forced-new row
    #    is untagged, so the birth tag applies cleanly to the NEXT rotation day.
    tag_result = apply_birth_tag(db_path, session_id, verdict)

    # 5. Active marker (best-effort, stale takeover). The closed-id guard in
    #    set_marker clears a stale tombstone that matches the new active id, so
    #    .active-session can never point at a closed session.
    marker_result = set_marker(marker_path, session_id, tombstone_path)

    # 5b. BIRTH-SIDE PENDING SWEEP (D1, 2026-08-25). A brand-new session cannot
    #     legitimately owe an answer to a menu that was offered before it
    #     existed, so any .reply-pending / .tip-pending found at open is by
    #     definition garbage from a prior session and is dropped here.
    #
    #     This is the THIRD independent guard on the marker that deadlocked
    #     session 10092's fast path for all 31 of its typed sets, and the three
    #     are deliberately independent so no single failure can reproduce it:
    #       birth   (here)              -- start every session with a clean slate
    #       in-flight (session-fastpath) -- consume-on-read + sid match + TTL
    #       death   (session-closeout)   -- sweep every marker the session owns
    #     The 10092 deadlock needed only ONE of these to exist. Cheap, and the
    #     cost of being wrong is one model turn.
    # A RESUMED live session can owe an answer to a menu it offered itself;
    # the sweep is for a new session only.
    is_resume = resumed and created == "existing"
    pending_result = ("kept_resumed" if is_resume
                      else clear_pending_markers(session_id))

    # 5c. us_step reconcile (G17): the rows serve resolves follow the card.
    us_result = reconcile_us_steps(db_path, program_path)

    # 6. SESSION-START 표3 pin (SPEC section 2). Reaches here only on a REAL open
    #    (dry-run returned above; a hard row error returned above), so a bad pin
    #    can never be written on a dry-run/hold/error path. Best-effort: the pin
    #    is layered on top of the row+tag+marker and never fails the open.
    start_card_lines = []
    pin_result = write_start_pin(session_program, verdict, db_path=db_path,
                                 session_id=session_id,
                                 card_out=start_card_lines)

    # 7. SESSION-START chat card (owner 2026-09-11 표-평문-버튼): the SAME
    #    render the pin got, pushed into the chat flow NOW -- i.e. before the
    #    model's C6 question/buttons can exist. See deliver_start_card.
    card_result = deliver_start_card(start_card_lines, session_id)

    # 8. INSTALL COMPLETENESS (read-only, best-effort). See the header block.
    tax_report, gaps = install_gaps(db_path, program_path)
    tax_verdict = tax_report["verdict"]

    print("OPENED session_id=%d created=%s session_class=%s rotation_day=%s "
          "tag=%s marker=%s force_new=%s start_pin=%s start_card=%s pending=%s "
          "taxonomy=%s install=%s us_step=%s resumed=%s"
          % (session_id, created, verdict["session_class"],
             verdict["rotation_day"] or "NONE", tag_result, marker_result,
             "yes" if force_new else "no", pin_result, card_result,
             pending_result, tax_verdict,
             "complete" if not gaps else "incomplete:%d" % len(gaps),
             us_result, "yes" if is_resume else "no"))
    if gaps:
        print("INSTALL-GAP %d unmet post-install step(s). This install is "
              "INCOMPLETE -- do NOT improvise the missing content to cover it. "
              "Tell the owner the install needs finishing, in one plain "
              "sentence, and work through the items below with them."
              % len(gaps))
        for g in gaps:
            print("  - %s" % g["what"])
            print("    %s" % g["why_it_matters"])
            print("    fix: %s" % g["fix"])
        if tax_verdict in TX.BAD_VERDICTS:
            print(TX.taxonomy_diagnostic(tax_report, "session birth"))
        # One line on the OTHER channel too: session-ensure.sh / cron-guard read
        # stderr, and they parse stdout for session_id only, so a stdout-only
        # announcement would be invisible on the headless path.
        print("[session-open] install incomplete: %s"
              % "; ".join(g["what"] for g in gaps), file=sys.stderr)
    if is_resume:
        print("RESUMED session_id=%d -- today's session was already live (the "
              "active marker named it); this open re-attached to it and "
              "created nothing. Continue from the live cursor; do not restart "
              "the prep or re-announce the lineup. If the owner really wants "
              "to start over, `session-open --new` opens a fresh row."
              % session_id)
    care = care_lines(program_path) if not is_resume else None
    if care:
        print("CARE %d line(s) -- what this owner's plan carries beyond the "
              "lifts at EVERY session. Say them verbatim in this turn's "
              "prose (below the lineup card, above the [[OPTIONS]] marker); "
              "run the prep before the first lift, the cooldown after the "
              "last, the breathing cue on every heavy set:" % (len(care) - 1))
        for ln in care:
            print("  %s" % ln)
    if card_result in ("sent", "duplicate"):
        print("START_CARD delivered=yes -- today's lineup table is already on "
              "the owner's screen, ABOVE this turn's reply. Do NOT re-render "
              "the lineup in chat; put any prose below it and the [[OPTIONS]] "
              "marker last (표-평문-버튼).")
    if overtrain_note:
        print("NOTE %s" % overtrain_note)
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(
        prog="session-open",
        description="Deterministic session BIRTH primitive (row + birth tag + "
                    "active marker). Symmetric partner of session-closeout.",
    )
    p.add_argument("--free", action="store_true", help="open an off-plan session")
    p.add_argument("--regions", help="comma-separated regions for proposals")
    p.add_argument("--exercises", help="comma-separated catalog exercise names")
    p.add_argument("--venue", choices=("gym", "home", "other"))
    p.add_argument("--date", default=None,
                   help="session date YYYY-MM-DD (default: today KST)")
    p.add_argument("--db", default=DEFAULT_DB,
                   help="DB for the birth tag + set-count reads. Must be the "
                        "same file --kit_life's workout-add writes to.")
    p.add_argument("--kit_life", default=LIFEKIT_SH,
                   help="kit_life.sh to call for workout-add (row birth). "
                        "Default: the real database/kit_life.sh. Tests point "
                        "this at a scratch database dir's kit_life.sh.")
    p.add_argument("--program", default=DEFAULT_PROGRAM)
    p.add_argument("--marker", default=DEFAULT_MARKER)
    p.add_argument("--tombstone", default=DEFAULT_TOMBSTONE,
                   help="closed-session tombstone (.session-closed) read for the "
                        "same-day 2nd-session detection + closed-id marker guard")
    p.add_argument("--subtype", default=None,
                   help="workout-add subtype (default: resolved rotation code)")
    p.add_argument("--minutes", type=int, default=0)
    p.add_argument("--kcal", type=int, default=None,
                   help="omit = not entered (kit 064 NULL), never 0")
    p.add_argument("--note", default="")
    p.add_argument("--dry-run", action="store_true",
                   help="print the resolved verdict, create nothing")
    p.add_argument("--new", dest="start_over", action="store_true",
                   help="start over: open a NEW row even while today's live "
                        "session is open (default: a reopen resumes it)")
    args = p.parse_args(argv)

    date = args.date or _today_kst()

    db_path = os.path.abspath(args.db)
    program_path = os.path.abspath(args.program)
    if not args.dry_run and not os.path.exists(db_path):
        print("ERROR: db not found: %s" % db_path, file=sys.stderr)
        return 1
    if args.free:
        import free_session
        from types import SimpleNamespace
        try:
            return free_session.open_free(SimpleNamespace(**globals()), args,
                                          db_path, program_path, date)
        except (ValueError, OSError, free_session.sqlite3.Error) as exc:
            print("ERROR %s" % exc, file=sys.stderr)
            return 1
    if not os.path.exists(program_path):
        print("ERROR: program.yaml not found; use session-open --free for "
              "a real off-plan session.", file=sys.stderr)
        return 1

    return do_open(db_path, program_path, os.path.abspath(args.marker),
                   os.path.abspath(args.kit_life),
                   date, args.subtype, args.minutes, args.kcal, args.note,
                   args.dry_run, tombstone_path=os.path.abspath(args.tombstone),
                   start_over=args.start_over)


def _today_kst():
    import datetime
    # KST = UTC+9, no DST. Matches kit_life's TZ=Asia/Seoul date +%F.
    now = datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(hours=9)
    return now.strftime("%Y-%m-%d")


if __name__ == "__main__":
    sys.exit(main())
