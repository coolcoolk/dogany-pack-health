def _load_module(name, filename):
    """Import a sibling script that has no .py extension as a module (same
    convention session-cursor uses). __main__ guards keep import side-effect
    free."""
    path = os.path.join(HERE, filename)
    spec = importlib.util.spec_from_loader(
        name, importlib.machinery.SourceFileLoader(name, path))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


# ---------------------------------------------------------------------------
# (a) row birth -- call kit_life.sh workout-add (framework, DGN-231 preserved).
# ---------------------------------------------------------------------------
def open_workout_row(kit_life_sh, date, subtype, minutes, kcal, note,
                     force_new=False):
    """Create or reconcile today's strength (근력) workouts row via
    `kit_life.sh workout-add`. Returns (session_id, created_flag, err).
    created_flag: "yes" (new row) | "existing" (DGN-231 reconcile hit).
    force_new=True appends the framework `--new` flag (DGN-231 reconcile bypass)
    so a BRAND-NEW same-day row is created even when today's category row already
    exists -- used for a same-day 2nd session after the first was closed. On
    failure returns (None, None, reason).

    NOTE: kit_life.py's DB_PATH is hardcoded to its own SCRIPT_DIR/kit_life.db
    (framework, no --db override for workout-add). So the DB that this row lands
    in is determined by WHICH kit_life.sh we call -- production points at the real
    database/kit_life.sh; the test harness points --kit_life at a scratch copy of
    the database dir so workout-add writes to the scratch DB. The caller keeps
    the tag/marker DB in lockstep with this kit_life's DB."""
    if not os.path.exists(kit_life_sh):
        return None, None, "kit_life.sh not found: %s" % kit_life_sh
    # kit 064: an omitted kcal is "not entered" (NULL), never 0. A number
    # here was stated by the caller, so it carries origin `declared`.
    argv = [kit_life_sh, "workout-add", date, STRENGTH_CATEGORY, subtype,
            str(minutes), "" if kcal is None else str(kcal), note]
    if kcal is not None:
        argv += ["--kcal-origin", "declared"]
    if force_new:
        argv.append("--new")   # DGN-231 reconcile bypass -> guaranteed new row
    try:
        proc = subprocess.run(argv, capture_output=True, text=True)
    except OSError as e:
        return None, None, "workout-add exec failed: %s" % e
    out = (proc.stdout or "").strip()
    # DGN-231 reconcile hit -> EXISTS <n> then rows: id<TAB>type<TAB>...
    if proc.returncode == WORKOUT_ADD_EXISTS_CODE:
        sid = _first_id_from_output(out)
        if sid is None:
            return None, None, "workout-add EXISTS but no id parsed: %r" % out
        return sid, "existing", None
    if proc.returncode != 0:
        err = (proc.stderr or out or "nonzero exit %d" % proc.returncode).strip()
        return None, None, "workout-add failed: %s" % err
    # success: first line = id<TAB>type<TAB>name<TAB>kcal<TAB>avg_hr
    sid = _first_id_from_output(out)
    if sid is None:
        return None, None, "workout-add ok but no id parsed: %r" % out
    return sid, "yes", None


def _first_id_from_output(out):
    """Pull the leading integer workouts.id from a workout-add stdout block.
    Handles both the success shape (id<TAB>...) and the EXISTS shape
    (`EXISTS <n>` header then id<TAB>... rows)."""
    for line in out.splitlines():
        line = line.strip()
        if not line or line.startswith("EXISTS"):
            continue
        head = line.split("\t", 1)[0].strip()
        if head.isdigit():
            return int(head)
    return None


# ---------------------------------------------------------------------------
# same-day closed-session detection (2nd-session guard).
# A same-day strength row is treated as CLOSED (so a fresh session-open must NOT
# reuse it) when EITHER the .session-closed tombstone holds its id OR the row is
# already tagged (session_type_id NOT NULL -- closeout writes the tag) AND
# carries >=1 workout_sets row. Tombstone is the primary signal; the tagged+sets
# fallback catches a manual/legacy close that never stamped the tombstone.
#
# LIVE SESSION (2026-09-30, ticket 2026-08-23-session-open-reopen-
# abandons-live). The tagged+sets fallback read EVERY live session as closed:
# session-open tags at birth, so one logged set was enough. A second
# session-open mid-session (bridge restart, "운동 시작" said twice) then forked
# a new makeup row, took the marker over, and abandoned the live one --
# reproduced on a fixture: open -> 1 set -> open => row 2, session_class=makeup,
# marker 1 -> 2. The fact that a session is still running already exists: the
# .active-session marker names it until closeout clears it. So a row the
# marker names, and the tombstone does not, is OPEN, whatever it carries.
# Decision owed by the ticket (promote lifecycle state to a workouts column vs
# fix the judgment): the judgment. The column is a kit_life schema change this
# pack cannot make (zero-schema, db_lane=false), and the marker is already the
# lifecycle fact every other reader (set-add, session-cursor, the TurnPre hook)
# uses -- a column would be a second copy of it. "Start over" stays possible,
# explicitly: `session-open --new`.
# ---------------------------------------------------------------------------
def _marker_names(marker_path, session_id):
    if not marker_path:
        return False
    try:
        with open(marker_path) as fh:
            txt = fh.read().strip()
        return bool(txt) and int(txt) == int(session_id)
    except (OSError, ValueError):
        return False


def _row_is_closed(db_path, session_id, tombstone_path, marker_path=None):
    """True if session_id is a CLOSED strength session. Best-effort: any error
    returns False (never blocks a legitimate first-open)."""
    if session_id is None:
        return False
    try:
        co = _load_module("session_closeout", "session-closeout")
        tomb = co.read_closed_tombstone(tombstone_path)
        if tomb is not None and int(tomb) == int(session_id):
            return True
    except Exception:  # noqa: BLE001 -- tombstone read is best-effort
        pass
    if _marker_names(marker_path, session_id):
        return False   # the live session: the marker still names it
    try:
        import sqlite3
        conn = sqlite3.connect(db_path)
        try:
            row = conn.execute(
                "SELECT session_type_id FROM workouts WHERE id = ?",
                (session_id,)).fetchone()
            if not row or row[0] is None:
                return False   # untagged -> still open (mid-session)
            srow = conn.execute(
                "SELECT COUNT(*) FROM workout_sets WHERE session_id = ?",
                (session_id,)).fetchone()
            return bool(srow and srow[0] > 0)
        finally:
            conn.close()
    except Exception:  # noqa: BLE001
        return False


def probe_existing_strength_ids(db_path, date):
    """Read-only: return the list of today's strength (근력) workouts ids, newest
    first. Pure SELECT -- NO write, so it never creates a junk row (unlike a
    workout-add reconcile probe). Best-effort: any error -> []."""
    try:
        import sqlite3
        conn = sqlite3.connect(db_path)
        try:
            rows = conn.execute(
                "SELECT DISTINCT w.id FROM workouts w "
                "JOIN workout_classifications wc ON wc.workout_id = w.id "
                "JOIN workout_types wt ON wt.id = wc.type_id "
                "WHERE w.date = ? AND wt.category = ? "
                "ORDER BY w.id DESC",
                (date, STRENGTH_CATEGORY)).fetchall()
            return [r[0] for r in rows]
        finally:
            conn.close()
    except Exception:  # noqa: BLE001 -- probe is best-effort
        return []


# ---------------------------------------------------------------------------
# rotation verdict -- rx-calc is the AUTHORITATIVE source of rotation_day,
# session_class, and provisional. We never re-derive the day.
# ---------------------------------------------------------------------------
def rotation_verdict(program_path, db_path, date, exclude_session_id=None):
    """Return a dict {session_class, rotation_day, provisional, session_type_id,
    makeup_type_id} using rx-calc's own functions -- NOT a re-derivation.
    On any failure returns (None, reason)."""
    try:
        rx = _load_module("rx_calc", "rx-calc")
    except Exception as e:  # noqa: BLE001 -- surface any import failure as a reason
        return None, "rx-calc import failed: %s" % e
    try:
        program = rx.load_yaml(program_path)
    except Exception as e:  # noqa: BLE001
        return None, "program.yaml load failed: %s" % e
    if not isinstance(program, dict):
        return None, "program.yaml did not parse as a dict"

    # Authoritative rotation day (excludes the session we are opening so its own
    # untagged row never contaminates the basis -- same guard rx-calc uses).
    try:
        rotation_day, provisional = _select_day(rx, program, db_path,
                                                 exclude_session_id)
    except Exception as e:  # noqa: BLE001
        return None, "select_rotation_day failed: %s" % e

    # Authoritative regular/makeup verdict (MEASURED weekly state, C1 gate).
    # G1: the SAME exclusion applies to the class gate. Previously only the day
    # selector honored exclude_session_id, so an "exclude this session" retry
    # fixed the exercise list while the 정규/보충 label stayed wrong.
    session_class = _session_class(rx, program, db_path, date,
                                   exclude_session_id)

    makeup_type_id = rx.resolve_session_type_id(db_path, MAKEUP_CODE)
    rot_type_id = (rx.resolve_session_type_id(db_path, rotation_day)
                   if rotation_day else None)
    return {
        "session_class": session_class,
        "rotation_day": rotation_day,
        "provisional": bool(provisional),
        "rotation_type_id": rot_type_id,
        "makeup_type_id": makeup_type_id,
    }, None


def _select_day(rx, program, db_path, exclude_session_id):
    """Call rx-calc.select_rotation_day. Its contract is a 3-tuple
    (rotation_day_code, basis_text, provisional_flag). Returns (code,
    provisional)."""
    res = rx.select_rotation_day(program, db_path,
                                 exclude_session_id=exclude_session_id)
    # Contract: (code, basis_text, provisional_flag). provisional is index 2.
    code = res[0]
    prov = res[2] if len(res) >= 3 else False
    return code, prov


def _session_class(rx, program, db_path, date, exclude_session_id=None):
    """Authoritative regular/makeup via rx-calc's C1 gate (week_regular_status).
    Returns 'regular' | 'makeup'; defaults to 'regular' if unavailable.
    exclude_session_id = the session this verdict is FOR (never counts itself).
    Passed as a keyword and tolerated if absent, so an older rx-calc without
    the G1 parameter still yields a verdict instead of falling to the
    'regular' default."""
    fn = getattr(rx, "week_regular_status", None)
    if not callable(fn):
        return "regular"
    try:
        try:
            v = fn(program, db_path, date,
                   exclude_session_id=exclude_session_id)
        except TypeError:
            # pre-G1 rx-calc: no exclude_session_id parameter.
            v = fn(program, db_path, date)
    except Exception:  # noqa: BLE001 -- best-effort; default regular
        return "regular"
    if isinstance(v, dict):
        v = v.get("session_class")
    if isinstance(v, str) and v in ("regular", "makeup"):
        return v
    return "regular"


# ---------------------------------------------------------------------------
# (b) tag + (c) marker  -- best-effort layered on the row.
# ---------------------------------------------------------------------------
def apply_birth_tag(db_path, session_id, verdict):
    """Best-effort birth tag through the shared canonical write. Returns one of:
    applied | skipped_provisional | skip_clobber | noop | failed. A tag failure
    NEVER propagates (row + marker must survive)."""
    session_class = verdict["session_class"]
    if session_class == "makeup":
        code = MAKEUP_CODE
    else:
        # PROVISIONAL policy: an unconfirmed rotation guess is NOT laundered into
        # a confirmed anchor. Leave NULL; closeout tags authoritatively later.
        if verdict["provisional"]:
            return "skipped_provisional"
        code = verdict["rotation_day"]
        if not code:
            return "skipped_provisional"
    try:
        import sqlite3
        co = _load_module("session_closeout", "session-closeout")
        conn = sqlite3.connect(db_path)
        try:
            rc, result = co.tag_session_type(conn, session_id, code,
                                             birth_only=True)
        finally:
            conn.close()
    except Exception as e:  # noqa: BLE001 -- best-effort; never fail the open
        print("WARN birth tag failed (row+marker unaffected): %s" % e,
              file=sys.stderr)
        return "failed"
    if rc != 0:
        return "failed"
    if result == "skip_birth_clobber":
        return "skip_clobber"
    if result == "noop_same":
        return "noop"
    return "applied"


def set_marker(marker_path, session_id, tombstone_path=None):
    """Set the active-session marker (session-cursor.marker_write), clearing a
    STALE marker for a DIFFERENT session first. Returns set | takeover | failed.
    Best-effort: a marker failure never fails the open.

    Closed-id guard: never point .active-session at a session that the
    .session-closed tombstone still holds. When the marker is about to become the
    active session AND the tombstone equals it, clear the stale tombstone first
    (a fresh open on the closed session's day supersedes it) so the active marker
    can never coexist with a closed tombstone for the SAME id -- the exact
    contradiction the 2026-08-20 incident produced. For a forced-new 2nd session
    this is a no-op (the new id != the tombstoned id)."""
    try:
        sc = _load_module("session_cursor", "session-cursor")
    except Exception:  # noqa: BLE001
        return "failed"
    if tombstone_path is not None:
        _clear_matching_tombstone(tombstone_path, session_id)
    prior = sc.marker_read(marker_path)
    ok = sc.marker_write(marker_path, session_id)
    if not ok:
        return "failed"
    if prior is not None and prior != session_id:
        return "takeover"
    return "set"


def clear_pending_markers(session_id, state_dir=None):
    """Drop any pending-menu marker found at session BIRTH. See the call site in
    do_open (step 5b) for why birth is a legitimate clear point.

    Returns a short status token for the OPENED line: "clean" (nothing there),
    or e.g. "cleared:reply" / "cleared:reply+tip". Best-effort: a marker that
    will not delete never fails an open -- the fast path's own age bound (900s,
    session-fastpath.REPLY_PENDING_TTL_S) retires it shortly after."""
    root = state_dir or STATE_DIR
    cleared = []
    for label, name in (("reply", ".reply-pending"), ("tip", ".tip-pending")):
        path = os.path.join(root, name)
        if not os.path.exists(path):
            continue
        try:
            os.remove(path)
            cleared.append(label)
        except OSError:
            pass
    return "cleared:%s" % "+".join(cleared) if cleared else "clean"


def _clear_matching_tombstone(tombstone_path, session_id):
    """If the .session-closed tombstone holds session_id, remove it (best-effort).
    Prevents a closed-tombstone + active-marker contradiction for the same id."""
    try:
        co = _load_module("session_closeout", "session-closeout")
        tomb = co.read_closed_tombstone(tombstone_path)
    except Exception:  # noqa: BLE001
        return
    if tomb is None or int(tomb) != int(session_id):
        return
    try:
        os.remove(tombstone_path)
    except OSError:
        pass


