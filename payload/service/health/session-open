# today's exercise lineup the moment the session opens; exercise-enter later
# REFINES the same pin per exercise (it re-publishes the SAME owner section, so
# its card simply supersedes this initial state). ONE SHARED CARD FORMAT (owner
# directive 2026-08-21): both the CARD BUILDER (exercise-enter.render_lineup_card
# -- the 종목전환표/표3 종목카드 with per-slot ✓완료/▸진행중/·예정 state, all ·예정
# at open) and the PUBLISH path (write_dashboard_card -> DGN-967
# `status-footer.py --pin-set workout` -> bridge/dashboard.py DGN-214 auto-pin)
# live in exercise-enter, so the session-start pin and the per-exercise pin read
# as ONE card -- no new pin mechanism, no session-open-local lineup renderer.
# session-closeout owns the matching --pin-clear at the end of the session.
# ---------------------------------------------------------------------------
def write_start_pin(program_path, verdict, db_path=None, session_id=None,
                    card_out=None):
    """Write today's 종목전환표 (표3 종목카드) to the dashboard.md pin at SESSION
    START.

    ONE shared card format (owner directive 2026-08-21): the session-start pin
    and the per-exercise pin use the SAME builder -- exercise-enter.render_lineup_card,
    which renders the whole-day session card in the 2026-08-14 LOCKED 표(3)
    layout (🗂 title + 부위군 / progress bar + 진행률 / 경과·잔여 / [진행] with
    ✓ ▸ · markers / [누적 볼륨]). At session open EVERY slot is · 예정, the bar
    reads 0/N and the volume block is ABSENT (nothing is measured yet -- it
    appears with the first working set); exercise-enter later REFINES the same
    pin per set.

    db_path/session_id (optional): when both are given the card is built from
    live state via exercise-enter.gather_card_state, so the session-start pin
    already carries the coarse 부위군 title and the 0분 경과 clock row. Absent ->
    the static all-upcoming card (still the locked layout, no clock row).

    GATED (never write a bad pin):
      - only for a REGULAR session with a CONFIRMED (non-provisional) rotation
        day -- a provisional guess or a makeup session has no authoritative
        lineup, so we leave the pin to exercise-enter's per-exercise refine;
      - render_lineup_card returns None -> nothing to pin -> no publish (an
        empty body is a NO-OP for the owner section, never a clear -- clearing
        is session-closeout's job, DGN-967).

    REUSE: both the CARD BUILDER (render_lineup_card) and the PUBLISH path
    (write_dashboard_card -- the SAME DGN-967 "workout" pin section + inert-safe
    guard the per-exercise refine uses) live in exercise-enter.
    BEST-EFFORT / INERT-SAFE: any failure is swallowed here so a pin miss can
    NEVER fail the session open (the row + tag + marker are the critical path).
    Returns "written" | "skipped_provisional" | "skipped_makeup"
    | "skipped_no_lineup" | "error"."""
    session_class = verdict.get("session_class")
    if session_class == "makeup":
        return "skipped_makeup"
    if verdict.get("provisional"):
        return "skipped_provisional"
    day_code = verdict.get("rotation_day")
    if not day_code:
        return "skipped_provisional"
    try:
        rx = _load_module("rx_calc", "rx-calc")
        program = rx.load_yaml(program_path)
    except Exception as e:  # noqa: BLE001 -- pin miss never fails the open
        print("WARN start-pin program load failed (pin unaffected): %s" % e,
              file=sys.stderr)
        return "error"
    if not isinstance(program, dict):
        return "skipped_no_lineup"
    days = program.get("days") or {}
    slots = (days.get(day_code) or {}).get("exercises") or []
    if not slots:
        return "skipped_no_lineup"
    try:
        # REUSE the exercise-enter card builder + pin publisher (shared 표3
        # format + the DGN-967 "workout" section). It reads WARG_DASHBOARD_FILE
        # from env at import time and derives the section store's dir from it,
        # so a scratch pin path set for a test isolates this call too.
        # states=None -> every slot ·예정 (session-start all-upcoming state).
        ee = _load_module("exercise_enter", "exercise-enter")
        card_state = None
        if db_path and session_id:
            # D1: rotation_day = the split THIS session trains, so the start pin
            # names TODAY's prescribed weights -- the same ones the 표2 grid will
            # show -- not program.yaml's last-session snapshot.
            card_state = ee.gather_card_state(db_path, program_path,
                                              session_id, slots, rx=rx,
                                              rotation_day=day_code)
        if not card_state or not card_state.get('session_prep_total'):
            try:
                st = _load_module('start_set_table', 'set-table')
                prep = st.session_prep_drills(rx, program_path, day_code)
                if prep:
                    card_state = dict(card_state or {})
                    card_state['session_prep_total'] = len(prep)
                    card_state['session_prep_done'] = 0
                    card_state['session_prep_names'] = [
                        d.get('display') or d.get('code') for d in prep]
            except Exception:
                pass
        card_lines = ee.render_lineup_card(day_code, slots,
                                           card_state=card_state)
        if not card_lines:
            return "skipped_no_lineup"
        if card_out is not None:
            # deliver_start_card reads the SAME render, so the chat card and
            # the pin can never show two different lineups.
            card_out.extend(card_lines)
        ok = ee.write_dashboard_card(card_lines)
    except Exception as e:  # noqa: BLE001 -- inert-safe: never break the open
        print("WARN start-pin write failed (session open unaffected): %s" % e,
              file=sys.stderr)
        return "error"
    return "written" if ok else "error"


