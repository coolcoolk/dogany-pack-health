# THE CARRIER IS EXECUTION ORDER, not an instruction: session-open runs as the
# session's STEP-0 tool call, and this push happens synchronously INSIDE that
# call -- so the card is on the owner's screen before the model's C6 question
# (평문) and its [[OPTIONS]] marker (버튼, rendered on that same later message)
# can exist. 표 -> 평문 -> 버튼, held by sequence, with nothing for the model
# to remember.
#
# Reuses the delivery hop the tables already ride (set-table.deliver_table,
# push.sh -> bridge sanitize -> <pre>) and its content ledger (an idempotent
# re-open of the same session must not post the card twice). Ledger key is
# ASCII -- the identifier axis never carries Korean. Best-effort: a delivery
# miss never fails the open (the pin still carries the lineup).
# ---------------------------------------------------------------------------
START_CARD_LEDGER_KEY = "session-start-card"


def deliver_start_card(card_lines, session_id):
    """Push the session-start 표3 card into the CHAT FLOW, by code, during the
    open call. Returns "sent" | "duplicate" | "skipped_<reason>" | "error"."""
    if not card_lines:
        return "skipped_no_lineup"
    try:
        ee = _load_module("exercise_enter", "exercise-enter")
        markers = getattr(ee, "_CARD_MACHINE_MARKERS", ())
        body_lines = [str(ln) for ln in card_lines
                      if str(ln).strip() not in markers]
        if not any(ln.strip() for ln in body_lines):
            return "skipped_no_lineup"
        body = "```\n%s\n```" % "\n".join(body_lines)
        st = _load_module("set_table", "set-table")
        claimed, _sig = st.claim_table_delivery(
            session_id, START_CARD_LEDGER_KEY, body)
        if not claimed:
            return "duplicate"
        ok, detail = st.deliver_table(body, session_id,
                                      START_CARD_LEDGER_KEY)
        return "sent" if ok else ("error:%s" % detail)
    except Exception as e:  # noqa: BLE001 -- a card miss never fails the open
        print("WARN start-card delivery failed (open unaffected): %s" % e,
              file=sys.stderr)
        return "error"


