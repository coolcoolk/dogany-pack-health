# TIMEBLOCK CLOSE CARRIER (2026-08-25 -- the workout timeblock was not being
# renamed and completed at session close)
#
# close_task.sh renames the day's 헬스 timeblock to "헬스 - <split>" and
# completes it. It worked; it simply was not reachable. Its ONLY caller was a
# PROSE step in .claude/skills-bundle/workout-log/SKILL.md ("4. auto-close
# workout task ... run after successful workout-add"), i.e. the block close was
# MODEL-REMEMBERED and lived on the workout-add branch only.
#
# Measured both ways on consecutive days:
#   2026-08-24 08:43:52 session-closeout 10091 앞A -> 08:44:34 close_task.sh
#              -> timeblock 12766 "헬스 - 앞A", status=done.   (remembered)
#   2026-08-25 08:17:21 session-closeout 10092 뒷A -> close_task.sh NEVER run
#              -> timeblock 12768 "헬스" sat unsettled all day while 32 real
#              set rows were on disk.                          (forgotten)
# Same skill, same model, same owner, opposite outcome. A coin flip is not a
# lifecycle.
#
# CODE decides, not the model -- the same discipline kit_life.py already applies
# to TASK_OWNING_AGENT ("a CLI flag alone would depend on the model remembering
# to pass it, which is exactly the failure mode this codebase keeps repeating").
# Closing the session and closing the day's block are ONE event, so they get ONE
# carrier: this function, called from do_close. Whichever entry point the model
# picks, the block now closes.
#
# RE-ENTRANCY. close_task.sh drives session-closeout at ITS end (the reverse
# edge of this same pair), so an unguarded call here is mutual recursion.
# LIFEKIT_SESSION_CLOSE_CHAIN is the single chain flag: whoever enters the chain
# first sets it, and the other edge no-ops. Both edges read this exact name.
#
# LIVE GATE. close_task.sh always talks to the LIVE kit_life.sh / kit_life.db --
# it has no --db and kit_life.py hardcodes DB_PATH next to itself. do_close, by
# contrast, is routinely called by the test suite against a scratch --db. An
# unconditional call out would let a TEST close-out settle the OWNER'S real
# timeblock. So this fires only when the DB being closed IS the live DB; a
# scratch-DB close-out skips and says so on stderr.
#
# STDOUT. D5 says stdout carries exactly one renderable artifact (the card).
# close_task.sh prints its CLOSED/NONE/MULTI verdict on stdout, so the verdict
# is captured and re-emitted through _op (stderr). Never printed raw.
# ---------------------------------------------------------------------------
# KIT FILE (0.17.0). close_task.sh ships with the KIT's workout-log skill
# (kit_life >=2.27.0, pinned by requires_kit); this pack no longer carries it.
# The installer lands every kit skill at <instance>/.claude/skills-bundle/<name>/
# (pack_install.sh skills-bundle step), so the path below is unchanged. The
# chain flag name is the kit's (close_task.sh reads LIFEKIT_SESSION_CLOSE_CHAIN
# and LIFEKIT_HEALTH_STATE_DIR); both edges must use the same name or the
# re-entrancy guard is dead.
CLOSE_CHAIN_ENV = "LIFEKIT_SESSION_CLOSE_CHAIN"
CLOSE_TASK_SH = os.path.join(PROJECT_ROOT, ".claude", "skills-bundle",
                             "workout-log", "close_task.sh")


def _is_live_db(db_path, live_db=DEFAULT_DB):
    """True iff db_path resolves to the same file as the live kit_life.db.
    realpath on both sides: the live path is a symlink into the shared crews DB,
    and --db is commonly passed as a relative or non-canonical path."""
    try:
        return os.path.realpath(db_path) == os.path.realpath(live_db)
    except OSError:
        return False


def close_day_timeblock(db_path, day, close_task_sh=CLOSE_TASK_SH):
    """Rename + complete `day`'s 헬스 timeblock via close_task.sh.

    `day` is the SESSION's date (workouts.date), not today -- a close-out run
    the morning after, or a backfill of a past session, must settle the block
    that session belongs to.

    Returns the close_task.sh verdict ('CLOSED\\t<title>' / 'NONE' / 'MULTI'),
    or None when skipped or failed. BEST-EFFORT throughout: never raises, never
    fails a close-out, never writes to stdout.
    """
    if os.environ.get(CLOSE_CHAIN_ENV):
        return None          # close_task.sh started this chain; it owns the block
    if not _is_live_db(db_path):
        _op("TIMEBLOCK skipped -- not the live db (%s); live-only carrier"
            % db_path)
        return None
    if not os.path.isfile(close_task_sh):
        _op("TIMEBLOCK skipped -- close_task.sh not found at %s" % close_task_sh)
        return None
    env = dict(os.environ)
    env[CLOSE_CHAIN_ENV] = "1"
    # Force, not setdefault: close_task.sh resolves kit_life.sh from PROJECT_ROOT
    # first, and an inherited PROJECT_ROOT from some other tree would send the
    # write to the wrong instance. We are already past the live-db gate.
    env["PROJECT_ROOT"] = PROJECT_ROOT
    try:
        proc = subprocess.run(
            ["bash", close_task_sh, day],
            cwd=PROJECT_ROOT, env=env, timeout=60,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
    except Exception as exc:  # noqa: BLE001 -- a block close never fails a close-out
        _op("WARN timeblock close failed: %s" % exc)
        return None
    err = (proc.stderr or b"").decode("utf-8", "replace").strip()
    if err:
        _op("TIMEBLOCK stderr: %s" % err.replace("\n", " | "))
    if proc.returncode != 0:
        _op("WARN close_task.sh exit=%s" % proc.returncode)
        return None
    verdict = (proc.stdout or b"").decode("utf-8", "replace").strip()
    _op("TIMEBLOCK %s" % (verdict.replace("\n", " | ") or "(no output)"))
    return verdict


def _fatigue_tail(db_path, session_id, program_path=None, state_dir=None):
    """fatigue-brief close_card_line(): (card line, extra lines), or ('', [])
    on any failure (never blocks). The line becomes the closeout card's last
    line; `extra` is the one-time draft-map confirmation printed under it."""
    try:
        path = os.path.join(SCRIPT_DIR, "fatigue-brief")
        if not os.path.exists(path):
            return "", []
        loader = importlib.machinery.SourceFileLoader("fatigue_brief_tail",
                                                      path)
        spec = importlib.util.spec_from_loader(loader.name, loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        return mod.close_card_line(db_path, session_id, program=program_path,
                                   state_dir=state_dir)
    except Exception as exc:  # noqa: BLE001 -- a close-out never fails here
        _op("WARN fatigue tail skipped: %s" % exc)
        return "", []


def do_close(db_path, session_id, session_type_code,
             marker_path=ACTIVE_MARKER, tombstone_path=CLOSED_TOMBSTONE,
             published_dir=PUBLISHED_DIR, clear_pin=True,
             unmeasured=False, make_card=True, resolve_exercises=True,
             program_path=None, closed_dir=None, state_dir=None):
    from free_session import is_free, effective_path, CODE
    if is_free(db_path, session_id):
        session_type_code = CODE
    program_path = effective_path(program_path, db_path, session_id)
    conn = sqlite3.connect(db_path)
    try:
        # -- D4 GATE, BEFORE ANY WRITE ------------------------------------
        # A refused close-out must leave the session byte-identical: still
        # tagged as it was, still open, still fast-pathable. So the measurement
        # verdict is taken first, ahead of the tag write and the tombstone.
        row = measure_row(conn, session_id)
        if row is None:
            print("ERROR: no workouts row with id=%s" % session_id,
                  file=sys.stderr)
            return 1
        date, _minutes, _kcal, _hr, note = row
        missing = _missing_measures(row)
        if missing and not is_unmeasured_declared(note):
            if not unmeasured:
                print(unmeasured_refusal_text(session_id, row, missing,
                                              session_type_code))
                return 4
            note = stamp_unmeasured(conn, session_id, note)
            row = (row[0], row[1], row[2], row[3], note)
            _op("UNMEASURED session %s declared %s (missing: %s)"
                % (session_id, UNMEASURED_STAMP, ", ".join(missing)))

        rc, _result = tag_session_type(
            conn, session_id, session_type_code, birth_only=False,
            stream=sys.stderr)
        if rc != 0:
            return rc

        set_n = _set_count(conn, session_id)
        if set_n == 0:
            _op("WARN session %s has 0 workout_sets rows -- tag set, but "
                "per-set data missing; not fully closed until sets are logged"
                % session_id)
        else:
            _op("session %s has %s workout_sets rows" % (session_id, set_n))

        # -- D6: resolve every still-open exercise BEFORE the markers go -----
        # Ordering is load-bearing twice over: resolve_exercise runs set-table,
        # which reads .set-arm-override / .exercise-entered, so it must happen
        # before the sweep; and it must happen before the pin clear so the card
        # it builds is the same card the pin was showing.
        records = []
        if make_card or resolve_exercises:
            try:
                records = resolve_open_exercises(
                    db_path, conn, session_id, "session_close",
                    program_path=program_path, closed_dir=closed_dir)
                records = include_unstarted(records, program_path,
                                            session_type_code)
                unresolved = sum(r.get("rows_resolved") or 0 for r in records)
                _op("EXERCISES resolved=%d rows_marked_abandoned=%d"
                    % (len(records), unresolved))
            except Exception as exc:  # noqa: BLE001 -- never block a close-out
                _op("WARN exercise resolution failed: %s" % exc)

        # Session is closed -> stamp the F1 tombstone then stop the fast-path
        # gate (best-effort). Tombstone-before-remove ordering lives in the
        # helper so set-add's self-heal cannot revive a closed session's marker.
        _clear_active_marker(session_id, marker_path, tombstone_path)
        # Clear this session's set-table entry-gate flags (best-effort).
        _clear_published_flags(session_id, published_dir)
        # D1 leak: retire every OTHER marker this session owns -- above all
        # .reply-pending, whose survival past close-out is what poisoned the
        # next morning. Session-scoped and best-effort throughout.
        for label, detail in sweep_session_markers(session_id,
                                                   state_dir=state_dir):
            _op("SWEPT %s=%s" % (label, detail))
        # DGN-967: retire the 표3 종목카드 from the shared pin (best-effort).
        # Last, and after the tombstone: an un-cleared pin is cosmetic, a
        # mis-ordered tombstone is the F1 phantom-logging bug.
        if clear_pin:
            _op("PIN_CARD cleared=%s" % ("yes" if clear_pin_card() else "no"))
            try:
                subprocess.run([sys.executable, os.path.join(SCRIPT_DIR, "workbench.py"),
                                "--db", db_path, "--state",
                                os.path.join(STATE_DIR, ".program-plan.json")],
                               capture_output=True, timeout=20, check=False)
            except (OSError, subprocess.TimeoutExpired):
                pass

        # The day's 헬스 timeblock is part of the same session end -- rename it
        # to "헬스 - <split>" and complete it. See close_day_timeblock() for why
        # this lives in code rather than in SKILL.md prose. Placed AFTER the
        # durable state transition and BEFORE the card, on the same rule as the
        # pin clear: once the session is closed, nothing downstream may un-close
        # it, so every step from here on is best-effort and cannot change the
        # return code. `date` is the SESSION's day (from measure_row above), not
        # today -- a next-morning close-out settles the right day's block.
        close_day_timeblock(db_path, date)

        # -- D5: the CARD is the stdout product ----------------------------
        # Operator lines went to stderr (_op); stdout carries one renderable
        # artifact. A card that cannot be built REFUSES rather than degrading
        # into sentences -- but it refuses AFTER the state transition, which is
        # already durable, so the exit code stays 0 and the failure is loud on
        # stderr. (Same reasoning as the fast path's post-commit rule: once the
        # session is closed, a render problem may not un-close it.)
        if make_card:
            # Muscle-fatigue session end (worklog 2026-09-26, phase 2), folded
            # into the card as its last line (owner 2026-10-02): slowest
            # recovery, else the most-used regions. The sentence is
            # fatigue-brief's (the only fatigue copy owner). The one-time
            # confirmation of muscle maps drafted mid-session prints under the
            # card. Fail-open: a kit without the 056 read model prints nothing.
            fline, fextra = _fatigue_tail(db_path, session_id, program_path,
                                          state_dir)
            try:
                print(render_card(
                    session_close_card(session_id, date, session_type_code,
                                       row, records, db_path=db_path,
                                       program_path=program_path,
                                       fatigue_line=fline)))
            except CardPublishError as exc:
                _op("WARN close-out card refused: %s" % exc)
            if fextra:
                print("")
                print("\n".join(fextra))
        return 0
    finally:
        conn.close()


def main(argv=None):
    p = argparse.ArgumentParser(
        prog="session-closeout",
        description="Weight-session close-out validator + writer (DGN-388).",
    )
    p.add_argument("session_id", nargs="?", type=int, help="workouts.id to close out")
    p.add_argument(
        "session_type_code",
        nargs="?",
        help="session_type.code to tag (e.g. 앞A, 뒷A, 앞B, 뒷B)",
    )
    p.add_argument("--db", default=DEFAULT_DB, help="path to kit_life.db")
    p.add_argument("--marker", default=ACTIVE_MARKER,
                   help="active-session marker to clear on close (default: live; "
                        "tests point this at a scratch path for isolation)")
    p.add_argument("--tombstone", default=CLOSED_TOMBSTONE,
                   help="closed-session tombstone to stamp (default: live)")
    p.add_argument("--published-dir", default=PUBLISHED_DIR,
                   help="set-table published-flag dir to clear (default: live)")
    p.add_argument("--no-pin-clear", action="store_true",
                   help="skip the DGN-967 pin section clear (tests / a close-out "
                        "that must not touch the owner's pinned card)")
    p.add_argument(
        "--check",
        action="store_true",
        help="validator mode: is the latest weight session properly closed?",
    )
    p.add_argument(
        "--sweep",
        action="store_true",
        help="cron mode: run the FULL close-out for the latest weight session "
             "when its DB content is complete but its state transition never "
             "ran. NEVER auto-closes a NEEDS_CLOSEOUT session (that refusal is "
             "the owner's call). Always exits 0.",
    )
    p.add_argument("--unmeasured", action="store_true",
                   help="D4: this session's duration/energy genuinely were not "
                        "measured -- stamp the note %s and close anyway. "
                        "Without this a session with minutes=0 or kcal=0 is "
                        "REFUSED (exit 4), never silently booked as zero."
                        % UNMEASURED_STAMP)
    p.add_argument("--no-card", action="store_true",
                   help="suppress the D5 close-out card on stdout (state "
                        "transition only; operator log still goes to stderr)")
    p.add_argument("--no-resolve", action="store_true",
                   help="skip the D6 exercise-exit resolution sweep")
    p.add_argument("--program", default=None,
                   help="program.yaml for the set-table renders (default: "
                        "set-table's own default)")
    p.add_argument("--closed-dir", default=None,
                   help=".exercise-closed dir (default: live)")
    p.add_argument("--state-dir", default=None,
                   help="runtime-marker root for the session sweep (default: "
                        "$LIFEKIT_HEALTH_STATE_DIR or this script's dir)")
    p.add_argument("--exercise-exit", nargs=2, metavar=("SESSION_ID", "EXERCISE"),
                   help="D6: close ONE exercise -- resolve every unfinished set "
                        "row and emit the ExerciseExit card. Use this at the "
                        "moment the owner abandons an exercise mid-way.")
    p.add_argument("--reason", default="",
                   help="free text recorded with --exercise-exit "
                        '(e.g. "털렸어, 넘어가자")')
    args = p.parse_args(argv)

    db_path = os.path.abspath(args.db)
    if not os.path.exists(db_path):
        print("ERROR: db not found: %s" % db_path, file=sys.stderr)
        return 1

    if args.check:
        return do_check(db_path)

    if args.sweep:
        return do_sweep(db_path,
                        marker_path=os.path.abspath(args.marker),
                        tombstone_path=os.path.abspath(args.tombstone),
                        published_dir=os.path.abspath(args.published_dir),
                        clear_pin=not args.no_pin_clear,
                        state_dir=args.state_dir,
                        program_path=args.program,
                        closed_dir=args.closed_dir)

    if args.exercise_exit:
        return do_exercise_exit(db_path, int(args.exercise_exit[0]),
                                args.exercise_exit[1], reason=args.reason,
                                program_path=args.program,
                                closed_dir=args.closed_dir)

    from free_session import is_free, effective_path, CODE
    if args.session_id is not None and is_free(db_path, args.session_id):
        args.session_type_code = CODE
        args.program = effective_path(args.program, db_path, args.session_id)
    if args.session_id is None or args.session_type_code is None:
        p.error("close-out needs <session_id> <session_type_code> (or use --check)")
    return do_close(db_path, args.session_id, args.session_type_code,
                    marker_path=os.path.abspath(args.marker),
                    tombstone_path=os.path.abspath(args.tombstone),
                    published_dir=os.path.abspath(args.published_dir),
                    clear_pin=not args.no_pin_clear,
                    unmeasured=args.unmeasured,
                    make_card=not args.no_card,
                    resolve_exercises=not args.no_resolve,
                    program_path=args.program,
                    closed_dir=args.closed_dir,
                    state_dir=args.state_dir)


if __name__ == "__main__":
    sys.exit(main())
