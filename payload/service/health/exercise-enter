def publish_set_table(st, rx, program, db_path, program_path,
                      session_id, exercise_name, signals=None):
    """Render the (2) progress table through set-table.render and mark it
    published (set-table's own flag) so the set-add SET_TABLE_MISSING fallback
    stays consistent. Returns (table_text_or_None, err_or_None). Best-effort:
    any failure -> (None, reason); the caller degrades, never aborts.

    `signals` (A3): pass a list to collect set-table's own machine lines
    (RAMP_DECISION / WT_UNKNOWN / PREP_PLANNED) so ENTRY -- the moment the
    owner first sees the exercise -- states the ramp decision out loud. D3 was
    the model claiming "엔진이 별도 램프 세트를 산출하지 않았어요" at entry and
    folding 20 seconds later, having had no way to check."""
    try:
        out, err = st.render(program, db_path, session_id, exercise_name, rx,
                             program_path=program_path, signals=signals)
    except Exception as e:  # noqa: BLE001 -- surface any render failure as reason
        return None, "set-table render raised: %s" % e
    if err:
        return None, err
    # Mark set-table's OWN published flag (reuse its writer) so the set-add
    # entry gate sees the table as posted at entry -- exactly what set-table's
    # main() does after a successful render.
    try:
        st._mark_published(session_id, exercise_name)
    except Exception:  # noqa: BLE001 -- flag miss never blocks the publish
        pass
    return out, None


# ---------------------------------------------------------------------------
# (a2) THE DELIVERY HOP -- the (2) table reaches the owner because CODE SENT IT.
#
# WHY THIS EXISTS (owner ruling 2026-09-11): the table must appear on every
# recorded set, not only at entry:
#
#   Before this, the (2) table had exactly ONE carrier: the model. do_enter
#   rendered the table and PRINTED it, and a prose rule asked the model to
#   relay the fenced block. The measured result over one live session is the
#   whole argument -- the table rail's own push ledger held 5 sends for the
#   day, ALL FIVE at exercise entry, ZERO between sets. The one place the
#   documentation named as the deterministic carrier
#   (routines/set-table-followup.py) is a hook that instructs the MODEL, is
#   registered in no settings file, and has never run.
#
#   So the fix is not another sentence in a document. Model discipline is the
#   thing that failed; a sentence telling it to try harder fails the same way.
#   The code sends the table, on the same event the DB write already lands on.
#
# WHAT ONE DELIVERY IS. The arbiter is the table's own CONTENT, not the event
# that asked for it. Two publish requests that would put the SAME rows on the
# screen are ONE delivery, whoever asked -- which is what makes entry and
# per-set publishing safe to run in the same beat. The concrete case this
# closes: on the first working set of an un-entered exercise, set-add
# auto-fires exercise-enter (the #34/#37 recovery) AND then asks for the
# per-set publish. Both render the same post-set state, so both compute the
# same signature and the owner gets ONE message.
#
# THE LEDGER ITSELF LIVES IN set-table (claim_table_delivery / table_delivered),
# next to the table it arbitrates, because a THIRD sender consults it: the
# inline-button rail declares set-table as the arm's `followup_cmd` and the
# bridge posts its stdout. exercise-enter decides WHEN a table is owed;
# set-table owns the table, its delivery and who is allowed to put it on the
# screen. Underneath, both are set-arm's step_affordance G3 ledger -- the same
# O_CREAT|O_EXCL claim that keeps two concurrent arms from double-pushing a
# keyboard. A second delivery ledger for the same class of defect is how the
# two drift apart, so this rail borrows that one rather than growing its own.
# ---------------------------------------------------------------------------


def _inplace_stale(st, session_id, exercise_name, body):
    """True only when set-table KNOWS its in-place message shows other rows."""
    try:
        return st.inplace_shows(session_id, exercise_name, body) is False
    except Exception:  # noqa: BLE001 -- older set-table / unknown -> no
        return False


def deliver_set_table(st, table, session_id, exercise_name, entry=False):
    """Send the rendered (2) table to the owner as its OWN message, ONCE.

    Returns one of:
        "sent"       -- delivered by code; stdout carries a receipt, no fence
        "duplicate"  -- this exact table already went out; NOTHING was sent
        "edit_uncertain" -- the in-place edit may have landed; NO fallback
                        rows (they would be the duplicate)
        "<reason>"   -- the send failed; the CALLER must print the fallback

    IN PLACE (spec 2026-08-20 s.2): when push.sh can edit, the table is ONE
    message per exercise -- the entry beat (entry=True) posts it fresh, every
    set boundary edits it (set-table deliver_table inplace=True).

    Prints its own machine line and, on failure, the de-fenced rows. The
    FALLBACK SHAPE is deliberate and is not the old `print(table)`: the fenced
    block re-printed on a relay surface renders as literal backticks around a
    collapsed grid, which is the defect the delivery hop was opened to remove,
    so a failed send would silently restore it. Rows are kept (losing the table
    is worse than mis-aligning it), fence markers are stripped.

    A FAILED send RELEASES its ledger claim (hop map 2026-09-03, rail B). The
    claim means "on the owner's screen", and a failed send put nothing there:
    the fallback rows go to this process's stdout, which on the per-set beat
    and the inline-button rail reaches no one. A kept claim then made the
    button followup withhold the rows as already delivered and the next
    publish refuse them as a duplicate -- no table at all. Released, the next
    publish of the same rows is a retry. The ONE exception is an uncertain
    in-place edit: it may have landed, so its claim stays.

    BEST-EFFORT: never raises. This runs after a committed DB write on both
    call paths."""
    body = (table or "").strip()
    if not body:
        return "empty"
    claimed, sig = st.claim_table_delivery(session_id, exercise_name, body)
    if not claimed and not entry and _inplace_stale(st, session_id,
                                                    exercise_name, body):
        # Delivered once, but the in-place message has since been edited to
        # other rows (undo / re-log): re-showing it is an edit, not a repeat.
        claimed = True
    if not claimed:
        # G4: a repeat is not a second bubble. Say so on stdout -- silence here
        # would read as "the table was never rendered" to anyone reading the
        # log, which is the confession the F14 suite exists to prevent.
        print("SET_TABLE delivered=no reason=duplicate sig=%s" % sig)
        return "duplicate"
    try:
        ok, detail = st.deliver_table(body, session_id, exercise_name,
                                      inplace=True, fresh=entry)
    except Exception as e:  # noqa: BLE001 -- a send miss is never a crash
        ok, detail = False, "deliver_raised:%s" % type(e).__name__
    if ok:
        print("SET_TABLE delivered=yes by=code sig=%s" % sig)
        return "sent"
    if detail == getattr(st, "EDIT_UNCERTAIN", None):
        # The claim stays (same reasoning as a failed send). The next set
        # boundary edits the same message again, so a lost edit heals.
        print("SET_TABLE delivered=uncertain reason=%s sig=%s -- do not "
              "restate the table" % (detail, sig))
        return detail
    try:
        st.release_table_delivery(session_id, exercise_name, body)
    except Exception:  # noqa: BLE001 -- older set-table: claim stays
        pass
    print("SET_TABLE delivered=no reason=%s sig=%s" % (detail, sig))
    print("SET_TABLE fallback=defenced")
    try:
        for _ln in st.defence_table(body):
            print(_ln)
    except Exception:  # noqa: BLE001 -- last resort: never drop the rows
        print(body)
    return detail


