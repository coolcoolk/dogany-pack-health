# F14 AS A GATE, NOT A SENTENCE (2026-09-11).
#
# F14 (owner 2026-08-14) has TWO clauses and only one of them was ever built:
#
#   1. 준비운동 먼저 -- 하나씩 순차 안내                     <- built 2026-08-27
#      (set-arm.prep_lane_open closes the ramp/working ARM lane)
#   2. 준비운동이 모두 닫힌 뒤에 비로소 그 종목의
#      **set-table + 워킹 큐 블록**을 전달한다               <- NEVER built
#
# Clause 2 names the TABLE, and this file publishes the table STRUCTURALLY at
# entry -- "before warmup/cues", by its own header's design. So the arm was
# suppressed and the table went out anyway. Owner, live 2026-09-11 06:2x:
# 「운동시작했는데 냅다 데드리프트 표 던지네 매트프렙 차례인데 / 내가 이럴줄알았다」.
#
# SKILL.md carried clause 2 as prose and claimed a mechanism for it -- "set_seq
# ==1 게이트는 첫 워킹세트에서만 발화 -> prep 드릴(set_seq<=0)은 자연히 그 앞에
# 위치". That mechanism gates the SET, not the TABLE. Prose describing a
# mechanism that does not exist is the 2026-08-14 timer lesson exactly: what
# must happen goes in a deterministic carrier.
#
# WHICH DRILLS COUNT. The ENTRY phases only (mat_prep + equipment_prep + any
# unknown phase, which extract_prep_plan keeps fail-visible in `entry`).
# immediate_primer is F14's own documented EXCEPTION -- it is deliberately
# deferred to AFTER 큐+세트표+웜업/램프 -- so counting it would gate the table on
# a drill that is supposed to come after the table. set-arm's arm gate counts
# the whole band, and correctly: the primer must land before working set 1.
# Two gates, two bands, both matching the rule they enforce.
#
# FAIL-OPEN, matching set-arm.prep_lane_open byte for byte in policy: no prep
# planned and an unreadable plan BOTH publish. A prep.yaml miss must never be
# the reason the owner cannot see their set table.
# ---------------------------------------------------------------------------
def entry_prep_band_state(st, db_path, session_id, exercise_name, slot):
    """(planned, logged) over the ENTRY-PHASE prep band for this slot.

    planned -- len(extract_prep_plan(slot)["entry"]). The SAME list this file
      prints as PREP_ENTRY lines, so the gate can never count drills the owner
      was not shown.
    logged  -- prep-band rows sitting in the entry-phase seq window. Prep seqs
      are assigned by set-table.prep_plan_ordered in PREP_PHASE_ORDER, and
      mat_prep/equipment_prep sort ahead of immediate_primer, so the entry
      drills are exactly the first `planned` seqs: PREP_SEQ_BASE down to
      PREP_SEQ_BASE-(planned-1). Derived from the ordering SoT rather than
      re-declared here.

    Best-effort: any miss -> (0, 0), which reads as "no entry prep planned" and
    therefore publishes (see the fail-open note above)."""
    try:
        planned = len(extract_prep_plan(slot).get("entry") or [])
        if planned <= 0:
            return 0, 0
        base = st.PREP_SEQ_BASE
        floor_seq = base - (planned - 1)
        conn = sqlite3.connect(db_path)
        try:
            row = conn.execute(
                "SELECT COUNT(*) FROM workout_sets WHERE session_id = ? "
                "AND exercise_name = ? AND set_seq <= ? AND set_seq >= ?",
                (session_id, exercise_name, base, floor_seq)).fetchone()
        finally:
            conn.close()
        return planned, int(row[0]) if row and row[0] is not None else 0
    except Exception:  # noqa: BLE001 -- an unreadable plan never closes the gate
        return 0, 0


def entry_table_gate_open(st, db_path, session_id, exercise_name, slot):
    """Is the (2) set-table publish allowed for this entry right now?

    Returns (open, reason, planned, logged). `reason` is a stable audit token,
    never owner-facing:
        no_prep_planned  -- this slot declares no entry-phase prep (fail-open)
        prep_complete    -- every entry-phase drill has a row
        prep_incomplete  -- the band is short; the table is HELD
    """
    planned, logged = entry_prep_band_state(st, db_path, session_id,
                                            exercise_name, slot)
    if planned <= 0:
        return True, "no_prep_planned", planned, logged
    if logged >= planned:
        return True, "prep_complete", planned, logged
    return False, "prep_incomplete", planned, logged


def format_prep_plan(plan, session_id=None, exercise_name=None, slot_num=None,
                     st=None):
    """#10/#11/#26: render the ordered prep plan as machine lines the model
    echoes. Two labeled sections so the model presents entry drills now and
    DEFERS immediate-primers to just before the first working set. Returns a
    list of lines (possibly empty). Never raises.

    Format (parseable, one drill per line under a section header):
        PREP_PLAN entry=<n> immediate_primer=<m> logged_as=sets
        PREP_ENTRY code=K1 phase=equipment_prep target_reps=10 display="..."
        PREP_SET p1 seq=-100 kind=prep target=20 unit=reps
                 keyboard=completion_tap cue=exercise_target volume=no
        PREP_DONE_TAP p1 keyboard=completion_tap -- ONE completion button
        PREP_SET_CMD p1 set-add <sid> <ex> <slot> -100 20 --set-kind prep
                 --target-reps 20
        PREP_IMMEDIATE code=K4 phase=immediate_primer hold_sec=15 display="..."
    The IMMEDIATE lines are explicitly flagged DEFER so the model never front-
    loads them (that was the #26 live failure).

    A3/D1 -- THE PREP_SET / PREP_SET_CMD PAIR. Ruling, 2026-08-25 06:28 and
    again 07:06: each mat-prep drill must be treated as a set, with a
    progress-table row and a proper cue. Every prep drill is now a row in the prep band
    (set-table PREP_SEQ_BASE), and these two lines are what make that
    deterministic rather than a rule the model has to remember:
      PREP_SET      the derived shape of this drill AS A SET -- its stored
                    set_seq, its label, its target, and the keyboard/cue shape
                    READ FROM the derivation table (set-table
                    SET_KIND_DERIVATION), never re-decided here.
      PREP_SET_CMD  the literal set-add argv that logs it. The model runs it; it
                    does not compose it. A composed call is a call that can be
                    skipped under pressure, and 21 minutes of prep work went
                    unlogged on 2026-08-25 for exactly that reason.

    THE KEYBOARD IS A SINGLE COMPLETION TAP (owner ruling 2026-08-27; the
    derivation table's prep row now reads `completion_tap`). A3 originally gave
    prep the reps drilldown "like any other set" -- one pipeline, one keyboard.
    That was right about the pipeline and wrong about the keyboard: reps are
    collected to MEASURE VOLUME, and volume is worth measuring on a WORKING set
    because a working set is a challenge set whose outcome genuinely varies.
    Prep is prescribed on the assumption of completion, so a rep drilldown asks
    the owner something already known; and when a prep drill cannot be
    completed, that is a PRESCRIPTION DEFECT -- the prescription was set too
    high -- not a data point to log low.

    So each drill emits PREP_DONE_TAP: exactly one completion button, no
    candidate numbers. This is NOT the old `1. 완료` single-option MENU -- that
    was a zero-decision round trip that offered nothing AND recorded nothing.
    The tap runs PREP_SET_CMD, whose prescribed value is already baked in, so
    one tap is both the acknowledgement and the row.

    session_id / exercise_name / slot_num / st are optional: without them the
    PREP_SET / PREP_SET_CMD lines are omitted and the output is byte-identical
    to the pre-A3 plan (the shape every existing caller and test sees)."""
    entry = plan.get("entry") or []
    primers = plan.get("immediate_primer") or []
    if not entry and not primers:
        return []
    can_set = (st is not None and session_id is not None
               and exercise_name is not None and slot_num is not None)
    head = "PREP_PLAN entry=%d immediate_primer=%d" % (len(entry), len(primers))
    if can_set:
        head += " logged_as=sets band=prep"
    lines = [head]
    # The stored seq runs across the WHOLE slot plan (entry drills then
    # primers) in performance order, so p-numbers never collide.
    order = [(d, False) for d in entry] + [(d, True) for d in primers]
    seq_of = {}
    if can_set:
        for idx, (d, _defer) in enumerate(order):
            seq_of[id(d)] = st.prep_seq(idx)
    # THE ZONE SUMMARY, on the plan header. Owner, 2026-09-11: 「랫풀다운은
    # 매트프렙이아닌데 구분이 전혀안돼있네」 -- three drills read 준비운동 1/2/3
    # and one of them is at a machine across the gym. Counting the zones here
    # lets the overview list say so in its first line instead of the owner
    # finding out when he stands up.
    _zc = {}
    for d, _ in order:
        z = d.get("zone")
        if z:
            _zc[z] = _zc.get(z, 0) + 1
    if _zc:
        lines[0] += " zones=" + ",".join(
            "%s:%d" % (k, _zc[k]) for k in sorted(_zc))

    # THE MOVE, announced BEFORE the drill that requires it -- not discovered
    # at the drill. `prev_zone` walks the whole plan in performance order
    # (entry then primers), which is the order the seqs were assigned in above,
    # so a PREP_ZONE_MOVE always sits between the two drills it separates.
    prev_zone = [None]

    def _zone_move_lines(d):
        z = d.get("zone")
        if not z:
            return []
        out_ = []
        if prev_zone[0] is not None and z != prev_zone[0]:
            frm = _zone_label(prev_zone[0]) or prev_zone[0]
            to = _zone_label(z) or z
            req = d.get("requires") or []
            req_tok = (" requires=" + ",".join(str(r) for r in req)) if req \
                else ""
            out_.append('PREP_ZONE_MOVE from=%s to=%s before=%s%s '
                        'say="%s존 -> %s존으로 이동"'
                        % (prev_zone[0], z, d.get("code"), req_tok, frm, to))
        prev_zone[0] = z
        return out_

    for d in entry:
        lines.extend(_zone_move_lines(d))
        lines.append("PREP_ENTRY " + _prep_kv(d))
        lines.extend(_prep_cue_lines(d))
        lines.extend(_prep_set_lines(d, seq_of.get(id(d)), session_id,
                                     exercise_name, slot_num, st))
    for d in primers:
        lines.extend(_zone_move_lines(d))
        # DEFER marker: this drill fires ONLY right before the first working set.
        lines.append("PREP_IMMEDIATE defer=first_working_set " + _prep_kv(d))
        lines.extend(_prep_cue_lines(d))
        lines.extend(_prep_set_lines(d, seq_of.get(id(d)), session_id,
                                     exercise_name, slot_num, st))
    return lines


# ---------------------------------------------------------------------------
# TABLES (0) / (0-E) -- the prep progress tables, rendered by CODE (2026-10-02).
#
# Until now progress-tables.md asked the MODEL to draw both tables from
# PREP_ENTRY rows (0-E) and from stretch-matrix prose (0). Owner 2026-10-02:
# header line, ONE blank line, then the rows, in the one session marker set.
# A shape the model has to remember is a shape that drifts, so the code emits
# the finished table and the model relays it:
#
#     PREP_TABLE kind=mat done=2/4
#     ```
#     🧘 매트 준비운동 · 2/4
#
#     [v] 발목 도르시플렉션
#     [ ] 밴드 니-아웃
#     ```
#
# SOURCES, both already the live ones (no new data path):
#   mat        set-table.session_prep_drills -- the same list the pin's prep
#              cell and set-add's next-drill cue count; done = the session-level
#              prep rows at prep_seq(i), exactly as set-add reads them.
#   equipment  this slot's ENTRY plan (extract_prep_plan -- the PREP_ENTRY
#              lines) minus its mat_prep drills; done = this exercise's row at
#              the drill's prep_seq, numbered as format_prep_plan numbers it.
#              PREP_IMMEDIATE stays out (progress-tables.md (0-E)).
# Emitted at entry (do_enter) and after every prep row (set-add ->
# `exercise-enter --prep-table`). Renderer: card_lib.render_prep_table.
# ---------------------------------------------------------------------------
PREP_TABLE_KINDS = ("mat", "equipment")


def _logged_prep_seqs(db_path, session_id, exercise_name=None, st=None):
    """set_seq values of this session's prep-band rows -- session-level rows
    when exercise_name is None, else that exercise's rows. Empty on a miss."""
    try:
        base = st.PREP_SEQ_BASE if st is not None else -100
        conn = sqlite3.connect(db_path)
        try:
            if exercise_name is None:
                sql_scope = (st.SESSION_SLOT_SQL if st is not None
                             else "(slot_num IS NULL OR slot_num = 0)")
                rows = conn.execute(
                    "SELECT set_seq FROM workout_sets WHERE session_id = ? "
                    "AND " + sql_scope + " AND set_seq <= ?",
                    (session_id, base)).fetchall()
            else:
                rows = conn.execute(
                    "SELECT set_seq FROM workout_sets WHERE session_id = ? "
                    "AND exercise_name = ? AND set_seq <= ?",
                    (session_id, exercise_name, base)).fetchall()
        finally:
            conn.close()
        return {int(r[0]) for r in rows if r[0] is not None}
    except Exception:  # noqa: BLE001 -- unreadable -> nothing done yet
        return set()


def prep_table_rows(kind, st, rx, db_path, program_path, session_id,
                    exercise_name, day_code, slot):
    """[(display, done, dose)] for table (0) (kind='mat') or (0-E) ('equipment')."""
    if kind == "mat":
        drills = st.session_prep_drills(rx, program_path, day_code) or []
        done = _logged_prep_seqs(db_path, session_id, None, st)
        return [(d.get("display") or d.get("code"), st.prep_seq(i) in done,
                 _prep_dose(st, d))
                for i, d in enumerate(drills)]
    plan = extract_prep_plan(slot or {})
    order = list(plan.get("entry") or []) + list(
        plan.get("immediate_primer") or [])
    entry_ids = {id(d) for d in plan.get("entry") or []}
    done = _logged_prep_seqs(db_path, session_id, exercise_name, st)
    out = []
    for i, d in enumerate(order):
        if id(d) not in entry_ids:
            continue                       # PREP_IMMEDIATE: not on (0-E)
        if d.get("phase") == st.PREP_PHASE_MAT:
            continue                       # mat drills belong to table (0)
        out.append((d.get("display") or d.get("code"), st.prep_seq(i) in done,
                    _prep_dose(st, d)))
    return out


def _prep_dose(st, drill):
    """The row's dose text from the owner-stated prescription ('' if none)."""
    cl = _card_lib()
    try:
        return cl.prep_dose_text(st.prep_target_spec(drill)) if cl else ""
    except Exception:  # noqa: BLE001 -- a dose never breaks the table
        return ""


def _prep_nav(kind, slots, slot_i):
    """Footer of a prep table, the set table's grammar (owner 2026-10-02 11:21:
    "이전/다음 종목도 보여줬으면해 세트 진행표랑 비슷하게"): '◂ <prev>' and
    '▸ <next>' by program slot order. Mat prep runs before slot 1, so it has
    no prev and its next is the first lift; a lift's prep sits between the
    previous lift and that lift."""
    slots = slots or []

    def disp(x):
        return (x or {}).get("display") or (x or {}).get("name") or ""
    out = []
    if kind == "mat":
        if slots:
            out.append("\u25b8 %s" % disp(slots[0]))
        return out
    try:
        i = int(slot_i or 0)
    except (TypeError, ValueError):
        i = 0
    if i > 1 and i - 2 < len(slots):
        out.append("\u25c2 %s" % disp(slots[i - 2]))
    if 1 <= i <= len(slots):
        out.append("\u25b8 %s" % disp(slots[i - 1]))
    return [ln for ln in out if ln.strip() not in ("\u25c2", "\u25b8")]


def prep_table_block(kind, rows, exercise_ko=None, nav=None):
    """The machine head line + the fenced table, or [] when there is no row."""
    cl = _card_lib()
    body = cl.render_prep_table(kind, rows, exercise_ko) if cl else []
    if not body:
        return []
    if nav:
        body = body + [""] + list(nav)
    done = sum(1 for r in rows if r[1])
    return (["PREP_TABLE kind=%s done=%d/%d" % (kind, done, len(rows)), "```"]
            + body + ["```"])


def do_prep_table(db_path, program_path, session_id, exercise_name, kind):
    """`--prep-table mat|equipment`: print the current table (0) / (0-E).
    Exit 0 always (best-effort); prints nothing when that table has no rows."""
    try:
        st = _load_module("set_table", "set-table")
        rx = st.load_rx_calc()
        program = rx.load_yaml(program_path)
        day_code, slots_all, slot, slot_i, _n = st.find_day_and_slot(
            program, db_path, session_id, exercise_name, rx=rx)
        if isinstance(slot, dict) and day_code and kind == "equipment":
            slot = dict(slot)
            slot["prep_drills"] = st.slot_prep_drills(
                rx, program_path, day_code, slot.get("slot"))
        rows = prep_table_rows(kind, st, rx, db_path, program_path,
                               session_id, exercise_name, day_code, slot)
        ex_ko = card_base_name((slot or {}).get("display")
                               or exercise_name) if kind == "equipment" \
            else None
        for line in prep_table_block(kind, rows, ex_ko,
                                     _prep_nav(kind, slots_all, slot_i)):
            print(line)
    except Exception as e:  # noqa: BLE001 -- a table miss never breaks a set
        print("WARN prep table failed: %s" % e, file=sys.stderr)
    return 0


def _prep_cue_lines(drill):
    """The drill's cue, one line per declared key, VERBATIM from prep.yaml.

        PREP_CUE code=<code> setup="..."
        PREP_CUE code=<code> sensation="..."

    ABSENT STAYS ABSENT and emits NOTHING -- a drill with no recorded cue says
    nothing about how it should feel, which is the honest answer. The model
    echoes these; it does not compose them, does not paraphrase them, and does
    not generate one for a drill that has none. An invented sensation on a
    rehab drill is worse than silence: it is a confident instruction about a
    joint that is already hurt.

    Rendered as separate lines rather than folded into PREP_ENTRY because a cue
    is a SENTENCE and PREP_ENTRY is a key=value line the model parses -- a
    sentence with its own spaces and punctuation belongs on its own line."""
    cue = drill.get("cue")
    if not cue and drill.get("howto"):
        cue = {"setup": drill["howto"]}
    if not isinstance(cue, dict):
        return []
    out = []
    for key in ("setup", "sensation"):
        val = cue.get(key)
        if not isinstance(val, str) or not val.strip():
            continue
        out.append('PREP_CUE code=%s %s="%s"'
                   % (drill.get("code"), key,
                      val.strip().replace('"', "'")))
    return out


def _prep_set_lines(drill, seq, session_id, exercise_name, slot_num, st):
    """The PREP_SET + PREP_SET_CMD pair for one drill, or [] when the caller
    supplied no session context. Every derived field is a TABLE LOOKUP
    (st.derive_set_kind) -- there is no if/elif here deciding what a prep set
    gets, which is the whole point of the derivation table."""
    if st is None or seq is None:
        return []
    try:
        row = st.derive_set_kind(st.SET_KIND_PREP)
        label = st.seq_label(seq)
        spec = st.prep_target_spec(drill)
    except Exception:  # noqa: BLE001 -- a prep line must never block entry
        return []
    target = spec["value"]
    hold = spec["hold_sec"]
    # The target is stated or it is `?`. Never defaulted -- see prep.yaml's
    # target_reps schema note (the 헤일로 6kg lesson). The token now carries the
    # UNIT with the number (10/side, 1round, 2x15s), because `target_reps` is one
    # integer column holding four incompatible units and the bare integer is the
    # thing that got coerced (a one-ROUND circuit stored as reps=1).
    target_tok = spec["token"]
    out = [
        # `code=` rides this line too (2026-08-27): the target token and its
        # unit are only meaningful next to WHICH drill they prescribe, and the
        # code used to live one line up, on PREP_ENTRY.
        "PREP_SET %s seq=%d code=%s kind=%s target=%s unit=%s keyboard=%s "
        "cue=%s volume=%s"
        % (label, seq, drill.get("code"), row["set_kind"], target_tok,
           spec["unit"], row["keyboard_kind"], row["cue_shape"],
           "yes" if row["counts_toward_volume"] else "no"),
    ]
    # THE AFFORDANCE, STATED (owner ruling 2026-08-27). The keyboard cell in the
    # derivation table is now `completion_tap`, and this line is what makes that
    # cell reach the reply: ONE button, no candidate rep numbers, no count
    # question. Prep is prescribed on the assumption of completion, so the count
    # is already known; and a drill that could not be completed is a PRESCRIPTION
    # DEFECT, not data -- logging a lower number would launder the defect into
    # the volume trend.
    if row["keyboard_kind"] == getattr(st, "KEYBOARD_COMPLETION_TAP",
                                       "completion_tap"):
        out.append(
            "PREP_DONE_TAP %s keyboard=%s -- render ONE completion button "
            "for this drill (a single-item options block) and nothing else. "
            "Do NOT ask how many reps, "
            "do NOT offer a rep drilldown, do NOT list numbers. The prescribed "
            "value IS the recorded value; the tap runs PREP_SET_CMD verbatim."
            % (label, row["keyboard_kind"]))
    if spec["value"] is not None and not spec["unit_declared"]:
        # Fail-VISIBLE: a stated number whose unit prep.yaml never declared. It
        # is being read as total reps; say so, rather than let a round count
        # pass silently as a rep count for a second time.
        out.append("PREP_UNIT_UNDECLARED %s code=%s -- prep.yaml states "
                   "target_reps=%s but no target_unit; reading it as total "
                   "reps. Record the gap as a post-session item; do NOT "
                   "interrupt the session over it."
                   % (label, drill.get("code"), spec["value"]))
    # set-add's real signature is POSITIONAL:
    #   set-add <session_id> <exercise_name> <slot_num> <set_seq> [reps]
    # A negative set_seq passes through argparse unquoted because no option in
    # set-add starts with a digit. Emitting the literal argv (rather than a
    # description of it) is the point: the model runs this line, it does not
    # assemble one.
    #
    # BUILT BY set-table.prep_set_argv, not here -- set-arm emits the same
    # command for the NEXT drill after one lands, and two builders drift into
    # two different stored rows. The old local build also emitted a literal
    # `<보고받은 횟수>` placeholder when a drill had no stated target, which is
    # an instruction to ASK; the ruling removes it.
    cmd = st.prep_set_argv(session_id, exercise_name, slot_num, seq, drill)
    out.append("PREP_SET_CMD %s %s" % (label, " ".join(cmd)))
    if target is None and hold is None:
        # Fail-VISIBLE: the drill has no owner-stated target anywhere. The
        # table shows `?`; this names it so it can be closed rather than
        # silently carried forever.
        #
        # 2026-08-27 -- THIS LINE NO LONGER TELLS THE MODEL TO ASK. It used to
        # end "Ask the owner ONCE and write the number to prep.yaml", and the
        # agent obeyed it: it stopped MID-PREP, in the middle of a live session,
        # to ask for a rep target. The skill already carries the opposite rule
        # ("세션 진행 중에는 그 자리에서 되묻지 않는다") -- but that rule sits
        # ~1,200 lines away in a prompt file while THIS arrives inline in tool
        # output, and inline wins. So the instruction is removed at the source
        # rather than argued with downstream.
        #
        # The SIGNAL is unchanged: the token, the label and the code= field keep
        # their shape (SKILL.md's A3 suppression list keys on the token). Only
        # the instruction changed -- proceed without a stated count, and leave
        # the gap as a POST-SESSION item. Still never invent a number: that is
        # the 헤일로 "원판 6kg" defect and it is not what changed here.
        out.append("PREP_TARGET_MISSING %s code=%s -- prep.yaml has no "
                   "target_reps for this drill; the REPS cell renders '?'. "
                   "Run the drill WITHOUT stating a count and record the gap as "
                   "a post-session item; do NOT interrupt the session over it "
                   "and do NOT invent a number." % (label, drill.get("code")))
    return out


def extract_cooldown_plan(slot):
    """2026-08-22 blocks: read the slot's `cooldown_drills` (hydrated from
    prep.yaml's cooldown block) and return them in declaration order.

    Cooldown is a PEER of prep and work, but it has NO phase split -- a
    cooldown drill pinned to a slot is performed right after that slot's last
    set, so there is nothing to defer. Never raises; no cooldown_drills -> [].

    NOT A SET. A cooldown drill is display-only: it creates no workout_sets
    row (set-arm's resolve_hold_slot_num returns None for a non-slot exercise)
    and never enters a volume aggregate (rx-calc NON_VOLUME_KINDS)."""
    drills = (slot or {}).get("cooldown_drills")
    if not isinstance(drills, list):
        return []
    out = []
    for d in drills:
        if not isinstance(d, dict):
            continue
        item = {
            "code": d.get("code"),
            "phase": d.get("phase"),
            "display": d.get("display"),
        }
        if d.get("hold_sec") is not None:
            item["hold_sec"] = d.get("hold_sec")
        out.append(item)
    return out


def format_cooldown_plan(items):
    """Render the slot's cooldown drills as machine lines, mirroring
    format_prep_plan:

        COOLDOWN_PLAN entry=<n>
        COOLDOWN_ENTRY code=HP1 phase=cooldown display="..."

    Empty list -> NO lines at all (not a zero-count header), so a slot with no
    pinned cooldown is byte-identical to the pre-cooldown output. That is the
    case for every slot today."""
    if not items:
        return []
    lines = ["COOLDOWN_PLAN entry=%d" % len(items)]
    for d in items:
        lines.append("COOLDOWN_ENTRY " + _prep_kv(d))
    return lines


def _ui_labels():
    """The shared owner-facing label resolver, or None in a tree without it.
    Same degrade shape set-arm._ui_labels uses -- an absent module never blocks
    an entry."""
    try:
        if HERE not in sys.path:
            sys.path.insert(0, HERE)
        import ui_labels
        return ui_labels
    except Exception:  # noqa: BLE001 -- absent module is a degrade, not an error
