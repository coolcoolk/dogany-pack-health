                   help="deliver the machine confirm ask to the owner by code "
                        "(set-arm machine-ask) and print its receipt instead "
                        "of the MACHINE_ASK lines. set-add's auto-enter passes "
                        "it: the button rail runs no model turn.")
    args = p.parse_args(argv)

    db_path = os.path.abspath(args.db)
    _use_tax_db(db_path)   # bind the muscle taxonomy to THIS run's db
    from free_session import effective_path
    program_path = effective_path(os.path.abspath(args.program), db_path, args.session_id)
    if not os.path.exists(db_path):
        print("ERROR: db not found: %s" % db_path, file=sys.stderr)
        return 1
    if not os.path.exists(program_path):
        print("ERROR: program.yaml not found: %s" % program_path,
              file=sys.stderr)
        return 1

    if args.prep_table:
        return do_prep_table(db_path, program_path, args.session_id,
                             args.exercise_name, args.prep_table)
    if args.refresh_card:
        return do_refresh_card(db_path, program_path, args.session_id,
                               args.exercise_name)
    if args.publish_table:
        return do_publish_table(db_path, program_path, args.session_id,
                                args.exercise_name)
    exercise_name = fatigue_swap_redirect(args.session_id, args.exercise_name)
    return do_enter(db_path, program_path, args.session_id, exercise_name,
                    args.force, args.no_table,
                    deliver_machine_ask=args.deliver_machine_ask)


def fatigue_swap_redirect(session_id, exercise_name):
    """Muscle-fatigue swap package (worklog 2026-09-26, phase 2, owner 11:29).

    When the user took the session-start swap package, entering a planned
    exercise that was swapped ENTERS THE SUBSTITUTE instead -- the entry is
    where the swap becomes real, so it is decided here, not remembered by the
    model. The one-tap way back rides the same output:
        FATIGUE_SWAP\t<planned>\t<substitute>
        FATIGUE_SAY\t<one line, verbatim>
        FATIGUE_CHOICE\t<the "back to the original" button label>
    The tap runs `fatigue-brief revert` and re-enters the planned name.
    No package / reverted / any error -> the name unchanged, nothing printed
    (byte-identical to the pre-fatigue entry)."""
    try:
        import importlib.machinery
        import importlib.util
        path = os.path.join(HERE, "fatigue-brief")
        if not os.path.exists(path):
            return exercise_name
        loader = importlib.machinery.SourceFileLoader("fatigue_brief_enter",
                                                      path)
        spec = importlib.util.spec_from_loader(loader.name, loader)
        fb = importlib.util.module_from_spec(spec)
        loader.exec_module(fb)
        slot = fb.slot_move(STATE_DIR, session_id, exercise_name)
    except Exception as exc:  # noqa: BLE001 -- entry never fails on this
        print("[exercise-enter] fatigue swap lookup skipped: %s" % exc,
              file=sys.stderr)
        return exercise_name
    if not slot.get("planned"):
        return exercise_name
    print("FATIGUE_SWAP\t%s\t%s" % (slot["planned"], slot["exercise"]))
    print("FATIGUE_SAY\t%s" % slot["say"])
    print("FATIGUE_CHOICE\t%s" % slot["choices"][0]["label"])
    return slot["exercise"]


