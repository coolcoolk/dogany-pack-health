def _dwidth(s):
    """Monospace/CJK display width. REUSES health_dashboard._disp_width (hangul
    and East-Asian-Ambiguous glyphs count 2). Falls back to len() only when the
    shared lib is unavailable -- a degraded width, never a second width model."""
    hd, _hm = _health_lib()
    if hd is not None:
        try:
            return hd._disp_width(s)
        except Exception:  # noqa: BLE001
            pass
    return len(str(s))


def _pad_to(s, width, align="l"):
    """Pad `s` out to `width` DISPLAY cells with plain ASCII spaces.

    For HANGUL columns (종목명, 부위). The pin body is a code block (DGN-974), so
    the surface is monospace: one ASCII space == one cell, one hangul glyph ==
    two cells (_dwidth), and `gap` spaces close the column exactly. See CARD_PAD
    for why this is no longer U+3000."""
    s = str(s)
    gap = width - _dwidth(s)
    if gap <= 0:
        return s
    pad = CARD_PAD * gap
    return (pad + s) if align == "r" else (s + pad)


def _narrow_width(s):
    """Display width with AMBIGUOUS-width glyphs counted as ONE cell.

    _dwidth (health_dashboard._disp_width) counts East-Asian-Ambiguous as 2,
    which is right for a proportional CJK chat bubble but wrong inside the pin's
    monospace <pre>, where the 볼륨 figures' narrow glyphs ('≈', digits, ',',
    'kg') each take exactly one cell. Truly WIDE glyphs (hangul/CJK, class W/F)
    still count 2, so a hangul CAPTION lines up with its ASCII figures."""
    try:
        import unicodedata
        return sum(2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
                   for ch in str(s))
    except Exception:  # noqa: BLE001 -- width math must never break the card
        return len(str(s))


def _pad_ascii(s, width, align="r"):
    """Pad a FIGURE column (the 볼륨 values: digits, ',', 'kg', '≈') to `width`
    cells with plain spaces, measured by _narrow_width.

    Width is counted in DISPLAY cells, not characters: the column's caption
    ("볼륨") is hangul and occupies two cells per glyph, so a len()-based pad
    pushed the caption row two cells right of its own figures (visible the
    moment the pin became a real monospace block). For a pure-ASCII value
    _narrow_width == len, so the figures themselves are unchanged."""
    s = str(s)
    gap = width - _narrow_width(s)
    if gap <= 0:
        return s
    return ((" " * gap) + s) if align == "r" else (s + (" " * gap))


def _fmt_thousands(v):
    """Volume figure with a thousands separator (locked 볼륨 column format)."""
    try:
        return "{:,}".format(int(round(float(v or 0))))
    except (TypeError, ValueError):
        return str(v)


