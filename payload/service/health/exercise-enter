# Progress markers (표3 종목카드 rows). ONE marker set across every session
# table (owner 2026-10-02): the set-table style, ASCII --
#   [v] = 완료(done)   [>] = 진행중(current)   [ ] = 예정(upcoming)
#   [-] = 미완료로 넘어감(passed: the session moved past it unfinished)
# AT MOST ONE [>] (owner ruling 2026-10-02: two items both shown in progress is
# wrong): only the exercise currently entered is in progress. An earlier
# item left partial -- mat prep 2/4 once a lift has started, a lift 2/4 once
# another is entered -- is [-], value line kept.
# Read from card_lib so the lineup pin, the closeout card and the prep tables
# cannot drift apart. (The 2026-08-14 ✓ / ▸ / · glyphs are retired.)
# The card row updates on every set-add so the pinned card reflects LIVE
# per-set state (recomputed from workout_sets, not model-typed).
_CL = _card_lib()
CARD_DONE_MARK = getattr(_CL, "MARK_DONE", "[v]")
CARD_CURRENT_MARK = getattr(_CL, "MARK_CURRENT", "[>]")
CARD_UPCOMING_MARK = getattr(_CL, "MARK_PENDING", "[ ]")
CARD_PASSED_MARK = getattr(_CL, "MARK_PASSED", "[-]")


def card_progress_line(work_sets, total_sets, current_weight):
    """Render the per-set progress row for the 종목카드 (표3): one glyph per
    working set on the SAME line -- ✓ for each done set, ▸ (with weight+set
    number) for the current set, · for each upcoming set.

    work_sets   = logged WORKING sets (set_seq>=1) as returned by set-table's
                  fetch_current_sets (list of dicts, ascending set_seq).
    total_sets  = today's prescribed working-set count (rx-calc trimmed) -- the
                  same single source set-table renders its planned rows from.
    current_weight = target weight for the current set (rx prescription), used
                  only to annotate the ▸ marker. None -> no weight annotation.

    Returns a single string (never raises). Returns None when total_sets is
    unknown/<=0 (no meaningful per-set grid to draw)."""
    try:
        total = int(total_sets or 0)
    except (TypeError, ValueError):
        total = 0
    if total <= 0:
        return None
    done = len(work_sets or [])
    if done > total:
        # More sets logged than prescribed (owner added sets): show them all
        # done and no upcoming, so the marker count never lies.
        total = done
    cells = []
    for n in range(1, total + 1):
        if n <= done:
            cells.append(CARD_DONE_MARK)
        elif n == done + 1:
            # Current set: annotate with target weight + set number.
            if current_weight is not None:
                cells.append("%s%skg·%d" % (CARD_CURRENT_MARK,
                                            _fmt_num(current_weight), n))
            else:
                cells.append("%s%d" % (CARD_CURRENT_MARK, n))
        else:
            cells.append(CARD_UPCOMING_MARK)
    return "  " + " ".join(cells)


