    back's children) reads `등`, while a day that only does a seated calf raise
    keeps `가자미` -- because 비복 was not trained and "종아리" would overclaim.

    ORDER: descending CONTRIBUTION, where a subregion contributes
    `weight x planned sets`. Planned sets are what makes the order reflect the
    session's actual emphasis rather than its exercise count -- a 4-set RDL
    outranks a 3-set curl. Ties fall back to the coarse GROUP_ORDER so the line
    is stable run to run.

    LEVEL: 초급 collapses everything to the coarse 6-group names (the level-axis
    rule); 중급+ (and the no-level default) gets the rolled-up sub-muscles."""
    rows = _card_muscle_rows(db_path, exercise_names)
    if not rows:
        return []
    sets_by = sets_by_exercise or {}
    from ui_labels import gate
    muscle_gate = gate("card.muscle_vocab", db_path, level_override=level)
    if not muscle_gate["visible"]:
        return []

    contrib = {}                      # subregion -> weighted contribution
    for ex, sr, _parent, wt in rows:
        n = sets_by.get(ex) or 1
        contrib[sr] = contrib.get(sr, 0.0) + wt * float(n)

    if muscle_gate["label_key"] == "muscle_coarse":
        # 초급: straight to the coarse 6 groups, no sub-muscle vocabulary.
        _hd, hm = _health_lib()
        agg = {}
        for sr, c in contrib.items():
            parent = CARD_SUBREGION_PARENT.get(sr)
            g = hm.coarse_group(parent) if hm is not None else parent
            agg[g] = agg.get(g, 0.0) + c
        ko = (hm.GROUP_KO if hm is not None else {})
        order = (hm.GROUP_ORDER if hm is not None else [])
        items = [(agg[g], -_card_rank(g, order), ko.get(g, g)) for g in agg]
        items.sort(key=lambda t: (-t[0], -t[1]))
        return [t[2] for t in items]

    trained = set(contrib)
    emitted, items = set(), []
    for sr, c in sorted(contrib.items(), key=lambda kv: -kv[1]):
        if sr in emitted:
            continue
        parent = CARD_SUBREGION_PARENT.get(sr)
        family = CARD_MUSCLE_CHILDREN.get(parent, {sr})
        if family <= trained:
            # every child of this parent is trained -> roll up
            emitted |= family
            items.append((sum(contrib[c2] for c2 in family), parent,
                          CARD_MUSCLE_KO.get(parent, parent)))
        else:
            emitted.add(sr)
            items.append((c, parent, CARD_SUBREGION_KO.get(sr, sr)))
    _hd, hm = _health_lib()
    order = (hm.GROUP_ORDER if hm is not None else [])
    items.sort(key=lambda t: (-t[0],
                             _card_rank(hm.coarse_group(t[1]) if hm else t[1],
                                        order)))
    return [t[2] for t in items]


def _card_rank(group, order):
    try:
        return order.index(group)
    except (ValueError, AttributeError):
        return len(order or ())


def card_primary_muscles(db_path, exercise_names):
    """{exercise -> [Korean 주동근 …]} for the per-row annotation.

    SOURCE: exercise_muscle role='primary' -- the COARSE muscle, which is the
    register the owner wrote their example in (`RDL · 햄스`). The sub-muscle axis
    stays on line 3; repeating 광배/승모 per row would make every 로우 row look
    different for no added meaning.

    MULTI-PRIMARY RANKING: several exercises carry two 주동근 (rdl -> glutes +
    hamstrings, bulgarian_split_squat -> glutes + quads). They are ranked by
    their strongest exercise_subregion contribution for THAT exercise, which is
    the data's own statement of which muscle drives the lift: rdl's hamstrings
    sits at weight 1.0 grade='group' against glute_max/med at 0.5 'even', so
    rdl ranks 햄스 first -- matching the owner's own example. grade='group'
    breaks a weight tie (it marks the whole-muscle driver). Nothing is dropped
    here: the CALLER decides how many to print, so the second 주동근 is always
    recoverable."""
    _use_tax_db(db_path)
    names = [n for n in (exercise_names or []) if n]
    if not names:
        return {}
    q = ",".join("?" * len(names))
    try:
        conn = sqlite3.connect(db_path)
        try:
            prim = conn.execute(
                "SELECT exercise_name, muscle FROM exercise_muscle "
                "WHERE role = 'primary' AND exercise_name IN (%s)" % q,
                names).fetchall()
            subs = conn.execute(
                "SELECT exercise_name, subregion, weight, grade "
                "FROM exercise_subregion WHERE exercise_name IN (%s)" % q,
                names).fetchall()
        finally:
            conn.close()
    except Exception:  # noqa: BLE001 -- no annotation rather than a broken card
        return {}
    strength = {}                     # (exercise, parent) -> (weight, is_group)
    for ex, sr, wt, grade in subs:
        parent = CARD_SUBREGION_PARENT.get(sr)
        if parent is None:
            continue
        cur = strength.get((ex, parent), (0.0, 0))
        cand = (float(wt or 0), 1 if grade == "group" else 0)
        if cand > cur:
            strength[(ex, parent)] = cand
    by_ex = {}
    for ex, muscle in prim:
        by_ex.setdefault(ex, []).append(muscle)
    out = {}
    for ex, muscles in by_ex.items():
        muscles.sort(key=lambda m: (-strength.get((ex, m), (0.0, 0))[0],
                                    -strength.get((ex, m), (0.0, 0))[1], m))
        out[ex] = [card_muscle_ko(m, db_path) for m in muscles]
    return out


def card_muscle_ko(muscle, db_path=None):
    """The SESSION cards' muscle label: the anatomy short register (2026-08-21
    lock -- 둔근 / 햄스 / 사두 / 이두 / 등 / 어깨).

    ui_labels.MUSCLE_PLAIN_KO (엉덩이 / 팔 앞쪽) is the PROGRAM card's register
    and never reaches a session card (owner 2026-10-02). A db without a short
    label falls back to the anatomy long register (ui_labels.muscle_ko), never
    to the plain words and never to the English key."""
    got = CARD_MUSCLE_KO.get(muscle)
    if got:
        return got
    try:
        from ui_labels import muscle_ko
        return muscle_ko(muscle, db_path)
    except Exception:  # noqa: BLE001
        return muscle


# --- display-name normalisation --------------------------------------------
# program.yaml display strings carry a trailing parenthetical written to at
# least five unrelated conventions:
#     불가리안 스플릿 스쿼트 (불스스)          nickname
#     인클라인 덤벨 컬 (이두 신장 편향)        stimulus note
#     스미스머신 시티드 카프레이즈 (가자미)     muscle name
#     RDL (루마니안 데드리프트)                acronym longhand
#     친업 (언더그립 풀업)                     synonym
# Ruling (2026-08-21): the parenthetical annotations were inconsistent; and on
# being shown a strip-only card, a per-exercise target region was still wanted.
# So the parenthetical is not deleted, it is REPLACED by ONE uniform,
# data-derived annotation: that exercise's 주동근. Every row then carries the
# same kind of fact, and no display string is hand-authored.
#
# WHY AT THE RENDER LAYER: rewriting program.yaml's display strings would move
# a data change through rx-calc / set-table / history / the model's own
# vocabulary. The card is the surface with the complaint, so the card fixes it.
# The strip is UNCONDITIONAL (any trailing `(...)`), because the annotation
# that replaces it is unconditional -- a rule that kept SOME parentheticals
# would reproduce exactly the inconsistency being fixed.
_CARD_PAREN_TAIL = re.compile(r"\s*\([^()]*\)\s*$")


def card_base_name(display):
    """program.yaml display string minus its trailing parenthetical."""
    s = str(display or "").strip()
    stripped = _CARD_PAREN_TAIL.sub("", s).strip()
    return stripped or s          # a name that is ONLY a parenthetical stays


def card_row_name(display, muscles_ko, style=None, max_muscles=None):
    """`<종목명> · <주동근>` -- the uniform per-row annotation.

    `style` picks the separator shape (CARD_ROW_ANNOT_STYLE default):
      "dot"   -> `RDL · 햄스`      "paren" -> `RDL (햄스)`      "none" -> `RDL`
    `max_muscles` caps how many 주동근 print (default CARD_ROW_ANNOT_MUSCLES);
    they arrive pre-ranked by card_primary_muscles."""
    base = card_base_name(display)
    style = style or CARD_ROW_ANNOT_STYLE
    cap = CARD_ROW_ANNOT_MUSCLES if max_muscles is None else max_muscles
    ms = [m for m in (muscles_ko or []) if m][:max(0, cap)]
    if not ms or style == "none":
        return base
    tag = " ".join(ms)
    return "%s (%s)" % (base, tag) if style == "paren" else "%s · %s" % (base,
                                                                        tag)


# Row annotation shape. "dot" + 1 muscle is the default: it is the shape the
# owner wrote their own example in, and it is the only combination that keeps the
# longest row (스미스머신 시티드 카프레이즈 + 종아리) inside the phone's ~40-cell
# code-block budget. See the width table in the 2026-08-21 card-retune report.
CARD_ROW_ANNOT_STYLE = "dot"
CARD_ROW_ANNOT_MUSCLES = 1
# Row VALUE line (무게 · 세트) indent, in cells. The value moved OFF the name
# line: with a uniform muscle annotation appended, `name + gutter + value` blew
# past 40 cells for the long names and the only ways back were truncating a
# 종목명 or dropping the annotation. A second, indented line costs one row and
# caps the widest line at the name row. 4 = the `[v] ` gutter, so the value
# starts under the first letter of the name (2026-10-02 marker set).
CARD_VALUE_INDENT = 4
# [진행] label for the session-level prep cell, and the unit its 진행 value is
# counted in. "매트 프렙" is not invented here -- prep.yaml's card_slot doc
# already names this exact surface's session-level block "0 매트 프렙" (as
# opposed to "E 장비 프렙", which is slot-bound and never reaches this cell --
# see is_session_prep). "드릴" mirrors the working rows' "세트" unit; there is
# no existing card-surface word for a prep item count to reuse instead.
CARD_SESSION_PREP_NAME = "준비운동"
CARD_SESSION_PREP_UNIT = "드릴"


def card_total_slots(work_slots, session_prep_total=0):
    """THE card denominator: how many cells the day is divided into.

    work_slots         = the program day's working slots (len of the lineup).
    session_prep_total = how many SESSION-level prep drills the day declares
                         (set-table.session_prep_drills). ANY number > 0 adds
                         exactly CARD_SESSION_PREP_CELLS (1) -- owner ruling
                         2026-09-10, option A. Zero adds nothing, so a day with
                         no mat prep renders byte-identically to before.

    render_lineup_card calls this ONCE and feeds the SAME number to
    card_progress_bar and to the `<done>/<total>` counter. Nothing else may
    compute a card denominator."""
    try:
        work_slots = int(work_slots or 0)
    except (TypeError, ValueError):
        work_slots = 0
    try:
        session_prep_total = int(session_prep_total or 0)
    except (TypeError, ValueError):
        session_prep_total = 0
    work_slots = max(0, work_slots)
    if work_slots <= 0:
        # No lineup -> no card at all (render_lineup_card returns None before
        # it gets here). A lone prep cell is not a session.
        return 0
    return work_slots + (CARD_SESSION_PREP_CELLS if session_prep_total else 0)


def card_session_prep_done(done, total):
    """Is the single mat-prep cell filled? ALL-OR-NOTHING: `done >= total`.

    The owner has not ruled on partial credit; this is a CHOSEN default (the
    bar may never show more finished than is true), stated as one rather than
    silently baked in."""
    try:
        total = int(total or 0)
        done = int(done or 0)
    except (TypeError, ValueError):
        return False
    return total > 0 and done >= total


def card_bar_cells_per_slot(total):
    """Cells per slot for a `total`-slot day. THE owner ruling, in one place.

    <= CARD_BAR_WIDE_MAX_SLOTS (7) -> 2 cells/slot, else 1. Nothing else in
    this codebase may branch on slot count to pick a scale: two copies of this
    rule is exactly how the bar and the denominator drift apart."""
    try:
        total = int(total or 0)
    except (TypeError, ValueError):
        return 0
    if total <= 0:
        return 0
    return (CARD_BAR_CELLS_WIDE if total <= CARD_BAR_WIDE_MAX_SLOTS
            else CARD_BAR_CELLS_NARROW)


def card_bar_width(total):
    """Bar width in CELLS for a `total`-slot day.

    width = total x card_bar_cells_per_slot(total), capped at CARD_BAR_MAX_CELLS
    (14 -- the owner-measured un-clipped pin width on their phone).

    The cap is only reachable above 14 slots, which is the boundary the owner
    has not ruled on. When it IS reached the bar clamps and announces the clamp
    on stderr (CARD_BAR_OVERFLOW_AUDIT) instead of silently handing the pin a
    string too wide to display -- a silent clip is the failure they named. Note
    the clamp DOES break the one-cell-per-slot invariant; that is the honest
    cost of not inventing their ruling, and the audit line is what makes it
    visible rather than mysterious."""
    try:
        total = int(total or 0)
    except (TypeError, ValueError):
        return 0
    if total <= 0:
        return 0
    natural = total * card_bar_cells_per_slot(total)
    if natural > CARD_BAR_MAX_CELLS:
        try:
            sys.stderr.write((CARD_BAR_OVERFLOW_AUDIT + "\n")
                             % (total, natural, CARD_BAR_MAX_CELLS))
        except Exception:      # noqa: BLE001 -- an audit line never breaks a card
            pass
        return CARD_BAR_MAX_CELLS
    return natural


def card_progress_bar(done, total, width=None):
    """`████▓▓▒▒▒▒▒▒` -- the three-state progress bar. `width` defaults to the ADAPTIVE
    per-slot budget (card_bar_width); an explicit width is honoured for callers
    that need a fixed rail.

    Filled length is computed per SLOT, not by re-rounding a ratio, so each
    completed slot advances the bar by exactly one whole step and the bar can
    never disagree with the `<done>/<total>` counter beside it.

    The one exception is a day so long that card_bar_width had to CLAMP to
    CARD_BAR_MAX_CELLS (>14 slots, the boundary the owner has not ruled on).
    There is no whole number of cells per slot left, so the bar falls back to
    proportional fill -- the same arithmetic the explicit-width branch uses.
    Detected as `w < total`, i.e. from the numbers themselves; the clamp is not
    signalled through a flag that could go stale."""
    try:
        total = int(total or 0)
        done = max(0, min(int(done or 0), total))
    except (TypeError, ValueError):
        return CARD_BAR_EMPTY * int(width or 0)
    w = card_bar_width(total) if width is None else int(width)
    if total <= 0 or w <= 0:
        return CARD_BAR_EMPTY * max(0, w)
    if width is None and w >= total:
        per = w // total
        filled = done * per
    else:
        filled = int(round(done / float(total) * w))
    filled = max(0, min(w, filled))
    current = min(max(0, w - filled), (w // total if width is None and w >= total else max(1, round(w / total)))) if done < total else 0
    return (CARD_BAR_FILLED * filled + CARD_BAR_CURRENT * current
            + CARD_BAR_EMPTY * (w - filled - current))


# POSITIONAL BAR (owner ruling 2026-10-02: the progress bar must follow the
# in-progress / done exercise order). card_progress_bar above fills `done` cells from the
# LEFT, so it disagreed with the row order beneath it: prep showed █ while
# unfinished, a finished lift further down showed ▓. The lineup card now draws
# one SEGMENT per [진행] row, in display order (the prep cell first -- option A,
# one cell), each segment's glyph taken from THAT row's state. A passed row
# ([-]) is behind the session, so it reads █ like a done one.
CARD_BAR_STATE_GLYPH = {"done": CARD_BAR_FILLED, "passed": CARD_BAR_FILLED,
                        "current": CARD_BAR_CURRENT}


def card_progress_bar_states(seg_states, width=None):
    """The positional bar: `seg_states` = one state per [진행] row in display
    order (done | passed | current | upcoming). Each segment gets
    card_bar_cells_per_slot cells of its own glyph (done/passed █, current ▓,
    upcoming ▒), so the bar reads in the same order as the rows.

    Width, the 14-cell ceiling and the clamp audit are card_bar_width's -- the
    same budget as card_progress_bar. When the day is so long that the bar
    clamped (w < segments, the boundary the owner has not ruled on), cell c
    shows the segment under its centre, `(c + 0.5) * n / w`: still positional,
    no longer one cell per row -- the cost the audit line already announces.
    An explicit `width` is honoured the same way."""
    segs = [str(x or "upcoming") for x in (seg_states or [])]
    n = len(segs)
    w = card_bar_width(n) if width is None else max(0, int(width or 0))
    if n <= 0 or w <= 0:
        return CARD_BAR_EMPTY * w
    glyphs = [CARD_BAR_STATE_GLYPH.get(x, CARD_BAR_EMPTY) for x in segs]
    if w % n == 0:
        per = w // n
        return "".join(g * per for g in glyphs)
    return "".join(glyphs[min(n - 1, int((c + 0.5) * n / float(w)))]
                   for c in range(w))


def card_remaining_min(elapsed_min, slots_done, slots_total):
    """Minutes left, from the pace this session is ACTUALLY running at.

    A raw elapsed/done rate is useless early: slot 1 carries the mat-prep +
    warmup, so one finished slot at 22 min would project a 155-minute session.
    The measured pace is therefore blended with a flat per-slot prior:

        rate = (elapsed + DEFAULT x PRIOR) / (done + PRIOR)

    `slots_done` is FRACTIONAL (a slot 1 set into 4 counts 0.25), so the pace
    updates every set instead of only at slot boundaries. Rounded to 5 minutes
    -- this is a budget cue, not a stopwatch."""
    try:
        elapsed = max(0.0, float(elapsed_min or 0))
        done = max(0.0, float(slots_done or 0))
        total = max(0.0, float(slots_total or 0))
    except (TypeError, ValueError):
        return None
    if total <= 0:
        return None
    prior = CARD_PACE_PRIOR_SLOTS
    rate = ((elapsed + CARD_DEFAULT_SLOT_MINUTES * prior) / (done + prior))
    left = max(0.0, total - done)
    return max(0, int(round(left * rate / 5.0)) * 5)


def card_timing_line(elapsed_min, remain_min):
    """`30분 경과 · 잔여 ~25분` (own row, locked). Elapsed unknown -> None so the
    row is OMITTED rather than faked. '~' here is a TIME estimate -- unrelated
    to the volume block's '≈' (협력근 0.5 estimate) marker."""
    if elapsed_min is None:
        return None
    line = "%d분 경과" % int(elapsed_min)
    if remain_min is not None:
        line += " · 잔여 ~%d분" % int(remain_min)
    return line


def render_lineup_card(day_code, slots, states=None, card_state=None):
    """Build today's whole-day session card in the 2026-08-14 LOCKED 표(3)
    layout (see the block comment above). ONE builder for BOTH pin writers:
    session-open's session-start pin and exercise-enter's per-set refresh call
    this, so the pin never has two formats.

    day_code   = rx-calc's authoritative rotation day (title tag).
    slots      = the resolved program day's exercise slots (list of dicts).
    states     = legacy override {slot_index -> "done"|"current"|"upcoming"}.
                 Ignored when card_state carries its own states.
    card_state = gather_card_state() output: the live per-slot state, per-slot
                 무게/세트 progress, coarse 부위 groups, elapsed/remaining and
                 the [누적 볼륨] rows. None -> a STATIC card (all slots ·예정,
                 no time row, no volume block) -- the session-start shape.

    Returns a list of text lines, or None when there is no lineup to show
    (unknown day / empty slots) -- the caller must NOT write an empty/bad pin in
    that case. Never raises."""
    if not day_code:
        return None
    if not slots:
        return None
    cs = card_state or {}
    states = cs.get("states") or states or {}
    prog = cs.get("progress") or {}

    prim_ko = cs.get("primary_ko") or {}
    rows = []
    for idx, slot in enumerate(slots):
        if not isinstance(slot, dict):
            continue
        raw = slot.get("display") or slot.get("name") or "(미등록 종목)"
        # UNIFORM ANNOTATION (owner 2026-08-21): drop program.yaml's ad-hoc
        # trailing parenthetical, append this exercise's 주동근 instead. See
        # card_row_name / the _CARD_PAREN_TAIL block for why this lives here
        # and not in program.yaml.
        name = card_row_name(raw, prim_ko.get(slot.get("name")))
        rows.append((idx, name, states.get(idx, "upcoming"), slot))
    if not rows:
        return None
    # THE DENOMINATOR, resolved ONCE (card_total_slots) and handed to BOTH the
    # bar and the counter below. Owner ruling 2026-09-10 option A: the day's
    # session-level mat prep is one cell on top of the working slots; slot-bound
    # prep is none. gather_card_state supplies the two prep numbers; a STATIC
    # card (card_state=None -- session-open's start pin before a session row
    # exists) has neither, so it degrades to work-slots-only, exactly the
    # pre-2026-09-10 shape.
    prep_total = cs.get("session_prep_total") or 0
    prep_done = cs.get("session_prep_done") or 0
    total_slots = card_total_slots(len(rows), prep_total)
    # AT MOST ONE current row. gather_card_state already resolves it; a legacy
    # `states` map naming several keeps the first and marks the rest passed.
    _seen_current = False
    for i, r in enumerate(rows):
        if r[2] == "current":
            if _seen_current:
                rows[i] = (r[0], r[1], "passed", r[3])
            _seen_current = True
    # The prep cell's state. Partial prep is in progress only while no lift has
    # started; once one has, the session moved past it -> passed ([-], █).
    lift_started = any(r[2] != "upcoming" for r in rows)
    prep_state = None
    if prep_total:
        if card_session_prep_done(prep_done, prep_total):
            prep_state = "done"
        elif prep_done > 0:
            prep_state = "passed" if lift_started else "current"
        else:
            prep_state = "upcoming"
    # Segments in DISPLAY order: the bar and the counter read the same list.
    seg_states = ([prep_state] if prep_state else []) + [r[2] for r in rows]
    # Counter = done + passed (everything the session is past), the same
    # cells the positional bar fills with █.
    done_slots = sum(1 for x in seg_states if x in ("done", "passed"))

    lines = ["EXERCISE_CARD"]

    # -- line 1: 🗂 + 세션코드 + bar + <done>/<total> -------------------------
    # THE COUNTER LIVES HERE, not on its own row. Telegram's pinned-message
    # PREVIEW STRIP shows only the first line of the pin, so anything below
    # line 1 is invisible until the owner opens the pin -- and `2/8` is exactly
    # the number they want at a glance. The old line-2 counter was being cut off.
    # The COARSE 부위군 suffix that used to trail here moved to line 3 (below),
    # at sub-muscle resolution.
    # Layout note: the bar is followed by a FIXED 3-space gap, never a computed
    # pad -- █ is East-Asian-Ambiguous, so the bar's rendered width is
    # font-dependent and must not anchor a column.
    # 세션코드 = the session's OWN session_type code when card_state carries one
    # (gather_card_state (0)) -- '보충' for a makeup session, whose day_code is
    # the rotation split the lifter is NOT training and must never be shown as
    # the title. Falls back to day_code for a STATIC card (card_state=None, the
    # session-open start pin, which only ever fires for a confirmed regular
    # day) and whenever the code cannot be read.
    title_code = cs.get("session_code") or day_code
    lines.append("%s %s %s   %d/%d"
                 % (CARD_EMOJI, title_code,
                    card_progress_bar_states(seg_states),
                    done_slots, total_slots))

    # -- line 2: elapsed + remaining (omitted when the clock is unknown) ------
    timing = card_timing_line(cs.get("elapsed_min"), cs.get("remain_min"))
    if timing:
        lines.append(timing)

    # -- line 3: today's target muscles (sub-muscle, rolled up) --------------
    muscles = cs.get("muscles") or []
    if muscles:
        lines.append(" ".join(muscles))

    # -- [진행] --------------------------------------------------------------
    values = {}
    for idx, _name, st, slot in rows:
        if st == "upcoming":
            values[idx] = ""              # locked: upcoming shows NAME ONLY
            continue
        p = prog.get(idx) or {}
        # D1: the ONLY weight this row may show is the one gather_card_state
        # resolved (logged actual, else today's prescription from
        # set-table.resolve_today_weights). The old `wt or slot["weight_kg"]`
        # fallback here was the card's private second ledger -- program.yaml
        # carries LAST session's load, so it printed 135kg under a 140.0kg
        # table. None -> the row renders weight-free (honest, and matches the
        # 표2 WT column, which is blank in exactly the same cases).
        wt = p.get("weight")
        planned = p.get("total") or slot.get("sets")
        logged = p.get("done") or 0
        cells = []
        if wt is not None:
            cells.append("%skg" % _fmt_num(wt))
        if st == "done":
            n = logged or planned
            if n:
                cells.append("%s세트" % n)
        else:
            cells.append("%s/%s세트" % (logged, planned or "?"))
        values[idx] = " · ".join(cells)

    # ROW LAYOUT (owner width fix 2026-08-21): the 무게 · 세트 value is NO LONGER
    # padded out to the right of the name -- it sits on its OWN line, indented
    # CARD_VALUE_INDENT cells under the name.
    #
    # WHY: the phone's code block fits ~40 display cells. The longest name
    # (스미스머신 시티드 카프레이즈, 28 cells) plus the marker gutter plus the new
    # 주동근 annotation already reaches that budget; appending `  110kg · 4/4세트`
    # to the same line put it near 60. CARD_NAME_PAD_CELLS could not help --
    # it is a padding CEILING, not a truncation limit, so lowering it shortens
    # the pad of the SHORT names and leaves the longest line exactly as wide.
    # The only remaining alternatives were truncating a 종목명 (rejected) or
    # dropping the annotation (rejected by the owner), so the value takes a
    # second line and the widest line is now the name row itself.
    lines.append("")
    lines.append("[진행]")
    # THE MISSING 8TH ROW (owner "이거왜 4/8이냐", 2026-09-11). card_total_slots
    # already puts the prep cell in the denominator, but nothing below ever
    # emitted a matching [진행] LINE for it -- so a card reading 4/8 listed
    # only 7 rows, and no amount of counting them explains the 8th. This row
    # is that missing line, in the SAME mark/name/indented-value grammar as
    # every working row below it.
    #
    # POSITION: first, above every working slot. Mat prep is performed before
    # any working slot is entered, so it belongs at the top of a list read
    # top-to-bottom in session order -- not appended after the lifts it
    # precedes.
    if prep_total:
        if prep_state == "done":
            p_mark = CARD_DONE_MARK
            p_val = "%s%s" % (prep_total, CARD_SESSION_PREP_UNIT)
        elif prep_state in ("current", "passed"):
            # owner 2026-10-02 10:12: an item the session moved past is
            # shown DONE while the session runs ("하다 넘어간 것도 진행할땐
            # 완료처리"); the value line keeps the real count. The closeout
            # card still marks it [-].
            p_mark = (CARD_CURRENT_MARK if prep_state == "current"
                      else CARD_DONE_MARK)
            p_val = "%s/%s%s" % (prep_done, prep_total, CARD_SESSION_PREP_UNIT)
        else:
            p_mark = CARD_UPCOMING_MARK
            p_val = ""
        lines.append("%s %s" % (p_mark, CARD_SESSION_PREP_NAME))
        if p_val:
            lines.append((CARD_PAD * CARD_VALUE_INDENT) + p_val)
    for idx, name, st, _slot in rows:
        if st == "done":
            mark = CARD_DONE_MARK
        elif st == "current":
            mark = CARD_CURRENT_MARK
        elif st == "passed":
            mark = CARD_DONE_MARK     # owner 2026-10-02 10:12, see prep row
        else:
            mark = CARD_UPCOMING_MARK
        lines.append("%s %s" % (mark, name))
        val = values.get(idx) or ""
        if val:
            lines.append((CARD_PAD * CARD_VALUE_INDENT) + val)

    # -- [누적 볼륨] ---------------------------------------------------------
    # OMITTED (not an empty header) when no working set is logged yet -- at
    # session start there is no volume to measure, and an empty bracketed
    # header on the owner's always-visible pin reads as a broken card. It
    # appears the moment the first working set lands.
    vol = cs.get("volume") or []
    if vol:
        lines.append("")
        lines.append("[누적 볼륨]")
        lines.extend(card_volume_lines(
            vol, cs.get("volume_window") or CARD_VOLUME_ROWS_MAX))
    return lines


def render_lineup_preview(exercises, db_path=None):
    """Today's lineup BEFORE the session (owner 2026-10-02 11:53, the morning
    pin): render_lineup_card's static form, rows only -- every slot
    MARK_PENDING, `<name> . <primary muscle>` (card_row_name), and the
    CARD_VALUE_INDENT value line `<weight> . <sets>` (sets alone when the
    slot has no weight: calibration / hold). The value words are copy
    (ui_labels.i18n health.pin.value*).

    exercises = rx-calc's prescription rows (name, display, weight_kg, sets).
    Returns [] when there is nothing to show. Never raises."""
    try:
        ul = _ui_labels()
        rows = [e for e in exercises or () if isinstance(e, dict)
                and e.get("sets")]
        if not rows or ul is None:
            return []
        prim = {}
        if db_path:
            try:
                prim = card_primary_muscles(
                    db_path, [e.get("name") for e in rows]) or {}
            except Exception:  # noqa: BLE001 -- rows degrade to bare names
                prim = {}
        out = []
        for e in rows:
            name = card_row_name(e.get("display") or e.get("name") or "",
                                 prim.get(e.get("name")))
            out.append("%s %s" % (CARD_UPCOMING_MARK, name))
            if e.get("weight_kg") is not None:
                val = ul.i18n("health.pin.value",
                              weight=_fmt_num(e["weight_kg"]), sets=e["sets"])
            else:
                val = ul.i18n("health.pin.value_sets", sets=e["sets"])
            if val:
                out.append((CARD_PAD * CARD_VALUE_INDENT) + val)
        return out
    except Exception:  # noqa: BLE001 -- a preview miss never breaks a caller
        return []


def card_volume_lines(vol, win=None, caption=True):
    """The effective-volume rows, aligned -- ONE formatter for the lineup
    card's [누적 볼륨] and the closeout card's [부위별 부하] (2026-10-02).

    vol = card_volume_rows() output. `caption` adds the column-caption row
    (the lineup card has one; the closeout card does not)."""
    vol = list(vol or [])[:CARD_VOLUME_ROWS_MAX]
    if not vol:
        return []
    mus_col = max([_dwidth(r.get("muscle_ko", "")) for r in vol]
                  + [_dwidth("부위")])
    # Figure column width in DISPLAY cells (_narrow_width, matching
    # _pad_ascii) -- the hangul caption is 4 cells wide, not 2 characters.
    val_col = max([_narrow_width(r.get("value", "")) for r in vol]
                  + [_narrow_width("볼륨")])
    out = []
    if caption:
        # Column CAPTIONS sit at the head of their column (locked sample:
        # ` 부위     볼륨          추이 · 최근 6세션`) -- only the FIGURES are
        # right-aligned.
        out.append(" %s  %s  추이 · 최근 %d세션"
                   % (_pad_to("부위", mus_col),
                      _pad_ascii("볼륨", val_col, "l"),
                      win or CARD_VOLUME_ROWS_MAX))
    for r in vol:
        out.append((" %s  %s  %s %s"
                    % (_pad_to(r.get("muscle_ko", ""), mus_col),
                       _pad_ascii(r.get("value", ""), val_col),
                       r.get("spark", ""), r.get("arrow", ""))).rstrip())
    return out


# ---------------------------------------------------------------------------
# gather_card_state -- the DETERMINISTIC data pass behind the locked card.
# Every figure the card shows is recomputed here from workout_sets / workouts /
# exercise_muscle + the program slots. No model input, no cached prose, so the
# post-commit detached refresh (session-fastpath -> exercise-enter
# --refresh-card) reproduces the WHOLE card, volume block included.
# ---------------------------------------------------------------------------
def gather_card_state(db_path, program_path, session_id, slots,
                      current_exercise=None, rx=None, rotation_day=None):
    """Live 표(3) card state. Returns a dict; a section that cannot be computed
    is simply absent (the renderer degrades that block away). Never raises.

    Keys: states {idx -> done|current|passed|upcoming; at most one
    current}, progress {idx -> {done,total,
    weight}}, groups [COARSE 부위 …], muscles [line-3 부위 …],
    primary_ko {exercise -> [주동근 …]}, elapsed_min, remain_min,
    plan_weights {exercise -> today's working weight | None},
    volume [{muscle_ko, value, spark, arrow} …], volume_window,
    session_code (the session's own session_type code -- '앞A' | '보충' -- the
    card TITLE; absent when unreadable, renderer falls back to day_code),
    session_prep_total / session_prep_done (the day's SESSION-level mat prep:
    how many drills it declares, and how many this session has logged -- the
    two numbers card_total_slots / card_session_prep_done turn into the pin's
    single prep cell. Both ABSENT when prep cannot be read, which degrades the
    denominator to work-slots-only rather than to a cell that never fills)."""
    out = {"states": {}, "progress": {}, "groups": [], "muscles": [],
           "primary_ko": {}, "plan_weights": {}, "volume": []}
    named = [(i, s.get("name")) for i, s in enumerate(slots or [])
             if isinstance(s, dict) and s.get("name")]

    # (0a) D1 -- TODAY's working weight per exercise, from the ONE resolver
    # (set-table.resolve_today_weights: rx-calc prescription for the split being
    # trained + the owner's mid-session override). This is the SAME value the 표2
    # grid's WT column, the SET_CUE and the rest-over push carry.
    # It replaces the card's old read of the raw program.yaml slot weight_kg,
    # which is only the starting seed (nothing writes it back; program state
    # step A) -- that read is what put 135kg on the card while the table said
    # 140.0kg.
    # Best-effort: resolver failure -> {} -> the card renders those rows
    # weight-free. Blank is recoverable; a wrong weight goes onto the bar.
    try:
        _st = _load_module("set_table", "set-table")
        _rxm = rx if rx is not None else _st.load_rx_calc()
        out["plan_weights"] = _st.resolve_today_weights(
            _rxm, program_path, db_path, session_id,
            exercise_names=[n for _i, n in named], rotation_day=rotation_day)
    except Exception:  # noqa: BLE001 -- never break the card on the resolver
        pass

    # (0b) THE PREP CELL (owner ruling 2026-09-10, option A). Two numbers, and
    # deliberately only two: how many session-level mat drills this DAY declares
    # and how many this SESSION has logged. The renderer turns them into exactly
    # one cell (card_total_slots / card_session_prep_done); nothing here decides
    # how many cells that is.
    #
    # DERIVED, NEVER STORED. The declared count comes from prep.yaml through
    # set-table.session_prep_drills -- the same is_session_prep predicate the
    # LIVE per-slot plan uses, so the denominator can never contain a drill the
    # plan does not emit. The done count comes from the rows themselves:
    # slot_num NULL (0 before kit 061; SESSION_SLOT_SQL reads both) is what
    # makes a session-level row
    # distinguishable at all, and set_kind = 'prep' keeps a stray non-prep row
    # at slot 0 from filling the cell.
    #
    # BOTH KEYS STAY ABSENT ON ANY FAILURE, and that direction is chosen: an
    # unreadable prep.yaml drops the cell from the denominator entirely (the
    # pre-ruling pin), whereas a total-without-a-done would pin an empty cell
    # the owner could never fill.
    try:
        _stp = _load_module("set_table", "set-table")
        _rxp = rx if rx is not None else _stp.load_rx_calc()
        _declared = _stp.session_prep_drills(_rxp, program_path, rotation_day)
        if _declared:
            _done = 0
            conn = sqlite3.connect(db_path)
            try:
                row = conn.execute(
                    "SELECT COUNT(DISTINCT set_seq) FROM workout_sets "
                    "WHERE session_id = ? AND " + _stp.SESSION_SLOT_SQL
                    + " AND set_kind = ?",
                    (session_id, _stp.SET_KIND_PREP)).fetchone()
                _done = int((row or [0])[0] or 0)
            finally:
                conn.close()
            out["session_prep_total"] = len(_declared)
            out["session_prep_done"] = min(_done, len(_declared))
            out["session_prep_names"] = [d.get('display') or d.get('code')
                                         for d in _declared]
    except Exception:  # noqa: BLE001 -- no prep read -> no cell, never a stuck one
        out.pop("session_prep_total", None)
        out.pop("session_prep_done", None)

    # (0) the session's OWN session_type code -- '앞A' for a regular session,
    # '보충' for a makeup one. The card title used to print the caller's
    # day_code verbatim, which for a makeup session is the rotation day the
    # lifter is NOT training; session-open deliberately skips the makeup pin
    # (skipped_makeup), so the FIRST publisher of that pin is exercise-enter,
    # and set-add's --refresh-card re-published the same wrong title after
    # every set. The class was never lost -- it is right here in the DB -- so
    # the fix is to carry it into the card state rather than to add a parameter
    # to render_lineup_card and its five call sites.
    # Absent key -> the renderer falls back to day_code (static card / no rx).
    try:
        _rx = rx if rx is not None else _load_module("rx_calc", "rx-calc")
        _code = _rx.session_code(db_path, session_id)
        if _code:
            out["session_code"] = _code
    except Exception:  # noqa: BLE001 -- title falls back to day_code
        pass

    # (1) per-exercise logged WORKING sets (set_seq >= 1) -> state + 무게·세트.
    logged = {}
    last_row = {}       # exercise -> rowid of its latest working set
    try:
        conn = sqlite3.connect(db_path)
        try:
            for ex, cnt, wt, vol, last in conn.execute(
                    "SELECT exercise_name, COUNT(*), MAX(weight_kg), "
                    "SUM(weight_kg * reps), MAX(rowid) "
                    "FROM workout_sets WHERE session_id = ? AND set_seq >= 1 "
                    "GROUP BY exercise_name", (session_id,)):
                logged[ex] = (int(cnt or 0), wt, float(vol or 0))
                last_row[ex] = int(last or 0)
        finally:
            conn.close()
    except Exception:  # noqa: BLE001 -- no rows -> everything reads ·예정
        pass
    # AT MOST ONE "current" (owner 2026-10-02 09:15): the exercise currently
    # ENTERED, unless it is already done. Every other lift with sets logged
    # but short of its plan was left behind -> "passed" ([-]). Without a
    # current_exercise (or one this lineup does not hold) the lift whose
    # latest set is the most recent one is taken as current -- the best the
    # DB alone can say.
    def _is_done(i, e):
        c = logged.get(e, (0,))[0]
        p = slots[i].get("sets") or 0
        return bool(c and p and c >= p)
    cur_idx = None
    if current_exercise and any(e == current_exercise for _i, e in named):
        cur_idx = next((i for i, e in named
                        if e == current_exercise and not _is_done(i, e)), None)
    else:
        partial = [(last_row.get(e, 0), i) for i, e in named
                   if logged.get(e, (0,))[0] and not _is_done(i, e)]
        if partial:
            cur_idx = max(partial)[1]
    for idx, ex in named:
        slot = slots[idx]
        planned = slot.get("sets") or 0
        cnt, wt, ex_vol = logged.get(ex, (0, None, 0.0))
        if _is_done(idx, ex):
            state = "done"
        elif idx == cur_idx:
            state = "current"       # entered (first set maybe not logged yet)
        elif cnt:
            state = "passed"        # sets logged, then the session moved on
        else:
            state = "upcoming"
        out["states"][idx] = state
        out["progress"][idx] = {
            "done": cnt,
            # D1: nothing logged yet -> TODAY's prescribed weight from the one
            # resolver, NEVER slot["weight_kg"] (= last session's load).
            "total": planned or None,
            "weight": (wt if wt is not None
                       else (out.get("plan_weights") or {}).get(ex)),
            # this exercise's session volume, SUM(weight x reps) over working
            # sets -- the closeout card's value line (2026-10-02).
            "volume": ex_vol,
        }

    _hd, hm = _health_lib()

    # (2a) COARSE groups of today's PRIMARY muscles. No longer on the title --
    # line 3 carries sub-muscle resolution now -- but still computed: the key
    # is part of gather_card_state's published contract and 초급 falls back to
    # exactly this vocabulary.
    if hm is not None and named:
        try:
            conn = sqlite3.connect(db_path)
            try:
                q = ",".join("?" * len(named))
                muscles = [r[0] for r in conn.execute(
                    "SELECT DISTINCT muscle FROM exercise_muscle "
                    "WHERE role = 'primary' AND exercise_name IN (%s)" % q,
                    [n for _i, n in named])]
            finally:
                conn.close()
            present = {hm.coarse_group(m) for m in muscles}
            out["groups"] = [hm.GROUP_KO.get(g, g) for g in hm.GROUP_ORDER
                             if g in present]
        except Exception:  # noqa: BLE001 -- degrades to no group list
            pass

    # (2b) line 3 부위 + the per-row 주동근 annotation. Both read the same
    # primary-role gate; the line takes sub-muscle resolution (rolled up), the
    # rows take the coarse 주동근. Weighted by PLANNED sets so the line's order
    # reflects the session's emphasis. Level-gated (card_user_level).
    # CARD_SHOW_SESSION_MUSCLES (2026-08-21 18:05 -- line 3 dropped): line 3
    # became a near-derivative once every row carries its own 주동근, so it is
    # off. The builder below is kept intact -- it is the rolled-up SUB-muscle
    # view (가자미), which the rows do NOT carry (they show 종아리), so flipping
    # this back is a one-constant change, not a rewrite.
    if named and CARD_SHOW_SESSION_MUSCLES:
        try:
            sets_by = {}
            for idx, ex in named:
                sets_by[ex] = (slots[idx].get("sets") or 1)
            out["muscles"] = card_session_muscles(
                db_path, [n for _i, n in named], sets_by)
        except Exception:  # noqa: BLE001 -- line 3 degrades away
            pass
    if named:
        try:
            out["primary_ko"] = card_primary_muscles(
                db_path, [n for _i, n in named])
        except Exception:  # noqa: BLE001 -- rows degrade to bare names
            pass

    # (3) elapsed + remaining. Clock origin = workouts.created_at (the row
    # session-open births), so "경과" is real session time, not set time.
    try:
        conn = sqlite3.connect(db_path)
        try:
            row = conn.execute("SELECT created_at FROM workouts WHERE id = ?",
                               (session_id,)).fetchone()
        finally:
            conn.close()
        started = None
        if row and row[0]:
            started = datetime.datetime.strptime(
                str(row[0])[:19], "%Y-%m-%d %H:%M:%S")
        if started is not None:
            elapsed = int(round(
                (datetime.datetime.now() - started).total_seconds() / 60.0))
            out["elapsed_min"] = max(0, elapsed)
            # FRACTIONAL slots-done: a slot 1-of-4 sets in counts 0.25, so the
            # pace (and therefore 잔여) moves on every logged set.
            frac = 0.0
            for idx, _ex in named:
                p = out["progress"].get(idx) or {}
                tot = p.get("total") or 0
                dn = p.get("done") or 0
                if tot:
                    frac += min(1.0, dn / float(tot))
                elif dn:
                    frac += 1.0
            out["remain_min"] = card_remaining_min(out["elapsed_min"], frac,
                                                   len(named))
    except Exception:  # noqa: BLE001 -- no clock -> the timing row is omitted
        pass

    # (4) [누적 볼륨].
    try:
        vol, win = card_volume_rows(db_path, session_id, rx=rx)
        out["volume"] = vol
        out["volume_window"] = win
    except Exception:  # noqa: BLE001 -- volume block degrades away
        pass
    return out


def card_volume_rows(db_path, session_id, rx=None):
    """[누적 볼륨] rows for THIS session + the per-muscle 최근 N세션 sparkline.

    EFFECTIVE VOLUME (spec: reference/progress-tables.md "누적 볼륨" block):
      per-muscle effective volume = SUM over exercises of
          (1.0 if role == 'primary' else MUSCLE_SET_WEIGHT_SECONDARY) x
          (that exercise's session volume)
      exercise session volume = SUM(weight_kg x reps) over WORKING sets
          (set_seq >= 1; calibration rows with a NULL weight are skipped).
    The 0.5 secondary weight is read from rx-calc's own
    MUSCLE_SET_WEIGHT_SECONDARY, never re-declared here.

    REUSE: the session window (_recent_coded_sessions +
    VOLUME_TREND_SESSIONS) and the sparkline / direction-arrow glyph mapping
    (_sparkline / _dir_arrow) come from card_lib, the pack-owned copy of the
    weekly dashboard's helpers. Muscle names are the session cards' short
    anatomy register (card_muscle_ko).

    TWO SCOPES, deliberately: the 볼륨 figure is THIS session's live
    accumulation, while 추이 is the last N COMPLETED sessions -- the current,
    still-growing session is excluded from the sparkline. Including it would
    plant a near-empty final bar and turn every arrow ↓ for the first half of
    every workout (the locked sample shows ↑ arrows at 2/7 done).

    Returns ([{muscle_ko, value, spark, arrow} …] desc by volume, window_size).
    """
    _use_tax_db(db_path)
    hd, hm = _health_lib()
    if hd is None or hm is None:
        return [], CARD_VOLUME_ROWS_MAX
    win = getattr(hm, "VOLUME_TREND_SESSIONS", 6)
    sec_w = getattr(rx, "MUSCLE_SET_WEIGHT_SECONDARY", 0.5) if rx else 0.5
    sid = int(session_id)

    # health_metrics resolves its DB from WARG_ROOT at import; point it at the
    # DB this run was handed (sandbox-safe) for the read, then restore.
    prev_db = getattr(hm, "DB", None)
    try:
        hm.DB = db_path
        # +1 then drop the current session: it may or may not be in the window.
        sessions = hm._recent_coded_sessions(win + 1)
    except Exception:  # noqa: BLE001
        sessions = []
    finally:
        if prev_db is not None:
            hm.DB = prev_db
    hist = [s["id"] for s in sessions if s["id"] != sid][-win:]

    def _effective(sids):
        """{muscle: (effective_volume_by_sid, assisted_by_sid)} for `sids`."""
        agg = {}
        if not sids:
            return agg
        conn = sqlite3.connect(db_path)
        try:
            rows = conn.execute(
                "SELECT ws.session_id, em.muscle, em.role, "
                "       SUM(ws.weight_kg * ws.reps) "
                "FROM workout_sets ws "
                "JOIN exercise_muscle em "
                "  ON em.exercise_name = ws.exercise_name "
                "WHERE ws.session_id IN (%s) AND ws.set_seq >= 1 "
                "      AND ws.weight_kg IS NOT NULL "
                "GROUP BY ws.session_id, em.muscle, em.role"
                % ",".join("?" * len(sids)), sids).fetchall()
        except sqlite3.OperationalError:
            rows = []
        finally:
            conn.close()
        for s, muscle, role, vol in rows:
            rec = agg.setdefault(muscle, {"vol": {}, "assist": {}})
            rec["vol"][s] = rec["vol"].get(s, 0.0) + (
                float(vol or 0) * (1.0 if role == "primary" else sec_w))
            if role != "primary" and vol:
                rec["assist"][s] = True
        return agg

    live = _effective([sid])
    past = _effective(hist)

    out = []
    for muscle, rec in live.items():
        today = rec["vol"].get(sid, 0.0)
        if today <= 0:
            continue                      # not trained today -> not a card row
        series = [int(round((past.get(muscle) or {}).get("vol", {}).get(h, 0.0)))
                  for h in hist]
        spark = hd._sparkline(series)
        # Locked: 6-char FIXED sparkline. A short history left-pads with blanks
        # so the 추이 column still starts at the same place.
        if len(spark) < win:
            spark = " " * (win - len(spark)) + spark
        # Arrow compares the sessions that ACTUALLY trained this muscle (the
        # rotation gaps read as zeros and would fake a crash) -- same rule as
        # health_dashboard._volume_block. ↑/→/↓ only, never a diagonal.
        arrow = hd._dir_arrow([v for v in series if v])
        out.append({
            # Short anatomy register, like every session-card label (owner
            # 2026-10-02: 둔근 / 햄스 / 사두 -- not the dashboard's long form).
            "muscle_ko": card_muscle_ko(muscle, db_path),
            # '≈' = includes a 협력근(0.5) contribution -> estimate. Bare = 주동근
            # 1.0 only -> exact. NEVER '~' (misreads as a range).
            "value": "%s%skg" % ("≈" if rec["assist"].get(sid) else "",
                                 _fmt_thousands(today)),
            "spark": spark,
            "arrow": arrow,
            "_volume": today,
        })
    out.sort(key=lambda r: -r["_volume"])
    return out[:CARD_VOLUME_ROWS_MAX], win


def _fmt_num(v):
    try:
        f = float(v)
    except (TypeError, ValueError):
        return str(v)
    return str(int(f)) if f.is_integer() else str(f)


# SPEC 5.9 -- machine markers must NEVER reach the pin. render_exercise_card /
# render_lineup_card emit "EXERCISE_CARD" as line 0: that is the STDOUT machine
# contract the model parses. But write_dashboard_card mirrors the same list into
# dashboard.md, which the bridge renders verbatim as the owner's PINNED message
# -- so the owner's always-visible card literally opened with the raw English
# token "EXERCISE_CARD" (confirmed live 2026-08-21). Strip bare machine markers
# on the way to the pin only; stdout keeps them.
_CARD_MACHINE_MARKERS = ("EXERCISE_CARD",)

# Telegram's message limit is 4096 UTF-16 code units. bridge/dashboard.py holds
# a dumb tail-cut safeguard but explicitly delegates the SMART cut to the
# GENERATOR -- which had none. SPEC 5.5: cut by WHOLE LINES against a UTF-16
# unit budget, so a row is kept or dropped whole and a multibyte char (hangul,
# emoji) is never split.
_PIN_MAX_UTF16_UNITS = 3800      # under dashboard.py's 3900 safeguard

# DGN-974 restored code block: the pin body ships inside a ``` fence, which
# bridge/dashboard.py converts to a single <pre> (parse_mode=HTML, with a
# plain-text fail-open). The fence costs "```\n" + "\n```" = 8 UTF-16 units, and
# _PIN_MAX_UTF16_UNITS is the budget for the WHOLE pin body, so the SPEC 5.5
# line cut runs against (_PIN_MAX_UTF16_UNITS - _PIN_FENCE_UNITS).
_PIN_CODE_FENCE = "```"
_PIN_FENCE_UNITS = 8

# DGN-967 pin section ownership. dashboard.md is a DERIVED artifact composed by
# routines/status-footer.py from <bot_data_dir>/dashboard-sections.json; each
# owner slug holds exactly one section and the composer is the file's SOLE
# physical writer. This card is the "workout" owner (slug grammar
# ^[a-z0-9_-]{1,32}$; "board"/"legacy" are reserved by the framework).
PIN_OWNER = "workout"
STATUS_FOOTER = os.path.join(HERE, "..", "..", "routines", "status-footer.py")
# TTL backstop (seconds), re-stamped on EVERY --pin-set. session-closeout is the
# real lifecycle end (--pin-clear), but an un-closed session is exactly the case
# session-closeout --check exists to catch, so a dead writer must not pin a
# stale card forever. 24h matches the framework's own legacy-adoption backstop,
# i.e. this is the same expiry behaviour the card already had.
PIN_TTL_SECS = 24 * 3600


def _pin_data_dir():
    """BOT_DATA_DIR for the section API = the dir holding dashboard.md.

    Derived from DASHBOARD_FILE so the WARG_DASHBOARD_FILE test override keeps
    isolating the whole pin surface (dashboard.md AND the section store), never
    the live one."""
    return os.path.dirname(os.path.abspath(DASHBOARD_FILE)) or "."


def _pin_call(args, body=None):
    """Run `status-footer.py <args>` with the DGN-967 owner API. Returns True on
    exit 0. BEST-EFFORT / INERT-SAFE: any failure returns False, never raises."""
    try:
        if not os.path.isfile(STATUS_FOOTER):
            return False              # framework hook absent -> feature dormant
        env = dict(os.environ)
        env["DOGANY_BOT_DATA_DIR"] = _pin_data_dir()
        p = subprocess.run([sys.executable, STATUS_FOOTER] + list(args),
                           input=(body if body is not None else ""),
                           capture_output=True, text=True, timeout=15, env=env)
        return p.returncode == 0
    except Exception:  # noqa: BLE001 -- a pin miss must never break the caller
        return False


def clear_dashboard_card():
    """DGN-967 --pin-clear: drop THIS owner's section and recompose.

    The session-end lifecycle call (session-closeout). Clearing one section is
    not the bridge HIDE signal by itself -- the composer re-renders whatever
    other owners still hold, and only an all-empty compose writes "".
    Returns True when the clear was applied."""
    return _pin_call(["--pin-clear", PIN_OWNER])


def _utf16_units(text):
    """Length of `text` in UTF-16 code units (Telegram's length unit)."""
    return len(text.encode("utf-16-le")) // 2


def _cap_card_lines(lines, budget=_PIN_MAX_UTF16_UNITS):
    """SPEC 5.5: trim `lines` to fit `budget` UTF-16 units, dropping WHOLE trailing
    lines. Never slices inside a line, so a hangul display name can never be cut
    mid-character. The first line is always kept (a 1-line card is still a card).
    Returns a (possibly shorter) list. Never raises."""
    try:
        out = []
        used = 0
        for i, ln in enumerate(lines or []):
            cost = _utf16_units(ln) + (1 if i else 0)   # +1 for the joining \n
            if i and used + cost > budget:
                break
            out.append(ln)
            used += cost
        return out
    except Exception:              # noqa: BLE001 -- capping must never break entry
        return list(lines or [])


def write_dashboard_card(card_lines):
    """#14: publish the 표3 card to the dashboard.md pin surface so the bridge
    (bridge/dashboard.py, DGN-214) keeps it pinned + synced in one owner-chat
    message.

    Contract (DGN-967 SECTION OWNERSHIP -- this is NOT a whole-file write):
      - dashboard.md is a DERIVED artifact.  routines/status-footer.py composes
        it from <bot_data_dir>/dashboard-sections.json and is its SOLE physical
        writer; we own exactly one named section (PIN_OWNER) and publish it via
        `status-footer.py --pin-set <owner> --ttl <secs>` with the body on stdin.
        The workbench board owns its own section, so the two surfaces coexist
        instead of clobbering each other -- the whole point of DGN-967.
        (Superseded contract, for anyone reading the old comment: "the GENERATOR
        owns all content, the bridge is a dumb mirror, so os.replace the file".
        A direct write still WORKS -- the composer detects the sha mismatch and
        adopts it as the reserved "legacy" section with a 24h TTL -- but that is
        a compatibility fallback, not ownership: a legacy section is dropped
        FIRST under the composer's length budget and carries no lifecycle.)
      - Locking/atomicity/composition are the framework's job now: --pin-set
        runs one flock'd read-modify-write and does the atomic dashboard.md +
        manifest write itself.  We no longer touch the file.
      - dashboard_state.json ({chat_id, message_id}) stays BRIDGE-owned.
      - EMPTY BODY == NO-OP, NOT A CLEAR.  Under the section API empty content
        means "clear this owner", but every empty body reaching HERE is a render
        that failed or found no lineup -- callers pass [] on an exception path.
        Wiping the owner's live mid-session card because a render blew up is
        strictly worse than leaving the last good card up, so an empty body
        returns False without calling the API.  Clearing is an explicit
        lifecycle act: clear_dashboard_card() at session close-out.
      - DGN-974 CODE BLOCK: the body ships inside a ``` fence.  The bridge sends
        the pin as HTML now, so the fence becomes a <pre> and the card renders
        MONOSPACE -- restoring the owner's standing "표3 is always a code block"
        directive, which was suspended only while pins were plain-text-only.
      - SPEC 5.9: bare machine markers are stripped here -- the pin is OWNER
        SURFACE, so no internal English token may survive into it.
      - SPEC 5.5: the generator-side length cut drops WHOLE LINES against a
        UTF-16 budget (fence overhead included), never slicing inside a
        (multibyte) display name.

    BEST-EFFORT / INERT-SAFE: any failure (unwritable dir, dormant feature,
    OS error) is swallowed -- this must NEVER throw into the exercise-entry
    path.  Returns True on a successful publish, False otherwise.
    """
    try:
        pin_lines = [str(ln) for ln in (card_lines or [])
                     if str(ln).strip() not in _CARD_MACHINE_MARKERS]
        pin_lines = _cap_card_lines(
            pin_lines, _PIN_MAX_UTF16_UNITS - _PIN_FENCE_UNITS)
        body = "\n".join(pin_lines)
        if not body.strip():
            return False              # see EMPTY BODY == NO-OP above
        if _PIN_CODE_FENCE not in body:
            # Guard: a stray ``` inside a display name would close the fence
            # early and spill raw markup onto the owner's pin. Unfenced (today's
            # look) beats a broken block.
            body = "%s\n%s\n%s" % (_PIN_CODE_FENCE, body, _PIN_CODE_FENCE)
        # Only publish when the pin surface dir exists (i.e. a real bot data
        # dir). We do NOT create .telegram_bot from a program script -- and
        # status-footer.py WOULD (os.makedirs), so this gate has to stay ahead
        # of the call. Its absence simply means the feature is dormant here.
        if not os.path.isdir(_pin_data_dir()):
            return False
        ok = _pin_call(["--pin-set", PIN_OWNER, "--ttl", str(PIN_TTL_SECS)],
                       body=body)
        if ok:
            _pin_call(["--pin-clear", "health-workbench"])
        return ok
    except Exception:  # noqa: BLE001 -- inert-safe: a write miss never breaks entry
        return False


