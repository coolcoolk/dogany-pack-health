def _load_module(name, filename):
    """Import a sibling script that has no .py extension as a module (same
    convention session-open / session-cursor use). __main__ guards keep the
    import side-effect free."""
    path = os.path.join(HERE, filename)
    spec = importlib.util.spec_from_loader(
        name, importlib.machinery.SourceFileLoader(name, path))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def _safe_token(exercise_name):
    return re.sub(r"[^A-Za-z0-9_.-]", "_", str(exercise_name or ""))


def _entered_path(session_id, exercise_name):
    return os.path.join(ENTERED_DIR,
                        "%s.%s" % (session_id, _safe_token(exercise_name)))


def _mark_entered(session_id, exercise_name):
    """Record that this exercise was entered in this session. Best-effort --
    a marker miss can never break an entry."""
    try:
        os.makedirs(ENTERED_DIR, exist_ok=True)
        with open(_entered_path(session_id, exercise_name), "w") as fh:
            fh.write("1")
    except OSError:
        pass


def _is_entered(session_id, exercise_name):
    return os.path.exists(_entered_path(session_id, exercise_name))


