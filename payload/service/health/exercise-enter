def _card_muscle_rows(db_path, exercise_names):
    """[(exercise, subregion, parent, weight)] for the PRIMARY-role subregions
    of `exercise_names`.

    ROLE GATE (owner: "use primary only"): a subregion is kept only when its
    PARENT muscle is role='primary' for that same exercise. exercise_subregion
    carries no role of its own, so this join is the only place the gate can be
    applied. Secondary spill (rdl -> back 0.17, pendlay_row -> biceps 0.25) is
    dropped: the 부위 line answers "what am I training today", not "what gets
    touched"."""
    _use_tax_db(db_path)
    names = [n for n in (exercise_names or []) if n]
    if not names:
        return []
    q = ",".join("?" * len(names))
    try:
        conn = sqlite3.connect(db_path)
        try:
            prim = set(conn.execute(
                "SELECT exercise_name, muscle FROM exercise_muscle "
                "WHERE role = 'primary' AND exercise_name IN (%s)" % q,
                names).fetchall())
            subs = conn.execute(
                "SELECT exercise_name, subregion, weight FROM exercise_subregion"
                " WHERE exercise_name IN (%s)" % q, names).fetchall()
        finally:
            conn.close()
    except Exception:  # noqa: BLE001 -- no tables -> caller degrades the line
        return []
    out = []
    for ex, sr, wt in subs:
        parent = CARD_SUBREGION_PARENT.get(sr)
        if parent is None or (ex, parent) not in prim:
            continue
        out.append((ex, sr, parent, float(wt or 0)))
    return out


