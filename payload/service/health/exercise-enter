def do_enter(db_path, program_path, session_id, exercise_name, force,
             no_table, deliver_machine_ask=False):
    from free_session import enter
    try:
        program_path = enter(program_path, db_path, session_id, exercise_name)
    except ValueError as exc:
        print("ERROR %s" % exc, file=sys.stderr)
        return 1
    # Load reusable modules ONCE (set-table carries the day/slot resolver + the
    # (2) render + the published-flag writer; rx-calc carries load_yaml).
    try:
        st = _load_module("set_table", "set-table")
    except Exception as e:  # noqa: BLE001
        print("ERROR set-table import failed: %s" % e, file=sys.stderr)
        return 1
    try:
        rx = st.load_rx_calc()
    except Exception as e:  # noqa: BLE001
        print("ERROR rx-calc load failed: %s" % e, file=sys.stderr)
        return 1
    try:
        program = rx.load_yaml(program_path)
    except Exception as e:  # noqa: BLE001
        print("ERROR program.yaml load failed: %s" % e, file=sys.stderr)
        return 1
    if not isinstance(program, dict):
        print("ERROR program.yaml did not parse as a dict", file=sys.stderr)
        return 1

    # Resolve the day + slot (REUSE set-table's resolver). slot may be None for
    # a JIT / unregistered exercise -> the entry still proceeds with a minimal
    # card and no confirmed settings (graceful).
    day_code = slot = slot_idx = total = None
    day_slots = None
    try:
        day_code, day_slots, slot, slot_idx, total = st.find_day_and_slot(
            program, db_path, session_id, exercise_name, rx=rx)
    except Exception as e:  # noqa: BLE001 -- resolver failure degrades, no abort
        print("WARN day/slot resolve failed (%s) -- minimal entry" % e,
              file=sys.stderr)

    # DGN-773: the full safety_note prose now lives in program-history.json (out
    # of program.yaml so the per-set path stays lean). Re-hydrate this slot's
    # note so extract_record_params' weak-side / unilateral keyword scan and the
    # card render see the exact same text as before. Best-effort: a missing
    # sidecar leaves the note None (graceful, same as an inline null slot).
    if isinstance(slot, dict) and day_code and not slot.get("safety_note"):
        try:
            sidecar = rx.load_history_sidecar(program_path)
            notes = (sidecar.get("safety_notes") or {}) if sidecar else {}
            key = rx.safety_note_key(day_code, slot.get("slot"), exercise_name)
            prose = notes.get(key)
            if prose:
                slot["safety_note"] = prose
        except Exception:  # noqa: BLE001 -- never block entry on hydration
            pass

    # 2026-08-21 prep collapse: prep drills are NO LONGER stored on the
    # program.yaml slot. files/program/prep.yaml is the single canonical prep
    # SoT (morning card + live session read the same file), so hydrate this
    # slot's `prep_drills` from it here -- same best-effort shape as the
    # safety_note hydration above. extract_prep_plan() below is unchanged and
    # still reads slot["prep_drills"], so the emitted PREP_* lines are
    # byte-identical to the pre-collapse output. A missing/unparseable prep.yaml
    # leaves the key absent -> no PREP_PLAN, never a blocked entry.
    #
    # 2026-08-22 blocks: cooldown is a PEER block in the same file, hydrated
    # the same way. It is EMPTY on every slot today -- the one seeded cooldown
    # item (고관절 스트레칭) is session-end, i.e. it carries no live_slot -- so
    # this emits nothing and the live entry surface is byte-unchanged. The
    # wiring exists so that pinning a cooldown drill to a lift is a prep.yaml
    # edit, not a code change.
    #
    # A3 (2026-08-25): the PREP hydration moved from rx.prep_slot_drills to
    # set-table's slot_prep_drills. Two reasons, both D1:
    #   * rx.prep_slot_drills whitelists the pre-A3 key set and DROPS
    #     `target_reps` -- the field that makes a prep drill a set. A drill
    #     arriving here without its target cannot be prescribed, and an
    #     unprescribed "set" is the `1. 완료` menu again.
    #   * MAT PREP reached no live surface at all (it carries no live_slot, so
    #     the old projection filtered it out entirely). It binds to slot 1 now.
    #     That is the 06:23-06:30 half of the owner's complaint.
    # ONE projection, shared with the table, so the live plan and the pN rows
    # in 표2 can never list different drills or different targets.
    # COOLDOWN is unchanged and still reads rx.cooldown_slot_drills: it is
    # display-only, has no prescription data, and nothing reported a defect
    # there.
    if isinstance(slot, dict) and day_code:
        try:
            _prep_data = rx.load_prep(program_path)
            slot["prep_drills"] = st.slot_prep_drills(
                rx, program_path, day_code, slot.get("slot"))
            slot["cooldown_drills"] = rx.cooldown_slot_drills(
                _prep_data, day_code, slot.get("slot"))
        except Exception:  # noqa: BLE001 -- never block entry on hydration
            pass

    already = _is_entered(session_id, exercise_name)
    first_entry = not already

    print("ENTERED session_id=%s exercise=%s day=%s slot=%s/%s first_entry=%s"
          % (session_id, exercise_name, day_code or "-",
             slot_idx or "-", total or "-", "yes" if first_entry else "no"))

    # (a) #13 -- publish the (2) set-table. Re-published on EVERY entry call
    # (rule 2026-08-21: drop the published-skip logic; re-publish current
    # state at every set boundary). The old `already and not force -> skipped=already_published`
    # branch was a published-skip that could leave a boundary (e.g. a re-entry at
    # 웜업 시작) without a current-state table; it is REMOVED so a re-entry always
    # re-renders the table from live state (set-table is idempotent + reflects the
    # current ✓/▸/· rows, so a re-render is never a stale duplicate). Only the
    # explicit caller opt-out (--no-table) still suppresses the publish. Best-
    # effort: a render failure prints WARN and proceeds.
    # F14 clause 2, as a gate (2026-09-11 -- see entry_table_gate_open above).
    # Evaluated BEFORE the publish so the held case never renders the table at
    # all; a rendered-then-discarded table is a table one stray print away from
    # the owner's screen.
    _f14_open, _f14_why, _f14_planned, _f14_logged = entry_table_gate_open(
        st, db_path, session_id, exercise_name, slot)
    print("F14_GATE table=%s reason=%s entry_prep_planned=%d "
          "entry_prep_logged=%d"
          % ("open" if _f14_open else "held", _f14_why, _f14_planned,
             _f14_logged))
    if no_table:
        print("SET_TABLE skipped=no_table")
    elif not _f14_open:
        # HELD, not missing. The token is deliberately distinct from
        # `SET_TABLE unavailable`: nothing failed, the table is simply not this
        # beat's output. The PREP_ENTRY block below is -- and it carries the
        # PREP_SET_CMD argv for each remaining drill, so the turn is not left
        # without a next action. SET_TABLE_MISSING must NOT be inferred from
        # this line (SKILL 「자백 금지」: no signal, no confession).
        print("SET_TABLE held=prep_incomplete entry_prep=%d/%d "
              "publish_after=entry_prep_complete"
              % (_f14_logged, _f14_planned))
    else:
        # Defect B (owner SPEC 2026-08-20 section 2): this is a GENUINE (re)entry
        # publish (first entry, or a --force correction). Clear any STALE
        # .set-table-published flag FIRST so a leftover flag (e.g. a diagnostic
        # mid-session set-table render -- the 5.8 pollution) can never make the
        # entry table look "already delivered"; publish_set_table re-marks it right
        # after, so the flag reflects THIS entry's real delivery. Best-effort.
        try:
            st._clear_published(session_id, exercise_name)
        except Exception:  # noqa: BLE001 -- clear miss never blocks the entry
            pass
        _tbl_signals = []
        table, err = publish_set_table(st, rx, program, db_path, program_path,
                                       session_id, exercise_name,
                                       signals=_tbl_signals)
        if table is not None:
            # DELIVERED BY CODE, as its own owner message (see deliver_set_table
            # above). The entry beat goes through the SAME hop and the SAME
            # content ledger as the per-set beat -- that shared claim is what
            # makes it safe for set-add to ask for a publish immediately after
            # this call's auto-fire without putting two tables on one screen.
            deliver_set_table(st, table, session_id, exercise_name, entry=True)
            # A3/D3: OUTSIDE the fence, on every entry, whichever way the
            # decision went. A ramp that was not generated must say so and say
            # why; a ramp that WAS generated must be visible as a fact rather
            # than as something the model noticed. lat_pulldown on 2026-08-25
