def do_refresh_card(db_path, program_path, session_id, exercise_name):
    """#14 follow-up (표3 row progress): recompute the 종목카드 with LIVE per-set
    ✓/▸/· state from workout_sets and rewrite the dashboard.md pin surface.

    Called on every set-add success (deterministic, server-side -- the model
    never re-types the card). Distinct surface from the 표2 inline set-table:
    표3 is the PINNED card written here, edited in place by the bridge; 표2 is
    delivered as its own message by do_publish_table, on the same set-add
    success. Different write paths, different Telegram messages, so they never
    double-post.

    (The superseded sentence here said 표2 "rides the set-table-followup render
    hook". That hook instructs the MODEL, is registered in no settings file and
    has never run -- it was never a carrier. Corrected rather than deleted
    because a stale mechanism claim in a docstring is exactly what taught the
    model the table had already been delivered.)

    Reuses set-table's resolver + fetch_current_sets + rx prescription (no new
    DB code, no new pin engine -- write_dashboard_card feeds the SAME DGN-214
    dashboard.py auto-pin). BEST-EFFORT / INERT-SAFE: any failure prints a WARN
    and returns without touching the set write (this runs AFTER the set is
    committed). Emits `PINNED_CARD refresh=<yes|no>` for audit."""
    try:
        st = _load_module("set_table", "set-table")
        rx = st.load_rx_calc()
        program = rx.load_yaml(program_path)
    except Exception as e:  # noqa: BLE001 -- degrade, never break the set write
        print("WARN card refresh setup failed: %s" % e, file=sys.stderr)
        print("PINNED_CARD refresh=no")
        return 0
    if not isinstance(program, dict):
        print("PINNED_CARD refresh=no")
        return 0

    day_code = slot = slot_idx = total = None
    day_slots = None
    try:
        day_code, day_slots, slot, slot_idx, total = st.find_day_and_slot(
            program, db_path, session_id, exercise_name, rx=rx)
    except Exception as e:  # noqa: BLE001
        print("WARN card refresh day/slot resolve failed: %s" % e,
              file=sys.stderr)

    # Live card state -- ALL of it recomputed from the DB (per-slot ✓/▸/·,
    # 무게·세트, coarse 부위군, elapsed/remaining, and the [누적 볼륨] effective-
    # volume rows + sparklines). This is the DETERMINISTIC refresh the fast path
    # fires post-commit (session-fastpath:side_fx_detached -> --refresh-card),
    # so the full locked card -- volume block included -- lands on the pin with
    # zero model turns.
    card_state = None
    try:
        card_state = gather_card_state(db_path, program_path, session_id,
                                       day_slots or [],
                                       current_exercise=exercise_name, rx=rx,
                                       rotation_day=day_code)
    except Exception as e:  # noqa: BLE001 -- degrade to a static card
        print("WARN card refresh state compute failed: %s" % e,
              file=sys.stderr)

    card_lines = []
    try:
        card_lines = render_lineup_card(day_code, day_slots,
                                        card_state=card_state) or []
        if not card_lines:
            # No resolvable day lineup (off-program / JIT): degrade to the
            # single-slot card rather than writing an empty pin. D1: the weight
            # comes from the same resolved map, never from the slot snapshot.
            card_lines = render_exercise_card(
                day_code, slot, slot_idx, total,
                today_weight=((card_state or {}).get("plan_weights")
                              or {}).get(exercise_name),
                session_code=(card_state or {}).get("session_code"))
    except Exception as e:  # noqa: BLE001
        print("WARN card refresh render failed: %s" % e, file=sys.stderr)
        card_lines = []
    pinned = write_dashboard_card(card_lines)
    print("PINNED_CARD refresh=%s" % ("yes" if pinned else "no"))
