def do_publish_table(db_path, program_path, session_id, exercise_name):
    """THE PER-SET BEAT: re-render the (2) table from live state and deliver it.

    Called on every set-add success (see set-add:_publish_table), which is the
    one event that is guaranteed to happen every time a set exists -- the same
    reasoning that made --refresh-card the carrier for the 표3 pin. Every set
    means EVERY set: a prep drill, a ramp rung and a working set all move the
    grid, and the ramp rows are the ones that measurably vanished from the
    owner's screen (2026-08-25, four exercises: the rung reached the DB and
    nothing reached the chat, so the owner had to ask whether their own warmup
    had been recorded).

    WHAT THIS IS NOT: it is not an entry. No entered-marker, no card, no
    settings/params/anchor, no arm. It renders and it delivers, and it shares
    do_enter's gate and delivery ledger so the two beats cannot double-post.

    THE GATE IS THE SAME GATE (F14 clause 2). Publishing per set must not be a
    way around it: the owner's complaint of 2026-09-11 06:2x -- 「운동시작했는데
    냅다 데드리프트 표 던지네 매트프렙 차례인데」 -- was about a table arriving
    while prep was still owed, and a per-set publish that skipped the gate
    would reproduce it once per prep drill instead of once per entry. So this
    beat evaluates entry_table_gate_open exactly as do_enter does, and a held
    beat delivers NOTHING. The natural consequence is the good one: the drill
    that CLOSES the entry prep band opens the gate, so the table's first
    appearance is the moment prep is finished, published by code.

    stdout (audit lines; there is no relay contract on this path -- on the
    inline-button rail set-add's stdout reaches no one, which is precisely why
    the delivery has to be a send and not a print):
        F14_GATE table=<open|held> reason=... entry_prep_planned=N
                 entry_prep_logged=M
        SET_TABLE held=prep_incomplete ...   (held beats)
        SET_TABLE delivered=<yes|no> ...     (open beats)

    BEST-EFFORT / INERT-SAFE: always returns 0. This runs AFTER the set is
    committed, so nothing here may cost the owner the record."""
    try:
        st = _load_module("set_table", "set-table")
        rx = st.load_rx_calc()
        program = rx.load_yaml(program_path)
    except Exception as e:  # noqa: BLE001 -- degrade, never break the set write
        print("WARN table publish setup failed: %s" % e, file=sys.stderr)
        print("SET_TABLE delivered=no reason=setup_failed")
        return 0
    if not isinstance(program, dict):
        print("SET_TABLE delivered=no reason=program_unparsed")
        return 0

    slot = None
    try:
        _day, _slots, slot, _idx, _tot = st.find_day_and_slot(
            program, db_path, session_id, exercise_name, rx=rx)
    except Exception as e:  # noqa: BLE001 -- slot=None reads as "no prep
        # planned" in the gate below, i.e. fail-open, same as do_enter's own
        # hydration failure path.
        print("WARN table publish day/slot resolve failed: %s" % e,
              file=sys.stderr)
        _day = None
    # HYDRATE THE PREP BAND BEFORE READING THE GATE. find_day_and_slot returns
    # the program.yaml slot, and prep lives in prep.yaml -- an un-hydrated slot
    # carries no prep_drills at all, so entry_table_gate_open would read
    # planned=0, call it no_prep_planned and fail OPEN on every beat. That is
    # not a degraded gate, it is no gate: the table would go out after each
    # prep drill, which is the 「냅다 표 던지네」 surface F14 exists to stop,
    # once per drill instead of once per entry. Same projection do_enter uses
    # (st.slot_prep_drills), so the gate here counts exactly the drills the
    # entry gate counts and the pN rows in 표2 list.
    if isinstance(slot, dict) and _day:
        try:
            slot["prep_drills"] = st.slot_prep_drills(
                rx, program_path, _day, slot.get("slot"))
        except Exception as e:  # noqa: BLE001 -- fail-open, same as do_enter
            print("WARN table publish prep hydration failed: %s" % e,
                  file=sys.stderr)

    gate_open, why, planned, logged = entry_table_gate_open(
        st, db_path, session_id, exercise_name, slot)
    print("F14_GATE table=%s reason=%s entry_prep_planned=%d "
          "entry_prep_logged=%d"
          % ("open" if gate_open else "held", why, planned, logged))
    if not gate_open:
        # HELD, not missing -- the same distinction do_enter draws. The prep
        # rail owns this beat's output; the table simply is not it.
        print("SET_TABLE held=prep_incomplete entry_prep=%d/%d "
              "publish_after=entry_prep_complete" % (logged, planned))
        return 0

    signals = []
    table, err = publish_set_table(st, rx, program, db_path, program_path,
                                   session_id, exercise_name, signals=signals)
    if table is None:
        print("SET_TABLE unavailable=%s" % (err or "unknown"), file=sys.stderr)
        print("SET_TABLE unavailable")
        return 0
    status = deliver_set_table(st, table, session_id, exercise_name)
    # A3/D3: the render's own decisions ride along on a delivered beat too --
    # a ramp that was NOT generated has to say so on the set it was owed, not
    # only at entry. Suppressed on a duplicate: nothing went to the screen, so
    # there is no decision to explain.
    if status != "duplicate":
        for sig in signals:
            print(sig)
    return 0


def _exec_mode_say(params):
    """The owner-facing execution-mode sentence, or None when there is nothing
    worth saying out loud.

    NOT emitted for the ordinary bilateral default, and that omission is the
    design, not an oversight: 「양측입니다」 on every entry of every lift is noise,
    and noise is what a reader stops reading. The BINDING statement is the
    machine token `exec_mode=bilateral:default` on the RECORD_PARAMS line above
    -- always present, A-class, never relayed. What the owner hears is reserved
    for the two cases where the mode is actually news:

      * a DECLARED unilateral mode -- 양쪽 다 하고 한 번 기록, and on some slots
        약한 쪽 먼저. That is a protocol they execute, so it is spoken;
      * an UNDECLARED slot whose prose smells unilateral (exec_mode_hint). Here
        the sentence exists precisely to pre-empt the incident: it states that we
        are going 양측 BECAUSE nothing declares otherwise, and invites the
        correction. This is the one turn where the old code could have asserted
        편측 off a keyword, and it is now the turn that says it did not."""
    mode = params.get("exec_mode")
    if not mode:
        return None
    if params.get("exec_mode_source") == "declared":
        tail = (". 약한 쪽 먼저 가고 강한 쪽은 그 반복수에 맞춥니다"
                if params.get("weak_side_first") else "")
        return ("이 종목은 프로그램에 편측 수행으로 선언돼 있습니다 -- "
                "양쪽 다 하고 기록은 한 번%s." % tail)
    if params.get("exec_mode_hint"):
        return ("이 종목은 편측 선언이 없어서 양측(양쪽 같이)으로 갑니다 -- "
                "설명 문구에 한쪽씩 하는 얘기가 있긴 한데, 선언이 아니라 "
                "제가 임의로 편측으로 바꾸지 않았습니다. 한쪽씩이 맞으면 "
                "말씀 주세요.")
    return None


def _kv(d, order):
    """Render a dict as space-joined key=value in a stable order (declared keys
    first, any extras after). Values with spaces are quoted."""
    keys = [k for k in order if k in d] + [k for k in d if k not in order]
    parts = []
    for k in keys:
        v = str(d[k])
        if " " in v or "\t" in v:
            v = '"%s"' % v.replace('"', "'")
        parts.append("%s=%s" % (k, v))
    return " ".join(parts)


