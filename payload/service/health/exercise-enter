def _zone_label(zone):
    """Owner-facing name for a prep zone, resolved through ui_labels (the one
    home for owner-facing labels) -- never a literal typed here. None when the
    zone is undeclared or the resolver is absent."""
    mod = _ui_labels()
    if mod is None:
