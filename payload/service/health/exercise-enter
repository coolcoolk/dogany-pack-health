    except Exception:  # noqa: BLE001
        return None


def _prep_kv(d):
    # `target_reps` sits between hold_sec and display (A3): a present value adds
    # one token, an absent one leaves the line byte-identical to before -- which
    # is every drill that carried no owner-stated number.
    parts = []
    for k in ("code", "phase", "zone", "requires", "hold_sec", "target_reps",
              "target_unit", "display"):
        v = d.get(k)
        if v is None:
            continue
        # `requires` is a list; render it as a comma-joined token so the line
        # stays one-drill-per-line and shell-free (no spaces to quote).
        if k == "requires":
            v = ",".join(str(r).strip() for r in v if str(r).strip()) \
                if isinstance(v, (list, tuple)) else str(v).strip()
            if not v:
                continue
        v = str(v)
        if " " in v or "\t" in v:
            v = '"%s"' % v.replace('"', "'")
        parts.append("%s=%s" % (k, v))
    return " ".join(parts)


# ---------------------------------------------------------------------------
# (e) #43 -- PRIOR-ACTUAL anchor (deterministic, code-provided). The weight the
# owner ACTUALLY worked with the last time they did THIS exercise, so the entry
# cue can frame today's number as "직전 N kg -> 오늘 M kg" instead of a bare
# surprise ("싱글레그 왜 40키로냐"). Read straight from workout_sets -- the last
# logged WORKING set (weight_kg NOT NULL) of the SAME exercise_name in a PRIOR
# session (session_id != current, so the still-open session's own partial sets
# never shadow the anchor). No prior working set -> first-ever ("첫 기록").
# BEST-EFFORT / FAIL-OPEN: any DB error returns None and the entry proceeds --
# the anchor is a convenience line, never a gate.
# ---------------------------------------------------------------------------
def get_prior_actual(db_path, session_id, exercise_name):
    """Return (weight_kg, reps, date) for the last logged WORKING set of this
    exercise in a PRIOR session, or None if there is no prior working set.
    Working set = weight_kg IS NOT NULL (a calibration/bw set has weight_kg
    NULL and is not a meaningful weight anchor). Never raises."""
    try:
        conn = sqlite3.connect(db_path)
    except sqlite3.Error:
        return None
    try:
        row = conn.execute(
            "SELECT ws.weight_kg, ws.reps, w.date "
            "FROM workout_sets ws JOIN workouts w ON w.id = ws.session_id "
            "WHERE ws.exercise_name = ? AND ws.session_id != ? "
            "AND ws.weight_kg IS NOT NULL "
            "ORDER BY w.date DESC, w.created_at DESC, ws.recorded_at DESC, "
            "ws.id DESC LIMIT 1",
            (exercise_name, session_id),
        ).fetchone()
    except sqlite3.Error:
        return None
    finally:
        conn.close()
    if not row or row[0] is None:
        return None
    return row[0], row[1], row[2]


def format_anchor(prior, slot, today_weight=_TODAY_WEIGHT_UNRESOLVED):
    """#43: one deterministic ANCHOR machine line. prior = get_prior_actual()
    result or None. slot = resolved program slot (kept for callers with no
    session context). First-ever -> '첫 기록'. Never raises.

    today_weight (D1, 2026-08-24): TODAY's working weight from the ONE resolver
    (set-table.resolve_today_weights) -- the same number the 표2 grid, the
    SET_CUE and the rest-over push carry. It MUST be supplied by any live
    caller, INCLUDING as None ("no prescribed weight today" -> the line simply
    carries no today= / no 오늘 note).

    Why: this function used to read `slot["weight_kg"]` as "today". That key is
    only the owner's starting seed (nothing writes it back; the progression
    base is the last LOGGED load, program state step A). On a session where
    progression advanced (deadlift 135 -> 140) the
    ANCHOR note said `직전 135kg -> 오늘 135kg` -- a no-progress statement, in
    the message the model relays verbatim and the bridge pins, directly above a
    table reading 140.0kg. Never re-derive today's weight here."""
    today = None
    # A4: an unsupplied weight is NOT the card's seed -- blank stays blank.
    wt = None if today_weight is _TODAY_WEIGHT_UNRESOLVED else today_weight
    if wt is not None:
        today = _fmt_num(wt)
    if prior is None:
        # First-ever exposure to this exercise -- no prior working set on record.
        line = "ANCHOR prior=none first=yes note=첫 기록"
        if today is not None:
            line += " today=%skg" % today
        return line
    p_wt, p_reps, p_date = prior
    line = "ANCHOR prior=%skg" % _fmt_num(p_wt)
    if p_reps is not None:
        line += " prior_reps=%s" % p_reps
    if p_date:
        line += " prior_date=%s" % p_date
    if today is not None:
        line += " today=%skg" % today
        # Human-facing summary the model echoes verbatim (no model composition).
        line += " note=\"직전 %skg -> 오늘 %skg\"" % (_fmt_num(p_wt), today)
    else:
        line += " note=\"직전 %skg\"" % _fmt_num(p_wt)
    return line


def _first_term(hay, terms):
    low = hay.lower()
    for t in terms:
        if t.lower() in low:
            return t
    return None


def _has_term(hay, terms):
    return _first_term(hay, terms) is not None


_RX_FOR_HOLD = []


def _rx_for_hold():
    """rx-calc, loaded once per process for the hold predicate."""
    if not _RX_FOR_HOLD:
        _RX_FOR_HOLD.append(
            _load_module("set_table", "set-table").load_rx_calc())
    return _RX_FOR_HOLD[0]


def _is_hold_slot(slot, db_path=None):
    """Same rule as set-arm.is_hold_class -- DELEGATED to
    rx-calc._is_isometric_hold (A1, 2026-09-30): structure (rep_unit /
    isometric, taxonomy measure, legacy card shape), never a resolved weight.
    Hold slots have their own press-start/hold-done END flow (no reps
    keyboard), so exercise-enter must NOT arm a reps-first keyboard for them.
    None slot -> False (arm the reps keyboard -- the safe default for an
    unregistered set)."""
    if not isinstance(slot, dict):
        return False
    try:
        return bool(_rx_for_hold()._is_isometric_hold(slot, db_path))
    except Exception:  # noqa: BLE001
        return (slot.get("progression") == "hold"
                and slot.get("weight_kg") is None)


def _next_working_seq(db_path, session_id, exercise_name):
    """The next WORKING set_seq = count of already-logged working sets
    (set_seq >= 1) for this (session, exercise) + 1.

    NO LONGER the entry arm's seq (2026-08-21). It is >= 1 by construction, so
    using it on entry meant ENTERING an exercise always armed WORKING SET 1 --
    even when the very next thing the owner does is a bodyweight primer or a
    ramp rung. That is the entry half of incident 1: the keyboard offered the
    working set's rep window during a warm-up, and tapping it wrote working set
    1 at the working weight. The ladder-aware resolution (warm-up rungs first,
    working sets after) lives in set-arm.next_ladder_seq and is applied by
    `set-arm reps-entry` itself when no seq is passed -- ONE resolver, shared by
    the entry arm and the post-log re-arm. Kept here as the documented degrade
    for a caller that needs a working-lane seq without loading set-arm."""
    try:
        conn = sqlite3.connect(db_path)
        try:
            row = conn.execute(
                "SELECT COUNT(*) FROM workout_sets "
                "WHERE session_id = ? AND exercise_name = ? AND set_seq >= 1",
                (session_id, exercise_name)).fetchone()
        finally:
            conn.close()
        n = int(row[0]) if row and row[0] is not None else 0
        return n + 1
    except Exception:  # noqa: BLE001 -- arm resolve must never break the entry
        return 1


def _deliver_machine_ask(db_path, session_id, exercise_name):
    """Run `set-arm machine-ask`; its `MACHINE_ASK delivered=yes|already`
    receipt line, or None (not delivered -- the caller keeps the ask lines).
    Best-effort: any failure is None."""
    try:
        proc = subprocess.run(
            [SET_ARM, "machine-ask", str(session_id), exercise_name,
             "--db", db_path], capture_output=True, text=True, timeout=30)
        if proc.stderr:
            print(proc.stderr.rstrip(), file=sys.stderr)
        for line in (proc.stdout or "").splitlines():
            if line.startswith(("MACHINE_ASK delivered=yes",
                                "MACHINE_ASK delivered=already")):
                return line.rstrip()
    except Exception as e:  # noqa: BLE001 -- never block entry on this
        print("WARN machine ask delivery failed: %s" % e, file=sys.stderr)
    return None


def arm_reps_first(db_path, program_path, session_id, exercise_name, slot):
    """DGN-918 REPS-FIRST arm on working-set entry. Fires set-arm's `reps-entry`
    subcommand (which builds the reps->RIR arm-file WITHOUT a DB write and emits
    `[[IDRILL:<arm_id>]]` on its stdout), captures that marker, and re-surfaces it
    as a clean `IDRILL_MARKER: [[IDRILL:<arm_id>]]` line on exercise-enter's OWN
    stdout so the model attaches it VERBATIM to the entry reply (0-model-turn
    reps keyboard at turn-0). Skipped for a TRUE hold/iso slot (its END flow is
    press-start/hold-done, not a reps keyboard). LIVE-SAFETY / degrade: set-arm's
    reps-entry is itself gated behind the DGN918 flag (flag off -> no marker
    emitted -> nothing surfaced here). Any failure prints a WARN and never blocks
    the entry."""
    if _is_hold_slot(slot, db_path):
        print("IDRILL_ARM skipped=hold_class")
        return
    try:
        # NO set_seq argument (2026-08-21): `set-arm reps-entry` resolves the
        # LADDER position itself -- the first un-logged warm-up rung, else the
        # next working set (set-arm.next_ladder_seq). Passing a seq from here
        # is what armed working set 1 during a warm-up; the resolver lives next
        # to the rung/ramp SoT it has to read, not in this file.
        cmd = [SET_ARM, "reps-entry", str(session_id), exercise_name,
               "--db", db_path, "--program", program_path]
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
        # set-arm's audit output rides stderr; scan its stdout for the marker.
        if proc.stderr:
            print(proc.stderr.rstrip(), file=sys.stderr)
        marker = None
        delivered = []
        for line in (proc.stdout or "").splitlines():
            if line.startswith("[[IDRILL:") and line.rstrip().endswith("]]"):
                marker = line.rstrip()
            elif line.startswith("KEYBOARD_DELIVERED"):
                # ONE ARM ONE KEYBOARD (2026-09-11): set-arm delivered the
                # entry keyboard as its own code push and (by design) emitted
                # NO marker. The receipt is the contract line set-add and the
                # model key on; dropping it here would both lose the "do not
                # author buttons" instruction and make the audit below claim
                # armed=no for a keyboard that is on its way.
                delivered.append(line.rstrip())
        for line in delivered:
            print(line)
        if marker:
            # Same output contract set-add uses (§6). The bridge renders the
            # step1 keyboard ONLY from a BARE `[[IDRILL:<id>]]` line in the
            # model reply (bridge IDRILL_MARKER_RE is full-line anchored:
            # `^\[\[IDRILL:([0-9a-f]{8})\]\]$`). So we surface the marker as a
            # BARE bracket line on stdout -- the exact form the model must echo
            # verbatim. A human-readable audit label rides stderr only (never
            # the model reply), so an `IDRILL_MARKER: ` prefix can never leak
            # into the reply and defeat the bridge regex.
            print("IDRILL_MARKER (echo the bare bracket line below verbatim):",
                  file=sys.stderr)
            print(marker)
        elif not delivered:
            # Flag off, or set-arm degraded -> nothing to arm (byte-identical to
            # today when the flag is not set). Emit an audit line, no marker.
            # `not delivered` guard: a code-delivered keyboard with no marker is
            # ARMED -- printing armed=no for it is the false audit that hid the
            # rail split.
            print("IDRILL_ARM armed=no")
    except Exception as e:  # noqa: BLE001 -- arming must never break the entry
        print("WARN reps-first arm failed: %s" % e, file=sys.stderr)


