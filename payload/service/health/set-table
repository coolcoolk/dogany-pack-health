def e1rm(weight, reps, rir):
    """Epley-style e1RM. NOT sourced from an rx-calc function (none exists);
    replicated from workout-session/SKILL.md e1RM/볼륨 텔레메트리 spec:
        e1rm = weight_kg * (1 + (reps + RIR) / 30)   (top set)
    NULL rir -> 0 (conservative). Trend display value; the PRESCRIPTION's
    estimate (owner ruling 2026-09-30, replacing the 2026-07-28 display-only
    exclusion) is e1rm_rx.estimate -- same formula, median of the last 3
    session top sets, sufficiency-gated -- not this function."""
    if weight is None:
        return None
    r = rir if rir is not None else 0
    return weight * (1 + (reps + r) / 30.0)


def sparkline(values):
    """Map a session series onto unicode blocks (1 char / session), scaled
    min->max within the window. Single point / flat series -> mid block ▄ so a
    lone datum still renders (C10) without implying a slope."""
    if not values:
        return ""
    lo, hi = min(values), max(values)
    if hi <= lo:
        return "▄" * len(values)
    out = []
    for v in values:
        idx = int(round((v - lo) / (hi - lo) * (len(SPARK_BLOCKS) - 1)))
        out.append(SPARK_BLOCKS[idx])
    return "".join(out)


def find_day_and_slot(program, db_path, session_id, exercise_name, rx=None,
                      trace=None):
    """Resolve (day_code, day_plan, slot_dict, slot_index, total_slots) for the
    current exercise. Day is resolved from the session's session_type_id ->
    session_type.code (which equals the program day key, e.g. 뒷B).

    E23 fix: session_type_id is NULL mid-session (it is only written at
    POST_SESSION). When NULL, derive today's rotation day via
    rx.select_rotation_day(program, db_path) -- the same deterministic rotation
    resolver used by rx-calc to pick today's prescription. This ensures a
    duplicate exercise name (e.g. single_leg_extension in both 앞A slot4 and 앞B
    slot4) always resolves to the CORRECT day rather than the first file-order
    match. The file-order fallback is kept only as a last resort when rx is
    unavailable, to preserve backward compatibility.

    `trace` (2026-08-26): an optional dict this function FILLS IN so the caller
    can tell a READ from a GUESS. This resolver has three tiers and only the
    first one asks the session row what the session is; the other two infer the
    day from the rotation queue / program file order. Until now the three were
    indistinguishable from the outside -- the caller got a day_code and no way
    to know whether the DB said so or the calendar did. That is the exact shape
    of the makeup defect (2026-08-22 session 10090): the answer WAS in the row
    ('보충'), the guard dropped it because '보충' is a session CLASS and never a
    program day key, tier 2 silently advanced the queue, and the pin printed a
    split the owner was not training -- with nothing anywhere saying the title
    had been inferred. Keys written:

      session_code  the session's OWN session_type.code, RAW -- '보충' included,
                    even though only a program-day key can become day_code.
                    None when workouts.session_type_id is NULL (an UNTAGGED
                    session: the row cannot say what it is) or unreadable.
      source        'session_type'   tier 1 -- READ from the session row
                    'rotation_queue' tier 2 -- INFERRED from the last tagged
                                     session + one queue step
                    'file_order'     tier 3 -- INFERRED from program file order
                    'unresolved'     no day at all
                    'db_error'       the session row could not be read
      day           the resolved day_code (None when unresolved)

    Passing nothing keeps the previous behaviour exactly; the trace is written
    to a throwaway dict and dropped.

    slot_index/total_slots are 1-based over that day's slot order."""
    days = program.get("days") or {}
    rotation = program.get("rotation") or list(days.keys())

    tr = trace if isinstance(trace, dict) else {}
    tr["session_code"] = None
    tr["source"] = None
    tr["day"] = None

    day_code = None
    conn = sqlite3.connect(db_path)
    try:
        row = conn.execute(
            "SELECT session_type_id FROM workouts WHERE id = ?", (session_id,)
        ).fetchone()
        stype_id = row[0] if row else None
        if stype_id is not None:
            crow = conn.execute(
                "SELECT code FROM session_type WHERE id = ?", (stype_id,)
            ).fetchone()
            # Keep the RAW code whether or not it is a program day -- '보충' is
            # a real, correct answer to "what is this session", it is just not
            # an answer to "which program day". Dropping it here is what made
            # the class invisible to every render layer downstream.
            if crow and crow[0]:
                tr["session_code"] = crow[0]
                if crow[0] in days:
                    day_code = crow[0]
                    tr["source"] = "session_type"
    except sqlite3.OperationalError:
        tr["source"] = "db_error"
    finally:
        conn.close()

    def slots_of(code):
        return (days.get(code) or {}).get("exercises") or []

    # E23 fix: session_type_id is NULL mid-session (it is only written at
    # POST_SESSION). Derive today's rotation day by finding the last TAGGED
    # regular session (excluding the current open session_id so its untagged
    # sets do not shadow the lookup), then advancing one step in the rotation.
    #
    # rx is passed in for get_session_type_codes reuse (no new DB schema
    # dependency). The makeup-exclusion logic from rx.get_last_weight_session
    # is replicated here for the same correctness guarantee: makeup sessions
    # (codes NOT in rotation) are skipped so they cannot set the rotation basis.
    # G1 (2026-08-23): the zero-set guard is replicated for the same reason --
    # session-open birth-tags a row BEFORE any set exists, so an abandoned
    # same-day 0-set row (e.g. a session opened, aborted, and reopened) would
    # otherwise become "the last session" here and advance the day one slot
    # past the day actually being trained. Only a workout_sets row proves a
    # session happened. This keeps set-table's answer identical to
    # rx.get_last_weight_session's instead of drifting from it.
    #
    # Steps:
    #   1. Query workouts for the most recent tagged session that carries >=1
    #      set, excluding session_id and makeup codes.
    #   2. Advance one step in the rotation queue -> today's expected day.
    #   3. Confirm the exercise exists in that day; if not, fall through to
    #      file-order scan (substitution / rotation anomaly safety net).
    if day_code is None:
        if rx is not None:
            try:
                type_codes = rx.get_session_type_codes(db_path)
                # Collect makeup session_type ids (codes not in rotation).
                makeup_type_ids = [tid for tid, code in type_codes.items()
                                   if code not in rotation]
                excl_clause = ""
                params = [session_id]
                if makeup_type_ids:
                    placeholders = ",".join("?" * len(makeup_type_ids))
                    excl_clause = (" AND w.session_type_id NOT IN (%s)"
                                   % placeholders)
                    params.extend(makeup_type_ids)
                conn2 = sqlite3.connect(db_path)
                try:
                    row2 = conn2.execute(
                        "SELECT session_type_id FROM workouts w "
                        "WHERE w.id != ? AND w.session_type_id IS NOT NULL "
                        "AND EXISTS (SELECT 1 FROM workout_sets ws "
                        "WHERE ws.session_id = w.id)"
                        + excl_clause +
                        " ORDER BY w.date DESC, w.created_at DESC, w.id DESC "
                        "LIMIT 1",
                        params,
                    ).fetchone()
                finally:
                    conn2.close()
                if row2 and row2[0] is not None:
                    last_code = type_codes.get(row2[0])
                    if last_code and last_code in rotation:
                        cur_idx = rotation.index(last_code)
                        next_idx = (cur_idx + 1) % len(rotation)
                        candidate = rotation[next_idx]
                        if candidate in days and any(
                                ex.get("name") == exercise_name
                                for ex in slots_of(candidate)):
                            day_code = candidate
                            tr["source"] = "rotation_queue"
            except Exception:
                pass  # any unexpected error -> fall through to file-order scan

        if day_code is None:
            # Last-resort fallback: first rotation day whose slots include this
            # exercise. Reached when rx is unavailable, rotation state is
            # unresolvable, or the rotation-resolved day lacks this exercise
            # (substitution session). Preserves pre-fix behavior for those cases.
            for code in rotation:
                if any(ex.get("name") == exercise_name for ex in slots_of(code)):
                    day_code = code
                    tr["source"] = "file_order"
                    break

    if day_code is None:
        if tr["source"] != "db_error":
            tr["source"] = "unresolved"
        return None, None, None, None, None

    tr["day"] = day_code

    exercises = slots_of(day_code)
    total = len(exercises)
    for i, ex in enumerate(exercises, start=1):
        if ex.get("name") == exercise_name:
            return day_code, exercises, ex, i, total
    return day_code, exercises, None, None, total


def fetch_current_sets(db_path, session_id, exercise_name):
    """All logged rows for (session, exercise). Returns list of dicts sorted
    with ramp/primer (set_seq<=0) first (ascending magnitude), then working
    sets (set_seq>=1) ascending."""
    conn = sqlite3.connect(db_path)
    try:
        rows = conn.execute(
            "SELECT set_seq, weight_kg, reps, rir FROM workout_sets "
            "WHERE session_id = ? AND exercise_name = ?",
            (session_id, exercise_name),
        ).fetchall()
    except sqlite3.OperationalError:
        rows = []
    finally:
        conn.close()
    sets = [{"set_seq": r[0], "weight_kg": r[1], "reps": r[2], "rir": r[3]}
            for r in rows]
    # ramp (<=0) first by proximity to the working sets (0, -1, -2 -> bw,r1,r2),
    # then working sets ascending.
    #
    # A3: the ramp band is now BOUNDED BELOW by PREP_SEQ_BASE. A prep drill is a
    # row in this same table (D1) at set_seq <= -100, and it is a different KIND
    # -- letting it fall through the old open-ended `<= 0` filter would render a
    # 발목 도르시플렉션 drill as ramp rung "r100" of the deadlift ladder. Prep
    # rows are read by fetch_prep_sets() below. Both filters stay inside the
    # single `set_seq >= 1` volume line, so no aggregate moves.
    ramps = sorted([s for s in sets
                    if PREP_SEQ_BASE < s["set_seq"] <= 0],
                   key=lambda s: -s["set_seq"])   # 0, -1, -2, ...
    work = sorted([s for s in sets if s["set_seq"] >= 1],
                  key=lambda s: s["set_seq"])
    return ramps, work


def fetch_prep_sets(db_path, session_id, exercise_name):
    """Logged PREP rows for (session, exercise), p1 first.

    D1 (2026-08-25, raised twice -- 06:28 and again 07:06): each mat-prep drill
    must be treated as a set, with a progress-table row and a proper cue.
    Prep drills used to produce nothing at all: no row, no table line, no
    prescription. The 06:31 lat-pulldown prep alone ran 8m26s and left no trace.
    They are rows now, in the prep band, and this is how the table reads them
    back. Returns a list of dicts in the same shape as fetch_current_sets."""
    conn = sqlite3.connect(db_path)
    try:
        rows = conn.execute(
            "SELECT set_seq, weight_kg, reps, rir FROM workout_sets "
            "WHERE session_id = ? AND exercise_name = ? AND set_seq <= ?",
            (session_id, exercise_name, PREP_SEQ_BASE),
        ).fetchall()
    except sqlite3.OperationalError:
        rows = []
    finally:
        conn.close()
    return sorted(
        [{"set_seq": r[0], "weight_kg": r[1], "reps": r[2], "rir": r[3]}
         for r in rows],
        key=lambda s: -s["set_seq"])      # -100, -101, ... -> p1, p2, ...


def planned_prep_rows(drills):
    """prep.yaml drill items -> planned PREP table rows, in declared order.

    Each row: {set_seq, label, display, code, weight_kg, target_reps,
               hold_sec, prescribed}
    `prescribed` is False when the drill carries NO owner-stated target -- and
    that case is NOT filled in. prep.yaml's own contract is that an absent
    number renders as ABSENT, never as a default and never as a plausible guess
    (the 헤일로 "원판 6kg" invention is the entry that put that rule there). So
    an unprescribed drill still gets a row and still gets a keyboard; its target
    cell renders `?`, which is a question the owner can answer in one word --
    not a blank they have to interpret. See build_grid's wt/reps cells.

    Reads only what the item declares. Never raises; a bad list -> []."""
    out = []
    if not isinstance(drills, list):
        return []
    idx = 0
    for d in drills:
        if not isinstance(d, dict):
            continue
        spec = prep_target_spec(d)
        reps = spec["value"]
        hold = spec["hold_sec"]
        load = d.get("load_kg")
        out.append({
            "set_seq": prep_seq(idx),
            "label": "p%d" % (idx + 1),
            "code": d.get("code"),
            "display": d.get("display"),
            "implement": d.get("implement"),
            "weight_kg": load,
            "target_reps": reps,
            # 2026-08-27: the UNIT travels with the value everywhere the value
            # goes. A consumer that reads target_reps alone is reading one of
            # four units and cannot tell which.
            "target_unit": spec["unit"],
            "target_token": spec["token"],
            "hold_sec": hold,
            "prescribed": spec["prescribed"],
        })
        idx += 1
    return out


def session_history(db_path, exercise_name, per_side, session_id):
    """Per-session trend points for this exercise, oldest->newest, up to
    TREND_MAX_SESSIONS. Each point = (top-set e1RM, session working volume).
    Working sets only (weight_kg NOT NULL). per_side doubles the volume.

    C13 (owner-confirmed 2026-07-31): the trend aggregates only sessions of the
    SAME split (session_type_id) as the current session, so a like-named
    exercise logged under a different day -- or a substitution session -- can't
    distort the comparison (e.g. 뒷B is compared against 뒷B only). If the
    current session is untagged (session_type_id NULL), no split filter is
    applied and it falls back to all sessions for this exercise."""
    conn = sqlite3.connect(db_path)
    try:
        # Resolve the current session's split for the like-for-like filter.
        stype_id = None
        try:
            r = conn.execute(
                "SELECT session_type_id FROM workouts WHERE id = ?",
                (session_id,),
            ).fetchone()
            stype_id = r[0] if r else None
        except sqlite3.OperationalError:
            stype_id = None

        if stype_id is not None:
            srows = conn.execute(
                """
                SELECT ws.session_id, w.date, w.created_at
                FROM workout_sets ws JOIN workouts w ON w.id = ws.session_id
                WHERE ws.exercise_name = ? AND ws.weight_kg IS NOT NULL
                  AND ws.set_seq >= 1
                  AND w.session_type_id = ?
                GROUP BY ws.session_id
                ORDER BY w.date DESC, w.created_at DESC, ws.session_id DESC
                LIMIT ?
                """,
                (exercise_name, stype_id, TREND_MAX_SESSIONS),
            ).fetchall()
        else:
            srows = conn.execute(
                """
                SELECT ws.session_id, w.date, w.created_at
                FROM workout_sets ws JOIN workouts w ON w.id = ws.session_id
                WHERE ws.exercise_name = ? AND ws.weight_kg IS NOT NULL
                  AND ws.set_seq >= 1
                GROUP BY ws.session_id
                ORDER BY w.date DESC, w.created_at DESC, ws.session_id DESC
                LIMIT ?
                """,
                (exercise_name, TREND_MAX_SESSIONS),
            ).fetchall()
        session_ids = [r[0] for r in srows][::-1]   # flip to oldest->newest
        _ctx = _AL.context(db_path) if _AL is not None else None
        _assisted = bool(_ctx and _ctx.is_assisted(exercise_name))
        points = []
        for sid in session_ids:
            wrows = conn.execute(
                "SELECT weight_kg, reps, rir FROM workout_sets "
                "WHERE session_id = ? AND exercise_name = ? "
                "AND weight_kg IS NOT NULL "
                "AND set_seq >= 1",
                (sid, exercise_name),
            ).fetchall()
            if not wrows:
                continue
            # top set = HARDEST working set (tie -> most reps).
            # ASSIST INVERSION: on an assist stack the number is the
            # counterweight, so the hardest set is the LOWEST one --
            # `max(weight)` was picking the most-assisted (easiest) set and
            # feeding its e1RM to the trend.
            if _AL is not None and _assisted:
                top = max(wrows, key=lambda r: (-r[0], r[1]))
            else:
                top = max(wrows, key=lambda r: (r[0], r[1]))
            e = e1rm(top[0], top[1], top[2])
            # ASSIST INVERSION: volume unit is
            # (bodyweight_at_the_time - counterweight) x reps. `or 0.0` covers
            # the unmeasurable case (no bodyweight reading at all), matching
            # how a NULL weight_kg row is already skipped by the query.
            if _AL is not None and _assisted:
                _date = _ctx.session_date(sid)
                vol = sum(_AL.set_volume(_ctx, exercise_name, r[0], r[1], _date)
                          or 0.0 for r in wrows)
            else:
                vol = sum(r[0] * r[1] for r in wrows)
            if per_side:
                vol *= 2
            points.append((e, vol))
        return points
    except sqlite3.OperationalError:
        return []
    finally:
        conn.close()


def muscle_line(db_path, exercise_name, rest_sec):
    """Header line 3 names primary muscles and any secondary muscles."""
    _use_tax_db(db_path)
    conn = sqlite3.connect(db_path)
    try:
        rows = conn.execute(
            "SELECT muscle, role FROM exercise_muscle WHERE exercise_name = ?",
            (exercise_name,),
        ).fetchall()
    except sqlite3.OperationalError:
        rows = []
    finally:
        conn.close()
    from ui_labels import muscle_ko
    primary = "/".join(muscle_ko(m, db_path) for m, role in rows if role == "primary") or "-"
    secondary = "/".join(muscle_ko(m, db_path) for m, role in rows if role == "secondary")
    return "부위: %s%s" % (primary, " · 보조근 %s" % secondary if secondary else "")


def _fmt_rir(rir):
    """RC1: render a target RIR value. rx-calc emits [lo, hi] (a range) or a
    bare int, or None (not derivable). None/empty -> "" (blank, never invented).
    A [lo, hi] pair renders 'lo-hi'; a collapsed pair (lo==hi) or a scalar
    renders the single number."""
    if rir is None:
        return ""
    if isinstance(rir, (list, tuple)):
        if not rir:
            return ""
        if len(rir) >= 2 and rir[0] != rir[1]:
            return "%s-%s" % (rir[0], rir[1])
        return str(rir[0])
    return str(rir)


def reps_cell(actual, target):
    """The REPS cell for ONE row -- the D4 fix, and the reason the column shape
    did NOT grow a sixth column.

    D4, measured 06:40:39: the deadlift entry table rendered
    `|  bw |  20.0kg |   6  |  4+ | [ ] |` where the `6` is a TARGET,
    indistinguishable from a logged 6. The owner tapped the keyboard at
    06:41:03, saw no visible refresh, and 17 seconds later typed
    `웜업기록됐나?`. The only delta on logging was `[ ]`->`[v]` and the RIR
    cell going BLANK -- so a logged row carried strictly LESS information than
    an unlogged one. That inversion is the bug.

    THE RULE: a cell shows the TARGET until the row is logged; once logged it
    shows the MEASUREMENT, and it shows `actual/target` whenever the two
    DIFFER. So the target is never lost -- either it is still on screen next to
    the actual, or it is identical to the actual and nothing was lost by
    printing one number. Combined with the RIR rule below (a logged row falls
    back to its PRESCRIBED RIR instead of blanking), a logged row now carries
    strictly MORE than an unlogged one, which is the invariant D4 violated.

    WHY NOT A SEPARATE TGT COLUMN. The obvious shape -- SET|WT|REPS|TGT|RIR|ST
    -- is the one that reads best on a desktop and the one that breaks on the
    device this table is actually read on. The grid is 36 columns and lives in
    a Telegram code block on a phone; a sixth column takes it past 43 and the
    block soft-wraps, at which point EVERY row is misaligned and the table
    stops being a table. A wrapped grid is a worse defect than the one being
    fixed, and it is worse for every row rather than for logged rows only. The
    5-column shape stays; the two cells that were ambiguous carry the
    distinction themselves, and the ST column (`[ ]` vs `[v]`) remains the
    plain statement of which reading applies."""
    if actual is None:
        return UNKNOWN_CELL if target is None else str(target)
    if target is None or str(target) == "" or str(actual) == str(target):
        return str(actual)
    return "%s/%s" % (actual, target)


def prep_reps_cell(actual, target):
    """reps_cell for a PREP row.

    Identical to reps_cell except for ONE case that only prep can produce: a
    LOGGED drill that never had a prescribed value (prep.yaml states no
    target_reps). Such a row stores PREP_UNPRESCRIBED_REPS, and rendering that
    as the numeral `0` would read as a set the owner failed. It is not a
    measurement at all, so it renders `-` -- the same glyph this grid already
    uses in the RIR column for "KNOWN not to apply", as distinct from `?`
    ("unknown").

    THE UNIT IS DELIBERATELY NOT RENDERED HERE. The REPS column is 6 display
    columns inside a 36-column phone code block, and a logged row already spends
    that budget on the `actual/target` composite; `10/side` alone overflows it
    and a wrapped grid is a worse defect than the one it would fix (see
    reps_cell's own note on why there is no sixth column). The unit travels on
    the MACHINE lines instead -- PREP_SET / PREP_TAP carry
    `target=<n> unit=<unit>` -- which is where the completion tap is decided.
    Rendering it in the grid too is a separate ticket with a real width problem
    to solve first."""
    if actual is not None and target is None and int(actual or 0) == \
            PREP_UNPRESCRIBED_REPS:
        return "-"
    return reps_cell(actual, target)


# A cell whose value is genuinely not known renders THIS, never an empty cell.
#
# D5, verbatim 07:09:29: "(표 WT칸은 방금 등록 반영 전 스냅샷이라 비어 보이지만,
# 실제 적용 무게는 위에 안내한 70kg입니다.)" -- a sentence of prose excusing a
# wrong table. It then recurred SILENTLY (blank, no excuse) at
# standing_calf_raise 08:12:53 and 08:14:59, which is what an excuse buys you.
#
# An empty cell is unreadable in both directions: it can mean "no load applies"
# (a bodyweight primer) or "we failed to resolve one", and the owner cannot tell
# which. So the two are now different glyphs -- `bw` for the first, `?` for the
# second -- and the render emits a WT_UNKNOWN signal naming the rows, so the
# gap is a thing to fix rather than a thing to narrate around.
UNKNOWN_CELL = "?"

# ...and the THIRD state, which `?` had swallowed. D29, owner 07:28 asked what
# the `?` meant, over a wall_sit table whose every WT and RIR cell read `?`:
#
#     | 1 |  ? | 45 |  ? | [v] |
#     | 2 |  ? | 45 |  ? | [ ] |
#
# One glyph was covering three different facts:
#     미정      not decided yet          -> `?`  correct, and it STAYS
#     맨몸      the load is zero         -> `bw`
#     해당없음  the axis does not exist  -> `-`
# `?` reads as "something you still owe me", so it sent the owner looking for
# a number that was never missing -- and on a hold set the RIR number does not
# exist at all.
#
# NEITHER GLYPH IS NEW AND NEITHER INVENTS A VALUE. `bw` is what wt_cell()
# already prints for the identical physical state one band higher (the same
# session's v_squat bodyweight rung rendered `bw` correctly while wall_sit's
# working rows rendered `?`), and `-` is what the prep rows above already use,
# for this exact reason, in this exact function: "a blank means 'unknown', and
# this is KNOWN not to apply". Nothing about the prescription changes; a cell
# that had no number still has no number.
NOT_APPLICABLE_CELL = "-"


def slot_axis_is_bodyweight_hold(slot):
    """True when this slot is a DECLARED bodyweight isometric hold -- i.e. its
    load is zero by prescription (not unresolved), and it has no RIR axis at all
    (its rep_range is SECONDS of hold, so there is no rep-based reserve to
    report).

    DELEGATES to rx-calc._is_isometric_hold. That predicate is the one place
    this shape is declared -- resolve_rest_sec skips the load proxy on it and
    resolve_target_rir returns None on it -- so re-deciding "is this a hold?"
    here would be a second opinion about a slot the engine has already
    classified, and the two would drift the way D15's three rep-target copies
    did.

    The `weight_kg is None` conjunct is load-bearing, not belt-and-braces: a
    LOADED isometric (a weighted plank, declared `isometric: true` with a real
    weight_kg) is a hold whose WT cell must print its number. This helper only
    ever speaks about a slot with no number to print.

    DEGRADE, never raise (the _drill_display / _rir_header house rule): a
    sandboxed subset tree with no rx-calc returns False, which is the
    pre-existing behaviour -- `?`. A helper miss must never be the reason a
    table cannot render."""
    if not isinstance(slot, dict):
        return False
    if slot.get("weight_kg") is not None:
        return False
    try:
        return bool(load_rx_calc()._is_isometric_hold(slot))
    except Exception:  # noqa: BLE001 -- no rx-calc -> the old glyph, not a crash
        return False


def build_grid(slot, ramps, work, rx_weight=None, rx_target_rir=None,
               rx_sets=None, override=None, planned_ramp=None,
               bar_primer=False, rir_header=None, planned_prep=None,
               preps=None, exercise_closed=False, show_rir=True,
               rx_target_reps=None):
    """Build the ASCII [세트] grid rows (prep -> ramp -> done -> planned).
    Returns a list of text lines (borders + rows), WT column fixed 9 wide (C17).

    `exercise_closed` (A2, 2026-08-25): True once session-closeout has resolved
    this exercise. Every UNLOGGED row -- prep, warmup, working alike -- then
    renders `[-]` (미실시) instead of `[ ]`. A checkbox that says "still to
    come" on a set the owner has already walked away from is the table lying,
    and it lied for the rest of the session on leg_curl 3/4. See
    exercise_is_closed().

    `planned_prep` / `preps` (A3, 2026-08-25): the slot's planned prep drills
    (planned_prep_rows) and the ones already logged (fetch_prep_sets). A prep
    drill is a SET -- same table, same keyboard, same [ ]/[v] -- per the
    derivation table at the top of this file. They render FIRST because that is
    when they are performed. Both default to None, in which case the grid is
    byte-identical to the pre-prep output.

    `bar_primer` (2026-08-21): True iff THIS exercise's set_seq==0 primer rung
    is an EMPTY BARBELL, not bodyweight -- resolved by render() through the
    shared ax_engine.is_plate_loaded gate. See wt_cell() below for why that
    distinction has to reach the WT column.

    RC1 (display-truthfulness): planned target weight and target RIR are the
    SINGLE-SOURCE rx-calc prescription for TODAY (rx_weight / rx_target_rir),
    NOT the program.yaml slot snapshot -- program.yaml weight_kg is only the
    owner's starting SEED (nothing writes it after program-init; since program
    state step A rx-calc starts from the last LOGGED load), so reading it
    directly shows a STALE load once anything was lifted (E22), and its
    slot dict carries no target_rir so RIR came out blank (E11). Both now route
    through rx-calc. A None rx_weight (calibration / first session) renders
    weight-free (no placeholder, no invent); a None rx_target_rir renders blank.

    F6/RC1-ext: the NUMBER of planned rows (total working sets) is likewise the
    rx-calc prescription for TODAY (rx_sets, already fatigue-trimmed), not the
    program.yaml static slot count. A trimmed exercise (program.yaml 4, today 3)
    must render 3 rows so the table matches what set-arm arms (F14) and what the
    owner actually performs. None rx_sets -> fall back to the program.yaml slot
    count (rx miss / instances without the muscle table).

    G12 (owner-confirmed 2026-08-07): planned_ramp is the warmup+ramp ladder
    (list of {weight_kg, label} dicts, ascending) computed by planned_ramp_rows().
    Planned ramp rows that have already been logged (present in ramps by position)
    are shown with actual weight + [v]. Remaining planned rows are shown with
    planned weight + [ ]. When planned_ramp is empty or None, ramp rendering
    falls back to the existing logged-only behavior.

    `rir_header` (2026-08-24 label revert) is the RESOLVED owner-facing name of
    the RIR column, passed in by the caller so the lookup happens once per run
    at the render entry point rather than inside this builder. None means "ask
    the resolver here" -- the honest default for the direct callers (tests,
    other tools) that have no render() above them; it is still the same
    resolver, never a literal."""
    if rir_header is None:
        rir_header = _rir_header()
    # D29: resolved ONCE per render, not per cell -- the predicate loads
    # rx-calc, and a table has up to a dozen working rows.
    _bw_hold = slot_axis_is_bodyweight_hold(slot)
    columns = tuple(c for c in ("SET", "WT", "REPS", "RIR", "ST")
                    if c != "RIR" or show_rir)
    border = "+" + "+".join("-" * COL_W[c] for c in columns) + "+"

    def row(set_lbl, wt, reps, rir, st):
        cells = dict(zip(("SET", "WT", "REPS", "RIR", "ST"),
                         (set_lbl, wt, reps, rir, st)))
        return "|" + "|".join(ctr(cells[c], COL_W[c]) for c in columns) + "|"

    def wt_cell(weight_kg, is_bar_rung):
        """WT cell for ONE ramp/primer row.

        A NULL weight_kg is the schema's "no external load" sentinel and is
        shared by TWO physically different things (this is the whole defect):
          * a genuine BODYWEIGHT primer -- 맨몸 v_squat / single_leg_extension
            primer, wall_sit, leg_raise. Nothing is loaded. -> "bw", correct.
          * the EMPTY-BAR primer of a barbell lift -- deadlift / barbell_row /
            pendlay_row. the user is holding a real 20kg olympic bar. Rendering that
            as "bw" (bodyweight) is simply false, and it contradicted the cue,
            which already says "빈 봉 x8" per warmup-stretch.md.
        The row itself cannot tell them apart -- both are (set_seq==0, NULL) --
        so the disambiguator is the EXERCISE (`bar_primer` = the shared
        ax_engine.is_plate_loaded gate: compound+freeweight AND a plate lattice,
        so a FIXED-DUMBBELL press is excluded), exactly like
        ax_engine._ramp_row_is_empty_bar keys on the tag and never on the weight
        alone -- a machine rung can legitimately BE 20.0kg with no bar existing.

        The bar rung renders its true load, `20.0kg` (_RAMP_EMPTY_BAR_KG, the
        shared ax_engine.EMPTY_BAR_KG constant). ASCII on purpose: the (2)
        format lock in reference/progress-tables.md allows Korean in the
        rightmost 비고 column ONLY -- a "빈봉" token in an aligned column would
        break the padding (CJK glyph width). The barbell-vs-machine distinction
        the F6-ext comment below protects is preserved by the SET label column,
        which still reads "bw" for a bar rung and "rN" for a machine rung.

        DISPLAY ONLY. No stored value changes, and no volume/tonnage figure is
        derived from this string -- every volume query is set_seq >= 1, so ramp
        and primer rows are outside the volume unit by design (and correctly so:
        they are prescribed RIR 4+, nowhere near failure -- see
        knowledge/kimwog/items/exercise-set-counting-volume-unit-009.md)."""
        if weight_kg is not None:
            return fmt_kg(weight_kg)
        return fmt_kg(_RAMP_EMPTY_BAR_KG) if is_bar_rung else "bw"

    def work_wt_cell(weight_kg):
        """WT cell for a WORKING row (logged or planned) -- D5.

        A working set has a load by definition; the schema's NULL is the
        calibration/weight-free sentinel, but on the render side an unresolved
        number and a genuinely absent one had collapsed into the SAME empty
        cell, and the model papered over the difference in prose. They are
        different glyphs now: a resolved weight prints; an unresolved one prints
        `?`. Nothing is invented and nothing is blank.

        D29 (2026-09-02) finishes that split on this band. "The load is zero by
        prescription" is a THIRD state, and it had been landing on `?` -- so
        wall_sit, a declared 맨몸 아이소메트릭, asked the owner for a weight it
        is defined as not having, in the same session where the v_squat rung one
        band up rendered the identical state as `bw`. One state, two glyphs.
        A slot that is NOT a declared bodyweight hold keeps `?` exactly as
        before: there, the number really is unresolved."""
        if weight_kg is not None:
            return fmt_kg(weight_kg)
        return "bw" if _bw_hold else UNKNOWN_CELL

    # RC1: today's prescription (rx-calc) is the sole source for planned target
    # weight/RIR. The program.yaml slot dict is used ONLY for the non-prescribed
    # structural fields (rep_range top, sets count).
    target_rir_str = _fmt_rir(rx_target_rir)
    # D15: the rep target comes from the ONE resolver (rep_target), never from a
    # local copy of the planned-row rule. The inline expression that used to sit
    # here was one of three copies; see the rep_target() block for the incident.
    target_top_rep = rep_target(slot).get("top")
    # 2026-09-30: today's rx-calc rep target wins over the static rep_range top
    # -- it is the number that moved with today's load (e1RM path: reps at the
    # rounded load; progression 'up': the range bottom). None -> the old rule.
    if rx_target_reps is not None:
        target_top_rep = rx_target_reps
    slot_weight = rx_weight
    # F6/RC1-ext: planned-row count = today's rx-calc prescribed sets (trimmed);
    # program.yaml slot count only as fallback (rx miss / no muscle table).
    total_sets = (rx_sets if rx_sets is not None else slot.get("sets")) or 0

    # F19/F21: overlay the owner's mid-session target override onto the PLANNED
    # target weight / reps / RIR (and the completed-row RIR default-fill), so the
    # remaining/upcoming rows show the SAME new target the re-fired push carries.
    # A missing override key keeps the rx-calc/program derivation (partial
    # override -- F21 supplies weight only). display is handled in render().
    ov = override or {}
    # D1: the weight overlay is the SHARED rule (apply_override_weight), the same
    # one resolve_today_weights uses -- so the grid's WT column and the 표3 card /
    # ANCHOR can never disagree about an override. reps/RIR stay grid-local.
    slot_weight = apply_override_weight(slot_weight, ov)
    if ov.get("reps") is not None:
        target_top_rep = ov["reps"]
    if ov.get("rir") is not None:
        target_rir_str = _fmt_rir(ov["rir"])

    # A2: the state an UNLOGGED row renders. Resolved ONCE here rather than at
    # each of the three planned-row sites, so a fourth row type (there already
    # were two more than when this table was written) cannot be added with the
    # old literal.
    _UNDONE = "[·]" if exercise_closed else "[ ]"

    lines = [border, row("SET", "WT", "REPS", "RIR", "ST"), border]

    # Preparation is displayed in the separate movement list. Its drills never
    # enter a lift's set table (owner 2026-09-27 14:47).

    # (a) ramp / primer rows.
    # G12 (owner-confirmed 2026-08-07): when planned_ramp is provided, render the
    # FULL warmup+ramp ladder (planned + done) instead of logged-only. Each planned
    # ramp row shows its computed weight, 5 standard warmup reps, and "4+" RIR --
    # the confirmed ramp-set spec (warmup-stretch.md: RIR 4+). Logged ramp rows
    # (from ramps, by position) replace the planned row at that index with actual
    # weight/reps/rir and [v]. Any logged ramps beyond the planned ladder length
    # (seeded warmup / primer steps without a matching planned row) are appended
    # after the ladder. Falls back to logged-only (original behavior) when
    # planned_ramp is empty or None.
    # RIR anchor read from the shared SoT (ax_engine.RAMP_RIR) -- the same value
    # the engine stamps on each ramp_set item for the spoken cue.
    _RAMP_DEFAULT_RIR = ramp_rir()
    # 5.6: ramp reps TAPER by load (never a constant 5). One reps value per
    # planned row, computed from the ladder + working weight + working top rep.
    _taper = ramp_taper_reps(planned_ramp or [], slot_weight, target_top_rep)
    if planned_ramp:
        for idx, pr in enumerate(planned_ramp):
            if idx < len(ramps):
                # Logged: show actual result.
                #
                # D4: `rir` used to be `"" if r["rir"] is None else ...`, and a
                # ramp row NEVER reports an RIR (set-add writes no --rir on a
                # rung; it is prescribed 4+ by construction). So logging a rung
                # BLANKED its RIR cell -- the row lost the one number it had.
                # The prescribed value did not become unknown by being
                # performed, so it stays. This is the same default-fill rule
                # block (b) already applies to completed working rows, extended
                # to the band that needed it more.
                r = ramps[idx]
                wt = wt_cell(r["weight_kg"],
                             bar_primer and pr.get("label") == "bw")
                rir = (str(r["rir"]) if r["rir"] is not None
                       else _RAMP_DEFAULT_RIR)
                ramp_reps = _taper[idx] if idx < len(_taper) else None
                lines.append(row(set_col_label(pr["label"]), wt,
                                 reps_cell(r["reps"], ramp_reps), rir, "[v]"))
            else:
                # Planned: show computed weight + tapered warmup reps + RIR 4+.
                # The planned empty-bar rung already CARRIES its weight (20.0 =
                # _RAMP_EMPTY_BAR_KG, stamped by planned_ramp_rows), so on a real
                # bar lift it now renders that number -- see wt_cell() for why
                # the blanket "label == 'bw' -> print bw" was wrong (an empty bar
                # is 20kg of steel, not bodyweight).
                # The special-case SURVIVES for `not bar_primer`, and that is
                # deliberate, not leftover: planned_ramp_rows picks the ramp KIND
                # with _is_ramp_exercise (compound+freeweight), which also
                # matches FIXED-DUMBBELL lifts (incline_dumbbell_press), so it
                # stamps them a 20kg "empty bar" rung that does not exist. That
                # is a pre-existing planner defect (the fix is to gate the ramp
                # kind on ax_engine.is_plate_loaded, which changes the prescribed
                # ladder -- out of scope for a display fix). Printing "20.0kg"
                # there would swap the old vague lie for a NEW specific one, so
                # a lift with no bar keeps rendering "bw" exactly as before and
                # this change stays confined to lifts that really have a bar.
                # F6-ext is unaffected: a machine rung already showed its own
                # weight, never "bw", and its SET label stays "rN".
                # ...and `weight_kg is None` is the third condition, added
                # with the 12:07 stack ruling: a STACK 세팅 rung is label `bw`
                # and not a bar, but it carries a REAL pin weight. Printing
                # "bw" (=맨몸) on a 50kg lat-pulldown setting would be the same
                # lie in the other direction. The old two-condition form is
                # preserved exactly for a genuinely weight-free bw rung.
                wt = ("bw" if (pr.get("label") == "bw" and not bar_primer
                               and pr.get("weight_kg") is None)
                      else fmt_kg(pr["weight_kg"]))
                ramp_reps = _taper[idx] if idx < len(_taper) else 5
                lines.append(row(set_col_label(pr["label"]), wt,
                                 str(ramp_reps),
                                 _RAMP_DEFAULT_RIR, _UNDONE))
        # Append any extra logged ramps that exceed the planned ladder (seeded).
        for r in ramps[len(planned_ramp):]:
            seq = r["set_seq"]
            wt = wt_cell(r["weight_kg"], bar_primer and seq == 0)
            rir = str(r["rir"]) if r["rir"] is not None else _RAMP_DEFAULT_RIR
            lines.append(row(set_col_label(seq_label(seq)), wt,
                             str(r["reps"]), rir, "[v]"))
    else:
        # Original behavior: only logged ramp rows, never invented.
        for r in ramps:
            seq = r["set_seq"]
            wt = wt_cell(r["weight_kg"], bar_primer and seq == 0)
            rir = str(r["rir"]) if r["rir"] is not None else _RAMP_DEFAULT_RIR
            lines.append(row(set_col_label(seq_label(seq)), wt,
                             str(r["reps"]), rir, "[v]"))

    # (b) completed working sets (actual reps only; NULL rir -> today's rx-calc
    #     target_rir default-fill if derivable, else blank. SKILL RIR default-
    #     fill carve-out ("RIR 미보고 = 목표 RIR 충족", owner-defined default) --
    #     RIR column ONLY; the reps column is always the logged measurement.
    #     E11 close: back-squat completed row no longer blank when rx derives RIR.)
    for s in work:
        # D5: a NULL weight on a WORKING row is `?`, never an empty cell. See
        # work_wt_cell -- "we do not know" and "no load applies" stopped being
        # the same glyph, so no sentence of prose has to tell them apart.
        # D4: the target reps ride alongside the measured reps whenever they
        # differ, so the prescription survives being performed.
        wt = work_wt_cell(s["weight_kg"])
        rir = str(s["rir"]) if s["rir"] is not None else target_rir_str
        if rir == "":
            # D29: an EMPTY target_rir_str means rx-calc returned None, and None
            # has two causes that are not the same fact. On a hold slot the RIR
            # axis does not exist (resolve_target_rir: "isometric hold stays
            # None -- no floor can manufacture an RIR for a slot that has no
            # rep-based RIR to begin with"); anywhere else it really is
            # unresolved. `-` vs `?`, the distinction the prep band above makes.
            rir = NOT_APPLICABLE_CELL if _bw_hold else UNKNOWN_CELL
        lines.append(row(str(s["set_seq"]), wt,
                         reps_cell(s["reps"], target_top_rep), rir, "[v]"))

    # (c) planned working sets still to do (target weight/top-rep/target-RIR).
    # Target weight = today's rx-calc prescription (RC1); unresolved -> `?`
    # (D5), never a blank cell and never an invented number.
    done_working = len(work)
    for n in range(done_working + 1, (total_sets or 0) + 1):
        wt = work_wt_cell(slot_weight)
        lines.append(row(str(n), wt, reps_cell(None, target_top_rep),
                         target_rir_str
                         or (NOT_APPLICABLE_CELL if _bw_hold  # D29
                             else UNKNOWN_CELL),
                         _UNDONE))

    lines.append(border)
    return lines


def fetch_prescription(rx, program_path, today, db_path, session_id,
                       rotation_day=None):
    """RC1: run rx-calc ONCE for today and build a name -> prescription map so
    set-table displays TODAY's prescribed weight/RIR, not the stale program.yaml
    snapshot. exclude_session_id = the current open session so rx never reads its
    own partial sets as prior evidence (same M-5 discipline rx-calc uses).
    Returns {exercise_name: {weight_kg, target_rir}}. Any rx failure (bad path,
    calibration SystemExit) degrades to {} so the caller falls back to no
    prescription (blank planned weight) rather than crashing the live table.

    rotation_day (2026-08-23): the split THIS session is actually training, as
    already resolved by find_day_and_slot. Without it rx-calc answers with the
    rotation QUEUE's next REGULAR day, so in a 보충 session the returned map was
    keyed on a different day's exercises entirely, every lookup below missed,
    and the 표2 WT column rendered blank on a LIVE session with nothing yet
    completed. Forwarded as calc_rx(rotation_day_override=...); rx-calc ignores
    a value that is not a program day key, so a stale/odd value can only
    degrade to the old behaviour, never produce a wrong prescription."""
    try:
        result = rx.calc_rx(program_path, today, db_path,
                            exclude_session_id=session_id,
                            rotation_day_override=rotation_day)
    except SystemExit:
        return {}
    except Exception:
        return {}
    out = {}
    for ex in (result.get("exercises") or []):
        name = ex.get("name")
        if name:
            out[name] = {"weight_kg": ex.get("weight_kg"),
                         "target_rir": ex.get("target_rir"),
                         # F6/RC1-ext: today's prescribed working-set count is
                         # the SINGLE source for the number of planned rows --
                         # calc_rx's 'sets' is already fatigue-trimmed (DGN-316
                         # 6.3), so a trimmed exercise (e.g. 4->3) renders 3
                         # planned rows, not the stale program.yaml 4.
                         "sets": ex.get("sets"),
                         # 2026-09-30: the rep target that moves with the load,
                         # and which basis (e1rm | progression) produced it.
                         "target_reps": ex.get("target_reps"),
                         "rx_basis": ex.get("rx_basis")}
    return out


def session_today(db_path, session_id):
    """The session's own date (YYYY-MM-DD) drives rx-calc's 'today' so the
    prescription matches this session, not the wall clock. Falls back to the
    system date if the row/column is absent."""
    conn = sqlite3.connect(db_path)
    try:
        row = conn.execute(
            "SELECT date FROM workouts WHERE id = ?", (session_id,)
        ).fetchone()
        if row and row[0]:
            return str(row[0])
    except sqlite3.OperationalError:
        pass
    finally:
        conn.close()
    import datetime
    return datetime.date.today().isoformat()


# ---------------------------------------------------------------------------
# D1 (2026-08-24): THE single source of truth for "today's working weight".
#
# Today's working weight used to be resolved twice, by two different rules:
#   * 표2 grid / SET_CUE / rest-over push  -> rx-calc prescription for TODAY,
#     overlaid with the owner's mid-session override  (correct)
#   * 표3 progress card / ANCHOR / pinned  -> the RAW program.yaml slot's
#     weight_kg                     (the SEED -- nothing writes it back; the
#     progression base is the last LOGGED load, program state step A)
# so a session where progression advanced showed BOTH numbers in the SAME
# message (deadlift 140.0kg in the table, 135kg on the card and in the pinned
# ANCHOR note). Two ledgers for the one number the owner loads onto the bar.
#
# The rule now lives here, once. Every surface that has to NAME today's working
# weight calls resolve_today_weights(); nobody re-derives it, and nobody reads
# slot["weight_kg"] as "today" ever again. If you find yourself adding a second
# weight resolution, that is the bug coming back.
# ---------------------------------------------------------------------------

def apply_override_weight(weight_kg, override):
    """Overlay the owner's persisted mid-session weight override (F19/F21) onto
    a resolved target weight. ONE rule, shared by the 표2 grid (build_grid) and
    resolve_today_weights, so the grid and the card can never disagree about
    whether an override is in force. A missing/partial override keeps the
    rx-calc derivation. Never raises."""
    ov = override or {}
    ov_wt = ov.get("weight_kg") if isinstance(ov, dict) else None
    return ov_wt if ov_wt is not None else weight_kg


# ---------------------------------------------------------------------------
# D15 (2026-09-02): THE single source of truth for "this slot's rep target".
#
# The rep target used to be derived THREE times, by three copies of the same
# arithmetic that nobody could see side by side:
#   * set-table build_grid   -> `rep_range[1] if len>=2 else rep_range[0]`
#   * set-arm  _fmt_reps     -> the same expression, re-typed, with a docstring
#                               that says "mirroring set-table's planned-row
#                               rule" -- i.e. the copy KNEW it was a copy
#   * exercise-enter card    -> `"%s-%s회" % (rr[0], rr[1])`, the RANGE form
# so one slot spoke three dialects of the same number in one session: the table
# said 10, the arm spec said 10, the card said 8-10, and the model -- with no
# single line to echo -- invented 6-8 (owner 2026-09-02: the card said 6-8, the cue said 10, and
# the buttons offered 8-12).
#
# The rule now lives here, once. Every surface that has to NAME this slot's rep
# target calls rep_target(); nobody re-derives it. Same treatment, and for the
# same reason, as resolve_today_weights() above did for the weight.
#
# It DECIDES NOTHING about the prescription: lo/hi are program.yaml's own
# rep_range verbatim, and `top` reproduces the pre-existing planned-row rule
# byte for byte. Changing WHICH of these a given surface prints is an owner
# call, not a refactor -- this function only makes it impossible for two
# surfaces to compute the answer differently.
# ---------------------------------------------------------------------------

def rep_target(slot, override=None):
    """THE rep-target resolver for one program.yaml slot.

    Returns a dict -- never None, never raises:
        lo      int|None  -- the plan's rep_range floor, verbatim
        hi      int|None  -- the plan's rep_range ceiling, verbatim
        top     int|str   -- the planned-row scalar ('' when absent), VERBATIM
                             from the plan (an int stays an int). This is the
                             pre-existing rule: rep_range[1], falling back to
                             rep_range[0] on a 1-element range. An override
                             `reps` wins (F19/F21), exactly as before.
        top_str str       -- str(top), '' when absent -- the form the arm spec
                             line and the reps window want.
        range_label str   -- 'lo-hi' ('' when there is no 2-element range)
        overridden  bool  -- the owner's mid-session reps override is in force

    Types are preserved deliberately: the grid renders `top` and the arm
    renders `top_str`, and both did so BEFORE this resolver existed. A resolver
    that quietly restringifies one surface's cell is a display change wearing a
    refactor's clothes.
    """
    rr = (slot or {}).get("rep_range") if isinstance(slot, dict) else None
    if not isinstance(rr, (list, tuple)):
        rr = []
    lo = rr[0] if len(rr) >= 1 else None
    hi = rr[1] if len(rr) >= 2 else None
    if len(rr) >= 2:
        top = rr[1]
    elif len(rr) == 1:
        top = rr[0]
    else:
        top = ""
    # EXACTLY two -- the pinned card's pre-existing guard. A 3+ element range is
    # malformed data and printed nothing before; it prints nothing now.
    range_label = ("%s-%s" % (lo, hi)) if (len(rr) == 2) else ""
    ov = override if isinstance(override, dict) else {}
    overridden = ov.get("reps") is not None
    if overridden:
        top = ov["reps"]
    return {"lo": lo, "hi": hi, "top": top,
            "top_str": ("" if top == "" or top is None else str(top)),
            "range_label": range_label, "overridden": overridden}


# ---------------------------------------------------------------------------
# D18 (2026-09-02): THE reader for a slot's `unilateral` block.
#
# program.yaml has carried a structured {mode, weak_side_first, weak_side} block
# on every unilateral slot since #24/#25, and it is authoritative. The CUE path
# (exercise-enter.extract_record_params) read it and spoke it correctly; the
# INPUT path never read it at all. So on 2026-09-02 the same slot, two minutes
# apart, said:
#     07:07 cue    "오른쪽은 왼쪽 횟수에 맞춰서, 기록은 한 번에"
#     07:09 input  "몇 개 하셨어요? (좌우 각각, 예: 15개씩)"
# The value was present and correct both times. What was missing was a second
# reader -- so the input path composed its own answer.
#
# One normalizer, both consumers. Adding a third consumer means calling this,
# not re-reading the dict.
# ---------------------------------------------------------------------------

# The recorded mode (owner-confirmed 2026-07-18, workout-session
# reference/hold-unilateral.md): both sides are performed and ONE set-result
# entry covers both. Not a rest boundary, not two records.
UNILATERAL_ONE_RECORD = "both_one_record"


def unilateral_spec(slot):
    """Normalized view of one slot's `unilateral` block. Never raises.

    Returns:
        declared        bool      -- the explicit program.yaml field is present
        mode            str|None  -- the declared performance mode, verbatim
        weak_side_first bool
        weak_side       str|None  -- 'left'|'right' when on record
        one_record      bool      -- mode == both_one_record: both sides, ONE
                                     set-result entry. The input path must ask
                                     for ONE number, never for a per-side pair.

    Absent field -> declared=False and every flag off. This function does NOT
    do the prose keyword fallback: that is exercise-enter's degraded path for
    an unregistered JIT slot, and inferring a performance mode from prose is
    exactly what #24/#25 removed from the registered ones.
    """
    uni = (slot or {}).get("unilateral") if isinstance(slot, dict) else None
    if not isinstance(uni, dict):
        return {"declared": False, "mode": None, "weak_side_first": False,
                "weak_side": None, "one_record": False}
    mode = uni.get("mode")
    mode = str(mode) if mode else None
    side = uni.get("weak_side")
    return {"declared": True,
            "mode": mode,
            "weak_side_first": bool(uni.get("weak_side_first")),
            "weak_side": (str(side) if side else None),
            "one_record": (mode == UNILATERAL_ONE_RECORD)}


# ---------------------------------------------------------------------------
# THE EXECUTION MODE (2026-09-11, incident B). THE ANSWER IS A VALUE.
#
# MEASURED, the SAME exercise and the same three minutes as incident A. The
# model announced a switch to single-leg execution on standing_calf_raise. The
# owner: 「아니그거 시티드였는데.. 스탠딩은 양발이야」.
#
# THERE IS NO DATA ANYWHERE THAT SUGGESTS IT. program.yaml declares `unilateral`
# on exactly one slot in the whole file (single_leg_extension) plus its three
# rotation twins; standing_calf_raise carries no such block. ax_exercise says
# isolation / reps / machine -- nothing about sides. So the assertion was minted
# in prose, and at 115kg 양발 -> 한발 doubles the load per leg.
#
# WHY unilateral_spec WAS NOT ENOUGH. It answers "is there a declaration?" and
# returns declared=False when there is not. Every consumer then reads that as
# ABSENCE and says nothing -- exercise-enter prints `RECORD_PARAMS none`. An
# absence is a vacuum, and this file already learned once what fills a vacuum:
# "the decision is now a VALUE, not an absence" (the RAMP_YES block comment).
# The identical move, one axis over.
#
# THE RULE, in the owner's words: 선언이 없으면 답은 「양측」이다. Not "unknown",
# not "the model decides" -- BILATERAL, positively stated, with its source
# attached so the owner can tell a read from a default and overrule either.
#
# Deliberately NOT here: prose keyword inference. exercise-enter still SCANS
# slot prose, but from this ruling that scan can only produce a HINT beside the
# answer, never the answer (see extract_record_params). Inferring a performance
# mode from prose is what #24/#25 removed from the registered slots; letting it
# back in through the unregistered ones would be the same defect with a smaller
# blast radius, and today it had the biggest one available.
# ---------------------------------------------------------------------------
EXEC_MODE_BILATERAL = "bilateral"       # 양측 -- both limbs, one movement
EXEC_SOURCE_DECLARED = "declared"       # program.yaml said so
EXEC_SOURCE_DEFAULT = "default"         # nothing said so -> the standing answer

# The owner-facing word for each mode. `bilateral` is 양측 and NOT 양발/양팔:
# which limb it is depends on the exercise, and guessing that from an exercise
# name is exactly the class of inference this resolver exists to delete.
EXEC_MODE_KO = {
    EXEC_MODE_BILATERAL: "양측",
    UNILATERAL_ONE_RECORD: "편측(양쪽 다 하고 한 번 기록)",
}


def resolve_unilateral(slot):
    """THE execution-mode answer for one slot. Never raises, never returns None,
    never returns "unknown".

        {"mode": <str>, "declared": bool, "source": EXEC_SOURCE_*,
         "sides": 1|2, "one_record": bool, "weak_side_first": bool,
         "weak_side": str|None, "say": <한국어 한 문장>}

    `mode` is the DECLARED performance mode when program.yaml carries one, and
    EXEC_MODE_BILATERAL otherwise. There is no third outcome: a slot with no
    declaration is bilateral, stated as such, sourced as `default`.

    `sides` is 2 for a declared unilateral mode (both limbs are performed) and 1
    for bilateral -- the count of EXECUTIONS, not of set-result rows. Rows are
    `one_record`'s business and that flag is carried through unchanged from
    unilateral_spec, so the input path keeps asking for one number.

    `say` is the ONE owner-facing sentence, authored here so no consumer has to
    compose one. It names the mode AND its source, because 「선언에서 읽었다」와
    「선언이 없어 기본값을 썼다」는 오너가 반박할 수 있어야 하는 서로 다른 문장이다.

    A thin, total function over unilateral_spec -- that reader stays the single
    place the program.yaml block is parsed. This one only makes its absence
    speak."""
    spec = unilateral_spec(slot)
    if spec["declared"] and spec["mode"]:
        mode = spec["mode"]
        return {"mode": mode, "declared": True,
                "source": EXEC_SOURCE_DECLARED, "sides": 2,
                "one_record": spec["one_record"],
                "weak_side_first": spec["weak_side_first"],
                "weak_side": spec["weak_side"],
                "say": ("%s -- 프로그램에 선언된 수행 방식입니다."
                        % EXEC_MODE_KO.get(mode, mode))}
    return {"mode": EXEC_MODE_BILATERAL, "declared": False,
            "source": EXEC_SOURCE_DEFAULT, "sides": 1,
            "one_record": False, "weak_side_first": False, "weak_side": None,
            "say": ("양측(양쪽 같이) 수행입니다 -- 이 종목엔 편측 선언이 없어서 "
                    "기본값 양측으로 갑니다. 한쪽씩 가실 거면 말씀 주세요.")}


def load_decision_line(session_id, exercise_name):
    """P2 (2026-08-24): the owner-facing sentence for today's load decision, or
    None when the served weight IS the engine's prescription.

    Read-only, and deliberately not a second author: the sentence was composed
    by set-arm.load_decision_say() at the moment the decision was made and
    persisted into the override alongside the weight it explains. This function
    only hands it back. If the number and its reason were composed in two
    places they would eventually say two different things, which is the whole
    class of defect D1 closed for the number itself.

    Best-effort: an unreadable / reason-less override returns None (the table
    renders exactly as before) -- never an invented explanation."""
    ov = read_override(session_id, exercise_name)
    if not isinstance(ov, dict):
        return None
    if ov.get("decision") in (None, "engine"):
        return None
    say = ov.get("say")
    return say.strip() if isinstance(say, str) and say.strip() else None


def resolve_today_weights(rx, program_path, db_path, session_id,
                          exercise_names=None, rotation_day=None):
    """SINGLE SOURCE OF TRUTH: {exercise_name: today's working weight (kg) or
    None} for THIS session, resolved exactly as the 표2 grid resolves it --
    today's rx-calc prescription (keyed on the split actually being trained),
    overlaid with the owner's mid-session override.

    None for an exercise means "no prescribed working weight today" (rx miss /
    bodyweight / uncalibrated stack). That is the HONEST answer and every
    surface must render it the same blank way -- it must NOT be back-filled
    from program.yaml, whose weight_kg is last session's confirmed load.

    exercise_names: restrict the map to these names (missing ones map to the
    override-only answer, usually None). None -> every exercise rx prescribed.

    Best-effort: any resolver failure returns {} so a caller degrades to a
    weight-free render rather than to a WRONG weight."""
    try:
        today = session_today(db_path, session_id)
        rx_map = fetch_prescription(rx, program_path, today, db_path,
                                    session_id, rotation_day=rotation_day)
    except Exception:  # noqa: BLE001 -- never break a render on the resolver
        return {}
    names = list(exercise_names) if exercise_names is not None else list(rx_map)
    out = {}
    for name in names:
        if not name:
            continue
        rx_slot = rx_map.get(name) or {}
        try:
            override = read_override(session_id, name)
        except Exception:  # noqa: BLE001 -- no override readable -> rx answer
            override = {}
        out[name] = apply_override_weight(rx_slot.get("weight_kg"), override)
    return out


