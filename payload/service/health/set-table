CH2_LOG = os.environ.get(
    "WARG_CH2_LOG", os.path.join(STATE_DIR, ".ch2-push.log"))

# One retry, and ONLY after a fast failure. rc=35 (curl SSL connect) returns in
# well under a second, and that is the measured shape of this host's flakiness:
# transient Telegram-unreachable blips, every observed one self-healing on the
# next attempt. A SLOW failure is a timeout; retrying that would double the
# worst case and hang a live entry, which PUSH_TIMEOUT_SEC exists to prevent.
PUSH_RETRY_FAST_FAIL_SEC = 5
PUSH_RETRY_BACKOFF_SEC = 2
PUSH_RETRY_TIMEOUT_SEC = 10

# ---------------------------------------------------------------------------
# ONE TABLE, ONE DELIVERY -- the content ledger.
#
# The table now has more than one sender. exercise-enter delivers it at entry
# AND on every recorded set (2026-09-11, owner: 「제발 세트마다 표를 내자는
# 의미잖아」), and the inline-button rail has its own carrier: the arm declares
# `followup_cmd` = this script, and the BRIDGE posts whatever this script puts
# on stdout as a new owner message (DGN-939 item2). Two senders, one screen --
# without an arbiter a single tap would post the table twice, which is the
# exact complaint the keyboard rail already produced once.
#
# The arbiter is the table's own CONTENT. A table that would put the same rows
# on the screen as one already delivered is not a second table; it is the same
# one. Senders CLAIM (atomically, so two processes cannot both win); readers
# that merely PRINT for someone else to post only CHECK -- see the boundary
# note on table_delivered. The store is set-arm's step_affordance ledger, the
# same O_CREAT|O_EXCL claim the keyboard rail uses; a second ledger for the
# same class of defect is how the two drift apart.
# ---------------------------------------------------------------------------
TABLE_CHANNEL = "set-table"
_SET_ARM_MOD = None


def _step_affordance():
    """set-arm's step_affordance (the delivery ledger), imported lazily.

    Lazy on purpose: set-arm loads THIS module (for the day/slot resolver), so
    a module-level import either way would be a cycle. Both directions are
    function-local and both scripts are __main__-guarded, so neither import has
    side effects. Returns None when the sibling cannot be loaded -- callers
    then degrade to no-dedup, which is the pre-2026-09-11 behaviour: a missing
    ledger may cost a duplicate, it must never cost the table."""
    global _SET_ARM_MOD
    if _SET_ARM_MOD is None:
        try:
            path = os.path.join(HERE, "set-arm")
            spec = importlib.util.spec_from_loader(
                "set_arm",
                importlib.machinery.SourceFileLoader("set_arm", path))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            _SET_ARM_MOD = mod
        except Exception:  # noqa: BLE001 -- degrade to no-dedup, never raise
            _SET_ARM_MOD = False
    if _SET_ARM_MOD is False:
        return None
    return getattr(_SET_ARM_MOD, "step_affordance", None)


def table_signature(text):
    """Stable short signature of a rendered table -- the ledger's identity for
    "these exact rows, on this exact screen". Line-level whitespace is
    normalised so a trailing space cannot make one table look like two."""
    body = "\n".join(ln.rstrip() for ln in (text or "").splitlines())
    return hashlib.sha1(body.encode("utf-8")).hexdigest()[:16]


def _table_ledger_key(exercise_name, signature):
    # Plain comprehension rather than a regex: this module imports `re` inside
    # the two functions that need it, and a delivery key is not a reason to
    # change that. step_affordance sanitises the path again anyway; this only
    # keeps the key readable in a directory listing.
    safe = "".join(ch if (ch.isalnum() or ch in "._-") else "_"
                   for ch in str(exercise_name or ""))
    return "tbl.%s.%s" % (safe, signature)


def claim_table_delivery(session_id, exercise_name, text):
    """Claim the ONE delivery slot for this table's content.

    Returns (claimed, signature). claimed=False means an identical table is
    already on the owner's screen and the caller must send NOTHING.

    FOR SENDERS ONLY. A claim asserts "I am delivering this"; claiming without
    then sending would make the ledger refuse the sender that actually would
    have, and the owner would lose the table entirely. Fail-open on any ledger
    trouble -- a duplicate is strictly the lesser harm."""
    sig = table_signature(text)
    sa = _step_affordance()
    if sa is None:
        return True, sig
    try:
        return (sa.claim_delivery(session_id,
                                  _table_ledger_key(exercise_name, sig),
                                  channel=TABLE_CHANNEL),
                sig)
    except Exception:  # noqa: BLE001 -- a ledger miss never costs the table
        return True, sig


def release_table_delivery(session_id, exercise_name, text):
    """Drop this table's claim: the send it was taken for did NOT reach the
    owner. Returns True when a claim was removed.

    The claim means "these rows are on the owner's screen". A failed send
    leaves nothing on the screen (its fallback rows go to a stdout that may
    reach no one -- the per-set beat's set-add, the inline-button rail), so
    keeping the claim would make the button followup withhold the rows as
    already delivered and the next publish refuse them as a duplicate: the
    owner would see no table at all (hop map 2026-09-03, rail B). Releasing
    turns the next publish into a retry. Never raises."""
    sa = _step_affordance()
    if sa is None:
        return False
    try:
        return bool(sa.release_delivery(
            session_id, _table_ledger_key(exercise_name,
                                          table_signature(text)),
            channel=TABLE_CHANNEL))
    except Exception:  # noqa: BLE001 -- best-effort like the claim
        return False


def table_delivered(session_id, exercise_name, text):
    """Has this exact table already reached the owner?

    THE READ-ONLY HALF, and the distinction is load-bearing. This script's
    plain stdout is not a delivery -- it is text handed to someone else (the
    bridge's followup poster, a fast-path body, a person at a terminal) who may
    or may not put it on a screen. So this path must never CLAIM: a claim taken
    by a printer would silence the sender that follows it, and the table would
    reach nobody. It only asks, and lets main() decide what to print.

    Fail-open (unknown -> False): when the ledger cannot be read, printing the
    table is the safe answer."""
    sa = _step_affordance()
    if sa is None:
        return False
    try:
        return sa.already_delivered(
            session_id, _table_ledger_key(exercise_name,
                                          table_signature(text)),
            channel=TABLE_CHANNEL)
    except Exception:  # noqa: BLE001 -- unreadable ledger -> print it
        return False


def defence_table(text):
    """Return the table's lines with its ``` fence markers removed.

    THE FALLBACK SHAPE. When delivery fails the caller still owes the owner the
    data, but re-emitting the fence is what produced the original defect: on the
    relay surface a fence renders as literal backticks around a collapsed pipe
    grid. Stripping the markers keeps every row and loses only the (already
    broken) monospace promise. Rows are never dropped -- owner ruling: losing
    the table is worse than mis-rendering it.
    """
    return [ln for ln in (text or "").splitlines()
            if not ln.strip().startswith("```")]


def _ch2_log_table(status, session_id=None):
    """Append one CH2_OUT line for the table rail. Never raises, never blocks."""
    try:
        label = "set-table sid=%s" % (session_id if session_id is not None
                                      else "?")
        line = "%s\tCH2_OUT\t%s\t%s\n" % (
            time.strftime("%Y-%m-%dT%H:%M:%S"), label, status)
        with open(CH2_LOG, "a") as fh:
            fh.write(line)
    except Exception:  # noqa: BLE001 -- a ledger miss never blocks a send
        pass


def _push_once(binary, body, timeout):
    """Run one send. Returns (ok, detail, elapsed_sec). Never raises."""
    t0 = time.time()
    try:
        proc = subprocess.run([binary, "--text", body],
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              timeout=timeout)
    except Exception as exc:  # noqa: BLE001 -- a send miss is never a crash
        return False, "push_error:%s" % type(exc).__name__, time.time() - t0
    if proc.returncode == 0:
        return True, "sent", time.time() - t0
    # rc 3 = push.sh's DGN-1122 test-context guard. Named, not swallowed: a
    # suite must be able to tell "guard refused" from "Telegram refused".
    return False, "push_rc=%d" % proc.returncode, time.time() - t0


# ---------------------------------------------------------------------------
# IN PLACE (session UX intent spec 2026-08-20 s.0-2: one table message per
# exercise, edited at every set boundary). OPT-IN per caller: only the set
# table itself (exercise-enter deliver_set_table, the --deliver CLI) passes
# inplace=True. deliver_table has other passengers keyed by the SAME
# (session, exercise) pair -- set-add's transition wrap-up line -- and keying
# in-place on that pair alone would edit the table into the wrap-up.
#
# Taken only when push.sh declares `edit` (framework DGN-1803); otherwise the
# historic send path below runs unchanged. EDIT_UNCERTAIN is not a failure
# the caller may paper over with the fallback rows: the edit may have landed,
# and re-posting the table is the duplicate the spec forbids.
# ---------------------------------------------------------------------------
INPLACE_SURFACE = "set-table"
EDIT_UNCERTAIN = "edit_uncertain"
_INPLACE_MOD = None


def _inplace():
    """inplace_delivery, imported lazily; None when it cannot load (callers
    then take the historic send path -- never a lost table)."""
    global _INPLACE_MOD
    if _INPLACE_MOD is None:
        try:
            if HERE not in sys.path:
                sys.path.insert(0, HERE)
            import inplace_delivery as mod
            _INPLACE_MOD = mod
        except Exception:  # noqa: BLE001 -- degrade to the send path
            _INPLACE_MOD = False
    return _INPLACE_MOD or None


def _deliver_inplace(body, session_id, exercise_name, binary, fresh):
    """(ok, detail) through the in-place module, or None when the in-place
    path does not apply (module missing / push.sh cannot edit)."""
    mod = _inplace()
    if mod is None or not mod.can_edit(binary):
        return None
    key = mod.surface_key(INPLACE_SURFACE, session_id, exercise_name)
    if fresh:
        # A genuine (re)entry posts a NEW table at the bottom of the chat;
        # editing a message scrolled far up would be invisible. Set
        # boundaries after it edit this new one.
        mod.drop_record(STATE_DIR, key)
    ok, detail, _mid = mod.deliver(key, body, binary, STATE_DIR,
                                   timeout=PUSH_TIMEOUT_SEC)
    _ch2_log_table(("SENT inplace=%s" % detail) if ok
                   else ("FAILED inplace=%s" % detail), session_id)
    # detail is the module's own word; "edit_uncertain" == EDIT_UNCERTAIN.
    return (True, "sent") if ok else (False, detail)


def inplace_shows(session_id, exercise_name, text, push=None):
    """True/False: the in-place table message for this exercise does / does
    not show exactly `text`. None: no in-place message (module missing,
    push.sh cannot edit, nothing recorded) -- the content ledger decides.

    Why the content ledger alone is not enough once tables edit in place: a
    table claimed earlier (rows A) can since have been edited to rows B; an
    undo that renders A again is then NOT on the screen, and refusing it as
    a duplicate would leave B showing. Never raises."""
    try:
        mod = _inplace()
        if mod is None or not session_id or not exercise_name or \
                not mod.can_edit(push or PUSH):
            return None
        return mod.shows(STATE_DIR, mod.surface_key(
            INPLACE_SURFACE, session_id, exercise_name), text)
    except Exception:  # noqa: BLE001 -- unknown -> the ledger decides
        return None


def deliver_table(text, session_id=None, exercise_name=None, push=None,
                  inplace=False, fresh=False):
    """Send the rendered table to the owner as its OWN message.

    Returns (ok, detail):
        (True,  "sent")            -- push.sh exited 0 (possibly on the retry),
                                      or the in-place message now shows it
        (False, EDIT_UNCERTAIN)    -- in-place edit may have landed: the
                                      caller must NOT print the fallback rows
        (False, "<reason>")        -- anything else. The CALLER must then fall
                                      back to printing the table: a delivery
                                      that failed silently would drop the table
                                      entirely, which is worse than the defect.

    inplace=True (set table only, see IN PLACE above) with both ids known
    edits this exercise's table message when push.sh can; fresh=True first
    forgets that message, so the render is a new one (entry beat).

    Every outcome is appended to CH2_LOG so the table rail is auditable the way
    the timer rail already was.

    `push` overrides the binary for a direct in-process call; the default is the
    module-level PUSH, i.e. $WARG_PUSH when a suite has bound it. Never raises.
    """
    body = (text or "").strip()
    if not body:
        return False, "empty"
    binary = push or PUSH
    if not os.path.exists(binary):
        _ch2_log_table("FAILED no_push_binary", session_id)
        return False, "no_push_binary"

    if inplace and session_id and exercise_name:
        res = _deliver_inplace(body, session_id, exercise_name, binary, fresh)
        if res is not None:
            return res

    ok, detail, elapsed = _push_once(binary, body, PUSH_TIMEOUT_SEC)
    if ok:
        _ch2_log_table("SENT", session_id)
        return True, "sent"

    # The test-context guard is a VERDICT, not a blip -- retrying it would just
    # refuse twice and burn a live entry's patience.
    retryable = (detail != "push_rc=3"
                 and elapsed < PUSH_RETRY_FAST_FAIL_SEC)
    if not retryable:
        _ch2_log_table("FAILED %s" % detail, session_id)
        return False, detail

    time.sleep(PUSH_RETRY_BACKOFF_SEC)
    ok2, detail2, _ = _push_once(binary, body, PUSH_RETRY_TIMEOUT_SEC)
    if ok2:
        _ch2_log_table("SENT retry=1 first=%s" % detail, session_id)
        return True, "sent"
    _ch2_log_table("FAILED %s retry=1 first=%s" % (detail2, detail), session_id)
    return False, detail2


# push.sh does one HTTPS call; this only has to be shorter than a live session's
# patience, and it must never hang an entry.
PUSH_TIMEOUT_SEC = 25


def main(argv=None):
    p = argparse.ArgumentParser(
        prog="set-table",
        description="Render the in-session (2) set-progress table (B5/C2).",
    )
    p.add_argument("session_id", type=int, help="workouts.id")
    p.add_argument("exercise_name", help="current slot name (snake_case)")
    p.add_argument("--db", default=DEFAULT_DB, help="path to kit_life.db")
    p.add_argument("--program", default=DEFAULT_PROGRAM,
                   help="path to program.yaml")
    # WHO READS THIS STDOUT -- declared by the caller, never inferred (see the
    # boundary block above for the production failure that ruled inference
    # out). Omitted = DEFAULT_SURFACE = the owner surface: the machine tail is
    # withheld. `--surface machine` is the pre-2026-09-01 output, byte for byte.
    p.add_argument("--surface", choices=(SURFACE_OWNER, SURFACE_MACHINE),
                   default=None,
                   help="who reads this stdout. machine: keep the "
                        "out-of-fence signal lines (the model rail -- D3). "
                        "owner: strip them. Default: owner.")
    # D19: deliver the table as its OWN owner message instead of leaving the
    # fenced block on stdout for a relay. On success stdout carries a RECEIPT
    # and no fence -- there is nothing left for anyone to paste into a progress
    # log. On failure the fence is printed exactly as before (never drop it).
    p.add_argument("--deliver", action="store_true",
                   help="send the table to the owner as its own message "
                        "(push.sh) and print a receipt instead of the fenced "
                        "block. Delivery failure falls back to printing it.")
    args = p.parse_args(argv)

    db_path = os.path.abspath(args.db)
    _use_tax_db(db_path)   # bind the muscle taxonomy to THIS run's db
    from free_session import effective_path
    program_path = effective_path(os.path.abspath(args.program), db_path, args.session_id)
    if not os.path.exists(db_path):
        print("ERROR: db not found: %s" % db_path, file=sys.stderr)
        return 1
    if not os.path.exists(program_path):
        print("ERROR: program.yaml not found: %s" % program_path, file=sys.stderr)
        return 1

    rx = load_rx_calc()
    program = rx.load_yaml(program_path)
    if not isinstance(program, dict):
        print("ERROR: program.yaml did not parse as a dict", file=sys.stderr)
        return 1

    signals = []
    out, err = render(program, db_path, args.session_id, args.exercise_name, rx,
                      program_path=program_path, signals=signals)
    if err:
        print(err, file=sys.stderr)
        return 1
    surface = resolve_surface(args.surface)
    # D19: the fenced block goes to the OWNER through the sender, or -- only if
    # that fails -- to stdout, which is what it always did.
    if args.deliver:
        ok, detail = deliver_table(out, args.session_id, args.exercise_name,
                                   inplace=True)
        if ok:
            print("SET_TABLE delivered=yes by=code")
        elif detail == EDIT_UNCERTAIN:
            # The edit may be on the screen already; printing the rows here
            # would hand a relay the duplicate. The next beat edits again.
            print("SET_TABLE delivered=uncertain reason=%s (not reprinted)"
                  % detail)
        else:
            print("SET_TABLE delivered=no reason=%s (printed below)" % detail,
                  file=sys.stderr)
            print("SET_TABLE delivered=no reason=%s" % detail)
            # SAME fallback shape as the exercise-enter caller (2026-09-03):
            # rows kept, fence markers stripped. This CLI branch has no caller
            # today, but leaving the old `print(out)` here would have kept a
            # second, dormant copy of the exact path D19 removed -- ready to
            # silently restore the defect the day something wires --deliver.
            # One rail, one fallback shape.
            print("SET_TABLE fallback=defenced")
            for _ln in defence_table(out):
                print(_ln)
    elif table_delivered(args.session_id, args.exercise_name, out):
        # ALREADY ON THE OWNER'S SCREEN -- withhold it from stdout.
        #
        # Whoever runs this script without --deliver is not the sender; they
        # hand the text to someone who posts it. The bridge's inline-button
        # rail is the case that matters: an arm declares this script as its
        # `followup_cmd`, and after the tap's set-add fires the bridge posts
        # this stdout as a NEW owner message (DGN-939 item2). set-add now
        # delivers the table itself on that same tap, so leaving the rows here
        # would put the same table on the screen twice -- the duplicate the
        # owner has already been shown once, on the keyboard rail.
        #
        # An EMPTY stdout is exactly how that rail is told "nothing to post"
        # (bridge/bot.py _idrill_run_followup: `return out or None`), so the
        # withholding is expressed in the vocabulary the consumer already
        # speaks rather than as a new signal it would have to learn.
        #
        # The rows are not lost, only re-routed: a person running this at a
        # terminal still sees the table, on stderr, with the reason. And this
        # branch only ever reads the ledger -- it never claims -- so a render
        # that merely printed can never silence the delivery that follows it.
        print("SET_TABLE stdout=withheld reason=already_delivered "
              "sig=%s (below, for the terminal only)"
              % table_signature(out), file=sys.stderr)
        print(out, file=sys.stderr)
    else:
        print(out)
    # A3: the render's own decisions, OUTSIDE the code fence -- they are not
    # columns. RAMP_DECISION in particular must be printed on EVERY render,
    # including (especially) the renders where the decision was "no ramp": D3
    # was a silent absence that the model then defended and retracted inside 20
    # seconds. A decision that is always stated cannot be guessed at.
    #
    # ...to a MACHINE reader. On the owner surface the same decisions are
    # dropped here instead (surface_lines): they are still stated on every
    # render, to the reader they were written for. D3 is a contract with the
    # model, not with the owner's phone.
    for line in surface_lines(signals, surface):
        print(line)
    # P2 (owner 2026-08-24: the agent, not the engine, owns the load increase): if the
    # WT column is showing a weight the agent decided rather than the one the engine
    # prescribed, the table has to carry the reason WITH the number. The table
    # is where the owner reads the weight, and a number they cannot account for
    # is exactly what they challenged ("8회인데왜 증량해?").
    #
    # OUTSIDE the code fence on purpose: this is prose for the owner, not a
    # column, and the grid's alignment is not negotiable. The sentence is
    # composed in set-arm (load_decision_say) at DECISION time and only
    # reproduced here, so the table and the cue can never explain the same
    # number two different ways.
    #
    # STRIP, never DROP: on the owner surface the `LOAD_DECISION: ` prefix goes
    # and the sentence stays. Suppressing it would delete the reason the weight
    # changed from the one surface they read the weight on -- the defect this
    # line was added to fix.
    say = load_decision_line(args.session_id, args.exercise_name)
    if say:
        for line in surface_lines(["LOAD_DECISION: %s" % say], surface):
            print(line)
    # F10/F28: the table was actually rendered for this exercise -> mark it
    # published so the set-add entry gate knows the (2) table was posted on
    # entry (best-effort, never blocks the successful render above).
    _mark_published(args.session_id, args.exercise_name)
    return 0


if __name__ == "__main__":
