def _disp_w(s):
    """Monospace COLUMN width of s, not its character count.

    Added 2026-08-24, when the RIR column header was briefly a Korean word, and
    KEPT after that revert because the header is now a knob that can be set to
    one again. Every cell in this grid used to be pure ASCII, so len() WAS the
    width; a Hangul syllable occupies TWO
    columns in the monospace font Telegram renders a code block in, so padding a
    Korean header by len() would make its row 2 columns wider than its own
    border and visibly skew the table. East-Asian Wide/Fullwidth count 2 and
    zero-width combining marks count 0; for ASCII this returns exactly len(s),
    so every pre-existing cell pads byte-identically to before."""
    w = 0
    for ch in str(s):
        if unicodedata.combining(ch):
            continue
        w += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return w


def ctr(s, w):
    """Center s in width w; when the margin is odd the EXTRA space goes on the
    LEFT (matches the SKILL.md example grid, e.g. 'WT'->'    WT   ').

    Width is measured in DISPLAY columns (_disp_w), not characters, so a Korean
    header centers against the same border the ASCII cells use."""
    s = str(s)
    sw = _disp_w(s)
    if sw >= w:
        return s
    marg = w - sw
    left = (marg + 1) // 2
    return " " * left + s + " " * (marg - left)


def fmt_kg(w):
    """Weight -> 'NN.NNkg'. Machine-grid resolution is 2 decimals (pin lattices
    bottom out at the 0.01 place: 34.38 / 40.63 / 31.25 etc.), so the DISPLAY is
    snapped to <=2 decimals. This preserves every legitimate value verbatim
    (21.25 / 40.0 / 16.25 / 34.38 -> unchanged, integers keep their .0) while
    collapsing binary-float render noise -- e.g. an rx-calc raw assist result of
    31.880000000000003 renders 31.88 instead of the full float tail (G18:
    un-logged/planned-row render path was leaking the raw float). Only rounding
    BEYOND 2 decimals is suppressed; no legitimate grid value is altered.
    Values already representable at <=2 decimals fall through to str(w) so the
    prior verbatim output (40.0 -> '40.0kg', 22.5 -> '22.5kg') is byte-identical."""
    if w is None:
        return ""
    r = round(float(w), 2)
    # Preserve prior verbatim rendering for clean values (float noise -> r != w).
    disp = w if float(w) == r else r
    return "%skg" % (disp,)


