SURFACE_OWNER = "owner"
SURFACE_MACHINE = "machine"

# The default when the call site declares nothing. See "WHICH WAY THE DEFAULT
# FAILS" above: an undeclared caller is treated as a human surface, so a rail
# nobody has written yet is clean the day it opens, and the cost of a forgotten
# declaration is a machine reader missing a signal it is trained to miss out
# loud -- never the owner reading machine text.
DEFAULT_SURFACE = SURFACE_OWNER


def signal_policy(line):
    """(action, text) for ONE out-of-fence line, per SIGNAL_POLICY.

    Anchored, exact-token matching:
      kv     `TOKEN` alone, or `TOKEN ` + payload   (`TOKEN k=v ...` signals)
      colon  `TOKEN:` + payload                     (`TOKEN: <prose>` form)
    A line that merely CONTAINS a token, or opens with a longer word sharing
    the prefix (`RAMP_DECISIONS ...`), is owner prose and passes."""
    s = line.rstrip("\r")
    for token, form, action in SIGNAL_POLICY:
        if form == "kv":
            if s == token or s.startswith(token + " "):
                return action, s
        elif form == "colon":
            if s == token + ":":
                return action, ""
            if s.startswith(token + ": "):
                return action, s[len(token) + 2:]
    return "pass", s


def owner_filter(chunks):
    """The out-of-fence lines as the OWNER must receive them.

    Splits on newlines first: a signal that ever grows a second line must not
    escape by failing a whole-chunk match. A `strip` whose payload is empty
    carries nothing to say and is dropped rather than posted as a blank."""
    out = []
    for chunk in chunks:
        for line in str(chunk).split("\n"):
            action, text = signal_policy(line)
            if action == "drop":
                continue
            if action == "strip" and not text.strip():
                continue
            out.append(text)
    return out


def resolve_surface(declared=None):
    """Who is reading this stdout -- as DECLARED by the caller. Nothing else.

    This function deliberately reads no environment variable, inspects no
    process ancestry, and tests no tty. It takes one argument and returns it,
    or DEFAULT_SURFACE when the caller declared nothing. That is the whole
    contract, and the emptiness is the fix: the version of this file that
    classified its caller from context shipped green and regressed in
    production, because both audiences run inside the same process tree and no
    ambient signal separates them.

    Consequence, stated plainly so it is not a surprise later: a caller that
    wants the machine tail MUST say so. The four owner-bound rails in this
    pack -- set-arm's followup_cmd declaration and its hold_followup_argv,
    session-fastpath's render_table, session-closeout's render_set_table --
    pass `--surface owner` explicitly rather than lean on the default: an
    inferred default and a declared default read the same in the output and
    not in the code, and the rule above is about what the CODE says.

    That sentence was FALSE for one cut of this pack -- it named three rails
    while every one of them omitted the flag -- so read it as a claim that can
    be checked, not as background. `grep -n '"--surface", "owner"'` over
    set-arm / session-fastpath / session-closeout must return four hits."""
    if declared in (SURFACE_OWNER, SURFACE_MACHINE):
        return declared
    return DEFAULT_SURFACE


def surface_lines(chunks, surface):
    """Out-of-fence lines for `surface`. The fenced table never passes through
    here -- it is not a signal channel and is emitted untouched."""
    if surface == SURFACE_OWNER:
        return owner_filter(chunks)
    return [str(c) for c in chunks]


