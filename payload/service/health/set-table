# A2 (2026-08-25) exercise-exit resolution. session-closeout writes one marker
# per (session, exercise) when an exercise is RESOLVED -- finished, or stopped
# early. Read-only here (session-closeout is the sole writer).
#
# WHY THE TABLE HAS TO READ IT: A2 resolves the render at exit time, but a plain
# `set-table` call later in the session re-derives the planned rows from the
# prescription and hands back `[ ]` again -- so the resolution was true for one
# message and false forever after. The observed case: leg_curl ended at 3/4 when
# the user called it there and moved on, and the set-4 row stayed
# `| 4 | 40.0kg | 15 | 0-1 | [ ] |` for the rest of the session. A pending
# checkbox on a set nobody is going to do is a lie the table keeps telling.
#
# A closed exercise's unlogged rows render `[-]` (미실시), never `[ ]`. That is
# a THIRD state, not a rename: `[v]` done, `[-]` closed and not done, `[ ]`
# still to come. It applies to prep and warmup rows too (A3) -- those are
# planned rows exactly like a working set, and an abandoned exercise leaves them
# dangling in exactly the same way.
EXERCISE_CLOSED_DIR = os.path.join(STATE_DIR, ".exercise-closed")


def exercise_is_closed(session_id, exercise_name):
    """True once session-closeout has resolved this exercise (early stop or
    completion). A closed exercise has no pending sets.

    Best-effort: any error -> False, i.e. degrade to the pre-A2 `[ ]`. A missed
    marker costs a stale checkbox; a wrongly-claimed one would tell the owner an
    exercise is over when it is not."""
    try:
        import re as _re
        safe = _re.sub(r"[^A-Za-z0-9_.-]", "_", str(exercise_name or ""))
        return os.path.exists(os.path.join(
            EXERCISE_CLOSED_DIR, "%s.%s.json" % (session_id, safe)))
    except Exception:      # noqa: BLE001 -- a marker miss never breaks a table
        return False


def _override_path(session_id, exercise_name):
    import re
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", str(exercise_name or ""))
    return os.path.join(OVERRIDE_DIR, "%s.%s.json" % (session_id, safe))


def read_override(session_id, exercise_name):
    """Read the persisted target override for this (session, exercise), or {}."""
    try:
        import json
        with open(_override_path(session_id, exercise_name)) as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def _published_flag_path(session_id, exercise_name):
    """Per-(session, exercise) flag file the entry gate keys on. exercise_name
    is sanitized to a safe filename token; session_id is an int already."""
    import re
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", str(exercise_name or ""))
    return os.path.join(PUBLISHED_DIR, "%s.%s" % (session_id, safe))


def _mark_published(session_id, exercise_name):
    """Record that the (2) progress table was rendered for this exercise in
    this session -- best-effort, never raises (a marker miss can never break a
    render)."""
    try:
        os.makedirs(PUBLISHED_DIR, exist_ok=True)
        with open(_published_flag_path(session_id, exercise_name), "w") as fh:
            fh.write("1")
    except OSError:
        pass


def _clear_published(session_id, exercise_name):
    """Defect B (owner SPEC 2026-08-20 section 2): drop any pre-existing
    published flag for this (session, exercise). Called by exercise-enter at
    GENUINE first entry, right before it (re)publishes the initial table, so a
    STALE flag (e.g. left by a diagnostic/manual mid-session set-table render --
    the 5.8 pollution incident) can never linger and mis-signal downstream that
    the entry table was already delivered. The entry publish immediately re-marks
    it via _mark_published, so the flag ends up reflecting THIS session's real
    entry delivery. Best-effort: a clear miss never breaks the entry."""
    try:
        os.remove(_published_flag_path(session_id, exercise_name))
    except OSError:
        pass

