class UnknownSetKindError(ValueError):
    """No derivation row for this set_kind. There is deliberately NO fallback:
    a silent default is how `working` semantics leaked onto prep rows in the
    first place."""

    def __init__(self, given):
        self.given = given
        super().__init__(
            "R-SETKIND-UNKNOWN: no derivation row for set_kind %r; known kinds "
            "are %s (no default is applied -- a set_kind must be declared)"
            % (given, ", ".join(sorted(SET_KIND_DERIVATION))))


def derive_set_kind(set_kind):
    """set_kind -> its derivation row (a dict). Table lookup, never a branch,
    never a default."""
    try:
        return SET_KIND_DERIVATION[set_kind]
    except KeyError:
        raise UnknownSetKindError(set_kind) from None


def keyboard_kind_for(set_kind):
    """Symbolic keyboard token for a kind. `timer_done` is derivable ONLY from
    `hold`: no other row in the table carries that token."""
    return derive_set_kind(set_kind)["keyboard_kind"]


def counts_toward_volume(set_kind):
    return derive_set_kind(set_kind)["counts_toward_volume"]


def cue_shape_for(set_kind):
    return derive_set_kind(set_kind)["cue_shape"]


def kinds_with_keyboard(keyboard_kind):
    """Inverse index over the table -- which kinds can produce this keyboard.
    Lets the timer-leak invariant be asserted structurally, not by inspection."""
    return tuple(sorted(k for k, row in SET_KIND_DERIVATION.items()
                        if row["keyboard_kind"] == keyboard_kind))


# ---------------------------------------------------------------------------
# THE SIGN CONVENTION -- today's carrier for `set_kind`, until 034 lands.
#
#   set_seq >= 1                       working
#   PREP_SEQ_BASE < set_seq <= 0       ramp / primer   (0 = bw/empty-bar rung,
#                                                       -1 = r1, -2 = r2, ...)
#   set_seq <= PREP_SEQ_BASE           prep drill      (-100 = p1, -101 = p2)
#
# PREP GETS ITS OWN BAND rather than joining the ramp band, for two reasons:
#   1. A prep row and a ramp rung are DIFFERENT KINDS with different cue shapes
#      and different labels; sharing a band would make them indistinguishable
#      from the stored row alone -- which is the whole defect (prep as a
#      second-class citizen).
#   2. The band is BELOW the ramp band, so every existing volume query
#      (`set_seq >= 1`) and every ramp reader (`set_seq <= 0`, bounded here)
#      keeps working with no change. Prep rows are excluded from every
#      aggregate by the SAME filter that already excludes ramp rows.
# -100 leaves 99 ramp rungs of headroom; the deepest real ladder is 3.
# ---------------------------------------------------------------------------
PREP_SEQ_BASE = -100


def prep_seq(index):
    """0-based prep-drill index -> its stored set_seq (p1 -> -100, p2 -> -101)."""
    return PREP_SEQ_BASE - int(index)


def prep_index(set_seq):
    """Stored prep set_seq -> its 0-based index. Raises for a non-prep seq."""
    n = int(set_seq)
    if n > PREP_SEQ_BASE:
        raise ValueError("not a prep set_seq: %r" % (set_seq,))
    return PREP_SEQ_BASE - n


def set_kind_for_seq(set_seq):
    """Stored set_seq -> set_kind, per the sign convention above.

    `hold` is deliberately NOT derivable here: a hold working set is still
    set_seq >= 1, and what makes it a hold is the SLOT (progression == 'hold'),
    not the sequence number. set-arm owns that predicate (is_hold_class); this
    function answers only what the sequence number can honestly answer."""
    n = int(set_seq)
    if n >= 1:
        return SET_KIND_WORKING
    if n > PREP_SEQ_BASE:
        return SET_KIND_RAMP
    return SET_KIND_PREP


def seq_label(set_seq):
    """The SET-column label for a stored set_seq: working -> '1'.., ramp ->
    'bw'/'r1'.., prep -> 'p1'... ONE definition; the table, the cue and the
    refusal messages all read it, so a row can never be named two ways."""
    n = int(set_seq)
    kind = set_kind_for_seq(n)
    if kind == SET_KIND_WORKING:
        return str(n)
    if kind == SET_KIND_PREP:
        return "p%d" % (prep_index(n) + 1)
    return "bw" if n == 0 else "r%d" % (-n)


# ---------------------------------------------------------------------------
# THE PRESCRIBED VALUE AND ITS UNIT (2026-08-27, owner ruling -- see the
# derivation-table comment above).
#
# prep.yaml's `target_reps` is ONE INTEGER COLUMN carrying FOUR DIFFERENT UNITS.
# That was survivable while a human read the `display` string next to it; it
# stopped being survivable the moment the number became the thing a keyboard
# collects and a row stores, because every unit collapses into "reps" on the way
# through. `target_unit` names the unit AT THE SOURCE, transcribed from the same
# owner-authored `display` that `target_reps` itself was transcribed from -- so
# this is the same provenance operation, not a new prescription.
#
#   reps       total repetitions.
#   per_side   repetitions PER SIDE; the true total is DOUBLE.
#   rounds     rounds of a multi-exercise circuit.
#   hold_sets  number of timed hold SETS; the duration is hold_sec.
#
# ABSENCE IS STILL MEANINGFUL. A drill with no `target_reps` has NO prescribed
# value and gets NO unit -- it takes the completion tap with no number stated at
# all. Never defaulted: inventing a count here is the same defect class as
# inventing a load, in a different column.
#
# A stated `target_reps` with NO `target_unit` falls back to `reps` and is
# REPORTED (`unit_declared` False), so an added drill that forgot the field is
# visible rather than silently coerced -- fail-visible, the same rule the
# unknown-phase bucket in exercise-enter follows.
# ---------------------------------------------------------------------------
PREP_UNIT_REPS = "reps"
PREP_UNIT_PER_SIDE = "per_side"
PREP_UNIT_HOLD_SETS = "hold_sets"
PREP_UNIT_NONE = "none"          # no owner-stated value exists for this drill

# 「rounds」 IS RETIRED -- owner ruling 2026-09-02 06:12, verbatim:
#     "라운드라는 말을 만든 게 이상해. 세트가 있는데."
# The unit said "this drill is performed N times", which 세트 already said. The
# repeat count is now `sets: N` on the day item and rx-calc expands it into N
# items BEFORE this function ever sees one -- so a multi-set drill arrives here
# as N single-set drills and there is nothing left for a `rounds` unit to mean.
#
# The distinction 라운드 was defended for ("웜업이 세트 수에 안 들어간다") is
# held by set_kind='prep' and the PREP_SEQ_BASE band, not by a word. Measured on
# session 10095: prep rows sat at seq -107..-100 and were excluded from every
# working aggregate by the same `set_seq >= 1` filter that was already there.
# ** An aggregation rule defended by vocabulary was never defended. **
#
# The name stays bound below ONLY so an un-migrated file degrades VISIBLY
# (unit_declared False -> PREP_UNIT_UNDECLARED) instead of crashing. rx-calc
# validate_prep REFUSES the value at build time, which is the real stop.
PREP_UNIT_ROUNDS = "rounds"      # RETIRED. Refused by rx-calc validate_prep.

PREP_TARGET_UNITS = (PREP_UNIT_REPS, PREP_UNIT_PER_SIDE,
                     PREP_UNIT_HOLD_SETS)


def prep_target_spec(drill):
    """A prep/cooldown drill item -> its PRESCRIPTION, unit included.

    Returns a dict, always, never raises:
        value          the prescribed integer, or None when the owner stated none
        unit           one of PREP_TARGET_UNITS, or PREP_UNIT_NONE when value is
                       None
        unit_declared  True when prep.yaml stated the unit itself
        hold_sec       the drill's hold duration, or None
        prescribed     value is not None or hold_sec is not None
        token          the value+unit as ONE machine token for a stdout line
                       ('20', '10/side', '1round', '2x15s', '?')

    `token` exists so a consumer cannot print the bare integer by accident: the
    unit rides the same string as the number, which is precisely what the REPS
    column could not do.
    """
    d = drill if isinstance(drill, dict) else {}
    value = d.get("target_reps")
    hold = d.get("hold_sec")
    declared = d.get("target_unit")
    try:
        value = None if value is None else int(value)
    except (TypeError, ValueError):
        value = None
    try:
        hold = None if hold is None else int(hold)
    except (TypeError, ValueError):
        hold = None

    if value is None:
        unit, unit_declared = PREP_UNIT_NONE, declared in PREP_TARGET_UNITS
    elif declared in PREP_TARGET_UNITS:
        unit, unit_declared = declared, True
    else:
        # Stated number, undeclared unit. Fall back to the commonest unit but
        # SAY SO -- a silent fallback here is how a round count becomes a rep
        # count, which is the defect this function exists to end.
        unit, unit_declared = PREP_UNIT_REPS, False

    if value is None:
        token = "%ss" % hold if hold is not None else "?"
    elif unit == PREP_UNIT_PER_SIDE:
        token = "%d/side" % value
    elif unit == PREP_UNIT_ROUNDS:
        token = "%dround" % value
    elif unit == PREP_UNIT_HOLD_SETS:
        token = "%dx%ss" % (value, hold) if hold is not None else "%dset" % value
    else:
        token = str(value)

    # SET POSITION RIDES THE SPEC, 2026-09-02. rx-calc expands `sets: N` into N
    # items carrying set_index/set_total; carrying them through here is what
    # lets a step say "2/3" instead of announcing three sets at once. Owner
    # 06:29: "세트더 하나씩 알려줘야지 3세트 툭 주냐".
    try:
        set_total = max(1, int(d.get("set_total") or 1))
    except (TypeError, ValueError):
        set_total = 1
    try:
        set_index = max(1, int(d.get("set_index") or 1))
    except (TypeError, ValueError):
        set_index = 1
    return {
        "value": value,
        "unit": unit,
        "unit_declared": bool(unit_declared),
        "hold_sec": hold,
        "prescribed": value is not None or hold is not None,
        "token": token,
        "set_index": set_index,
        "set_total": set_total,
    }


# What a prep row stores in `reps` when the owner stated NO prescribed value.
#
# workout_sets.reps is NOT NULL and there is no migration in front of an
# afternoon session, so the row needs a number. It gets 0, and 0 here means
# exactly "completed; no count was ever prescribed and none was measured" --
# readable because the row also carries set_kind='prep' and target_reps NULL.
# It cannot reach a volume aggregate (set_seq <= PREP_SEQ_BASE is below every
# `set_seq >= 1` filter in the tree), and the table renders it as '-' rather
# than a numeral, so it can never be read as a failed set.
PREP_UNPRESCRIBED_REPS = 0

# THE EMISSION ORDER OF A SLOT'S PREP DRILLS, and therefore the order p-numbers
# and set_seqs are assigned in. exercise-enter's PREP_PHASE_ORDER holds the same
# three names in the same order and sorts by them (stably, so declared order
# survives within a phase); this is the copy the OTHER readers use, so a reader
# that needs "which drill is p3" does not have to re-derive it and drift.
# tests/test-prep-completion-tap.py pins the two lists equal.
PREP_PHASE_ORDER = ("mat_prep", "equipment_prep", "immediate_primer")


def prep_phase_rank(phase):
    """Sort key for a prep phase. An unknown/None phase sorts LAST rather than
    being dropped -- fail-visible, matching exercise-enter's own bucket rule."""
    try:
        return PREP_PHASE_ORDER.index(phase)
    except ValueError:
        return len(PREP_PHASE_ORDER)


def prep_plan_ordered(drills):
    """[drill] -> [(set_seq, drill)] in EMISSION order, p1 first.

    ONE definition of "which drill is p3". Before this, exercise-enter assigned
    the seqs and anything else that wanted to name a drill by its seq had to
    re-implement the phase sort -- and a mismatch would put the owner's tap on a
    different drill from the one they were just shown."""
    items = [d for d in (drills or []) if isinstance(d, dict)]
    ordered = sorted(items, key=lambda d: prep_phase_rank(d.get("phase")))
    return [(prep_seq(i), d) for i, d in enumerate(ordered)]


# THE PHASE BOUNDARY -- the ONE definition of "which drills are due BEFORE the
# warmup, and which are deferred to just before working set 1".
#
# This name is not new vocabulary. exercise-enter has emitted
# `PREP_IMMEDIATE defer=first_working_set` since #26, PREP_PHASE_ORDER above
# already sorts this phase last, and the SKILL's F2 3-bucket rule spells the
# order out:  mat_prep -> equipment_prep -> [entry] -> immediate_primer.
# What was missing was a READER: the boundary existed as text the model was
# asked to honour, and on 2026-09-02 it did not (D10 order inversion, D16 a
# primer offered AFTER all three working sets).
PREP_DEFERRED_PHASE = "immediate_primer"


def prep_phase_split(drills):
    """(entry_planned, deferred_planned) for a slot's prep drills.

    Derived from prep_plan_ordered -- the SAME ordering that assigns the
    set_seqs -- and NOT from a second sort, so the counts are positionally
    exact: the first `entry_planned` p-rows are the entry drills, by
    construction. A caller can therefore compare a logged COUNT against these
    without joining on codes.

    The split is taken at the FIRST deferred drill rather than by totalling the
    phase, deliberately: an unknown/typo phase sorts LAST (prep_phase_rank), so
    counting deferred drills by phase alone could claim "entry complete" while
    an unlisted drill still sat ahead of the boundary in seq order. Taking the
    lead run cannot overstate entry completeness, which is the direction that
    matters -- overstating it is what re-opens the warmup lane too early."""
    plan = prep_plan_ordered(drills)
    lead = 0
    for _seq, d in plan:
        if isinstance(d, dict) and d.get("phase") == PREP_DEFERRED_PHASE:
            break
        lead += 1
    return lead, len(plan) - lead


def prep_set_argv(session_id, exercise_name, slot_num, set_seq, drill,
                  program="set-add"):
    """The LITERAL set-add argv that logs one prep drill as a completed set.

    ONE builder, shared by exercise-enter (the entry plan) and set-arm (the
    next-drill tap after one lands), because two builders drift and the drift
    lands in the owner's stored data. It writes the prescription EXPLICITLY --
    --set-kind / --target-reps / --hold-sec -- so the stored row says what was
    prescribed and in the `reps` column repeats it as performed (prep is
    prescribed on the assumption of completion; see the ruling above).

    There is NO placeholder argument. The pre-2026-08-27 builder emitted a
    literal `<보고받은 횟수>` when a drill had no stated target, which is an
    instruction to ASK -- the exact behaviour the ruling removes.

    slot_num IS OVERRIDDEN BY THE DRILL'S OWN SCOPE (2026-09-10). When the drill
    carries `write_slot_num` -- which slot_prep_drills sets on every item it
    returns -- that value wins over the `slot_num` argument, because the
    projection is the only place that knows whether the drill belongs to the
    SESSION or to this lift. A session-level drill is written with
    SESSION_SLOT_NUM (None -> the `session` token, stored NULL); a slot's own
    drill is written with the slot number, as before.

    Doing it HERE rather than at the two call sites is the point: this is the
    single builder both exercise-enter and set-arm converge on, so scope cannot
    be applied by one writer and forgotten by the other. A caller that passes a
    drill without the key gets exactly the pre-2026-09-10 argv.
    """
    spec = prep_target_spec(drill)
    # kit 061 (2026-09-30): the drill is a DONE-TAP. Its reps are not
    # counted -- the argv carries `done`, set-add stores reps NULL on a 061
    # DB, and --target-reps keeps the prescription (a pre-061 DB still gets
    # the prescribed value / PREP_UNPRESCRIBED_REPS, set-add decides).
    if isinstance(drill, dict) and "write_slot_num" in drill:
        slot_num = drill["write_slot_num"]
    slot_tok = SESSION_SLOT_TOKEN if slot_num is None else str(slot_num)
    argv = [str(program), str(session_id), str(exercise_name), slot_tok,
            str(set_seq), PREP_DONE_TOKEN, "--set-kind", SET_KIND_PREP]
    if spec["value"] is not None:
        argv += ["--target-reps", str(spec["value"])]
    code = (drill or {}).get("code") if isinstance(drill, dict) else None
    if code:
        argv += ["--drill-code", str(code)]
    if spec["hold_sec"] is not None:
        argv += ["--hold-sec", str(spec["hold_sec"])]
    load = (drill or {}).get("load_kg") if isinstance(drill, dict) else None
    if load is not None:
        argv += ["--weight", str(load)]
    return argv


