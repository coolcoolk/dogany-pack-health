SESSION_SLOT_NUM = None
# kit 061 (2026-09-30): the session-level row is slot_num NULL -- the kit's own
# "no program slot" -- and the value above moved from 0 to None. The argv token
# that carries it to set-add is `session`. Readers accept BOTH NULL and the old
# 0 (session_slot_sql below), so rows written before the move need no rewrite.
SESSION_SLOT_TOKEN = "session"
# reps token of a done-tap (prep / ramp): set-add stores reps NULL on a 061 DB.
PREP_DONE_TOKEN = "done"
# The one SQL predicate for "a session-level row", old and new shape alike.
SESSION_SLOT_SQL = "(slot_num IS NULL OR slot_num = 0)"

# Scope tokens returned on every drill by slot_prep_drills(). Machine tokens for
# the audit line and the render split -- never owner-facing text.
PREP_SCOPE_SESSION = "session"   # belongs to the SESSION (no program slot)
PREP_SCOPE_SLOT = "slot"         # belongs to THIS lift

# Basis tokens for mat_prep_host(). Machine tokens for the MAT_PREP_HOST audit
# line, never owner-facing text.
MAT_PREP_BASIS_LOGGED = "first_logged"     # this session already recorded a row
MAT_PREP_BASIS_ENTERING = "first_entry"    # nothing logged yet -> this entry
MAT_PREP_BASIS_FALLBACK = "fallback_slot1"  # no session context -> the constant

# The phase a slot-unbound drill must carry to be hosted at all. Named here
# (rather than spelled inline) because TWO readers now key on it -- the live
# per-slot projection and the day-level one below -- and they must agree
# exactly: a day-level count that admits one more drill than the live plan
# emits would put a cell in the denominator with nothing behind it.
PREP_PHASE_MAT = PREP_PHASE_ORDER[0]       # "mat_prep"


def is_session_prep(drill):
    """True when this prep.yaml item belongs to the SESSION and not to a lift.

    THE predicate. Two things ask this question -- slot_prep_drills (which
    lift hosts it) and session_prep_drills (does the day have any at all) --
    and a second copy is exactly how the card's denominator would come to
    count a drill the live plan never emits.

    Slot-unbound is NECESSARY but not SUFFICIENT. `phase == mat_prep` is the
    owner's 2026-08-14 「무릎 나쁜 날만」 ruling, not a filter someone forgot to
    remove: 뒷A's K1 is slot-unbound equipment_prep, offered on the morning
    card and taken only on a bad-knee day. Admitting it here would push a
    CONDITIONAL drill into the mandatory prep band -- and that band gates the
    working lane (set-arm.prep_lane_open), so a drill the owner chose to skip
    would block the owner's first working set."""
    if not isinstance(drill, dict):
        return False
    return (drill.get("live_slot") is None
            and drill.get("phase") == PREP_PHASE_MAT)


def session_prep_drills(rx, program_path, day_code):
    """The day's SESSION-LEVEL prep drills -- DAY-level, no slot context.

    slot_prep_drills answers "which drills does THIS lift host", so it needs a
    slot and a session to resolve the host. The card's denominator asks a
    strictly smaller question -- "does this DAY have session-level prep, and
    how many drills is it" -- which has an answer before any session exists
    and does not move when the host slot does. Answering it through
    slot_prep_drills would mean sweeping every slot and de-duplicating, i.e.
    re-deriving a day fact from a per-slot projection.

    Returns the raw prep.yaml items (no scope tag, no equipment check -- those
    belong to the live plan). Best-effort: any miss -> []."""
    if not (rx and program_path and day_code):
        return []
    try:
        items = rx.prep_day_items(rx.load_prep(program_path), day_code) or []
    except Exception:      # noqa: BLE001 -- a prep miss must never break a card
        return []
    return [d for d in items if is_session_prep(d)]


def first_logged_slot(db_path, session_id):
    """slot_num of the FIRST row this session recorded, or None when it has
    recorded nothing (or the DB cannot be read).

    ORDER BY id, not by recorded_at: a corrected row keeps its id but takes a
    new timestamp, and the question here is which lift the session STARTED on,
    which is an insertion-order fact. Best-effort by design -- every caller
    treats None as 'the session has not started yet'.

    `slot_num >= 1` is part of the question, not an optimisation. The caller is
    mat_prep_host, which asks WHICH PROGRAM SLOT this session started on, and
    session-level prep rows carry SESSION_SLOT_NUM (NULL; 0 before kit 061)
    precisely because they
    are not one. They are also written FIRST, so without this predicate the very
    rows whose host is being resolved would answer the question about their own
    host -- the host would resolve to 0, no slot would ever match it, and every
    session-level drill would vanish from every surface. That is the same
    silent-drop failure the 2026-09-01 note below describes, reintroduced from
    the other side."""
    if not (db_path and session_id):
        return None
    try:
        conn = sqlite3.connect(db_path)
    except Exception:      # noqa: BLE001 -- an unreadable DB is not an answer
        return None
    try:
        row = conn.execute(
            "SELECT slot_num FROM workout_sets WHERE session_id = ? "
            "AND slot_num >= 1 ORDER BY id LIMIT 1", (session_id,)).fetchone()
    except sqlite3.OperationalError:
        row = None
    finally:
        conn.close()
    if not row or row[0] is None:
        return None
    try:
        return int(row[0])
    except (TypeError, ValueError):
        return None


def mat_prep_host(entering_slot=None, db_path=None, session_id=None):
    """(slot_num, basis) -- which slot hosts THIS session's session-level prep.

    Precedence, strongest first:
      1. the slot of the session's first recorded row (MAT_PREP_BASIS_LOGGED).
         Once the session has written anything, the lift it started on is a
         fact, so the host stops moving -- the answer is stable for every
         later caller and idempotent across re-entries.
      2. the slot being entered/rendered right now (MAT_PREP_BASIS_ENTERING).
         Only reachable while the session has recorded NOTHING, i.e. on its
         first entry -- which is precisely the lift mat prep is performed in
         front of.
      3. MAT_PREP_LIVE_SLOT (MAT_PREP_BASIS_FALLBACK), for a caller with no
         session context. That is the pre-2026-09-01 behaviour, unchanged.

    The one soft spot is (2): before any row exists, ANY slot asked about
    answers 'me'. That window is a single turn, it can only ever ADD the drills
    to a plan (never drop them), and render emits MAT_PREP_HOST so the basis is
    auditable rather than inferred. The alternative -- pinning the host to an
    .exercise-entered marker -- buys nothing here: exercise-enter writes that
    marker LAST, so it does not exist yet at the moment this question is asked
    on a first entry."""
    logged = first_logged_slot(db_path, session_id)
    if logged is not None:
        return logged, MAT_PREP_BASIS_LOGGED
    # The entering branch is reachable ONLY with a session in hand. Without one
    # there is no "this session's first lift" to answer with, and answering
    # `entering_slot` anyway would make EVERY slot host the mat prep -- the
    # morning card, the day audit and every 4-argument caller would each see the
    # drills repeated on every slot of the day. No context -> the constant.
    if session_id is not None and entering_slot is not None:
        try:
            return int(entering_slot), MAT_PREP_BASIS_ENTERING
        except (TypeError, ValueError):
            pass
    return MAT_PREP_LIVE_SLOT, MAT_PREP_BASIS_FALLBACK


def slot_prep_drills(rx, program_path, day_code, slot_num, db_path=None,
                     session_id=None):
    """This slot's LIVE prep drills, hydrated from prep.yaml -- the ONE
    projection both the table and exercise-enter's live plan read, so the two
    can never list different drills or different targets.

    NOT rx.prep_slot_drills(): that projection whitelists the pre-A3 key set
    (code / phase / display / hold_sec) and therefore DROPS `target_reps`, the
    field that makes a prep drill a set. This reads the raw day items and keeps
    every declared key. rx-calc stays the loader and the display enricher; the
    live projection lives here, next to the table that renders it.

    db_path / session_id are OPTIONAL and carry the SESSION context that
    decides which slot hosts session-level mat prep (mat_prep_host). Omit them
    and the host falls back to MAT_PREP_LIVE_SLOT, i.e. the exact pre-2026-09-01
    answer -- so every existing caller and test that passes four arguments is
    unchanged.

    Best-effort: any miss -> []."""
    if not (rx and program_path and day_code and slot_num):
        return []
    try:
        want = int(slot_num)
    except (TypeError, ValueError):
        return []
    try:
        items = rx.prep_day_items(rx.load_prep(program_path), day_code) or []
    except Exception:      # noqa: BLE001 -- a prep miss must never break a table
        return []
    host, _basis = mat_prep_host(entering_slot=want, db_path=db_path,
                                 session_id=session_id)
    out = []
    for d in items:
        if not isinstance(d, dict):
            continue
        live = d.get("live_slot")
        if live is None:
            # No live_slot -> this drill belongs to the SESSION, not to a lift.
            # Mat prep surfaces on the host slot (mat_prep_host) and now carries
            # PREP_SCOPE_SESSION so the table can say WHOSE it is.
            #
            # THE PHASE TEST HERE IS LOAD-BEARING, NOT AN OVERSIGHT. Checked
            # 2026-09-10, and the check REVERSED ITS OWN FIRST CONCLUSION --
            # recorded because the next reader will reach for the same wrong one.
            # A "declared vs live-plan" audit shows 뒷A declaring 6 prep items
            # and the live plan emitting 5, with 「무릎 스크루홈 회전 드릴」 (K1,
            # phase equipment_prep, no live_slot) missing; the live data agrees
            # (session 10097, 뒷A: exactly 5 prep rows). That looks precisely
            # like a silent drop. It is not one.
            #
            # K1 IS on 뒷A's morning card -- verified through
            # rx.prep_card_blocks, which emits it under equipment_prep. Its
            # absence from the LIVE plan is the owner's 2026-08-14 「무릎 나쁜
            # 날만」 ruling: offered on the card, taken only on a bad-knee day.
            # tests/test-prep-slot-hosting.py pins it in LIVE_UNBOUND with that
            # rationale, and L4's conservation check is written to expect it.
            #
            # Auto-hosting it would push a CONDITIONAL drill into the mandatory
            # prep band on every 뒷A session -- and because the band GATES the
            # working lane (set-arm.prep_lane_open), a drill the owner chose not
            # to do would block the owner's first working set. The audit that "found"
            # the drop had only looked at one of the two surfaces.
            # is_session_prep carries the phase test (and its rationale). Same
            # predicate the DAY-level count uses, so the card's denominator and
            # the live plan can never admit a different set of drills.
            if not (is_session_prep(d) and want == host):
                continue
            scope = PREP_SCOPE_SESSION
        else:
            try:
                if int(live) != want:
                    continue
            except (TypeError, ValueError):
                continue
            scope = PREP_SCOPE_SLOT
        item = dict(d)
        item["prep_scope"] = scope
        # The slot_num this drill's row must be WRITTEN with. Resolved here,
        # in the one projection that knows the scope, so no caller has to
        # re-derive it (and none can derive it differently).
        item["write_slot_num"] = (SESSION_SLOT_NUM
                                  if scope == PREP_SCOPE_SESSION else want)
        out.append(item)
    # THE REQUIREMENT IS RESOLVED HERE, ONCE, 2026-09-02 (D7).
    #
    # This is the one projection that has both the drills and the db_path, so
    # it is the one place that can answer "is the thing this drill needs
    # actually in the gym" -- and having exactly one place answer it is the
    # point. `'덤벨 풀오버(벤치 시)'` failed because the condition lived in a
    # display string, so the only available action was to READ IT ALOUD, with
    # one 완료 button behind it: a question the owner had no way to answer.
    #
    # Resolved here, the downstream emitter never sees a condition -- it sees
    # either "announce plainly" or "offer a skip branch".
    #
    # `requires_unmet` stays ABSENT (not []) when the inventory could not be
    # read. Absent means "not checked"; [] means "checked, all satisfied". A
    # plan that could not check must not be able to claim the gym is empty.
    inventory = None
    if db_path:
        try:
            inventory = rx.registered_equipment(db_path)
        except Exception:  # noqa: BLE001 -- inventory is advisory, never a gate
            inventory = None
    if inventory is not None:
        for d in out:
            need = d.get("requires") or []
            if need:
                try:
                    d["requires_unmet"] = rx.requirements_unmet(
                        None, d.get("code"), d, inventory=inventory)
                except Exception:  # noqa: BLE001
                    pass
    # PREP LOAD IS OBSERVED, NOT PRESCRIBED (root 3 item 3; kit 061,
    # 2026-09-30). prep.yaml's load_kg wins when the owner stated one. Else
    # the load the owner last USED on this drill (a prep row carrying this
    # drill_code and a weight) is handed back with its date. A drill with an
    # implement and no observation anywhere is marked load_ask -- the one
    # place the model asks once and records the answer (set-add --weight on
    # the prep row), after which this read answers.
    if db_path:
        for d in out:
            if d.get("load_kg") is not None or not d.get("code"):
                continue
            hit = drill_load_last(db_path, d.get("code"),
                                  before_session=session_id)
            if hit is not None:
                d["load_kg"], d["load_as_of"] = hit[0], hit[1]
                d["load_source"] = PREP_LOAD_OBSERVED
            elif isinstance(d.get("implement"), str) and d["implement"].strip():
                d["load_ask"] = True
    return out


PREP_LOAD_OBSERVED = "observed"


def drill_load_last(db_path, drill_code, exercise=None, before_session=None):
    """(kg, date) the owner last used on this prep drill, or None. The pack's
    read of kit 061 `drill-load-last` (training_axis.drill_load_last): prep
    rows only, a load must be stated (a done-tap with no weight is not an
    observation of 0 kg), newest first, the session being planned excluded.
    Pre-061 DB (no drill_code column) / any read miss -> None."""
    try:
        conn = sqlite3.connect(db_path)
    except Exception:  # noqa: BLE001
        return None
    try:
        sql = ("SELECT ws.weight_kg, w.date FROM workout_sets ws "
               "JOIN workouts w ON w.id = ws.session_id "
               "WHERE ws.drill_code = ? AND ws.set_kind = 'prep' "
               "AND ws.weight_kg IS NOT NULL")
        args = [drill_code]
        if exercise:
            sql += " AND ws.exercise_name = ?"
            args.append(exercise)
        if before_session is not None:
            sql += " AND ws.session_id <> ?"
            args.append(int(before_session))
        row = conn.execute(
            sql + " ORDER BY w.date DESC, ws.recorded_at DESC, ws.id DESC "
            "LIMIT 1", args).fetchone()
        return (float(row[0]), row[1]) if row else None
    except Exception:  # noqa: BLE001 -- pre-061 DB: nothing was ever keyed
        return None
    finally:
        conn.close()


