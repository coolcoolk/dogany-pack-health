# Width: set is THREE display columns in the 5-wide SET column, and ctr()
# measures in _disp_w (not len), so the row pads to the same 36-column border as
# every ASCII cell. A test pins the uniform line width.
SET_COL_LABEL_BW = "set"


def set_col_label(label):
    """The SET-column TEXT for an internal rung/set label: 'bw' -> set,
    ramp r1 -> w1, and working labels verbatim.

    DISPLAY ONLY. Never compare against this and never store it -- seq_label's
    output is the label; this is what the owner reads in that column."""
    value = str(label)
    if value == "bw":
        return SET_COL_LABEL_BW
    if value.startswith("r") and value[1:].isdigit():
        return "w" + value[1:]
    return value


# ---------------------------------------------------------------------------
# G12 (owner-confirmed 2026-08-07): planned warmup + ramp-up rows in the set
# table, prepended before working-set rows. Algorithm mirrors ax_engine.py
# _f6_ramp_sets / _ramp_pick_step (warmup-stretch.md B7/F6, snap-first
# reconfirmed 2026-08-15 + batch G11):
#
#   - Empty bar (20 kg) is always the first rung.
#   - Pick ONE per-side step-plate (largest that yields 1-3 intermediate rungs).
#   - Rungs: bar + 2*step_plate*k for k=1,2,... strictly below working weight.
#   - No micro plates (1.25/0.75) on ramp rungs.
#   - Only fires for ax_exercise compound+freeweight exercises (F6 gate).
#   - Best-effort: any DB error -> no planned ramp (degrades gracefully).
# ---------------------------------------------------------------------------
_RAMP_EMPTY_BAR_KG = 20.0
_RAMP_STEP_PLATES = (20.0, 15.0, 10.0, 5.0, 2.5)   # per-side, descending
_RAMP_TARGET_INTS = 2    # sweet-spot intermediate count (bar + 2 ints + working)
_RAMP_MIN_INTS = 1
_RAMP_MAX_INTS = 3


def _ramp_intermediates(working_weight, step_plate):
    """Intermediate rung weights strictly between the empty bar and the working
    weight for one per-side step plate: bar + 2*step_plate*k for k=1,2,...
    Returns an ascending list (may be empty)."""
    out = []
    k = 1
    while True:
        w = _RAMP_EMPTY_BAR_KG + 2.0 * step_plate * k
        if w >= working_weight - 1e-9:
            break
        out.append(round(w, 4))
        k += 1
    return out


def _ramp_pick_step(working_weight):
    """Pick the per-side step-plate whose intermediate count is closest to
    _RAMP_TARGET_INTS (ties: prefer larger plate). Returns (step_plate, ints)
    or (None, []) when no plate yields a valid count."""
    best = None
    for p in _RAMP_STEP_PLATES:
        ints = _ramp_intermediates(working_weight, p)
        n = len(ints)
        if _RAMP_MIN_INTS <= n <= _RAMP_MAX_INTS:
            dist = abs(n - _RAMP_TARGET_INTS)
            if best is None or dist < best[0]:
                best = (dist, p, ints)
    if best is None:
        return None, []
    return best[1], best[2]


def _exercise_class(db_path, exercise_name):
    """Return (movement, load_type) for an active ax_exercise row, or
    (None, None) when the exercise is unknown / inactive / the table is missing.
    Best-effort: any DB error -> (None, None). F6 gate uses this to decide the
    ramp KIND (barbell vs machine) deterministically instead of a single
    freeweight-only boolean."""
    try:
        conn = sqlite3.connect(db_path)
        try:
            row = conn.execute(
                "SELECT movement, load_type FROM ax_exercise "
                "WHERE exercise_name=? AND status='active' LIMIT 1;",
                (exercise_name,)
            ).fetchone()
            if row is None:
                return None, None
            return row[0], row[1]
        finally:
            conn.close()
    except Exception:
        return None, None


def _is_ramp_exercise(db_path, exercise_name):
    """True iff the exercise is compound+freeweight in ax_exercise (barbell F6
    gate -- the ORIGINAL bar+plate ramp). Machine ramps go through
    _is_machine_ramp_exercise instead. Best-effort: any error -> False.

    #39-B: delegates to the shared SoT ax_engine.is_free_weight_compound. The
    ramp-KIND decision is UNCHANGED (byte-identical rows); the plate cue layers
    one extra check on top of this same predicate (ax_engine.is_plate_loaded),
    so the two surfaces can never drift apart on which lifts have a bar."""
    return ax_engine().is_free_weight_compound(db_path, exercise_name)


def _is_bar_primer_exercise(db_path, exercise_name, slot=None):
    """True iff this lift's set_seq==0 primer rung is an EMPTY 20kg BARBELL
    rather than a genuine bodyweight primer -- the WT-column disambiguator for
    the shared NULL-weight sentinel (see build_grid.wt_cell).

    Delegates to the shared SoT ax_engine.is_plate_loaded, the SAME "which lifts
    have a bar" gate set-arm's per-set plate cue uses, so the set table and the
    cue can never disagree about whether the user is holding a bar. That is STRICTER
    than _is_ramp_exercise on purpose: _is_ramp_exercise is compound+freeweight,
    which also matches a FIXED-DUMBBELL press (incline_dumbbell_press) -- and a
    dumbbell press has no empty bar. `slot` supplies the program.yaml
    `lattice.type` that carries that second signal; None degrades to the
    ax_exercise signal alone. Best-effort: any error -> False (keep "bw")."""
    lat = (slot or {}).get("lattice")
    lattice_type = (lat or {}).get("type") if isinstance(lat, dict) else None
    try:
        return ax_engine().is_plate_loaded(db_path, exercise_name, lattice_type)
    except Exception:      # noqa: BLE001 -- a gate miss must never break a table
        return False


def _is_machine_ramp_exercise(db_path, exercise_name):
    """#9/F6-ext (owner-confirmed 2026-08-19): True iff the exercise is a
    machine/stack loaded lift that should still get warmup/ramp rows -- the live
    bug was v_squat (compound+MACHINE) rendering working sets only, because the
    F6 gate was freeweight-only, so no bw->ramp rows appeared even though the user
    ramps it. The ramp KIND differs (no 20kg bar; rungs step up in the machine's
    own load unit -- see _machine_ramp_rungs), but the DECISION to include a ramp
    is deterministic: compound machines always ramp; isolation machines ramp only
    when the working load is heavy enough to warrant a lighter primer (see
    planned_ramp_rows' floor). Best-effort: any error -> False (no ramp).

    A3 (2026-08-25): `cable` joined the tuple. It was missing, and that omission
    IS the face_pull defect -- the owner's load rose 25 -> 28.75kg on a PIN
    STACK and the session announced "워밍업은 별도 없이 바로 워킹세트입니다".
    A cable stack is physically the same object this predicate was written for:
    a pin in a plate stack, set by reading a number, ramped by moving the pin.
    The tuple was meant to name that object and named two of its three DB
    spellings. `bodyweight` / `freeweight` are deliberately still out -- they
    have no stack and are handled by the barbell gate or not at all."""
    movement, load_type = _exercise_class(db_path, exercise_name)
    return load_type in _MACHINE_RAMP_LOAD_TYPES and movement is not None


def _plate_breakdown(total_weight):
    """#39: per-side plate load for a barbell ramp/working weight
    ('바 20kg + 양쪽 N kg'). Thin delegation to the shared SoT -- see
    ax_engine.plate_breakdown for the bar constant and the formatting rule.
    Kept as a module-level name so existing call sites and tests
    (st._plate_breakdown) bind to the SoT transparently.

    #39-B (owner 2026-08-21): this no longer feeds a static [원판] BLOCK at the
    bottom of the table -- that block is REMOVED. It survives only as the
    per-rung `plate_note` on planned_ramp_rows; the owner-facing plate math is
    now delivered per-set, at cue time, by set-arm's set-start push."""
    return ax_engine().plate_breakdown(total_weight, _RAMP_EMPTY_BAR_KG)


# #9/F6-ext machine ramp: a machine/stack lift has no 20kg bar, so its ramp is a
# short weight ladder that steps UP to the working weight in a single clean load
# unit (the machine's own increment), never a bar+plate composition. The unit is
# picked deterministically (no model %-guess): the largest increment from
# _MACHINE_RAMP_UNITS that yields _RAMP_TARGET_INTS rungs between a light floor
# and the working weight. The floor is a clean fraction of the working weight so
# the first rung is a genuine warm-up (light), not the working load itself.
# The ax_exercise `load_type` values that mean "a numbered stack setting" -- the
# equipment class that ramps by moving a pin. See _is_machine_ramp_exercise.
_MACHINE_RAMP_LOAD_TYPES = ("machine", "stack", "cable")
_MACHINE_RAMP_UNITS = (20.0, 15.0, 10.0, 5.0, 2.5)   # clean load steps, desc
_MACHINE_RAMP_MIN_KG = 5.0        # never ramp a load lighter than this (isolation)
_MACHINE_RAMP_FLOOR_FRAC = 0.45   # first-rung target = ~this fraction of working


def _machine_ramp_rungs(working_weight):
    """Deterministic warmup/ramp rungs (ascending, EXCLUDING the working weight)
    for a lift with NO UNLOADED START STATE -- a machine, a stack, or a FIXED
    DUMBBELL. Rungs step up by ONE clean unit toward the working weight from a
    light floor (~_MACHINE_RAMP_FLOOR_FRAC of working). Returns an ascending list
    of rung weights (may be empty). No 20kg bar, no plate math -- the number is
    read straight off the stack/pin or stamped on the bell, so each rung is just
    a lighter setting. Mirrors _ramp_pick_step's target-count logic anchored on
    the working weight instead of the empty bar.

    Output is UNSNAPPED: the caller (planned_ramp_rows) gates every rung through
    the exercise's DECLARED load grid (_snap_rungs). This function only picks the
    ladder SHAPE; which values are physically settable is grid knowledge and is
    read from data, never re-decided here.

    Tie-break (2026-08-24): when two units are equidistant from
    _RAMP_TARGET_INTS, the one with MORE rungs wins. It used to be the larger
    unit, which collapsed a 30kg working load to a SINGLE rung (unit 15 -> [15],
    n=1) instead of the three-rung [15, 20, 25] unit-5 ladder -- the standing
    e18/e19 failure in test-set-table-loading. _RAMP_MAX_INTS already caps the
    count, so "more rungs" can only ever mean smaller, safer jumps."""
    if working_weight is None or working_weight <= _MACHINE_RAMP_MIN_KG:
        return []
    floor = working_weight * _MACHINE_RAMP_FLOOR_FRAC
    best = None
    for unit in _MACHINE_RAMP_UNITS:
        # Rungs: working - unit*k for k=1,2,... strictly above the floor.
        rungs = []
        k = 1
        while True:
            w = working_weight - unit * k
            if w <= floor + 1e-9:
                break
            rungs.append(round(w, 4))
            k += 1
        n = len(rungs)
        if _RAMP_MIN_INTS <= n <= _RAMP_MAX_INTS:
            dist = abs(n - _RAMP_TARGET_INTS)
            # (dist asc, count desc) -- closest to the target count first, then
            # the fuller ladder.
            key = (dist, -n)
            if best is None or key < best[0]:
                best = (key, list(reversed(rungs)))   # ascending
    if best is None:
        # No clean unit yielded a valid rung count (working weight barely above
        # the floor). Fall back to a single light primer rung at the floor,
        # snapped to the smallest clean unit so it is a real reachable setting.
        smallest = _MACHINE_RAMP_UNITS[-1]
        snapped = round(floor / smallest) * smallest
        if _MACHINE_RAMP_MIN_KG - 1e-9 < snapped < working_weight - 1e-9:
            return [round(snapped, 4)]
        return []
    return best[1]


# ---------------------------------------------------------------------------
# DECLARED LOAD GRID -- the one place the ramp asks "what loads can this lift
# actually be set to, and does an UNLOADED start state exist?" (2026-08-24).
#
# Both questions were previously re-implemented by hand here while the answers
# already sat in data, and the two drifted apart in front of the owner:
#   * a fixed-DUMBBELL press got the BARBELL ladder (empty 20kg bar first),
#     because the gate was the proxy `compound + freeweight` -- which a dumbbell
#     press satisfies. There is no such thing as an empty dumbbell.
#   * the same ladder prescribed 25.0kg on a rack that only stocks EVEN kg,
#     because no rung was ever snapped to the declared grid.
# Both rules are declared, in three places, in this vocabulary:
#   1. ax_projection_rule / FREEWEIGHT_lattice_round.action_param.freeweight_grid
#      -> per exercise {"type": standard|even, "base", "coarse_step",
#         ["working_step"]}. COARSE is the warmup/ramp grid (working_step is the
#         micro grid and is deliberately NOT used for a rung -- see
#         warmup-stretch.md "램프 세트엔 마이크로 원판 쓰지 않음").
#   2. program.yaml slot `lattice` -> {type, base, step} (the working grid).
#   3. ax_machine.loading_method + lattice_base/lattice_step for a
#      machine-backed exercise.
# `type` is the SAME token set ax_engine.snap_to_lattice consumes and that
# ax_engine.NON_PLATE_LATTICE_TYPES already reads as "this is not a bar".
# ---------------------------------------------------------------------------

# ax_machine.loading_method -> snap_to_lattice grid type. 'assisted' is a pin
# stack read the other way round (counterweight), but the SETTABLE values are
# still base + k*step, so it snaps as a stack.
_MACHINE_LOADING_TO_GRID_TYPE = {
    "plate_loaded": "standard",
    "even": "even",
    "stack": "stack",
    "assisted": "stack",
}


def _slot_lattice(slot):
    """program.yaml slot `lattice` dict, or None."""
    lat = (slot or {}).get("lattice") if isinstance(slot, dict) else None
    return lat if isinstance(lat, dict) and lat.get("type") else None


# One taxonomy note per process, per db. set-table renders row by row and a
# per-row repeat of the same diagnostic would bury the table it is describing.
_TAXONOMY_WARNED = set()


def _warn_unseeded_once(db_path):
    """Name the never-seeded taxonomy on stderr, once. Degrade-safe by
    construction: any failure inside the probe is swallowed, because a
    diagnostic must never be able to break the render it is annotating."""
    try:
        key = os.path.abspath(db_path)
        if key in _TAXONOMY_WARNED:
            return
        _TAXONOMY_WARNED.add(key)
        ax = ax_engine()            # the same engine module the ladder uses
        report = ax.taxonomy_probe(db_path)
        if report["verdict"] in ax.BAD_VERDICTS:
            print("[set-table] %s" % ax.taxonomy_one_line(report),
                  file=sys.stderr)
    except Exception:      # noqa: BLE001
        return


def _db_freeweight_grid(db_path, exercise_name):
    """This exercise's COARSE freeweight grid from the active `lattice_round`
    projection rule (ax_projection_rule.action_param.freeweight_grid), or None.

    This is the rule table ax_engine._freeweight_grid_param already reads for
    the engine-side ramp; reading it here is what stops the table/arm ladder
    from being a second, hand-written copy of the same grid.

    NO GRID vs NO TABLE (2026-09-12). None means "nothing declares a grid for
    this lift", and declared_load_grid's contract is to fall through to the
    slot lattice rather than guess. On a never-seeded install the table holds
    ZERO rules, so priority 1 is not missing for this exercise -- it is
    structurally absent for every exercise, and the ladder silently drops to
    the WORKING grid for rungs the coarse grid owns. This function still
    degrades (a table must never fail to render) but it NAMES the cause once,
    on stderr, instead of letting it read as a per-exercise data gap."""
    try:
        conn = sqlite3.connect(db_path)
        try:
            rows = conn.execute(
                "SELECT action_param FROM ax_projection_rule "
                "WHERE status='active' AND action_kind='lattice_round';"
            ).fetchall()
            if not rows:
                _warn_unseeded_once(db_path)
        finally:
            conn.close()
    except Exception:      # noqa: BLE001 -- a grid miss must never break a table
        return None
    for (param,) in rows:
        if not param:
            continue
        try:
            grids = (json.loads(param) or {}).get("freeweight_grid") or {}
        except Exception:  # noqa: BLE001 -- malformed param: ignore, never guess
            continue
        g = grids.get(exercise_name)
        if isinstance(g, dict) and g.get("type") and g.get("coarse_step"):
            return {"type": g["type"], "base": g.get("base", 0.0),
                    "step": g["coarse_step"]}
    return None


def _db_machine_grid(db_path, exercise_name):
    """The backing machine's declared grid (ax_machine.loading_method +
    lattice_base/lattice_step) for a machine/cable exercise, or None when the
    exercise has no machine_ref or the machine's grid was never measured
    (provisional rows carry NULL base/step -- we snap nothing rather than
    invent a grid)."""
    try:
        conn = sqlite3.connect(db_path)
        try:
            row = conn.execute(
                "SELECT m.loading_method, m.lattice_base, m.lattice_step "
                "FROM ax_exercise e JOIN ax_machine m ON m.ulid = e.machine_ref "
                "WHERE e.exercise_name=? AND e.status='active' LIMIT 1;",
                (exercise_name,)).fetchone()
        finally:
            conn.close()
    except Exception:      # noqa: BLE001
        return None
    if not row:
        return None
    loading, base, step = row
    gtype = _MACHINE_LOADING_TO_GRID_TYPE.get(loading)
    if gtype is None or base is None or step is None or step <= 0:
        return None
    return {"type": gtype, "base": float(base), "step": float(step)}


def declared_load_grid(db_path, exercise_name, slot=None):
    """The load grid a ramp rung for this exercise must land on, or None when
    NOTHING declares one (then no snap happens -- an unmeasured grid is a data
    gap to fill, never a number to guess).

    Priority is coarse-before-fine, declared-before-inherited:
      1. ax_projection_rule freeweight_grid  (per-exercise, COARSE ramp step)
      2. program.yaml slot lattice           (the slot's working grid)
      3. ax_machine lattice_base/lattice_step
    """
    return (_db_freeweight_grid(db_path, exercise_name)
            or _slot_lattice(slot)
            or _db_machine_grid(db_path, exercise_name))


def _is_assist_loaded(db_path, exercise_name):
    """True iff the backing machine is ASSIST-loaded (ax_machine.loading_method
    = 'assisted' -- the chin-up / pull-up assist stack).

    On an assist machine the number is COUNTERWEIGHT, so the load axis is
    INVERTED: a SMALLER number is a HARDER set. Every ladder generator here
    walks DOWN from the working value, which on an assist stack yields a warm-up
    HARDER than the working set. Nothing in the declared data says how far UP the
    assist stack goes, so the honest output is no synthesized ramp at all rather
    than a wrong-direction number -- a missing rung costs a question, a wrong
    rung gets written to the training log and becomes progression input.
    (Pre-existing defect: the old assist ladder was already inverted, at one
    rung. This declines rather than deepening it.) Any error -> False."""
    try:
        conn = sqlite3.connect(db_path)
        try:
            row = conn.execute(
                "SELECT m.loading_method FROM ax_exercise e "
                "JOIN ax_machine m ON m.ulid = e.machine_ref "
                "WHERE e.exercise_name=? AND e.status='active' LIMIT 1;",
                (exercise_name,)).fetchone()
        finally:
            conn.close()
    except Exception:      # noqa: BLE001 -- never break a table on a gate miss
        return False
    return bool(row) and row[0] == "assisted"


def _has_unloaded_start(db_path, exercise_name, slot=None, grid=None):
    """Does this lift have an UNLOADED START STATE -- a thing the owner can hold
    and move with no load on it? That, not "what is it made of", is the real
    condition for an empty-bar warm-up rung (2026-08-24 ruling: gate on whether
    an unloaded start state exists, not on filtering out dumbbells).

      barbell / smith  -> the empty 20kg bar exists            -> True
      fixed dumbbell   -> there is no such thing as an empty bell -> False
      stack / cable    -> even the lightest pin is load        -> False
      machine          -> handled by the machine ladder, no bar -> False

    Read from data, not re-decided: the exercise is a FREEWEIGHT lift
    (ax_exercise.load_type) whose DECLARED grid is the bar+plate one
    ('standard'). 'even' (고정덤벨 짝수kg) and 'stack' are exactly the tokens
    ax_engine.NON_PLATE_LATTICE_TYPES already means by "not a bar".

    When nothing declares a grid, degrade to the shared gate
    ax_engine.is_plate_loaded -- the historical behaviour, never looser."""
    if grid is None:
        grid = declared_load_grid(db_path, exercise_name, slot)
    _movement, load_type = _exercise_class(db_path, exercise_name)
    if grid is not None:
        if load_type != "freeweight":
            return False        # machine/cable/bodyweight: no bar in their hands
        return str(grid.get("type", "")).strip().lower() == "standard"
    lat = _slot_lattice(slot)
    try:
        return ax_engine().is_plate_loaded(db_path, exercise_name,
                                           (lat or {}).get("type"))
    except Exception:      # noqa: BLE001 -- a gate miss must never break a table
        return False


def _snap_rungs(rungs, grid, working_weight, floor):
    """Gate a raw ladder through the declared grid: snap every rung onto a
    settable value, drop anything at/below `floor` or at/above the working
    weight, de-duplicate collisions, and return it strictly ascending.

    Snapping is ax_engine.snap_to_lattice -- the SAME rounder rx-calc uses for
    the working weight, so a rung and a working set can never disagree about
    which numbers this equipment can actually be set to. grid None -> no snap
    (the ladder is returned filtered only), because an undeclared grid is a
    data gap, not a licence to round to something invented."""
    out = []
    for w in rungs:
        if w is None:
            continue
        if grid is not None:
            try:
                w = ax_engine().snap_to_lattice(w, grid)
            except Exception:  # noqa: BLE001 -- snap miss -> keep the raw value
                pass
        if w is None:
            continue
        w = round(float(w), 4)
        if w <= floor + 1e-9 or w >= working_weight - 1e-9:
            continue
        if out and w <= out[-1] + 1e-9:
            continue          # collision after snapping: one rung, not two
        out.append(w)
    return out


