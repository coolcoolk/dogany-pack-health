def prep_cue_lines(drill, label=None):
    """The cue lines for one drill: setup, sensation, or an explicit absence.

    `sensation` is the D27 field and it carries an instruction to state it
    BEFORE the owner asks, because the measured failure was ordering, not
    knowledge: the model answered "벽을 미는 느낌이냐" correctly and only
    because the owner asked.

    A drill with no recorded cue emits PREP_CUE_MISSING and the model says
    NOTHING about form. Silence is the correct output for an unknown; an
    invented sensation for a rehab drill is the 헤일로 '원판 6kg' defect one
    column over."""
    drill = drill if isinstance(drill, dict) else {}
    tag = ("%s " % label) if label else ""
    cue = drill.get("cue")
    cue = cue if isinstance(cue, dict) else {}
    setup = cue.get("setup") or drill.get("howto")
    sensation = cue.get("sensation")
    out = []
    if setup:
        out.append('PREP_CUE_SETUP %scode=%s "%s"'
                   % (tag, drill.get("code"), str(setup).replace('"', "'")))
    if sensation:
        out.append(
            'PREP_CUE_SENSATION %scode=%s "%s" -- state this WITH the drill, '
            'BEFORE the owner asks. It is the answer to "what should this feel like", '
            'and the measured defect is that it was only ever given when the owner '
            'asked for it.'
            % (tag, drill.get("code"), str(sensation).replace('"', "'")))
    if not setup and not sensation:
        out.append(
            "PREP_CUE_MISSING %scode=%s -- prep.yaml records no cue for this "
            "drill. Announce the name and the target and NOTHING about form. "
            "Do NOT compose a cue: an invented instruction about how a rehab "
            "drill should feel is the 헤일로 '원판 6kg' defect in a different "
            "column. Record the gap as a post-session item."
            % (tag, drill.get("code")))
    return out


def prep_implement_line(drill, label=None):
    """What the owner PICKS UP, as its own line -- B4, 2026-09-02.

    Owner 06:20: the cue still did not say the implement or the weight.
    `implement` (and `load_kg`) are already folded into the owner-facing
    `display` by rx-calc._with_equipment, but the display is a sentence and the
    machine name is a FACT the guidance turn should hand over on its own --
    U1c's 펙덱 disappeared entirely once its display was rewritten, because the
    only place naming it was prose.

    Absent implement -> NO LINE. There is no default and none is invented: a
    load with no implement renders as nothing (rx-calc/ui_labels contract) and
    so does an implement nobody recorded."""
    drill = drill if isinstance(drill, dict) else {}
    imp = drill.get("implement")
    if not (isinstance(imp, str) and imp.strip()):
        return []
    tag = ("%s " % label) if label else ""
    load = drill.get("load_kg")
    extra = "" if load is None else " load_kg=%s" % load
    if load is not None and drill.get("load_source") == PREP_LOAD_OBSERVED:
        extra += " load_source=observed as_of=%s" % drill.get("load_as_of")
    lines = ['PREP_IMPLEMENT %scode=%s implement="%s"%s -- NAME THE EQUIPMENT '
             'when you announce this drill. Say only what is here: no weight '
             'unless load_kg is present, no substitute.'
             % (tag, drill.get("code"), str(imp).strip().replace('"', "'"),
                extra)]
    if drill.get("load_ask"):
        # kit 061 / root 3 item 3: observe, then record. First time only --
        # once a prep row carries a weight for this drill_code, the load is
        # read back and this line stops.
        lines.append('PREP_LOAD_ASK %scode=%s -- no load was ever recorded for '
                     'this drill. Ask ONCE which weight they use and pass it as '
                     '--weight on this drill\'s completion tap; from the next '
                     'session it is read back.' % (tag, drill.get("code")))
    return lines


def prep_requires_lines(drill, unmet, label=None):
    """The condition line for one drill -- RESOLVED, never narrated.

    `unmet` is the already-computed list from rx-calc.requirements_unmet(),
    produced once at slot_prep_drills(); the inventory lookup does not happen
    here, so this function cannot disagree with the one that decided.

    THE D7 SHAPE. `'덤벨 풀오버(벤치 시)'` was a condition inside a string, so
    the only thing that could be done with it was read it out -- and it was,
    with one 완료 button behind it and nothing to press if there was no bench
    ("벤치있으면? 킹받네"). Satisfied: say nothing about the condition at all.
    Unsatisfied: a SECOND affordance, so the question the owner is asked is
    one they can answer."""
    drill = drill if isinstance(drill, dict) else {}
    tag = ("%s " % label) if label else ""
    need = drill.get("requires") or []
    if not need:
        return []
    if not unmet:
        return ["PREP_REQUIRES_OK %scode=%s needs=%s -- available. Announce "
                "the drill plainly; do NOT state the condition, do NOT say "
                "'있으면' or ask whether the owner has it."
                % (tag, drill.get("code"), ",".join(need))]
    # THE SKIP BRANCH RECORDS NOTHING, AND THAT IS THE RECORD.
    #
    # There is deliberately no `--skip` flag invented for set-add here. The
    # prep band already answers "was this drill done" by whether its pN row
    # EXISTS: a skipped drill simply has no row, and the progress table shows
    # the gap. Adding a third state to workout_sets to say the same thing would
    # be a schema change bought with nothing, and this artifact does not touch
    # the schema.
    return [
        "PREP_REQUIRES_UNMET %scode=%s missing=%s -- NOT registered in the "
        "equipment inventory. Offer TWO options, never a bare 완료: "
        "[1] 완료  [2] 장비 없음 -- 건너뛰기. Option 1 runs the drill's prep "
        "command as normal. Option 2 runs NOTHING and moves to the next drill "
        "-- the absent row IS the record that it was skipped. Do NOT ask an "
        "open question, do NOT invent a substitute drill, and do NOT state the "
        "requirement as a condition the owner has to evaluate: the inventory "
        "is known to be incomplete (measured 2026-09-02 -- no bench "
        "registered, and the owner does incline dumbbell press), so the branch "
        "is the answer and the tap is the resolution."
        % (tag, drill.get("code"), ",".join(unmet))]


def prep_set_of_line(drill, spec, label=None):
    """`set=2/3` as an instruction -- ONE SET AT A TIME. [] for a single set.

    Owner 05:53: two prep rounds must be cued one round at a time, the same
    as two working sets are never batched. The argument is
    from symmetry and it is right: a working set is never batched, so a prep
    set must not be. rx-calc already expanded the sets; this line is what stops
    them being re-collapsed into one sentence at the moment of speaking."""
    spec = spec if isinstance(spec, dict) else {}
    drill = drill if isinstance(drill, dict) else {}
    total = spec.get("set_total") or drill.get("set_total") or 1
    try:
        total = int(total)
    except (TypeError, ValueError):
        total = 1
    if total <= 1:
        return []
    index = spec.get("set_index") or drill.get("set_index") or 1
    tag = ("%s " % label) if label else ""
    return ["PREP_SET_OF %scode=%s set=%s/%s -- announce THIS set only. Do NOT "
            "state the remaining sets, do NOT ask the owner to do them all and "
            "report back. The next set gets its own announcement and its own "
            "button after this one lands."
            % (tag, drill.get("code"), index, total)]


def prep_requirement_verdict(drill):
    """('ok' | 'unmet' | 'unchecked' | 'none', [missing, ...]).

    ONE reading of `requires_unmet`, so the affordance decision and the spoken
    line cannot disagree about it. The value is set upstream at
    slot_prep_drills():
        absent  inventory could not be read      -> 'unchecked'
        []      checked, every requirement met   -> 'ok'
        [...]   checked, these are missing       -> 'unmet'
    A plan that could not check must never be able to claim the gym is empty,
    which is why 'unchecked' is its own answer and not folded into either."""
    drill = drill if isinstance(drill, dict) else {}
    if not (drill.get("requires") or []):
        return ("none", [])
    unmet = drill.get("requires_unmet")
    if unmet is None:
        return ("unchecked", [])
    return (("unmet", list(unmet)) if unmet else ("ok", []))


def prep_drill_context_lines(drill, spec=None, label=None):
    """Every non-affordance guidance line for ONE drill, in speaking order:
    what the owner picks up, what to do, what it should feel like, whether
    they can, and which set this is.

    This is the whole of B1: the entry turn and the tap turn call THIS, so the
    twelve tap turns carry the same fields the one entry turn does."""
    drill = drill if isinstance(drill, dict) else {}
    out = prep_implement_line(drill, label)
    out.extend(prep_cue_lines(drill, label))
    verdict, missing = prep_requirement_verdict(drill)
    tag = ("%s " % label) if label else ""
    if verdict == "unchecked":
        # Could not check. Announce plainly rather than manufacture a branch
        # out of ignorance -- an unnecessary skip button is noise, but a wrong
        # claim about the owner's gym is a lie.
        out.append("PREP_REQUIRES_UNCHECKED %scode=%s needs=%s -- inventory "
                   "unavailable. Announce the drill plainly; do NOT state the "
                   "requirement as a condition."
                   % (tag, drill.get("code"),
                      ",".join(drill.get("requires") or [])))
    elif verdict != "none":
        out.extend(prep_requires_lines(drill, missing, label))
    out.extend(prep_set_of_line(drill, spec, label))
    if drill.get("schema_violation"):
        out.append("PREP_SCHEMA_VIOLATION %scode=%s kind=%s -- this drill has "
                   "no catalog entry in prep.yaml, so its zone, cue and "
                   "requirements are UNKNOWN rather than defaulted. Run it "
                   "from its stated target only, say nothing about form, and "
                   "record the gap as a post-session item."
                   % (tag, drill.get("code"), drill.get("schema_violation")))
    return out


def render(program, db_path, session_id, exercise_name, rx, program_path=None,
           signals=None):
    """Render the (2) set-progress table.

    `signals` (A3, 2026-08-25): an optional list the render APPENDS machine
    lines to -- RAMP_DECISION, WT_UNKNOWN, PREP_PLANNED, DAY_SOURCE,
    SESSION_UNTAGGED. They are NOT part of the returned string because they are
    not part of the table; they are the render telling its caller what it
    decided, so a decision can be audited instead of argued with (D3) and a `?`
    cell can be traced instead of excused (D5). Callers that pass nothing get
    exactly the previous behavior."""
    day_trace = {}
    day_code, exercises, slot, slot_idx, total_slots = find_day_and_slot(
        program, db_path, session_id, exercise_name, rx=rx, trace=day_trace)
    if slot is None:
        return None, ("ERROR: exercise %r not found in program.yaml "
                      "(day=%s session_code=%s day_source=%s)"
                      % (exercise_name, day_code,
                         day_trace.get("session_code"),
                         day_trace.get("source")))

    display = slot.get("display") or exercise_name
    loading = slot.get("loading")
    per_side = loading == "per_side"

    # F19/F21: the owner's mid-session target override for this (session,
    # exercise), persisted by set-arm. The header display becomes the override
    # name (F19 substitution, e.g. 케이블 플라이 -> 펙덱); the grid's planned
    # weight/reps/RIR follow the override (applied in build_grid). Absent -> {}.
    override = read_override(session_id, exercise_name)
    if override.get("display"):
        display = override["display"]

    # --- header ---
    # DGN-388 rest factor model needs cost_map/pattern_map or fatigue_adj
    # silently degrades to 0 (see rx-calc resolve_rest_sec docstring) --
    # mirror rx-calc's own call (get_fatigue_cost_map/get_pattern_map) so the
    # displayed rest matches what set-arm actually arms.
    cost_map = rx.get_fatigue_cost_map(db_path)
    pattern_map = rx.get_pattern_map(db_path)
    rest_sec, _basis = rx.resolve_rest_sec(slot, program, cost_map, pattern_map)
    ramps, work = fetch_current_sets(db_path, session_id, exercise_name)
    # ASSIST INVERSION: the cumulative volume line must use
    # (bodyweight_at_the_time - counterweight) x reps for an assisted
    # exercise. session-closeout parses THIS number back out of the rendered
    # header (parse_table_meta) and caches it into .exercise-closed/, so this
    # one line is also the source of the stored per-exercise volume.
    if _AL is not None:
        _vctx = _AL.context(db_path)
        _vdate = _vctx.session_date(session_id)
        done_vol = sum(
            _AL.set_volume(_vctx, exercise_name, s["weight_kg"], s["reps"],
                           _vdate) or 0.0
            for s in work if s["weight_kg"] is not None)
    else:
        done_vol = sum((s["weight_kg"] or 0) * s["reps"] for s in work
                       if s["weight_kg"] is not None)
    if per_side:
        done_vol *= 2
    done_cnt = sum(1 for s in work if s["weight_kg"] is not None)

    # RC1: today's rx-calc prescription is the single source for planned
    # weight/RIR (E22/E11) AND -- F6/RC1-ext -- the planned working-set COUNT
    # (fatigue-trimmed 'sets'). Fetch it once here so the header (done/total)
    # line and the grid's planned rows agree on the same trimmed count; the
    # program.yaml static count is only the fallback when rx yields nothing
    # (rx miss / instance without the muscle table).
    # day_code (resolved above from the session's own session_type_id) is handed
    # to rx so the prescription is keyed on the split BEING TRAINED, not on the
    # rotation queue's next regular day -- the 보충 blank-WT fix (2026-08-23).
    rx_slot = None
    if program_path is not None:
        today = session_today(db_path, session_id)
        rx_map = fetch_prescription(rx, program_path, today, db_path, session_id,
                                    rotation_day=day_code)
        rx_slot = rx_map.get(exercise_name)
    # A4 (program state step A): today's weight is the rx prescription and
    # nothing else. The card's weight_kg is a seed rx-calc already consulted
    # (only while nothing was logged); falling back to it here would print a
    # stale seed over a logged history whenever the rx read missed. Blank
    # stays blank (`?`), never a second opinion.
    rx_weight = rx_slot.get("weight_kg") if rx_slot else None
    rx_sets = rx_slot.get("sets") if rx_slot is not None else None
    total_sets = (rx_sets if rx_sets is not None else slot.get("sets")) or 0

    header_top = display
    header = [
        header_top,
        "═" * GRID_WIDTH,
        muscle_line(db_path, exercise_name, rest_sec),
    ]

    # --- trend ---
    points = session_history(db_path, exercise_name, per_side, session_id)
    trend = []
    if points:
        e_vals = [p[0] for p in points]
        v_vals = [p[1] for p in points]
        trend = [
            "[추세] 최근 %d세션" % len(points),
            " e1RM %s %dkg" % (sparkline(e_vals), round(e_vals[-1])),
            " VOL  %s %dkg" % (sparkline(v_vals), round(v_vals[-1])),
        ]

    # --- grid ---
    # RC1: route planned target weight + target RIR through rx-calc, never the
    # stale program.yaml slot snapshot.
    #  * target RIR is a DAY-LOCAL derivation (rep_range + intensity scale) --
    #    resolve it from the ALREADY-RESOLVED slot (correct rotation day, E23
    #    guarded) so it is right even when the rendered session is not today's
    #    rotation day (e.g. reviewing a past 앞B session). None -> blank.
    #  * target WEIGHT is today's progression, so it comes from today's rx-calc
    #    prescription (the E22 stale-weight fix). The prescription is now
    #    requested FOR day_code -- the split this session is actually training --
    #    so a 보충 session gets its own day's weights.
    #    (2026-08-23, corrected) This comment used to claim that a rx_weight miss
    #    on a "different-day session" was harmless because "a non-today session's
    #    planned sets are already all completed (nothing to plan)". That read
    #    "not the rotation queue's day" as "a PAST session being reviewed". A
    #    MAKEUP session is neither: it is LIVE and nothing is completed, so the
    #    blank propagated all the way to a weight-free armed argv, a refused
    #    set-add write and 세트볼륨 0. A miss here is now a genuine miss (slot
    #    substituted / off-program / rx unavailable), and blank is the honest
    #    render for it -- as it also is for a slot whose program weight_kg is
    #    legitimately null (bodyweight / calibration, e.g. 앞A/cable_lateral_raise).
    # rx_weight + rx_sets were already resolved once above (header uses the same
    # trimmed count). rx_target_rir is a day-local derivation off the resolved
    # slot (correct rotation day, E23 guarded) -- computed here.
    rx_target_rir = rx.resolve_target_rir(slot)
    # G12 + F6-ext (#9, 2026-08-19): compute the planned warmup+ramp ladder.
    # Barbell (compound+freeweight) -> empty bar + per-side plate rungs; machine/
    # stack (v_squat etc.) -> a light ladder stepping up to the working weight in
    # the machine's own load unit (the machine-omission fix -- machines used to
    # render working sets only, no warmup rows). Uses rx_weight (today's target)
    # as the working weight. Best-effort: any error / non-qualifying -> [].
    # A3/D3: the ramp decision, as a VALUE. `rows` feeds the grid exactly as
    # before; `decision`/`reason` go out on the signal channel so "no ramp" is
    # an auditable assertion and never a silent absence.
    rdec = ramp_decision(db_path, exercise_name, rx_weight, slot=slot,
                         e1rm=ramp_e1rm_for(db_path, exercise_name, slot,
                                            session_id))
    p_ramp = rdec["rows"]
    # A3/D1: the slot's prep drills are rows in this table like any other set.
    p_prep = planned_prep_rows(
        slot_prep_drills(rx, program_path, day_code, slot.get("slot"),
                         db_path=db_path, session_id=session_id))
    done_prep = fetch_prep_sets(db_path, session_id, exercise_name)
    if signals is not None:
        # 2026-08-26: where the DAY came from, on EVERY render -- same
        # discipline as RAMP_DECISION. This table's weights, its RIR column and
        # the card title all hang off day_code, and until now day_code arrived
        # with no provenance: a day READ from the session row and a day GUESSED
        # off the rotation queue looked identical downstream. The makeup defect
        # lived in exactly that gap. source=session_type means the row said so;
        # anything else means the calendar/program order did.
        signals.append(
            "DAY_SOURCE exercise=%s day=%s source=%s session_code=%s"
            % (exercise_name, day_code, day_trace.get("source"),
               day_trace.get("session_code")))
        if not day_trace.get("session_code"):
            # LOUD, not blank (the whole point): workouts.session_type_id is
            # NULL, so the session row cannot say what this session is and every
            # split-shaped thing on screen -- the title, the prescription, the
            # trend filter -- is an inference. session-open birth-tags the row,
            # so an untagged LIVE session means the tag was lost, not deferred.
            signals.append(
                "SESSION_UNTAGGED session=%s day=%s source=%s -- the session "
                "row carries no session_type_id; the split shown was INFERRED, "
                "not read. Say so, or fix the tag -- do not present it as read"
                % (session_id, day_code, day_trace.get("source")))
        signals.append(
            "RAMP_DECISION exercise=%s decision=%s reason=%s rungs=%d "
            "target_weight=%s"
            % (exercise_name, rdec["decision"], rdec["reason"],
               len(p_ramp), "none" if rx_weight is None else rx_weight))
        # 2026-09-30: which prescription basis produced today's load, so an
        # e1RM-derived number is auditable, never mistaken for a progression.
        _rb = (rx_slot or {}).get("rx_basis") or {}
        if _rb:
            signals.append(
                "RX_BASIS exercise=%s basis=%s sessions=%s e1rm=%s "
                "target_reps=%s ramp_basis=%s measure=%s anchor=%s "
                "censored=%s excluded=%s"
                % (exercise_name, _rb.get("basis"), _rb.get("sessions"),
                   _rb.get("e1rm", "none"),
                   (rx_slot or {}).get("target_reps"),
                   rdec.get("basis", "load"),
                   "true" if _rb.get("measure") else "false",
                   ((_rb.get("anchor") or {}).get("date") or "none"),
                   _rb.get("censored", 0),
                   ",".join("%s:%s" % (x.get("date"), x.get("reason"))
                            for x in (_rb.get("excluded") or [])) or "none"))
        if p_prep:
            signals.append(
                "PREP_PLANNED exercise=%s drills=%d logged=%d unprescribed=%d"
                % (exercise_name, len(p_prep), len(done_prep),
                   sum(1 for d in p_prep if not d["prescribed"])))
            # 2026-09-01/D3: WHICH lift hosts this session's session-level mat
            # prep, and on what basis. Until today the answer was the literal
            # constant 1 and a session that did not start on slot 1 lost its mat
            # prep with no line saying so. An assumption that decides whether
            # five drills are shown or dropped is an assumption that has to be
            # auditable, not inferred from their absence.
            _host, _basis = mat_prep_host(entering_slot=slot.get("slot"),
                                          db_path=db_path,
                                          session_id=session_id)
            signals.append(
                "MAT_PREP_HOST session=%s slot=%s basis=%s -- session-level "
                "prep (no live_slot) is performed in front of THIS lift"
                % (session_id, _host, _basis))
        # D5: a `?` in the WT column is reported, not narrated around. Fires
        # when a WORKING row (logged or planned) has no resolvable weight.
        _wt_unknown = ([s["set_seq"] for s in work if s["weight_kg"] is None]
                       + ([n for n in range(len(work) + 1, (total_sets or 0) + 1)]
                          if rx_weight is None else []))
        if _wt_unknown:
            signals.append(
                "WT_UNKNOWN exercise=%s rows=%s -- the WT cell renders '%s'; "
                "resolve the weight, do NOT explain the cell in prose"
                % (exercise_name,
                   ",".join(str(n) for n in _wt_unknown), UNKNOWN_CELL))
    # 표2's fixed columns are owner-locked even when the coaching prompt gate
    # suppresses an RIR question for a beginner.
    show_rir = True
    grid = ["[세트]"] + build_grid(slot, ramps, work,
                                   rx_weight=rx_weight,
                                   rx_target_rir=rx_target_rir,
                                   rx_sets=rx_sets,
                                   rx_target_reps=(rx_slot or {}).get(
                                       "target_reps"),
                                   override=override,
                                   planned_ramp=p_ramp,
                                   # Does a NULL-weight set_seq==0 row on THIS
                                   # exercise mean "empty 20kg bar" or literally
                                   # "bodyweight"? Resolved via the shared
                                   # "which lifts actually have a bar" gate --
                                   # the SAME one set-arm's plate cue uses, so
                                   # the two surfaces can never disagree about
                                   # whether a 20kg bar is in the user's hands.
                                   # See build_grid.wt_cell.
                                   bar_primer=_is_bar_primer_exercise(
                                       db_path, exercise_name, slot),
                                   # Label revert 2026-08-24: resolved HERE,
                                   # once, at the render entry point -- never
                                   # inside the row loop, and never as a
                                   # literal in the builder.
                                   rir_header=_rir_header(db_path),
                                   show_rir=show_rir,
                                   # Prep is separately cued; the grid omits it.
                                   planned_prep=p_prep,
                                   preps=done_prep,
                                   # A2: an exercise the owner already walked
                                   # away from has no pending sets -- its
                                   # unlogged rows read 미실시, not 예정.
                                   exercise_closed=exercise_is_closed(
                                       session_id, exercise_name))

    # #39-B (owner 2026-08-21): the static "[원판] 양쪽당 껴야 하는 무게" BLOCK that
    # used to render here is REMOVED. Owner ruling: plates are explained set by
    # set, not dumped into the set table up front. Listing every rung at once forced
    # them to scan and re-find the right line, and by the time they steps up to the
    # bar they are no longer looking at the table. The plate math is now delivered
    # per-set at CUE time -- one line, for the ONE weight being cued -- by
    # set-arm's deterministic set-start push (set-arm plate_cue_line). The math
    # itself did not move to set-arm: both consumers read the shared SoT
    # ax_engine.plate_breakdown (see _plate_breakdown above).

    # --- footer (prev / next by program slot order) ---
    footer = []
    if exercises and slot_idx:
        if slot_idx > 1:
            footer.append("◂ %s" % (exercises[slot_idx - 2].get("display")
                                    or exercises[slot_idx - 2].get("name")))
        if slot_idx < len(exercises):
            footer.append("▸ %s" % (exercises[slot_idx].get("display")
                                    or exercises[slot_idx].get("name")))

    body = list(header)
    if trend:
        body += [""] + trend
    body += [""] + grid
    _mcue = measure_cue_line((rx_slot or {}).get("rx_basis"), work)
    if _mcue:
        body += [_mcue]
    body += ["누적 %skg · %d/%d세트" % (_fmt_vol(done_vol), done_cnt, total_sets)]
    if rest_sec:
        minutes, seconds = divmod(int(rest_sec), 60)
        body += ["휴식: %d분%s" % (minutes, " %d초" % seconds if seconds else "")]
    if footer:
        body += [""] + footer

    out = "```\n" + "\n".join(body) + "\n```"
    return out, None


