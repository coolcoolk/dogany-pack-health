_AX_WARNED = [False]


def _announce_ax_engine_missing(exc):
    """ONE stderr line, ONCE per process, when the engine will not load.

    Identical to set-add's and set-arm's (audit 2026-09-12 2.1 -- one shape, not
    three). Here the load failure ALSO propagates, because render() has no
    best-effort fallback for a missing ramp SoT and a table that silently drops
    its ramp rungs is the same defect one level up. The line exists so the three
    callers name the structural absence the same way in the same log."""
    if _AX_WARNED[0]:
        return
    _AX_WARNED[0] = True
    probed = ", ".join(os.path.abspath(os.path.join(HERE, *p))
                       for p in _AX_ENGINE_CANDIDATES)
    sys.stderr.write(
        "[set-table] AX-ENGINE-MISSING: ax_engine.py did not load (%s). The "
        "ramp SoT is unreachable -- render cannot taper or stamp RIR. "
        "probed: %s\n" % (exc, probed))


def load_ax_engine():
    """Import the pack engine ax_engine.py as a module. Same importlib pattern
    as load_rx_calc(); ax_engine does no module-level work (its kit_life/DB
    access is all lazy), so import has no side effects. The file is located via
    ax_engine_path() -- see the seam note above for why there are two."""
    path = ax_engine_path()
    try:
        spec = importlib.util.spec_from_file_location("ax_engine", path)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
    except Exception as exc:      # noqa: BLE001 -- announce, then re-raise
        _announce_ax_engine_missing(exc)
        raise
    return mod


def ax_engine():
