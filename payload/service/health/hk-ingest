class Lock(object):
    def __init__(self, wait_s=180):
        self.wait_s = wait_s
        self.fh = None

    def __enter__(self):
        d = state_dir()
        os.makedirs(d, exist_ok=True)
        self.fh = open(os.path.join(d, ".hk-ingest.lock"), "w")
        deadline = time.time() + self.wait_s
        while True:
            try:
                fcntl.flock(self.fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except OSError:
                if time.time() > deadline:
                    raise RuntimeError("another hk-ingest run holds the lock")
                time.sleep(1)

    def __exit__(self, *exc):
        try:
            fcntl.flock(self.fh, fcntl.LOCK_UN)
        finally:
            self.fh.close()


def _opts(argv):
    o = {"now": None, "dry": False}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--dry-run":
            o["dry"] = True
        elif a == "--now" and i + 1 < len(argv):
            o["now"] = parse_ts(argv[i + 1])
            i += 1
        else:
            raise SystemExit("hk-ingest: unknown argument %s" % a)
        i += 1
    o["now"] = o["now"] or _dt.datetime.now(_dt.timezone.utc)
    return o


def _prepare(o):
    kit = Kit(dry=o["dry"])
    floors = kit.floors()
    kit.load_ledger()
    return kit, floors


def cmd_pass(argv):
    o = _opts(argv)
    c = conf()
    with Lock():
        try:
            kit, floors = _prepare(o)
        except RuntimeError as exc:
            print("HK-INGEST BLOCKED %s" % exc)
            return EXIT_BLOCKED
        amap = load_map()
        try:
            n = max(1, int(c.get("HK_INGEST_WINDOW_DAYS", "3")))
        except ValueError:
            n = 3
        print("HK-INGEST pass now=%s approved=%s" %
              (utc_z(o["now"]), ",".join(sorted(floors)) or "-"))
        if not floors:
            return EXIT_OK
        reg = kit.register_tokens()
        if reg != "ok":
            print("NOTE metric-register %s" % reg)
        try:
            client = TM.Client(c.get("HK_TRANSPORTER_MCP") or None)
            client.open()
        except TM.TransporterError as exc:
            print("HK-INGEST BLOCKED transporter unreachable: %s" % exc)
            return EXIT_BLOCKED
        try:
            if c.get("HK_INGEST_REFRESH", "off") == "on":
                try:
                    r = client.refresh_events(wait_s=int(
                        c.get("HK_INGEST_REFRESH_WAIT_S", "20")))
                    print("REFRESH %s" % r.get("result"))
                except (TM.TransporterError, ValueError) as exc:
                    print("REFRESH failed: %s" % exc)
            counts = {}
            if "workout" in floors:
                floor = floors["workout"]
                days, _ = window_days(o["now"], floor, n)
                since = utc_z(max(floor, local_midnight(days[0])) -
                              _dt.timedelta(days=1)) if days else utc_z(floor)
                for ev in sorted(client.list_events(source=SOURCE,
                                                    kind="workout", since=since,
                                                    limit=500),
                                 key=lambda e: e.get("occurred_at") or ""):
                    act, wid = ingest_workout(kit, ev, amap, floor)
                    counts[act] = counts.get(act, 0) + 1
                    if act not in ("same", "skip-pre-consent"):
                        print("WORKOUT %s %s workouts/%s" %
                              (ev.get("id"), act, wid))
            metrics = []
            for kind in KINDS[1:]:
                if kind not in floors:
                    continue
                floor = floors[kind]
                days, today = window_days(o["now"], floor, n)
                if not days:
                    continue
                day_since = utc_z(local_midnight(days[0]) -
                                  _dt.timedelta(days=1))
                if kind == "steps":
                    metrics += ingest_bucket_metric(
                        kit, client, kind, "steps", [d for d in days if d < today],
                        steps_value, day_since, floor)
                elif kind == "heart_rate":
                    metrics += ingest_bucket_metric(
                        kit, client, kind, "hr_avg_bpm",
                        [d for d in days if d < today], hr_value, day_since,
                        floor)
                elif kind == "resting_heart_rate":
                    metrics += ingest_resting(kit, client, days, day_since, floor)
                elif kind == "sleep":
                    metrics += ingest_sleep(kit, client, days, day_since, floor)
                elif kind == "active_energy_day":
                    metrics += ingest_active_energy(kit, client, days, floor)
            for m, d, v, verdict in metrics:
                print("METRIC %s %s %s %s" % (m, d, fmt(v), verdict))
            print("HK-INGEST done workouts=%s metrics=%d"
                  % (",".join("%s:%d" % kv for kv in sorted(counts.items()))
                     or "0", len(metrics)))
        finally:
            client.close()
    return EXIT_OK


def cmd_callback(argv):
    o = _opts(argv)
    try:
        msg = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        msg = {}
    # filter at entry: the receiver calls back for every kind and source.
    if msg.get("source") != SOURCE or msg.get("kind") != "workout" \
            or not msg.get("id"):
        return EXIT_OK
    c = conf()
    with Lock():
        try:
            kit, floors = _prepare(o)
        except RuntimeError as exc:
            print("HK-INGEST BLOCKED %s" % exc)
            return EXIT_BLOCKED
        if "workout" not in floors:
            return EXIT_OK
        try:
            with TM.Client(c.get("HK_TRANSPORTER_MCP") or None) as client:
                ev = client.get_event(SOURCE, "workout", str(msg["id"]))
        except TM.TransporterError as exc:
            print("HK-INGEST BLOCKED transporter unreachable: %s" % exc)
            return EXIT_BLOCKED
        if not ev:
            print("HK-INGEST callback id=%s not found" % msg["id"])
            return EXIT_OK
        act, wid = ingest_workout(kit, ev, load_map(), floors["workout"])
        print("WORKOUT %s %s workouts/%s" % (msg["id"], act, wid))
    return EXIT_OK


def cmd_status(_argv):
    kit = Kit()
    for kind, floor in sorted(kit.floors().items()):
        print("%s floor=%s" % (kind, floor.isoformat()))
    return EXIT_OK


def cmd_consent(argv, revoke=False):
    if not argv or any(kind not in KINDS for kind in argv):
        raise RuntimeError("expected one or more kinds: %s" % ", ".join(KINDS))
    kit = Kit()
    for kind in dict.fromkeys(argv):
        args = ["ingest-consent", SOURCE, kind]
        if revoke:
            args.append("--off")
        args += ["--module", "health"]
        rc, out, err = kit.run(args)
        if rc:
            raise RuntimeError("ingest-consent %s failed (%s): %s" %
                               (kind, rc, (err or out).strip()[:200]))
        print(out.strip())
    return EXIT_OK


def main(argv=None):
    argv = sys.argv[1:] if argv is None else list(argv)
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return EXIT_OK if argv else EXIT_ERR
    cmd, rest = argv[0], argv[1:]
    fn = {"pass": cmd_pass, "callback": cmd_callback,
          "status": cmd_status, "consent": cmd_consent,
          "revoke": lambda args: cmd_consent(args, True)}.get(cmd)
    if fn is None:
        print("hk-ingest: unknown command %s" % cmd, file=sys.stderr)
        return EXIT_ERR
    try:
        return fn(rest)
    except RuntimeError as exc:
        print("HK-INGEST ERROR %s" % exc)
        return EXIT_ERR


if __name__ == "__main__":
    sys.exit(main())
