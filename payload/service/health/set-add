def _read_closed_tombstone():
    """Return the closed session id held in the .session-closed tombstone, or
    None. Best-effort: any error -> None (never blocks a set write)."""
    try:
        with open(CLOSED_TOMBSTONE) as fh:
            txt = fh.read().strip()
        return int(txt) if txt else None
    except (OSError, ValueError):
        return None


def _exercise_entered(session_id, exercise_name):
    """Defect B: True iff exercise-enter actually RAN its entry for this
    (session, exercise) -- i.e. the entry payload (incl. the (2) table) was
    delivered this session. Mirrors exercise-enter's .exercise-entered marker
    path + safe-token convention exactly (exercise-enter is the sole writer).
    Best-effort: any error -> True (fail SILENT -- never fire a spurious recovery
    that would double-publish; the model-facing SET_TABLE_MISSING fallback below
    still guards a genuinely missing table via the published-flag check)."""
    try:
        safe = re.sub(r"[^A-Za-z0-9_.-]", "_", str(exercise_name or ""))
        path = os.path.join(ENTERED_DIR, "%s.%s" % (session_id, safe))
        return os.path.exists(path)
    except Exception:  # noqa: BLE001 -- gate must never break the write
        return True


def _mark_active(session_id):
    # F1 revival guard: if this session is the one the tombstone marks as closed,
    # do NOT (re)write .active-session -- the gate marker stays down. The set row
    # is still logged by the caller; only the session gate is withheld so a
    # closed session cannot be re-opened by a stray self-heal.
    try:
        closed_sid = _read_closed_tombstone()
        if closed_sid is not None and int(session_id) == closed_sid:
            return
    except (TypeError, ValueError):
        pass
    try:
        with open(ACTIVE_MARKER, "w") as fh:
            fh.write("%d" % int(session_id))
    except OSError:
        pass


def _table_published(session_id, exercise_name):
    """True if set-table already rendered (published) the (2) progress table for
    this (session, exercise). Mirrors set-table's flag path convention exactly.
    Best-effort: any error -> True (fail SILENT, never emit a false gate warning
    that would nag on every set)."""
    try:
        safe = re.sub(r"[^A-Za-z0-9_.-]", "_", str(exercise_name or ""))
        path = os.path.join(PUBLISHED_DIR, "%s.%s" % (session_id, safe))
        return os.path.exists(path)
    except Exception:  # noqa: BLE001 -- gate must never break the write
        return True


def _arm(db_path, session_id, exercise_name, set_seq, arm_opts):
    """Fire the deterministic rest-timer stack via set-arm (C12). BEST-EFFORT:
    called AFTER the DB write is committed, wrapped so any failure here can
    never lose the logged set -- worst case the timer is missing (degraded),
    never the data. Runs before SET_LOGGED is printed so the timer is armed
    the instant the set lands (arm-first, zero chat gap)."""
    try:
        cmd = [SET_ARM, str(session_id), exercise_name, str(set_seq),
               "--db", db_path]
        if arm_opts.get("next_spec") is not None:
            cmd += ["--next", arm_opts["next_spec"]]
        if arm_opts.get("tip") is not None:
            cmd += ["--tip", arm_opts["tip"]]
        if arm_opts.get("tip60") is not None:
            cmd += ["--tip60", arm_opts["tip60"]]
        if arm_opts.get("no_next"):
            cmd += ["--no-next"]
        # F19/F21: pass the owner's mid-session target override through to set-arm
        # so the re-fired push + set-table reflect the substitution / weight
        # adjust (set-arm persists it per (session, exercise); set-table reads it
        # back). Any subset is valid: F21 weight-adjust passes ov_weight alone.
        if arm_opts.get("ov_display") is not None:
            cmd += ["--ov-display", arm_opts["ov_display"]]
        if arm_opts.get("ov_weight") is not None:
            cmd += ["--ov-weight", str(arm_opts["ov_weight"])]
        if arm_opts.get("ov_reps") is not None:
            cmd += ["--ov-reps", str(arm_opts["ov_reps"])]
        if arm_opts.get("ov_rir") is not None:
            cmd += ["--ov-rir", str(arm_opts["ov_rir"])]
        if arm_opts.get("ov_clear"):
            cmd += ["--ov-clear"]
        # P2 (2026-08-24): a weight change is a PROGRESSION DECISION. Carry the
        # reason and the author through to the gate -- set-arm decides on the
        # lower side when the reason is missing, so dropping it here would turn
        # a justified raise into a silent clamp.
        if arm_opts.get("ov_reason") is not None:
            cmd += ["--ov-reason", str(arm_opts["ov_reason"])]
        if arm_opts.get("ov_by") is not None:
            cmd += ["--ov-by", str(arm_opts["ov_by"])]
        if arm_opts.get("arm_dry_run"):
            cmd += ["--dry-run"]
        proc = _run_step(cmd, SET_ARM_WAIT_SEC)
        # Surface the arm summary on stderr (audit only, never touches the
        # SET_LOGGED stdout contract the forcing hook keys on).
        if proc.stdout:
            print(proc.stdout.rstrip(), file=sys.stderr)
        if proc.stderr:
            print(proc.stderr.rstrip(), file=sys.stderr)
        # F11 Delta 2: parse set-arm's machine line `NEXT_HINT\t<spec>` (or
        # `NEXT_HINT\tNONE` at session end) from its STDOUT so do_add can
        # re-print it on set-add's OWN stdout AFTER SET_LOGGED (lets the model
        # pre-attach "다음: <spec>" verbatim at arming time without composing it).
        # F19/F33 + 41-5: also parse `HOLD_NEXT_REQUIRED\t<label>` -- present only
        # for a hold-class set -- so do_add can surface the FORCE-A-BUTTON order.
        # The value is the position-correct button label (다음 세트/다음(진행)/완료).
        # Returns a dict; best-effort, any parse miss -> None values, never
        # affects the logged set.
        # #23: also parse `REST_ARMED\t<sec>\thold=<0|1>` (or `REST_ARMED\tNONE`
        # on a transition) so do_add can surface that a between-set rest was
        # armed -- the forcing signal that a HOLD/iso continuation rest is NOT
        # skipped before the next hold press-start.
        # H11: also parse `SET_CUE\t...` -- the deterministic block-2 (큐)
        # carrier. Kept as the RAW payload here (`<text>` / `NONE\t<reason>` /
        # `MISSING\t<reason>`); do_add below decides how each state renders.
        # P2: also parse `LOAD_DECISION_SAY\t<sentence>` -- set-arm's stdout is
        # relayed to STDERR here (audit), where the model has no obligation to
        # read it. The whole point of authoring the sentence in code is that it
        # reaches the owner, so it is re-surfaced on set-add's OWN stdout.
        signals = {"next_hint": None, "hold_next": None, "table_complete": None,
                   "rest_armed": None, "idrill_marker": None, "set_cue": None,
                   "load_say": None, "load_decision": None, "prep_tap": [],
                   "kb_delivered": None}
        signals["rung_lines"] = []
        for line in (proc.stdout or "").splitlines():
            if line.startswith(("RUNG_SET_CMD", "RUNG_REST\t",
                                "EXERCISE_INCOMPLETE ")):
                # hotfix 0.34.x: the next warm-up row's literal record argv,
                # its plate-change pause and the not-complete verdict ride
                # set-add's OWN stdout (set-arm's is relayed to stderr).
                signals["rung_lines"].append(line.rstrip())
            elif line.startswith("PREP_TAP"):
                # 2026-08-27: the NEXT prep drill's completion tap -- its
                # prescribed value, its unit, and the literal argv that logs it
                # (set-arm emit_prep_tap_lines). Re-surfaced for the same reason
                # the IDRILL marker is: set-arm's stdout is relayed to STDERR
                # here, where the model has no obligation to look, and while the
                # prep band is incomplete this is the ONLY affordance the turn
                # has. Losing it means the owner types "다음" again.
                signals["prep_tap"].append(line.rstrip())
            elif line.startswith("LOAD_DECISION_SAY\t"):
                _say = line.split("\t", 1)[1]
                signals["load_say"] = None if _say == "NONE" else _say
            elif line.startswith("LOAD_DECISION\t"):
                signals["load_decision"] = line.split("\t", 1)[1]
            elif line.startswith("NEXT_SET_LINE\t"):
                signals.setdefault("next_set_lines", []).append(
                    line.split("\t", 1)[1])
            elif line.startswith("NEXT_HINT\t"):
                signals["next_hint"] = line.split("\t", 1)[1]
            elif line.startswith("SET_CUE\t"):
                signals["set_cue"] = line.split("\t", 1)[1]
            elif line.startswith("HOLD_NEXT_REQUIRED\t"):
                signals["hold_next"] = line.split("\t", 1)[1]
            elif line.startswith("SET_TABLE_COMPLETE\t"):
                # F16: exercise finished -> render the completion set-table.
                signals["table_complete"] = line.split("\t", 1)[1]
            elif line.startswith("REST_ARMED\t"):
                signals["rest_armed"] = line.split("\t", 1)[1]
            elif line.startswith("KEYBOARD_RAIL\t"):
                # CODE-POSTED KEYBOARDS (2026-10-08): set-arm says every set
                # keyboard on this install is posted by code (row_keyboard).
                signals["kb_rail"] = line.split("\t", 1)[1].strip()
            elif line.startswith("KEYBOARD_DELIVERED\t"):
                # ONE ARM ONE KEYBOARD (2026-09-11): set-arm scheduled (or
                # found already-on-screen) the keyboard as its own code push
                # and therefore emitted NO marker. Re-surfaced below as the
                # positive "buttons are handled" line so the model neither
                # echoes a marker nor authors an [[OPTIONS]] substitute --
                # either would put a second set of buttons on the screen.
                signals["kb_delivered"] = line.split("\t", 1)[1]
            elif line.startswith("[[IDRILL:") and line.rstrip().endswith("]]"):
                # DGN-918/939 in-place reps/RIR keyboard: set-arm emits the
                # `[[IDRILL:<arm_id>]]` OUTPUT marker to ITS stdout (flag-gated).
                # set-arm's stdout is otherwise relayed to stderr (audit), where
                # the bridge -- which only renders the marker from the MODEL turn
                # body (contract v3.1 §2) -- never sees it. Capture the marker
                # here and re-surface it as a clean IDRILL_MARKER: line on
                # set-add's OWN stdout so the model echoes it verbatim onto the
                # set-done/completion reply (contract §6 completion-push attach).
                signals["idrill_marker"] = line.rstrip()
        return signals
    except Exception as e:  # noqa: BLE001 -- arming must never break the write
        print("WARN: set-arm failed (%s) -- set logged, timer NOT armed" % e,
              file=sys.stderr)
    return {"next_hint": None, "hold_next": None, "table_complete": None,
            "rest_armed": None, "idrill_marker": None, "set_cue": None,
            "kb_delivered": None}


# D4 (2026-08-24 preflight): the cue-failure REASON has two audiences and they
# do not read the same alphabet.
#
# What leaked, off a dry-run walk:
#   SET_CUE_MISSING: 큐를 만들지 못했습니다 (사유: generic_placeholder_only) -- ...
# `generic_placeholder_only` is an internal state key. It sat INSIDE the Korean
# sentence the SKILL tells the model to relay verbatim, which is the exact leak
# named on 2026-08-20 as recurring English leakage, and which the SKILL's
# own "내부 영어 토큰 누수 금지" rule forbids.
#
# The fix is NOT to drop the reason -- a cue failure whose cause is unreportable
# is worse than one that reads badly. It is to render the SAME source twice:
#   * the MACHINE line `SET_CUE_MISSING_REASON reason=<code>` keeps the raw code
#     (grep-able, stable, never spoken -- it is on the SKILL suppression list),
#   * the OWNER line carries the Korean rendering of that same code.
# One registry below is the single source for both, so a new code cannot appear
# in one rendering and be missing from the other without the drift test firing.
#
# Keys MUST stay in lockstep with every reason set-arm's set_cue_line() can
# return (CUE_STATE_MISSING / CUE_STATE_NONE payloads). tests/test-token-leak-
# d4-d6.py scans set-arm's source for those literals and fails if any is absent
# here -- that scan is what keeps "one source" true across the two scripts,
# which cannot import each other (they are extensionless CLI entrypoints).
CUE_MISSING_REASONS = {
    # set-arm resolved no next-step spec at all (no rung, no derived
    # continuation/transition spec, no --next from the model).
    "no_spec_derived": "다음 세트 정보를 만들지 못했습니다",
    # the only thing left was GENERIC_NEXT_SPEC ("다음 세트 준비") -- a
    # placeholder naming no weight, no reps, no RIR. Not a cue.
    "generic_placeholder_only": "무게·횟수를 확정하지 못했습니다",
    # NONE-state payload. Never rendered to the owner (block 2 drops out of the
    # order entirely), registered so the drift scan stays exhaustive.
    "session_end": "세션이 끝나 큐가 필요 없습니다",
    # set-arm emitted MISSING with no reason field at all (an OLD set-arm, or a
    # truncated line). The signal still has to say something true.
    "unknown": "사유를 확인하지 못했습니다",
}

# Korean stand-in for a code that reaches here without a registry entry. The raw
# code is NOT interpolated into this string -- that is the whole defect. It
# survives on the machine line instead, so the diagnostic is never lost.
CUE_MISSING_REASON_FALLBACK_KO = "알 수 없는 사유"


def cue_missing_reason_ko(code):
    """Owner-facing Korean rendering of a cue-failure reason code.

    Never returns the code itself, not even on a miss: an unregistered code is
    still an internal token, and interpolating it "just this once" is how the
    leak got in. The machine line carries the code for whoever is debugging."""
    return CUE_MISSING_REASONS.get(str(code or "").strip(),
                                   CUE_MISSING_REASON_FALLBACK_KO)


def render_set_cue(raw):
    """H11: turn set-arm's `SET_CUE` payload into the stdout lines set-add
    prints for block 2 (큐) of the 표->큐->타이머 order.

    `raw` is the tab-payload verbatim: `<text>` | `NONE\t<reason>` |
    `MISSING\t<reason>` | None (no signal at all -- an OLD set-arm, or an arm
    that never ran). Returns a list of stdout lines; the audit label rides
    stderr so it can never leak into the owner-facing reply.

    Three states, three DIFFERENT renderings -- collapsing any two of them is
    how the defect happened in the first place:
      real cue -> the cue text, for the model to echo verbatim.
      NONE     -> [] . No cue belongs in this slot, so block 2 leaves the
                  order entirely rather than occupying it with nothing.
      MISSING  -> TWO lines (D4). A machine line carrying the raw reason code,
                  then the LOUD owner line carrying the SAME reason in Korean.
                  Cue production failed; the owner sees that it failed and why,
                  in their own language, and the code stays greppable next to it.
      None     -> [] . Nothing was claimed, so nothing is asserted. A missing
                  SIGNAL is not the same as a failed CUE, and inventing a
                  loud line here would cry wolf on every arm-suppressed path.
    """
    if not raw:
        return []
    if raw.startswith("NONE"):
        return []
    if raw.startswith("MISSING"):
        reason = raw.split("\t", 1)[1] if "\t" in raw else "unknown"
        print("SET_CUE_MISSING (%s) -- block 2 (큐) could NOT be produced; "
              "say so in the reply, do not leave the slot blank" % reason,
              file=sys.stderr)
        # D4: two audiences, two renderings, ONE source (CUE_MISSING_REASONS).
        # Line 1 is the machine field -- the raw code, suppressed by the SKILL
        # machine-marker rule, never spoken. Line 2 is the owner's sentence and
        # holds no ASCII state key. Same discipline as the WEIGHT_MISSING /
        # WEIGHT_ASK and SET_SEQ_OCCUPIED / SEQ_ASK pairs above.
        return ["SET_CUE_MISSING_REASON reason=%s" % reason,
                "SET_CUE_MISSING: 큐를 만들지 못했습니다 (사유: %s) -- "
                "다음 세트 지시를 직접 확인해주세요" % cue_missing_reason_ko(reason)]
    print("SET_CUE (echo the line below verbatim as block 2 -- 표 -> 큐 -> "
          "타이머):", file=sys.stderr)
    return ["SET_CUE: %s" % raw]


def next_action_block(labels):
    """H17: render the next-action affordance from the COUNT of candidates.

    Owner ruling, live: a single next step should just be taken, not offered as
    a tap-to-proceed prompt -- after "체스트 프레스 3세트 다 끝났어요" the user was
    handed "선택: 1. 다음(진행)". One candidate is not a choice.

    The old emitter printed `1. <label>` + `[[OPTIONS]]` unconditionally, so
    the count was never consulted. Two things went wrong at once:
      * a menu was rendered where no decision existed (the friction), and
      * a ONE-item numbered list is exactly what bridge/options.py declines to
        promote to a button (has_numbered_list >= 2), so it degraded to the
        literal text they read.

    `labels` is the candidate list. Returns {"kind", "stdout"}:
      0 candidates -> "missing". A DISTINCT bug, not a quiet version of 1: we
                      were asked to present a forward action and have none to
                      present. Loud, and it does NOT auto-advance -- advancing
                      to an unnamed step is how a session walks off a cliff.
                      REACHABLE since 2026-08-24 (D2). Until then this branch
                      existed but nothing in production could enter it: the one
                      call site passed `[hold_next]` from inside `if hold_next:`,
                      so the list was always exactly 1, and the real
                      no-forward-action situation skipped the block entirely and
                      said nothing. See the call site for what now triggers it.
      1 candidate  -> "auto". ACT. The action is NAMED (so 41-5's "never
                      strand the owner after a hold push" still holds) but no
                      menu and no [[OPTIONS]] marker is emitted.
      >= 2         -> "menu". A real choice: the numbered list plus the marker,
                      which is the shape options.py actually renders as
                      buttons.
    """
    labels = [l for l in (labels or []) if l and str(l).strip()]
    if not labels:
        print("NEXT_ACTION_MISSING -- a forward action was required but no "
              "candidate was resolved; NOT auto-advancing", file=sys.stderr)
        # 다음 동작 후보가 없음 -- distinct from "exactly one", by design.
        return {"kind": "missing",
                "stdout": ["NEXT_ACTION_MISSING: 다음 동작을 결정하지 "
                           "못했습니다 -- 진행 전에 확인이 필요합니다"]}
    if len(labels) == 1:
        print("AUTO_ADVANCE (%s): exactly ONE candidate -- perform it now, do "
              "NOT render a menu and do NOT ask for a tap" % labels[0],
              file=sys.stderr)
        return {"kind": "auto",
                "stdout": ["AUTO_ADVANCE: %s" % labels[0]]}
    print("NEXT_ACTION_BLOCK (echo the lines below verbatim to render the "
          "buttons):", file=sys.stderr)
    out = ["%d. %s" % (i, l) for i, l in enumerate(labels, 1)]
    out.append("[[OPTIONS]]")
    return {"kind": "menu", "stdout": out}


