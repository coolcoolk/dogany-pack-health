# A3/D1: the prep band's floor, mirrored from set-table.PREP_SEQ_BASE (the SoT
# for the sign convention). It is a bare int rather than an import because this
# module is loaded on the write path of every set and must stay import-light --
# the same reason session-cursor mirrors set-arm's hold predicate in three
# lines. tests/test-a3-set-kind.py asserts the two constants are equal, so a
# change to the SoT cannot drift past this copy silently.
PREP_SEQ_BASE = -100

# RELAY DEPENDENCE (review of a live session, 2026-10-08): the agent
# piped this tool's stdout through grep/head all session, so every owner line
# that only existed as a stdout line for the reply to relay -- the record
# line, the load decision / next-load sentence, the next-set blockquote --
# reached the owner only when the filter happened to keep it. On a TAP (no
# model turn at all) they never reached the owner. On the code rail they are
# now ONE code-posted message per logged set; stdout carries a receipt.
OWNER_LINES_CHANNEL = "owner-lines"


def _post_owner_lines(session_id, exercise_name, set_seq, lines):
    """Post the owed owner lines for this set as ONE message, by code.
    Returns "sent" / "already" (an identical message for this row is already
    on screen -- a re-fire) / None (nothing to post, or the send failed: the
    stdout lines stay the carrier). Never raises."""
    body = "\n".join(str(ln) for ln in lines if ln and str(ln).strip())
    if not body.strip():
        return None
    try:
        st = _set_table_mod()
        if st is None:
            return None
        sa = st._step_affordance()
        safe = "".join(ch if (ch.isalnum() or ch in "._-") else "_"
                       for ch in str(exercise_name or ""))
        key = "own.%s.%s.%s" % (safe, set_seq, st.table_signature(body))
        claimed = True
        if sa is not None:
            try:
                claimed = sa.claim_delivery(session_id, key,
                                            channel=OWNER_LINES_CHANNEL)
            except Exception:  # noqa: BLE001 -- a ledger miss never costs it
                claimed = True
        if not claimed:
            return "already"
        ok, _detail = st.deliver_table(body, session_id, None)
        if ok:
            return "sent"
        if sa is not None:
            try:
                os.remove(sa._ledger_path(session_id, key,
                                          OWNER_LINES_CHANNEL))
            except Exception:  # noqa: BLE001
                pass
    except Exception as e:  # noqa: BLE001 -- the set is already written
        print("WARN: owner lines post failed (%s) -- stdout stays the "
              "carrier" % e, file=sys.stderr)
    return None


_SET_TABLE_MOD = None


def _set_table_mod():
    """Lazy handle on set-table, the SoT for the set-kind derivation table.
    Memoized; set-table has a __main__ guard so importing it is side-effect
    free. Returns None on any failure -- see _derive_kind for why that has to
    degrade rather than raise."""
    global _SET_TABLE_MOD
    if _SET_TABLE_MOD is None:
        try:
            path = os.path.join(SCRIPT_DIR, "set-table")
            spec = importlib.util.spec_from_loader(
                "set_table",
                importlib.machinery.SourceFileLoader("set_table", path))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            _SET_TABLE_MOD = mod
        except Exception:  # noqa: BLE001 -- never break a set write on an import
            _SET_TABLE_MOD = False
    return _SET_TABLE_MOD or None


def _prep_cues_mod():
    if SCRIPT_DIR not in sys.path:
        sys.path.insert(0, SCRIPT_DIR)
    import prep_cues
    return prep_cues


def _next_session_prep(db_path, program_path, session_id):
    """The next unfinished SESSION-level mat drill as its whole cue block
    ('<drill> - <dose>' first, then prep_cues' count unit, steps and mistake),
    or None. Day-level and lift-free: what _next_prep_cue falls back to when
    the lift has no program slot (an off-plan host)."""
    st = _set_table_mod()
    if st is None:
        return None
    try:
        conn = _db_connect(db_path)
        try:
            row = conn.execute(
                "SELECT t.code FROM workouts w JOIN session_type t "
                "ON t.id=w.session_type_id WHERE w.id=?", (session_id,)).fetchone()
            done = {r[0] for r in conn.execute(
                "SELECT set_seq FROM workout_sets WHERE session_id=? AND "
                + st.SESSION_SLOT_SQL + " AND set_seq<=?",
                (session_id, PREP_SEQ_BASE))}
        finally:
            conn.close()
        if not row:
            return None
        rx = st.load_rx_calc()
        drills = st.session_prep_drills(rx, program_path, row[0])
        for i, drill in enumerate(drills):
            if st.prep_seq(i) in done:
                continue
            return "\n".join(_prep_cues_mod().block(
                drill, st.prep_target_spec(drill)))
    except (sqlite3.Error, KeyError, ValueError, TypeError, ImportError):
        return None
    return None


def _next_prep_cue(db_path, program_path, session_id, exercise_name):
    """(hint, cue, is_mat) for the NEXT owed entry prep drill of this lift, or
    None when no entry drill is left (the hand-over to the lift).

    hint = '<drill> - <dose>' (one line); cue = the whole prep_cues block --
    the hint, what ONE rep is, the ordered steps and the one common mistake.

    THE SAME PLAN exercise-enter printed: set-table.slot_prep_drills with the
    session context, seqs by prep_plan_ordered, done = this lift's prep rows.
    The pre-2026-10-08 reader counted session-level rows only, so a drill
    logged with the wrong scope (slot 1, live session 1) never counted and the
    JUST-FINISHED drill was announced as the next one, nine taps in a row.
    A deferred immediate_primer is not "next" here: the ramp comes first."""
    st = _set_table_mod()
    if st is None:
        return None
    try:
        rx = st.load_rx_calc()
        program = rx.load_yaml(program_path)
        day_code, _slots, slot, _i, _n = st.find_day_and_slot(
            program, db_path, session_id, exercise_name, rx=rx)
        if not (isinstance(slot, dict) and day_code):
            text = _next_session_prep(db_path, program_path, session_id)
            return (text.split("\n", 1)[0], text, True) if text else None
        drills = st.slot_prep_drills(rx, program_path, day_code,
                                     slot.get("slot"), db_path=db_path,
                                     session_id=session_id)
        conn = _db_connect(db_path)
        try:
            done = {r[0] for r in conn.execute(
                "SELECT set_seq FROM workout_sets WHERE session_id=? "
                "AND exercise_name=? AND set_seq<=?",
                (session_id, exercise_name, PREP_SEQ_BASE))}
            # a mat drill counts wherever the session logged it (table (0)
            # and the pin count session-level rows across lifts)
            session_done = {r[0] for r in conn.execute(
                "SELECT set_seq FROM workout_sets WHERE session_id=? AND "
                + st.SESSION_SLOT_SQL + " AND set_seq<=?",
                (session_id, PREP_SEQ_BASE))}
        finally:
            conn.close()
        for seq, drill in st.prep_plan_ordered(drills):
            scope_session = drill.get("prep_scope") == st.PREP_SCOPE_SESSION
            if seq in done or (scope_session and seq in session_done):
                continue
            if drill.get("phase") == st.PREP_DEFERRED_PHASE:
                return None
            lines = _prep_cues_mod().block(drill, st.prep_target_spec(drill))
            return (lines[0], "\n".join(lines), scope_session)
    except (sqlite3.Error, KeyError, ValueError, TypeError, ImportError):
        return None
    return None


def _is_mat_row(db_path, program_path, slot_num, drill_code):
    """Does this prep row belong to the session's MAT prep (table (0))? A
    session-scope row does; so does a drill the day declares as session prep
    even when an older argv stored it against a slot (live session 1)."""
    if slot_num in (None, 0):
        return True
    st = _set_table_mod()
    if st is None or not drill_code:
        return False
    try:
        rx = st.load_rx_calc()
        program = rx.load_yaml(program_path)
        days = (program or {}).get("days") or {}
        for day in days:
            if any(d.get("code") == drill_code
                   for d in st.session_prep_drills(rx, program_path, day)):
                return True
    except Exception:  # noqa: BLE001 -- unknown -> the slot's own table
        return False
    return False


def _derive_kind(set_seq):
    """(set_kind, keyboard_kind, cue_shape) for this row, READ FROM the shared
    derivation table -- never branched on here.

    Degrades to the working row of the table when set-table cannot be loaded.
