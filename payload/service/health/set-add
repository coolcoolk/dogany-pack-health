#   * the next set's weight is computed from the set just logged and ARMED
#     (live_load.arm_weight -> the shared override), so NEXT_HINT, the table,
#     the pre-log keyboard and a reps-only reply all carry the same number
#     ("you may go one step up" with no weight; owner: "say one step up to
#     WHAT").
# Best-effort throughout: any miss -> the pre-existing behaviour.
# ---------------------------------------------------------------------------
_LIVE_LOAD = None


def _live_load():
    global _LIVE_LOAD
    if _LIVE_LOAD is None:
        try:
            if SCRIPT_DIR not in sys.path:
                sys.path.insert(0, SCRIPT_DIR)
            import live_load as _ll
            _LIVE_LOAD = _ll
        except Exception:  # noqa: BLE001
            _LIVE_LOAD = False
    return _LIVE_LOAD or None


def _live_slot(program_path, db_path, session_id, exercise_name):
    """(live_load, rx, today's slot view) when this lift is calibrating today,
    else (None, None, None)."""
    ll = _live_load()
    if ll is None:
        return None, None, None
    # Cheap gate first: a lift with any prior session's working set has a
    # measured basis -- the steady state -- so rx-calc is never loaded for it.
    if ll.prior_session_working(db_path, session_id, exercise_name):
        return None, None, None
    sa = _set_arm_mod()
    if sa is None:
        return None, None, None
    try:
        rx = sa.load_rx_calc()
        slot = ll.find_slot(rx, program_path, db_path, session_id,
                            exercise_name)
        if not ll.calibrating(db_path, session_id, exercise_name, slot):
            return None, None, None
        return ll, rx, ll.view(rx, slot, db_path, session_id, exercise_name)
    except Exception:  # noqa: BLE001
        return None, None, None


def _calibration_check(conn, db_path, program_path, session_id,
                       exercise_name, weight, reps, rir):
    """dict(seq, implied, band, rir_target) when this FIRST working set of a
    calibrating lift is a calibration rung, else None."""
    if weight is None or reps is None:
        return None
    if _working_max_seq(conn, session_id, exercise_name) is not None:
        return None
    ll, rx, slot = _live_slot(program_path, db_path, session_id,
                              exercise_name)
    if ll is None:
        return None
    lohi = ll.band(slot)
    rt = ll.rir_target(rx, slot)
    verdict, imp = ll.classify(weight, reps, rir, lohi, rt)
    if verdict != "calibration":
        return None
    # Outside the band but the grid has no better weight (a light stack's
    # next pin is already past the band): re-labelling it a warm-up would
    # only re-prescribe the same number. It is working set 1.
    nxt = ll.next_load(rx, slot, db_path, session_id, exercise_name, weight,
                       reps, rir)
    if nxt is None or nxt["move"] == "hold":
        return None
    row = conn.execute(
        "SELECT MIN(set_seq) FROM workout_sets WHERE session_id = ? AND "
        "exercise_name = ? AND set_seq <= -1 AND set_seq > ?",
        (session_id, exercise_name, PREP_SEQ_BASE)).fetchone()
    seq = -1 if (row is None or row[0] is None) else int(row[0]) - 1
    return {"seq": seq, "implied": imp, "band": lohi, "rir_target": rt}


def _live_next(db_path, program_path, session_id, exercise_name, set_seq,
               weight, reps, rir, calibration=None):
    """Decide and ARM the next set's weight for a calibrating lift. Returns
    dict(kg, prev, move, say, cue) or None.

    ONE AUTHOR PER SET: a working set short of the rep floor is live batch 2's
    in-session step-down (set-arm calibration_step_down, its LOAD_DECISION
    line); this function stands aside for it, and decides every other set
    (up, hold, and the calibration rung's re-prescription)."""
    ll, rx, slot = _live_slot(program_path, db_path, session_id,
                              exercise_name)
    if ll is None or weight is None or reps is None:
        return None
    try:
        sa = _set_arm_mod()
        if sa is not None and set_seq >= 1 and calibration is None:
            try:
                if sa.calibration_step_down(
                        rx, program_path, db_path, session_id, exercise_name,
                        set_seq, slot,
                        sa.read_override(session_id, exercise_name)):
                    return None
            except Exception:  # noqa: BLE001 -- no verdict -> decide here
                pass
        nxt = ll.next_load(rx, slot, db_path, session_id, exercise_name,
                           weight, reps, rir)
        if nxt is None:
            return None
        disp = (slot.get("display") or _slot_display(program_path,
                                                     exercise_name)
                or exercise_name)
        cue = ll.load_cue(db_path, session_id, exercise_name, slot,
                          nxt["kg"])
        served = ll.read_override(session_id, exercise_name).get("weight_kg")
        if calibration is not None:
            say = ll.calibration_say(disp, weight, reps, rir, nxt["kg"], cue,
                                     nxt["band"], nxt["rir_target"])
            ll.mark_calibration(session_id, exercise_name, {
                "set_seq": calibration["seq"], "weight": weight,
                "reps": reps, "rir": rir, "implied": calibration["implied"],
                "next_kg": nxt["kg"]})
            move = nxt["move"]
        else:
            move = nxt["move"]
            if (move == "hold" and served is not None
                    and abs(float(served) - nxt["kg"]) < 1e-6):
                # Nothing to decide: the served weight stands (an owner-named
                # number keeps its author). NEXT_SET already names it.
                return {"kg": nxt["kg"], "prev": weight, "move": move,
                        "say": None, "cue": cue, "served_before": served,
                        "implied": nxt["implied"]}
            say = ll.next_say(disp, nxt["kg"], weight, move, cue,
                              nxt["band"], nxt["rir_target"])
        reason = ("%s %skg x %s%s -> e1RM %skg, target %d-%d reps RIR %d"
                  % ("calibration" if calibration else "last set",
                     ll.kg_txt(weight), reps,
                     (" RIR %s" % rir) if rir is not None else "",
                     ll.kg_txt(round(nxt["e1rm"], 1)), nxt["band"][0],
                     nxt["band"][1], nxt["rir_target"]))
        # say=None: the sentence rides set-add's own LOAD_NEXT_SAY line, not
        # the table footer (one surface, not two).
        ll.arm_weight(session_id, exercise_name, nxt["kg"], ll.DECISION_NEXT,
                      reason, None)
        return {"kg": nxt["kg"], "prev": weight, "move": move, "say": say,
                "cue": cue, "served_before": served,
                "implied": nxt["implied"]}
    except Exception as e:  # noqa: BLE001 -- never costs the logged set
        print("WARN: live load decision failed (%s)" % e, file=sys.stderr)
        return None


def _addon_pending(db_path, session_id, exercise_name, set_seq, weight, reps,
                   rir):
    """Flag a row logged with an add-on block of unknown weight. Returns
    {"ask": the Korean ask (first flagged row of this machine this session)
    or "" (already asked), "cmd": the fix argv}, or None on a miss."""
    ll = _live_load()
    if ll is None:
        return None
    try:
        machine = ll.session_machine(db_path, session_id, exercise_name)
        asked = any(r.get("machine") == machine
                    for r in ll.read_pending(session_id))
        ll.add_pending(session_id, {
            "exercise": exercise_name, "set_seq": set_seq, "pin": weight,
            "reps": reps, "rir": rir, "machine": machine})
        if machine and ll.addon_of(machine) is None \
                and not ll.addon_stated(machine):
            ll.set_addon(machine, ll.ADDON_UNKNOWN)
        cmd = ("%s %s %s --addon <kg> --addon-source <url|owner> "
               "--addon-confidence <high|medium|low>"
               % (os.path.join(SCRIPT_DIR, "machine-pick"), session_id,
                  exercise_name))
        if asked:
            return {"ask": "", "cmd": cmd, "solve": None}
        # 0.36.0 item 6: SOLVE FIRST. The machine is named from its stack
        # photo label and the block's increment is looked up (web search)
        # before the owner is asked; ADDON_ASK is the fallback only.
        label = None
        try:
            import machine_capture as _mc
            label = _mc._label(db_path, machine) if machine else None
            if label == machine:            # no ax_machine label recorded
                label = None
        except Exception:  # noqa: BLE001 -- unlabeled -> the query says so
            label = None
        solve = {"machine": machine or "-", "label": label or "-",
                 "query": "%s add-on weight kg" % " ".join(
                     x for x in (label, exercise_name.replace("_", " "))
                     if x)}
        return {"cmd": cmd, "solve": solve,
                "ask": ll.t("health.live.addon_ask", pin=_kg(weight))}
    except Exception as e:  # noqa: BLE001
        print("WARN: addon pending failed (%s)" % e, file=sys.stderr)
        return None


