def _reps_arg(v):
    """reps: an int, or `done` -> None (a done-tap: reached as prescribed, not
    counted; target_reps keeps the prescription)."""
    if str(v).strip().lower() == REPS_DONE_TOKEN:
        return None
    return int(v)


