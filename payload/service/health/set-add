def _seq_label(set_seq):
    """Owner-facing Korean label for a set_seq, in the module's OWN rung
    convention (>=1 working set / 0 bw 세팅 / -N ramp rN / <=-100 prep pN).
    Keeps the refusal readable: "웜업 r2 자리" instead of "set_seq=-2 자리"."""
    try:
        n = int(set_seq)
    except (TypeError, ValueError):
        return str(set_seq)
    if n >= 1:
        return "%d세트" % n
    if n <= PREP_SEQ_BASE:
        # The prep band. A prep drill is a set, so its refusals have to read
        # like one: "준비운동 p2 자리", never "set_seq=-101 자리".
        #
        # OWNER RULING 2026-08-25 09:30: the owner-facing word for `prep` is
        # 「준비운동」, not 프렙 -- the product-facing word is 준비운동 and the
        # English key stays prep. The key is untouched; only what they read changes.
        return "준비운동 p%d" % (PREP_SEQ_BASE - n + 1)
    if n == 0:
        # OWNER RULING 2026-08-25 12:04: 「프라이머」 is RETIRED -- it reads as
        # private internal jargon. The owner-facing word is 「세팅」. It was
        # picked over 동작 확인 because it names WHAT THE USER ACTUALLY DOES --
        # 앉아서 자리 잡고, 핀 꽂고, 한 번 움직여 보는 것 -- not the outcome.
        #
        # ONE name for every equipment class. The trailing description ("빈 봉",
        # "원판 없이", "낮은 무게 한 세트") belongs to the EQUIPMENT, and this
        # function is handed a set_seq with no equipment in it -- so it says the
        # name and nothing else. That also stops the label from lying now that a
        # STACK gets a 세팅 rung too (12:07 ruling): "빈봉 ..." on a pin stack
        # would be the same class of falsehood set-table's wt_cell exists to
        # prevent.
        #
        # The English keys are UNCHANGED -- `bw`, the set_seq==0 band and the
        # derivation table's keys all stay. Only what they read moves.
        return "세팅"
    # OWNER RULING 2026-08-25 09:30: 램프 is not a category the owner is shown.
    # `ramp` stays a distinct internal key (its own set_seq band, its own row in
    # the derivation table), but owner-facing it reads 「웜업」 -- one word for
    # the whole warm-up ladder. Also 웜업, never 워밍업: it is the word they use.
    return "웜업 r%d" % (-n)


def _field_eq(a, b):
    """Field equality across the sqlite REAL/INTEGER round-trip (the stored
    weight comes back as a float, the incoming one may be an int or a str-parsed
    float). None matches ONLY None: a NULL weight is a real datum (bodyweight /
    calibration), never "equal to" 42.5, so a write that would turn a NULL into a
    number -- or a number into a NULL -- is a DIFFERENCE and must not slip
    through the idempotent path."""
    if a is None or b is None:
        return a is None and b is None
    try:
        return abs(float(a) - float(b)) <= 1e-9
    except (TypeError, ValueError):
        return str(a) == str(b)


def _existing_set(conn, session_id, exercise_name, set_seq):
    """(slot_num, weight_kg, reps, rir) already stored at this exact
    (session_id, exercise_name, set_seq), or None when the slot is free.

    Deliberately NOT best-effort: this read IS the guard. Every other helper in
    this file swallows its errors because a miss only costs a timer or a pin --
    here a swallowed error would degrade straight back into the silent overwrite
    the guard exists to prevent, so a failure propagates and set-add exits
    non-zero with nothing written."""
    return conn.execute(
        "SELECT slot_num, weight_kg, reps, rir FROM workout_sets "
        "WHERE session_id = ? AND exercise_name = ? AND set_seq = ?",
        (session_id, exercise_name, set_seq),
    ).fetchone()


def _next_free_seq(conn, session_id, exercise_name, set_seq):
    """The next set_seq in THIS RUNG LANE that is guaranteed free, or None.

    Lanes never mix: a working set advances MAX(seq >= 1) + 1, a ramp rung
    advances MIN(seq <= -1) - 1 (r1 -> r2 -> r3). MAX+1 / MIN-1 rather than
    "first hole" on purpose -- the value handed back must be provably
    unoccupied, and a hole in the sequence is itself a symptom, not a slot to
    fill blind.

    set_seq == 0 (the bw/empty-bar primer) has NO next: the lane holds exactly
    one row by the module's convention, so None is returned and the refusal
    reports `next_free=none` instead of inventing a rung.

    Best-effort: any error -> None. Losing the hint degrades the refusal message
    (the caller is asked instead of told), never the refusal itself."""
    try:
        n = int(set_seq)
        if n >= 1:
            row = conn.execute(
                "SELECT MAX(set_seq) FROM workout_sets WHERE session_id = ? "
                "AND exercise_name = ? AND set_seq >= 1",
                (session_id, exercise_name)).fetchone()
            return int(row[0] or 0) + 1
        if n <= PREP_SEQ_BASE:
            # A3/D1: the PREP lane. It is its own lane for the same reason the
            # ramp lane is: lanes never mix, and a prep drill advancing onto a
            # ramp rung's seq would put a 발목 드릴 in the middle of a barbell
            # ladder. MIN-1 within the band, floored at the band's own base so
            # the first prep row lands on -100 and not on -101.
            row = conn.execute(
                "SELECT MIN(set_seq) FROM workout_sets WHERE session_id = ? "
                "AND exercise_name = ? AND set_seq <= ?",
                (session_id, exercise_name, PREP_SEQ_BASE)).fetchone()
            cur = row[0]
            return PREP_SEQ_BASE if cur is None else int(cur) - 1
        if n <= -1:
            # The RAMP lane, now BOUNDED BELOW by the prep band -- otherwise
            # MIN(seq <= -1) would read a prep row (-100) and hand back -101 as
            # the "next ramp rung".
            row = conn.execute(
                "SELECT MIN(set_seq) FROM workout_sets WHERE session_id = ? "
                "AND exercise_name = ? AND set_seq <= -1 AND set_seq > ?",
                (session_id, exercise_name, PREP_SEQ_BASE)).fetchone()
            return int(row[0] or 0) - 1
    except Exception:      # noqa: BLE001 -- a hint miss must never break the gate
        return None
    return None


def _fmt_measure_ko(weight, reps, rir, db_path=None):
    """Owner-facing rendering of one set's measurements.

    The name comes from the resolver. The machine sibling _fmt_measure_machine
    below is DELIBERATELY left on `rir=<n>` -- that one is parsed, not read, and
    its key is the internal field name, which never moves. A done-tap row
    (reps NULL, kit 061) reads 완료, never "None회"."""
    w = "무게없음" if weight is None else "%gkg" % float(weight)
    if reps is None:
        return "%s 완료%s" % (w, _rir_clause(rir, db_path))
    return "%s %s회%s" % (w, reps, _rir_clause(rir, db_path))


# kit 061 (2026-09-30). Tokens the positional args accept besides a number.
SLOT_SESSION_TOKEN = "session"     # slot_num -> NULL: a session-level row
REPS_DONE_TOKEN = "done"           # reps -> NULL: a prep/ramp done-tap


def _slot_arg(v):
    """slot_num: a 1-based int, or `session` (legacy `0` still accepted) ->
    None, the session-level row (kit 061: slot_num NULL = belongs to the
    session)."""
    if str(v).strip().lower() in (SLOT_SESSION_TOKEN, "-", "none"):
        return None
    n = int(v)
