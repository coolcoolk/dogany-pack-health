def _rir_clause(rir, db_path=None):
    """` · RIR <n>` for a reported rir, or '' when none was reported.

    The leading separator is part of the clause on purpose: a caller must not be
    able to print a dangling ' · ' for a set whose rir is NULL, which is the
    shape of every 'a blank rendered as a value' defect in this file."""
    return '' if rir is None else ' · %s %s' % (_rir_label(db_path), rir)


def _refuse_missing_weight(exercise_name, set_seq, reps, rir, display=None,
                           db_path=None):
    """PART 1 refusal. NOTHING is written -- and nothing the owner just reported
    is thrown away either. Refusing SILENTLY would lose the rep/RIR they spoke,
    which is worse than the bug, so the refusal is loud on both streams and
    carries every value needed to re-issue the call.

    STDOUT (the channel the model relays -- same contract as SET_LOGGED /
    SET_TABLE_MISSING / SET_TABLE_COMPLETE / NEXT_HINT:):
        WEIGHT_MISSING exercise=<name> set_seq=<n> armed=none
        WEIGHT_ASK: <short Korean ask, verbatim to the owner>
    STDERR (audit / operator, same `ERROR: ` prefix every other set-add refusal
    uses -- unknown session id, missing reps):
        ERROR: ... why ... + the exact re-run instruction.

    Exit code 1, matching set-add's documented "1 = error, clear stderr message".
    """
    print("WEIGHT_MISSING exercise=%s set_seq=%s armed=none"
          % (exercise_name, set_seq))
    # The name comes from the resolver; the VALUE, the `rir` parameter, the DB
    # column and the `--rir` flag are untouched. rir None omits the clause
    # entirely -- nothing is invented into a refusal message.
    kept = "%s회%s" % (reps, _rir_clause(rir, db_path))
    print("WEIGHT_ASK: ⚠️ 무게가 빠져서 아직 기록 안 했습니다. "
          "%s %s세트는 가장 가벼운 설정으로 5회 자세를 확인하고 "
          "2회 정도 더 할 수 있는 무게를 찾아 시작해요. 사용한 무게를 알려주세요. "
          "(%s는 들고 있습니다)"
          % (display or exercise_name, set_seq, kept))
    print("ERROR: refusing to write a PLATE-LOADED working set with no weight "
          "(%s set_seq=%s). weight_kg NULL on a barbell working set is "
          "indistinguishable from a genuine bodyweight set and is silently "
          "dropped from every volume figure (the 2026-08-20 defect: 9 sets "
          "lost). No armed prescription was found in .idrill-arm/ for this "
          "(session, exercise) either. NOTHING was written -- ask the owner for "
          "the weight, then re-run this exact call with --weight <kg> "
          "(reps=%s rir=%s are preserved above)."
          % (exercise_name, set_seq, reps, rir), file=sys.stderr)
    return 1


