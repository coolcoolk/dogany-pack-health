def _refuse_occupied_seq(exercise_name, set_seq, existing, slot_num, weight,
                         reps, rir, next_free, display=None, db_path=None):
    """THE REFUSAL. NOTHING is written and the EXISTING row is untouched -- that
    is the whole point. And nothing the owner just reported is thrown away
    either: both sides (what is already stored, what was just handed in) ride
    the output, so the call can be re-issued verbatim with one field changed.

    Conventions copied EXACTLY from _refuse_missing_weight (the sibling guard
    added the same day), so the caller has one protocol to learn, not two:

    STDOUT (the channel the model relays -- same contract as SET_LOGGED /
    WEIGHT_MISSING / SET_TABLE_MISSING):
        SET_SEQ_OCCUPIED exercise=<name> set_seq=<n> existing=<...>
                         incoming=<...> next_free=<m|none>
        SEQ_ASK: <short Korean question, verbatim to the owner>
    STDERR (audit / operator, same `ERROR: ` prefix every other set-add refusal
    uses):
        ERROR: ... why ... + both exact re-run instructions.

    Exit code 1, matching set-add's documented "1 = error, clear stderr message".

    RECOVERY IS TWO-WAY AND NEITHER BRANCH IS A GUESS. `next_free` is computed
    by CODE, so the caller never counts sets: re-fire the identical call with
    set_seq=<next_free> when the owner performed a NEW set, or re-fire it
    unchanged with --correct when they were correcting the stored one. Only the
    INTENT is left to the caller, because only the caller has it."""
    ex_slot, ex_weight, ex_reps, ex_rir = existing
    print("SET_SEQ_OCCUPIED exercise=%s set_seq=%s existing=%s incoming=%s "
          "next_free=%s"
          % (exercise_name, set_seq,
             _fmt_measure_machine(ex_slot, ex_weight, ex_reps, ex_rir),
             _fmt_measure_machine(slot_num, weight, reps, rir),
             "none" if next_free is None else next_free))
    label = _seq_label(set_seq)
    name = display or exercise_name
    if next_free is None:
        tail = "%s 정정인가요, 아니면 다른 자리인가요?" % label
    else:
        tail = "%s인가요, 아니면 %s 정정인가요?" % (_seq_label(next_free), label)
    print("SEQ_ASK: ⚠️ %s %s 자리에 이미 %s가 기록돼 있어서 덮어쓰지 않았습니다 — "
          "방금 %s은 %s"
          % (name, label,
             _fmt_measure_ko(ex_weight, ex_reps, ex_rir, db_path),
             _fmt_measure_ko(weight, reps, rir, db_path), tail))
    print("ERROR: refusing to overwrite an EXISTING set row (%s set_seq=%s). "
          "The stored row is %s and the incoming write is %s -- they differ, and "
          "no --correct was passed. set_seq is caller-chosen, so an unsignalled "
          "collision is a count desync, not a correction: overwriting it "
          "DESTROYS a set the owner performed (the 2026-08-21 defect -- working "
          "set 2 written onto set_seq=1 erased set 1; 2 sets performed, 1 row "
          "left). NOTHING was written and the stored row is untouched. Re-run "
          "this exact call ONE of two ways: with set_seq=%s if the owner just "
          "performed a NEW set (that seq is verified free), or unchanged plus "
          "--correct if this really is a correction of the stored row."
          % (exercise_name, set_seq,
             _fmt_measure_machine(ex_slot, ex_weight, ex_reps, ex_rir),
             _fmt_measure_machine(slot_num, weight, reps, rir),
             "<no free seq in this rung lane>" if next_free is None
             else next_free),
          file=sys.stderr)
    return 1


# ---------------------------------------------------------------------------
# 2026-09-01 LADDER-DESYNC defect fix -- the set-seq LADDER guard.
#
# THE INCIDENT (session 10095, incline_dumbbell_press, 2026-09-01 06:56-07:13).
# The ramp ladder went out of order at session start -- rung r2 (set_seq -2) was
# logged at 06:56:30 and rung r1 (set_seq -1) never was -- so -1 sat FREE for the
# rest of the exercise. Working sets 1/2/3 then landed at 26.0kg. At 07:10 the
# owner finished working set 4 and typed "10-2" (10 reps, RIR 2). The rows, as
# they actually stand in the DB:
#     -2  22.0  7   -   ramp      06:56:30   <- r2 logged BEFORE r1
#      1  26.0  10  3   working   06:57:56
#      2  26.0  10  2   working   07:01:03
#      3  26.0  10  2   working   07:06:44
#     -1  16.0  10  -   ramp      07:10:20   <- set 4's input landed HERE
#      4  26.0  10  2   working   07:13:14   <- only on the SECOND attempt
# session-fastpath declined the utterance (`fast-path FALLBACK: non_numeric`,
# logged 07:10:03) and handed the turn to the MODEL. The model reconstructed
# state from the DB, saw an unfilled rung, and attributed the input to it: a
# working set at 26kg was recorded as a WARM-UP at 16kg, and the owner's set 4
# landed 13 minutes late.
#
# WHY THE COLLISION GATE ABOVE DID NOT CATCH IT. That gate answers exactly one
# question -- "is this seat TAKEN?" -- and set_seq -1 was EMPTY, so it passed
# without a murmur. This is the other failure shape: the seat is free, but it is
# the WRONG seat, because the ladder has already moved past it. Two different
# questions need two gates; neither subsumes the other.
#
# WHY A PROMPT RULE WAS NEVER GOING TO CLOSE IT. The deterministic resolver was
# CORRECT the entire time. set-arm.next_ladder_seq's first rule reads: "a working
# set is already logged -> the ladder is behind us; return MAX(working) + 1.
# (Never walk BACK into a warm-up mid-exercise ...)". Asked, it would have
# answered 4. Nothing FORCED the model to ask, so the model reasoned out its own
# seq instead and got it wrong. Owner standing principle, recorded 2026-08-01:
# 안전 캡은 tool-layer에서 강제 (prompt-only 금지). This is that cap, planted on
# the write path where the wrong seq actually becomes data.
#
# THE RESOLVER IS NOT REIMPLEMENTED HERE. set-arm is IMPORTED and
# next_ladder_seq is CALLED (see _ladder_expected_seq). Its answer is the only
# thing that may authorize a refusal. There is exactly ONE ladder rule in this
# tree and it does not live in this file -- a second copy here would be the same
# class of defect as a second ramp planner (see set-arm.resolve_ramp_ladder's
# "nothing here is a second planner").
#
# WHERE THE GUARD BINDS -- the WORKING BAND ONLY, and that narrowness IS the
# safety argument. It engages only once at least one WORKING set (set_seq >= 1)
# is already logged for this (session, exercise). In that band, and only in that
# band, the resolver's answer is derivable from DB rows ALONE (rule 1: MAX + 1)
# -- no program.yaml, no ax_engine, no ramp planning. So the guard can tell a
# genuine disagreement apart from a resolver that merely failed, which matters
# enormously because next_ladder_seq is best-effort and SWALLOWS every error into
# a bare `return 1`. Outside the band (nothing logged yet, or a warm-up ladder
# still in progress) the resolver's answer depends on the ramp plan, a returned
# 1 is indistinguishable from a swallowed failure, and a wrong refusal would stop
# the owner from logging his workout at all. So outside the band: no opinion.
#
# The band still covers all three desync shapes that can destroy or misfile data
# once working sets exist:
#   * BACKWARD into a stale rung  -- the 2026-09-01 incident, exactly;
#   * BACKFILL of a hole          -- a lost set's empty seat, which _next_free_seq
#     already calls "a symptom, not a slot to fill blind";
#   * SKIP AHEAD past the next seq -- an over-counted ladder.
# Each has the same recovery: re-fire at the computed seq, or say --correct.
#
# Everything below is a pure READ plus one output helper -- nothing here writes a
# file, a DB row, or a push.
# ---------------------------------------------------------------------------

_SET_ARM_MOD = None


def _set_arm_mod():
    """Lazy handle on set-arm, the SoT for the ladder resolver next_ladder_seq.

    Same loader shape as _set_table_mod() above, for the same reason: these are
    extensionless CLI entrypoints that cannot be `import`ed by name. set-arm has
    a __main__ guard and its module level is nothing but constants and
    os.path.join calls, so loading it is side-effect free -- no DB open, no
    marker write, no push.

    Memoized, and reached ONLY on a SUSPECTED desync (see _check_ladder_seq step
    3). set-arm is a large module and the set write is the hot path -- the fast
    path budgets ~3s for the whole cursor+commit chain -- so a clean set must
    never pay for this import. A desync is by definition not the hot path.

    Returns None on any failure. A resolver that cannot be loaded is a resolver
    with no opinion, and the guard's fail-OPEN rule then applies: the owner keeps
    logging, and the operator gets a LADDER_GUARD_DEGRADED line on stderr."""
    global _SET_ARM_MOD
    if _SET_ARM_MOD is None:
        try:
            spec = importlib.util.spec_from_loader(
                "set_arm",
                importlib.machinery.SourceFileLoader("set_arm", SET_ARM))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            _SET_ARM_MOD = mod
        except Exception:  # noqa: BLE001 -- never break a set write on an import
            _SET_ARM_MOD = False
    return _SET_ARM_MOD or None


def _working_max_seq(conn, session_id, exercise_name):
    """MAX(set_seq) among WORKING sets (>= 1) already stored for this
    (session, exercise), or None when no working set is logged yet.

    Deliberately NOT best-effort, for the same reason _existing_set is not: this
    read decides whether the guard is IN SCOPE at all, so swallowing an error
    here would silently restore the always-open state the incident happened in.
    A failure propagates and set-add exits non-zero with nothing written."""
    row = conn.execute(
        "SELECT MAX(set_seq) FROM workout_sets WHERE session_id = ? "
        "AND exercise_name = ? AND set_seq >= 1",
        (session_id, exercise_name)).fetchone()
    return None if (row is None or row[0] is None) else int(row[0])


def _ladder_expected_seq(db_path, program_path, session_id, exercise_name):
    """(expected_seq, None) as computed by set-arm.next_ladder_seq, or
    (None, reason) when the resolver could not be consulted.

    The three arguments next_ladder_seq needs beyond the identifying triple are
    fetched from set-arm itself, never rebuilt here:
      * rx        -- set-arm.load_rx_calc() (rx-calc, the program/YAML reader);
      * override  -- set-arm.read_override(), the persisted F19/F21 target
                     override, so the guard reads the ladder through the SAME
                     lens the arm and the set-table do. Dropping it would let the
                     guard and the keyboard disagree about a substituted lift.
    Both are pure reads.

    `reason` is an OPERATOR string for the stderr degrade line only -- it never
    reaches the owner and is never parsed."""
    sa = _set_arm_mod()
    if sa is None:
        return None, "set-arm could not be loaded"
    try:
        rx = sa.load_rx_calc()
        override = sa.read_override(session_id, exercise_name)
        seq = sa.next_ladder_seq(rx, program_path, db_path, session_id,
                                 exercise_name, override)
    except Exception as e:  # noqa: BLE001 -- a resolver miss must never refuse
        return None, "resolver raised (%s)" % e
    try:
        return int(seq), None
    except (TypeError, ValueError):
        return None, "resolver returned a non-integer (%r)" % (seq,)


def _refuse_ladder_seq(exercise_name, set_seq, expected, slot_num, weight, reps,
                       rir, display=None, db_path=None):
    """THE LADDER REFUSAL. Nothing is written -- the row the caller aimed at is
    the WRONG row, and writing it is how a working set became a warm-up.

    Protocol copied EXACTLY from _refuse_occupied_seq, deliberately: the caller
    already learned one refusal shape and must not have to learn a second. Same
    two stdout lines, same `SEQ_ASK: ` prefix (already documented in
    workout-session/SKILL.md as a B-token -- prefix stripped, payload relayed
    verbatim), same `ERROR: ` stderr prefix, same exit code 1. The machine token
    is NEW (`SET_SEQ_MISMATCH`), and needs no SKILL edit to be handled correctly:
    the SKILL's standing rule is that an unknown NO-COLON token defaults to
    class A (suppressed entirely), which is exactly right for it.

    STDOUT:
        SET_SEQ_MISMATCH exercise=<name> set_seq=<n> expected=<m>
                         incoming=<...> resolver=next_ladder_seq
        SEQ_ASK: <short Korean question, verbatim to the owner>
    STDERR:
        ERROR: ... what the caller believed vs what the engine computed ...

    BOTH numbers ride the output on purpose. "What it believed" (set_seq) and
    "what the engine computed" (expected) are the whole content of the
    disagreement -- a refusal that named only the right answer would leave the
    caller unable to tell whether it had been misread.

    RECOVERY IS TWO-WAY AND NEITHER BRANCH IS A GUESS, same as the occupied gate:
    re-fire the identical call with set_seq=<expected> when the owner just
    performed the NEXT set (that value came from the resolver, so the caller
    never counts sets), or re-fire it unchanged plus --correct when the older
    seat really was the target. Only the INTENT is left to the caller, because
    only the caller has it."""
    print("SET_SEQ_MISMATCH exercise=%s set_seq=%s expected=%s incoming=%s "
          "resolver=next_ladder_seq"
          % (exercise_name, set_seq, expected,
             _fmt_measure_machine(slot_num, weight, reps, rir)))
    name = display or exercise_name
    print("SEQ_ASK: ⚠️ %s — 방금 %s를 %s 자리에 기록하려 했는데, 지금 순서상 "
          "다음 자리는 %s입니다. 그래서 기록하지 않았습니다 — %s인가요, 아니면 "
          "%s 정정인가요?"
          % (name, _fmt_measure_ko(weight, reps, rir, db_path),
             _seq_label(set_seq), _seq_label(expected), _seq_label(expected),
             _seq_label(set_seq)))
    print("ERROR: refusing a set_seq the ladder resolver contradicts (%s). The "
          "caller asked for set_seq=%s; set-arm.next_ladder_seq computed %s from "
          "the rows already logged. set_seq is caller-chosen, not code-derived, "
          "so an unsignalled disagreement is a count desync, not an intention: "
          "writing it FILES THE SET IN THE WRONG SEAT (the 2026-09-01 defect -- "
          "working set 4 at 26kg was recorded as warm-up rung r1 at 16kg because "
          "r1 was left unfilled and looked available). NOTHING was written. "
          "Re-run this exact call ONE of two ways: with set_seq=%s if the owner "
          "just performed the NEXT set (that value is the resolver's, not a "
          "count), or unchanged plus --correct if the older seat really was the "
          "target."
          % (exercise_name, set_seq, expected, expected), file=sys.stderr)
    return 1


def _copy(key, **kw):
    """Owner copy from the i18n bundle (code stays ASCII; ui_labels.i18n)."""
    try:
        if SCRIPT_DIR not in sys.path:
            sys.path.insert(0, SCRIPT_DIR)
        import ui_labels
        return ui_labels.i18n(key, **kw)
    except Exception:  # noqa: BLE001 -- a missing bundle never breaks a set
        return ""


def record_line(set_seq, weight, reps, rir):
    """The record line (health.live.record_line: check, n sets, kg x reps,
    RIR) from the i18n bundle; a
    weight-free set drops the kg, an unlogged RIR drops its clause."""
    if weight is not None and float(weight) > 0:
        load = _copy("health.live.record_load", kg=_kg(weight), reps=reps)
    else:
        load = _copy("health.live.record_reps", reps=reps)
    rir_part = ("" if rir is None or str(rir).strip() == ""
                else _copy("health.live.record_rir", rir=rir))
    return _copy("health.live.record_line", n=set_seq, load=load,
                 rir=rir_part)


def rung_options_block(rung_lines):
    """The fallback [[OPTIONS: ...]] block for the next warm-up row, built from
    its RUNG_SET_CMD (reps = the argv's 6th field after `set-add`), or None."""
    for line in rung_lines:
        parts = line.split()
        if parts[:1] != ["RUNG_SET_CMD"] or len(parts) < 8:
            continue
        reps = parts[7]
        if not reps.isdigit():
            return _copy("health.live.rung_options_done")
        return _copy("health.live.rung_options_reps", reps=reps)
    return None


def _check_seq_kind(db_path, program_path, session_id, exercise_name,
                    set_seq, set_kind):
    """hotfix 0.34.x (owner live 2026-10-08 06:4x, bench press). The agent ran
    `set-add <sid> bench_press 0 10 --weight 20 --set-kind ramp` -- slot and seq
    swapped -- and the row landed at set_seq=10: a "ramp" row in the working
    band, past the 4 planned sets. The engine then read seq 10 >= 4 as the last
    working set, declared the exercise complete and pushed the next exercise
    with 0 of 4 working sets logged.

    Two refusals, both before anything is written (exit 1, nothing stored):
      * the KIND contradicts the SEQ: ramp/setup rows live at set_seq <= 0, a
        working row at >= 1 (prep at <= -100). --set-kind hold is exempt.
      * a WORKING seq past today's planned count that also skips seats
        (set_seq > planned AND set_seq > MAX(logged working) + 1). An extra set
        right after the last logged one stays allowed -- that is a real
        "one more set", not a desync.
    Returns None to proceed, or the exit code after printing the refusal."""
    kind = set_kind
    if kind in ("ramp", "prep") and set_seq >= 1:
        bad = "%s row at a working seq" % kind
    elif kind == "working" and set_seq <= 0:
        bad = "working row at a warm-up seq"
    else:
        bad = None
    if bad is None and set_seq >= 2 and kind in (None, "working"):
        try:
            conn = _db_connect(db_path)
            try:
                wmax = _working_max_seq(conn, session_id, exercise_name) or 0
            finally:
                conn.close()
        except sqlite3.Error:
            wmax = None
        if wmax is not None and set_seq > wmax + 1:
            planned = None
            sa = _set_arm_mod()
            if sa is not None:
                try:
                    planned = sa.resolve_rx_sets(sa.load_rx_calc(), program_path,
                                                 db_path, session_id,
                                                 exercise_name)
                except Exception:  # noqa: BLE001 -- no plan -> fail open
                    planned = None
            if planned is not None and set_seq > int(planned):
                bad = ("working seq %s past the %s planned sets (last logged "
                       "working set: %s)" % (set_seq, planned, wmax or "none"))
    if bad is None:
        return None
    print("SET_SEQ_KIND_MISMATCH exercise=%s set_seq=%s set_kind=%s -- %s"
          % (exercise_name, set_seq, kind or "derived", bad))
    print("SEQ_ASK: " + _copy("health.live.seq_kind_ask"))
    print("ERROR: refusing set_seq=%s (%s). set-add's positional order is "
          "<session_id> <exercise_name> <slot_num> <set_seq> [reps]: setup/ramp "
          "rows are set_seq <= 0 (setup 0, ramp -1, -2, ...), working sets 1..N. "
          "NOTHING was written. Re-run the RUNG_SET_CMD line set-arm/exercise-"
          "enter printed for this row verbatim -- never compose the argv."
          % (set_seq, bad), file=sys.stderr)
    return 1


def _check_ladder_seq(conn, db_path, program_path, session_id, exercise_name,
                      slot_num, set_seq, reps, weight, rir):
    """THE LADDER GUARD. Returns None to let the write proceed, or the exit code
    of a refusal that has already emitted its full contract.

    Called only for a set_seq that is FREE and carries no --correct; the occupied
    seat and the signalled correction are the collision gate's business, and this
    one must not second-guess either (see the call site in do_add)."""
    # (1) SCOPE -- the prep band has NO ladder. next_ladder_seq walks the bw/ramp
    # rungs and the working sets; it can never return a prep seq, so asking it
    # about a 준비운동 row would manufacture a disagreement out of a question the
    # resolver was never given. exercise-enter's PREP_SET_CMD emits exactly these
    # rows (`set-add <sid> <ex> <slot> -100 <reps>`, and down from there) and the
    # model runs that argv verbatim -- a refusal here would break prep logging
    # outright, and no prep row can misfile a working set anyway (own band, own
    # lane, excluded from volume).
    if set_seq <= PREP_SEQ_BASE:
        return None

    # (2) THE CONFIDENT BAND -- see the block comment above. No working set logged
    # yet means the ladder is still in the ramp, where the resolver's answer
    # depends on the program plan and its swallowed failures are indistinguishable
    # from a real "1". No opinion, no refusal.
    working_max = _working_max_seq(conn, session_id, exercise_name)
    if working_max is None:
        return None
    # The DB-only corroboration of rule 1. This is NOT the guard's authority --
    # nothing is refused on this number alone. It exists to do two jobs the
    # resolver cannot do for itself:
    #   * skip the expensive set-arm load on every clean write (an agreeing seq
    #     can only ever be allowed, so not asking costs nothing but time), and
    #   * DETECT the resolver's swallow-all `return 1` fallback below, which is
    #     otherwise silent and would read as a confident answer.
    corroboration = working_max + 1
    if set_seq == corroboration:
        return None

    # (3) THE DISAGREEMENT PATH. Only now is the resolver loaded and asked, and
    # only its answer can refuse anything.
    expected, reason = _ladder_expected_seq(db_path, program_path, session_id,
                                            exercise_name)
    if expected is None:
        # FAIL OPEN, LOUDLY. A resolver we could not consult has no opinion, and
        # blocking the owner's set on our own inability to check is a worse
        # outcome than the desync we were checking for -- he cannot log his
        # workout at all, mid-session, with no way around it. Warn and write.
        print("LADDER_GUARD_DEGRADED %s %s set_seq=%s reason=%s -- ladder not "
              "verified, set written as asked"
              % (session_id, exercise_name, set_seq, reason), file=sys.stderr)
        return None
    if expected != corroboration:
        # The resolver and the DB rows disagree about a rule that reads straight
        # off those same rows ("a working set is logged -> MAX(working) + 1").
        # That cannot happen when the resolver actually ran, so this IS the
        # signature of its silent `except -> return 1` fallback -- or of a rule
        # change this guard has not been taught. Either way the answer is not
        # trustworthy enough to refuse a real set on. Fail open, loudly.
        print("LADDER_GUARD_DEGRADED %s %s set_seq=%s resolver=%s "
              "corroboration=%s -- resolver disagrees with the logged rows, "
              "ladder not verified, set written as asked"
              % (session_id, exercise_name, set_seq, expected, corroboration),
              file=sys.stderr)
        return None
    if set_seq == expected:
        # Unreachable given step 2 (expected == corroboration != set_seq). Kept
        # so the contract is legible as written -- the resolver agrees, we pass --
        # rather than implied by an arithmetic identity two branches up.
        return None
    return _refuse_ladder_seq(
        exercise_name, set_seq, expected, slot_num, weight, reps, rir,
        display=_slot_display(program_path, exercise_name), db_path=db_path)


def do_add(db_path, session_id, exercise_name, slot_num, set_seq, reps,
           weight, rir, raw, arm=True, arm_opts=None, program_path=None,
           correct=False, set_kind=None, target_reps=None, hold_sec=None,
           drill_code=None, machine_ref=None, addon=None):
    # Default the program SoT path for the #34/#37 auto-enter recovery.
    if program_path is None:
        program_path = os.path.abspath(DEFAULT_PROGRAM)
    from free_session import effective_path
    program_path = effective_path(program_path, db_path, session_id)
    # Ruling 3 (2026-09-11): remember whether the CALLER supplied this weight.
    # After the NULL-weight resolution block below, `weight` may hold a value the
    # ARM carried, and those two are different claims -- one is a number someone
    # typed, the other is the code's own. Only the first can be a mint.
    weight_explicit = weight is not None
    conn = _db_connect(db_path)
    try:
        # kit 061: a session-level row is slot NULL. A pre-061 DB (slot_num
        # NOT NULL) keeps the old slot 0, and every comparison below (the
        # collision gate's identical test) sees the value actually stored.
        if slot_num is None and not _kit_allows_uncounted(conn):
            slot_num = 0
        wrow = conn.execute(
            "SELECT id FROM workouts WHERE id = ?", (session_id,)
        ).fetchone()
        if wrow is None:
            print(
                "ERROR: no workouts row with id=%s (SESSION_START must "
                "pre-create the session)" % session_id,
                file=sys.stderr,
            )
            return 1

        # -------------------------------------------------------------------
        # 2026-08-21 NULL-weight defect fix. Runs BEFORE the row is written, so
        # a refusal writes nothing at all (no half-row, no upsert of a good row
        # into a weightless one). Only a WORKING set (set_seq >= 1) is touched:
        # a ramp/primer row's NULL is real data, never a hole to fill.
        # -------------------------------------------------------------------
        weight_from_arm = None
        # live batch 2 item 4 (2026-10-08: the agent asked which dumbbell
        # weight was used -- for the 16kg it had itself prescribed). A reps(+RIR)
        # reply on a rung/set the TOOL prescribed records at the prescribed
        # weight: the rung lane resolves its weight from the rung's own arm
        # (exact key) or the ladder, the working lane falls through to today's
        # prescription when no arm exists. The weight is asked only when the
        # owner says it differed (the reply then carries --weight).
        if PREP_SEQ_BASE < set_seq <= 0 and weight is None:
            weight, weight_src = _resolve_prescribed_weight(
                db_path, program_path, session_id, exercise_name, set_seq)
            if weight is not None:
                weight_from_arm = weight_src
                print("WEIGHT_RESOLVED %s %s set_seq=%s weight=%s src=%s"
                      % (session_id, exercise_name, set_seq, weight,
                         weight_src), file=sys.stderr)
        if set_seq >= 1 and weight is None:
            # PART 2 (primary): the weight is code-carried, not model-composed.
            weight, weight_src = _resolve_armed_weight(
                session_id, exercise_name, set_seq)
            if weight is None:
                weight, weight_src = _resolve_prescribed_weight(
                    db_path, program_path, session_id, exercise_name, set_seq)
            if weight is not None:
                weight_from_arm = weight_src
                # Audit only -- stderr, so the SET_LOGGED stdout contract and
                # the model's relay surface are byte-identical to a caller that
                # passed --weight itself.
                print("WEIGHT_RESOLVED %s %s set_seq=%s weight=%s src=%s"
                      % (session_id, exercise_name, set_seq, weight,
                         weight_src), file=sys.stderr)
            else:
                # PART 1 (backstop): no explicit weight, no armed prescription.
                # If this lift is loaded with a bar and plates, a NULL here is
                # the defect -- refuse and ask, never invent and never drop.
                if _is_plate_loaded(db_path, program_path, exercise_name):
                    return _refuse_missing_weight(
                        exercise_name, set_seq, reps, rir,
                        display=_slot_display(program_path, exercise_name),
                        db_path=db_path)
                # Otherwise it is a genuine weight-free movement (bodyweight /
                # machine / stack / cable / fixed dumbbell / unmapped) and NULL
                # stays legal -- wall_sit and leg_raise fall through here.

        # -------------------------------------------------------------------
        # ADD-ON BLOCK (live 2026-10-08 07:36, cable_lateral_raise): the owner
        # stacked a block on the 5kg pin, its weight unknown, and the row was
        # logged at 6.25 on an ASSUMED 1.25. `--addon <kg>` adds a known block
        # to the pin weight; `--addon unknown` records the PIN weight (a lower
        # bound, never an invented number), flags the row in raw_input and
        # the pending ledger, and asks ONCE per machine per session for the
        # number written on the block (machine-pick --addon fixes the rows).
        # -------------------------------------------------------------------
        addon_unknown = False
        if addon is not None:
            if str(addon).strip().lower() in ("unknown", "?",
                                              "\ubaa8\ub984"):  # ko unknown
                addon_unknown = True
                raw = ("%s [addon=unknown pin=%s]" % (raw or "", weight)).strip()
            else:
                try:
                    _add = float(addon)
                except (TypeError, ValueError):
                    print("ERROR: --addon takes a kg number or 'unknown' "
                          "(got %r)" % (addon,), file=sys.stderr)
                    return 1
                if weight is None:
                    print("ERROR: --addon %s needs the pin weight (--weight)"
                          % addon, file=sys.stderr)
                    return 1
                raw = ("%s [pin=%s addon=%s]" % (raw or "", weight,
                                                 _add)).strip()
                weight = round(float(weight) + _add, 4)

        # -------------------------------------------------------------------
        # LIVE LOAD item 3: the first working set of a lift with no measured
        # basis is classified by CODE (see _calibration_check). A calibration
        # set moves to the next free rung seat BEFORE any gate runs, and is
        # exempt from the rung ceiling below: the ceiling protects a planned
        # ladder from a working-weight rung, and this row is the measurement
        # the working weight is about to be derived from.
        # -------------------------------------------------------------------
        calibration = None
        if (set_seq == 1 and not correct and set_kind in (None, "working")
                and _existing_set(conn, session_id, exercise_name, 1) is None):
            calibration = _calibration_check(
                conn, db_path, program_path, session_id, exercise_name,
                weight, reps, rir)
            if calibration is not None:
                set_seq = calibration["seq"]
                set_kind = "ramp"
                print("SET_RECLASSIFIED %s %s from=1 to=%s implied=%.1f "
                      "band=%d-%d rir_target=%d src=live_load"
                      % (session_id, exercise_name, set_seq,
                         calibration["implied"], calibration["band"][0],
                         calibration["band"][1], calibration["rir_target"]),
                      file=sys.stderr)

        # -------------------------------------------------------------------
        # 2026-09-11 RUNG-CEILING gate (incident A). Runs BEFORE the row is
        # written, so a refusal writes nothing at all -- the same placement, and
        # for the same reason, as the NULL-weight gate above it.
        #
        # BAND: the RAMP lane only (PREP_SEQ_BASE < set_seq <= 0). A prep drill
        # (set_seq <= PREP_SEQ_BASE) is not a warm-up FOR anything and has no
        # working weight to be under; a working set (set_seq >= 1) is the
        # ceiling, not a thing measured against it.
        #
        # FAILS OPEN when no ceiling resolves. An unknown working weight is not
        # a working weight of zero, and refusing a rung over our own missing
        # number is the fail-open doctrine this file and ramp_lane_open both
        # already rule for.
        # -------------------------------------------------------------------
        if (PREP_SEQ_BASE < set_seq <= 0 and weight is not None
                and calibration is None):
            _ceiling, _ceil_src = _working_ceiling(conn, session_id,
                                                   exercise_name)
            if _ceiling is not None and float(weight) >= _ceiling - 1e-9:
                return _refuse_rung_at_working(
                    exercise_name, set_seq, weight, reps, _ceiling, _ceil_src,
                    display=_slot_display(program_path, exercise_name),
                    db_path=db_path)

        # -------------------------------------------------------------------
        # 2026-09-11 WORKING-LANE DIVERGENCE REPORT (ruling 3). Reports, never
        # refuses -- see the block comment on _report_weight_divergence for why
        # this lane is asymmetric with the rung lane above. Emitted BEFORE the
        # write so the line rides the same stdout as SET_LOGGED even if the
        # write later refuses on the collision gate.
        # -------------------------------------------------------------------
        if set_seq >= 1 and weight_explicit and weight is not None:
            _report_weight_divergence(
                session_id, exercise_name, set_seq, weight,
                display=_slot_display(program_path, exercise_name),
                by=((arm_opts or {}).get("ov_by")
                    if isinstance(arm_opts, dict) else None))

        # -------------------------------------------------------------------
        # 2026-08-21 SILENT-OVERWRITE fix -- the set-seq collision gate.
        #
        # Placed AFTER weight resolution and BEFORE the UPSERT, and both halves
        # of that are load-bearing:
        #   * AFTER resolution, because an idempotent re-fire that omitted
        #     --weight must compare against the SAME resolved value the first
        #     write stored -- comparing the unresolved None would read as a
        #     difference and refuse a write that changes nothing;
        #   * BEFORE the UPSERT, so a refusal writes NOTHING at all -- no
        #     half-row, no destroyed row, no recorded_at churn.
        #
        # `raw_input` is deliberately NOT part of the comparison: it is audit
        # text, not a measurement, so two utterances that report the same set
        # ("8 1" vs a button tap) stay idempotent instead of tripping the gate
        # on their wording. The four MEASURED fields are the set.
        # -------------------------------------------------------------------
        seq_noop_next_free = None
        # Case 1 (content-identical re-fire) carried to the UPSERT, where it
        # holds recorded_at + raw_input still. A SEPARATE flag from
        # seq_noop_next_free on purpose: that one is None for an identical
        # re-fire in the set_seq 0 (bw primer) lane, which has no next_free by
        # convention -- reusing it would leave exactly the primer rung
        # unprotected.
        noop_refire = 0
        existing = _existing_set(conn, session_id, exercise_name, set_seq)
        if existing is not None:
            identical = (_field_eq(existing[0], slot_num)
                         and _field_eq(existing[1], weight)
                         and _field_eq(existing[2], reps)
                         and _field_eq(existing[3], rir))
            if identical:
                # Case 1: the idempotent re-fire the UPSERT exists to support
                # (the arm/callback path can re-fire). ALLOWED unchanged -- the
                # row content cannot move, so nothing can be lost. Only a
                # SIGNAL is added, because "this write changed nothing" is
                # precisely what the caller needs to hear when the owner in
                # fact just performed a NEW set: the row survives either way,
                # but the set COUNT would otherwise stay silently wrong.
                #
                # And the row really is left ALONE -- see the CHRONOLOGY note in
                # the header. This flag is the only thing that reaches the
                # UPSERT from here, and all it does is keep recorded_at (and the
                # first utterance) from being restamped by a write that changes
                # nothing.
                noop_refire = 1
                seq_noop_next_free = _next_free_seq(
                    conn, session_id, exercise_name, set_seq)
            elif not correct:
                # Case 2: differing values, no correction signalled. REFUSE.
                return _refuse_occupied_seq(
                    exercise_name, set_seq, existing, slot_num, weight, reps,
                    rir, _next_free_seq(conn, session_id, exercise_name,
                                        set_seq),
                    display=_slot_display(program_path, exercise_name),
                    db_path=db_path)
            else:
                # Case 3: an explicitly signalled correction -- overwrite
                # exactly as before (F3a in-place correction), but never
                # invisibly: the before->after rides stderr (audit), so the
                # stdout contract stays byte-identical to a plain write.
                print("SET_OVERWRITE %s %s set_seq=%s before=%s after=%s "
                      "src=--correct"
                      % (session_id, exercise_name, set_seq,
                         _fmt_measure_machine(*existing),
                         _fmt_measure_machine(slot_num, weight, reps, rir)),
                      file=sys.stderr)

        # -------------------------------------------------------------------
        # 2026-09-01 LADDER-DESYNC fix -- the set-seq ladder guard (full
        # rationale + the incident at _check_ladder_seq above).
        #
        # Placed AFTER the collision gate and BEFORE the UPSERT, and all three
        # facets of that position are load-bearing:
        #   * AFTER the collision gate, because that gate owns every OCCUPIED
        #     seat and this one must not re-litigate its verdicts. In particular
        #     the IDEMPOTENT RE-FIRE (case 1) is an explicitly supported path --
        #     a button/callback re-firing an already-written set -- and the
        #     ladder has by definition moved past that seq, so a ladder check
        #     there would refuse exactly the re-fire the UPSERT exists to allow.
        #     `existing is None` is what excludes all of it.
        #   * NOT when --correct is set. A correction legitimately targets an
        #     OLDER seq -- that is what the flag means -- so it is the caller's
        #     declared escape hatch from this gate as well as from the collision
        #     one. It stays the single word that opens a write the code would
        #     otherwise refuse. (--ov-* is NOT a correction signal here either,
        #     for the reason spelled out at the collision gate: it rides ordinary
        #     first-time writes.)
        #   * BEFORE the UPSERT, so a refusal writes NOTHING -- no half-row, no
        #     mis-seated row, no recorded_at churn.
        # -------------------------------------------------------------------
        if existing is None and not correct:
            _ladder_rc = _check_ladder_seq(
                conn, db_path, program_path, session_id, exercise_name,
                slot_num, set_seq, reps, weight, rir)
            if _ladder_rc is not None:
                return _ladder_rc

        # Direct, idempotent UPSERT. On the UNIQUE key collision (same set slot)
        # every MEASURED field is rewritten, so an F3a correction overwrites in
        # place instead of inserting a duplicate. The two AUDIT fields are
        # conditional on `noop_refire`, the collision gate's own verdict:
        #
        #   * recorded_at -- restamped on a write that changed the set (a fresh
        #     INSERT never reaches DO UPDATE at all; case 3 --correct really did
        #     happen now), PRESERVED on a case-1 no-op. Unconditional restamping
        #     is the 2026-09-01 chronology defect: the write that provably
        #     changed nothing was the one that moved WHEN the set happened, and
        #     a reader ordering by recorded_at saw a phantom out-of-order ladder
        #     (full account in the header's CHRONOLOGY note);
        #   * raw_input -- SAME class of silent loss, so it is fixed here with
        #     it. A re-fire commonly carries no --raw (it defaults to None), so
        #     `raw_input = excluded.raw_input` on a no-op NULLED OUT the original
        #     utterance -- destroying the audit trail of a write whose whole
        #     claim is that it destroys nothing. COALESCE rather than a flat
        #     preserve because the loss runs both ways: an existing utterance is
        #     never overwritten by a later re-fire, but a NULL left by a
        #     button-path first write is still fillable by one. Never a
        #     difference the gate compares on -- two wordings of the same set
        #     stay idempotent, exactly as the gate's note above says.
        #
        # 2026-08-27 -- THE KIND AND THE PRESCRIPTION ARE ALSO WRITTEN.
        #
        # The column list used to omit `set_kind` and `target_reps` entirely
        # while the schema declares `set_kind TEXT NOT NULL DEFAULT 'working'`,
        # so every prep row this file wrote was stored as a WORKING set by
        # default. A migration-time backfill hides that, because only rows
        # written AFTERWARDS take the default.
        #
        # The kind is DERIVED FROM THE SHARED TABLE (_derive_kind -> set-table
        # set_kind_for_seq), not branched on here, so the stored column and the
        # derived kind cannot disagree. An explicit --set-kind wins, because
        # `hold` is not derivable from a sequence number (set-table says so in
        # set_kind_for_seq's own docstring: what makes a set a hold is the SLOT).
        #
        # target_reps / hold_sec carry the PRESCRIPTION. For a prep row that is
        # the whole point of the completion tap: the value recorded is the value
        # prescribed, and it has to land somewhere that says it was a
        # prescription rather than a measurement. The UNIT of that value lives in
        # prep.yaml (`target_unit`) and is resolved at read time from the same
        # projection the table reads -- there is no unit column and no migration
        # is being run in front of a live session to add one.
        #
        # The statement is ASSEMBLED rather than written out because of the
        # column probe below; the two CASE WHEN clauses are appended LAST, so
        # their qmarks bind after every value qmark. The flag is bound TWICE
        # because sqlite3 forbids mixing qmark and named parameters in one
        # statement; it is one value, computed once, above.
        stored_kind = set_kind or _derive_kind(set_seq)[0]
        cols = ["session_id", "exercise_name", "slot_num", "set_seq",
                "weight_kg", "reps", "rir", "raw_input"]
        vals = [session_id, exercise_name, slot_num, set_seq,
                weight, reps, rir, raw]
        upserts = ["slot_num    = excluded.slot_num",
                   "weight_kg   = excluded.weight_kg",
                   "reps        = excluded.reps",
                   "rir         = excluded.rir"]
        # Column-probe rather than assume: an older DB copy (a suite fixture, a
        # restored backup) may predate 034, and a write that CRASHES is worse
        # than one that stores a little less. Present -> written; absent -> the
        # pre-034 column list, byte-for-byte what it was before.
        have = _workout_sets_columns(conn)
        if "set_kind" in have:
            cols.append("set_kind")
            vals.append(stored_kind)
            upserts.append("set_kind    = excluded.set_kind")
        if "target_reps" in have:
            cols.append("target_reps")
            vals.append(target_reps)
            upserts.append("target_reps = excluded.target_reps")
        if "hold_sec" in have:
            cols.append("hold_sec")
            vals.append(hold_sec)
            upserts.append("hold_sec    = excluded.hold_sec")
        if "drill_code" in have and drill_code:
            cols.append("drill_code")
            vals.append(drill_code)
            upserts.append("drill_code  = excluded.drill_code")
        # kit 062: which machine. An explicit --machine wins; else a machine
        # lift takes this session's choice (machine-pick / an earlier set).
        # Prep/ramp rows too: a warm-up on the machine teaches its grid.
        if "machine_ref" in have:
            mref = machine_ref or _session_machine(db_path, session_id,
                                                   exercise_name)
            if mref:
                cols.append("machine_ref")
                vals.append(mref)
                upserts.append("machine_ref = excluded.machine_ref")
        upserts.append(
            "raw_input   = CASE WHEN ? "
            "THEN COALESCE(workout_sets.raw_input, excluded.raw_input) "
            "ELSE excluded.raw_input END")
        upserts.append(
            "recorded_at = CASE WHEN ? THEN workout_sets.recorded_at "
            "ELSE datetime('now', 'localtime') END")
        try:
            conn.execute(
                "INSERT INTO workout_sets (%s) VALUES (%s) "
                "ON CONFLICT(session_id, exercise_name, set_seq) "
                "DO UPDATE SET %s"
                % (", ".join(cols), ", ".join("?" * len(cols)),
                   ", ".join(upserts)),
                tuple(vals) + (noop_refire, noop_refire),
            )
        except sqlite3.IntegrityError as e:
            # A kit trigger refused the row (kit 061 reps / kit 062 machine):
            # nothing was written; say so plainly instead of a traceback.
            print("ERROR: set refused by the kit: %s" % e, file=sys.stderr)
            return 1
        conn.commit()
        # Self-heal the session-active marker (best-effort, never blocks a set).
        _mark_active(session_id)
        # The row's code-posted keyboard is done (row_keyboard) -- BEFORE
        # set-arm runs, because set-arm re-writes this row's arm file.
        _row_keyboard_logged(session_id, exercise_name, set_seq)
        # LIVE LOAD item 2: the next set's weight, decided and ARMED before
        # set-arm runs, so the arm / NEXT_HINT / table it builds carry it. A
        # caller-stated --ov-weight on this call is a decision already made
        # and wins.
        live_next = None
        if (arm and (set_seq >= 1 or calibration is not None)
                and not (arm_opts or {}).get("ov_weight")
                and not (arm_opts or {}).get("ov_clear")):
            live_next = _live_next(db_path, program_path, session_id,
                                   exercise_name, set_seq, weight, reps, rir,
                                   calibration=calibration)
        addon_ask = None
        if addon_unknown:
            addon_ask = _addon_pending(db_path, session_id, exercise_name,
                                       set_seq, weight, reps, rir)
        # Arm the rest timer FIRST (before the SET_LOGGED line), so the timer
        # starts the instant the set lands. Best-effort -- see _arm().
        # _arm returns a dict of machine signals parsed from set-arm's stdout
        # (next_hint = F11 derived next-step; hold_next = F19/F33 force-a-button),
        # to be surfaced AFTER SET_LOGGED.
        signals = {"next_hint": None, "hold_next": None, "table_complete": None,
                   "rest_armed": None, "idrill_marker": None, "prep_tap": [],
                   "kb_delivered": None}
        if arm:
            signals = _arm(db_path, session_id, exercise_name, set_seq,
                           arm_opts or {}) or signals
        next_hint = signals.get("next_hint")
        hold_next = signals.get("hold_next")
        table_complete = signals.get("table_complete")
        rest_armed = signals.get("rest_armed")
        idrill_marker = signals.get("idrill_marker")
        kb_delivered = signals.get("kb_delivered")
        set_cue = signals.get("set_cue")
        load_say = signals.get("load_say")
        # A PREP ROW: the next thing is the next DRILL, with its cue, while
        # any entry drill is owed -- never the lift (live 2026-10-08: "bench
        # press x 8" after drill 1 of 9). None -> prep is over and set-arm's
        # hint (the lift's first step) stands: the hand-over.
        prep_next = None
        if set_seq <= PREP_SEQ_BASE:
            prep_next = _next_prep_cue(db_path, program_path, session_id,
                                       exercise_name)
            if prep_next:
                next_hint = prep_next[0]
                set_cue = prep_next[1]
                rest_armed = None
        # Well-formed success line the forcing hook matches. This contract line
        # is UNCHANGED and stays first; the NEXT_HINT line below is ADDITIVE.
        print("SET_LOGGED %s %s %s reps=%s"
              % (session_id, exercise_name, set_seq, reps))
        # Set-seq collision gate, case 1 (idempotent re-fire). The write was
        # allowed and the row is byte-identical to what was already stored, so
        # this line is purely ADDITIVE and never blocks anything -- but it is on
        # STDOUT, not stderr, because the caller has to act on it in the one
        # case that matters: if the owner just performed a NEW set, this write
        # recorded nothing new and the set belongs at next_free. Printed AFTER
        # SET_LOGGED so the forcing hook's first-line match is untouched.
        if seq_noop_next_free is not None:
            print("SET_SEQ_NOOP %s %s set_seq=%s unchanged next_free=%s"
                  % (session_id, exercise_name, set_seq, seq_noop_next_free))
        # Item 1: the weight came from the tool's own prescription -- say so,
        # so the reply states it and never asks the owner for it.
        if weight_from_arm:
            print("WEIGHT_FROM_ARM %s %s set_seq=%s weight=%s src=%s -- "
                  "recorded at the prescribed weight; do NOT ask the owner "
                  "for the weight" % (session_id, exercise_name, set_seq,
                                      _kg(weight), weight_from_arm))
        # 0.36.0 item 4: rest measured RETROACTIVELY -- this set's record
        # time minus the previous row's (the clarifying back-and-forth in
        # between counts as rest). A machine line; the first row has none.
        try:
            import session_clock
            _rest = session_clock.rest_before(db_path, session_id,
                                              exercise_name, set_seq)
        except Exception:  # noqa: BLE001
            _rest = None
        if _rest is not None and set_seq > PREP_SEQ_BASE:
            print("REST_MEASURED %s %s set_seq=%s rest=%ds basis=record"
                  % (session_id, exercise_name, set_seq, _rest))
        # 0.36.0 item 7: the register's record line, built by code so the
        # reply opens with it verbatim (never recomposed, never praised).
        if set_seq >= 1 and calibration is None:
            print("RECORD_LINE: " + record_line(set_seq, weight, reps, rir))
        if calibration is not None:
            print("SET_RECLASSIFIED %s %s from=1 to=%s kind=ramp "
                  "reason=calibration implied=%.1f band=%d-%d -- stored as a "
                  "warm-up; working set 1 is still owed"
                  % (session_id, exercise_name, set_seq,
                     calibration["implied"], calibration["band"][0],
                     calibration["band"][1]))
        if live_next is not None:
            print("LOAD_NEXT %s %s from=%s to=%s move=%s -- armed: table, "
                  "NEXT_HINT, keyboard and a reps-only reply all use it"
                  % (session_id, exercise_name, _kg(live_next["prev"]),
                     _kg(live_next["kg"]), live_next["move"]))
            if live_next["say"]:
                print("%s: %s" % ("CALIBRATION_SAY" if calibration is not None
                                  else "LOAD_NEXT_SAY", live_next["say"]))
        if addon_ask is not None:
            print("ADDON_UNKNOWN %s %s set_seq=%s pin=%s -- recorded at the "
                  "pin weight; the block is flagged, not guessed"
                  % (session_id, exercise_name, set_seq, _kg(weight)))
            _solve = addon_ask.get("solve")
            if _solve:
                print('ADDON_SOLVE machine=%s label="%s" query="%s" -- SOLVE '
                      "FIRST, before any ask: identify the machine from its "
                      "stack-photo label, look the add-on block's increment "
                      "up (web search the query), then run ADDON_FIX_CMD "
                      "with that kg, --addon-source <url> and "
                      "--addon-confidence, and state the source and the "
                      "confidence in the reply. NEVER invent a number: no "
                      "source found -> relay ADDON_ASK below, nothing else"
                      % (_solve["machine"], _solve["label"], _solve["query"]))
            print("ADDON_FIX_CMD %s -- run with the looked-up kg (its source "
                  "+ confidence), or the number the owner reads off the "
                  "block (--addon-source owner); it corrects every flagged "
                  "row" % addon_ask["cmd"])
            if addon_ask["ask"]:
                print("ADDON_ASK: %s" % addon_ask["ask"])
        # G19 RIR-floor breach flag (2026-08-23, owner-confirmed). The floor is a
        # SAFETY CAP, and the owner rule of 2026-08-01 says a safety cap is
        # enforced in the tool layer, never prompt-only. rx-calc already clamps
        # the PRESCRIPTION; this is the other half -- the cap biting on the
        # RECORD side, after the fact.
        #
        # Why post-hoc and not a refusal or an input cap: the RIR keyboard
        # deliberately still offers 0-4 (see set-arm RIR_STEP_BUTTONS). If the
        # owner actually ground the set out to RIR 0, the log MUST be able to say
        # RIR 0 -- capping the input would falsify the record and blind the very
        # autoregulation the floor feeds. So the set is written UNCHANGED and
        # UNBLOCKED, exactly as reported, and the breach is announced alongside
        # it. The signal line is purely ADDITIVE (SET_LOGGED stays first and
        # byte-identical, same discipline as SET_SEQ_NOOP / SET_TABLE_MISSING),
        # so nothing downstream that matches on SET_LOGGED is disturbed.
        #
        # Scope: working sets only (set_seq >= 1). A rung/primer writes no --rir
        # at all (rir stays NULL) and is prescribed at RIR 4+ by construction, so
        # it has nothing to breach.
        if set_seq >= 1 and rir is not None:
            floor = _rir_floor(program_path, exercise_name)
            if floor is not None and rir < floor:
                print("RIR_FLOOR_BREACH %s %s set_seq=%s rir=%s floor=%s"
                      % (session_id, exercise_name, set_seq, rir, floor))
                disp = _slot_display(program_path, exercise_name) or exercise_name
                # Owner-facing, in the owner's language: name the breach and the
                # action. Per the SKILL, a floor with room left is a LOAD signal,
                # so going under it is not a scolding -- it is a cue to add weight
                # next session rather than to keep grinding to failure.
                #
                # The TERM is kept (owner ruling: keep the RIR string itself and
                # take display-name changes on a separate track). It is their
                # working vocabulary, not an internal state key -- paraphrasing it
                # into plain language was tried on 2026-08-24 and reverted the
                # same day. The English-token leak rule targets state keys and
                # file/function names, never domain terminology the user uses themselves.
                #
                # The NAME, however, is no longer a literal here. This warning is
                # the site that proved why: the substitution rollout renamed the
                # keyboard, the table and the confirm string and never reached
                # this sentence, so one session showed the owner two names for
                # one number. Resolving it here means the four surfaces cannot
                # be edited apart.
                #
                # D5 (2026-08-24 preflight): this prose used to exist ONLY on
                # stderr. The model's contract surface is stdout, so the machine
                # token went to the model and the SAFETY sentence went nowhere --
                # a safety cap that announces itself to no one. Composed ONCE and
                # emitted twice: stdout for the owner (relayed), stderr kept for
                # the audit trail (and for the suites that pin it there).
                _floor_note = floor_warning(db_path, disp, set_seq, rir, floor)
                print("RIR_FLOOR_NOTE: %s" % _floor_note)
                print("WARN: %s" % _floor_note, file=sys.stderr)
        # F10/F28 exercise-entry gate -> #34/#37 TRUE determinism: on the FIRST
        # working set of an exercise (set_seq == 1), if set-table never published
        # the (2) progress table for this exercise, the entry forcing point
        # (exercise-enter) was DROPPED -- the exact recurring non-determinism on
        # JIT/prep-laden exercises (v_squat). Instead of only signalling the
        # model, set-add now AUTO-FIRES exercise-enter server-side so the entry
        # payload (표2 publish + 표3 pin + settings/params/anchor) lands via code,
        # never depending on the model to have remembered the call. Only the
        # first working set is checked (ramp/primer/later sets do not re-enter),
        # and only when arming (the data-only backfill path owns its own state).
        # The SET_TABLE_MISSING model-facing fallback still fires IF auto-enter
        # could not publish (e.g. a resolver miss), so the belt-and-suspenders
        # nudge is preserved for the degenerate case. Never blocks the logged set.
        # Defect B: the recovery fires when the exercise was NEVER entered this
        # session (no .exercise-entered marker -> the entry payload, incl. the
        # (2) table, was never delivered) OR the table was never published. Keying
        # on the entered-marker (not the published flag alone) closes the stale-
        # flag hole: a leftover/diagnostic .set-table-published flag no longer
        # suppresses the entry recovery, so the initial table reliably lands.
        # auto-enter is idempotent (its own entered-marker), so re-running it when
        # a real entry already happened is a cheap no-op that does not double-post.
        entered = _exercise_entered(session_id, exercise_name)
        if (set_seq == 1
                and (not entered
                     or not _table_published(session_id, exercise_name))):
            published = False
            if arm:
                published = _auto_enter(db_path, program_path, session_id,
                                        exercise_name)
            if not published:
                print("SET_TABLE_MISSING %s %s" % (session_id, exercise_name))
                print("WARN: (2) set-progress table was NOT posted on entry for "
                      "%s -- run set-table now and post its output before the "
                      "next reply (F10/F28 gate)" % exercise_name,
                      file=sys.stderr)
        # #14 follow-up: refresh the pinned 종목카드 (표3) live per-set progress
        # (✓/▸/·). Deterministic + best-effort; after commit + arm + the #34/#37
        # auto-enter so THIS live-progress refresh is the FINAL pin write (a
        # first-set auto-enter renders the static entry card; the refresh then
        # overlays the current ✓/▸/· row on top). Never on the arm-suppressed
        # data-only path (arm=False is used only by tests/tools that own their
        # own pin state).
        # set_seq >= 1: the card's live row is WORKING-set progress (✓/▸/·) and
        # the volume block ignores set_seq <= 0 entirely, so a rung has nothing
        # to refresh. Keeping the rung out also keeps the 2026-08-21 arming-gate
        # lift (rungs now reach set-arm) from adding a new pin-write surface.
        # A3/D2: the gate used to be `set_seq >= 1`, and that is exactly how a
        # ramp turn ended up with NO TABLE. Measured, barbell_row 2026-08-25:
        #   07:23:40  "빈 봉 5회 기록됐어요. 다음 램프 1, 40kg x7 ..." + table
        #   07:24:30  "램프 1(40kg) 7회 기록됐어요. ..."   <- no table, no arm
        #   07:26:53  "램프 2(60kg) 5회 기록됐어요. ..."   <- no table, no arm
        # Identical at leg_curl / bicep_curl / standing_calf_raise. The rung had
        # landed in the DB and vanished from the screen, so the owner could not
        # see their own ramp progress and had to ask (`웜업기록됐나?`, 06:41:20).
        #
        # The refresh is an EDIT OF THE PINNED CARD -- an in-place update, no
        # new bubble. It stays exactly as it was; what changed on 2026-09-11 is
        # that it is no longer the ONLY per-set surface -- the (2) table now
        # goes out on the same beat, for the reason set out just below.
        #
        # The card's ✓/▸/· working-progress row is computed from set_seq >= 1
        # inside exercise-enter and is therefore unmoved by a rung; what changes
        # is the set grid, which is the part that was missing.
        #
        # ------------------------------------------------------------------
        # THE (2) SET-TABLE, ON THIS SET. Owner ruling 2026-09-11, said three
        # times and finally in plain words: 「제발 세트마다 표를 내자는 의미잖아」.
        #
        # This SUPERSEDES the reading that stood here since 2026-08-25 -- that
        # the pinned-card edit above was the only per-set surface the progress
        # table was allowed, because a table per set would mean a bubble per
        # set. The owner has now weighed that cost themselves and chosen the
        # table. The measurement that forced the choice: over one live session
        # the table rail sent 5 messages, all 5 at exercise entry and none
        # between sets, because the only carrier the table ever had was a
        # sentence asking the model to post it.
        #
        # LAST, after the pin refresh: the table is the message the owner is
        # meant to be looking at when the beat settles, so it is the last thing
        # written. Under `arm` for the same reason the refresh is -- the
        # data-only backfill path (arm=False, tests/tools) owns its own
        # surfaces and must not push anything at an owner.
        #
        # EVERY set, no set_seq filter. A prep drill, a rung and a working set
        # all move the grid, and the rungs are the rows that measurably
        # disappeared (2026-08-25: four exercises where the rung landed in the
        # DB and never reached the screen). Prep drills need no special case
        # either -- the F14 gate on the other side holds the table until the
        # entry prep band closes, so the first table of an exercise arrives on
        # the drill that finishes prep, which is exactly where F14 puts it.
        #
        # (The text fast path that committed with --no-arm and rendered its
        # own table was removed 2026-10-08; --no-arm callers own their beats.)
        prep_table_out = False
        if arm:
            _refresh_card(db_path, session_id, exercise_name)
            _publish_table(db_path, program_path, session_id, exercise_name)
            # Tables (0) / (0-E) re-post after every prep drill (2026-10-02):
            # a session-level row moves the mat table, a slot row the machine
            # table. Code-rendered; the model relays the fenced block.
            if set_seq <= PREP_SEQ_BASE:
                prep_table_out = _prep_table(
                    db_path, program_path, session_id, exercise_name,
                    "mat" if _is_mat_row(db_path, program_path, slot_num,
                                         drill_code) else "equipment")
        # F11 Delta 2: re-print the derived next-step hint on set-add's OWN
        # stdout, a SEPARATE line with a distinct prefix (never merged into
        # SET_LOGGED). Model reads this to pre-attach "다음: <spec>" verbatim.
        # NONE (session end) -> a marker line; absent hint -> omitted.
        # P2 (owner ruling: load progression is the AGENT's call, not the engine's):
        # when this write changed today's load, set-arm has already DECIDED and
        # written the one sentence that states it. Surface it here, ahead of the
        # cue, and relay it verbatim -- it is the answer to "왜 증량해?", and the
        # reason the model must not compose one is that the composed version is
        # what cited the engine and then handed the choice back.
        if load_say:
            print("LOAD_DECISION (echo verbatim -- this is the decision and its "
                  "reason; do NOT restate it as a choice for the owner):")
            print("LOAD_DECISION: %s" % load_say)
        # live batch 2 item 8: the owner-format next-set line, code-emitted.
        # Relayed verbatim (both lines, the leading `>` included) -- the reply
        # never recomposes the next-set line itself.
        _ns_lines = signals.get("next_set_lines") or []
        if _ns_lines and next_hint not in (None, "NONE"):
            print("NEXT_SET (relay the %d quoted lines below VERBATIM as the "
                  "next-set line, '>' included; do NOT compose your own "
                  "'%s' line):" % (len(_ns_lines),
                                   _copy("health.live.next_set.label")))
            for _nl in _ns_lines:
                print(_nl)
        if next_hint == "NONE":
            print("NEXT_HINT: (세션 종료)")            # (세션 종료)
        elif next_hint:
            print("NEXT_HINT: %s" % next_hint)
        # H11 (2026-08-24 -- the cue block went out empty): re-surface
        # set-arm's deterministic block-2 (큐) carrier on set-add's OWN stdout
        # so the model ECHOES the cue instead of composing it. Composition was
        # the step that got skipped under live pressure -- SKILL.md's G5-ext
        # rule already conceded it is "prose 레벨 통제이지 강제 메커니즘이
        # 아니다". This is the forcing point it named.
        #
        # Printed BEFORE the timer/arming lines below and AFTER the table
        # signals above, so set-add's own stdout mirrors the 표->큐->타이머
        # order the reply must land in.
        #
        # The three states render as three DIFFERENT things. That is the fix:
        #   real cue -> the text (echo verbatim)
        #   NONE     -> nothing at all. The owner's reading of case (b): if the
        #               slot has no cue, block 2 drops OUT of the order rather
        #               than sitting there empty for them to notice.
        #   MISSING  -> a loud line naming the reason. A cue we failed to build
        #               is a defect they must be able to SEE and report, not a
        #               gap they have to interpret. Silence here is what cost them
        #               the 07:05 set.
        # A3/D2: THE BLOCK CONTRACT, STATED PER SET, DERIVED FROM THE TABLE.
        #
        # Every one of the three prose-only ramp turns on 2026-08-25 had its
        # blocks available: set-arm's stdout for those very rows carried
        # `[[IDRILL:0bcbbb7b]]`, `[[IDRILL:4bd3734f]]` and a SET_CUE: line. The
        # blocks existed and the turn did not use them, because nothing in the
        # payload said what the turn OWED. A rule that lives only in SKILL.md
        # prose is a rule that evaporates under live pressure -- the same
        # concession G5-ext already made in writing.
        #
        # So the owed blocks are now a LINE, computed from the derivation table
        # (set-table SET_KIND_DERIVATION) for THIS set's kind. There is no
        # if/elif here choosing what a ramp gets: the kind is read off the
        # stored set_seq and the shape is read out of the table. A rung and a
        # working set therefore owe the same three blocks BY CONSTRUCTION, and
        # "ramp turns are different" stops being expressible.
        _kind, _kb, _cue_shape = _derive_kind(set_seq)
        # A prep drill's table is the PREP_TABLE fence printed above (tables
        # (0)/(0-E)), not the pin: say which, so the reply relays it.
        _tbl = ("prep_table", "the PREP_TABLE fence above, relayed verbatim") \
            if prep_table_out else ("pin_edit", "the refreshed table (pin "
                                    "edit, NOT a new table bubble)")
        if signals.get("kb_rail") == "code":
            # CODE-POSTED KEYBOARDS (2026-10-08): the reply owes no keyboard.
            print("SET_BLOCKS kind=%s seq=%s table=%s cue=%s keyboard=%s "
                  "volume=%s -- this reply owes ALL of: %s and the cue line. "
                  "The keyboard is posted by code: never author buttons, and "
                  "echo a bare [[IDRILL:...]] or [[OPTIONS: ...]] line only "
                  "if one is printed below. Prose alone is not a turn."
                  % (_kind, set_seq, _tbl[0], _cue_shape, _kb,
                     "yes" if _kind == "working" or _kind == "hold" else "no",
                     _tbl[1]))
        else:
            print("SET_BLOCKS kind=%s seq=%s table=%s cue=%s keyboard=%s "
                  "volume=%s -- this reply owes ALL of: %s, the cue line, the "
                  "keyboard marker. Prose alone is not a turn."
                  % (_kind, set_seq, _tbl[0], _cue_shape, _kb,
                     "yes" if _kind == "working" or _kind == "hold" else "no",
                     _tbl[1]))
        for _cue_line in render_set_cue(set_cue):
            print(_cue_line)
        # DGN-918/939 in-place reps/RIR keyboard: re-surface set-arm's
        # `[[IDRILL:<arm_id>]]` output marker on set-add's OWN stdout as a clean
        # machine line so the model attaches it VERBATIM to the set-done/
        # completion reply (contract §6: the marker renders the reps->RIR->log
        # keyboard on the message it rides, 0 model turn per tap -- replacing the
        # OLD F17 [[OPTIONS]] model-narration two-tap). Present only when the
        # DGN918 flag is on AND set-arm emitted a marker; absent otherwise, so a
        # flag-off session is byte-identical (no marker line, no leak).
        if idrill_marker:
            # The bridge renders the reps->RIR keyboard ONLY from a BARE
            # `[[IDRILL:<id>]]` line in the model reply (IDRILL_MARKER_RE is
            # full-line anchored: `^\[\[IDRILL:([0-9a-f]{8})\]\]$`). Surface the
            # marker as a BARE bracket line on stdout -- the exact form the model
            # echoes verbatim. The human-readable audit label rides stderr only,
            # so an `IDRILL_MARKER: ` prefix can never leak into the reply and
            # defeat the bridge regex.
            print("IDRILL_MARKER (echo the bare bracket line below verbatim):",
                  file=sys.stderr)
            print(idrill_marker)
        elif kb_delivered:
            # ONE ARM ONE KEYBOARD (owner live 2026-09-11 06:36/06:37): the
            # keyboard went out (or already sits) as its OWN code-sent message,
            # so set-arm emitted no marker. Say so POSITIVELY: silence here
            # reads as "keyboard missing" and invites the model to author a
            # substitute -- which is exactly the second set of buttons the
            # owner reported.
            print("KEYBOARD_DELIVERED %s -- the keyboard for the next step is "
                  "already on the owner's screen (sent by code, its message "
                  "carries its own prompt). Do NOT echo any [[IDRILL:...]] "
                  "marker, do NOT author an [[OPTIONS]] block for this step, "
                  "and do NOT restate the input prompt." % kb_delivered)
        # RELAY DEPENDENCE: on the code rail the lines above that the owner
        # is owed for this set go out as ONE code-posted message (record
        # line, the load decision / next-load sentence, the next-set
        # blockquote). The plate cue already rides the code-posted set-start
        # push and keyboard. Prep drills have their own code-posted cue.
        owner_posted = None
        if (arm and signals.get("kb_rail") == "code"
                and set_seq > PREP_SEQ_BASE):
            _own = []
            if set_seq >= 1 and calibration is None:
                _own.append(record_line(set_seq, weight, reps, rir))
            if live_next is not None and live_next.get("say"):
                _own.append(live_next["say"])
            if load_say:
                _own.append(load_say)
            if _ns_lines and next_hint not in (None, "NONE"):
                _own.extend(_ns_lines)
            owner_posted = _post_owner_lines(session_id, exercise_name,
                                             set_seq, _own)
        if owner_posted:
            print("OWNER_LINES posted=code status=%s -- RECORD_LINE, the "
                  "LOAD_* / CALIBRATION sentence and the NEXT_SET lines above "
                  "are ALREADY on the owner's screen (one code-posted "
                  "message). Do NOT repeat them; this set owes no reply "
                  "unless the owner asked something." % owner_posted)
        if (idrill_marker or kb_delivered) and owner_posted:
            print("REGISTER footer=none praise=none reply=none_owed -- the "
                  "record line, the next-set line and the keyboard are all "
                  "on the owner's screen by code")
        elif idrill_marker or kb_delivered:
            print("REGISTER footer=none praise=none bullets<=3 -- a keyboard "
                  "is on the row: it IS the ask (record line, <= 3 short "
                  "bullets, the next-set blockquote; nothing after it)")
        # A3/D2: a block the table SAYS this kind owes, and that we did not
        # produce, is a defect the owner must be able to see -- not a gap the
        # turn quietly fills with a sentence. Same discipline as
        # SET_CUE_MISSING (H11) and NEXT_ACTION_MISSING (H17): three declared
        # states, all three reachable.
        #
        # Only on the arming path. --no-arm asked for no blocks, so it is owed
        # none (the same carve-out H17's zero case makes).
        #
        # 2026-08-27: `completion_tap` is NOT a missing reps keyboard. The
        # derivation table's prep row asks for ONE button, and the bridge has no
        # marker for that -- the model authors a single-item [[OPTIONS]] block.
        # So the prep case gets its own POSITIVE instruction rather than falling
        # into the BLOCK_MISSING branch below and being reported as a defect
        # every single drill. The gate stays `_kb == "reps_drilldown"`, which is
        # now false for prep BY TABLE LOOKUP, not by a special case here.
        _prep_posted = any(str(_pt).startswith("PREP_TAP_POSTED")
                           for _pt in (signals.get("prep_tap") or []))
        if _kb == "completion_tap" and (_prep_posted or kb_delivered):
            # CODE-POSTED (2026-10-08): the NEXT item's keyboard is already on
            # the owner's screen -- the next drill's done button, or (after
            # the last drill) the setup rung's -- and a model-authored one
            # would be a second live keyboard for that row.
            # After the LAST entry drill the next item is the lift's first
            # step (setup / ramp rung): code armed it AND posted its
            # completion button, so say which item it is (0.36.0 item 1).
            _next_item = ("the lift's first step" if (set_seq <= PREP_SEQ_BASE
                                                      and prep_next is None)
                          else "the next drill")
            print("NEXT_TAP kind=%s seq=%s keyboard=%s posted=code next=%s -- "
                  "this drill is done. The completion button for %s is "
                  "already on the owner's screen (posted by code): do NOT "
                  "render one. A drill's tap arrives as a message: run that "
                  "drill's PREP_TAP_CMD below."
                  % (_kind, set_seq, _kb,
                     "lift" if _next_item.startswith("the lift") else "drill",
                     _next_item))
            for _pt in (signals.get("prep_tap") or []):
                print(_pt)
        # After the LAST entry drill the next item is the lift's first step,
        # whose keyboard set-arm already armed: no completion button is owed.
        elif _kb == "completion_tap" and not (set_seq <= PREP_SEQ_BASE
                                              and prep_next is None
                                              and idrill_marker):
            print("NEXT_TAP kind=%s seq=%s keyboard=%s -- this drill is done. "
                  "Render ONE completion button (a single-item options block) "
                  "for the NEXT item in the sequence. No rep question, no "
                  "candidate numbers: the "
                  "prescribed value is the recorded value." % (_kind, set_seq, _kb))
            # ...and WHICH item that is, with its prescription and its runnable
            # argv, straight from set-arm. The model relays these rather than
            # composing a call: a composed call is a call that gets skipped
            # under live pressure, which is how a whole prep block once went
            # unlogged.
            for _pt in (signals.get("prep_tap") or []):
                print(_pt)
        for _rl in (signals.get("rung_lines") or []):
            print(_rl)
        # CODE-POSTED (2026-10-08): with the code rail live the reply owes no
        # keyboard at all -- the next row's keyboard is code's (set-start /
        # rung-next / prep-tap, CH2_KB in the channel-2 log; an "already on
        # screen" verdict also reads as kb_delivered), and a logged row owes
        # none. Nothing for this reply to be missing -- unless the next
        # warm-up row's keyboard was owed and code did NOT post it, which is
        # what the KEYBOARD_RELAY backstop below still covers on either rail.
        _kb_owed = (arm and not idrill_marker and not kb_delivered
                    and _kb == "reps_drilldown")
        if _kb_owed and signals.get("kb_rail") != "code":
            _arming_off = not os.path.exists(DGN918_FLAG)
            print("BLOCK_MISSING kind=%s slot=keyboard expected=%s%s -- the "
                  "derivation table says a %s set takes the reps keyboard and "
                  "none was produced. The set IS logged. Say so plainly; do "
                  "NOT substitute a numbered menu or an input instruction."
                  % (_kind, _kb, " reason=arming_off" if _arming_off else "",
                     _kind))
            print("WARN: no keyboard for a %s row (set_seq=%s) that the table "
                  "says owes one%s" % (
                      _kind, set_seq,
                      " -- set keyboards are OFF on this install (%s is "
                      "missing; routines/bundle/health-install-ensure.sh "
                      "seeds it)" % DGN918_FLAG if _arming_off else ""),
                  file=sys.stderr)
        if _kb_owed:
            # hotfix 0.34.x (live 2026-10-08: "the warm-up sets show no button"),
            # kept as the FAILURE BACKSTOP of the code rail: a warm-up row whose
            # code keyboard did not land still gets buttons -- the bridge's own
            # [[OPTIONS: ...]] marker, printed here as ONE literal line so the
            # reply carries it verbatim. A tap sends the label back as text;
            # the turn then runs RUNG_SET_CMD.
            _relay = rung_options_block(signals.get("rung_lines") or [])
            if _relay:
                print("KEYBOARD_RELAY (echo the next line VERBATIM as the last "
                      "line of the reply, alone; then on the tap run the "
                      "RUNG_SET_CMD line above):")
                print(_relay)
        # F19/F33 + 41-5 hold-class force-a-button: surface the order to render a
        # tappable completion/next [[OPTIONS]] block in the IN-SESSION reply (a
        # hold END is a plain push with no inline button, so the owner is
        # otherwise stranded). Present only when set-arm flagged this set as
        # hold-class. 41-5: the value is now the POSITION-CORRECT button LABEL
        # (다음 세트 / 다음(진행) / 완료) -- the model renders exactly that button.
        # H17 (owner live 2026-08-24): the 2026-08-22 carrier below used to
        # print `1. <label>` + `[[OPTIONS]]` UNCONDITIONALLY. It fixed being
        # stranded but created a worse one: a menu with a single item, i.e. a
        # confirmation tap demanded for a step that should just proceed on its
        # own. And because options.py promotes a numbered list
        # only at >= 2 items, that one-item block never became a button anyway;
        # it degraded to the literal "선택: 1. 다음(진행)" they read.
        #
        # set-arm resolves exactly ONE position-correct label (hold_next_label:
        # 다음 세트 / 다음(진행) / 완료), so the candidate list here is a
        # one-element list BY CONSTRUCTION -- which is precisely why it must be
        # counted rather than assumed. next_action_block() keeps the three
        # counts as three outcomes; the zero case is a real, separate bug and is
        # NOT folded into the one case. 41-5's guarantee survives intact: the
        # action is still NAMED on every hold/transition arm, so the owner is
        # never stranded -- they are just no longer asked to tap to confirm a
        # non-choice.
        #
        # D2 (2026-08-24 preflight): the zero case above was UNREACHABLE in
        # production. This was the only call site, it sat behind `if hold_next:`,
        # and the argument was always `[hold_next]` -- so the list was always
        # exactly one and NEXT_ACTION_MISSING could only be produced by a unit
        # test calling the function directly. Meanwhile the situation the zero
        # case exists FOR -- arming failed, set-arm crashed, nothing came back --
        # made `hold_next` None, which made this whole block evaporate. The set
        # landed and the owner was told nothing about what happens next: a silent
        # no-op, which is the exact failure H17 was written to abolish. H17 had
        # three declared states and only two of them existed.
        #
        # The missing input was never the count, it was WHETHER A FORWARD ACTION
        # WAS OWED. It is owed whenever we asked set-arm for one: a successful
        # arm always comes back with at least one forward affordance -- a
        # hold-class button label, an armed rest, or a next-step hint (session
        # end included, which returns the explicit string "NONE" and is therefore
        # an answer, not a silence). All three absent after `--arm` means the arm
        # produced nothing at all, and that is a bug the owner must see rather
        # than a set that quietly ends the conversation.
        #
        # --no-arm is deliberately NOT this case. Nothing was asked for, so
        # nothing is owed; an operator who suppressed arming is not owed a defect
        # report about arming.
        _forward_owed = bool(arm)
        _forward_have = bool(hold_next or rest_armed or next_hint)
        if hold_next:
            print("HOLD_NEXT: %s" % hold_next)
            for _action_line in next_action_block([hold_next])["stdout"]:
                print(_action_line)
        elif _forward_owed and not _forward_have:
            # The zero case, now reachable from the situation it describes.
            # It does NOT auto-advance and it does not invent a destination --
            # advancing to an unnamed step is how a session walks off a cliff.
            print("WARN: arming returned no forward action at all "
                  "(hold_next/rest_armed/next_hint all absent) -- the set IS "
                  "logged; the next step is unresolved", file=sys.stderr)
            for _action_line in next_action_block([])["stdout"]:
                print(_action_line)
        # #23 between-set rest determinism (owner live 2026-08-19): when a HOLD/iso
        # continuation logs, set-arm armed a real between-set rest (countdown +
        # markers + rest-over push, same as a working set). Re-surface it so the
        # model does NOT skip straight to the next hold press-start: the rest is
        # already firing via THIS set-done path -- the model presents the armed
        # rest, and only after it starts the next hold set's countdown. Only for
        # a hold continuation (hold_next present AND a real rest armed); working
        # sets already flow through the rest push, and a transition prints NONE.
        if hold_next and rest_armed and rest_armed != "NONE":
            _sec = rest_armed.split("\t", 1)[0]
            print("REST_ARMED: %s초 (홀드 세트 간 휴식 -- 다음 홀드 시작 전 대기)"
                  % _sec)
        # F16 exercise-completion gate: the completed set was the exercise's last
        # working set -> emit a deterministic line so the model is FORCED to
        # render the completion set-table (all-done grid, on-demand from
        # workout_sets) for the owner's review. Mirrors the SET_TABLE_MISSING
        # entry gate; never blocks the logged set.
        if table_complete:
            print("SET_TABLE_COMPLETE %s %s" % (session_id, table_complete))
            print("WARN: %s finished -- run set-table now and post the completion "
                  "table before the next reply (F16 gate)" % table_complete,
                  file=sys.stderr)
            # Owner spec 2026-09-11: the exercise-transition SEQUENCE (finished
            # table -> wrap-up -> next table -> cue -> buttons) is carried by
            # code, on this beat. Only on the arming path -- the data-only
            # backfill (arm=False / --no-arm) owns its own beats.
            if arm:
                _transition_deferred(db_path, program_path, session_id,
                                     table_complete)
        return 0
    finally:
        conn.close()


def main(argv=None):
    _argv = sys.argv[1:] if argv is None else list(argv)
    if _argv and _argv[0] == TRANSITION_RUN_VERB:
        return _transition_run(_argv[1:])
    p = argparse.ArgumentParser(
        prog="set-add",
        description="Live per-set writer -- direct UPSERT into workout_sets "
                    "(B5/C2).",
    )
    p.add_argument("session_id", type=int, help="workouts.id (must exist)")
    p.add_argument("exercise_name", help="program.yaml slot name (snake_case)")
    p.add_argument("slot_num", type=_slot_arg,
                   help="program.yaml slot number (1-based), or `session` for "
                        "a session-level row (stored NULL, kit 061)")
    p.add_argument("set_seq", type=int,
                   help="set order (>=1 working; 0=bw primer; -N=ramp N)")
    p.add_argument("reps", type=_reps_arg, nargs="?", default=None,
                   help="reps completed. A prep/ramp row may omit it or pass "
                        "`done` (a done-tap, stored NULL on a kit-061 DB; "
                        "--target-reps keeps the prescription)")
    p.add_argument("--machine", dest="machine_ref", default=None,
                   help="ax_machine ulid this set was done on (kit 062). "
                        "Omitted on a machine lift -> this session's choice "
                        "(machine-pick), else NULL")
    p.add_argument("--drill-code", dest="drill_code", default=None,
                   help="prep.yaml drill code a prep row performed (kit 061; "
                        "the key its observed load is read back by)")
    p.add_argument("--weight", type=float, default=None,
                   help="working weight kg. EXPLICIT ALWAYS WINS. Omitted on a "
                        "working set (set_seq>=1) -> resolved from the live "
                        "armed prescription in .idrill-arm/; if none is found "
                        "AND the lift is plate-loaded the write is REFUSED "
                        "(exit 1 + WEIGHT_MISSING) instead of storing NULL. "
                        "Omit freely for a genuine bodyweight/calibration set "
                        "or any ramp/primer row (set_seq<=0) -- NULL is kept.")
    p.add_argument("--addon", default=None,
                   help="an add-on block stacked on the machine pin: its kg "
                        "(added to --weight, the pin) or 'unknown' (the row "
                        "is stored at the pin weight and flagged; ask once "
                        "for the number on the block, then machine-pick "
                        "--addon <kg> fixes the flagged rows)")
    p.add_argument("--rir", type=int, default=None,
                   help="reps-in-reserve (omit if not reported, NULL)")
    # 2026-08-27: the kind and the prescription are STORED, not just derived.
    p.add_argument("--set-kind", dest="set_kind", default=None,
                   choices=["prep", "ramp", "working", "hold"],
                   help="workout_sets.set_kind. Omitted -> DERIVED from set_seq "
                        "via set-table's derivation table (>=1 working, "
                        "0..-99 ramp, <=-100 prep). State it explicitly for a "
                        "hold, which a sequence number cannot express.")
    p.add_argument("--target-reps", dest="target_reps", type=int, default=None,
                   help="the PRESCRIBED value for this row, in the drill's own "
                        "unit (prep.yaml target_unit: reps / per_side / rounds "
                        "/ hold_sets). A prep completion tap records the "
                        "prescription; do NOT convert a round or hold-set count "
                        "into reps.")
    p.add_argument("--hold-sec", dest="hold_sec", type=int, default=None,
                   help="prescribed hold duration in seconds (prep.yaml "
                        "hold_sec). Omit when the drill is untimed.")
    p.add_argument("--raw", default=None, help="original utterance (audit)")
    p.add_argument("--db", default=DEFAULT_DB, help="path to kit_life.db")
    p.add_argument("--program", default=DEFAULT_PROGRAM,
                   help="path to program.yaml (SoT for the #34/#37 auto-enter "
                        "recovery on a dropped exercise entry)")
    # C12 rest-timer arming passthrough (all optional -- arming is automatic).
    p.add_argument("--next", dest="next_spec", default=None,
                   help="next-set spec text for the set-start push")
    p.add_argument("--tip", default=None, help="30s-marker form tip (carve-out)")
    p.add_argument("--tip60", default=None, help="60s-marker extra line")
    p.add_argument("--no-next", action="store_true",
                   help="session end / exercise stopped early: suppress the "
                        "ENTIRE inter-set rest stack -- countdown, "
                        "before-markers and the set-start push (C12-B)")
    # F19/F21 target-change re-arm passthrough. On a SUBSTITUTION (F19) the model
    # writes this set with the substitute's display/weight/reps/rir override so
    # the re-fired push + set-table carry the new target; on a WEIGHT ADJUST
    # (F21) it passes --ov-weight alone. --ov-clear reverts to the derivation.
    p.add_argument("--ov-display", default=None,
                   help="F19/F21: override display name (substitution)")
    p.add_argument("--ov-weight", type=float, default=None,
                   help="F19/F21: override target weight kg (weight adjust)")
    p.add_argument("--ov-reps", default=None,
                   help="F19/F21: override target reps")
    p.add_argument("--ov-rir", default=None, help="F19/F21: override target RIR")
    p.add_argument("--ov-clear", action="store_true",
                   help="F19/F21: clear a prior override for this exercise")
    # P2 (2026-08-24): --ov-weight is a progression decision. See set-arm
    # gate_weight_override(); these two args are the reason and the author.
    p.add_argument("--ov-reason", default=None,
                   help="P2: one line for why this weight differs from the "
                        "engine verdict. Without it a move to the HARDER side "
                        "is not served -- the gate takes the lower side.")
    p.add_argument("--ov-by", default=None, choices=["coach", "owner"],
                   help="P2: whose call this weight is (default coach = the agent's "
                        "own judgement; 'owner' is never clamped)")
    # SET-SEQ COLLISION gate (2026-08-21). The ONLY signal that a write is meant
    # to REPLACE an existing row. Without it, a write whose measurements differ
    # from the row already at (session, exercise, set_seq) is REFUSED instead of
    # overwriting it. An EXPLICIT flag and not a heuristic on the existing
    # --ov-* flags: those are set-arm TARGET overrides (they re-aim the next
    # push / set-table for the exercise) and are passed on perfectly ordinary
    # first-time writes -- reading them as "this is a correction" would leave
    # exactly the hole the gate closes. See the module docstring.
    p.add_argument("--correct", action="store_true",
                   help="this write CORRECTS the row already at this set_seq "
                        "-- overwrite it. Required whenever the values differ "
                        "from the stored row; without it the write is refused "
                        "(SET_SEQ_OCCUPIED) so a count desync cannot destroy a "
                        "logged set. Not needed for an identical re-fire.")
    p.add_argument("--no-arm", action="store_true",
                   help="do NOT arm a timer (corrections / bulk backfill)")
    p.add_argument("--arm-dry-run", action="store_true",
                   help="forward --dry-run to set-arm (tests: no real push)")
    args = p.parse_args(argv)

    # F11: reps is REQUIRED for EVERY row. workout_sets.reps is NOT NULL, and
    # kit_life is a versioned schema we do NOT migrate for this -- so a missing
    # reps value can never be stored. The earlier F7 "optional for set_seq<=0"
    # help text contradicted the schema and made ramp/primer writes crash on the
    # NOT NULL constraint. A warmup/ramp/primer set always has a real rep count
    # the owner performed, so requiring it is both correct and non-lossy (never
    # invent a placeholder into a data column). Fail fast with a clear message.
    #
    # 2026-08-27 CARVE-OUT, PREP ONLY. A prep row is a COMPLETION, not a
    # measurement: the ruling is that its recorded value is its prescribed value,
    # so there is nothing to "pass the actual reps performed" for and asking is
    # the behaviour being removed. `reps` is still NOT NULL, so the row still
    # needs a number -- it takes --target-reps when prep.yaml states one, and
    # PREP_UNPRESCRIBED_REPS (0, meaning "completed; no count was ever
    # prescribed") when it does not. It cannot reach a volume aggregate: every
    # one of those filters is `set_seq >= 1` and the prep band is <= -100.
    # This carve-out does NOT extend to ramp: a rung IS performed to a count.
    # 2026-09-30 (kit 061): on a DB that carries 061 a prep OR ramp row with
    # no counted reps is stored with reps NULL -- the done-tap: reached as
    # prescribed, not counted; target_reps keeps the prescription. The kit's
    # trigger still refuses a working/hold row without reps. On a pre-061 DB
    # the 2026-08-27 carve-out above stands unchanged (prep only).
    kind_now = args.set_kind or (
        "prep" if args.set_seq <= PREP_SEQ_BASE
        else ("ramp" if args.set_seq <= 0 else None))
    uncounted_ok = False
    if args.reps is None and kind_now in ("prep", "ramp"):
        try:
            _c = _db_connect(os.path.abspath(args.db))
            try:
                uncounted_ok = _kit_allows_uncounted(_c)
            finally:
                _c.close()
        except sqlite3.Error:
            uncounted_ok = False
    if args.reps is None and not uncounted_ok:
        if kind_now == "prep":
            args.reps = (args.target_reps if args.target_reps is not None
                         else _prep_unprescribed_reps())
        else:
            kind = ("working set" if args.set_seq >= 1
                    else "warmup/ramp/primer row")
            print("ERROR: reps required for every row incl. this %s "
                  "(workout_sets.reps is NOT NULL) -- pass the actual reps "
                  "performed" % kind, file=sys.stderr)
            return 1

    db_path = os.path.abspath(args.db)
    if not os.path.exists(db_path):
        print("ERROR: db not found: %s" % db_path, file=sys.stderr)
        return 1
    if not args.correct:
        _sk_rc = _check_seq_kind(db_path, os.path.abspath(args.program),
                                 args.session_id, args.exercise_name,
                                 args.set_seq, args.set_kind)
        if _sk_rc is not None:
            return _sk_rc

    arm_opts = {
        "next_spec": args.next_spec,
        "tip": args.tip,
        "tip60": args.tip60,
        "no_next": args.no_next,
        "arm_dry_run": args.arm_dry_run,
        # F19/F21 target-change re-arm passthrough.
        "ov_display": args.ov_display,
        "ov_weight": args.ov_weight,
        "ov_reps": args.ov_reps,
        "ov_rir": args.ov_rir,
        "ov_clear": args.ov_clear,
        # P2: the progression decision's reason + author.
        "ov_reason": args.ov_reason,
        "ov_by": args.ov_by,
    }
    # F8 (RESTATED 2026-08-21): warmup/primer/ramp rows (set_seq<=0) NEVER arm a
    # rest timer or fire a set-start alert. That invariant is UNCHANGED -- what
    # changed is WHERE it is enforced. It used to live here, as `set_seq >= 1`,
    # which switched off the whole set-arm call and therefore also cost a rung
    # its KEYBOARD: a ramp rung could not be tapped in at all, and the engine's
    # "다음은 60kg 5회 램프 세트예요" prose had no arm behind it. The gate now
    # lives INSIDE set-arm (its RUNG MODE), which arms the rung's one-tap reps
    # keyboard and skips every rest side effect -- countdown, before-markers,
    # set-start push, water mark, generation bump. See set-arm `is_rung`.
    return do_add(db_path, args.session_id, args.exercise_name, args.slot_num,
                  args.set_seq, args.reps, args.weight, args.rir, args.raw,
                  arm=(not args.no_arm), arm_opts=arm_opts,
                  program_path=os.path.abspath(args.program),
                  correct=args.correct, set_kind=args.set_kind,
                  target_reps=args.target_reps, hold_sec=args.hold_sec,
                  drill_code=args.drill_code, machine_ref=args.machine_ref,
                  addon=args.addon)


if __name__ == "__main__":
    sys.exit(main())
