def _rir_floor(program_path, exercise_name):
    """program.yaml `rir_floor` (G19 compound-freeweight safety cap) for this
    exercise as an int, or None when the slot declares none.

    The floor's roster and rationale live in ONE place, workout-program/SKILL.md
    "복합 프리웨이트 RIR 하한 정책 (G19)"; this function does not re-derive them,
    it only reads what that roster stamped onto the slot.

    Best-effort: any miss / malformed value -> None, which degrades to "no breach
    check for this lift". A floor lookup must never break or block a logged set
    -- the set is the owner's data, the flag is only commentary on it."""
    try:
        val = (_program_slot(program_path, exercise_name) or {}).get("rir_floor")
        if isinstance(val, bool) or val is None:
            return None
        return int(val)
    except (TypeError, ValueError):
        return None
    except Exception:      # noqa: BLE001 -- a flag miss must never break a set
        return None


def _is_plate_loaded(db_path, program_path, exercise_name):
    """PART 1 gate: True iff this lift is a BAR + PLATES lift.

    Thin delegation to the SHARED pack SoT ax_engine.is_plate_loaded --
    the SAME predicate set-table's bar-primer disambiguator and set-arm's plate
    cue already call. Deliberately NOT a second definition: a genuine bodyweight
    movement (wall_sit / leg_raise), a machine or stack lift (leg_curl, v_squat,
    chinup), a cable, a fixed dumbbell, and any unmapped lift all return False
    there, so their NULL weight stays legal and untouched.

    Best-effort: any error -> False. A gate that cannot decide must let the set
    through -- refusing on a broken import would be worse than the bug. A
    STRUCTURALLY absent engine is not silent though: load_ax_engine() writes one
    AX-ENGINE-MISSING line to stderr before this handler swallows the miss (see
    _announce_ax_engine_missing for why that line is stderr and not a raise)."""
    try:
        return bool(ax_engine().is_plate_loaded(
            db_path, exercise_name,
            _lattice_type(program_path, exercise_name)))
    except Exception:      # noqa: BLE001 -- gate must never break the write
        return False


