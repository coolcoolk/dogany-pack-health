_WS_COLUMNS = None


def _workout_sets_columns(conn):
    """The column names workout_sets actually has, memoized per process.

    Migration 034 (set_kind / target_reps / hold_sec) may or may not be applied
    on the DB this call is pointed at -- a test fixture or a restored backup can
    predate it. A write that raises OperationalError on a missing column is a
