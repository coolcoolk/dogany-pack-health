# Fallback grids already on set-add's stdout this beat (see _publish_table).
_FALLBACK_ON_STDOUT = []
_TABLE_FALLBACK_MARK = "SET_TABLE fallback=defenced"


def _fallback_grid(text):
    """The de-fenced grid rows after a fallback marker, or None."""
    if _TABLE_FALLBACK_MARK not in (text or ""):
        return None
    tail = text.split(_TABLE_FALLBACK_MARK, 1)[1]
    return tuple(ln for ln in tail.splitlines() if ln.startswith("|"))


def _publish_table(db_path, program_path, session_id, exercise_name):
    """THE PER-SET (2) SET-TABLE BEAT. Delegates to
    `exercise-enter --publish-table`, which re-renders the table from live state
    and DELIVERS it to the owner as its own message.

    WHY IT IS HERE, next to _refresh_card and not in a document: the table had
    no deterministic carrier at all. It was rendered by code and POSTED BY THE
    MODEL, and over one measured live session that produced 5 table sends --
    every one of them at exercise entry, none between sets. The owner said it
    three times in a row and the third time plainly: 「제발 세트마다 표를 내자는
    의미잖아」. A rule asking the model to post one per set is the thing that
    already failed; the set write is the event that never does.

    So the shape is _refresh_card's, exactly, and for the same reason: fired
    AFTER the DB commit, in a subprocess, wrapped so that no failure here can
    cost the logged set -- worst case the owner misses one table, never the
    record. Output goes to stderr (audit only) so the SET_LOGGED stdout
    contract the forcing hook keys on is untouched.

    Gate + dedup live on the other side of this call (exercise-enter):
    do_publish_table holds the beat while entry prep is still owed (F14 clause
    2) and claims one delivery per table CONTENT, so this call and a first-set
    auto-enter cannot put two copies of the same table on one screen.

    A FAILED SEND IS THE EXCEPTION (hop map 2026-09-03, rail B): the beat's
    failure receipt and de-fenced fallback rows are ALSO forwarded on stdout,
    after SET_LOGGED, the way _prep_table forwards its table. On stderr alone
    they reached no one. Skipped when the auto-enter forward already put the
    same grid on stdout this beat (one fallback per beat)."""
    try:
        cmd = [EXERCISE_ENTER, str(session_id), exercise_name,
               "--publish-table", "--db", db_path, "--program", program_path]
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
        grid = _fallback_grid(proc.stdout)
        if grid is not None and grid not in _FALLBACK_ON_STDOUT:
            _FALLBACK_ON_STDOUT.append(grid)
            lines = proc.stdout.rstrip().splitlines()
            start = next((i for i, ln in enumerate(lines)
                          if ln.startswith("SET_TABLE delivered=no")), 0)
            print("\n".join(lines[start:]))
        if proc.stdout:
            print(proc.stdout.rstrip(), file=sys.stderr)
        if proc.stderr:
            print(proc.stderr.rstrip(), file=sys.stderr)
    except Exception as e:  # noqa: BLE001 -- publish must never break the write
        print("WARN: set-table publish failed (%s) -- set logged, table NOT "
              "delivered this beat" % e, file=sys.stderr)


