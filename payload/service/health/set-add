)
_AX_WARNED = [False]
_AX = None


def ax_engine_path():
    """Absolute path to the ax_engine.py this tree should import, or the LIVE
    candidate when neither exists (so the error names the historical path)."""
    for parts in _AX_ENGINE_CANDIDATES:
        cand = os.path.abspath(os.path.join(SCRIPT_DIR, *parts))
        if os.path.exists(cand):
            return cand
    return os.path.abspath(os.path.join(SCRIPT_DIR,
                                        *_AX_ENGINE_CANDIDATES[-1]))


def _announce_ax_engine_missing(exc):
    """ONE stderr line, ONCE per process, when the engine will not load.

    SILENT-VS-LOUD (audit 2026-09-12 2.1). Two failure classes were being
    collapsed into one `except Exception`:
      * a PER-CALL miss -- unmapped lift, DB row absent, bad argument. Genuinely
        best-effort: degrade to False and say nothing. That is correct and
        stays.
      * a STRUCTURAL absence -- the engine file is not where any caller can see
        it. That is an INSTALL defect. It is total, it affects every answer, it
        never self-heals, and it is the one an owner cannot report because the
        product looks normal without it.
    The second class is now announced. It is announced on STDERR and NOT to the
    owner, and it does NOT raise: a live set write must never die to prove a
    configuration point, and a broken-install banner on a mid-workout push is
    noise the owner cannot act on between sets. The durable detector is the
    test (tests/test-backport-round5-ax-engine.py K13), which fails the pack
    before it ships; this line is the runtime backstop for a tree that shipped
    anyway."""
    if _AX_WARNED[0]:
        return
    _AX_WARNED[0] = True
    probed = ", ".join(os.path.abspath(os.path.join(SCRIPT_DIR, *p))
                       for p in _AX_ENGINE_CANDIDATES)
    sys.stderr.write(
        "[set-add] AX-ENGINE-MISSING: ax_engine.py did not load (%s). Every "
        "bar/plate decision in this process degrades to \"not a bar\". "
        "probed: %s\n" % (exc, probed))


def load_ax_engine():
    """Import the pack engine ax_engine.py as a module. Same lazy importlib
    pattern set-table uses; ax_engine does no module-level work (its kit_life /
    DB access is all lazy), so import has no side effects."""
    path = ax_engine_path()
    try:
        spec = importlib.util.spec_from_file_location("ax_engine", path)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
    except Exception as exc:      # noqa: BLE001 -- announce, then re-raise
        _announce_ax_engine_missing(exc)
        raise
    return mod


def ax_engine():
    global _AX
    if _AX is None:
        _AX = load_ax_engine()
    return _AX
