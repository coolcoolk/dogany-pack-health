# THE RUNG CEILING AT THE WRITE BOUNDARY (2026-09-11, incident A).
#
# MEASURED, session 10103, standing_calf_raise:
#     set_seq -1   115.0kg   <- written here, 08:28
#     set_seq  1   115.0kg
#     set_seq  2   115.0kg
#     set_seq  3   115.0kg
# and, on the same lift three weeks earlier, the shape a warm-up actually has:
#     set_seq -1    75.0kg   /   set_seq 1-3   105.0kg
#
# 115 was never a rung any code path computed -- set-table.ramp_decision, handed
# 115, plans 세팅 55 / 웜업 75 / 웜업 95. It arrived as `--weight 115` on a
# set_seq -1 call, and this file had no opinion about that: every ceiling check
# in the system compares a rung against an argument the PLANNER was handed, and
# on the write path there is no planner and no argument.
#
# So the ceiling gets its third and last checkpoint here, where the number stops
# being a claim and becomes a record.
#
# WHY THIS ONE REFUSES. The general rule in this file is that a set the owner
# has already performed is never destroyed over a disagreement -- that is why
# the missing-weight gate ASKS and why the collision gate refuses rather than
# overwrites. A rung is the one row where refusal is clearly right:
#   * its weight is 100% code-prescribed. The owner taps a keyboard whose prompt
#     already names the rung and its load; they never type a warm-up weight;
#   * a rung AT the working load is not a warm-up under any reading. Recording
#     it as one corrupts the very history the next session's ladder is planned
#     from -- last_logged is a ramp_basis source, so today's fiction becomes
#     next week's premise;
#   * nothing is lost. The refusal is loud on both streams, carries the reps
#     back, and names the two ways forward (record it as the working set it
#     actually is, or use the planned rung weight).
#
# `--correct` does NOT bypass it. Correcting a rung INTO the working weight is
# the same assertion arriving by a second door.
# ---------------------------------------------------------------------------
def _kg(v):
    """kg verbatim -- SKILL 「무게 소수점 verbatim」 (115.0 -> 115, 21.25 stays
    21.25). Mirrors set-arm._fmt_load_kg; a two-line copy rather than an import
    because this runs on the write path and a lazy sibling import that failed
    there would cost the owner the refusal itself."""
    if v is None:
        return "-"
    try:
        return ("%.2f" % float(v)).rstrip("0").rstrip(".")
    except (TypeError, ValueError):
        return str(v)


def _working_ceiling(conn, session_id, exercise_name):
    """The working load this session's rungs must sit under, or (None, None).

    Returns (weight, source). Two probes, in order:

      1. the ARMED working prescription for this (session, exercise) --
         _resolve_armed_weight's own working-lane probe, which already excludes
         rung arms by payload set_seq. This is the value 표2 and the keyboard are
         showing right now, and it is available BEFORE any working set is
         logged, which is exactly when today's rung was written;
      2. the heaviest WORKING set already logged in this session. A late rung
         (the 2026-08-21 "fill the warm-up in afterwards" shape) has no arm left
         to read, but it does have the sets it was supposedly a warm-up for.

    (None, None) when neither answers -- an unknown ceiling is not a ceiling of
    zero, and this gate fails OPEN in that case (see the caller). Best-effort
    throughout: this runs on the write path of every rung."""
    try:
        w, src = _resolve_armed_weight(session_id, exercise_name, 1)
        if w is not None:
            return float(w), src
    except Exception:      # noqa: BLE001 -- never break a write on a probe
        pass
    try:
        row = conn.execute(
            "SELECT MAX(weight_kg) FROM workout_sets WHERE session_id = ? AND "
            "exercise_name = ? AND set_seq >= 1 AND weight_kg IS NOT NULL",
            (session_id, exercise_name)).fetchone()
        if row and row[0] is not None:
            return float(row[0]), "logged:session"
    except Exception:      # noqa: BLE001
        pass
    return None, None


def _refuse_rung_at_working(exercise_name, set_seq, weight, reps, ceiling,
                            ceiling_src, display=None, db_path=None):
    """The refusal. Nothing is written; nothing the owner reported is lost.

    Same two-stream shape every other set-add refusal uses -- a machine line and
    a finished Korean line on STDOUT (D4), the operator's `ERROR: ` on STDERR --
    so anything already parsing this surface reads it without a new rule.

        RUNG_AT_WORKING exercise=<n> set_seq=<n> weight=<kg> working=<kg> src=<t>
        RUNG_REFUSED: <한국어 한 문장>
    """
    print("RUNG_AT_WORKING exercise=%s set_seq=%s weight=%s working=%s src=%s"
          % (exercise_name, set_seq, weight, ceiling, ceiling_src or "none"))
    kept = "%s회" % reps
    print("RUNG_REFUSED: ⚠️ %s -- 웜업을 %skg으로 기록하려 했는데 오늘 워킹 "
          "무게가 %skg입니다. 워킹과 같거나 무거운 건 웜업이 아니라서 기록 "
          "안 했습니다 (%s는 들고 있습니다). 방금 하신 게 워킹세트면 워킹으로 "
          "기록하겠습니다 -- 말씀만 주세요. 웜업이 맞으면 계획된 웜업 무게로 "
          "갑니다."
          % (display or exercise_name, _kg(weight), _kg(ceiling), kept))
    print("ERROR: refusing to write a RAMP RUNG at or above the working load "
          "(%s set_seq=%s weight=%s working=%s src=%s). set-table's "
          "RAMP_R_NO_RUNG rule -- a rung that is not BELOW the working weight "
          "is the working set under another name, and logging it corrupts "
          "last_logged, which is a ramp_basis source for the next session. "
          "NOTHING was written (reps=%s preserved above). Either re-run as a "
          "working set (set_seq >= 1) or use the planned rung weight from "
          "set-table.ramp_decision."
          % (exercise_name, set_seq, weight, ceiling, ceiling_src, reps),
          file=sys.stderr)
    return 1


