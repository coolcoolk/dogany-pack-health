def _row_keyboard_logged(session_id, exercise_name, set_seq):
    """CODE-POSTED KEYBOARDS (2026-10-08): this row was just written, so its
    keyboard (if code posted one) owes nothing any more. TAPPED vs TYPED is
    read off the arm file: the bridge consumes (unlinks) the arm BEFORE it
    fires this set-add, so an absent arm means the tap already turned that
    message into its confirmation; a present arm means the row was typed and
    its buttons are stale -> row_keyboard clears them. Best-effort."""
    try:
        if SCRIPT_DIR not in sys.path:
            sys.path.insert(0, SCRIPT_DIR)
        import row_keyboard
        arm = os.path.join(IDRILL_ARM_DIR,
                           _arm_id(session_id, exercise_name, set_seq))
        tapped = not os.path.exists(arm)
        prev = row_keyboard.on_logged(STATE_DIR, session_id, exercise_name,
                                      set_seq, tapped)
        if prev:
            print("ROW_KEYBOARD closed seq=%s by=%s was=%s"
                  % (set_seq, "tap" if tapped else "text", prev),
                  file=sys.stderr)
    except Exception:  # noqa: BLE001 -- a keyboard never costs a logged set
        pass


def _arm_id(session_id, exercise_name, set_seq):
    """Deterministic 8-char arm id -- a VERBATIM mirror of set-arm.compute_arm_id
    (first 8 of sha256("<sid>|<ex>|<seq>")). Duplicated rather than imported on
    purpose: set-arm is a 124KB module that loads rx-calc at import time, and the
    per-set WRITE path must not take that dependency (nor inherit a transient
    syntax error in a sibling being edited). The key rule is three fields,
    '|'-joined, stringified verbatim -- any change to set-arm.compute_arm_id MUST
    be mirrored here (cross-ref: set-arm compute_arm_id)."""
    key = "%s|%s|%s" % (session_id, exercise_name, set_seq)
    return hashlib.sha256(key.encode("utf-8")).hexdigest()[:8]


def _read_arm_payload(path, session_id, exercise_name, now=None):
    """Read ONE arm file and return (weight, set_seq, mtime), or None when the
    arm must not be trusted for this (session, exercise).

    STALE / DEBRIS EXCLUSION -- every one of these must pass:
      * the file parses as a JSON dict (a half-written arm is rejected; set-arm
        writes atomically via tmp+rename, so this is belt-and-braces);
      * payload session_id == this session_id AND payload exercise_name ==
        this exercise_name. The arm id alone is NOT trusted as identity: the
        payload re-states the triple, so a debris file that ever landed on a
        colliding path (e.g. the synthetic session 9001 arms a 2026-08-21 test
        run left in the live directory) is rejected on its own contents;
      * mtime is not in the future (clock skew / touched file);
      * mtime is within ARM_MAX_AGE_SEC. This is what retires yesterday's arms:
        session 10088's 2026-08-20 arms cannot prescribe a set logged today,
        even though the ids would still resolve;
      * `weight` is a real, finite, strictly-positive number. NULL / 0 / a
        string / NaN / inf all mean "no armed prescription", never a weight.

    Best-effort: ANY error -> None. A lookup miss must never cost a logged set;
    it degrades to the part-1 backstop, which asks the owner."""
    try:
        st = os.stat(path)
    except OSError:
        return None
    try:
        age = (time.time() if now is None else now) - st.st_mtime
        if age < 0 or age > ARM_MAX_AGE_SEC:
            return None
        with open(path, encoding="utf-8") as fh:
            payload = json.load(fh)
        if not isinstance(payload, dict):
            return None
        if str(payload.get("session_id")) != str(session_id):
            return None
        if str(payload.get("exercise_name")) != str(exercise_name):
            return None
        weight = payload.get("weight")
        if isinstance(weight, bool) or not isinstance(weight, (int, float)):
            return None
        weight = float(weight)
        # NaN / +-inf / non-positive are not weights.
        if weight != weight or weight in (float("inf"), float("-inf")):
            return None
        if weight <= 0:
            return None
        try:
            seq = int(payload.get("set_seq"))
        except (TypeError, ValueError):
            seq = None
        return (weight, seq, st.st_mtime)
    except Exception:      # noqa: BLE001 -- a lookup miss must never break a set
        return None


def _resolve_armed_weight(session_id, exercise_name, set_seq):
    """PART 2. Resolve the live armed prescription weight for THIS set, or
    (None, None). Returns (weight, source) where source is an audit token.

    TWO probes, in order:

      1. EXACT KEY -- .idrill-arm/<compute_arm_id(sid, ex, set_seq)>. This is the
         arm the BUTTON path would have fired, so when it exists the text path
         records byte-identically to a tap. Present pre-log for the FIRST working
         set of every exercise (exercise-enter fires `set-arm reps-entry` on
         entry) and for set_seq+1 on the set-start push.

      2. NEWEST SIBLING ARM of the SAME (session_id, exercise_name), any set_seq.
         Probe 1 alone is NOT sufficient and that is not a guess: on the model /
         text path nothing arms set N pre-log for N >= 2 -- set-arm writes the
         same-seq arm only AFTER set N is logged. Verified against the 2026-08-20
         incident: sets 2 and 3 of overhead_press / back_squat / incline_barbell_
         press had no arm at their own key at write time, but their exercise's
         set-1 arm was sitting there carrying the correct 42.5 / 100.0 / 50.0.
         The fallback is sound because the armed WORKING weight is SEQ-INDEPENDENT
         by construction: set-arm.resolve_current_arm_data resolves today's
         rx-calc prescription for the EXERCISE, overlaid with the F19/F21 owner
         override, and that value is the same for every working set of the
         exercise. "Newest" simply picks up a mid-session weight adjust first.

         RUNG ARMS ARE EXCLUDED FROM THIS PROBE (2026-08-21). Since set-arm
         became rung-aware, .idrill-arm/ also holds arms for warm-up primer /
         ramp rungs (set_seq <= 0), and those carry the RUNG's load -- 20kg for
         an empty bar, 40kg for r1. Those weights are seq-SPECIFIC, so adopting
         one for a working set would put a warm-up weight on a working set: the
         mirror image of the incident this whole probe exists to prevent. The
         loop therefore skips any sibling whose payload set_seq is not >= 1.
         (A rung write never reaches here at all: the NULL-weight resolution
         block that calls this function is itself gated on set_seq >= 1.)

    Both probes run the full stale/debris exclusion in _read_arm_payload, so a
    prior session's arm, a foreign exercise's arm, or a synthetic test arm can
    never be adopted. Best-effort throughout: any failure -> (None, None)."""
    try:
        exact = os.path.join(IDRILL_ARM_DIR,
                             _arm_id(session_id, exercise_name, set_seq))
        hit = _read_arm_payload(exact, session_id, exercise_name)
        # The exact-key probe additionally requires the payload's own set_seq to
        # match -- identity is taken from the file's contents, never its name.
        if hit is not None and hit[1] == set_seq:
            return hit[0], "arm:exact"

        best = None
        try:
            names = os.listdir(IDRILL_ARM_DIR)
        except OSError:
            names = []
        for name in names:
            sib = _read_arm_payload(os.path.join(IDRILL_ARM_DIR, name),
                                    session_id, exercise_name)
            if sib is None:
                continue
            # WORKING-LANE ONLY: a rung arm's weight is that rung's, never this
            # working set's (see the docstring). An arm with an unreadable seq
            # is skipped for the same reason -- it cannot be shown to be working.
            if sib[1] is None or sib[1] < 1:
                continue
            if best is None or sib[2] > best[2]:
                best = sib
        if best is not None:
            return best[0], "arm:session-exercise-seq%s" % best[1]
    except Exception:      # noqa: BLE001 -- resolution must never break a set
        pass
    return None, None


def _resolve_prescribed_weight(db_path, program_path, session_id,
                               exercise_name, set_seq):
    """live batch 2 item 4: the weight the TOOL prescribed for this seq, or
    (None, None). Rung lane: the rung's own arm at its exact key, else the
    ladder row (set-arm.resolve_current_arm_data with set_seq). Working lane
    (reached only when no arm exists): today's prescription + override.
    Best-effort; a miss falls back to the existing backstops."""
    try:
        if set_seq <= 0:
            hit = _read_arm_payload(
                os.path.join(IDRILL_ARM_DIR,
                             _arm_id(session_id, exercise_name, set_seq)),
                session_id, exercise_name)
            if hit is not None and hit[1] == set_seq:
                return hit[0], "arm:rung-exact"
        sa = _set_arm_mod()
        if sa is None:
            return None, None
        rx = sa.load_rx_calc()
        override = sa.read_override(session_id, exercise_name)
        _slot, weight, _reps = sa.resolve_current_arm_data(
            rx, program_path, db_path, session_id, exercise_name, override,
            set_seq=set_seq)
        if weight is None:
            return None, None
        weight = float(weight)
        if weight <= 0 or weight != weight:
            return None, None
        return weight, ("rx:rung" if set_seq <= 0 else "rx:prescribed")
    except Exception:  # noqa: BLE001 -- a lookup miss never breaks a set
        return None, None


