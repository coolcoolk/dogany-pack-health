# THE WORKING-LANE DIVERGENCE REPORT (2026-09-11, ruling 3).
#
# The rung gate above REFUSES, because a rung has no owner authorship in it. The
# working lane cannot be refused the same way and that asymmetry is deliberate,
# not a soft spot:
#
#   SKILL 「무게 누락 게이트」 already rules that an explicit `--weight` is
#   reserved for a weight THE OWNER STATED ("사용자가 명시적으로 말한 무게가
#   있을 때만 붙인다"). Under that contract a divergent --weight is, by
#   construction, the owner's own number -- and P2 ruled in the same words that
#   the owner naming a weight is never clamped. A gate that refused it would
#   break the one path the owner actually uses to correct us.
#
# So the working lane gets the OTHER half of the mechanism: the divergence is
# made DURABLE AND VISIBLE at the moment the number becomes a record.
#
#   RX_VIOLATION  ...                     <- machine, A-class, for the ledger
#   RX_DIVERGED: <한국어 한 문장>          <- relayed verbatim, B-class
#
# This is what 「? / ? / ?」 could not do this morning. The 115 was spoken with
# nothing on screen to contradict it; the WT column was blank, so there was no
# second number for the owner to notice was missing. Now the write itself says
# 「코드가 낸 무게는 X인데 Y로 기록했습니다」 in the same message -- a claim the
# owner can reject in one word, on the set it was made about, instead of three
# working sets later.
#
# The set IS written. Refusing here would throw away a set the owner performed
# over a disagreement about its label, which is the trade this file has refused
# to make since the 2026-08-21 nine-lost-sets defect.
# ---------------------------------------------------------------------------
def _rx_source():
    """rx_source.py, or None. Never raises: a missing audit module degrades to
    the pre-2026-09-11 silence, never to a broken write."""
    try:
        import rx_source
        return rx_source
    except Exception:  # noqa: BLE001
        try:
            import importlib.util
            spec = importlib.util.spec_from_file_location(
                "rx_source", os.path.join(SCRIPT_DIR, "rx_source.py"))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            return mod
        except Exception:  # noqa: BLE001
            return None


def _report_weight_divergence(session_id, exercise_name, set_seq, weight,
                              display=None, by=None):
    """Emit the D4 pair when an explicitly-supplied working weight is not the
    one the live arm prescribes. Prints nothing when they agree, when no arm can
    be read, or when the owner is on record as the author (`by`).

    Returns True iff a divergence was reported (for the caller's audit only --
    the write proceeds either way)."""
    rs = _rx_source()
    if rs is None:
        return False
    try:
        armed, armed_src = _resolve_armed_weight(session_id, exercise_name,
                                                 set_seq)
        if armed is None:
            # No armed prescription to compare against. NOT reported as a mint:
            # on the model/text path nothing arms set N for N >= 2, so silence
            # here is ordinary and a violation line would cry wolf every set.
            return False
        rec = rs.issue(weight=(float(armed), rs.S_RX))
        bad = rs.verify(rec, {rs.F_WEIGHT: float(weight)},
                        by=(rs.S_OWNER if by == "owner" else None))
        if not bad:
            return False
        print(rs.violation_line(bad, exercise_name, set_seq)
              + " armed_src=%s" % armed_src)
        print("RX_DIVERGED: %s" % _diverged_say(display or exercise_name,
                                                armed, weight))
        return True
    except Exception:  # noqa: BLE001 -- an audit line never breaks a write
        return False


def _diverged_say(display, armed, written):
    """The ONE owner-facing sentence for a recorded divergence.

    Says what was RECORDED first -- the set is written and pretending otherwise
    would be the second falsehood -- then the code value it differs from, then
    the one word that reverses it. No choice menu (the P2 banned shape)."""
    return ("%s -- %skg으로 기록했습니다. 코드가 낸 오늘 무게는 %skg입니다. "
            "제가 정한 게 아니라 들어온 값 그대로 적은 겁니다 -- 틀렸으면 "
            "말씀만 주시면 바로 정정합니다."
            % (display, _kg(written), _kg(armed)))


# ---------------------------------------------------------------------------
# PROGRAM.YAML SLOT READS -- parsed, not scanned (2026-09-12, S1 fix).
#
# The three helpers below (`_slot_display`, `_lattice_type`, `_rir_floor`) each
# used to scan program.yaml LINE BY LINE with its own regex. `_lattice_type`'s
# was anchored on the INLINE FLOW form:
#
#     re.match(r"^\s+lattice:\s*\{\s*type:\s*([A-Za-z0-9_]+)", line)
#
# so `lattice: {type: even}` read and the equally-valid BLOCK form
#
#     lattice:
#       type: even
#
# did not -- it returned None. program.yaml is HAND-AUTHORED by the owner and
# block form is the ordinary way a person writes YAML, so this was not a
# hypothetical. A None here degrades is_plate_loaded to signal (1) alone, which
# calls incline_dumbbell_press compound+freeweight and therefore A BAR: the
# owner gets told "바 20kg + 양쪽 4kg" for a lift that has no bar. That is the
# #39-B defect, re-entered through the parser instead of through the gate.
#
# WHY THE SCANNERS EXISTED, AND WHY THAT REASON DOES NOT HOLD. Their docstrings
# gave two grounds: (a) "PyYAML is not assumed present in this runtime" and
# (b) "importing the 2600-line rx-calc into the per-set WRITE path is exactly
# the coupling set-add avoids".
#   (a) is about PyYAML and was never about rx-calc: `rx-calc.load_yaml` is
#       ITSELF the stdlib-only hand-rolled loader written for that constraint.
#       Using it adds no dependency -- it IS the answer to (a).
#   (b) measured: exec_module("rx-calc") is 0.4-4.3 ms, against a ~20 ms python
#       interpreter start that set-add already pays. And set-add ALREADY loads
#       rx-calc transitively (`sa.load_rx_calc()` on the transition and ladder
#       paths). What (b) really guards is set-ADD not importing set-ARM (124KB,
#       and a transient syntax error in a sibling under edit would take the
#       write path down with it) -- that guard is kept: this loads rx-calc
#       DIRECTLY, exactly as `lattice-set` already does, never through set-arm.
#
# The fleet's other two readers of this key were never affected, because they
# were already reading a PARSED slot: `set-arm._lattice_type_of(slot)` and
# `set-table._is_bar_primer_exercise(..., slot)`. This makes set-add the third
# reader of ONE parse instead of the one holdout with a private grammar.
#
# The parse is memoized on (path, mtime_ns, size) -- the same key `load_prep`
# uses -- so three helpers on one set-add invocation cost ONE read, where the
# scanners cost three full file walks. An edit invalidates on the next call.
# ---------------------------------------------------------------------------
_RX_CALC = None
_SLOT_CACHE = {}


def rx_calc():
    """rx-calc imported as a module (memoized), or None.

    Same lazy importlib shape as ax_engine() above and as lattice-set's
    _load_rx_calc. rx-calc guards its CLI behind `if __name__ == '__main__'`,
    so import has no side effects. Never raises: a tree without a sibling
    rx-calc degrades to "no slot data", which is the scanners' own miss case."""
    global _RX_CALC
    if _RX_CALC is None:
        try:
            path = os.path.join(SCRIPT_DIR, "rx-calc")
            spec = importlib.util.spec_from_loader(
                "rx_calc",
                importlib.machinery.SourceFileLoader("rx_calc", path))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            _RX_CALC = mod
        except Exception:  # noqa: BLE001 -- absent loader -> no slot data
            _RX_CALC = False
    return _RX_CALC or None


def _program_slot(program_path, exercise_name):
    """The parsed program.yaml slot dict whose `name` == exercise_name, or None.

    NO DAY RESOLUTION, deliberately -- the three fields read off this slot
    (`display`, `lattice`, `rir_floor`) all describe the LIFT, not the session:
    the Korean name, the EQUIPMENT grid and the G19 stabilizer-failure floor are
    identical on every day that programs the exercise (verified over the whole
    file, 2026-08-21). First match wins, which is what the line scanners did.

    Best-effort: a missing / unparseable file -> None, and every caller's
    documented miss behaviour is unchanged."""
    rx = rx_calc()
    if rx is None:
        return None
    try:
        st = os.stat(program_path)
        key = (st.st_mtime_ns, st.st_size)
    except OSError:
        return None
    hit = _SLOT_CACHE.get(program_path)
    if hit is None or hit[0] != key:
        try:
            program = rx.load_yaml(program_path)
        except Exception:  # noqa: BLE001 -- a bad edit degrades, never crashes
            program = None
        slots = {}
        days = (program or {}).get("days") if isinstance(program, dict) else None
        for _day, day_plan in (days or {}).items():
            if not isinstance(day_plan, dict):
                continue
            for ex in (day_plan.get("exercises") or []):
                if not isinstance(ex, dict):
                    continue
                name = ex.get("name")
                if name is not None and name not in slots:
                    slots[str(name)] = ex
        hit = (key, slots)
        _SLOT_CACHE[program_path] = hit
    return hit[1].get(str(exercise_name))


def _slot_display(program_path, exercise_name):
    """program.yaml `display:` (the Korean lift name) for this exercise, or None.
    Used ONLY to make the owner-facing missing-weight ask readable -- "루마니안
    데드리프트 1세트" instead of "rdl 1세트". Any miss -> None and the caller
    falls back to the canonical snake_case name (never blocks, never invents)."""
    try:
        slot = _program_slot(program_path, exercise_name)
        val = (slot or {}).get("display")
        return val if isinstance(val, str) and val else None
    except Exception:      # noqa: BLE001 -- a label miss must never break a set
        return None


def _lattice_type(program_path, exercise_name):
    """program.yaml `lattice.type` for this exercise, or None.

    This is signal (2) of the shared is_plate_loaded gate -- the one that keeps a
    FIXED DUMBBELL press (`type: even`) out of the barbell class even though
    ax_exercise calls it compound+freeweight.

    Reads the PARSED slot, so the inline flow form and the block form are the
    same answer (see the header above: the old regex read only the first, and a
    block-form dumbbell press was classified as a barbell). Identical extraction
    to set-arm._lattice_type_of and set-table._is_bar_primer_exercise -- one key,
    three readers, no private grammar.

    Best-effort: any miss -> None, which degrades is_plate_loaded to signal (1)
    alone -- its own documented degraded form."""
    try:
        lat = (_program_slot(program_path, exercise_name) or {}).get("lattice")
        if not isinstance(lat, dict):
            return None
        val = lat.get("type")
        return None if val is None else str(val)
    except Exception:      # noqa: BLE001 -- a gate miss must never break a set
        return None


