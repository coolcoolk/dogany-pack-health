def _run_step(cmd, wait_sec):
    """Run a DELIVERY-CARRYING child (set-arm, exercise-enter): past `wait_sec`
    set-add stops WAITING and takes what the child printed so far; the child
    is never killed and finishes its owner pushes.

    WHY (2026-10-06, test-plate-machine-cue M4/P15 under 16 busy loops on 8
    cores). subprocess.run(timeout=30) KILLED the child and dropped its stdout:
    M4 -- the auto-enter's machine ask was already pushed, the kill lost its
    `MACHINE_ASK delivered=yes by=code` receipt (a model turn would ask again);
    P15 -- the rung tap's set-arm died before it spawned the next rung's
    keyboard (set logged, BLOCK_MISSING, owner stranded).
    Output goes to anonymous temp files (an abandoned child never dies on a
    closed pipe), the child runs unbuffered (every printed line is readable at
    the deadline), and os.pread leaves the file offset the child writes at
    alone. Same shape in exercise-enter._run_step -- inlined in both: a sibling
    module would break every suite that copies a hand-listed engine."""
    env = dict(os.environ, PYTHONUNBUFFERED="1")
    with tempfile.TemporaryFile() as out, tempfile.TemporaryFile() as err:
        proc = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=out,
                                stderr=err, env=env)
        try:
            proc.wait(timeout=wait_sec)
        except subprocess.TimeoutExpired:
            print("WARN: %s still running after %ss -- not killed (it carries "
                  "owner pushes); forwarding the output it printed so far"
                  % (os.path.basename(cmd[0]), wait_sec), file=sys.stderr)

        def _read(fh):
            size = os.fstat(fh.fileno()).st_size
            return os.pread(fh.fileno(), size, 0).decode(
                "utf-8", errors="replace") if size else ""
        return subprocess.CompletedProcess(cmd, proc.returncode, _read(out),
                                           _read(err))


def _auto_enter(db_path, program_path, session_id, exercise_name):
    """#34/#37 TRUE determinism: server-side auto-fire of exercise-enter when the
    exercise was entered WITHOUT the entry forcing point having run.

    Root problem this closes: exercise-enter is the deterministic per-exercise
    entry primitive (표2 set-table publish + 표3 pinned card + CONFIRMED_SETTINGS
    / RECORD_PARAMS / ANCHOR), but it was MODEL-INVOKED at entry -- so on a
    JIT-registered / prep-laden exercise (e.g. v_squat) the model kept dropping
    the call under live pressure and the whole entry payload went missing
    (#34 표2 미제공 / #37 표3 핀 미동작). The reliable, model-independent event
    on EVERY exercise is the first per-set write. So set-add makes the entry
    payload STRUCTURAL: on the first working set of an exercise whose entry table
    was never published, it fires exercise-enter itself, server-side, before the
    SET_TABLE_MISSING signal -- the entry work lands via code even when the model
    forgot to call exercise-enter at entry.

    REUSE (no rebuild -- climb the ladder): this simply invokes the EXISTING
    exercise-enter primitive (the same one --refresh-card uses), which already
    publishes 표2 via set-table.render, pins 표3, and surfaces settings/params/
    anchor. set-add adds no renderer, no pin engine, no set-table reimpl.

    Returns True iff exercise-enter published the entry set-table (its
    `.set-table-published` flag now exists), so the caller can decide whether the
    SET_TABLE_MISSING model-facing fallback is still needed. exercise-enter's
    stdout carries the ENTERED block + 표2 + card + settings lines: forward it on
    set-add's OWN stdout so the model receives the full entry payload it would
    have gotten had it called exercise-enter itself (the model echoes it exactly
    like a direct call). Its stderr (WARN/audit) stays on stderr.

    BEST-EFFORT: called AFTER the DB write is committed and fully wrapped -- any
    failure here can never lose the logged set (worst case the SET_TABLE_MISSING
    fallback still nudges the model). The exercise-enter marker makes this
    idempotent: a later re-entry prints ENTERED_ALREADY and does not re-publish."""
    try:
        # --deliver-machine-ask (2026-10-03): this path is the button rail's
        # (a tap runs set-add with no model turn), so the machine confirm ask
        # goes to the owner by code; the model gets a receipt, never the ask.
        cmd = [EXERCISE_ENTER, str(session_id), exercise_name,
               "--db", db_path, "--program", program_path,
               "--deliver-machine-ask"]
        proc = _run_step(cmd, AUTO_ENTER_WAIT_SEC)
        if proc.stdout:
            # Forward the entry payload on set-add's stdout so the model receives
            # 표2 + card + settings + params + anchor exactly as a direct
            # exercise-enter call would deliver them. Printed AFTER SET_LOGGED by
            # the caller so the forcing-hook's first-line match is untouched.
            print(proc.stdout.rstrip())
            grid = _fallback_grid(proc.stdout)
            if grid is not None:
                _FALLBACK_ON_STDOUT.append(grid)
        if proc.stderr:
            print(proc.stderr.rstrip(), file=sys.stderr)
    except Exception as e:  # noqa: BLE001 -- auto-enter must never break the write
        print("WARN: auto exercise-enter failed (%s) -- set logged, "
              "SET_TABLE_MISSING fallback still fires" % e, file=sys.stderr)
    # Re-read the published flag: True only if exercise-enter actually published
    # the entry table (so the caller can suppress the redundant fallback signal).
    return _table_published(session_id, exercise_name)


def _transition_sequence(db_path, program_path, session_id, exercise_name):
    """THE EXERCISE-TRANSITION SEQUENCER (owner spec 2026-09-11, verbatim:
    "프렙완료라고 종목 넘어가면 해당 종목 세트표 보여주고 종목 정리 멘트하고
    다음종목 세트표보여주고 다름종목 큐 나오고 버튼나와야해").

        1  finished exercise's set table
        2  a wrap-up line for it
        3  the next exercise's set table
        4  the next exercise's cue
        5  buttons

    Fired on the SET_TABLE_COMPLETE beat (the exercise's last working set just
    landed). The sequence is carried by CODE, in-process, in this order --
    prompt-only ordering was proven insufficient twice (2026-08-14 timer
    precedent, 2026-09-11 morning):

      1  already on the owner's screen: the per-set publish on THIS beat
         delivered the all-done grid before this function runs.
      2  authored HERE and pushed as its own message (set-table.deliver_table,
         the same hop the tables ride). The model narrating the wrap-up was
         the carrier that raced the buttons.
      3  exercise-enter auto-fired below for the NEXT slot -- the same
         server-side forcing point the #34/#37 recovery uses -- delivers the
         entry table by code (or, F14, holds it and surfaces the entry prep
         taps instead: for a prep-laden slot the prep affordance IS the next
         beat).
      4+5  the entry keyboard is code-pushed by exercise-enter's arm; that
         message carries its own prompt (arm step_text), so the cue sits
         directly above the buttons in one message. When the lane is closed
         (prep due) the PREP tap lines below carry the one button instead.

    BEST-EFFORT throughout: any miss degrades to today's behaviour (the model
    follows the machine lines) and can never un-log the set. Session end
    (no following slot) -> wrap-up only; session-closeout owns the rest."""
    # Recheck after the delivery delay: an undo may have removed the final
    # working row while this transition was queued. Never post a stale wrap-up.
    sa = _set_arm_mod()
    if sa is not None:
        planned = sa.resolve_rx_sets(sa.load_rx_calc(), program_path, db_path,
                                     session_id, exercise_name)
        logged = sa.count_logged_working(
            db_path, session_id, exercise_name, planned) if planned else None
        if planned and (logged is None or logged < int(planned)):
            print("TRANSITION_CANCELLED reason=working_rows_missing")
            return
    # Resolve the NEXT slot through the SAME oracle NEXT_HINT already uses
    # (set-arm.derive_next_spec, transition branch) -- a second next-exercise
    # resolver could disagree with the hint the owner just read.
    has_next, next_name, next_display = None, None, None
    sa = _set_arm_mod()
    if sa is not None:
        try:
            rx = sa.load_rx_calc()
            meta = {}
            has_next, _spec = sa.derive_next_spec(
                rx, program_path, db_path, session_id, exercise_name,
                0, True, meta=meta)
            next_name = meta.get("name")
            next_display = meta.get("display") or next_name
        except Exception as e:  # noqa: BLE001 -- never break the logged set
            print("WARN: transition next-slot resolve failed (%s)" % e,
                  file=sys.stderr)

    # (2) the wrap-up, code-authored from live state and code-delivered.
    # Korean because it is owner-facing; identifiers stay out of it.
    done_working = 0
    try:
        conn = _db_connect(db_path)
        try:
            done_working = conn.execute(
                "SELECT COUNT(*) FROM workout_sets WHERE session_id=? AND "
                "exercise_name=? AND set_seq>=1",
                (session_id, exercise_name)).fetchone()[0]
        finally:
            conn.close()
    except Exception:  # noqa: BLE001 -- an unreadable count degrades the copy
        pass
    display = exercise_name
    if sa is not None:
        try:
            display = sa.exercise_display_name(
                program_path, db_path, session_id, exercise_name)
        except Exception:  # noqa: BLE001
            pass
    if done_working:
        wrapup = "✅ %s 마무리 -- 워킹 %d세트 완료." % (display, done_working)
    else:
        wrapup = "✅ %s 마무리." % display
    if has_next and next_display:
        wrapup += " 다음 종목: %s" % next_display
    elif has_next is False:
        wrapup += " 오늘 종목은 여기까지입니다."
    delivered = False
    st = _set_table_mod()
    if st is not None:
        try:
            # Content-keyed claim: an idempotent re-fire of the same last set
            # must not push the same wrap-up twice. ASCII ledger key -- the
            # identifier axis never carries Korean.
            claimed, _sig = st.claim_table_delivery(
                session_id, "transition-wrapup-%s" % exercise_name, wrapup)
            if not claimed:
                delivered = True      # identical wrap-up already on screen
            else:
                ok, _detail = st.deliver_table(wrapup, session_id,
                                               exercise_name)
                delivered = bool(ok)
        except Exception as e:  # noqa: BLE001
            print("WARN: transition wrap-up delivery failed (%s)" % e,
                  file=sys.stderr)
    if delivered:
        print("TRANSITION_WRAPUP delivered=yes -- the wrap-up line is on the "
              "owner's screen; do not restate it.")
    else:
        # Losing the beat is worse than relaying it: the model says exactly
        # this line, in this position (after the finished table, before the
        # next exercise block below).
        print("TRANSITION_WRAPUP delivered=no (say this line verbatim, "
              "before the next-exercise block): %s" % wrapup)

    if has_next is False:
        print("TRANSITION next=NONE -- session end; session-closeout owns "
              "the rest. Do not arm or announce another exercise.")
        return
    if not next_name:
        print("TRANSITION next=UNRESOLVED -- the next slot could not be "
              "resolved by code; follow NEXT_HINT and enter it with "
              "exercise-enter yourself.")
        return

    # (3)+(4)+(5) the NEXT exercise's entry, server-side -- the same
    # forcing-point reuse as the #34/#37 recovery. exercise-enter delivers the
    # entry table by code (F14-gated), then its entry arm code-pushes the
    # keyboard whose message carries its own prompt.
    print("TRANSITION next=%s -- sequence carried by code: finished table + "
          "wrap-up are already delivered; the next exercise's table and "
          "keyboard are delivered by the entry block below. Relay the cue "
          "lines; do NOT re-render tables and do NOT add buttons." % next_name)
    _auto_enter(db_path, program_path, session_id, next_name)


# live batch 2 item 6 (owner 2026-10-08 07:24): the next exercise's table and
# its machine ask arrived BEFORE the "set 3 recorded" reply -- the pushes went
# out synchronously inside the very set-add call whose stdout the model then
# turned into the recording reply. Code-posted transition pushes (wrap-up,
# next table, machine ask, entry keyboard) now run in a detached child that
# waits TRANSITION_DEFER_SEC first, so they land AFTER the reply that records
# the triggering set. Same discipline as set-arm ARM_KB_PUSH_DELAY_SEC (sized
# for a model roundtrip), and one child keeps the sequence's own order.
# WARG_TRANSITION_DEFER_SEC overrides (0 = in-process, the pre-batch-2 shape).
TRANSITION_DEFER_SEC = 10
TRANSITION_RUN_VERB = "transition-run"


def _transition_defer_sec():
    try:
        return max(int(os.environ.get("WARG_TRANSITION_DEFER_SEC",
                                      TRANSITION_DEFER_SEC)), 0)
    except ValueError:
        return TRANSITION_DEFER_SEC


def _transition_deferred(db_path, program_path, session_id, exercise_name):
    """Schedule _transition_sequence AFTER the recording reply (item 6).

    stdout tells the model the beat is code-owned and still to come, so the
    reply is the record line (+ the next-exercise cue it already has), never a
    redrawn table or an authored button. Delay 0 -> run in-process."""
    delay = _transition_defer_sec()
    if delay <= 0:
        _transition_sequence(db_path, program_path, session_id, exercise_name)
        return
    next_name = None
    sa = _set_arm_mod()
    if sa is not None:
        try:
            meta = {}
            sa.derive_next_spec(sa.load_rx_calc(), program_path, db_path,
                                session_id, exercise_name, 0, True, meta=meta)
            next_name = meta.get("name")
        except Exception:  # noqa: BLE001
            next_name = None
    log = os.path.join(STATE_DIR, ".transition-%s.log" % session_id)
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(log, "a") as fh:
            subprocess.Popen(
                [sys.executable, os.path.abspath(__file__),
                 TRANSITION_RUN_VERB, str(session_id), exercise_name,
                 "--db", db_path, "--program", program_path,
                 "--delay", str(delay)],
                stdin=subprocess.DEVNULL, stdout=fh, stderr=fh,
                start_new_session=True, env=dict(os.environ))
    except Exception as e:  # noqa: BLE001 -- degrade to the in-process beat
        print("WARN: deferred transition spawn failed (%s) -- running it now"
              % e, file=sys.stderr)
        _transition_sequence(db_path, program_path, session_id, exercise_name)
        return
    print("TRANSITION deferred=%ds next=%s -- this exercise is done. Reply NOW "
          "with the record line for this set; code posts the wrap-up, the next "
          "exercise's table, its machine ask and its keyboard AFTER your reply "
          "(%ds). Do NOT redraw tables, do NOT ask the machine, do NOT add "
          "buttons." % (delay, next_name or "NONE", delay))


def _transition_run(argv):
    """`set-add transition-run <sid> <ex> --db --program --delay N`: the
    detached half of _transition_deferred."""
    p = argparse.ArgumentParser(prog="set-add transition-run")
    p.add_argument("session_id", type=int)
    p.add_argument("exercise_name")
    p.add_argument("--db", default=DEFAULT_DB)
    p.add_argument("--program", default=DEFAULT_PROGRAM)
    p.add_argument("--delay", type=int, default=TRANSITION_DEFER_SEC)
    a = p.parse_args(argv)
    time.sleep(max(a.delay, 0))
    _transition_sequence(os.path.abspath(a.db), os.path.abspath(a.program),
                         a.session_id, a.exercise_name)
    return 0


