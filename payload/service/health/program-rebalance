# ---------------------------------------------------------------------------
# ORDERING SOLVER (sub-problem 2) -- zone hop + intra-session fatigue order,
# STRICTLY INSIDE the priority bands that landed 2026-08-24.
# ---------------------------------------------------------------------------
#
# THE RULE OUTRANKS THE SOLVER, AND THE SOLVER CANNOT REACH IT.
# program.yaml's header makes `priority` the order authority and gives each
# role a band (0-99 warmup / 100-199 main / 200-299 rehab-prehab-focus /
# 300-399 main / 400+ accessory = the cut zone). The owner's reason is not
# efficiency, it is loss: 08-20 and 08-21 both ended early and ate a rehab slot
# and a focus slot. So this solver's decision variable is NOT "the order of the
# day" -- it is "the order WITHIN a band". Band membership is untouchable, and
# a permutation that would move a slot across a band boundary is not in the
# search space at all. It cannot propose breaking the rule even if that were
# cheaper.
#
# What it CAN say is what the rule costs: `unconstrained_min` re-solves with
# the bands removed, purely so the owner can see the hop they are paying for their
# own priority rule. That number is reported as INFO and is never a proposal.

# Band boundaries. Same contract as program.yaml's SLOT ORDERING header and
# tests/test-slot-priority.py -- a slot's band is the hundred it sits in, with
# everything >= 400 collapsed into the single cut zone.
def priority_band(p):
    try:
        p = int(p)
    except (TypeError, ValueError):
        return 400
    return 400 if p >= 400 else (p // 100) * 100


# Fatigue ordering: heavy systemic work first, isolation last. Ranks come from
# exercise_fatigue_cost via rx-calc resolve_fatigue_cost -- the same source the
# audit's per-slot layer reads. The RANK ORDER (high before med before low) is
# a practice convention, grade C; the weight below is what makes it negotiable
# against hop cost rather than absolute.
FATIGUE_RANK = {'high': 2, 'med': 1, 'low': 0}
W_HOP = 1.0
W_FATIGUE_ORDER = 0.5

# Cap on the exhaustive search. Band sizes in a real day are 1-5 slots, so the
# product of within-band permutations is in the tens; the cap only exists so a
# pathological program degrades to "no proposal" instead of hanging.
ORDER_SEARCH_CAP = 200000


def parse_gym_layout(path):
    """(hop_matrix, zone_of_token, unparsed) from gym-layout.md.

    gym-layout.md IS the zone ledger -- the hop matrix and the zone assignments
    are read out of it rather than copied into this file, so an owner
    correction there (several are pending: the doc itself flags that only 4
    mappings were ever owner-confirmed) reaches the solver with no code edit.

    Only the `워킹 슬롯:` block is read. The prep-drill block above it names
    drills, not slots, and matching against it would let a stretch band decide
    a working slot's zone."""
    hop, zone_of, unparsed = {}, {}, []
    if not os.path.exists(path):
        return hop, zone_of, ['gym-layout.md missing']
    lines = open(path, encoding='utf-8').read().splitlines()

    # --- hop matrix: a header row of zone letters, then one row per zone
    header = None
    for line in lines:
        toks = line.split()
        if header is None and len(toks) >= 5 and all(
                len(t) == 1 and t.isalpha() and t.isupper() for t in toks):
            header = toks
            continue
        if header and toks and toks[0] in header and len(toks) == len(header) + 1:
            row = toks[0]
            for col, val in zip(header, toks[1:]):
                if val == '-':
                    hop[(row, col)] = 0
                else:
                    try:
                        hop[(row, col)] = int(val)
                    except ValueError:
                        pass

    # --- working-slot zone assignments
    in_work = False
    cur = None
    for line in lines:
        if line.strip().startswith('워킹 슬롯:'):
            in_work = True
            continue
        if in_work and line.startswith('## '):
            break
        if not in_work:
            continue
        stripped = line.strip()
        m = None
        if stripped.startswith('- **') or stripped.startswith('- '):
            body = stripped.lstrip('- ').lstrip('*')
            if len(body) >= 2 and body[0].isupper() and body[1] == ':':
                cur = body[0]
                m = body[2:]
        if m is None and cur:
            m = stripped
        if not m or not cur:
            continue
        for tok in _layout_tokens(m):
            zone_of.setdefault(tok, cur)
    if not hop:
        unparsed.append('hop matrix not parsed')
    if not zone_of:
        unparsed.append('working-slot zone list not parsed')
    return hop, zone_of, unparsed


def _layout_tokens(text):
    """Comma-separated zone entries, stripped of parentheticals and markup."""
    out = []
    depth = 0
    buf = []
    for ch in text:
        if ch in '(（':
            depth += 1
            continue
        if ch in ')）':
            depth = max(0, depth - 1)
            continue
        if depth:
            continue
        if ch == ',':
            out.append(''.join(buf))
            buf = []
            continue
        buf.append(ch)
    out.append(''.join(buf))
    cleaned = []
    for t in out:
        t = t.replace('**', '').replace('[', ' ').replace(']', ' ').strip()
        t = t.strip('.').strip()
        if not t:
            continue
        for part in t.split('/'):
            part = part.strip()
            if part:
                cleaned.append(part)
    # A gym-layout entry may carry a trailing annotation on the same fragment
    # (e.g. `bicep_curl("바벨 컬", 뒷A slot6) **[confirmed 2026-08-22]**`), which
    # leaves the snake_case key glued to prose after the parenthetical is
    # stripped. Emit any embedded snake_case identifier as its own token so an
    # owner-confirmed mapping is not lost to markup.
    for frag in list(cleaned):
        for ident in re.findall(r'[a-z][a-z0-9]*(?:_[a-z0-9]+)+', frag):
            if ident != frag:
                cleaned.append(ident)
    return cleaned


def _norm(s):
    return ''.join((s or '').split()).lower()


def zone_map_for_program(program, zone_of):
    """{exercise_name: zone} plus the list of slots gym-layout does not cover.

    Matching is by snake_case key first (unambiguous), then by the slot's own
    Korean `display` string -- program.yaml already carries the display name, so
    the Korean entries in gym-layout.md are resolved through THAT rather than
    through a Korean->key table maintained here. An exercise that matches
    nothing is reported UNMAPPED and excluded from the cost, never guessed into
    a zone: gym-layout.md itself records that only four of its mappings were
    ever owner-confirmed."""
    by_key = {k: v for k, v in zone_of.items() if k.replace('_', '').isalnum()
              and k.islower()}
    korean = {_norm(k): v for k, v in zone_of.items() if k not in by_key}
    out, unmapped = {}, []
    for _d, _i, ex in iter_slots(program):
        name = ex.get('name')
        if not name or name in out:
            continue
        if name in by_key:
            out[name] = by_key[name]
            continue
        disp = _norm(ex.get('display'))
        hit = None
        for tok, z in korean.items():
            if tok and disp and (tok in disp or disp in tok):
                hit = z
                break
        if hit:
            out[name] = hit
        else:
            unmapped.append(name)
    return out, unmapped


def order_cost(names, zone, hop, fat_rank):
    """(total, hop_cost, fatigue_violations) for one day's slot sequence.

    Unmapped slots are TRANSPARENT to the hop term -- the walk continues from
    the last known zone -- so an unknown zone cannot fabricate movement. It is
    counted in the report as coverage loss instead."""
    zseq = [zone.get(n) for n in names]
    hop_cost = 0
    prev = None
    for z in zseq:
        if z is None:
            continue
        if prev is not None:
            hop_cost += hop.get((prev, z), 0)
        prev = z
    viol = 0
    ranks = [fat_rank.get(n, 0) for n in names]
    for i in range(len(ranks)):
        for j in range(i + 1, len(ranks)):
            if ranks[i] < ranks[j]:
                viol += 1
    return W_HOP * hop_cost + W_FATIGUE_ORDER * viol, hop_cost, viol


def _permute_within_bands(items, keyfn):
    """Every sequence reachable by permuting inside each band, bands in fixed
    order. This IS the constraint: nothing here can move a slot to another
    band."""
    bands = {}
    for it in items:
        bands.setdefault(keyfn(it), []).append(it)
    order = sorted(bands)
    pools = [list(itertools.permutations(bands[b])) for b in order]
    total = 1
    for p in pools:
        total *= len(p)
    if total > ORDER_SEARCH_CAP:
        return None, total
    seqs = []
    for combo in itertools.product(*pools):
        seq = []
        for chunk in combo:
            seq.extend(chunk)
        seqs.append(seq)
    return seqs, total


def solve_order(program, led, layout_path, program_path=None):
    hop, zone_of, unparsed = parse_gym_layout(layout_path)
    zone, unmapped = zone_map_for_program(program, zone_of)
    fat = {}
    fat_rank = {}
    for _d, _i, ex in iter_slots(program):
        n = ex.get('name')
        if n:
            fat[n] = led.fatigue(n)
            fat_rank[n] = FATIGUE_RANK.get(fat[n], 0)

    days = []
    for day in (program.get('rotation') or []):
        items = rx.day_work_items(program, day)
        names = [e.get('name') for e in items]
        cur_total, cur_hop, cur_viol = order_cost(names, zone, hop, fat_rank)

        seqs, space = _permute_within_bands(
            items, lambda e: priority_band(e.get('priority')))
        best_seq, best = names, (cur_total, cur_hop, cur_viol)
        if seqs:
            for seq in seqs:
                nm = [e.get('name') for e in seq]
                c = order_cost(nm, zone, hop, fat_rank)
                if c[0] < best[0] - 1e-9:
                    best, best_seq = c, nm

        # INFO ONLY -- what the priority rule costs. Never a proposal.
        if len(items) <= 9:
            free_best = min(
                (order_cost([e.get('name') for e in perm], zone, hop, fat_rank)
                 for perm in itertools.permutations(items)),
                key=lambda c: c[0])
        else:
            free_best = None

        # The cost model has a WITHIN-day fatigue ORDER term but no
        # exercise-to-exercise CONTINUITY term: it knows "heavy first", it does
        # not know "deadlift immediately followed by barbell row is two
        # consecutive high spinal loads". The 2026-08-22 consult briefing
        # flagged exactly that trade (the 뒷A 3-hop saving buys a
        # 데드->바벨로우 adjacency) and recorded it as an OWNER call. So any
        # NEW adjacency between two `high` fatigue-cost slots is surfaced as a
        # caution rather than silently bought.
        def high_pairs(seq):
            return {(seq[i], seq[i + 1]) for i in range(len(seq) - 1)
                    if fat.get(seq[i]) == 'high' and fat.get(seq[i + 1]) == 'high'}
        new_adjacency = sorted(high_pairs(best_seq) - high_pairs(names))

        renumber = None
        if best_seq != names:
            band_prios = {}
            for e in items:
                band_prios.setdefault(priority_band(e.get('priority')), []).append(
                    int(e.get('priority')))
            for b in band_prios:
                band_prios[b].sort()
            cursor = {b: 0 for b in band_prios}
            renumber = []
            for n in best_seq:
                e = next(x for x in items if x.get('name') == n)
                b = priority_band(e.get('priority'))
                p = band_prios[b][cursor[b]]
                cursor[b] += 1
                renumber.append({'exercise': n, 'from': int(e.get('priority')),
                                 'to': p, 'role': e.get('role'), 'band': b})

        days.append({
            'day': day,
            'current_order': names,
            'current_zones': [zone.get(n) for n in names],
            'current_hop': cur_hop,
            'current_fatigue_violations': cur_viol,
            'best_within_band_order': best_seq,
            'best_within_band_hop': best[1],
            'best_within_band_fatigue_violations': best[2],
            'improves': best_seq != names,
            'new_high_fatigue_adjacency': new_adjacency,
            'renumber': renumber,
            'search_space': space,
            'rule_free_min_hop': free_best[1] if free_best else None,
            'price_of_priority_rule':
                (best[1] - free_best[1]) if free_best else None,
        })

    return {
        'mode': 'order',
        'program': program_path,
        'layout': layout_path,
        'layout_parse_warnings': unparsed,
        'unmapped_exercises': unmapped,
        'zone_coverage': f'{len(zone)}/{len(zone) + len(unmapped)}',
        'weights': {'W_HOP': W_HOP, 'W_FATIGUE_ORDER': W_FATIGUE_ORDER},
        'days': days,
        'constraint': 'within-band permutation ONLY -- the 2026-08-24 priority '
                      'bands are not in the search space',
        'apply': 'NOT APPLIED -- proposal only. program.yaml is untouched.',
    }


