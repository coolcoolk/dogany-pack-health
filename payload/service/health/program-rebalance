            a('  제안: 없음 -- 밴드 내부에서 더 나은 배열이 없다')
        if d['price_of_priority_rule'] is not None:
            a(f"  [INFO] 밴드 제약을 풀면 최소 hop {d['rule_free_min_hop']} "
              f"(우선순위 룰이 지불하는 값 = +{d['price_of_priority_rule']}). "
              f"제안 아님 -- 룰이 상위 제약이다.")
        a('')
    a(o['apply'])
    return '\n'.join(L)


# ---------------------------------------------------------------------------
# GATE -- a program edit that breaks an invariant must fail LOUDLY
# ---------------------------------------------------------------------------

def run_priority_suite(program_path):
    """Delegate the slot-priority invariants to the guard that already owns
    them (tests/test-slot-priority.py, landed 2026-08-24). Re-implementing its
    seven invariants here would be a second ledger of the same rule.

    WARG_PROGRAM_YAML points that suite at the CANDIDATE file, so the gate
    checks the edit under review rather than whatever is currently live."""
    path = os.path.join(HERE, 'tests', 'test-slot-priority.py')
    if not os.path.exists(path):
        return {'ok': False, 'rc': None, 'detail': 'test-slot-priority.py missing'}
    env = dict(os.environ)
    env['WARG_PROGRAM_YAML'] = os.path.abspath(program_path)
    proc = subprocess.run([sys.executable, path], capture_output=True,
                          text=True, env=env)
    tail = (proc.stdout or '').strip().splitlines()[-3:]
    return {'ok': proc.returncode == 0, 'rc': proc.returncode,
            'detail': ' | '.join(tail)}


def baseline_program(program_path, baseline):
    """The state we are comparing against. Default = git HEAD of the same file,
    i.e. 'what was already agreed'. A NEW violation is the gate's trigger; a
    pre-existing one is a backlog item, not a landing blocker."""
    if baseline:
        return rx.load_yaml(baseline), f'file:{baseline}'
    top = subprocess.run(['git', '-C', os.path.dirname(program_path),
                          'rev-parse', '--show-toplevel'],
                         capture_output=True, text=True)
    if top.returncode != 0:
        return None, 'none (not a git repo)'
    root = top.stdout.strip()
    rel = os.path.relpath(os.path.abspath(program_path), root)
    show = subprocess.run(['git', '-C', root, 'show', f'HEAD:{rel}'],
                          capture_output=True, text=True)
    if show.returncode != 0:
        return None, 'none (no HEAD copy)'
    tmp = os.path.join('/tmp', f'.program-rebalance-baseline-{os.getpid()}.yaml')
    with open(tmp, 'w', encoding='utf-8') as f:
        f.write(show.stdout)
    try:
        return rx.load_yaml(tmp), f'git HEAD:{rel}'
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def violations(program, db_path, today, layer):
    """{unit: verdict} for every HARD band violation in a program state."""
    led = Ledger(db_path, program, layer)
    vals = unit_values(program, led)
    out = {}
    for u in led.units:
        floor_v, _t, ceiling_v, _f, _s = led.bands[u]
        if vals[u] < floor_v - 1e-9:
            out[u] = f'below_floor ({vals[u]} < {floor_v})'
        elif vals[u] > ceiling_v + 1e-9:
            out[u] = f'above_ceiling ({vals[u]} > {ceiling_v})'
    return out


def run_gate(args):
    program = rx.load_yaml(args.program)
    if not isinstance(program, dict):
        raise SystemExit('[program-rebalance] ERROR: program.yaml did not parse')
    prio = run_priority_suite(args.program)
    now = violations(program, args.db, args.today, args.layer)
    base, base_src = baseline_program(args.program, args.baseline)
    was = violations(base, args.db, args.today, args.layer) if base else {}
    # NO BASELINE => NO BAND VERDICT. Treating "unknown baseline" as "clean
    # baseline" would turn every pre-existing violation into a NEW one and the
    # gate would block every landing in a fresh checkout -- a gate that cries
    # wolf is a gate that gets bypassed. The priority arm still applies.
    new = {u: v for u, v in now.items() if u not in was} if base else {}
    fixed = sorted(set(was) - set(now))

    # ---- COORDINATION ARM (2026-08-24 owner rule). Two halves, on purpose:
    #   * REFUSALS are relative to the baseline -- an EDIT that demotes a
    #     unilateral slot behind the cut line, or swaps one out for a bilateral
    #     movement, exits 4 exactly like a priority/band break. Same shape.
    #   * The FLOOR is absolute and always evaluated, but it only WARNS: it is
    #     a judgement value, and a gate that blocks a landing on a judgement
    #     value is a gate that gets bypassed.
    led_u = Ledger(args.db, program, args.layer)
    census = unilateral_census(program, led_u)
    control = control_census(program, rx.load_prep(args.program), args.db)
    floor = unilateral_floor_verdict(
        census, args.unilateral_floor_share, args.unilateral_min_per_day,
        led_u.focus_muscles)
    refusals = unilateral_refusals(base, program) if base else []

    result = {
        'mode': 'gate',
        'program': os.path.abspath(args.program),
        'baseline': base_src,
        'priority_suite': prio,
        'violations_now': now,
        'violations_baseline': was,
        'new_violations': new,
        'fixed_violations': fixed,
        'baseline_available': base is not None,
        'unilateral': {
            'census': census,
            'floor': floor,
            'refusals': refusals,
            'refusals_evaluated': base is not None,
        },
        'coordination': coordination_reading(census, control, args.db),
        'coordination_control_census': control,
        'ok': prio['ok'] and not new and not refusals,
    }
    return result


def render_gate(g):
    L = []
    a = L.append
    a('=' * 74)
    a('program-rebalance --gate  (프로그램 편집 불변식 게이트)')
    a('=' * 74)
    a(f"program : {g['program']}")
    a(f"baseline: {g['baseline']}")
    a('')
    a(f"[PRIORITY] tests/test-slot-priority.py rc={g['priority_suite']['rc']} "
      f"-> {'OK' if g['priority_suite']['ok'] else 'FAIL'}")
    a(f"           {g['priority_suite']['detail']}")
    a('')
    a('[BANDS] 기준선 대비 NEW 위반만 게이트를 막는다 (선행 위반은 백로그)')
    if not g['baseline_available']:
        a('  기준선을 못 구했다 -- 밴드 판정 SKIP (우선순위 판정만 유효)')
    if g['violations_baseline']:
        for u, v in sorted(g['violations_baseline'].items()):
            a(f"  baseline: {u}: {v}")
    if g['fixed_violations']:
        a(f"  fixed   : {', '.join(g['fixed_violations'])}")
    if g['new_violations']:
        for u, v in sorted(g['new_violations'].items()):
            a(f"  NEW     : {u}: {v}   <- 이 편집이 만든 위반")
    else:
        a('  NEW     : (없음)')
    a('')
    u = g['unilateral']
    a(render_unilateral(u['census'], u['census'], u['floor'], u['refusals']))
    a('')
    a(render_coordination(g['coordination']))
    if not u['refusals_evaluated']:
        a('    기준선을 못 구했다 -- 거부 판정 SKIP (바닥선 경고만 유효)')
    a('')
    a('GATE: ' + ('PASS' if g['ok'] else 'FAIL -- 이 편집은 착지 금지'))
    return '\n'.join(L)


