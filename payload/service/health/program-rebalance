# THE LABEL IS THE USER'S, OR IT IS THE MEASURE'S NAME (2026-09-26).
# This used to be one person's word for this axis, typed in as a constant and
# printed on every user's program readout -- the same universality defect the
# kit removed from its seeded strands (migration 055, owner ruling 2026-09-26).
# Strands now come from each user's own answer. So the label is resolved:
#   1. a user strand linked to one of the sub-measure tokens below -> its label
#      (the kit registers the tokens; until it does, nothing links, see the
#      kit-side follow-up);
#   2. otherwise the plain name of WHAT IS COUNTED -- a description of the
#      measure, not anybody's aspiration.
# The internal key stays; it names the counting rule, not a person's picture.
#
# THE CONNECTION STRAND'S MEASURE SET (2026-09-30) is unilateral + controlled
# tempo. zero_load_control_share_sets counts timed holds and no longer stands
# for Pilates; it stays a sub-measure of the reading and still resolves the
# label of a strand linked to it before this date.
COORDINATION_AXIS_KEY = 'coordination'
CONNECTION_METRIC_TOKENS = ('unilateral_share_sets',
                            'controlled_tempo_share_sets')
COORDINATION_METRIC_TOKENS = CONNECTION_METRIC_TOKENS + (
    'zero_load_control_share_sets',)
COORDINATION_MEASURE_LABEL = '편측·느린 제어 세트 비율'


def resolve_coordination_label(db_path):
    """(label, source): source is 'user_strand' or 'measure'."""
    import sqlite3 as _sqlite3
    if db_path:
        try:
            conn = _sqlite3.connect('file:%s?mode=ro' % db_path, uri=True)
            try:
                row = conn.execute(
                    "SELECT a.label FROM metric_axis a JOIN goal_metric_source g "
                    "ON g.axis_key = a.axis_key WHERE a.origin='user' "
                    "AND g.metric_token IN (%s) ORDER BY a.axis_rank LIMIT 1"
                    % ",".join("?" * len(COORDINATION_METRIC_TOKENS)),
                    COORDINATION_METRIC_TOKENS).fetchone()
            finally:
                conn.close()
            if row and row[0]:
                return row[0], 'user_strand'
        except _sqlite3.Error:
            pass
    return COORDINATION_MEASURE_LABEL, 'measure'


def coordination_reading(uni_census, ctl_census, db_path=None):
    """The coordination axis as a READING: sub-measures in their own units.

    There is deliberately NO blended coordination score. Two sub-measures in
    two units is the honest shape; one number would be a new flattening, and a
    flattened number is what the system then mistakes for the picture.

    `baseline_proposal` exists to satisfy record-first: every number in it is
    derived from the owner's own program, so the axis can be opened with ONE
    confirm instead of a cold ask. NO TARGET is proposed. Measure-first
    (2026-08-18) says an unknown target gets observed, not invented, and this
    axis has exactly one observation -- today's program -- which is a baseline,
    not a trend."""
    uw = uni_census['totals']
