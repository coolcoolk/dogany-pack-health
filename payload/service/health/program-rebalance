def is_unilateral(slot):
    """True iff THE classifier says this slot is performed one side at a time.

    No second opinion is formed here, and a missing classifier is FATAL rather
    than a silent False: a coordination floor judged with a guessed
    classification is worse than no floor at all."""
    try:
        ee = load_exercise_enter()
    except Exception as exc:                                   # noqa: BLE001
        raise SystemExit(
            '[program-rebalance] FATAL: unilateral classifier unavailable '
            '(exercise-enter.extract_record_params): %r. Refusing to judge the '
            'coordination floor on a guess.' % (exc,))
    try:
        return 'unilateral' in ee.extract_record_params(slot)
    except Exception as exc:                                   # noqa: BLE001
        raise SystemExit(
            '[program-rebalance] FATAL: unilateral classifier raised on slot '
            '%r: %r' % (slot.get('name'), exc))


def is_zero_load_control(slot):
    """True iff THIS WORK SLOT is controlled work carrying no external load.

    The second coordination sub-measure (see the module docstring). Like
    is_unilateral, no second opinion is formed here: rx-calc._is_isometric_hold
    already owns "this slot's rep_range encodes SECONDS of hold, not reps",
    which is precisely 'measured as control, not as reps'. Its own docstring
    records why `progression == 'hold'` ALONE is insufficient -- a LOADED slot
    can be 'hold' for autoregulation reasons -- so the weight_kg-is-None guard
    that makes this ZERO-load is already inside the rule being imported.

    NOTHING HERE LOOKS AT load_type / freeweight-ness: a classifier that
    consults the load ladder returns 0 for unloaded control work.

    THIS IS HOLDS, NOT PILATES (2026-09-30). It counts timed isometric holds
    (wall_sit, 내전근 아이소메트릭). Pilates is slow controlled MOVEMENT and is
    the controlled-tempo sub-measure (is_controlled_tempo); this one no longer
    stands for it.

    A missing classifier is FATAL rather than a silent False, for the same
    reason as is_unilateral: reporting a coordination axis as 0 because the rule
    could not be found is worse than reporting nothing."""
    fn = getattr(rx, '_is_isometric_hold', None)
    if fn is None:
        raise SystemExit(
            '[program-rebalance] FATAL: zero-load-control classifier '
            'unavailable (rx-calc._is_isometric_hold is gone or renamed). '
            'Refusing to report the coordination axis as 0 on a missing rule.')
    try:
        return bool(fn(slot))
    except Exception as exc:                                   # noqa: BLE001
        raise SystemExit(
            '[program-rebalance] FATAL: zero-load-control classifier raised on '
            'slot %r: %r' % (slot.get('name'), exc))


# CONTROLLED TEMPO -- the sub-measure Pilates actually is (2026-09-30).
# The first cut let is_zero_load_control stand for Pilates, and its classifier
# is rx-calc._is_isometric_hold: it counts timed HOLDS. Pilates is not a hold.
# It is slow, controlled, full-range MOVEMENT (roll-down, bridge articulation,
# leg circles, a lift done at a slow stated tempo) -- kimwog
# exercise-ideal-pilates-controlled-movement-037, note 1. A hold-counting
# measure does not see it at all, which repeated the owner's correction in code.
#
# The marker is the tempo the slot already carries, in the one notation this
# pack reads (workout-session weight-realization F18): four digits,
# 당김 / 유지 / 신장 / 정지 seconds, 'X' = explosive (0 s). Source order:
#   1. the program.yaml slot's own `tempo` (the card is authoritative);
#   2. ax_exercise.tempo for that exercise (kit taxonomy), when a DB is given.
# LOAD IS NOT CONSULTED, loaded or not: a slow-tempo leg press counts exactly
# as a slow roll-down does.
#
# THE THRESHOLD IS A JUDGEMENT VALUE. No source gives Pilates tempo in seconds
# (kimwog GAPS, v33). Both MOVING phases must be deliberately slow -- a fast
# phase in either direction is ordinary lifting with a slow eccentric, not
# controlled movement -- and the rep must spend a real stretch of time moving.
# 2140 (the F18 machine example) counts; 3010 / 2010 / 20X0 do not.
CONTROLLED_TEMPO_MIN_PHASE_S = 2     # each of 당김 and 신장
CONTROLLED_TEMPO_MIN_MOVING_S = 5    # 당김 + 신장
CONTROLLED_TEMPO_DERIVATION = (
    'JUDGEMENT VALUE -- no source gives Pilates tempo in seconds (kimwog v33 '
    'GAPS). Both moving phases >= %d s and >= %d s moving per rep; a hold is '
    'never counted here (it is the zero-load-control sub-measure).'
    % (CONTROLLED_TEMPO_MIN_PHASE_S, CONTROLLED_TEMPO_MIN_MOVING_S))

_TEMPO_BY_NAME = {}


def parse_tempo(raw):
    """'2140' / '2-1-4-0' / '20X0' -> (concentric, top, eccentric, bottom) in
    seconds, or None when the value is not the four-phase notation. None is
    NOT 'fast': the caller names an unreadable tempo instead of scoring it."""
    if raw is None or isinstance(raw, bool):
        return None
    s = str(raw).strip().upper()
    for sep in ('-', ' ', '/', '.'):
        s = s.replace(sep, '')
    if len(s) != 4 or any(c not in '0123456789X' for c in s):
        return None
    return tuple(0 if c == 'X' else int(c) for c in s)


def tempo_by_exercise(db_path):
    """{exercise_name: tempo} from ax_exercise (active rows carrying one).
    Cached per DB path; no DB / unreadable DB -> {} (the slot field still
    answers)."""
    key = os.path.abspath(db_path) if db_path else None
    if key is None or not os.path.exists(key):
        return {}
    if key in _TEMPO_BY_NAME:
        return _TEMPO_BY_NAME[key]
    import sqlite3 as _sqlite3
    out = {}
    try:
        conn = _sqlite3.connect('file:%s?mode=ro' % key, uri=True)
        try:
            for name, tempo in conn.execute(
                    "SELECT exercise_name, tempo FROM ax_exercise WHERE "
                    "status = 'active' AND tempo IS NOT NULL "
                    "AND tempo <> ''"):
                out[name] = tempo
        finally:
            conn.close()
    except _sqlite3.Error:
        out = {}
    _TEMPO_BY_NAME[key] = out
    return out


def slot_tempo(slot, db_path=None):
    """(raw tempo, source) for a work slot; (None, None) when none is carried.
    source: 'program.yaml' | 'ax_exercise'."""
    if not isinstance(slot, dict):
        return None, None
    raw = slot.get('tempo')
    if raw not in (None, ''):
        return raw, 'program.yaml'
    raw = tempo_by_exercise(db_path).get(slot.get('name'))
    if raw not in (None, ''):
        return raw, 'ax_exercise'
    return None, None


def is_controlled_tempo(slot, db_path=None):
    """True iff THIS WORK SLOT is done at a slow controlled tempo (see the
    block above). A hold is never controlled-tempo movement: holds are the
    zero-load-control sub-measure, and letting them in here is exactly the
    Pilates-as-hold error this sub-measure replaces."""
    if is_zero_load_control(slot):
        return False
    raw, _src = slot_tempo(slot, db_path)
    t = parse_tempo(raw)
    if t is None:
        return False
    con, _top, ecc, _bot = t
    return (con >= CONTROLLED_TEMPO_MIN_PHASE_S
            and ecc >= CONTROLLED_TEMPO_MIN_PHASE_S
            and con + ecc >= CONTROLLED_TEMPO_MIN_MOVING_S)


def drill_implement(prep, drill):
    """The external implement a 준비운동/쿨다운 drill carries, or None.

    prep.yaml keeps it on the DRILL definition (`drills.<code>.implement`, e.g.
    헤일로 -> 케틀벨), not on the per-day item, so the lookup goes through the
    code. None/absent = unloaded."""
    code = (drill or {}).get('code')
    if not code:
        return None
    defn = ((prep or {}).get('drills') or {}).get(code)
    if not isinstance(defn, dict):
        return None
    return defn.get('implement') or None


def is_control_drill(prep, drill):
    """True iff a 준비운동/쿨다운 drill is UNLOADED CONTROL work.

    Same shape as the work-slot rule, read off the markers prep.yaml actually
    carries: measured in held seconds (`hold_sec`) and carrying no implement.
    A drill with an implement is loaded and is not this sub-measure; a drill
    counted in reps has no control marker and is reported as `unmeasured`
    rather than guessed at."""
    if not isinstance(drill, dict):
        return False
    if drill_implement(prep, drill):
        return False
    return bool(drill.get('hold_sec'))


