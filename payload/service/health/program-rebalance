def unilateral_floor_verdict(census, floor_share, min_per_day, focus_muscles=()):
    """The FLOOR arm: below it WARNS loudly. It does not refuse -- refusal is
    reserved for the two structural moves (demotion / substitution), because a
    share that drifts one set low is a conversation, while a program that
    swaps coordination work out is the failure the owner described."""
    warnings = []
    share = census['share_sets']
    if share < floor_share - 1e-9:
        warnings.append({
            'code': 'UNILATERAL_SHARE_BELOW_FLOOR',
            'detail': '편측 세트 비중 %.2f%% < 바닥선 %.2f%% '
                      '(%d/%d weekly sets)'
                      % (share * 100, floor_share * 100,
                         census['totals']['unilateral_sets'],
                         census['totals']['sets'])})
    bare = [d for d, v in census['per_day'].items()
            if v['uni_slots'] < min_per_day]
    if bare:
        warnings.append({
            'code': 'DAY_WITHOUT_UNILATERAL',
            'detail': '편측 슬롯이 %d개 미만인 날: %s'
                      % (min_per_day, ', '.join(bare))})
    return {
        'floor_share': floor_share,
        'min_per_day': min_per_day,
        'floor_derivation': UNILATERAL_FLOOR_DERIVATION,
        'per_day_derivation': UNILATERAL_PER_DAY_DERIVATION,
        'is_judgement_value': True,
        'share_sets': share,
        'share_slots': census['share_slots'],
        'ok': not warnings,
        'warnings': warnings,
        'upper_body_gap': unilateral_upper_gap(census, focus_muscles),
    }


def unilateral_upper_gap(census, focus_muscles=()):
    """SURFACE the upper-body hole. Do NOT fix it.

    Which movement fills it is PROGRAM CONTENT -- it names an exercise, and
    naming exercises is the owner's call with the agent, not this module's (the same
    line the allocator already draws with NO_CANDIDATE). So this reports the
    hole, its size, and why it matters, and stops."""
    upper = census['by_region_slots'].get('upper', 0)
    if upper:
        return None
    focus_upper = sorted(m for m in (focus_muscles or ())
                         if MUSCLE_REGION.get(m) == 'upper')
    return {
        'code': 'NO_UPPER_BODY_UNILATERAL',
        'unilateral_slots_by_region': census['by_region_slots'],
        'focus_muscles_in_upper_body': focus_upper,
        'severity': 'high' if focus_upper else 'medium',
        'owner_decision': True,
        'detail_ko':
            '상체 편측 동작이 0개다. 편측 슬롯 %d개가 전부 하체/코어에 몰려 있다.'
            % census['totals']['unilateral_slots']
            + ('  목표 근육(%s)이 상체인데 그 축의 편측 동작이 없다.'
               % ', '.join(focus_upper) if focus_upper else ''),
        'not_fixed_here':
            '어떤 종목을 넣을지는 PROGRAM CONTENT -- %s 에이전트와 정할 사안이라 '
            '여기서는 지적만 하고 손대지 않는다 (allocator NO_CANDIDATE 와 같은 선).'
            % _user('이', '가'),
    }


def _slot_index(program):
    """{(day, name): record} for every work slot, with its unilateral verdict."""
    idx = {}
    for day in (program.get('rotation') or []):
        for i, ex in enumerate(rx.day_work_items(program, day), 1):
            name = ex.get('name')
            if not name:
                continue
            idx[(day, name)] = {
                'day': day, 'position': i, 'exercise': name,
                'priority': ex.get('priority'),
                'band': priority_band(ex.get('priority')),
                'role': ex.get('role'),
                'sets': int(ex.get('sets', 3) or 0),
                'unilateral': is_unilateral(ex),
            }
    return idx


def unilateral_refusals(base, cand):
    """THE TWO REFUSALS. Each returns a dict that NAMES THE SLOT.

    Both are measured RELATIVE TO A BASELINE, the same doctrine the band arm of
    this gate already uses: a pre-existing shape is a backlog item, an EDIT that
    creates the shape is a landing blocker.

      UNILATERAL_DEMOTED_BEHIND_CUT_LINE
          the slot is still unilateral but the edit pushed it later -- into a
          later priority band (400+ IS the cut zone by program.yaml's own
          header) or to a later position within its day. There is no safe
          amount of backward movement for a coordination slot: the cut line
          moves session to session, and 08-20/08-21 both landed on top of one.

      UNILATERAL_SWAPPED_FOR_BILATERAL / UNILATERAL_SLOT_REMOVED /
      UNILATERAL_MARKER_STRIPPED
          the coordination work is gone. Swapped when the day picked up a new
          bilateral slot in its place, removed when it simply vanished, and
          MARKER_STRIPPED when the slot name survives but its `unilateral`
          block was deleted -- which is the same substitution performed on the
          data instead of on the program.
    """
    out = []
    if not isinstance(base, dict) or not isinstance(cand, dict):
        return out
    base_idx = _slot_index(base)
    cand_idx = _slot_index(cand)
    for (day, name), b in sorted(base_idx.items()):
        if not b['unilateral']:
            continue
        c = cand_idx.get((day, name))
        moved_to = None
        if c is None:
            elsewhere = sorted(k for k in cand_idx if k[1] == name)
            if elsewhere:
                c = cand_idx[elsewhere[0]]
                moved_to = c['day']
        if c is None:
            arrivals = sorted(k for k in cand_idx
                              if k[0] == day and k not in base_idx)
            bilateral = [k[1] for k in arrivals if not cand_idx[k]['unilateral']]
            if bilateral:
                out.append({
                    'code': 'UNILATERAL_SWAPPED_FOR_BILATERAL',
                    'day': day, 'exercise': name,
                    'replacement': bilateral,
                    'detail': '%s 의 편측 슬롯 %s 가 사라지고 양측 슬롯 %s 가 '
                              '들어왔다 -- 협응 작업의 치환. 거부.'
                              % (day, name, ', '.join(bilateral))})
            else:
                out.append({
                    'code': 'UNILATERAL_SLOT_REMOVED',
                    'day': day, 'exercise': name, 'replacement': [],
                    'detail': '%s 의 편측 슬롯 %s 가 프로그램에서 제거됐다. 거부.'
                              % (day, name)})
            continue
        if not c['unilateral']:
            out.append({
                'code': 'UNILATERAL_MARKER_STRIPPED',
                'day': c['day'], 'exercise': name,
                'detail': '%s %s 의 unilateral 표시가 지워졌다 -- 종목은 남고 '
                          '협응 분류만 사라진 치환. 거부.' % (c['day'], name)})
            continue
        if c['band'] > b['band']:
            out.append({
                'code': 'UNILATERAL_DEMOTED_BEHIND_CUT_LINE',
                'day': c['day'], 'exercise': name,
                'from': {'priority': b['priority'], 'band': b['band'],
                         'position': b['position'], 'day': b['day']},
                'to': {'priority': c['priority'], 'band': c['band'],
                       'position': c['position'], 'day': c['day']},
                'detail': '%s %s 우선순위 밴드 %d -> %d%s -- 잘림선 뒤로 밀렸다. 거부.'
                          % (c['day'], name, b['band'], c['band'],
                             ' (400+ = 컷존)' if c['band'] >= 400 else '')})
        elif c['position'] > b['position']:
            out.append({
                'code': 'UNILATERAL_DEMOTED_BEHIND_CUT_LINE',
                'day': c['day'], 'exercise': name,
                'from': {'priority': b['priority'], 'band': b['band'],
                         'position': b['position'], 'day': b['day']},
                'to': {'priority': c['priority'], 'band': c['band'],
                       'position': c['position'], 'day': c['day']},
                'detail': '%s %s 수행 순서 %d번째 -> %d번째%s -- 잘림선 쪽으로 '
                          '밀렸다. 거부.'
                          % (c['day'], name, b['position'], c['position'],
                             ' (%s -> %s 날짜 이동)' % (b['day'], moved_to)
                             if moved_to else '')})
    return out


