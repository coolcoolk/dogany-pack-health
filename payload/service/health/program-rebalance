def build_proposal(args):
    program_path, today, db_path = args.program, args.today, args.db
    program = rx.load_yaml(program_path)
    if not isinstance(program, dict):
        raise SystemExit('[program-rebalance] ERROR: program.yaml did not parse')
    history = rx.load_history_sidecar(program_path)
    led = Ledger(db_path, program, args.layer)
    # PURPOSE WIRE: an explicit --objective always wins (it is the owner or an
    # operator overriding on purpose). With no flag, the objective comes from
    # the owner's STORED purpose, not from a hardcoded constant.
    if args.objective:
        obj_name, obj_source = args.objective, 'flag:--objective'
    else:
        obj_name, obj_source = resolve_objective_from_purpose(db_path)
    obj = copy.deepcopy(OBJECTIVES[obj_name])
    if args.objective_weights:
        obj.update(json.loads(args.objective_weights))

    observed_max_slot = max(
        [int(ex.get('sets', 3)) for _d, _i, ex in iter_slots(program)] or [3])
    observed_max_day = max(
        [day_set_total(program, d) for d in (program.get('rotation') or [])] or [0])
    limits = {
        # Derived from the program the owner already accepted, not invented:
        # a slot may grow one set past the longest slot that exists, and no
        # session may grow past the longest session that exists. Both are
        # knobs -- the point is that the default is measured, not asserted.
        'max_slot_sets': args.max_slot_sets or (observed_max_slot + 1),
        'max_day_sets': args.max_day_sets or observed_max_day,
        'min_slot_sets': rx.MUSCLE_TRIM_FLOOR_SETS,   # rx-calc's own floor
        'new_slot_sets': args.new_slot_sets,
        # COORDINATION FLOOR -- a hard constraint on trim moves, not a report.
        'unilateral_floor_share': args.unilateral_floor_share,
    }

    audit = rx.volume_audit(program, db_path, today, None)
    before_vals = unit_values(program, led)
    deficits = classify_deficits(program, led, audit, before_vals)

    prep_yaml = rx.load_prep(args.program)
    uni_before = unilateral_census(program, led)
    ctl_before = control_census(program, prep_yaml, db_path)
    uni_floor_before = unilateral_floor_verdict(
        uni_before, args.unilateral_floor_share, args.unilateral_min_per_day,
        led.focus_muscles)

    after, accepted, rounds = allocate(
        program, led, obj, limits, history, audit, args.max_rounds)
    uni_after = unilateral_census(after, led)
    ctl_after = control_census(after, prep_yaml, db_path)
    uni_floor_after = unilateral_floor_verdict(
        uni_after, args.unilateral_floor_share, args.unilateral_min_per_day,
        led.focus_muscles)
    after_vals = unit_values(after, led)
    after_deficits = classify_deficits(after, led, audit, after_vals)
    accepted = merge_moves(accepted)

    # what the machine could NOT fix, and why. Two different questions, kept
    # apart on purpose: a PRESCRIPTION the allocator failed to raise is the
    # allocator's unfinished business; a DELIVERY shortfall (rolling 7d actual
    # under floor while the prescription is in band) is not an allocation
    # defect at all and adding sets to it would be the wrong fix.
    unresolved = []
    adherence = []
    for u, info in sorted(after_deficits.items()):
        if info['kind'] == 'adherence_gap':
            adherence.append({'unit': u, 'reason': 'ADHERENCE_NOT_ALLOCATION',
                              **info})
            continue
        unresolved.append({'unit': u,
                           'reasons': unresolved_reasons(after, led, limits, u),
                           'db_candidates': candidate_exercises(u, led, after),
                           **info})

    return {
        'mode': 'allocate',
        'program': os.path.abspath(program_path),
        'today': today,
        'objective': {'name': obj_name, 'weights': obj, 'source': obj_source},
        'layer': args.layer,
        'limits': limits,
        'limits_source': {
            'max_slot_sets': f'observed max slot sets ({observed_max_slot}) + 1'
                             if not args.max_slot_sets else 'cli',
            'max_day_sets': f'observed longest session ({observed_max_day} sets)'
                            if not args.max_day_sets else 'cli',
            'min_slot_sets': 'rx-calc MUSCLE_TRIM_FLOOR_SETS',
            'unilateral_floor_share': UNILATERAL_FLOOR_DERIVATION
                                      if args.unilateral_floor_share
                                      == UNILATERAL_FLOOR_SHARE_DEFAULT
                                      else 'cli',
        },
        'band_provenance': BAND_PROVENANCE,
        'focus_muscles': sorted(led.focus_muscles),
        'units': [
            {
                'unit': u,
                'band': {'floor': led.bands[u][0], 'target': led.bands[u][1],
                         'ceiling': led.bands[u][2], 'focus': led.bands[u][3],
                         'source': led.bands[u][4]},
                'before': before_vals[u],
                'after': after_vals[u],
                'delta': round(after_vals[u] - before_vals[u], 3),
            } for u in led.units
        ],
        'deficits_before': deficits,
        'adherence_gaps': adherence,
        'moves': [
            {
                'kind': m.kind, 'day': m.day, 'exercise': m.name,
                'delta_sets': m.delta, 'serves': m.serves,
                'cost_delta': round(m.cost_delta, 4),
                'caution': m.caution,
                'new_slot': m.slot,
                'label': m.label(),
            } for m in accepted
        ],
        'unresolved': unresolved,
        'session_length': {
            'before': {d: day_set_total(program, d)
                       for d in (program.get('rotation') or [])},
            'after': {d: day_set_total(after, d)
                      for d in (after.get('rotation') or [])},
            'weekly_before': weekly_set_total(program),
            'weekly_after': weekly_set_total(after),
        },
        'priority_invariants': priority_check(program, after),
        # COORDINATION AXIS. Asserted on the OUTPUT, not trusted: the allocator
        # has no ordering and no removal move, so its proposal must show zero
        # refusals -- and if a future move type ever breaks that, this is where
        # it fails rather than in the owner's program.
        'unilateral': {
            'before': uni_before,
            'after': uni_after,
            'floor_before': uni_floor_before,
            'floor_after': uni_floor_after,
            'refusals': unilateral_refusals(program, after),
        },
        # THE AXIS, both sub-measures. `unilateral` above is one of them and
        # keeps its key/shape because the FLOOR is defined on it; this is the
        # axis reading, and the axis is what the owner named.
        'coordination': {
            'before': coordination_reading(uni_before, ctl_before,
                                           led.db_path),
            'after': coordination_reading(uni_after, ctl_after, led.db_path),
            'control_before': ctl_before,
            'control_after': ctl_after,
        },
        'rounds': rounds,
        'apply': 'NOT APPLIED -- proposal only. program.yaml is untouched.',
    }


def priority_check(before, after):
    """The allocator must never disturb the 2026-08-24 slot-priority rule.

    It has no ordering move at all -- adds/trims change `sets`, a new slot
    enters at the accessory band. This asserts that outcome rather than
    trusting it: per day, the priority SEQUENCE of pre-existing slots must be
    unchanged, every new slot must sit strictly after every rehab/prehab/focus
    slot (the cut-line guard), and no new slot may enter a non-accessory band.
    """
    out = {'ok': True, 'checks': []}
    for day in (after.get('rotation') or []):
        old = [(ex.get('name'), ex.get('priority'))
               for ex in rx.day_work_items(before, day)]
        new = [(ex.get('name'), ex.get('priority'))
               for ex in rx.day_work_items(after, day)]
        old_names = {n for n, _p in old}
        kept = [(n, p) for n, p in new if n in old_names]
        if kept != old:
            out['ok'] = False
            out['checks'].append(
                {'day': day, 'check': 'existing_order_preserved', 'ok': False})
        added = [(n, p) for n, p in new if n not in old_names]
        guard_max = max(
            [int(ex.get('priority', 0)) for ex in rx.day_work_items(before, day)
             if ex.get('role') in ('rehab', 'prehab', 'focus', 'main')] or [0])
        for n, p in added:
            ok = isinstance(p, int) and p >= 400 and p > guard_max
            if not ok:
                out['ok'] = False
            out['checks'].append(
                {'day': day, 'check': 'new_slot_in_cut_zone',
                 'exercise': n, 'priority': p, 'ok': ok})
    return out


# ---------------------------------------------------------------------------
# COORDINATION AXIS -- THE UNILATERAL FLOOR  (owner rule, 2026-08-24)
# ---------------------------------------------------------------------------
#
# THE RULE, IN THE OWNER'S OWN WORDS:
#
#     "프리웨이트에서도 협응을 많이 요구하는 것들이 있잖아 주로 편측 운동이 그렇고.
#      그냥 SBD만 하면 몸이 망가지더라고"
#
# That is not a taste. It is a finding the owner made with their own body, and the
# program was already collapsing in exactly the direction they named. Measured on
# 2026-08-24 against the live program and workout_sets:
#
#     31 work slots carry 4 unilateral markers (13.68% of 95 weekly sets)
#       앞A single_leg_extension · 앞B single_leg_extension
#       뒷A leg_curl            · 뒷B bulgarian_split_squat
#     three of the four are lower body; UPPER-BODY UNILATERAL = 0
#     all four sit at position 3 or 4 -- i.e. right at the observed cut depth
#     08-20 (session 10088) ended at slot 3 and ate 앞B single_leg_extension
#     08-21 (session 10089) ended at slot 2 and ate the rest of that day
#     5 of the 6 truncated sessions on record delivered ZERO unilateral sets
#
# So truncation was eating the COORDINATION work first and leaving precisely the
# bilateral-heavy shape the owner says wrecked them. The 2026-08-24 priority rule
# happened to save those slots, but it saved them as REHAB slots -- the
# coordination reason was never written down anywhere, so nothing protected them
# AS coordination work. This block is that missing reason, in code.
#
# WHY THIS IS A FLOOR AND NOT A GRADE. The design of record considered ranking
# movements by how much coordination they demand and rejected it: the owner's
# own counter-example ("필라테스는 이 연결을 극대화하는 운동에 가깝고") shows
# coordination is INDEPENDENT of load, so any ladder derived from load is wrong.
# A floor needs no ladder. It only needs to know what is unilateral -- which is
# already recorded data -- and to refuse to go below it.
#
# ---- SETS OR SLOTS? SETS, and the reason matters --------------------------
# The floor is counted in weekly PRESCRIBED SETS, with the slot count reported
# alongside. Three reasons, in order:
#   1. ONE UNIT. Every other quantity this module optimises -- band floors,
#      band ceilings, session length, every allocator move -- is weekly sets. A
#      slot-count floor would be a second unit in the same ledger.
#   2. IT MATCHES THE EROSION MODE. The allocator's cheapest legal move is
#      `trim`, one set at a time, and trims never change the slot count. A
#      slot-count floor would watch leg_curl go 4 sets -> 2 and still read
#      "4/31 slots, fine". Sets is the only unit that sees that.
#   3. IT MATCHES THE LOSS. A short session ends mid-slot; what it costs is
#      sets, not slots.
# The floor's SECOND arm is deliberately counted in slots -- "at least one
# unilateral slot per training day" -- because a day cannot hold 0.4 of a slot,
# and because a pure share floor could be satisfied by piling all the
# coordination work onto one day and leaving three days bilateral.
#
# ---- WHERE THE FLOOR NUMBER COMES FROM ------------------------------------
# THIS IS A JUDGEMENT VALUE. There is no verified science behind it, exactly as
# this module already says out loud about the volume bands ("NO verified
# per-subregion numbers exist"). It is not imported from any literature. It is
# derived from the owner's own program and their own delivered history, and it is
# an INPUT (--unilateral-floor-share / --unilateral-min-per-day), never a truth:
#
#   prescription (program.yaml, 2026-08-24)  13.68% of weekly sets (13/95)
#                                            12.90% of slots       (4/31)
#   delivered (workout_sets, 21 sessions that reached >= 5 slots)
#                                            median 14.3%, mean 14.7%,
#                                            max 21.9%
#   per day  the owner's own program puts exactly ONE unilateral slot on each
#            of the 4 rotation days -- 4/4, authored by them, not by a machine
#
# The floor is set just BELOW what the owner already does, so that it measures
# EROSION rather than ratifying the status quo as a target:
#     0.12  -- one legitimate one-set trim on a unilateral slot lands at
#              12/94 = 12.8% and does NOT cry wolf; losing a whole 3-set
#              unilateral slot lands at 10/92 = 10.9% and DOES.
# A gate that cries wolf is a gate that gets bypassed -- the same reasoning the
# band arm of this gate already uses for its baseline rule.
UNILATERAL_FLOOR_SHARE_DEFAULT = 0.12
UNILATERAL_MIN_PER_DAY_DEFAULT = 1
UNILATERAL_FLOOR_DERIVATION = (
    'JUDGEMENT VALUE, derived from the owner only -- prescription 13.68% of '
    'weekly sets (13/95) and 12.90% of slots (4/31); delivered median 14.3% '
    'over 21 sessions that reached >=5 slots (workout_sets, 2026-08-24). Set '
    'just below both so it measures erosion, not the status quo. No literature '
    'number was imported. Tunable: --unilateral-floor-share.')
UNILATERAL_PER_DAY_DERIVATION = (
    "JUDGEMENT VALUE -- the owner's own program carries exactly one unilateral "
    'slot on each of the 4 rotation days (4/4). Tunable: '
    '--unilateral-min-per-day.')

# UPPER / LOWER / CORE is a PARTITION of rx-calc's own closed MUSCLE_VOCAB --
# every muscle rx-calc knows, placed exactly once. It is NOT a second exercise
# classifier: it is used ONLY to report WHERE the unilateral work sits, never to
# decide WHETHER something is unilateral. A vocabulary entry missing from here
# is surfaced (region_vocab_gap), not silently bucketed.
MUSCLE_REGION = {
    'chest': 'upper', 'back': 'upper', 'shoulders': 'upper',
    'biceps': 'upper', 'triceps': 'upper', 'forearms': 'upper',
    'quads': 'lower', 'hamstrings': 'lower', 'glutes': 'lower',
    'calves': 'lower',
    'abs': 'core',
}


def slot_region(name, led):
    """'upper' | 'lower' | 'core' | 'unknown' for one slot, from the DB muscle
    map (primary muscles first). Never guessed from the exercise's NAME."""
    if led is None:
        return 'unknown'
    prim = [m for m, role in led.muscle_map.get(name, []) if role == 'primary']
    if not prim:
        prim = [m for m, _r in led.muscle_map.get(name, [])]
    regions = [MUSCLE_REGION.get(m) for m in prim]
    regions = [r for r in regions if r]
    if not regions:
        return 'unknown'
    # A slot counts for the region most of its primary muscles sit in; ties go
    # to the first in rx.MUSCLE_VOCAB order so the answer is deterministic.
    best, best_n = 'unknown', -1
    for r in ('upper', 'lower', 'core'):
        n = regions.count(r)
        if n > best_n:
            best, best_n = r, n
    return best


def unilateral_census(program, led=None):
    """Count ONE sub-measure of the coordination axis -- 편측 비중.

    NOT the whole axis. The other sub-measure is control_census(); the two are
    assembled by coordination_reading(). This one drives the FLOOR, which is
    why it stays exactly as it was: the floor was derived from these numbers.

    Reports BOTH units; the floor uses sets."""
    slots, per_day = [], {}
    tot_slots = tot_sets = uni_slots = uni_sets = 0
    by_region = {'upper': 0, 'lower': 0, 'core': 0, 'unknown': 0}
    region_sets = {'upper': 0, 'lower': 0, 'core': 0, 'unknown': 0}
    for day in (program.get('rotation') or []):
        d = per_day.setdefault(day, {'slots': 0, 'sets': 0,
                                     'uni_slots': 0, 'uni_sets': 0})
        for i, ex in enumerate(rx.day_work_items(program, day), 1):
            name = ex.get('name')
            if not name:
                continue
            sets = int(ex.get('sets', 3) or 0)
            tot_slots += 1
            tot_sets += sets
            d['slots'] += 1
            d['sets'] += sets
            if not is_unilateral(ex):
                continue
            region = slot_region(name, led)
            uni_slots += 1
            uni_sets += sets
            d['uni_slots'] += 1
            d['uni_sets'] += sets
            by_region[region] = by_region.get(region, 0) + 1
            region_sets[region] = region_sets.get(region, 0) + sets
            slots.append({
                'day': day, 'position': i, 'exercise': name,
                'priority': ex.get('priority'),
                'band': priority_band(ex.get('priority')),
                'role': ex.get('role'), 'sets': sets, 'region': region,
                'mode': (ex.get('unilateral') or {}).get('mode')
                        if isinstance(ex.get('unilateral'), dict) else None,
                'in_cut_zone': priority_band(ex.get('priority')) >= 400,
            })
    gap = [m for m in rx.MUSCLE_VOCAB if m not in MUSCLE_REGION]
    return {
        'classifier': 'exercise-enter.extract_record_params '
                      '(program.yaml `unilateral` block authoritative; prose '
                      'scan only as JIT fallback)',
        'slots': slots,
        'totals': {'slots': tot_slots, 'sets': tot_sets,
                   'unilateral_slots': uni_slots, 'unilateral_sets': uni_sets},
        'share_sets': round(uni_sets / tot_sets, 4) if tot_sets else 0.0,
        'share_slots': round(uni_slots / tot_slots, 4) if tot_slots else 0.0,
        'per_day': per_day,
        'by_region_slots': by_region,
        'by_region_sets': region_sets,
        'region_vocab_gap': gap,
    }


def control_census(program, prep=None, db_path=None):
    """Count the SECOND and THIRD coordination sub-measures -- 무하중 통제
    비중 (holds) and 느린 제어 비중 (controlled tempo, the Pilates marker).

    Counted across ALL THREE blocks. The work block is counted in SETS (the
    unit the program prescribes); 준비운동/쿨다운 drills have no sets and are
    counted as ITEMS. The two units are kept apart deliberately -- inventing a
    set-equivalent for a drill would be a fabricated number, and this axis got
    lost the first time precisely by being converted into whatever number
    happened to be nearby.

    `union_*` counts work sets that are unilateral OR zero-load control. That
    IS legitimately one number: one unit, one denominator, a set qualifying by
    either path counted once. `connection_union_work_sets` is the same shape
    over the connection strand's measure set -- unilateral OR controlled tempo
    (2026-09-30: holds no longer stand for Pilates).

    `tempo_unreadable` names work slots whose tempo is not the four-phase
    notation: not counted, not scored fast either.

    `unmeasured` lists unloaded drills carrying no control marker. They are not
    counted as coordination and they are not counted as zero either -- they are
    named, so the hole is visible in the readout rather than absent from it."""
    work_slots, drills, unmeasured, per_day = [], [], [], {}
    tempo_slots, tempo_unreadable = [], []
    tot_sets = ctl_sets = union_sets = 0
    tempo_sets = conn_sets = 0
    tot_items = ctl_items = 0
    for day in (program.get('rotation') or []):
        d = per_day.setdefault(day, {'sets': 0, 'control_sets': 0,
                                     'union_sets': 0, 'control_items': 0,
                                     'tempo_sets': 0,
                                     'connection_union_sets': 0})
        for i, ex in enumerate(rx.day_work_items(program, day), 1):
            if not ex.get('name'):
                continue
            sets = int(ex.get('sets', 3) or 0)
            tot_sets += sets
            d['sets'] += sets
            ctl = is_zero_load_control(ex)
            uni = is_unilateral(ex)
            tmp = is_controlled_tempo(ex, db_path)
            raw_tempo, tempo_src = slot_tempo(ex, db_path)
            if tmp:
                tempo_sets += sets
                d['tempo_sets'] += sets
                tempo_slots.append({
                    'day': day, 'position': i, 'exercise': ex.get('name'),
                    'sets': sets, 'tempo': raw_tempo,
                    'tempo_source': tempo_src,
                    'weight_kg': ex.get('weight_kg'),
                })
            elif raw_tempo is not None and parse_tempo(raw_tempo) is None:
                tempo_unreadable.append({
                    'day': day, 'position': i, 'exercise': ex.get('name'),
                    'tempo': raw_tempo, 'tempo_source': tempo_src})
            if uni or tmp:
                conn_sets += sets
                d['connection_union_sets'] += sets
            if ctl:
                ctl_sets += sets
                d['control_sets'] += sets
                work_slots.append({
                    'day': day, 'position': i, 'exercise': ex.get('name'),
                    'sets': sets, 'priority': ex.get('priority'),
                    'role': ex.get('role'),
                    'weight_kg': ex.get('weight_kg'),
                    'progression': ex.get('progression'),
                })
            if ctl or uni:
                union_sets += sets
                d['union_sets'] += sets
        # 준비운동 / 쿨다운. rx.day_blocks is the read-path that sees the day as
        # three peer collections; day_work_items (used above) cannot see these
        # at all, which is exactly why their coordination contribution read 0.
        for b in rx.day_blocks(program, prep or {}, day):
            if b.get('kind') == 'work':
                continue
            for it in (b.get('items') or []):
                if not isinstance(it, dict):
                    continue
                tot_items += 1
                impl = drill_implement(prep, it)
                if is_control_drill(prep, it):
                    ctl_items += 1
                    d['control_items'] += 1
                    drills.append({'day': day, 'block': b.get('kind'),
                                   'code': it.get('code'),
                                   'hold_sec': it.get('hold_sec'),
                                   'phase': it.get('phase')})
                elif not impl:
                    unmeasured.append({'day': day, 'block': b.get('kind'),
                                       'code': it.get('code'),
                                       'phase': it.get('phase'),
                                       'why': 'unloaded, but no control marker '
                                              '(hold_sec) -- not counted, and '
                                              'not scored 0 either'})
    return {
        'classifier': 'work holds: rx-calc._is_isometric_hold  |  '
                      'work controlled tempo: slot tempo, else '
                      'ax_exercise.tempo (%s)  |  '
                      '준비운동·쿨다운: hold_sec AND no drills.<code>.implement '
                      '(load_type is NOT consulted anywhere)'
                      % CONTROLLED_TEMPO_DERIVATION,
        'work': {'sets': tot_sets, 'control_sets': ctl_sets,
                 'share_sets': round(ctl_sets / tot_sets, 4) if tot_sets else 0.0,
                 'slots': work_slots},
        'prep_cooldown': {'items': tot_items, 'control_items': ctl_items,
                          'share_items': round(ctl_items / tot_items, 4)
                                         if tot_items else 0.0,
                          'drills': drills},
        'tempo': {'sets': tot_sets, 'tempo_sets': tempo_sets,
