        a('  %-24s %6.2f%%  (%d/%d %s)'
          % (s['label'], s['value'] * 100, s['numerator'], s['denominator'],
             s['unit']))
        a('      %s' % s['note'])
    c = reading['connection_union_work_sets']
    a('  연결 합집합(편측 OR 느린 제어) 작업 세트: %.2f%% (%d/%d)'
      % (c['share_sets'] * 100, c['sets'], c['total']))
