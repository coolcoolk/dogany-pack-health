            a('      %s (%s)' % (m['code'], m['phase']))
    bp = reading['baseline_proposal']
    a('  [기준선 제안] 출처: %s / 확인 문항 %d개 / 목표치: 제안 안 함'
      % (bp['derived_from'], bp['asks']))
    a('      %s' % bp['target_note'])
    return '\n'.join(L)


