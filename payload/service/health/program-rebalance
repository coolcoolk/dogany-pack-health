def _reason_ko(code):
    head = code.split(':')[0]
    ko = UNRESOLVED_KO.get(head)
    if ko is not None and '{user}' in ko:
        ko = ko.replace('{user}', _user())
    if ko is None:
        if head == 'SESSION_LENGTH_CAP':
            ko = '세션 길이 상한에 걸림 -- 상한을 올리거나 다른 곳을 트림해야 함'
        elif head == 'SLOT_SET_CAP':
            ko = '슬롯당 세트 상한에 걸림'
        else:
            ko = head
    tail = code.split(':', 1)[1].strip() if ':' in code else ''
    return f'{ko} [{tail}]' if tail else ko


def render_coordination(reading):
    """The AXIS readout: both sub-measures, in their own units, plus the hole.

    Rendered even when a sub-measure is 0 -- an axis line that disappears when
    it has nothing to show is how the gap survived. `unmeasured` is printed for
    the same reason."""
    L = []
    a = L.append
    a('[COORDINATION] %s 축 -- 하위 측정 각자, 하중과 독립 (%s 룰링 2026-08-24)'
      % (reading['label'], _user()))
    a('  근거: 필라테스류는 하중이 아니라 이 연결을 극대화하는 운동에 가깝다.')
