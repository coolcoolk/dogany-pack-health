def main():
    ap = argparse.ArgumentParser(
        prog='program-rebalance',
        description='Volume allocator + edit gate for program.yaml. '
                    'Proposes; never writes.')
    ap.add_argument('program')
    ap.add_argument('today')
    ap.add_argument('db')
    ap.add_argument('--gate', action='store_true',
                    help='invariant gate mode instead of allocation')
    ap.add_argument('--order', action='store_true',
                    help='ordering solver (zone hop + intra-session fatigue) '
                         'INSIDE the priority bands')
    ap.add_argument('--baseline', default=None,
                    help='gate mode: baseline program.yaml (default: git HEAD)')
    # default=None on purpose: absence means "ask the stored purpose"
    # (resolve_objective_from_purpose). Defaulting to a constant here is what
    # made the owner's stored answer unreadable in the first place.
    ap.add_argument('--objective', default=None,
                    choices=sorted(OBJECTIVES))
    ap.add_argument('--objective-weights', default=None,
                    help='JSON dict overriding individual objective weights')
    ap.add_argument('--layer', default='both',
                    choices=['group', 'subregion', 'both'])
    ap.add_argument('--max-slot-sets', type=int, default=None)
    ap.add_argument('--max-day-sets', type=int, default=None)
    ap.add_argument('--new-slot-sets', type=int, default=3)
    # COORDINATION FLOOR -- judgement values, tunable on purpose. See
    # UNILATERAL_FLOOR_DERIVATION: they are derived from the owner's own
    # program and delivered history, not imported from any literature.
    ap.add_argument('--unilateral-floor-share', type=float,
                    default=UNILATERAL_FLOOR_SHARE_DEFAULT,
                    help='minimum share of weekly PRESCRIBED SETS that must be '
                         'unilateral (judgement value, default %.2f)'
                         % UNILATERAL_FLOOR_SHARE_DEFAULT)
    ap.add_argument('--unilateral-min-per-day', type=int,
                    default=UNILATERAL_MIN_PER_DAY_DEFAULT,
                    help='minimum unilateral SLOTS per rotation day '
                         '(judgement value, default %d)'
                         % UNILATERAL_MIN_PER_DAY_DEFAULT)
    ap.add_argument('--max-rounds', type=int, default=40)
    ap.add_argument('--json', action='store_true')
    args = ap.parse_args()

    for path in (args.program, args.db):
        if not os.path.exists(path):
            print(f'[program-rebalance] ERROR: not found: {path}',
                  file=sys.stderr)
            sys.exit(1)

    if args.order:
        program = rx.load_yaml(args.program)
        led = Ledger(args.db, program, args.layer)
        o = solve_order(program, led, os.path.join(DATA_DIR, 'gym-layout.md'),
                        os.path.abspath(args.program))
        print(json.dumps(o, ensure_ascii=False, indent=2) if args.json
              else render_order(o))
        sys.exit(0)

    if args.gate:
        g = run_gate(args)
        print(json.dumps(g, ensure_ascii=False, indent=2) if args.json
              else render_gate(g))
        sys.exit(0 if g['ok'] else 4)

    p = build_proposal(args)
    print(json.dumps(p, ensure_ascii=False, indent=2) if args.json else render(p))
    sys.exit(3 if p['unresolved'] else 0)


if __name__ == '__main__':
    main()
