# The allocator
# ---------------------------------------------------------------------------

def classify_deficits(program, led, audit, vals):
    """Split every deficient unit into what the ALLOCATOR can act on and what
    it must hand back. Acting on the wrong class is how a program picks up
    sets it never needed.

      allocation      -- PRESCRIBED dose is under floor -> the allocator's job.
      adherence_gap   -- prescription is in band, DELIVERY (rolling 7d actual)
                         is not. Adding sets does not fix attendance; the
                         allocator refuses to touch it.
      coverage_hole   -- the unit has NO primary slot at all in the program.
                         Actionable only if the DB knows an exercise for it.
    """
    out = {}
    per_muscle = audit.get('per_muscle') or {}
    per_group = audit.get('per_group') or {}
    for u in led.units:
        floor_v = led.bands[u][0]
        v = vals[u]
        actual = None
        if u in per_muscle:
            actual = per_muscle[u]['actual_sets_7d']
        elif u in per_group:
            actual = per_group[u]['actual_sets_7d']
        has_primary = any(
            led.credit(ex.get('name', '')).get(u, 0.0) >= 1.0
            for _d, _i, ex in iter_slots(program))
        if v < floor_v - 1e-9:
            kind = 'coverage_hole' if not has_primary else 'allocation'
        elif actual is not None and actual < floor_v - 1e-9:
            kind = 'adherence_gap'
        else:
            continue
        out[u] = {'kind': kind, 'proposed': v, 'actual_7d': actual,
                  'floor': floor_v}
    return out


def unresolved_reasons(program, led, limits, unit):
    """WHY the allocator stopped short on this unit -- named, not shrugged.

    Vague "could not fix" is useless to the owner: the answer they need is
    whether to raise a cap, add an exercise to the catalogue, or argue with the
    objective. Each of those is a different sentence, so each gets its own
    code."""
    reasons = []
    servers = [(d, ex) for d, _i, ex in iter_slots(program)
               if led.credit(ex.get('name', '')).get(unit, 0.0) > 0]
    at_slot_cap = [(d, ex.get('name')) for d, ex in servers
                   if int(ex.get('sets', 3)) >= limits['max_slot_sets']]
    at_day_cap = [(d, ex.get('name')) for d, ex in servers
                  if day_set_total(program, d) + 1 > limits['max_day_sets']]
    if not servers:
        reasons.append('NO_SLOT_SERVES_UNIT')
    if at_day_cap:
        reasons.append('SESSION_LENGTH_CAP: ' + ', '.join(
            f'{d}({day_set_total(program, d)}/{limits["max_day_sets"]})'
            for d, _n in at_day_cap))
    if at_slot_cap and not at_day_cap:
        reasons.append('SLOT_SET_CAP: ' + ', '.join(
            f'{n}@{limits["max_slot_sets"]}' for _d, n in at_slot_cap))
    if not candidate_exercises(unit, led, program):
        reasons.append('NO_OTHER_CANDIDATE_IN_DB')
    else:
        rotation = program.get('rotation') or []
        if all(day_set_total(program, d) + limits['new_slot_sets']
               > limits['max_day_sets'] for d in rotation):
            reasons.append('NO_DAY_CAN_ABSORB_A_NEW_SLOT')
    if not reasons:
        reasons.append('OBJECTIVE_DECLINED')
    return reasons


def allocate(program, led, obj, limits, history, audit, max_rounds):
    """Greedy descent. Every accepted move is recorded WITH the cost delta that
    bought it, so the proposal reads as an argument, not an oracle.

    RANKING IS PER SET, NOT PER MOVE. The moves are not the same size -- a new
    slot brings 3 sets at once, a set-add brings 1 -- so ranking on raw
    cost_delta systematically prefers the bulkiest move and the allocator
    invents a slot where growing an existing one was cheaper. Ranking on
    cost_delta / sets-touched removes that bias; the ACCEPTANCE test stays on
    the raw total (a move must be a net improvement in absolute terms)."""
    state = copy.deepcopy(program)
    accepted = []
    rounds = 0
    while rounds < max_rounds:
        rounds += 1
        vals = unit_values(state, led)
        deficits = under_floor_units(vals, led)
        moves = generate_moves(state, led, obj, limits, history, deficits)
        moves = [m for m in moves if m.cost_delta < -1e-6]
        if not moves:
            break
        moves.sort(key=lambda m: (round(m.cost_delta / max(1, abs(m.delta)), 6),
                                  round(m.cost_delta, 6),
                                  m.kind, m.day, m.name))
        best = moves[0]
        best.apply(state)
        accepted.append(best)
    return state, accepted, rounds


def merge_moves(moves):
    """Fold repeated single-set moves on the same slot into one line.

    The greedy loop necessarily emits '+1 set' four times; the owner should
    read '+4 sets'. Order of first appearance is preserved so the proposal
    still reads in the order the allocator decided things."""
    order = []
    folded = {}
    for m in moves:
        k = (m.day, m.name)
        prev = folded.get(k)
        if prev is not None and prev.kind == m.kind == 'new':
            continue                       # cannot happen; defensive
        if prev is not None:
            prev.delta += m.delta
            prev.cost_delta += m.cost_delta
            if prev.kind == 'new':
                prev.slot['sets'] = prev.delta
            if m.caution and not prev.caution:
                prev.caution = m.caution
            continue
        folded[k] = m
        order.append(k)
    return [folded[k] for k in order]


