def _user(with_final=None, without_final=None):
    """How this instance addresses its owner -- ui_labels.user_label, degraded.

    Every line below that NAMES the reader goes through here instead of
    carrying a word. The pack shipped 「사용자」/「오너」 in owner-facing stdout
    while the instance that runs it sets DOGANY_USER_LABEL to its own term, so the
    register was being downgraded by every apply and the only available repair
    was to hand-edit literals back -- which is what produced the split.

    DEGRADE, never raise, in set-table._rir_header's style: a sandboxed tree
    holding a subset of service/health has no ui_labels.py, and an audit line
    must not be able to stop a rebalance. The fallback is ui_labels' OWN
    default, read straight from the environment here so the two answers cannot
    become two opinions."""
    try:
        if HERE not in sys.path:
            sys.path.insert(0, HERE)
        import ui_labels
        return ui_labels.user_label(with_final, without_final)
    except Exception:  # noqa: BLE001 -- module absent -> the neutral word
        name = (os.environ.get('DOGANY_USER_LABEL') or '').strip() or '사용자'
        if with_final is None and without_final is None:
            return name
        ch = name[-1]
        has = ('가' <= ch <= '힣') and (ord(ch) - 0xAC00) % 28 != 0
        return '%s%s' % (name, (with_final if has else without_final) or '')


