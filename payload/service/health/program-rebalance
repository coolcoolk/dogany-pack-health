def _phase_metric_objective(metric):
    if metric in PHASE_METRIC_OBJECTIVE:
        return PHASE_METRIC_OBJECTIVE[metric]
    for prefix, obj in PHASE_METRIC_PREFIX_OBJECTIVE:
        if metric and metric.startswith(prefix):
            return obj
    return None


def objective_from_phase(conn):
    """(objective, source_label) from the user's own strands, or None.

    Current phase = the strands with the lowest phase_order (an order choice
    was made), else the strands that carry an active goal (no pull-apart pair,
    so no order was needed). Two objectives in one phase (the user chose to do
    both together) resolve to `functional`: the recomposition reading, floors
    held, no pure growth push."""
    import json as _json
    import sqlite3 as _sqlite3
    try:
        strands = conn.execute(
            "SELECT axis_key, label, phase_order FROM metric_axis "
            "WHERE origin='user' AND role='picture' "
            "ORDER BY axis_rank, axis_key").fetchall()
    except _sqlite3.Error:
        return None                    # pre-055 kit: no user strands at all
    if not strands:
        return None
    ordered = [r for r in strands if r[2] is not None]
    if ordered:
        first = min(r[2] for r in ordered)
        current = [r for r in ordered if r[2] == first]
        basis = 'phase_order'
    else:
        keys = set()
        try:
            for (detail,) in conn.execute(
                    "SELECT detail FROM ledger_goal WHERE status='active' "
                    "AND detail IS NOT NULL AND detail <> ''"):
                try:
                    d = _json.loads(detail)
                except (ValueError, TypeError):
                    continue
                if isinstance(d, dict) and d.get('axis_key'):
                    keys.add(d['axis_key'])
        except _sqlite3.Error:
            return None
        current = [r for r in strands if r[0] in keys]
        basis = 'active_goal'
    if not current:
        return None
    objectives, labels = set(), []
    for key, label, _order in current:
        try:
            mets = [m for (m,) in conn.execute(
                "SELECT metric_token FROM goal_metric_source WHERE axis_key=?",
                (key,))]
        except _sqlite3.Error:
            mets = []
        for m in mets:
            obj = _phase_metric_objective(m)
            if obj:
                objectives.add(obj)
                labels.append(label)
                break
    if not objectives:
        return None
    obj = objectives.pop() if len(objectives) == 1 else 'functional'
    return obj, 'db:%s:%s' % (basis, '+'.join(labels))


def resolve_objective_from_purpose(db_path):
    """Return (objective_name, source_label).

    source_label is ALWAYS reported so a fallback can never be mistaken for a
    stored answer. That indistinguishability is how the stale constant above
    survived unnoticed for weeks.
      db:phase_order:<strands> -- the user's order choice decided this
      db:active_goal:<strands> -- no order was needed; the current goal did
      db:<value>        -- a LEGACY stored tradeoff_priority decided this
      fallback:no-value -- nothing stored; module default applied
      fallback:unmapped:<value> -- stored, but no objective maps to it (a
                           consult/module vocabulary drift -- surfaced, not
                           silently swallowed)
    """
    import json as _json
    import sqlite3 as _sqlite3
    try:
        conn = _sqlite3.connect('file:%s?mode=ro' % db_path, uri=True)
        try:
            phase = objective_from_phase(conn)
        finally:
            conn.close()
    except Exception:
        phase = None
    if phase:
        return phase
    try:
        conn = _sqlite3.connect('file:%s?mode=ro' % db_path, uri=True)
        try:
            rows = conn.execute(
                "SELECT layer, detail FROM ledger_goal WHERE detail IS NOT ''"
            ).fetchall()
        finally:
            conn.close()
    except Exception as exc:
        return DEFAULT_OBJECTIVE, 'fallback:db-unreadable:%s' % type(exc).__name__

    # Purpose is a direction-level fact: prefer the long layer, then any layer.
    stored = None
    for want in ('long', None):
        for layer, detail in rows:
            if want is not None and layer != want:
                continue
            try:
                parsed = _json.loads(detail) if detail else {}
            except Exception:
                continue
            val = parsed.get('tradeoff_priority') if isinstance(parsed, dict) else None
            if val:
                stored = val
                break
        if stored:
            break

    if not stored:
        return DEFAULT_OBJECTIVE, 'fallback:no-value'
    mapped = PURPOSE_TO_OBJECTIVE.get(stored)
    if not mapped:
        return DEFAULT_OBJECTIVE, 'fallback:unmapped:%s' % stored
    return mapped, 'db:%s' % stored

# Provenance of every number the allocator optimises against. Printed verbatim
# in the report -- the owner must be able to see WHAT grade of evidence the
# machine just optimised on.
BAND_PROVENANCE = {
    'group': 'rx-calc GROUP_MUSCLE_BANDS -- "PROVISIONAL" (rx-calc comment); '
             'hypertrophy practice landmarks, grade C-D',
    'subregion': 'rx-calc GROUP_BANDS_4 -- "NO verified per-subregion numbers '
                 'exist, volume-research 2026-07-18 MAJOR GAP" (rx-calc '
                 'comment); Israetel/RP practitioner anchors, grade C-D',
    'override': 'program.yaml volume_bands -- owner override, wins over both',
}

# `shoulders` is the one group-layer muscle rx-calc deliberately DECOMPOSES:
# its sub-region layer bands side_delt and rear_delt separately (front_delt is
# tracked but unbanded -- pressing credit, no researched target). Scoring both
# `shoulders` AND side/rear would double-count the same sets, so in the default
# 'both' layer the group-level shoulders row is dropped in favour of the two
# finer units. This mapping is the ONLY place that relationship is written
# down on this side; it mirrors rx-calc's own comment at GROUP_MUSCLE_BANDS.
DECOMPOSED_GROUP_MUSCLES = {'shoulders': ('side_delt', 'rear_delt')}

# Banding units that are not themselves entries in rx.MUSCLE_VOCAB. Their
# parent muscle decides whether the focus bonus applies.
UNIT_PARENT_MUSCLE = {'side_delt': 'shoulders', 'rear_delt': 'shoulders'}

# The role a machine-proposed NEW slot enters at. An added slot is by
# construction an extra dose for an under-served region, never one of the day's
# opening lifts -- so it lands in the accessory band (400+), which is also the
# CUT ZONE. That is the honest placement: if the session gets cut short, the
# thing that gets dropped is the machine's addition, not the owner's rehab or
# focus slot. Owner can re-band it on approval.
NEW_SLOT_ROLE = 'accessory'
NEW_SLOT_PRIORITY_STEP = 10
# How many DB candidates per deficient unit enter the move pool each round.
# The greedy loop re-ranks every round anyway; the shortlist only bounds work.
NEW_SLOT_SHORTLIST = 3


# ---------------------------------------------------------------------------
# Scoring units + bands  (all band arithmetic delegates to rx-calc)
# ---------------------------------------------------------------------------

def unit_band(unit, program, focus_muscles):
    """(floor, target, ceiling, focus, source) for one scoring unit.

    MUSCLE_VOCAB units go straight through rx.resolve_band -- program.yaml
    volume_bands override, class band and MUSCLE_FOCUS_BONUS all handled there,
    not re-implemented here. Banding-only units (side_delt / rear_delt) read
    rx.GROUP_BANDS_4 and then apply the SAME two adjustments in the same order,
    because rx-calc's sub-region layer has no band-resolution helper of its own
    (its verdicts read GROUP_BANDS_4 raw -- see rx-calc subregion_layer)."""
    if unit in rx.MUSCLE_VOCAB:
        b = rx.resolve_band(unit, program, focus_muscles)
        src = 'override' if (program.get('volume_bands') or {}).get(unit) \
            else 'group'
        return b['floor'], b['target'], b['ceiling'], b['focus'], src
    mev, mav_lo, _mav_hi, mrv = rx.GROUP_BANDS_4[unit]
    floor_v, target_v, ceiling_v = mev, mav_lo, mrv
    src = 'subregion'
    ov = (program.get('volume_bands') or {}).get(unit)
    if isinstance(ov, dict):
        floor_v = ov.get('floor', floor_v)
        target_v = ov.get('target', target_v)
        ceiling_v = ov.get('ceiling', ceiling_v)
        src = 'override'
    parent = UNIT_PARENT_MUSCLE.get(unit, unit)
    focus = parent in focus_muscles
    if focus:
        target_v += rx.MUSCLE_FOCUS_BONUS
        ceiling_v += rx.MUSCLE_FOCUS_BONUS
    return floor_v, target_v, ceiling_v, focus, src


def scoring_units(layer):
    """Ordered list of units the allocator optimises over.

    layer='group'      -- rx.MUSCLE_VOCAB only (exactly volume_audit's
                          per_muscle ledger).
    layer='subregion'  -- rx.GROUP_BANDS_4 banding units only.
    layer='both'       -- union, minus the decomposed group muscles whose
                          finer units are already present (see
                          DECOMPOSED_GROUP_MUSCLES) and minus any group muscle
                          that IS a banding unit under the same name.
    """
    group = list(rx.MUSCLE_VOCAB)
    subs = sorted(rx.GROUP_BANDS_4)
    if layer == 'group':
        return group
    if layer == 'subregion':
        return subs
    out = list(subs)
    for m in group:
        if m in rx.GROUP_BANDS_4:
            continue                       # same unit, finer ledger wins
        if m in DECOMPOSED_GROUP_MUSCLES:
            continue                       # would double-count side/rear
        out.append(m)
    return out


class Ledger:
    """Everything read from the DB once, so the greedy loop never re-queries."""

    def __init__(self, db_path, program, layer):
        rx._use_tax_db(db_path)            # binds rx.SUBREGION_GROUP to the DB
        self.db_path = db_path
        self.muscle_map = rx.get_muscle_map(db_path)
        self.submap = rx.get_subregion_map(db_path)
        self.pattern_map = rx.get_pattern_map(db_path)
        self.cost_map = rx.get_fatigue_cost_map(db_path)
        self.focus_muscles, self.unexpanded_focus = rx.get_focus_muscles(
            db_path, program)
        self.subregion_group = dict(rx.SUBREGION_GROUP)
        self.units = scoring_units(layer)
        self.bands = {u: unit_band(u, program, self.focus_muscles)
                      for u in self.units}

    def fatigue(self, name):
        return rx.resolve_fatigue_cost(name, self.cost_map, self.pattern_map)[0]

    def credit(self, name):
        """{unit: weekly-set credit per ONE prescribed set of `name`}.

        Group-layer credit is rx-calc's role weight (primary 1.0 / secondary
        MUSCLE_SET_WEIGHT_SECONDARY); sub-region credit is the
        exercise_subregion weight, summed onto its banding unit. Same
        arithmetic proposed_sets / proposed_subregion_sets use -- the numbers
        this returns must reconcile with theirs, which test-program-rebalance
        asserts directly against rx-calc rather than against a copy."""
        out = {}
        for muscle, role in self.muscle_map.get(name, []):
            if muscle in self.bands:
                w = 1.0 if role == 'primary' else rx.MUSCLE_SET_WEIGHT_SECONDARY
                out[muscle] = out.get(muscle, 0.0) + w
        for sub, weight, _grade in self.submap.get(name, []):
            unit = self.subregion_group.get(sub, sub)
            if unit in self.bands:
                out[unit] = out.get(unit, 0.0) + weight
        return out


def unit_values(program, led):
    """{unit: proposed weekly effective sets} for the given program state.

    Delegates to rx.proposed_sets / rx.proposed_subregion_sets so the values
    are byte-identical with what --volume-audit will report on the same
    program. NOT recomputed from self.credit()."""
    per_muscle, _unmapped, _f, _d = rx.proposed_sets(program, led.muscle_map)
    per_sub, _unmapped_sub = rx.proposed_subregion_sets(
        program, led.submap, led.muscle_map)
    vals = {}
    for u in led.units:
        if u in rx.GROUP_BANDS_4:
            members = [s for s, unit in led.subregion_group.items() if unit == u]
            vals[u] = round(sum(per_sub.get(s, 0.0) for s in members), 4)
        else:
            vals[u] = round(per_muscle.get(u, 0.0), 4)
    return vals


def band_cost(vals, led, obj):
    """The band part of the objective, per unit and summed."""
    total = 0.0
    for u in led.units:
        floor_v, target_v, ceiling_v, _focus, _src = led.bands[u]
        v = vals[u]
        c = (obj['w_floor'] * max(0.0, floor_v - v)
             + obj['w_ceiling'] * max(0.0, v - ceiling_v)
             + obj['w_target'] * abs(v - target_v))
        total += c
    return total


# ---------------------------------------------------------------------------
# Program state helpers
# ---------------------------------------------------------------------------

def iter_slots(program):
    """(day, index, slot_dict) over the WORK block only -- rx.day_work_items is
    the single volume-eligible collection, so a prep drill can never be
    proposed a set."""
    for day in (program.get('rotation') or []):
        for i, ex in enumerate(rx.day_work_items(program, day)):
            yield day, i, ex


def day_set_total(program, day):
    return sum(int(ex.get('sets', 3) or 0) for ex in rx.day_work_items(program, day))


def weekly_set_total(program):
    return sum(day_set_total(program, d) for d in (program.get('rotation') or []))


def find_slot(program, day, name):
    for ex in rx.day_work_items(program, day):
        if ex.get('name') == name:
            return ex
    return None


def program_exercise_names(program):
    return {ex.get('name') for _d, _i, ex in iter_slots(program) if ex.get('name')}


def safety_flag(name, day, history):
    """The slot's recorded safety prose, if any -- program-history.json
    safety_notes keyed `<day>.<slot>.<name>`. A move that touches a slot with a
    recorded injury rationale is CAUTION-flagged; the machine is not allowed to
    quietly add load to a slot that exists under an injury protocol."""
    notes = (history or {}).get('safety_notes') or {}
    for key, prose in notes.items():
        parts = key.split('.')
        if len(parts) >= 3 and parts[0] == day and '.'.join(parts[2:]) == name:
            return prose
    return None


# ---------------------------------------------------------------------------
# Moves
# ---------------------------------------------------------------------------

class Move:
    """One atomic, reversible edit proposal."""

    def __init__(self, kind, day, name, delta=0, slot=None, serves=None):
        self.kind = kind          # 'add' | 'trim' | 'new'
        self.day = day
        self.name = name
        self.delta = delta        # sets added (+) / removed (-)
        self.slot = slot          # the new slot dict, for kind == 'new'
        self.serves = serves or []
        self.cost_delta = 0.0
        self.caution = None

    def key(self):
        return (self.kind, self.day, self.name)

    def apply(self, program):
        if self.kind == 'new':
            program['days'][self.day]['exercises'].append(copy.deepcopy(self.slot))
            return
        ex = find_slot(program, self.day, self.name)
        ex['sets'] = int(ex.get('sets', 3)) + self.delta

    def label(self):
        if self.kind == 'new':
            return (f"{self.day} NEW slot {self.name} "
                    f"x{self.slot.get('sets')} sets "
                    f"(priority {self.slot.get('priority')}, "
                    f"role {self.slot.get('role')})")
        sign = '+' if self.delta > 0 else ''
        ex_sets = self.delta
        return f"{self.day} {self.name} sets {sign}{ex_sets}"


def new_slot_dict(program, day, name, sets):
    """A machine-proposed slot, deliberately UNDER-SPECIFIED.

    weight_kg is None on purpose: that is rx-calc's calibration mode, i.e. "the
    first session measures it". The machine does not invent a working weight,
    a rep range beyond the program's own default, or a safety note. No
    miss_streak either: rx-calc derives it from logged history (program state
    step A), so a card field would be state nobody reads."""
    accessory = [int(ex.get('priority', 0)) for ex in rx.day_work_items(program, day)
                 if isinstance(ex.get('priority'), int)
                 and ex.get('role') == NEW_SLOT_ROLE]
    base = max(accessory) if accessory else 400
    return {
        'slot': len(rx.day_work_items(program, day)) + 1,
        'name': name,
        'display': None,                 # owner/skill supplies the Korean label
        'priority': base + NEW_SLOT_PRIORITY_STEP,
        'role': NEW_SLOT_ROLE,
        'weight_kg': None,               # calibration -- never invented
        'sets': sets,
        'rep_range': [8, 12],
        'progression': 'double',
        'safety_note': None,
        'proposed_by': 'program-rebalance',
    }


def candidate_exercises(unit, led, program):
    """Off-program exercises in the DB that credit `unit`, best first.

    THE CATALOGUE IS THE DB. If this returns [], the allocator reports
    NO_CANDIDATE and stops -- it does not name a movement that kit_life.db has
    never heard of. Ranking: credit per set desc, then fatigue cost asc
    (cheapest systemic cost first), then name for determinism."""
    have = program_exercise_names(program)
    order = {'low': 0, 'med': 1, 'high': 2}
    out = []
    names = set(led.muscle_map) | set(led.submap)
    for name in sorted(names):
        if name in have:
            continue
        c = led.credit(name).get(unit, 0.0)
        if c <= 0:
            continue
        out.append((-c, order.get(led.fatigue(name), 1), name))
    out.sort()
    return [n for _c, _f, n in out]


def placement_day(program, led, unit, max_day_sets, sets):
    """Which day a new slot goes on -- decided by RULE, not by taste.

    1. only days that can absorb the WHOLE new slot are eligible (the cap is
       checked against day_total + sets, not day_total -- checking the
       pre-move total was the first version's bug and it inflated 뒷A to 28
       sets against a 27 cap);
    2. prefer a day that already trains this unit (block cohesion / the day is
       already 'about' that region);
    3. among those, the SHORTEST day (session length is the scarce resource);
    4. rotation order breaks the remaining tie so the output is deterministic.
    """
    rotation = program.get('rotation') or []
    eligible = [d for d in rotation
                if day_set_total(program, d) + sets <= max_day_sets]
    if not eligible:
        return None
    def trains(day):
        return any(led.credit(ex.get('name', '')).get(unit, 0.0) > 0
                   for ex in rx.day_work_items(program, day))
    ranked = sorted(eligible,
                    key=lambda d: (0 if trains(d) else 1,
                                   day_set_total(program, d),
                                   rotation.index(d)))
    return ranked[0]


def generate_moves(program, led, obj, limits, history, deficits):
    """All single moves legal in this state, each already cost-scored."""
    moves = []
    base_vals = unit_values(program, led)
    base_cost = band_cost(base_vals, led, obj)

    for day, _i, ex in iter_slots(program):
        name = ex.get('name')
        if not name:
            continue
        sets = int(ex.get('sets', 3))
        role = ex.get('role') or 'accessory'
        fat = led.fatigue(name)
        fw = obj['fatigue_w'].get(fat, 1.0)

        # ---- ADD one set
        if (sets < limits['max_slot_sets']
                and day_set_total(program, day) + 1 <= limits['max_day_sets']):
            m = Move('add', day, name, +1)
            trial = copy.deepcopy(program)
            m.apply(trial)
            new_cost = band_cost(unit_values(trial, led), led, obj)
            m.cost_delta = (new_cost - base_cost) + obj['w_addset'] * fw
            m.serves = sorted(led.credit(name))
            note = safety_flag(name, day, history)
            if note:
                m.caution = note
            moves.append(m)

        # ---- TRIM one set
        if sets > limits['min_slot_sets']:
            m = Move('trim', day, name, -1)
            trial = copy.deepcopy(program)
            m.apply(trial)
            # THE FLOOR IS A CONSTRAINT ON THE ALLOCATOR, NOT A NOTE ABOUT IT.
            # A trim that takes the unilateral share below the floor -- or that
            # cuts a unilateral slot when the share is ALREADY below it -- is
            # not in the search space. The allocator cannot propose crossing
            # the coordination floor even when the objective would pay for it.
            if is_unilateral(ex):
                after_share = unilateral_census(trial)['share_sets']
                if after_share < limits['unilateral_floor_share'] - 1e-9:
                    continue
            new_cost = band_cost(unit_values(trial, led), led, obj)
            pen = obj['trim_penalty'].get(role, obj['trim_penalty']['accessory'])
            m.cost_delta = (new_cost - base_cost) + pen
            m.serves = sorted(led.credit(name))
            note = safety_flag(name, day, history)
            if note:
                m.caution = note
            moves.append(m)

    # ---- NEW slot, only for units that are still under floor
    seen_new = set()
    for unit in deficits:
        for name in candidate_exercises(unit, led, program)[:NEW_SLOT_SHORTLIST]:
            if name in seen_new:
                continue
            sets = limits['new_slot_sets']
            day = placement_day(program, led, unit, limits['max_day_sets'], sets)
            if day is None:
                break
            seen_new.add(name)
            slot = new_slot_dict(program, day, name, sets)
            m = Move('new', day, name, sets, slot=slot, serves=[unit])
            trial = copy.deepcopy(program)
            m.apply(trial)
            new_cost = band_cost(unit_values(trial, led), led, obj)
            fw = obj['fatigue_w'].get(led.fatigue(name), 1.0)
            m.cost_delta = ((new_cost - base_cost)
                            + obj['w_newslot']
                            + obj['w_addset'] * fw * sets)
            m.serves = sorted(led.credit(name))
            moves.append(m)
    return moves


def under_floor_units(vals, led):
    return [u for u in led.units if vals[u] < led.bands[u][0] - 1e-9]


