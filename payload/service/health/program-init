# draft state -- what makes `next` a query instead of a memory
# ---------------------------------------------------------------------------
def load_draft(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def save_draft(path, draft):
    atomic_write(path, json.dumps(draft, ensure_ascii=False, indent=2) + "\n")


def outstanding_stages(draft):
    """[] when the draft is complete. Order is the ask order."""
    rot = draft.get("rotation")
    if not isinstance(rot, list) or not rot:
        return [STAGE_ROTATION]
    days = draft.get("days") or {}
    return [DAY_STAGE_PREFIX + c for c in rot if c not in days]


# ---------------------------------------------------------------------------
# reporting
# ---------------------------------------------------------------------------
def emit_findings(findings, stream=sys.stderr):
    for f in findings:
        stream.write("%s\n" % f.line())


def do_write(doc, args, facts, stage_label="write"):
    """The one write path. Every entry point lands here."""
    errs, warns, rotation = validate_answers(doc, facts)
    if errs:
        sys.stderr.write(
            "program-init: REFUSED -- %d error(s). No file was written; "
            "the previous card (if any) is untouched.\n" % len(errs))
        emit_findings(errs)
        emit_findings(warns)
        print("REFUSED\t%d\t%s" % (len(errs), stage_label))
        return EXIT_REFUSED
    program, notes = derive_program(doc, facts)
    text = render_program(program, notes)
    rt = roundtrip_check(text, program)
    if rt:
        sys.stderr.write(
            "program-init: REFUSED at the round-trip gate -- the rendered card "
            "does not read back as intended through rx-calc's own loader. This "
            "is a program-init defect, not an answer defect. Nothing was "
            "written.\n")
        emit_findings(rt)
        print("REFUSED\t%d\troundtrip" % len(rt))
        return EXIT_REFUSED
    existed = os.path.exists(args.program)
    if existed and not args.force:
        sys.stderr.write(
            "program-init: REFUSED -- %s already exists. This tool BUILDS the "
            "first card; it does not silently replace a program the owner is "
            "training on. Pass --force once the replacement is the confirmed "
            "intent (workout-program's revise path owns reconciliation).\n"
            % args.program)
        print("REFUSED\t1\texists")
        return EXIT_REFUSED
    atomic_write(args.program, text)
    print("WROTE\t%s\t%d day(s)\t%d slot(s)"
          % (args.program, len(rotation),
             sum(len(program["days"][c]["exercises"]) for c in rotation)))
    if warns:
        sys.stderr.write("program-init: %d warning(s) -- the card was written "
                         "and each of these is a real, named degrade:\n"
                         % len(warns))
        emit_findings(warns)
    rep = sync_session_types(args.db, program,
                             routine_name=doc.get("routine_name"))
    rc = report_sync(rep, program, args)
    # us_step rows come from the card AS WRITTEN, read back through the
    # engine's loader, so their seq is the priority position serve is asked
    # for -- not the answer document's list order.
    try:
        ordered = load_card_ordered(args.program)
    except Exception as e:                              # noqa: BLE001
        ordered = None
        sys.stderr.write("program-init: cannot re-read the card for us_step "
                         "derivation: %s\n" % e)
        print("USSTEP\tfailed\treread")
    us_ok = ordered is not None and report_us_sync(
        sync_us_steps(args.db, ordered))
    if rc == EXIT_OK and not us_ok:
        return EXIT_PARTIAL
    return rc


def report_sync(rep, program, args):
    if rep.get("error"):
        sys.stderr.write(
            "program-init: the card is written and valid, but the session_type "
            "derivation FAILED: %s\n"
            "  Until it succeeds, session-open's birth tag has nothing to "
            "point at and every card will say the split was INFERRED, not "
            "read. Re-run: service/health/program-init sync\n"
            % rep["error"])
        print("SYNC\tfailed\t%s" % rep["error"])
        return EXIT_PARTIAL
    print("SYNC\tok\troutine=%s(%s)\tcreated=%s\tpresent=%s"
          % (rep["routine"], rep["routine_action"],
             ",".join(rep["created"]) or "-",
             ",".join(rep["present"]) or "-"))
    if rep["stale"]:
        sys.stderr.write(
            "program-init: %d session_type row(s) on this routine are not in "
            "the card's rotation and were LEFT IN PLACE: %s. They are history "
            "-- old sessions are tagged with them -- so they are reported, "
            "never deleted.\n" % (len(rep["stale"]), ", ".join(rep["stale"])))
    n, missing, err = session_type_state(args.db, program)
    if err or missing:
        sys.stderr.write(
            "program-init: POST-WRITE RE-CHECK says the registry is still not "
            "complete (%s). The verdict is measured, not inferred from the "
            "insert's exit.\n" % (err or "missing: " + ", ".join(missing)))
        print("SYNC\tunmet\t%s" % (err or ",".join(missing)))
        return EXIT_PARTIAL
    return EXIT_OK


# ---------------------------------------------------------------------------
# argument plumbing
# ---------------------------------------------------------------------------
def read_payload(spec):
    """--json accepts inline JSON, @file, or - for stdin."""
    if spec is None:
        raise ValueError("no payload given (--json <inline|@file|->)")
    if spec == "-":
        raw = sys.stdin.read()
    elif spec.startswith("@"):
        with open(spec[1:], "r", encoding="utf-8") as f:
            raw = f.read()
    else:
        raw = spec
    return json.loads(raw)


def main(argv=None):
    ap = argparse.ArgumentParser(
        prog="program-init", add_help=True,
        description="Build the owner's program.yaml and the session_type "
                    "rotation registry it implies, from his own answers.")
    ap.add_argument("command",
                    choices=("schema", "status", "next", "answer", "write",
                             "sync", "validate", "check", "reset"))
    ap.add_argument("--db", default=DEFAULT_DB)
    ap.add_argument("--program", default=DEFAULT_PROGRAM)
    ap.add_argument("--draft", default=DEFAULT_DRAFT)
    ap.add_argument("--stage")
    ap.add_argument("--json", dest="payload")
    ap.add_argument("--answers", dest="answers")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--force", action="store_true")
    ap.add_argument("--json-out", dest="json_out", action="store_true",
                    help="machine-readable output for status/next/schema")
    args = ap.parse_args(argv)
    cmd = args.command

    if cmd == "schema":
        if args.json_out:
            print(json.dumps(ANSWER_SCHEMA, ensure_ascii=False, indent=2))
        else:
            print(json.dumps(ANSWER_SCHEMA, ensure_ascii=False, indent=2))
        return EXIT_OK

    facts = taxonomy_facts(args.db)

    if cmd == "reset":
        if os.path.exists(args.draft):
            os.unlink(args.draft)
            print("RESET\t%s" % args.draft)
        else:
            print("RESET\tnone")
        return EXIT_OK

    if cmd == "status":
        draft = load_draft(args.draft)
        out = outstanding_stages(draft)
        card = os.path.exists(args.program)
        n, missing, err = session_type_state(args.db)
        st = {
            "program_yaml": args.program,
            "program_present": card,
            "draft_stages_outstanding": out,
            "session_type_rows": n,
            "session_type_error": err,
            "taxonomy_known_exercises": len(facts),
        }
        if args.json_out:
            print(json.dumps(st, ensure_ascii=False, indent=2))
        else:
            print("PROGRAM\t%s\t%s" % ("present" if card else "absent",
                                       args.program))
            print("DRAFT\t%s" % (",".join(out) or "complete"))
            print("SESSION_TYPE\t%s" % (err or n))
            print("TAXONOMY\t%d known exercise(s)" % len(facts))
        return EXIT_OK if card else EXIT_UNMET

    if cmd == "next":
        draft = load_draft(args.draft)
        out = outstanding_stages(draft)
        if not out:
            if args.json_out:
                print(json.dumps({"done": True}, ensure_ascii=False))
            else:
                print("DONE\tevery stage answered -- `answer` already wrote "
                      "the card")
            return EXIT_OK
        stage = out[0]
        spec = ANSWER_SCHEMA["stages"][0 if stage == STAGE_ROTATION else 1]
        blob = {"done": False, "stage": stage, "remaining": len(out),
                "asks": spec["asks"], "payload": spec["payload"]}
        if stage != STAGE_ROTATION:
            blob["day"] = stage[len(DAY_STAGE_PREFIX):]
            blob["exercise"] = spec["exercise"]
        if args.json_out:
            print(json.dumps(blob, ensure_ascii=False, indent=2))
        else:
            print("NEXT\t%s\t%d remaining" % (stage, len(out)))
            print(json.dumps(blob, ensure_ascii=False, indent=2))
        return EXIT_UNMET

    if cmd == "answer":
        if not args.stage:
            sys.stderr.write("program-init: answer needs --stage\n")
            return EXIT_ERR
        try:
            payload = read_payload(args.payload)
        except (ValueError, OSError) as e:
            sys.stderr.write("program-init: unreadable --json payload: %s\n" % e)
            return EXIT_ERR
        draft = load_draft(args.draft)
        stage = args.stage
        if stage == STAGE_ROTATION:
            probe = dict(payload)
            probe.setdefault("days", {})
            errs, _w, rot = validate_answers(probe, facts,
                                             require_all_days=False)
            errs = [e for e in errs if not e.code.startswith("E-DAY")]
            if errs:
                sys.stderr.write("program-init: REFUSED stage %s -- %d "
                                 "error(s). Nothing recorded.\n"
                                 % (stage, len(errs)))
                emit_findings(errs)
                print("REFUSED\t%d\t%s" % (len(errs), stage))
                return EXIT_REFUSED
            draft["rotation"] = rot
            for k in (*ACTIVATION_FIELDS, "weekly_frequency", "routine_name", "focus_areas",
                      "care", "time_plan"):
                if payload.get(k) is not None:
                    draft[k] = payload[k]
            # A re-answered rotation drops day plans for codes it removed --
            # they can never be served again and keeping them would let a stale
            # day silently outlive the split it belonged to.
            draft["days"] = {c: v for c, v in (draft.get("days") or {}).items()
                             if c in rot}
        elif stage.startswith(DAY_STAGE_PREFIX):
            code = stage[len(DAY_STAGE_PREFIX):]
            rot = draft.get("rotation") or []
            if not rot:
                sys.stderr.write(
                    "program-init: REFUSED -- stage `%s` before `%s`. The "
                    "rotation decides which days exist; a day plan for a day "
                    "no split declares is never served.\n"
                    % (stage, STAGE_ROTATION))
                print("REFUSED\t1\torder")
                return EXIT_REFUSED
            if code not in rot:
                sys.stderr.write(
                    "program-init: REFUSED -- %r is not in the answered "
                    "rotation %s\n" % (code, rot))
                print("REFUSED\t1\tunknown-day")
                return EXIT_REFUSED
            probe = {"rotation": rot, "days": {code: payload}}
            errs, warns, _r = validate_answers(probe, facts,
                                               require_all_days=False)
            if errs:
                sys.stderr.write("program-init: REFUSED stage %s -- %d "
                                 "error(s). Nothing recorded.\n"
                                 % (stage, len(errs)))
                emit_findings(errs)
                print("REFUSED\t%d\t%s" % (len(errs), stage))
                return EXIT_REFUSED
            if warns:
                emit_findings(warns)
            draft.setdefault("days", {})[code] = payload
        else:
            sys.stderr.write("program-init: unknown stage %r (use `next`)\n"
                             % stage)
            return EXIT_ERR
        save_draft(args.draft, draft)
        out = outstanding_stages(draft)
        print("ANSWERED\t%s\t%d remaining" % (stage, len(out)))
        if out:
            return EXIT_UNMET
        # THE SEAM. The last answer does not return "now write it" -- it writes.
        rc = do_write(draft, args, facts, stage_label=stage)
        if rc == EXIT_OK:
            try:
                os.unlink(args.draft)
            except OSError:
                pass
        return rc

    if cmd == "write":
        try:
            doc = read_payload(args.answers or args.payload)
        except (ValueError, OSError) as e:
            sys.stderr.write("program-init: unreadable --answers payload: %s\n"
                             % e)
            return EXIT_ERR
        return do_write(doc, args, facts)

    if cmd in ("validate", "sync", "check"):
        if not os.path.exists(args.program):
            if cmd == "check":
                print("PROGRAM\tunmet\tabsent\t%s" % args.program)
                sys.stderr.write(
                    "program-init: files/program/program.yaml is ABSENT. "
                    "session-open exits 1 and no session can be born. The card "
                    "is the owner's own training and is built with him: "
                    "`service/health/program-init next` asks the first "
                    "question.\n")
                return EXIT_UNMET
            sys.stderr.write("program-init: no card at %s\n" % args.program)
            print("REFUSED\t1\tabsent")
            return EXIT_REFUSED
        try:
            rx = _load_rx()
            loaded = rx.load_yaml(args.program)
        except Exception as e:                      # noqa: BLE001
            sys.stderr.write("program-init: %s does not parse: %s\n"
                             % (args.program, e))
            print("REFUSED\t1\tparse")
            return EXIT_REFUSED
        # Validate the CARD ON DISK with the same rules the answers face, so a
        # hand-edit is held to the contract the writer is held to.
        doc = {"rotation": loaded.get("rotation"),
               "weekly_frequency": loaded.get("weekly_frequency"),
               "days": {}}
        if loaded.get("routine_name") is not None:
            doc["routine_name"] = loaded.get("routine_name")
        if loaded.get("focus_areas") is not None:
            doc["focus_areas"] = loaded.get("focus_areas")
        if loaded.get("care") is not None:
            doc["care"] = loaded.get("care")
        if loaded.get("time_plan") is not None:
            doc["time_plan"] = loaded.get("time_plan")
        for code, plan in (loaded.get("days") or {}).items():
            items = (plan or {}).get("exercises")
            doc["days"][code] = {"exercises": items}
            if isinstance(items, list):
                for ex in items:
                    if isinstance(ex, dict) and "weight_kg" not in ex:
                        ex["weight_kg"] = None
        errs, warns, rotation = validate_answers(doc, facts)
        if cmd == "validate":
            emit_findings(warns)
            if errs:
                emit_findings(errs)
                print("INVALID\t%d\t%s" % (len(errs), args.program))
                return EXIT_REFUSED
            print("VALID\t%s\t%d day(s)" % (args.program, len(rotation)))
            return EXIT_OK
        if errs:
            sys.stderr.write(
                "program-init: %s is INVALID -- refusing to derive "
                "session_type rows from a card the engine cannot trust.\n"
                % args.program)
            emit_findings(errs)
            print("REFUSED\t%d\tinvalid-card" % len(errs))
            return EXIT_REFUSED
        program = {"rotation": rotation, "days": doc["days"]}
        if cmd == "check":
            n, missing, err = session_type_state(args.db, program)
            if err:
                print("SESSION_TYPE\tunknown\t%s" % err)
                return EXIT_ERR
            if missing:
                print("PROGRAM\tok\t%s" % args.program)
                print("SESSION_TYPE\tunmet\tmissing=%s" % ",".join(missing))
                sys.stderr.write(
                    "program-init: the card declares %d rotation day(s) but "
                    "the registry is missing %s. session-open's birth tag "
                    "cannot resolve them -- every card will say the split was "
                    "INFERRED, not read. Fix: service/health/program-init "
                    "sync\n" % (len(rotation), ", ".join(missing)))
                return EXIT_UNMET
            print("PROGRAM\tok\t%s" % args.program)
            print("SESSION_TYPE\tok\t%d row(s)" % n)
            # us_step: a dry-run derivation that would change anything means
            # the rows are absent or have drifted from the card (G17).
            us = sync_us_steps(args.db, program, dry_run=True)
            if us.get("error") or us["changed"] or us["removed"] \
                    or us["collisions"]:
                print("USSTEP\tunmet\t%s" % (
                    us.get("error") or ",".join(
                        us["changed"] + us["removed"] + us["collisions"])))
                sys.stderr.write(
                    "program-init: us_step rows are missing or drifted from "
                    "the card, so `ax-project serve` would serve a stale slot "
                    "or none. Fix: service/health/program-init sync\n")
                return EXIT_UNMET
            print("USSTEP\tok\t%s" % (",".join(
                "%s:%d" % kv for kv in us["seeded"].items()) or "-"))
            return EXIT_OK
        rep = sync_session_types(args.db, program,
                                 routine_name=loaded.get("routine_name"),
                                 dry_run=args.dry_run)
        if args.dry_run:
            print("SYNC\tdryrun\troutine=%s(%s)\twould_create=%s\tpresent=%s"
                  % (rep["routine"], rep["routine_action"],
                     ",".join(rep["created"]) or "-",
                     ",".join(rep["present"]) or "-"))
            us = sync_us_steps(args.db, program, dry_run=True)
            print("USSTEP\tdryrun\twould_change=%s\twould_remove=%s"
                  % (",".join(us["changed"]) or "-",
                     ",".join(us["removed"]) or "-"))
            return EXIT_OK if not rep.get("error") else EXIT_PARTIAL
        rc = report_sync(rep, program, args)
        us_ok = report_us_sync(sync_us_steps(args.db, program))
        if rc == EXIT_OK and not us_ok:
            return EXIT_PARTIAL
        return rc

    sys.stderr.write("program-init: unhandled command %r\n" % cmd)
    return EXIT_ERR


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(EXIT_ERR)
