# ---------------------------------------------------------------------------
# taxonomy facts -- the only thing this tool reads out of the DB to derive with
# ---------------------------------------------------------------------------
def taxonomy_facts(db_path):
    """{exercise_name: {equipment, pattern, movement, measure, load_type}} for
    every lift the pack's shipped taxonomy knows on THIS db.

    Read-only and best-effort: an unseeded or unreadable DB returns {}, which
    turns every derivation off and reports it (W-NO-TAXONOMY) rather than
    guessing. The card is still written -- a missing seed must not be able to
    hold the owner's program hostage."""
    facts = {}
    try:
        conn = sqlite3.connect(
            "file:%s?mode=ro" % os.path.abspath(db_path), uri=True)
    except sqlite3.Error:
        return facts
    try:
        for table, cols, keys in (
                ("exercise_movement_grip",
                 "exercise_name, equipment, movement",
                 ("equipment", "grip_movement")),
                ("exercise_pattern", "exercise_name, pattern", ("pattern",)),
                ("ax_exercise",
                 "exercise_name, movement, measure, load_type",
                 ("movement", "measure", "load_type"))):
            try:
                sql = "SELECT %s FROM %s" % (cols, table)
                if table == "ax_exercise":
                    sql += " WHERE status='active'"
                for row in conn.execute(sql).fetchall():
                    ent = facts.setdefault(row[0], {})
                    for i, k in enumerate(keys):
                        if ent.get(k) is None:
                            ent[k] = row[i + 1]
            except sqlite3.Error:
                continue
    finally:
        conn.close()
    return facts


# ---------------------------------------------------------------------------
# validation -- every refusal is a NAMED code with a path
# ---------------------------------------------------------------------------
class Finding(object):
    __slots__ = ("code", "path", "msg")

    def __init__(self, code, path, msg):
        self.code, self.path, self.msg = code, path, msg

    def line(self):
        return "%s\t%s\t%s" % (self.code, self.path, self.msg)


def _is_num(v):
    return isinstance(v, (int, float)) and not isinstance(v, bool)


def _is_int(v):
    return isinstance(v, int) and not isinstance(v, bool)


def validate_rotation(doc, errs):
    rot = doc.get("rotation")
    if rot is None:
        errs.append(Finding("E-ROTATION-MISSING", "rotation",
                            "no `rotation` -- the split codes are the whole "
                            "answer to stage 1 and every session_type row is "
                            "derived from them"))
        return []
    if not isinstance(rot, list) or not rot:
        errs.append(Finding("E-ROTATION-EMPTY", "rotation",
                            "`rotation` must be a non-empty list of codes, in "
                            "the order the owner runs them"))
        return []
    seen, clean = set(), []
    for i, code in enumerate(rot):
        p = "rotation[%d]" % i
        if not isinstance(code, str) or not code.strip():
            errs.append(Finding("E-ROTATION-BADCODE", p,
                                "a rotation code must be a non-empty string"))
            continue
        code = code.strip()
        if len(code) > 16:
            errs.append(Finding("E-ROTATION-BADCODE", p,
                                "%r is longer than 16 characters" % code))
            continue
        if ROTATION_CODE_BAD.search(code):
            errs.append(Finding(
                "E-ROTATION-BADCODE", p,
                "%r carries whitespace or YAML punctuation (: # { } [ ] , "
                "quote). It becomes a YAML mapping key AND a session_type.code; "
                "either would read it back wrong" % code))
            continue
        if code == MAKEUP_CODE:
            errs.append(Finding(
                "E-ROTATION-RESERVED", p,
                "%r is the makeup session CLASS, not a rotation day. It is "
                "registered automatically at sort %d and must not consume a "
                "rotation slot -- rx-calc excludes it from the rotation basis "
                "by exactly that difference" % (MAKEUP_CODE, MAKEUP_SORT)))
            continue
        if code in seen:
            errs.append(Finding("E-ROTATION-DUP", p,
                                "%r appears twice; session_type is UNIQUE on "
                                "(routine_id, code)" % code))
            continue
        seen.add(code)
        clean.append(code)
    wf = doc.get("weekly_frequency")
    if wf is not None and not (_is_int(wf) and 1 <= wf <= 14):
        errs.append(Finding("E-FREQUENCY", "weekly_frequency",
                            "weekly_frequency must be an int 1..14, got %r"
                            % (wf,)))
    rn = doc.get("routine_name")
    if rn is not None and not (isinstance(rn, str) and rn.strip()):
        errs.append(Finding("E-ROUTINE-NAME", "routine_name",
                            "routine_name must be a non-empty string"))
    return clean


ACTIVATION_FIELDS = ("activation_primers", "activation_drills", "caution_prep",
                     "skip_optional_prep")


def validate_activation(obj, path, errs, program=False):
    for key in ("activation_primers", "caution_prep", "skip_optional_prep"):
        if key in obj and not isinstance(obj[key], bool):
            errs.append(Finding("E-ACTIVATION", path + "." + key,
                                "must be a boolean"))
    menus = obj.get("activation_drills")
    if menus is None:
        return
    if program:
        if not isinstance(menus, dict):
            errs.append(Finding("E-ACTIVATION", path, "activation_drills must map patterns to drill lists"))
            return
        menus = list(menus.values())
    else:
        menus = [menus]
    import movement_cues
    for menu in menus:
        if not isinstance(menu, list) or not 1 <= len(menu) <= 2:
            errs.append(Finding("E-ACTIVATION", path, "record one or two activation drills"))
            continue
        for drill in menu:
            code = drill.get("code") if isinstance(drill, dict) else drill
            recorded = (isinstance(drill, dict) and drill.get("display")
                        and drill.get("steps") and drill.get("fault"))
            if not isinstance(code, str) or not (movement_cues.cue(code) or recorded):
                errs.append(Finding("E-ACTIVATION", path, "activation drill needs a catalog cue"))


def validate_exercise(ex, path, errs, warns, facts):
    if not isinstance(ex, dict):
        errs.append(Finding("E-EX-SHAPE", path, "an exercise must be an object"))
        return None
    name = ex.get("name")
    if not isinstance(name, str) or not EXERCISE_NAME_RE.match(name or ""):
        errs.append(Finding(
            "E-EX-NAME", path + ".name",
            "name must be the canonical snake_case slug matching %s, got %r"
            % (EXERCISE_NAME_RE.pattern, name)))
        return None
    fact = facts.get(name) or {}
    if facts and not fact:
        warns.append(Finding(
            "W-UNKNOWN-EXERCISE", path + ".name",
            "%r is in no shipped taxonomy table on this DB. Accepted (it may "
            "be the owner's own lift), but with no row these are OFF for it "
            "and will not say so on the card: the muscle line, the fatigue "
            "cost, the ramp class and the plate cue. Either use the canonical "
            "slug or register the lift" % name))
    elif fact and not fact.get("equipment"):
        warns.append(Finding(
            "W-NO-EQUIPMENT", path + ".name",
            "%r has a taxonomy row but no exercise_movement_grip.equipment on "
            "this DB, so its equipment CLASS is unknown: no lattice is derived "
            "and the weight is never snapped to a loadable value. Answer "
            "`lattice` explicitly if this lift is loaded" % name))
    disp = ex.get("display")
    if disp is None:
        warns.append(Finding("W-NO-DISPLAY", path + ".display",
                             "no Korean display name -- the card will read "
                             "%r" % name))
    elif not (isinstance(disp, str) and disp.strip()):
        errs.append(Finding("E-EX-DISPLAY", path + ".display",
                            "display must be a non-empty string when present"))
    if "weight_kg" not in ex:
        errs.append(Finding(
            "E-EX-WEIGHT-KEY", path + ".weight_kg",
            "the weight_kg KEY is required. Use null for 'calibration "
            "pending' -- omitting it makes 'not asked' and 'asked, unknown' "
            "the same state, and the second is a real answer"))
    else:
        w = ex["weight_kg"]
        if w is not None and not (_is_num(w) and 0 < w <= 500):
            errs.append(Finding("E-EX-WEIGHT", path + ".weight_kg",
                                "weight_kg must be null or a number in "
                                "(0, 500], got %r" % (w,)))
    sets = ex.get("sets")
    if not (_is_int(sets) and 1 <= sets <= 20):
        errs.append(Finding("E-EX-SETS", path + ".sets",
                            "sets must be an int 1..20, got %r" % (sets,)))
    rr = ex.get("rep_range")
    if not (isinstance(rr, list) and len(rr) == 2 and _is_int(rr[0])
            and _is_int(rr[1]) and 1 <= rr[0] <= rr[1] <= 300):
        errs.append(Finding("E-EX-REPRANGE", path + ".rep_range",
                            "rep_range must be [low, high] ints with "
                            "1 <= low <= high <= 300, got %r" % (rr,)))
    unit = ex.get("rep_unit")
    if unit is not None and unit not in REP_UNITS:
        errs.append(Finding("E-EX-REPUNIT", path + ".rep_unit",
                            "rep_unit must be one of %s, got %r"
                            % ("|".join(REP_UNITS), unit)))
    prog = ex.get("progression")
    if prog is not None and prog not in PROGRESSIONS:
        errs.append(Finding("E-EX-PROGRESSION", path + ".progression",
                            "progression must be one of %s, got %r"
                            % ("|".join(PROGRESSIONS), prog)))
    role = ex.get("role")
    if role is not None and role not in ROLES:
        errs.append(Finding("E-EX-ROLE", path + ".role",
                            "role must be one of %s, got %r"
                            % ("|".join(ROLES), role)))
    lat = ex.get("lattice")
    if lat is not None:
        if not isinstance(lat, dict):
            errs.append(Finding("E-EX-LATTICE", path + ".lattice",
                                "lattice must be an object {type, base, step}"))
        else:
            if lat.get("type") not in LATTICE_TYPES:
                errs.append(Finding("E-EX-LATTICE-TYPE",
                                    path + ".lattice.type",
                                    "lattice.type must be one of %s, got %r"
                                    % ("|".join(LATTICE_TYPES),
                                       lat.get("type"))))
            for k in ("base", "step"):
                v = lat.get(k)
                if v is not None and not (_is_num(v) and v >= 0):
                    errs.append(Finding("E-EX-LATTICE-NUM",
                                        path + ".lattice." + k,
                                        "lattice.%s must be a number >= 0, "
                                        "got %r" % (k, v)))
            if _is_num(lat.get("step")) and lat.get("step") <= 0:
                errs.append(Finding("E-EX-LATTICE-NUM", path + ".lattice.step",
                                    "lattice.step must be > 0"))
            if "derived" in lat and not isinstance(lat["derived"], bool):
                errs.append(Finding("E-EX-LATTICE-DERIVED",
                                    path + ".lattice.derived",
                                    "lattice.derived must be true/false, "
                                    "got %r" % (lat["derived"],)))
    rf = ex.get("rir_floor")
    if rf is not None and not (_is_int(rf) and 0 <= rf <= 5):
        errs.append(Finding("E-EX-RIRFLOOR", path + ".rir_floor",
                            "rir_floor must be an int 0..5, got %r" % (rf,)))
    rt = ex.get("rir_target")
    if rt is not None and not (isinstance(rt, list) and len(rt) == 2 and all(
            _is_int(x) and 0 <= x <= 5 for x in rt) and rt[0] <= rt[1]):
        errs.append(Finding("E-EX-RIRTARGET", path + ".rir_target",
                            "rir_target must be [low, high] ints 0..5, "
                            "low<=high, got %r" % (rt,)))
    rs = ex.get("rest_sec")
    if rs is not None and not (_is_int(rs) and 10 <= rs <= 600):
        errs.append(Finding("E-EX-RESTSEC", path + ".rest_sec",
                            "rest_sec must be an int 10..600, got %r" % (rs,)))
    pr = ex.get("priority")
    if pr is not None and not _is_int(pr):
        errs.append(Finding("E-EX-PRIORITY", path + ".priority",
                            "priority must be an int, got %r" % (pr,)))
    validate_activation(ex, path, errs)
    for k in ("safety_note", "loading"):
        v = ex.get(k)
        if v is not None and not (isinstance(v, str) and v.strip()):
            errs.append(Finding("E-EX-STR", path + "." + k,
                                "%s must be a non-empty string when present"
                                % k))
    # G19 coverage -- a VERIFY output, not a value. See rir_floor in the schema.
    if rf is None and fact:
        eq, pat = fact.get("equipment"), fact.get("pattern")
        if eq in G19_FREEWEIGHT_EQUIPMENT and pat and \
                pat not in G19_EXEMPT_PATTERNS:
            warns.append(Finding(
                "W-G19-UNSET", path + ".rir_floor",
                "%r is a multi-joint FREEWEIGHT lift (pattern=%s, "
                "equipment=%s) -- the G19 class. It carries no rir_floor, so "
                "the RIR 2-3 safety floor is OFF for it. Read the G19 roster "
                "in workout-program/SKILL.md and answer rir_floor, or record "
                "why this lift is excluded" % (name, pat, eq)))
    return name


def validate_care(care, errs):
    """The optional `care` list: known keys once each, a known `when`, whole
    minutes, safety-ledger site keys. A wrong entry would be read at every
    session start, so it is refused, not carried."""
    if care is None:
        return
    if not isinstance(care, list):
        errs.append(Finding("E-CARE-SHAPE", "care",
                            "`care` must be a list of {key, when, ...}"))
        return
    seen = set()
    for i, it in enumerate(care):
        p = "care[%d]" % i
        if not isinstance(it, dict):
            errs.append(Finding("E-CARE-SHAPE", p, "each care item is an "
                                "object"))
            continue
        extra = sorted(set(it) - set(CARE_FIELDS))
        if extra:
            errs.append(Finding("E-CARE-FIELD", p, "unknown field(s) %s"
                                % ", ".join(extra)))
        k = it.get("key")
        if k not in CARE_KEYS:
            errs.append(Finding("E-CARE-KEY", p + ".key",
                                "%r is not one of %s" % (k, ", ".join(
                                    CARE_KEYS))))
        elif k in seen:
            errs.append(Finding("E-CARE-DUP", p + ".key", "%r twice" % k))
        seen.add(k)
        if it.get("when") not in CARE_WHEN:
            errs.append(Finding("E-CARE-WHEN", p + ".when",
                                "%r is not one of %s" % (it.get("when"),
                                                         ", ".join(CARE_WHEN))))
        m = it.get("minutes")
        if m is not None and not (_is_int(m) and 1 <= m <= 30):
            errs.append(Finding("E-CARE-MINUTES", p + ".minutes",
                                "minutes must be an int 1..30, got %r" % (m,)))
        sites = it.get("sites")
        if sites is not None and not (
                isinstance(sites, list) and sites and all(
                    isinstance(x, str) and CARE_SITE_RE.match(x)
                    for x in sites)):
            errs.append(Finding("E-CARE-SITES", p + ".sites",
                                "sites must be a non-empty list of safety "
                                "keys injury_<site>[_l|_r], got %r"
                                % (sites,)))


def derive_care(care):
    """The card's `care` list: fields in CARE_FIELDS order, nothing else."""
    return [{f: it[f] for f in CARE_FIELDS if it.get(f) is not None}
            for it in care or ()]


def validate_answers(doc, facts, require_all_days=True):
    """(errors, warnings, clean_rotation). Errors REFUSE; warnings are named
    and carried through."""
    errs, warns = [], []
    if not isinstance(doc, dict):
        errs.append(Finding("E-SHAPE", "<root>",
                            "the answer document must be a JSON object"))
        return errs, warns, []
    rotation = validate_rotation(doc, errs)
    fa = doc.get("focus_areas")
    if fa is not None:
        if not isinstance(fa, list) or not all(
                isinstance(a, str) and a.strip() for a in fa):
            errs.append(Finding("E-FOCUS-SHAPE", "focus_areas",
                                "`focus_areas` must be a list of area names"))
        else:
            for i, a in enumerate(fa):
                if a not in FOCUS_AREA_VOCAB:
                    errs.append(Finding(
                        "E-FOCUS-UNKNOWN", "focus_areas[%d]" % i,
                        "%r is not an area rx-calc can expand into muscles "
                        "(%s). A free-text area would be carried and never "
                        "read" % (a, ", ".join(FOCUS_AREA_VOCAB))))
    validate_activation(doc, "program", errs, program=True)
    validate_care(doc.get("care"), errs)
    ss = doc.get("set_style")
    if ss is not None and ss not in SET_STYLES:
        errs.append(Finding("E-SET-STYLE", "set_style",
                            "set_style must be one of %s, got %r"
                            % ("|".join(SET_STYLES), ss)))
    from session_day_trim import validate_time_plan
    try:
        validate_time_plan(doc.get("time_plan"))
    except ValueError as exc:
        errs.append(Finding("E-TIME-PLAN", "time_plan", str(exc)))
    days = doc.get("days")
    if days is None:
        errs.append(Finding("E-DAYS-MISSING", "days",
                            "no `days` -- a rotation with no day plans is a "
                            "split with no training in it"))
        days = {}
    elif not isinstance(days, dict):
        errs.append(Finding("E-DAYS-SHAPE", "days",
                            "`days` must be an object keyed by rotation code"))
        days = {}
    for code in sorted(days.keys()):
        if rotation and code not in rotation:
            errs.append(Finding(
                "E-DAY-UNKNOWN", "days.%s" % code,
                "%r is not in `rotation`. Every day plan must name a day the "
                "rotation runs -- otherwise it is never served and nothing "
                "says so" % code))
    if require_all_days:
        for code in rotation:
            if code not in days:
                errs.append(Finding(
                    "E-DAY-MISSING", "days.%s" % code,
                    "rotation declares %r but no day plan was given for it. "
                    "session-open would open that day with an empty lineup"
                    % code))
    for code in rotation:
        plan = days.get(code)
        if plan is None:
            continue
        p = "days.%s" % code
        if not isinstance(plan, dict):
            errs.append(Finding("E-DAY-SHAPE", p,
                                "a day plan must be an object with "
                                "`exercises`"))
            continue
        items = plan.get("exercises")
        if not isinstance(items, list) or not items:
            errs.append(Finding("E-DAY-EMPTY", p + ".exercises",
                                "a rotation day must carry at least one "
                                "exercise"))
            continue
        seen = set()
        for i, ex in enumerate(items):
            nm = validate_exercise(ex, "%s.exercises[%d]" % (p, i),
                                   errs, warns, facts)
            if nm is None:
                continue
            if nm in seen:
                errs.append(Finding(
                    "E-EX-DUP", "%s.exercises[%d].name" % (p, i),
                    "%r appears twice on %s. set-arm and set-table resolve a "
                    "slot BY NAME within the day; two slots with one name is "
                    "an ambiguous lookup, not a superset" % (nm, code)))
            seen.add(nm)
    if not facts:
        warns.append(Finding(
            "W-NO-TAXONOMY", "<db>",
            "the taxonomy tables answered nothing on this DB, so NOTHING was "
            "derived (lattice, role, progression, and the G19 coverage check "
            "are all off). Run the install lane "
            "(routines/bundle/health-install-ensure.sh) and re-write, or "
            "answer those fields explicitly"))
    return errs, warns, rotation


# ---------------------------------------------------------------------------
# derivation -- equipment mechanics only, every one of them announced
# ---------------------------------------------------------------------------
def derive_slot(ex, index, facts):
    """(slot_dict, [derivation_note, ...]). The owner's answer always wins;
    a derivation only fills a key he did not answer."""
    name = ex["name"]
    fact = facts.get(name) or {}
    notes = []
    out = {}
    out["slot"] = index + 1
    out["name"] = name
    out["display"] = ex.get("display") or name
    if ex.get("priority") is not None:
        out["priority"] = ex["priority"]
    else:
        out["priority"] = (index + 1) * 10
        notes.append("priority=slot*10 (ascends with slot order)")
    role = ex.get("role")
    if role is None:
        movement = fact.get("movement")
        pattern = fact.get("pattern")
        if movement == "compound":
            role, why = "main", "ax_exercise.movement=compound"
        elif movement == "isolation":
            role, why = "accessory", "ax_exercise.movement=isolation"
        elif pattern in G19_EXEMPT_PATTERNS and pattern:
            role, why = "accessory", "exercise_pattern.pattern=%s" % pattern
        elif pattern:
            role, why = "main", "exercise_pattern.pattern=%s" % pattern
        else:
            role, why = None, None
        if role:
            notes.append("role=%s from %s" % (role, why))
    if role:
        out["role"] = role
    out["weight_kg"] = ex.get("weight_kg")
    out["sets"] = ex["sets"]
    out["rep_range"] = list(ex["rep_range"])
    unit = ex.get("rep_unit")
    if unit is None:
        if fact.get("measure") == "hold_sec":
            unit = "sec"
            notes.append("rep_unit=sec from ax_exercise.measure=hold_sec")
        elif fact.get("grip_movement") in HOLD_MOVEMENTS:
            unit = "sec"
            notes.append("rep_unit=sec from movement=%s"
                         % fact["grip_movement"])
        else:
            unit = "reps"
    out["rep_unit"] = unit
    prog = ex.get("progression")
    if prog is None:
        if unit == "sec":
            prog = "hold"
            notes.append("progression=hold (a seconds hold)")
        else:
            prog = "double"
            notes.append("progression=double (the pack default)")
    out["progression"] = prog
    if ex.get("rir_floor") is not None:
        out["rir_floor"] = ex["rir_floor"]
    if ex.get("rir_target") is not None:
        out["rir_target"] = list(ex["rir_target"])
    if ex.get("rest_sec") is not None:
        out["rest_sec"] = ex["rest_sec"]
    if ex.get("loading") is not None:
        out["loading"] = ex["loading"]
    lat = ex.get("lattice")
    if lat is None:
        eq = fact.get("equipment")
        derived = LATTICE_BY_EQUIPMENT.get(eq)
        if derived is not None:
            # marked so rx-calc.resolve_lattice reads it as the class
            # grid, not as an owner answer that beats a machine's own grid
            lat = dict(derived, derived=True)
            notes.append("lattice=%s from equipment=%s"
                         % (lat.get("type"), eq))
        elif eq:
            notes.append("NO lattice: equipment=%s has no derivable class "
                         "grid" % eq)
        else:
            notes.append("NO lattice: equipment unknown for this lift")
    if lat is not None:
        out["lattice"] = lat
    if ex.get("safety_note") is not None:
        out["safety_note"] = ex["safety_note"]
    for key in ACTIVATION_FIELDS:
        if key in ex:
            out[key] = json.loads(json.dumps(ex[key]))
    return out, notes


def derive_program(doc, facts):
    """(program_dict, {slot_path: [notes]}). Pure: same answers + same
    taxonomy -> same card, byte for byte."""
    rotation = [c.strip() for c in doc["rotation"]]
    program = {
        "rotation": rotation,
        "weekly_frequency": doc.get("weekly_frequency") or len(rotation),
        "days": {},
    }
    # The routine's NAME is on the card because `sync` reads only the card:
    # `write` registered the routine under the answered name, and a later sync
    # that could not see it derived "<rotation> ..." instead, matched nothing,
    # created a second routine, demoted the first and minted new session_type
    # ids (test-program-init idempotency, measured 2026-10-02).
    if (doc.get("routine_name") or "").strip():
        program["routine_name"] = doc["routine_name"].strip()
    if doc.get("focus_areas"):
        program["focus_areas"] = list(doc["focus_areas"])
    if doc.get("set_style"):
        program["set_style"] = doc["set_style"]
    if doc.get("care"):
        program["care"] = derive_care(doc["care"])
    if doc.get("time_plan") is not None:
        program["time_plan"] = json.loads(json.dumps(doc["time_plan"]))
    for key in ACTIVATION_FIELDS:
        if key in doc:
            program[key] = json.loads(json.dumps(doc[key]))
    notes = {}
    for code in rotation:
        items = doc["days"][code]["exercises"]
        slots = []
        for i, ex in enumerate(items):
            slot, n = derive_slot(ex, i, facts)
            slots.append(slot)
            if n:
                notes["%s/%s" % (code, slot["name"])] = n
        program["days"][code] = {"exercises": slots}
    return program, notes


# ---------------------------------------------------------------------------
# rendering -- into the dialect rx-calc.load_yaml actually reads
# ---------------------------------------------------------------------------
def _scalar(v):
    if v is None:
        return "null"
    if v is True:
        return "true"
    if v is False:
        return "false"
    if isinstance(v, float):
        return repr(round(v, 4))
    if isinstance(v, int):
        return str(v)
    s = str(v)
    # Quote anything the hand-rolled reader could take for structure. A bare
    # Korean display name round-trips fine; one with a colon in it does not.
    if s == "" or re.search(r"[:#\{\}\[\],'\"]", s) or s != s.strip():
        return '"%s"' % s.replace('"', "'")
    return s


def _flow_map(d, order):
    parts = ["%s: %s" % (k, _scalar(d[k])) for k in order if k in d]
    return "{ %s }" % ", ".join(parts)


HEADER = """\
# program.yaml -- THE OWNER'S TRAINING. Written by service/health/program-init.
#
# This file is OWNER DATA, not pack content. Every training decision in it --
# the rotation codes, the lifts, the sets, the rep ranges, the weights -- was
# CONFIRMED by the owner. A first program built through program-plan proposes
# its doses from the pack's declared rule tables (owner-confirmed intensity
# scheme + 3-set floor), shows them day by day, and writes only what he
# accepted. No number here was composed by a model (D1: the user owns Why).
#
# DO NOT HAND-EDIT THE STRUCTURE. Three readers parse this with a hand-rolled
# parser (rx-calc.load_yaml) and the session_type rows in kit_life.db are
# DERIVED from `rotation:` below. Re-run program-init (or workout-program's
# revise path) so the file and the table cannot disagree:
#
#     service/health/program-init sync        # re-derive session_type rows
#     service/health/program-init validate    # check this file, loudly
#
# Slot fields marked DERIVED in the per-slot comments were filled from the
# pack's shipped equipment taxonomy, not from the owner -- answer the field
# explicitly to override any of them.
"""


def render_program(program, notes):
    out = [HEADER]
    out.append("rotation: [%s]"
               % ", ".join(_scalar(c) for c in program["rotation"]))
    out.append("weekly_frequency: %d" % program["weekly_frequency"])
    if program.get("routine_name"):
        out.append("routine_name: %s" % _scalar(program["routine_name"]))
    if program.get("focus_areas"):
        out.append("focus_areas: [%s]"
                   % ", ".join(_scalar(a) for a in program["focus_areas"]))
    if program.get("set_style"):
        out.append("set_style: %s" % _scalar(program["set_style"]))
    if program.get("time_plan") is not None:
        out.append("time_plan: " + json.dumps(program["time_plan"], ensure_ascii=True))
    for key in ACTIVATION_FIELDS:
        if key in program:
            out.append(key + ": " + json.dumps(program[key], ensure_ascii=False))
    if program.get("care"):
        out.append("care:")
        for it in program["care"]:
            lead = "  - "
            for f in CARE_FIELDS:
                if f not in it:
                    continue
                v = it[f]
                val = ("[%s]" % ", ".join(_scalar(x) for x in v)
                       if isinstance(v, list) else _scalar(v))
                out.append("%s%s: %s" % (lead, f, val))
                lead = "    "
    out.append("days:")
    for code in program["rotation"]:
        out.append("  %s:" % _scalar(code))
        out.append("    exercises:")
        for slot in program["days"][code]["exercises"]:
            n = notes.get("%s/%s" % (code, slot["name"]))
            if n:
                for ln in n:
                    out.append("      # DERIVED: %s" % ln)
            first = True
            # Field ORDER mirrors tests/fixtures/program.yaml -- the shape
            # every hand-authored card in this fleet already has, so a diff
            # between a written card and an edited one reads as a content
            # diff and not as a re-ordering. rep_range and lattice render as
            # FLOW collections for the same reason; set-add / set-arm /
            # set-table all read them through the one parsed slot, so there is
            # no second grammar to keep in step.
            for key in ("slot", "name", "display", "priority", "role",
                        "weight_kg", "sets", "rep_range", "rep_unit",
                        "progression",
                        "rir_floor", "rir_target", "rest_sec", "loading",
                        "lattice", "safety_note", *ACTIVATION_FIELDS):
                if key not in slot:
                    continue
                lead = "      - " if first else "        "
                first = False
                if key in ("rep_range", "rir_target"):
                    out.append("%s%s: [%d, %d]"
                               % (lead, key, slot[key][0], slot[key][1]))
                elif key in ACTIVATION_FIELDS:
                    out.append("%s%s: %s" % (lead, key, json.dumps(slot[key], ensure_ascii=False)))
                elif key == "lattice":
                    out.append("%slattice: %s"
                               % (lead, _flow_map(slot["lattice"],
                                                  ("type", "base", "step",
                                                   "derived"))))
                else:
                    out.append("%s%s: %s" % (lead, key, _scalar(slot[key])))
    return "\n".join(out) + "\n"


# ---------------------------------------------------------------------------
# the round-trip gate
# ---------------------------------------------------------------------------
def _load_rx():
    """rx-calc as a module -- it is the loader every consumer uses, so it is the
    loader the write is proved against. A hyphenated filename with no .py
    extension needs the explicit loader dance."""
    import importlib.util
    import importlib.machinery
    path = os.path.join(HERE, "rx-calc")
    loader = importlib.machinery.SourceFileLoader("rx_calc_for_init", path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def _normalize(obj):
    """Comparable shape: ints and floats that mean the same number compare
    equal (the reader turns `3` into int and `60.0` into float; both are
    correct)."""
    if isinstance(obj, dict):
        return {k: _normalize(v) for k, v in obj.items()}
    if isinstance(obj, list):
        return [_normalize(v) for v in obj]
    if isinstance(obj, bool) or obj is None:
        return obj
    if isinstance(obj, (int, float)):
        return float(obj)
    return obj


def roundtrip_check(text, program):
    """[] if rx-calc's own loader reads the rendered text back as the program we
    intended, else a list of Findings. This is the whole reason a malformed card
    cannot reach disk."""
    errs = []
    fd, tmp = tempfile.mkstemp(prefix=".program-roundtrip-", suffix=".yaml")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        try:
            rx = _load_rx()
        except Exception as e:                      # noqa: BLE001
            return [Finding("E-ROUNDTRIP-LOADER", "<rx-calc>",
                            "cannot load rx-calc to verify the write: %s" % e)]
        try:
            got = rx.load_yaml(tmp)
        except Exception as e:                      # noqa: BLE001
            return [Finding("E-ROUNDTRIP-PARSE", "<program.yaml>",
                            "the rendered card does not parse with the loader "
                            "every consumer uses: %s" % e)]
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass
    want_rot = _normalize(program["rotation"])
    if _normalize(got.get("rotation")) != want_rot:
        errs.append(Finding("E-ROUNDTRIP", "rotation",
                            "read back %r, intended %r"
                            % (got.get("rotation"), program["rotation"])))
    if got.get("routine_name") != program.get("routine_name"):
        errs.append(Finding("E-ROUNDTRIP", "routine_name",
                            "read back %r, intended %r"
                            % (got.get("routine_name"),
                               program.get("routine_name"))))
    if _normalize(got.get("focus_areas")) != _normalize(
            program.get("focus_areas")):
        errs.append(Finding("E-ROUNDTRIP", "focus_areas",
                            "read back %r, intended %r"
                            % (got.get("focus_areas"),
                               program.get("focus_areas"))))
    if _normalize(got.get("care")) != _normalize(program.get("care")):
        errs.append(Finding("E-ROUNDTRIP", "care",
                            "read back %r, intended %r"
                            % (got.get("care"), program.get("care"))))
    if got.get("time_plan") != program.get("time_plan"):
        errs.append(Finding("E-ROUNDTRIP", "time_plan", "weekday budgets changed"))
    if got.get("set_style") != program.get("set_style"):
        errs.append(Finding("E-ROUNDTRIP", "set_style",
                            "read back %r, intended %r"
                            % (got.get("set_style"), program.get("set_style"))))
    for key in ACTIVATION_FIELDS:
        if _normalize(got.get(key)) != _normalize(program.get(key)):
            errs.append(Finding("E-ROUNDTRIP", key, "activation preference changed"))
    for code in program["rotation"]:
        want = program["days"][code]["exercises"]
        back = ((got.get("days") or {}).get(code) or {}).get("exercises")
        if not isinstance(back, list) or len(back) != len(want):
            errs.append(Finding(
                "E-ROUNDTRIP", "days.%s.exercises" % code,
                "read back %s slots, intended %d"
                % (len(back) if isinstance(back, list) else "no",
                   len(want))))
            continue
        # The loader orders by `priority`; we render in slot order and derive
        # priority ascending, so the two agree -- compare by slot number so a
        # future ordering change fails here instead of in a live session.
        by_slot = {}
        for item in back:
            if isinstance(item, dict):
                by_slot[item.get("slot")] = item
        for w in want:
            g = by_slot.get(w["slot"])
            if g is None:
                errs.append(Finding("E-ROUNDTRIP",
                                    "days.%s.slot%s" % (code, w["slot"]),
                                    "slot did not read back at all"))
                continue
            for k, v in w.items():
                if _normalize(g.get(k)) != _normalize(v):
                    errs.append(Finding(
                        "E-ROUNDTRIP",
                        "days.%s.slot%s.%s" % (code, w["slot"], k),
                        "read back %r, intended %r" % (g.get(k), v)))
    return errs


def atomic_write(path, text):
    d = os.path.dirname(os.path.abspath(path))
    if not os.path.isdir(d):
        os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".program-init-", dir=d)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


# ---------------------------------------------------------------------------
# session_type derivation -- the SAME source, the SAME call
# ---------------------------------------------------------------------------
def sync_session_types(db_path, program, routine_name=None, dry_run=False):
    """Derive the rotation registry in kit_life.db from the card's `rotation:`.

    Returns a report dict. Reconcile-before-write throughout (D3): every write
    is find-first, so a second run is a no-op and an existing row is never
    clobbered -- including a row the owner renamed by hand.

    WHY THIS LIVES IN THE SAME CALL AS THE WRITE. `session_type` rows ARE the
    rotation, in the DB. Producing the file and leaving the table to another
    hand does not remove the wall, it moves it one step right: session-open
    would still fail its birth tag and every card would still say the split was
    INFERRED, not read. One source, one path.

    WHAT IS DELIBERATELY NOT WRITTEN. `session_muscle` (session_type_id ->
    workout_types) has NO reader anywhere in this pack or the kit -- measured
    by grep across both payloads on 2026-09-14. Writing rows nothing reads
    would be inventing a fact about the owner's training to fill a table. The
    card's per-slot muscles already come from exercise_muscle_map, which the
    taxonomy seed fills."""
    rep = {"routine": None, "routine_action": None, "created": [],
           "present": [], "stale": [], "makeup": None, "error": None}
    rotation = program["rotation"]
    name = (routine_name or "").strip() or \
        ("%s 분할" % "/".join(rotation))
    try:
        conn = sqlite3.connect(os.path.abspath(db_path))
    except sqlite3.Error as e:
        rep["error"] = "cannot open db: %s" % e
        return rep
    try:
        conn.execute("PRAGMA foreign_keys=ON;")
        # ---- the routine row (match by the card's name, not find-first) ---
        # Exactly one routine is active at a time (D-model). Matching on
        # status alone (the old find-first) lands a different card's rows on
        # whichever routine happens to be active; matching by `name`
        # (derived from the card above) is what keeps a card's writes on ITS
        # OWN routine.
        row = conn.execute(
            "SELECT id, name FROM routine WHERE status='active' AND name=?",
            (name,)).fetchone()
        others = [r[0] for r in conn.execute(
            "SELECT id FROM routine WHERE status='active' AND name!=?",
            (name,)).fetchall()]
        if row:
            rid, rep["routine"], rep["routine_action"] = row[0], row[1], "existing"
        elif dry_run:
            rid, rep["routine"], rep["routine_action"] = None, name, "would_create"
            if others:
                rep["routine_action"] += "+would_demote:%s" % ",".join(
                    str(i) for i in others)
        else:
            if others:
                # Demote, never delete: past `workouts` reference
                # session_type ids on the old routine, and deleting the
                # routine (or its session_type rows) would break that
                # history. Same transaction as the INSERT below (commit is
                # at the bottom of this function).
                conn.execute(
                    "UPDATE routine SET status='retired' "
                    "WHERE status='active' AND name!=?", (name,))
            cur = conn.execute(
                "INSERT INTO routine (name, style, status, note) "
                "VALUES (?, ?, 'active', ?)",
                (name, "split",
                 "derived from files/program/program.yaml by program-init"))
            rid, rep["routine"], rep["routine_action"] = \
                cur.lastrowid, name, "created"
            if others:
                rep["routine_action"] += "+demoted:%s" % ",".join(
                    str(i) for i in others)
        # ---- one session_type row per rotation code, in rotation order -----
        want = [(c, i) for i, c in enumerate(rotation)]
        want.append((MAKEUP_CODE, MAKEUP_SORT))
        for code, sort in want:
            hit = None
            if rid is not None:
                hit = conn.execute(
                    "SELECT id, sort FROM session_type "
                    "WHERE routine_id=? AND code=?", (rid, code)).fetchone()
            if hit:
                if hit[1] != sort and not dry_run:
                    # The CYCLE ORDER is derived, so it follows the card. The
                    # row's identity (its id, everything joined to it) does
                    # not move -- rotation-current reads `sort < 99 ORDER BY
                    # sort`, so a reordered split has to re-sort or the queue
                    # serves yesterday's order forever.
                    conn.execute("UPDATE session_type SET sort=? WHERE id=?",
                                 (sort, hit[0]))
                    rep["present"].append("%s(resorted %s->%s)"
                                          % (code, hit[1], sort))
                else:
                    rep["present"].append(code)
                continue
            if dry_run or rid is None:
                rep["created"].append("%s(would)" % code)
                continue
            conn.execute(
                "INSERT INTO session_type (routine_id, code, display_name, "
                "sort, note) VALUES (?, ?, ?, ?, ?)",
                (rid, code, code, sort,
                 "makeup class" if code == MAKEUP_CODE
                 else "rotation day, derived from program.yaml"))
            rep["created"].append(code)
        # ---- codes on this routine the card no longer declares --------------
        if rid is not None:
            known = set(rotation) | {MAKEUP_CODE}
            for (c,) in conn.execute(
                    "SELECT code FROM session_type WHERE routine_id=?",
                    (rid,)).fetchall():
                if c not in known:
                    rep["stale"].append(c)
        if dry_run:
            conn.rollback()
        else:
            conn.commit()
        rep["makeup"] = MAKEUP_CODE
    except sqlite3.Error as e:
        try:
            conn.rollback()
        except sqlite3.Error:
            pass
        rep["error"] = str(e)
    finally:
        conn.close()
    return rep


# ---------------------------------------------------------------------------
# us_step derivation -- the working-weight seam, from the SAME card
# ---------------------------------------------------------------------------
# WHY (G17, re-measured 2026-09-30). `ax-project serve --session <day> --slot
# <n>` is the only path a working weight reaches the owner
# (workout-session/reference/weight-realization.md), and it resolves the slot
# through a `us_step` row. Nothing in production wrote those rows: the only
# writer was us_reseed.py, a manual script hard-wired to a retired instance
# rotation. On a freshly composed program every serve exited 1
# ("no working us_step"), so the first real session could not settle a single
# working weight. And where rows DID exist they were a snapshot that drifted
# from program.yaml (the original G17 symptom: slot 8 served last month's lift).
#
# The repair is the session_type one again: the rows are DERIVED from the card
# in the same call that writes the card, so there is no second errand to
# forget and no snapshot to go stale. session-open re-runs the same derivation
# at birth, so a hand-edited card is reconciled before the first set.
#
# Row rules (same conventions us_reseed.py established):
#   seq            = the slot's 1-based position in rx-calc's priority order
#                    (rx-calc.load_yaml sorts by `priority`; that position is
#                    the --slot the skill passes to serve).
#   step_type      = 'hold' when ax_exercise.measure is hold_sec, else working.
#   target         = "lo-hi" (reps / tempo) or "lo-his" (hold seconds).
#   rest_sec       = the slot's own rest_sec, else 150 compound / 90 isolation.
#   display_key    = the card's Korean `display` (exercise_derived rows may
#                    carry one; us_render shows it instead of the English key).
#   ulid           = a fixed function of (owner, day, seq): re-running upserts
#                    in place, so ax_projection_slot history (FK, ON DELETE
#                    CASCADE) survives a re-sync of an unchanged slot.
# A slot whose lift has no active ax_exercise row (a machine/cable lift not yet
# JIT-registered) cannot carry a us_step (exercise_ref is NOT NULL + FK). It is
# REPORTED by name, never invented; the other slots are still seeded.
US_STEP_CREATED_AT = "1970-01-01T00:00:00Z"


def us_step_ulid(owner, code, seq):
    """Deterministic 26-char id for (owner, rotation code, seq)."""
    import base64
    import hashlib
    h = hashlib.sha1(("%s|%s|%d" % (owner, code, seq)).encode("utf-8"))
    return "US" + base64.b32encode(h.digest()).decode("ascii")[:24]


def _us_owner(conn):
    try:
        import ax_engine as AXE
        return AXE.owning_agent_for(conn)
    except Exception:                                    # noqa: BLE001
        return "warg"  # estate-scrub:allow(legacy DB slug value, a data contract kept for pre-049 DBs)


def _resolve_exercise(conn, name, owner):
    return conn.execute(
        "SELECT ulid, exercise_name, movement, measure, load_type "
        "FROM ax_exercise WHERE exercise_name=? AND status='active' "
        "ORDER BY (owning_agent=?) DESC, ulid LIMIT 1",
        (name, owner)).fetchone()


def derive_us_rows(conn, code, slots, owner):
    """([row, ...], [(seq, name), ...unresolved]) for one rotation day.
    `slots` are in rx-calc priority order."""
    rows, unresolved = [], []
    for i, slot in enumerate(slots):
        seq = i + 1
        name = slot.get("name")
        ax = _resolve_exercise(conn, name, owner) if name else None
        if ax is None:
            unresolved.append((seq, name))
            continue
        measure = ax[3]
        rr = slot.get("rep_range") or []
        if len(rr) == 2:
            target = "%d-%d%s" % (int(rr[0]), int(rr[1]),
                                  "s" if measure == "hold_sec" else "")
        else:
            target = None
        rest = slot.get("rest_sec")
        if rest is None:
            rest = 150 if ax[2] == "compound" else 90
        rows.append({
            "ulid": us_step_ulid(owner, code, seq),
            "owning_agent": owner,
            "session_ref": code,
            "seq": seq,
            "exercise_ref": ax[0],
            "step_type": "hold" if measure == "hold_sec" else "working",
            "group_id": None,
            "display_source": "exercise_derived",
            "display_key": slot.get("display") or None,
            "equipment_need": ("bodyweight" if ax[4] == "bodyweight"
                               else "equipment"),
            "measure": measure,
            "target": target,
            "rest_sec": int(rest),
            "suppress_alert": 0,
            "next_hint": None,
            "created_at": US_STEP_CREATED_AT,
        })
    return rows, unresolved


_US_UPSERT = (
    "INSERT INTO us_step (ulid, owning_agent, session_ref, seq, exercise_ref, "
    "step_type, group_id, display_source, display_key, equipment_need, "
    "measure, target, rest_sec, suppress_alert, next_hint, created_at) "
    "VALUES (:ulid, :owning_agent, :session_ref, :seq, :exercise_ref, "
    ":step_type, :group_id, :display_source, :display_key, :equipment_need, "
    ":measure, :target, :rest_sec, :suppress_alert, :next_hint, :created_at) "
    "ON CONFLICT(ulid) DO UPDATE SET exercise_ref=excluded.exercise_ref, "
    "step_type=excluded.step_type, display_source=excluded.display_source, "
    "display_key=excluded.display_key, "
    "equipment_need=excluded.equipment_need, measure=excluded.measure, "
    "target=excluded.target, rest_sec=excluded.rest_sec")

_US_COLS = ("exercise_ref", "step_type", "display_key", "equipment_need",
            "measure", "target", "rest_sec")


def sync_us_steps(db_path, program, codes=None, dry_run=False):
    """Derive us_step rows for every rotation day (or only `codes`) from the
    card. `program` = {"rotation": [...], "days": {code: {"exercises": [...]}}}
    with each day's exercises ALREADY in rx-calc priority order.

    Returns {"owner", "seeded": {code: n}, "changed": [...], "removed": [...],
             "unresolved": [(code, seq, name)], "collisions": [code],
             "error": str|None}. Idempotent: an unchanged card changes nothing.
    """
    rep = {"owner": None, "seeded": {}, "changed": [], "removed": [],
           "unresolved": [], "collisions": [], "error": None}
    try:
        conn = sqlite3.connect(os.path.abspath(db_path))
    except sqlite3.Error as e:
        rep["error"] = "cannot open db: %s" % e
        return rep
    try:
        conn.execute("PRAGMA foreign_keys=ON;")
        cols = {r[1] for r in conn.execute("PRAGMA table_info(us_step)")}
        if not cols:
            rep["error"] = "no us_step table on this DB (kit too old)"
            return rep
        owner = _us_owner(conn)
        rep["owner"] = owner
        rotation = list(program.get("rotation") or [])
        touched = []
        for code in rotation:
            if codes is not None and code not in codes:
                continue
            slots = ((program.get("days") or {}).get(code) or {}).get(
                "exercises") or []
            rows, unresolved = derive_us_rows(conn, code, slots, owner)
            rep["unresolved"].extend((code, s, n) for s, n in unresolved)
            # UNIQUE(session_ref, seq) is crew-wide, not per owner. A foreign
            # agent's row under the same day code would make every insert
            # fail; say so and leave that day alone rather than stomp it.
            foreign = conn.execute(
                "SELECT COUNT(*) FROM us_step WHERE session_ref=? AND "
                "owning_agent<>?", (code, owner)).fetchone()[0]
            if foreign:
                rep["collisions"].append(code)
                continue
            have = {r[0]: r for r in conn.execute(
                "SELECT ulid, exercise_ref, step_type, display_key, "
                "equipment_need, measure, target, rest_sec, seq "
                "FROM us_step WHERE session_ref=? AND owning_agent=?",
                (code, owner)).fetchall()}
            want_ids = set()
            for r in rows:
                want_ids.add(r["ulid"])
                old = have.get(r["ulid"])
                if old is None or tuple(old[1:8]) != tuple(
                        r[c] for c in _US_COLS):
                    rep["changed"].append("%s#%d" % (code, r["seq"]))
                    if not dry_run:
                        conn.execute(_US_UPSERT, r)
            # Slots that no longer exist (roster shrank) or no longer resolve.
            for ulid, old in have.items():
                if ulid not in want_ids:
                    rep["removed"].append("%s#%d" % (code, old[8]))
                    if not dry_run:
                        conn.execute("DELETE FROM us_step WHERE ulid=?",
                                     (ulid,))
            rep["seeded"][code] = len(rows)
            touched.append(code)
        if dry_run:
            conn.rollback()
            return rep
        conn.commit()
        if rep["changed"] or rep["removed"]:
            try:
                import us_render as USR
                conn.row_factory = sqlite3.Row
                for code in touched:
                    USR.materialize_next_hint(conn, code, write=True)
            except Exception as e:                       # noqa: BLE001
                rep["error"] = "next_hint materialize failed: %s" % e
    except sqlite3.Error as e:
        try:
            conn.rollback()
        except sqlite3.Error:
            pass
        rep["error"] = str(e)
    finally:
        conn.close()
    return rep


def load_card_ordered(path):
    """The card on disk through rx-calc's own loader (priority-sorted days)."""
    return _load_rx().load_yaml(path)


def report_us_sync(rep):
    """TAB line + prose. Returns True when every slot that CAN carry a
    us_step does."""
    if rep.get("error"):
        sys.stderr.write(
            "program-init: us_step derivation FAILED: %s\n"
            "  `ax-project serve` cannot realize a working weight for this "
            "card until it succeeds. Re-run: service/health/program-init "
            "sync\n" % rep["error"])
        print("USSTEP\tfailed\t%s" % rep["error"])
        return False
    print("USSTEP\tok\towner=%s\tseeded=%s\tchanged=%d\tremoved=%d"
          % (rep["owner"], ",".join("%s:%d" % kv for kv in
                                    rep["seeded"].items()) or "-",
             len(rep["changed"]), len(rep["removed"])))
    if rep["unresolved"]:
        sys.stderr.write(
            "program-init: %d slot(s) have no catalog row yet, so serve has "
            "no us_step for them (a machine/cable lift is registered on first "
            "use, then `program-init sync` seeds it): %s\n"
            % (len(rep["unresolved"]), ", ".join(
                "%s#%s %s" % u for u in rep["unresolved"])))
        print("USSTEP\tunresolved\t%s" % ",".join(
            "%s#%s:%s" % u for u in rep["unresolved"]))
    if rep["collisions"]:
        sys.stderr.write(
            "program-init: day code(s) %s already carry another agent's "
            "us_step rows on this crew DB; left untouched.\n"
            % ", ".join(rep["collisions"]))
        print("USSTEP\tcollision\t%s" % ",".join(rep["collisions"]))
        return False
    return True


def session_type_state(db_path, program=None):
    """(count, [missing_code, ...], error). What `check` and session-open want:
    is the registry the card's rotation actually resolvable?"""
    try:
        conn = sqlite3.connect(
            "file:%s?mode=ro" % os.path.abspath(db_path), uri=True)
    except sqlite3.Error as e:
        return None, [], str(e)
    try:
        n = conn.execute("SELECT COUNT(*) FROM session_type").fetchone()[0]
        missing = []
        if program:
            have = set(r[0] for r in conn.execute(
                "SELECT code FROM session_type").fetchall())
            for code in list(program.get("rotation") or []) + [MAKEUP_CODE]:
                if code not in have:
                    missing.append(code)
        return n, missing, None
    except sqlite3.Error as e:
        return None, [], str(e)
    finally:
        conn.close()


