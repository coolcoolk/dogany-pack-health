# a live tree keeps this script in files/program/ (no sibling there), so it
# falls straight through to the database/ path and LIVE BEHAVIOUR IS UNCHANGED.
_AX_ENGINE_CANDIDATES = (
    ("ax_engine.py",),                          # pack: service/health sibling
    ("..", "..", "database", "ax_engine.py"),   # live: <root>/database
)
_AX_WARNED = [False]


def ax_engine_path():
    """Absolute path to the ax_engine.py this tree should import, or the LIVE
    candidate when neither exists (so the error names the historical path)."""
    for parts in _AX_ENGINE_CANDIDATES:
        cand = os.path.abspath(os.path.join(SCRIPT_DIR, *parts))
        if os.path.exists(cand):
            return cand
    return os.path.abspath(os.path.join(SCRIPT_DIR,
                                        *_AX_ENGINE_CANDIDATES[-1]))


def _announce_ax_engine_missing(exc):
    """ONE stderr line, ONCE per process, when the engine will not load.

    SILENT-VS-LOUD (audit 2026-09-12 2.1). Two failure classes were being
    collapsed into one `except Exception`:
      * a PER-CALL miss -- unmapped lift, DB row absent, a rung with no weight.
        Genuinely best-effort: drop the cue and say nothing. Correct, and stays.
      * a STRUCTURAL absence -- the engine file is not where any caller can see
        it. That is an INSTALL defect: total, affecting every answer, never
        self-healing, and invisible to the owner because the card still renders.
    The second class is now announced. STDERR, not the owner, and it does NOT
    raise: a mid-set arm must never die to prove a configuration point, and a
    broken-install banner on a set-start push is noise nobody can act on
    between sets. The durable detector is the test (tests/
    test-backport-round5-ax-engine.py K13), which fails the pack before it
    ships; this line is the runtime backstop for a tree that shipped anyway."""
    if _AX_WARNED[0]:
        return
    _AX_WARNED[0] = True
    probed = ", ".join(os.path.abspath(os.path.join(SCRIPT_DIR, *p))
                       for p in _AX_ENGINE_CANDIDATES)
    sys.stderr.write(
        "[set-arm] AX-ENGINE-MISSING: ax_engine.py did not load (%s). Plate "
        "cue, rung label, ladder taper and RIR all degrade to absent in this "
        "process. probed: %s\n" % (exc, probed))


def load_ax_engine():
    """Import the pack engine ax_engine.py as a module. Same lazy importlib
    pattern set-table uses; ax_engine does no module-level work (its kit_life/DB
    access is all lazy), so import has no side effects. The file is located via
    ax_engine_path() -- see the seam note above for why there are two."""
    path = ax_engine_path()
    try:
        spec = importlib.util.spec_from_file_location("ax_engine", path)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
    except Exception as exc:      # noqa: BLE001 -- announce, then re-raise
        _announce_ax_engine_missing(exc)
        raise
    return mod


def ax_engine():
    global _AX_ENGINE
    if _AX_ENGINE is None:
        _AX_ENGINE = load_ax_engine()
    return _AX_ENGINE


