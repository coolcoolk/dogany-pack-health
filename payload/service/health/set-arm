        return None


def set_write_bound(db_path, session_id, exercise_name, set_seq):
    """C12-B ARM-TRIGGER BINDING (owner live 2026-08-24). Is THIS arm actually
    bound to a real set WRITE? Returns (bound, reason).

    THE DEFECT THIS CLOSES. `set-arm <sid> <ex> <seq>` is a plain CLI: anyone
    -- including the model, mid-conversation -- can run it with an arbitrary
    seq and a full between-set rest stack fires. So "a set was recorded" and "a
    timer was armed" were two INDEPENDENT ledgers, and workout-session/SKILL.md
    line 319's claim -- that the rest-timer main path only ever runs after a
    set-add write -- was documentation of a calling convention, not a mechanism.
    Live proof, session 10091 2026-08-24: .ch2-push.log 08:37:39 gen=15 armed a
    CONTINUATION rest while workout_sets held NOTHING for tricep_pushdown_rope
    until 08:41:53 (id 10568). QUOTED EVIDENCE -- the push text actually emitted
    (verbatim, not prose, do not translate):
        "✅ 60초 휴식 완료 🏋️ 세트 시작 — 로프 삼두 푸시다운"
    A rest ran on the owner's phone for a set that did not exist.

    THE BINDING. An inter-set rest may only arm off a set that is (1) WRITTEN
    and (2) the session's NEWEST write. Every legitimate caller satisfies both
    by construction -- set-add._arm() fires set-arm strictly POST-COMMIT -- so this costs the real path nothing
    and refuses exactly the fabricated ones:
      no-set-row   -- no workout_sets row at (session, exercise, set_seq): the
                      arm is for a set that was never recorded.
      stale-set-row-- the row exists but a LATER set (any exercise, incl. a
                      warm-up rung of the next one) has since been written, so
                      this rest boundary is already behind us. Also correctly
                      refuses a rest on an in-place CORRECTION of an older set.
      db-unreadable-- cannot PROVE a write. Suppress: ghost-arm suppression is
                      the safe side (set-arm's standing F14 degrade doctrine --
                      a missing timer beats a phantom one on the owner's phone).

    Scope: the rest path ONLY. `set-arm countdown` (F22/F15 press-start hold),
    `set-arm hold-chain` (unilateral hold chain) and `set-arm reps-entry`
    (DGN-918 pre-log keyboard) are dispatched BEFORE this and are legitimately
    decoupled from a set write -- they must never reach this gate."""
    try:
        conn = _db_connect(db_path)
        try:
            row = conn.execute(
                "SELECT id FROM workout_sets WHERE session_id = ? AND "
                "exercise_name = ? AND set_seq = ?",
                (session_id, exercise_name, set_seq)).fetchone()
            if row is None:
                return False, "no-set-row"
            newest = conn.execute(
                "SELECT id FROM workout_sets WHERE session_id = ? "
                "ORDER BY id DESC LIMIT 1", (session_id,)).fetchone()
        finally:
            conn.close()
        if newest is not None and int(newest[0]) != int(row[0]):
            return False, "stale-set-row"
        return True, "bound"
    except Exception:  # noqa: BLE001 -- cannot prove a write -> suppress
        return False, "db-unreadable"


# ---------------------------------------------------------------------------
# THE PREP GATE (2026-08-27). MEASURED, in the first minutes of a live session.
#
# next_ladder_seq below walks bw(0) -> ramp(-1..-k) -> working(1..n) and knows
# NOTHING about the PREP band (set_seq <= set-table.PREP_SEQ_BASE), which was
# added later, on 2026-08-25. Two consequences, both observed:
#   * at ENTRY, with an empty prep band and no working rows, the resolver
#     answered "the first un-logged rung", so the entry arm fired a bw-rung rep
#     keyboard immediately after printing the prep plan -- the owner was handed
#     a rep keyboard INSTEAD of their mat prep;
#   * after prep drill 1 landed at set_seq -100, logged_seqs grew but `working`
#     was still empty and -100 matches no ramp row, so the SAME rung came back
#     and the prompt RE-FIRED mid-prep.
#
# This is the same defect class the ramp band already had fixed once (see the
# arm_reps_first note in exercise-enter): a band exists in the data that the
# ladder resolver cannot see, so the resolver answers for the wrong band. The
# fix is the same shape and it is a SUPPRESSION, not a new lane -- while this
# slot's prep band is INCOMPLETE the ramp/working lane is CLOSED and nothing is
# armed at all. Prep drills do not need this lane: exercise-enter already prints
# a literal PREP_SET_CMD set-add argv for each one, which is how a prep row gets
# recorded.
#
# FAIL-OPEN, deliberately. "No prep planned" and "we could not read the plan"
# BOTH leave the lane OPEN. A slot with no prep must not become unusable, and a
# prep.yaml miss must never be the reason a working set cannot be armed.
# ---------------------------------------------------------------------------
def _prep_band_counts(rx, program_path, db_path, session_id, exercise_name):
    """(planned, entry_planned, logged) for this (session, exercise).

    D10/D16 (2026-09-02). The gate below used to compare ONE total against ONE
    logged count, which quietly asserted that every prep drill is due before the
    warmup. The declared order says otherwise, and has since #26:

        mat_prep -> equipment_prep -> [entry: cue + table + warmup/ramp]
                 -> immediate_primer -> working set 1

    `entry_planned` is the count due before the ramp; the remainder is deferred
    to just before working set 1. The split comes from
    set-table.prep_phase_split, which derives it from prep_plan_ordered -- the
    same ordering that assigns the set_seqs -- so comparing it against a logged
    COUNT is positionally exact and needs no join.

    The drills are resolved with the SESSION CONTEXT (db_path/session_id), the
    same way exercise-enter resolves them, because the mat-prep host is chosen
    per session (2026-09-01). Without it a resumed session plans drills the gate
    cannot see, so the gate would count a different number than the owner was
    shown -- measured as planned=2 against a 6-drill plan.

    Same best-effort contract as before: any miss -> (0, 0, 0), which reads as
    "no prep planned" and leaves the lane OPEN."""
    try:
        st = set_table()
        program = rx.load_yaml(program_path)
        day_code = find_day_code(program, db_path, session_id, exercise_name)
        slot = find_slot(program, db_path, session_id, exercise_name)
        slot_num = (slot or {}).get("slot")
        drills = st.slot_prep_drills(rx, program_path, day_code, slot_num,
                                     db_path=db_path,
                                     session_id=session_id) or []
        planned = len([d for d in drills if isinstance(d, dict)])
        entry_planned, _deferred = st.prep_phase_split(drills)
        logged = len([s for s in logged_seqs(db_path, session_id, exercise_name)
                      if s <= st.PREP_SEQ_BASE])
        return planned, entry_planned, logged
    except Exception:  # noqa: BLE001 -- an unreadable plan never closes the lane
        return 0, 0, 0


def prep_band_state(rx, program_path, db_path, session_id, exercise_name):
    """(planned, logged) prep-drill counts for this (session, exercise).

    planned -- how many drills this slot's prep plan declares. Read from the ONE
      projection the live plan and 표2 both read (set-table.slot_prep_drills
      over prep.yaml), counted the same way exercise-enter's extract_prep_plan
      counts it (dict items only, entry + immediate_primer). NOT a second source
      of truth: if this number ever disagreed with the number of PREP_SET lines
      the owner was shown, the gate would be gating something they cannot see.
    logged  -- how many rows already sit in the PREP BAND for this
      (session, exercise), i.e. set_seq <= set-table.PREP_SEQ_BASE.

    Best-effort: any miss -> (0, 0), which reads as "no prep planned" and
    therefore keeps the lane OPEN (see prep_lane_open).

    The counting rule itself lives in _prep_band_counts, which this delegates
    to -- one home for the rule -- and this signature is kept because three
    suites read it."""
    planned, _entry, logged = _prep_band_counts(
        rx, program_path, db_path, session_id, exercise_name)
    return planned, logged


def prep_lane_open(rx, program_path, db_path, session_id, exercise_name,
                   next_seq=None):
    """Is the ramp/working lane open for this (session, exercise) right now?

    Returns (open, reason, planned, logged). `reason` is a stable token meant
    for the IDRILL_ARM audit line, never for the owner:
        no_prep_planned        -- this slot declares no prep drills (fail-open)
        prep_complete          -- every declared drill has a row in the band
        entry_prep_complete    -- the entry drills are done; a deferred primer
                                  is still outstanding, but the WARMUP lane it
                                  does not block is open
        prep_incomplete        -- working set 1 is due and a drill is missing
        entry_prep_incomplete  -- the warmup is due and an ENTRY drill is missing

    `next_seq` (D10/D16, 2026-09-02) -- WHAT is about to be armed, because that
    decides WHICH drills are due. A rung (<= 0) is due after the entry drills;
    a working set (>= 1) is due after the immediate_primer as well. Passing
    None keeps the pre-2026-09-02 behaviour EXACTLY (require the whole band),
    which is what every caller that does not say gets.

    WHY THIS SPLIT IS THE FIX, measured on a real slot:
      the slot planned 2 (an equipment_prep and a deferred immediate_primer)
      and had 1 logged. The flat rule answered "closed" -- and kept answering
      "closed" for the rest of the slot. So the ramp rungs, all three working
      sets and every choice point in between were armed by nobody: the engine
      emitted `armed=no` each time and the model fell back to prose. That is
      the same slot reported as having no buttons at the ramp (D17), none at
      working-set entry (D21) and none at the real fork (D13), and the same
      slot whose primer was never performed and was then offered after all
      three working sets (D16).
      Under the split: the equipment_prep is logged -> the ENTRY phase is
      complete -> the ramp lane OPENS (it was wrongly shut). Working set 1
      then finds the primer outstanding, so the lane shuts at exactly the
      boundary `defer=first_working_set` has always declared, and
      prep_next_tap puts the primer in front of the owner as a completion tap.

    Net direction: this only ever OPENS lanes the flat rule had shut, plus one
    closure that the flat rule was already applying at that same moment. It
    cannot strand anyone -- every closure it returns is paired with the
    prep_next_tap affordance that advances it in one tap."""
    planned, entry_planned, logged = _prep_band_counts(
        rx, program_path, db_path, session_id, exercise_name)
    if planned <= 0:
        return True, "no_prep_planned", planned, logged
    # A deferred primer is due only when a WORKING set is what comes next.
    # next_seq is None -> caller did not say -> assume the strictest (the
    # historical answer), never the loosest.
    deferred_due = (next_seq is None or next_seq >= 1)
    required = planned if deferred_due else entry_planned
    if logged >= required:
        return (True,
                "prep_complete" if logged >= planned else "entry_prep_complete",
                planned, logged)
    return (False,
            "prep_incomplete" if deferred_due else "entry_prep_incomplete",
            planned, logged)


def prep_next_tap(rx, program_path, db_path, session_id, exercise_name):
    """The COMPLETION AFFORDANCE for the next un-logged prep drill, or None.

    2026-08-27, the other half of the prep gate. Closing the ramp/working lane
    while the band is short stopped the WRONG thing from being armed; it did not
    supply the RIGHT one, so between drills the engine emitted `IDRILL_ARM
    armed=no` and nothing tappable, and the owner had to type to advance.

    What this returns is a SINGLE COMPLETION TAP, never a rep keyboard. The
    derivation table's prep row reads `completion_tap` (owner ruling 2026-08-27:
    prep is not a challenge set, so the prescribed value IS the recorded value),
    and the argv comes from set-table.prep_set_argv -- the SAME builder
    exercise-enter emits at entry. Two builders would eventually store two
    different rows for one tap.

    Returns (label, seq, drill, slot_num, spec, argv) or None. Best-effort: any
    miss -> None and the caller simply says nothing extra."""
    try:
        st = set_table()
        program = rx.load_yaml(program_path)
        day_code = find_day_code(program, db_path, session_id, exercise_name)
        slot = find_slot(program, db_path, session_id, exercise_name)
        slot_num = (slot or {}).get("slot")
        drills = st.slot_prep_drills(rx, program_path, day_code, slot_num,
                                     db_path=db_path,
                                     session_id=session_id) or []
        plan = st.prep_plan_ordered(drills)
        if not plan:
            return None
        done = set(s for s in logged_seqs(db_path, session_id, exercise_name)
                   if s <= st.PREP_SEQ_BASE)
        for seq, drill in plan:
            if seq in done:
                continue
            spec = st.prep_target_spec(drill)
            argv = st.prep_set_argv(session_id, exercise_name, slot_num, seq,
                                    drill)
            return (st.seq_label(seq), seq, drill, slot_num, spec, argv)
        return None
    except Exception:  # noqa: BLE001 -- never break arming on a prep read
        return None


def emit_prep_tap_lines(tap, posted=False):
    """prep_next_tap(...) -> the stdout lines that put ONE completion button in
    front of the owner. Empty list when there is no next drill.

    Two lines, mirroring exercise-enter's PREP_SET / PREP_SET_CMD pair so the
    surface reads the same whether the drill was announced at entry or after the
    previous drill landed:

      PREP_TAP p3 code=<code> target=10/side unit=per_side keyboard=completion_tap
      PREP_TAP_CMD p3 set-add <sid> <ex> <slot> -102 10 --set-kind prep ...

    `target` carries the UNIT in the token itself. A prep drill's prescribed
    value is a total rep count, a PER-SIDE rep count, a round count or a hold-set
    count depending on the drill (prep.yaml `target_unit`), and printing the bare
    integer is what let one round be stored as one repetition."""
    if not tap:
        return []
    label, seq, drill, _slot_num, spec, argv = tap
    # posted=True: the button is already on the owner's screen (row_keyboard,
    # by code). The line then says so and asks for nothing to be rendered --
    # a second, model-authored button would be two live keyboards for one row.
    head = ("PREP_TAP %s code=%s target=%s unit=%s keyboard=completion_tap"
            % (label, (drill or {}).get("code"), spec["token"], spec["unit"]))
    if posted:
        first = (head + " posted=code -- the completion button for this "
                 "drill is already on the owner's screen (posted by code). "
                 "Do NOT render a button and do NOT ask how many reps. When "
                 "its tap arrives, run PREP_TAP_CMD %s verbatim." % label)
    else:
        first = (head + " -- "
                 "render ONE completion button (a single-item options block) "
                 "for this drill. Do NOT ask "
                 "how many reps and do NOT offer numbers: the prescribed value "
                 "is the recorded value. State the prescription in the "
                 "drill's OWN unit (display verbatim).")
    lines = [first, "PREP_TAP_CMD %s %s" % (label, " ".join(argv))]
    if not spec["prescribed"]:
        # No owner-stated value anywhere. Run the drill and take the tap with NO
        # count mentioned -- never invent one, never stop the session to ask
        # (2026-08-27 live: the session stopped mid-prep over exactly this).
        lines.append(
            "PREP_TAP_NO_TARGET %s code=%s -- prep.yaml states no target for "
            "this drill. Announce it with NO count and take the completion "
            "tap; record the gap as a post-session item."
            % (label, (drill or {}).get("code")))
    return lines


# ---------------------------------------------------------------------------
# THE RAMP GATE (2026-09-11). The other half of the ladder-basis fix.
#
# The fallback above resolves a basis whenever ANY source can name one. When
# none can -- a lift with no declared weight, no prescription and no logged
# history -- the ladder is genuinely empty, and the old code's answer was to say
# nothing and let next_ladder_seq return 1. That is not a degrade, it is a
# SUBSTITUTION: "we could not work out a warm-up" silently became "no warm-up is
# needed", and the owner walked into their first working set cold.
#
# Owner's ruling, in their frame: 무게를 못 구하는 것보다, 못 구했는데 아무 말
# 없이 워킹세트를 여는 것이 더 나쁘다. So the lane CLOSES and the turn says why.
#
# SHAPE COPIED FROM prep_lane_open, deliberately -- one gate vocabulary on this
# path, not two. Same (open, reason, ...) tuple, same "closed means arm nothing",
# same `IDRILL_ARM armed=no reason=<code>` machine line.
#
# SCOPE, kept as narrow as the defect:
#   * only while NO working set is logged for this (session, exercise). Once the
#     owner is on set 2 the ladder is behind them and a refusal would strand a
#     live session mid-exercise;
#   * only on RAMP_R_NO_WEIGHT. Every other RAMP_NO reason -- not_ramp_class,
#     assist_loaded, at_or_below_bar, no_rung_below_working -- is a real answer
#     ("this lift has no ladder"), and those lifts must keep arming exactly as
#     they do today;
#   * FAIL-OPEN on RAMP_R_UNREADABLE. An unreadable plan is our problem, not a
#     reason to refuse the owner a set (the same doctrine prep_lane_open states).
# ---------------------------------------------------------------------------
RAMP_LANE_NO_BASIS = "ramp_no_basis"      # CLOSED: no load resolves, anywhere
RAMP_LANE_WORKING = "working_in_progress"  # open: the ladder is behind us
RAMP_LANE_UNREADABLE = "ramp_unreadable"   # open: we could not read the plan
# rehearsal S2 (2026-10-10): open AS CALIBRATION -- a calibrating lift (no
# history, no declared weight) whose climb exercise-enter already announced
# (CALIBRATION_RAMP). No target is not a missing input here, it is the state
# the climb exists to resolve: the lane stays open, arms NO working set and NO
# rest timer, and the cue asks for the next rung. Closing it asked the owner
# for today's weight, so their next "60-5" read as a target instead of a done set.
RAMP_LANE_CALIBRATION = "ramp_calibration"


def ramp_lane_open(rx, program_path, db_path, session_id, exercise_name,
                   override=None):
    """Is the ramp/working lane open for this (session, exercise) right now?

    Returns (open, reason, plan). `reason` is a stable token for the
    `IDRILL_ARM` audit line, never for the owner -- the owner-facing sentence is
    ramp_blocked_say(). `plan` is resolve_ramp_plan's dict, or None when the
    question was answered without needing one."""
    try:
        if any(s >= 1 for s in logged_seqs(db_path, session_id,
                                           exercise_name)):
            return True, RAMP_LANE_WORKING, None
        plan = resolve_ramp_plan(rx, program_path, db_path, session_id,
                                 exercise_name, override)
        if plan["reason"] == RAMP_R_UNREADABLE:
            return True, RAMP_LANE_UNREADABLE, plan
        if plan["reason"] == set_table().RAMP_R_NO_WEIGHT:
            calib = _calibration_state(rx, program_path, db_path, session_id,
                                       exercise_name)
            if calib is not None:
                plan = dict(plan, calibration=calib)
                return True, RAMP_LANE_CALIBRATION, plan
            return False, RAMP_LANE_NO_BASIS, plan
        return True, plan["reason"], plan
    except Exception:  # noqa: BLE001 -- a gate miss never closes the lane
        return True, RAMP_LANE_UNREADABLE, None


def _calibration_state(rx, program_path, db_path, session_id, exercise_name):
    """live_load.calibration_open for this slot, or None. Best-effort: a miss
    keeps the pre-S2 verdict (closed)."""
    try:
        if SCRIPT_DIR not in sys.path:
            sys.path.insert(0, SCRIPT_DIR)
        import live_load as _ll
        slot = _ll.find_slot(rx, program_path, db_path, session_id,
                             exercise_name)
        if not isinstance(slot, dict):
            return None
        slot = _ll.view(rx, slot, db_path, session_id, exercise_name)
        return _ll.calibration_open(rx, slot, db_path, session_id,
                                    exercise_name)
    except Exception:  # noqa: BLE001
        return None


def _calibration_bar_seq(db_path, session_id, exercise_name):
    """The ramp seat the empty-bar rung records at: the first free seq from -1
    down (set-add's _next_ramp_seq numbering; seq 0 is the bodyweight primer's
    seat, and its table label 'bw' would misname a bar set)."""
    seqs = logged_seqs(db_path, session_id, exercise_name) if db_path else set()
    seq = -1
    while seq in seqs:
        seq -= 1
    return seq


def _calibration_slot_num(rx, program_path, db_path, session_id,
                          exercise_name, override=None):
    """The slot number for the empty-bar RUNG_SET_CMD. Best-effort: a miss
    prints 'session' in the argv (set-add's slot-less form)."""
    try:
        return resolve_current_arm_data(rx, program_path, db_path, session_id,
                                        exercise_name, override)[0]
    except Exception:  # noqa: BLE001
        return None


def emit_ramp_calibration_lines(exercise_name, display, plan=None,
                                session_id=None, slot_num=None, db_path=None):
    """The lines for a lane open AS CALIBRATION (no target yet). Nothing is
    armed: the next rung's load is the owner's to report, and a working set
    (keyboard, rest timer) waits for a working weight.

      IDRILL_ARM armed=no reason=ramp_calibration
      CALIBRATION_NEXT exercise=<name> rungs=<n> top=<kg>x<reps>|none ...
      CALIBRATION_NEXT_SAY: <one owner sentence>
      RUNG_SET_CMD r<N> set-add ... --weight <bar> --set-kind ramp   (rungs=0, bar)

    Rehearsal S2 r3 (2026-10-11): with rungs=0 the climb's first set is the
    empty bar, a weight this function already knows (start=20 kind=bar). The
    old text said only "log it with set-add as reported", and the model ran
    `set-add <sid> deadlift 1 0 10` with no --weight -- a warm-up row at an
    unknown load. A bar start now prints the complete command, weight included.
    """
    calib = (plan or {}).get("calibration") or {}
    top = calib.get("top")
    say = ""
    try:
        if SCRIPT_DIR not in sys.path:
            sys.path.insert(0, SCRIPT_DIR)
        import live_load as _ll
        say = _ll.calibration_next_say(display, calib)
    except Exception:  # noqa: BLE001
        pass
    lines = [
        "IDRILL_ARM armed=no reason=%s" % RAMP_LANE_CALIBRATION,
        "CALIBRATION_NEXT exercise=%s rungs=%d top=%s -- calibration in "
        "progress: no working weight yet, so no working set and no rest "
        "timer is armed. The owner's next reported set (weight + reps, any "
        "load) is a warm-up rung: log it with set-add as reported (set-add "
        "classifies it). A working weight exists only when the owner names "
        "it (set-arm --ov-weight <kg> --ov-by owner) or the code derives it. "
        "Relay CALIBRATION_NEXT_SAY verbatim; do NOT ask for today's weight."
        % (exercise_name, int(calib.get("rungs") or 0),
           ("%sx%s" % (_fmt_load_kg(top[0]), top[1])) if top else "none"),
    ]
    if say:
        lines.append("CALIBRATION_NEXT_SAY: %s" % say)
    start = calib.get("start")
    if (session_id is not None and not int(calib.get("rungs") or 0)
            and start and start[1] == "bar" and start[0] is not None):
        seq = _calibration_bar_seq(db_path, session_id, exercise_name)
        lines.append("RUNG_SET_CMD %s %s" % (rung_label_for_seq(seq), " ".join(
            rung_set_argv(session_id, exercise_name, slot_num, seq, start[0],
                          10))))
        lines.append("RUNG_SET_CMD_RULE -- the climb starts at the empty bar "
                     "(%skg). When the owner reports it, run the RUNG_SET_CMD "
                     "line above VERBATIM, changing only the reps number to "
                     "the count they did. Never drop --weight; never compose "
                     "set-add arguments yourself." % _fmt_load_kg(start[0]))
    return lines


def _slot_display(rx, program_path, db_path, session_id, exercise_name,
                  override=None):
    """Owner-facing name for this exercise -- the F19 substitution display when
    one is set, else the slot's own `display`, else the raw name. Best-effort."""
    if override and override.get("display"):
        return str(override["display"])
    try:
        program = rx.load_yaml(program_path)
        slot = find_slot(program, db_path, session_id, exercise_name)
        return (slot or {}).get("display") or exercise_name
    except Exception:  # noqa: BLE001
        return exercise_name


def ramp_basis_say(display, basis):
    """The ONE owner-facing sentence naming where a DERIVED ladder's weight came
    from, or None when nothing was derived (an rx prescription or the owner's
    own override needs no explanation -- they already know).

    Exists because ruling 3 of the 2026-09-11 design call is that a derived
    ladder must be auditable: 「주인이 '왜 이 무게냐'를 물을 수 있어야 한다」.
    States the number, its source and its DATE, then how to overrule it."""
    if not basis or basis.get("source") != RAMP_BASIS_LAST_LOGGED:
        return None
    kg = _fmt_load_kg(basis.get("weight"))
    when = basis.get("as_of")
    return ("%s 웜업 사다리는 지난 기록 무게 %skg%s 기준으로 세웠습니다 -- "
            "프로그램에 오늘 무게가 비어 있어서요. 다른 무게로 가시면 말씀만 "
            "주시면 사다리를 다시 세웁니다."
            % (display, kg, ("(%s)" % when) if when else ""))


def ramp_blocked_say(display):
    """The ONE owner-facing sentence for a CLOSED ramp lane. Says what is
    missing, says that nothing was armed BECAUSE of it, and asks for the one
    input that reopens the lane. Never offers to proceed without a weight: that
    silent proceed is the defect."""
    return ("⚠️ %s -- 오늘 들 무게를 알 수가 없습니다. 프로그램에 무게가 비어 "
            "있고 지난 기록도 없어서 웜업 사다리를 세울 수 없었습니다. 웜업 "
            "없이 워킹세트를 열지 않았습니다 -- 오늘 몇 kg으로 가실지 알려주시면 "
            "거기서부터 사다리를 세웁니다."
            % display)


def emit_ramp_basis_lines(exercise_name, display, basis):
    """The stdout lines that put a DERIVED ladder's provenance in front of the
    owner. Empty list for a declared/prescribed basis -- nothing to explain.

    Two lines, the D4 split the SKILL's token table already declares: the raw
    code rides the machine line, the Korean rides the colon line.

      RAMP_BASIS_REASON exercise=<name> kg=<v> source=last_logged as_of=<date>
      RAMP_BASIS: <한국어 한 문장>
    """
    say = ramp_basis_say(display, basis)
    if say is None:
        return []
    return [
        "RAMP_BASIS_REASON exercise=%s kg=%s source=%s as_of=%s"
        % (exercise_name, _fmt_load_kg(basis.get("weight")),
           basis.get("source"), basis.get("as_of") or "none"),
        "RAMP_BASIS: %s" % say,
    ]


# ---------------------------------------------------------------------------
# "왜 웜업이 없는지" (2026-09-11). The half of the morning's ramp fix that had
# not landed yet.
#
# That fix made the ramp REASON survive the trip from set-table to the arm path.
# It is still not visible to the owner anywhere except the ONE case that closes
# the lane (RAMP_R_NO_WEIGHT). Every other refusal -- this lift has no ladder
# class, the load is at or below the bar, the ladder produced nothing under the
# working weight -- arms the working set and says NOTHING.
#
# 「웜업 없습니다」 is not a statement the owner can argue with. 「왜 없는지」는
# 반박할 수 있다, and being able to argue is the whole point: on 2026-08-25 the
# turn DEFENDED an absent ramp ("엔진이 별도 램프 세트를 산출하지 않았어요") and
# folded twenty seconds later, because it had no reason to hand over and neither
# did the owner. A named reason ends that exchange before it starts.
#
# NARROW, on purpose, and to the SAME band the morning's gate uses: only while
# no working set is logged for this (session, exercise). Once they are on set 2
# the ladder is behind them and re-explaining its absence is noise.
# ---------------------------------------------------------------------------
# The reasons that mean "a ramp was CONSIDERED and refused". RAMP_R_NO_WEIGHT is
# absent because it CLOSES the lane and has its own louder sentence
# (ramp_blocked_say); RAMP_R_UNREADABLE is absent because a resolver crash is
# our problem, not an answer about this lift.
RAMP_ABSENT_KO = {
    "not_ramp_class": ("이 종목은 웜업 사다리를 세우는 종류가 아닙니다 -- "
                       "고립 운동이라 바로 워킹세트로 갑니다."),
    "assist_loaded": ("이 종목은 보조(어시스트) 하중이라 무게를 올려가는 "
                      "사다리가 성립하지 않습니다 -- 바로 워킹세트로 갑니다."),
    "at_or_below_bar": ("오늘 무게가 빈 봉 무게 이하라 그 아래로 밟을 렁이 "
                        "없습니다 -- 빈 봉이 곧 오늘 무게입니다."),
    # Covers both ways a ladder comes up empty -- the working load sits too
    # close to the equipment's light end, and the grid has no settable value in
    # between. Neither is "we saw a rung at the working weight", so the sentence
    # states the ladder's emptiness and only then the policy that keeps us from
    # papering over it.
    "no_rung_below_working": ("오늘 워킹 무게보다 가벼우면서 이 기구로 실제로 "
                              "맞출 수 있는 무게가 안 나왔습니다 -- 그래서 웜업을 "
                              "안 냈습니다. 없는 렁을 워킹 무게로 채우지는 "
                              "않습니다."),
}


def ramp_absent_say(display, reason):
    """The ONE owner-facing sentence for a ramp that was considered and refused,
    or None when this reason is not one of those (a ramp WAS planned, the lane
    is closed and has its own sentence, or the resolver failed).

    Authored here for the same reason ramp_blocked_say is: a consumer that
    composes its own explanation for an engine decision is the 2026-08-25
    failure, where the composed explanation cited the engine and then folded."""
    say = RAMP_ABSENT_KO.get(reason)
    if not say:
        return None
    return "%s -- %s" % (display or "이 종목", say)


def emit_ramp_absent_lines(exercise_name, display, plan=None):
    """The D4 pair for a considered-and-refused ramp. Empty list when there is
    nothing to explain.

      RAMP_ABSENT_REASON exercise=<name> reason=<code> basis=<source>
      RAMP_ABSENT: <한국어 한 문장>
    """
    reason = (plan or {}).get("reason")
    say = ramp_absent_say(display, reason)
    if say is None:
        return []
    basis = ((plan or {}).get("basis") or {}).get("source") or RAMP_BASIS_NONE
    return [
        "RAMP_ABSENT_REASON exercise=%s reason=%s basis=%s"
        % (exercise_name, reason, basis),
        "RAMP_ABSENT: %s" % say,
    ]


def emit_ramp_blocked_lines(exercise_name, display, plan=None):
    """The stdout lines for a CLOSED ramp lane -- same two-line D4 split.

      RAMP_BLOCKED_REASON exercise=<name> reason=no_target_weight basis=none
      RAMP_BLOCKED: <한국어 한 문장>

    The caller prints `IDRILL_ARM armed=no reason=ramp_no_basis` beside these,
    exactly as the prep gate does, so the two closures read identically to
    anything parsing this stdout."""
    reason = (plan or {}).get("reason") or "no_target_weight"
    basis = ((plan or {}).get("basis") or {}).get("source") or RAMP_BASIS_NONE
    return [
        "RAMP_BLOCKED_REASON exercise=%s reason=%s basis=%s"
        % (exercise_name, reason, basis),
        "RAMP_BLOCKED: %s" % ramp_blocked_say(display),
    ]


# ---------------------------------------------------------------------------
# THE PRESCRIPTION OF RECORD ON THE WIRE (2026-09-11, ruling 3).
#
#   세트 시작 발화의 처방값(무게 / 편측 / 반복수 / RIR)은 코드가 낸 값만 쓴다.
#
# The reasoning for the mechanism lives in rx_source.py's header; what happens
# HERE is the first of its three moves: no axis is ever silent. Every arm emits
# all four axes with a value AND the code path that produced it, including
# `unknown:none`, so there is no state in which the wire says nothing about the
# weight and therefore no vacuum for a turn to fill with 115.
#
# It is emitted beside IDRILL_ARM_SEQ rather than folded into the arm PAYLOAD on
# purpose: the payload is a bridge contract (v3.1, declared keys only) and the
# bridge must stay value-agnostic. This is an audit + relay line on the same
# stdout every other decision of this file already rides.
# ---------------------------------------------------------------------------
def _rx_source_mod():
    """rx_source.py as a module. A miss returns None and every caller degrades
    to emitting nothing -- an arm must never break over its own audit line."""
    try:
        import rx_source
        return rx_source
    except Exception:  # noqa: BLE001
        try:
            spec = importlib.util.spec_from_file_location(
                "rx_source", os.path.join(SCRIPT_DIR, "rx_source.py"))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            return mod
        except Exception:  # noqa: BLE001
            return None


def build_rx_record(rs, slot, weight, target_reps, target_rir, rung_label,
                    basis=None, override=None):
    """The four-axis prescription record for the set being armed.

    Every source is READ off the resolution that already happened -- this
    function decides nothing and computes nothing. It only names, per axis,
    which of the existing resolvers answered:

      weight  override(F19/F21) -> ladder(a rung) -> the ramp basis' own source
              -> unknown. The basis source is reused verbatim because
              ramp_basis already ranks override > rx > slot > last_logged and
              stamps the winner; re-deriving that ranking here would be a second
              opinion about the same question.
      exec    set-table.resolve_unilateral -- declared -> S_SLOT, otherwise the
              standing bilateral answer -> S_DEFAULT. Never unknown: that axis
              has a total resolver by construction (incident B).
      reps    the ladder taper for a rung, rx-calc's rep target for a working
              set.
      rir     the RAMP_RIR anchor for a rung, rx-calc's target for a working
              set. Unknown is legal here and is NOT part of the ask sentence --
              a set with no target RIR is ordinary, not a gap."""
    is_rung = rung_label is not None
    if weight is None:
        w = (rs.UNKNOWN, rs.S_NONE)
    elif override and override.get("weight_kg") is not None:
        w = (weight, rs.S_OVERRIDE)
    elif is_rung:
        w = (weight, rs.S_LADDER)
    else:
        w = (weight, {"override": rs.S_OVERRIDE, "rx": rs.S_RX,
                      "slot": rs.S_SLOT,
                      "last_logged": rs.S_LAST_LOGGED}.get(
                          (basis or {}).get("source"), rs.S_RX))
    try:
        exec_spec = set_table().resolve_unilateral(slot)
        ex = (exec_spec["mode"],
              rs.S_SLOT if exec_spec["declared"] else rs.S_DEFAULT)
    except Exception:  # noqa: BLE001 -- resolver miss: say unknown, never guess
        ex = (rs.UNKNOWN, rs.S_NONE)
    reps = ((target_reps, rs.S_LADDER if is_rung else rs.S_RX)
            if target_reps is not None else (rs.UNKNOWN, rs.S_NONE))
    rir = ((target_rir, rs.S_LADDER if is_rung else rs.S_RX)
           if target_rir is not None else (rs.UNKNOWN, rs.S_NONE))
    return rs.issue(weight=w, exec_mode=ex, reps=reps, rir=rir)


def arm_target_rir(rx, program_path, db_path, session_id, exercise_name,
                   rung_label, override=None):
    """The target RIR for the set being armed, or None.

    A RUNG's RIR is the ax_engine.RAMP_RIR anchor -- the same constant 표2 prints
    and _f6_ramp_sets stamps on the spoken cue. A WORKING set's is rx-calc's
    `target_rir` for today (already RIR-floor clamped by resolve_target_rir),
    overlaid with the F19/F21 override when the owner changed it mid-session.

    Read from the SAME two resolvers derive_next_spec reads, INCLUDING its day
    resolution: calc_rx keyed on the wall date alone answers for whatever day
    the rotation lands on, not for the split this session is actually training,
    so `rotation_day_override=find_day_code(...)` is not optional here any more
    than it is there (the 2026-08-23 makeup-day fix). Without it a 뒷A session
    asks about 앞B and every axis comes back unknown -- measured while wiring
    this in. Best-effort: any miss -> None, which emits `rir=unknown:none`
    rather than a guess."""
    if rung_label is not None:
        try:
            return ax_engine().RAMP_RIR
        except Exception:  # noqa: BLE001
            return None
    if override and override.get("rir") is not None:
        return override["rir"]
    try:
        program = rx.load_yaml(program_path)
        day_code = find_day_code(program, db_path, session_id, exercise_name)
        result = rx.calc_rx(program_path,
                            _session_today(db_path, session_id), db_path,
                            exclude_session_id=session_id,
                            rotation_day_override=day_code)
        for ex in (result.get("exercises") or []):
            if ex.get("name") == exercise_name:
                return ex.get("target_rir")
    except SystemExit:
        pass
    except Exception:  # noqa: BLE001
        pass
    return None


def emit_rx_issued(rx, program_path, db_path, session_id, exercise_name,
                   set_seq, weight, target_reps, target_rir, rung_label,
                   basis=None, override=None):
    """Print the D4 pair for this arm. Best-effort in full: any failure prints
    nothing and the arm proceeds, because an audit line that can break a set is
    worse than no audit line."""
    rs = _rx_source_mod()
    if rs is None:
        return
    try:
        program = rx.load_yaml(program_path)
        slot = find_slot(program, db_path, session_id, exercise_name)
    except Exception:  # noqa: BLE001
        slot = None
    try:
        rec = build_rx_record(rs, slot, weight, target_reps, target_rir,
                              rung_label, basis=basis, override=override)
        display = _slot_display(rx, program_path, db_path, session_id,
                                exercise_name, override)
        for line in rs.emit_lines(rec, exercise_name, display, set_seq):
            print(line)
    except Exception:  # noqa: BLE001
        return


def next_ladder_seq(rx, program_path, db_path, session_id, exercise_name,
                    override=None):
    """The set_seq the owner is ABOUT TO DO for this exercise, walking the WHOLE
    ladder -- warm-up rungs first, then working sets:

        bw (0) -> r1 (-1) -> r2 (-2) -> ... -> working 1 -> working 2 -> ...

    This is the fix for incident 1's entry half: exercise-enter used to arm
    `COUNT(set_seq >= 1) + 1`, which is >= 1 by construction, so ENTERING an
    exercise always armed WORKING SET 1 even when the very next thing the owner
    does is a bodyweight primer.

    Rules, in order:
      * a working set is already logged  -> the ladder is behind us; return
        MAX(working) + 1. (Never walk BACK into a warm-up mid-exercise, and
        never re-offer a primer to a man on set 3.)
      * otherwise the first PLANNED rung with no logged row -> that rung's seq.
      * otherwise (no ramp planned, or the ladder is complete) -> the next
        working seq, COUNT(set_seq >= 1) + 1.
    Best-effort: any failure -> the historical COUNT(>=1)+1."""
    try:
        seqs = logged_seqs(db_path, session_id, exercise_name)
        working = sorted(s for s in seqs if s >= 1)
        if working:
            return working[-1] + 1
        for row in resolve_ramp_ladder(rx, program_path, db_path, session_id,
                                       exercise_name, override):
            if row["set_seq"] not in seqs:
                return row["set_seq"]
        return 1
    except Exception:  # noqa: BLE001 -- never break an entry on this
        return 1


def due_rung(rx, program_path, db_path, session_id, exercise_name,
             override=None):
    """The warm-up RUNG this exercise owes right now, or None when the next
    ladder step is a working set.

    Returns one resolve_ramp_ladder row -- {"set_seq", "label", "weight_kg",
    "reps", "rir", "slot_num"} -- so every number in it is already the SoT's
    (set-table.planned_ramp_rows for the weights, ax_engine.ramp_taper_reps for
    the reps, ax_engine.RAMP_RIR for the RIR). This function decides NOTHING
    about a ramp; it only joins the two existing answers -- WHERE on the ladder
    we are (next_ladder_seq) and WHAT that rung is (resolve_ramp_ladder).

    None is returned for all three "no rung is due" cases, which a caller must
    treat identically (fall through to the working-set prescription):
      * next_ladder_seq says a working set is next -- either the ladder is spent
        or a working set is already logged, so the ladder is behind us;
      * the exercise plans no ramp at all (isolation / bodyweight / a load at or
        below the ramp floor) -- the ladder is empty;
      * anything failed -- best-effort, like every derivation on the arm path.

    Extracted for H15: the TRANSITION next-step spec has to ask this question of
    the INCOMING exercise, and the alternative to reusing the ladder resolvers
    was a second ramp derivation inside derive_next_spec."""
    try:
        seq = next_ladder_seq(rx, program_path, db_path, session_id,
                              exercise_name, override)
        if seq >= 1:
            return None
        for row in resolve_ramp_ladder(rx, program_path, db_path, session_id,
                                       exercise_name, override):
            if row["set_seq"] == seq:
                return row
        return None
    except Exception:  # noqa: BLE001 -- a rung miss never breaks arming
        return None


def main(argv=None):
    # F22/F15: standalone HOLD countdown subcommand. Dispatched before the
    # rest-arming parser so it does not require the session/exercise/set_seq
    # positionals -- a press-start hold is decoupled from set logging.
    args_list = sys.argv[1:] if argv is None else list(argv)
    if args_list and args_list[0] == "countdown":
        return run_hold_countdown(args_list[1:])
    # Unilateral (two-sided) HOLD auto-chain: 좌 타이머 -> 그 완료버튼이 우 타이머를
    # 직접 발사 -> 우 완료가 기록+다음 종목. No mid-step "시작" tap anywhere in it.
    # Dispatched here for the same reason `countdown` is: a hold chain link is
    # decoupled from the rest-arming positionals.
    if args_list and args_list[0] == "hold-chain":
        return run_hold_chain(args_list[1:])
    # BILATERAL timed hold: countdown + its close affordance in ONE code action
    # (the D25/D26 forcing point -- see run_hold_set). hold-chain remains the
    # UNILATERAL (좌/우) carrier; this is its bilateral sibling, and both now go
    # through the same step_affordance decision point.
    if args_list and args_list[0] == "hold-set":
        return run_hold_set(args_list[1:])
    # REPS-FIRST arm (DGN-918): a pre-log entry point that arms the reps->RIR
    # keyboard on working-set ENTRY without a DB write. Dispatched before the
    # rest-arming parser (which requires a completed set's positionals + does the
    # rest-timer side effects); reps-entry only reads program/db to build the arm.
    if args_list and args_list[0] == "reps-entry":
        return run_reps_entry(args_list[1:])
    # Machine confirm ask, delivered by code (2026-10-03, run_machine_ask).
    if args_list and args_list[0] == "machine-ask":
        return run_machine_ask(args_list[1:])

    p = argparse.ArgumentParser(
        prog="set-arm",
        description="Deterministic rest-timer arming (C12).")
    p.add_argument("session_id", type=int)
    p.add_argument("exercise_name")
    p.add_argument("set_seq", type=int)
    p.add_argument("--next", dest="next_spec", default=None,
                   help="next-set spec text for the set-start marker")
    p.add_argument("--tip", default=None, help="30s-marker form tip")
    p.add_argument("--tip60", default=None, help="60s-marker extra line")
    p.add_argument("--no-next", action="store_true",
                   help="session end: suppress the set-start marker entirely")
    p.add_argument("--db", default=DEFAULT_DB)
    p.add_argument("--program", default=DEFAULT_PROGRAM)
    p.add_argument("--today", default=None, help="YYYY-MM-DD (default: today)")
    p.add_argument("--dry-run", action="store_true")
    # F19/F21 target-change re-arm (owner 2026-08-14). Any of these overrides
    # the current exercise's derived target so the re-fired push + set-table
    # reflect the owner's mid-session change. A SUBSTITUTION (F19) passes
    # --ov-display (+ usually --ov-weight/--ov-reps/--ov-rir); a WEIGHT ADJUST
    # (F21) passes --ov-weight alone. Persisted per (session, exercise) so
    # set-table reads the same override. --ov-clear removes a prior override
    # (revert to the program/rx-calc derivation).
    p.add_argument("--ov-display", default=None,
                   help="F19/F21: override display name for the current exercise")
    p.add_argument("--ov-weight", type=float, default=None,
                   help="F19/F21: override target weight kg (F21 weight adjust)")
    p.add_argument("--ov-reps", default=None,
                   help="F19/F21: override target reps (substitution rep scheme)")
    p.add_argument("--ov-rir", default=None,
                   help="F19/F21: override target RIR")
    p.add_argument("--ov-clear", action="store_true",
                   help="F19/F21: clear any persisted override for this exercise")
    p.add_argument("--ov-alt-weight", type=float, default=None,
                   help="design 2: the prescription's FALLBACK weight kg (e.g. "
                        "no 1.25 plate). The next pre-log keyboard offers it "
                        "beside the prescribed weight; the record takes the "
                        "tapped one. Alone it joins the persisted override.")
    # P2 (2026-08-24): a weight override is a PROGRESSION DECISION, and a
    # decision that cannot say why it diverged from the engine does not get
    # served on the harder side. See gate_weight_override().
    p.add_argument("--ov-reason", default=None,
                   help="P2: one line, in the owner's language, for why this "
                        "weight differs from the engine's verdict. REQUIRED to "
                        "move to the harder side -- without it the gate serves "
                        "the engine weight (the lower side) and says so.")
    p.add_argument("--ov-by", choices=list(OV_BY), default=OV_BY_COACH,
                   help="P2: whose call this weight is. 'coach' (default) = "
                        "the agent's own judgement, gated. 'owner' = the owner named "
                        "the number themselves, never clamped.")
    args = p.parse_args(argv)

    rx = load_rx_calc()
    from free_session import effective_path
    prog_abs = effective_path(os.path.abspath(args.program), os.path.abspath(args.db), args.session_id)
    db_abs = os.path.abspath(args.db)
    rest_sec, static_sets, slot, rest_basis = resolve_slot(
        rx, prog_abs, db_abs, args.session_id, args.exercise_name)
    hold_class = is_hold_class(slot, db_abs, rx)

    # RUNG MODE (2026-08-21). A completed warm-up primer / ramp rung (set_seq
    # <= 0) is NOT a rest boundary. F8 used to express this by refusing to run
    # set-arm at all for a rung (set-add gated arming off at `set_seq >= 1`),
    # which also cost the rung its KEYBOARD -- so a ramp rung had no way to be
    # tapped in and the engine's "다음은 60kg 5회 램프 세트예요" prose had no arm
    # behind it. The gate is now HERE instead of at the caller: a rung arms its
    # keyboard and NOTHING ELSE. No channel-1 countdown, no 30s before-markers,
    # no set-start push, no water mark, no arm-generation bump (bumping would
    # fence off a legitimately pending working-set push). The owner's complaint
    # -- a rest timer running after a warm-up -- is structurally impossible in
    # this branch, and the tests assert on exactly that (no [countdown], no
    # [push], REST_ARMED NONE).
    is_rung = args.set_seq <= 0 and not hold_class

    # PREP STILL RUNNING (live 2026-10-08 06:21, session 1). A prep row is
    # `set_seq <= 0`, so it took the rung branch below, and every rung output
    # spoke for the WORKING lift while 8 mat drills were still owed:
    # NEXT_HINT/SET_CUE "bench press x 8", a pre-log arm for the next ladder
    # step, and `ARMED mode=rung rest=165s`. prep_pending is the one verdict
    # those three read: the next owed ENTRY drill (prep_next_tap -- the same
    # plan and seqs exercise-enter printed). A deferred immediate_primer is not
    # owed yet (the ramp comes first), so it does not hold the hand-over.
    prep_pending = None
    try:
        _st_pp = set_table() if is_rung else None
        if _st_pp is not None and args.set_seq <= _st_pp.PREP_SEQ_BASE:
            _tap = prep_next_tap(rx, prog_abs, db_abs, args.session_id,
                                 args.exercise_name)
            if _tap and (_tap[2] or {}).get("phase") != \
                    _st_pp.PREP_DEFERRED_PHASE:
                prep_pending = _tap
    except Exception:  # noqa: BLE001 -- unknown -> the pre-fix rung path
        prep_pending = None

    # F14/RC1-ext: the last-working-set (transition) judgment MUST use TODAY's
    # rx-calc prescribed set count (fatigue-trimmed), the single source that
    # also drives set-table's rendered rows -- NOT the program.yaml static slot
    # count. Reading the static count fired a ghost continuation stack when
    # today's trim shortened the exercise (e.g. static 4, trimmed 3: set_seq=3
    # was mis-read as a mid-exercise rest and armed a phantom 4th-set timer that
    # actually reached the owner's phone -- F14). Prefer rx sets; fall back to
    # the static count only when rx yields nothing.
    rx_sets = resolve_rx_sets(rx, prog_abs, db_abs,
                              args.session_id, args.exercise_name)
    sets = rx_sets if rx_sets is not None else static_sets

    # Transition = completed set is the exercise's last working set. Only a
    # single set-start alert fires (no before-markers). SAFE DEGRADE (F14): if
    # the set count is unknown from BOTH sources, suppress the continuation
    # stack (treat as transition) rather than arm a possibly-ghost next-set
    # rest -- ghost-arm suppression is the safe side (a missing timer beats a
    # phantom one firing on the owner's phone). The set-start alert still fires
    # (guaranteed next-step cue) unless caller/derivation says session end.
    sets_known = sets is not None
    transition = ((not sets_known)
                  or (args.set_seq >= 1 and args.set_seq >= sets))

    # C12-B ARM-TRIGGER BINDING (owner live 2026-08-24). The last-set judgment
    # above answers "is there a NEXT set?"; this answers "did a set actually
    # HAPPEN?". Both are read from DATA here, by this script -- neither may
    # depend on the model passing a flag. See set_write_bound() for the live
    # evidence (session 10091, a full rest stack fired for a set that had no
    # workout_sets row).
    rest_bound, bind_reason = set_write_bound(
        db_abs, args.session_id, args.exercise_name, args.set_seq)

    # hotfix 0.34.x (owner live 2026-10-08): a row at a seq >= the planned count
    # is NOT "the exercise is done" while planned working seats are still empty.
    # A mis-sequenced warm-up stored at set_seq=10 (0 of 4 working sets logged)
    # was read as the last working set: SET_TABLE_COMPLETE, the wrap-up line
    # wrap-up push and the next exercise's entry all fired. Completion now also
    # needs every planned working seat 1..N logged; short of that the arm stays
    # on this exercise (no transition, no completion beat).
    if (transition and sets_known and rest_bound and not hold_class
            and args.set_seq >= 1):
        _logged_working = count_logged_working(
            db_abs, args.session_id, args.exercise_name, sets)
        if _logged_working is not None and _logged_working < sets:
            transition = False
            print("EXERCISE_INCOMPLETE exercise=%s logged=%d planned=%d -- "
                  "planned working sets remain; NOT complete, do NOT advance"
                  % (args.exercise_name, _logged_working, sets))

    now = time.time()
    is_water = water_due(now)
    sched = rest_checkpoints(rest_sec)

    # F19/F21: resolve the owner's target override for this (session, exercise).
    # --ov-* args set/replace it (persisted so set-table reads the same target);
    # --ov-clear removes it. Absent any --ov-* arg on THIS call, a prior
    # persisted override still applies (a re-arm from set-add without --ov-*
    # would otherwise silently drop the owner's earlier change). Only display /
    # weight / reps / rir keys are carried; a missing key stays derived.
    ov_args = {}
    if args.ov_display is not None:
        ov_args["display"] = args.ov_display
    if args.ov_weight is not None:
        ov_args["weight_kg"] = args.ov_weight
    if args.ov_reps is not None:
        ov_args["reps"] = args.ov_reps
    if args.ov_rir is not None:
        ov_args["rir"] = args.ov_rir
    # design 2: a fallback weight belongs to the prescription it rides. With
    # other --ov-* it is part of that new override; alone it is added to the
    # persisted one (never replacing the owner's weight/display with nothing).
    if args.ov_alt_weight is not None:
        if ov_args:
            ov_args["alt_weight_kg"] = args.ov_alt_weight
        else:
            ov_args = dict(read_override(args.session_id, args.exercise_name))
            ov_args["alt_weight_kg"] = args.ov_alt_weight

    # P2: THE PROGRESSION DECISION POINT. A --ov-weight on THIS exercise is the agent
    # changing today's load away from the engine's verdict, so it goes through
    # the gate before it becomes the served number. The gate decides (it never
    # asks), stamps the record, and hands back the sentence.
    #
    # Scope: a WEIGHT ADJUST (F21, --ov-weight without --ov-display). A
    # SUBSTITUTION (F19) swaps in a DIFFERENT exercise, whose load has no
    # comparable engine baseline in this slot -- gating it against the replaced
    # exercise's weight would be comparing two different lifts, so it passes
    # through carrying whatever was stated.
    load_decision = None
    if args.ov_weight is not None:
        if args.ov_display is None:
            eng_kg, eng_verdict, eng_assisted, eng_source = engine_load_baseline(
                rx, prog_abs, db_abs, args.session_id, args.exercise_name)
            load_decision = gate_weight_override(
                eng_kg, float(args.ov_weight), assisted=eng_assisted,
                reason=args.ov_reason, by=args.ov_by,
                engine_verdict=eng_verdict, engine_source=eng_source)
            # The GATED weight is what gets persisted, so a clamp reaches every
            # surface that reads the override (표2 grid, 표3 card, ANCHOR, pin,
            # SET_CUE) without any of them knowing the gate exists.
            ov_args["weight_kg"] = load_decision["served_kg"]
        else:
            load_decision = gate_weight_override(
                None, float(args.ov_weight), reason=args.ov_reason,
                by=args.ov_by, engine_source="substitution")
        # Owner-facing name for the sentence: the substituted display when there
        # is one, else the slot's own display, else the raw slot name (the raw
        # name is the last resort -- SKILL '사용자는 이름을 읽는다' rule).
        _disp = args.ov_display
        if _disp is None:
            try:
                _slot = find_slot(rx.load_yaml(prog_abs), db_abs,
                                  args.session_id, args.exercise_name)
                _disp = (_slot or {}).get("display")
            except Exception:  # noqa: BLE001 -- a display miss never blocks
                _disp = None
        load_decision["display"] = _disp or args.exercise_name
        # Compose the owner-facing sentence ONCE, here, at decision time, and
        # persist it with the number. Every later surface (set-table's table,
        # set-add's relay line) reproduces this exact string instead of deriving
        # its own -- the same one-ledger discipline D1 imposed on the weight, now
        # applied to the explanation that travels with it.
        load_decision["say"] = load_decision_say(
            load_decision, display=load_decision["display"])

        # Persist the whole decision alongside the number. The 2026-08-24
        # artifact was `{"weight_kg": 25.0}` and that emptiness is what left the
        # model with nothing to cite but the engine it had just overridden.
        for key, val in (("say", load_decision.get("say")),
                         ("reason", load_decision.get("reason")),
                         ("reason_source", load_decision.get("reason_source")),
                         ("by", load_decision.get("by")),
                         ("engine_weight_kg", load_decision.get("engine_kg")),
                         ("engine_verdict", load_decision.get("engine_verdict")),
                         ("engine_source", load_decision.get("engine_source")),
                         ("decision", load_decision.get("decision"))):
            if val is not None:
                ov_args[key] = val

    if args.ov_clear:
        # Explicit revert: drop the persisted override (best-effort). Dry-run
        # does not mutate persisted state (parity with the write path below).
        if not args.dry_run:
            try:
                os.remove(_override_path(args.session_id, args.exercise_name))
            except OSError:
                pass
        override = {}
    elif ov_args:
        # New/updated override on this call -> persist so set-table agrees.
        if not args.dry_run:
            write_override(args.session_id, args.exercise_name, ov_args)
        override = ov_args
    else:
        # No --ov-* on this call: honor a previously persisted override.
        override = read_override(args.session_id, args.exercise_name)

    # F21 orphan cancel: bump this session's arm generation ONCE per arm so a
    # re-arm supersedes any still-pending detached set-start push from the prior
    # arm (the pushes self-suppress when their stamped gen no longer matches).
    # Dry-run does not bump (no real pushes to fence) and stamps a stable 0.
    # RUNG: no bump either -- a rung spawns no push of its own, and bumping
    # would SUPPRESS a still-pending set-start push from the previous working
    # set (the fencing token exists to cancel superseded pushes, and a warm-up
    # supersedes nothing).
    if args.dry_run or is_rung:
        gen = 0
        gen_file = None
    else:
        gen = bump_arm_gen(args.session_id)
        gen_file = os.path.join(ARM_GEN_DIR, "%s" % args.session_id) if gen else None

    # F11: derive the next-step spec from DATA (deterministic). Preferred over
    # the model-passed --next (derivation is the forcing point); --next is kept
    # only as a safety fallback when derivation returns nothing. A derivation
    # SESSION-END result (has_next False) behaves like --no-next.
    # F19/F21: pass the override so the CONTINUATION spec re-fires with the new
    # exercise/weight/reps/RIR (transition ignores it -- different exercise).
    # #39-B: `next_meta` collects the RESOLVED target (name + weight) of the set
    # being cued so the plate line below reads real numbers instead of re-parsing
    # the rendered spec string.
    # live batch 2 item 1: in-session step-down on a calibration session.
    # Decided HERE (before the next spec is derived) so the next set's spec,
    # keyboard weight, table and set-start push all read the stepped load.
    # Idempotent: a re-arm of the same seq finds the step already recorded.
    if (rest_bound and not is_rung and not hold_class and args.set_seq >= 1
            and args.ov_weight is None and not args.ov_clear
            and (override or {}).get("step_down_seq") != args.set_seq):
        try:
            _sd = calibration_step_down(rx, prog_abs, db_abs, args.session_id,
                                        args.exercise_name, args.set_seq,
                                        slot, override)
        except Exception:  # noqa: BLE001 -- a step-down miss never breaks arming
            _sd = None
        if _sd is not None:
            _disp = (override or {}).get("display") or \
                (slot or {}).get("display") or args.exercise_name
            _say = step_down_say(_disp, _sd, (slot or {}).get("rep_range"))
            # live batch 3 item 2: a load change names how to set it (the
            # pin / plates / dumbbell), not just the number.
            try:
                if SCRIPT_DIR not in sys.path:
                    sys.path.insert(0, SCRIPT_DIR)
                import live_load as _ll
                _cue = _ll.load_cue(db_abs, args.session_id,
                                    args.exercise_name, slot, _sd["to_kg"])
                if _cue:
                    _say = _ll.t("health.live.stepdown_cue", say=_say,
                                 cue=_cue)
            except Exception:  # noqa: BLE001 -- the cue never costs the line
                pass
            override = dict(override or {})
            # a new load is a new prescription: its fallback goes with it
            override.pop("alt_weight_kg", None)
            override.update({"weight_kg": _sd["to_kg"], "by": OV_BY_COACH,
                             "decision": "step_down", "say": _say,
                             "reason": "calibration_step_down",
                             "step_down_seq": args.set_seq})
            if not args.dry_run:
                write_override(args.session_id, args.exercise_name, override)
            load_decision = {"decision": "step_down",
                             "served_kg": _sd["to_kg"],
                             "engine_kg": _sd["from_kg"],
                             "engine_verdict": "calibration",
                             "by": OV_BY_COACH, "direction": "down",
                             "reason_source": "e1rm_set", "say": _say}

    # live batch 2 item 2: a rung on an ESTIMATED working weight is a probe.
    if (is_rung and args.ov_weight is None and not args.ov_clear
            and (override or {}).get("probe_seq") != args.set_seq):
        try:
            _pd = probe_decision(rx, prog_abs, db_abs, args.session_id,
                                 args.exercise_name, args.set_seq, slot,
                                 override)
        except Exception:  # noqa: BLE001 -- a probe miss never breaks arming
            _pd = None
        if _pd is not None:
            _kind, _kg, _info = _pd
            _disp = (override or {}).get("display") or \
                (slot or {}).get("display") or args.exercise_name
            _say = probe_say(_disp, _kind, _kg, _info)
            override = dict(override or {})
            override["probe_seq"] = args.set_seq
            if _kind == "calibrated":
                override.pop("alt_weight_kg", None)
                override.update({"weight_kg": _kg, "by": OV_BY_COACH,
                                 "decision": "probe_calibrated", "say": _say,
                                 "reason": "calibration_probe"})
            else:
                override["probe_rungs"] = sorted(
                    set(list(override.get("probe_rungs") or []) + [_kg]))
            if not args.dry_run:
                write_override(args.session_id, args.exercise_name, override)
            load_decision = {"decision": "probe_" + _kind, "served_kg": _kg,
                             "engine_kg": None, "engine_verdict": "calibration",
                             "by": OV_BY_COACH, "direction": "probe",
                             "reason_source": "probe_rung", "say": _say}

    next_meta = {}
    has_next, derived_spec = derive_next_spec(
        rx, prog_abs, db_abs,
        args.session_id, args.exercise_name, args.set_seq, transition,
        override=override, meta=next_meta)
    session_end = (has_next is False)          # explicit end (not a failure)
    # F16 PRODUCER (2026-09-11). set-add has parsed `SET_TABLE_COMPLETE\t...`
    # off this stdout since the 0.2.0 extraction -- and NOTHING ever printed
    # it (measured: zero producers in this tree AND in the live tree). The
    # whole F16 "deterministic completion" chain was a dead wire: the consumer,
    # the SKILL rule and the transition sequencer all sat behind a line that
    # could not occur. This is that line, emitted at the ONE place the
    # last-working-set judgment already lives.
    #
    # STRICT on purpose -- three exclusions, each load-bearing:
    #   * sets_known: the `not sets_known` degrade above treats an UNKNOWN
    #     count as a transition to keep a ghost rest from firing. That is a
    #     rest-stack safety, not a completion fact; declaring an exercise
    #     finished off it would fire the wrap-up + next-entry sequence on a
    #     guess.
    #   * hold_class: holds have their own END flow (SKILL F16 carve-out).
    #   * rest_bound: an arm bound to no set write (the row never landed) has
    #     completed nothing.
    if (not args.dry_run and sets_known and rest_bound and not hold_class
            and transition and args.set_seq >= 1 and args.set_seq >= sets):
        print("SET_TABLE_COMPLETE\t%s" % args.exercise_name)
    # F21-ext (owner 2026-08-12): on an exercise TRANSITION (last working set ->
    # next exercise) the "세트 시작 -- <next exercise>" push is redundant -- the
    # exercise handoff is done conversationally, so the push just duplicates chat.
    # Suppress it on transition. EXCEPT hold-class: for an isometric/hold, the
    # transition push IS the "hold done" END alert the owner needs, so keep it.
    # (NEXT_HINT machine line below still prints, so the model can pre-attach the
    # next exercise in chat.) Continuation (same-exercise next set after rest) is
    # unaffected -- its rest-over push stays.
    suppress_next = (args.no_next or session_end
                     or (transition and not hold_class)
                     or is_rung
                     # C12-B: an arm bound to NO set write pushes nothing at
                     # all. The live phantom was not just a silent countdown --
                     # it shipped a full rest-over + set-start push to the
                     # owner's phone for a set that did not exist (QUOTED
                     # EVIDENCE, verbatim: "✅ 60초 휴식 완료 🏋️ 세트 시작 —
                     # 로프 삼두 푸시다운"). Suppressing only the countdown
                     # would leave that push in place.
                     or not rest_bound)

    # THE INTER-SET REST DECISION, in ONE place (C12-B, 2026-08-24). Every term
    # is read from DATA by this script; NONE of them requires model cooperation:
    #   not transition -- there IS a further working set in this exercise
    #                     (set_seq < today's rx-prescribed count; F14).
    #   not is_rung    -- a warm-up/ramp rung is not a rest boundary.
    #   rest_bound     -- a real set WRITE triggered this arm (set_write_bound).
    #   not session_end-- the derivation itself says nothing follows.
    # `args.no_next` is the ONLY model-supplied term and it can only ADD
    # suppression, never be required for it: when the owner ends an exercise EARLY
    # (live 07:20:22, incline_dumbbell_press set 3 of a prescribed 4 -- gen=4
    # armed a full continuation stack the owner never wanted), the prescribed
    # count cannot know it, so the model's "exercise done" signal must be able
    # to kill the WHOLE stack. Before today --no-next silenced only the
    # set-start push while the countdown + before-markers ran regardless, so
    # the flag was a half-measure even when the model did pass it.
    rest_ok = (not transition and not is_rung and rest_bound
               and not session_end and not args.no_next)

    # #35/#36 cue defaults (code SoT, so delivery never depends on the model):
    #   water_line: a natural full sentence, VARIED across sets (#35).
    #   eff_tip: default-on coaching tip for a continuation working-set rest when
    #            the model passed none (#36); the model's --tip always wins.
    water_line = pick_water_line(args.set_seq)
    eff_tip = resolve_default_tip(
        args.tip, transition, hold_class, rest_sec, args.set_seq)

    out = []
    if rest_ok:
        # CHANNEL 1: one live in-place countdown for the full designated rest
        # (silent edits, DGN-594). CHANNEL 2: the milestone before-markers
        # (notifying pushes) below. Both coexist for a continuation rest.
        # Gate = rest_ok (C12-B). It was `not transition and not is_rung`, which
        # let an unbound / model-ended arm through to a live countdown.
        # H16: takes `countdown_sec` from the ONE schedule -- the same dict the
        # markers and the rest-over push below read. It used to take
        # sched["designated"] while the push track read a locally-shortened
        # `eff`, which is exactly how one rest ended up with two durations.
        # done_button=False: this is the REST timer between rep-based working
        # sets. Owner ruling 2026-08-22 -- no timer button here (the two hold
        # call sites above keep theirs). The set advances by being logged.
        emit_countdown(sched["countdown_sec"], args.dry_run, out,
                       done_button=False, blockquote=True)
        for m in sched["markers"]:
            text = build_marker_text(
                m["remaining"], is_water, eff_tip, args.tip60,
                water_line=water_line)
            spawn(m["sleep"], text, args.dry_run, out, gen=gen,
                  gen_file=gen_file, sid=args.session_id,
                  marker="before-%ds" % m["remaining"])

    # #39-B / D6: THE PER-SET PLATE CUE -- ONE line, for the weight of the step
    # being cued, computed HERE (once) because it now has TWO carriers.
    #
    # It used to be computed inside the `not suppress_next` block below, which
    # made it structurally impossible for a warm-up rung to ever produce one: a
    # rung suppresses the set-start push by design (a rung is not a rest
    # boundary), so the cue was skipped, so `write_last_cued_weight` never ran,
    # so the `.plate-cue` ledger sat empty for the whole ladder -- and the first
    # working set, having nothing to diff against, degraded to the ABSOLUTE
    # loading every single time. That is the line the owner rejected on
    # 2026-08-25 ("원판 저거 아니라 그랬지.. 무게 올릴 때 알려주는 기능이라도"):
    # `[원판] 바 20kg + 양쪽 60kg`, pushed moments after they had ramped that bar
    # 20 -> 60 -> 100 by hand. They does not want the stack read back to them; they
    # wants what to ADD. SKILL G10 already said so, and set-table already stamps
    # the per-rung delta -- the ledger was simply never being fed.
    #
    # So: compute once, deliver on whichever message this arm actually sends
    # (the set-start push for a working set, the rung keyboard's own push for a
    # rung), and record the weight only after one of them really carried it.
    # Empty string for machines/stacks/dumbbells, for weight-free sets, at or
    # below the empty bar, and -- the frequent case -- whenever the load did not
    # move, so every non-barbell slot stays byte-identical to before.
    _cue_ex = next_meta.get("name")
    _cue_wt = next_meta.get("weight_kg")
    _cue_prev = read_last_cued_weight(args.session_id, _cue_ex)
    # PLANNED delta vs OBSERVED bar: set-table's plate_delta is measured from
    # the rung below, the ledger records what was last actually cued onto the
    # bar. Normally identical. If the owner SKIPPED a rung they diverge, and the
    # ledger is the one telling the truth about the steel -- so the planner's
    # number is used only when the two agree, and otherwise the cue falls back
    # to diffing the ledger itself. A plan must never be quoted as a
    # measurement.
    _cue_delta = next_meta.get("plate_delta")
    if _cue_delta is not None and next_meta.get("plate_prev_kg") != _cue_prev:
        _cue_delta = None
    plate_line = plate_cue_line(
        db_abs, _cue_ex, _cue_wt, next_meta.get("lattice_type"),
        prev_weight=_cue_prev, delta_kg=_cue_delta,
        loading=next_meta.get("loading"),
        machine_ulid=_session_machine_ulid(db_abs, args.session_id, _cue_ex))
    # Set by whichever carrier actually shipped the line; gates the ledger write
    # at the end of this function. A cue the owner never saw must not advance
    # the ledger -- that would silently swallow the very instruction the next
    # diff assumes they already followed.
    plate_cued = False

    # A1-KEYBOARD: the set-start push, FROZEN here and SPAWNED after the arm
    # block so it can carry the arm for the set it is cueing. None = suppressed.
    pending_set_start = None
    # CONSOLIDATION (2026-09-02): computed ONCE, here, and read by all three
    # consumers -- the push text, the arm block, and the HOLD_NEXT_REQUIRED
    # wire line. One predicate, three readers: an arm with no message, a
    # message with no arm, and a model asked to author a button that code
    # already shipped are the three shapes of this ticket, and they all come
    # from the same value being derived twice.
    hold_next_armable = bool(
        hold_class and not (transition or session_end) and not suppress_next
        and hold_seconds(slot) and dgn918_enabled())
    # ...and the OTHER end of the same exercise -- defect (C). The last hold set
    # is a `transition`, which the arm block excluded, so the exercise boundary
    # stayed a model-discretion fork: a push that said "type 다음(진행)" and a
    # HOLD_NEXT_REQUIRED line asking the model for the button. A code-armed
    # advance button needs a next exercise to NAME (derive_next_spec resolved it
    # for this very push -- next_meta), a push to ride (`not suppress_next`,
    # which for a hold transition is true precisely because the hold-done alert
    # is kept), and the flag on.
    #
    # NOT extended to a non-hold transition: there `suppress_next` is True by
    # the F21-ext rule (the exercise handoff is conversational and the push
    # would duplicate chat), so there is no carrier to attach to. Arming a
    # button with no message is half of this whole ticket, so the predicate
    # stays keyed on the carrier.
    advance_armable = bool(
        hold_class and transition and not session_end and not suppress_next
        and (next_meta or {}).get("name") and dgn918_enabled())
    # ONE boolean for the three readers below (push text, arm block, the
    # HOLD_NEXT_REQUIRED wire line): "did CODE already ship a button for the
    # step this message is about". Derived once so the message and the arm can
    # never disagree.
    code_armed_next = hold_next_armable or advance_armable
    if not suppress_next:
        # Derived spec wins; degrade to model --next, then the generic line.
        spec = derived_spec or args.next_spec or "다음 세트 준비"  # 다음 세트 준비
        end_text = "\U0001f3cb️ 세트 시작 — %s" % spec  # 🏋️ 세트 시작 — spec
        # 41-1 (owner live 2026-08-19): a CONTINUATION rest-END push mirrors the
        # hold confirm style -- lead with the elapsed rest seconds ("✅ Nsec 휴식
        # 완료") so the owner sees how long the rest ran, not a bare next line.
        # #23 (owner live 2026-08-19): a hold/iso CONTINUATION (a between-hold-set
        # rest -- e.g. wall_sit set 1 of 2) is a REAL rest too and MUST carry the
        # same rest-elapsed prefix as a working-set continuation. The prefix is
        # keyed on `not transition` alone (a between-set rest was armed above at
        # `if not transition:`), NOT on set class: hold and working continuation
        # rests are consistent. Only a hold TRANSITION (last hold set) skips it --
        # there the end push is the "hold done / advance" alert, not a rest-over
        # (the hold's own "홀드 완료" confirm rides the idrill callback / chat).
        # C12-B: keyed on rest_ok, the SAME boolean that armed the rest above.
        # `not transition` no longer implies a rest ran, and a rest-over prefix
        # claiming a completed rest when no countdown was armed is exactly the
        # phantom the owner saw at 08:37 (QUOTED EVIDENCE, verbatim:
        # "✅ 60초 휴식 완료") -- the prefix must never outlive its own timer.
        if rest_ok:
            rest_done = CONFIRM_FMT_REST.format(sec=sched["designated"])
            end_text = "%s\n%s" % (rest_done, end_text)
        # #39-B: the per-set plate cue (computed above, once) appended right
        # under the spec so it lands the moment the set starts. CHANGE-ONLY
        # (owner 2026-08-21): absolute on the exercise's first cue, a per-side
        # delta on a change, silent when the load did not move.
        if plate_line:
            end_text = "%s\n%s" % (end_text, plate_line)
            plate_cued = True
        # 41-5 / F19/F33 hold-class chat carrier: a hold END is a plain Telegram
        # PUSH with no inline button (push has no inline-keyboard -- DGN-594 /
        # framework seam, NOT touched here), so after the owner sees a hold-done push
        # they are stranded with no way to advance. Within pure domain scope we
        # append an explicit self-serve action line naming the position-correct
        # next action (다음 세트 / 다음(진행) / 완료) so the owner always has a
        # next step from the push alone (no dependence on the model remembering).
        # The in-session tappable [[OPTIONS]] button is forced separately via the
        # HOLD_NEXT_REQUIRED machine line below (options.py only parses in-session
        # replies, never push text).
        #
        # CONSOLIDATION (2026-09-02, D26): the type-this line is now the
        # FALLBACK, not the primary path. When a real next-hold button can be
        # armed (below, in the arm block) this push carries that button on its
        # own last line, and printing "type '다음 세트'" underneath a button
        # labelled "▶️ 2세트 시작" would be two contradictory instructions in one
        # message. The condition is computed HERE because the push text has to
        # be frozen here, and it is the SAME predicate the arm block keys on --
        # deliberately, so the message and the arm cannot disagree (an arm with
        # no message, or a message with no arm, is this entire ticket).
        if hold_class and not code_armed_next:
            hn_label = hold_next_label(transition, session_end)
            end_text = ("%s\n\U0001f449 다음으로 진행하려면 '%s'라고 "
                        "보내주세요" % (end_text, hn_label))  # 👉 다음: <label>
        # A1-KEYBOARD ORDERING FIX (2026-08-25). This push used to FIRE HERE --
        # before the DGN-918 arm block below had built anything. That is the
        # ordering defect: the rest-complete / set-start push CUES the NEXT set
        # ("🏋️ 세트 시작 — <next spec>") while the only arm that existed at this
        # point in the function was the SAME-seq post-log CORRECTION arm for the
        # set just logged. So the one message the owner reads as "do this set
        # now" could never carry that set's keyboard; the next-set arm was built
        # 100 lines later and, worse, only under a fast-path-only flag (the
        # fast path was removed 2026-10-08). On the model path the cued set had
        # NO arm at all.
        # So the push is DEFERRED, not re-ordered by accident: the text is
        # frozen here (where all its inputs live) and handed to the arm block,
        # which appends the next set's `[[IDRILL:<arm>]]` line and spawns it.
        # The sleep is unchanged, so owner-visible timing is identical.
        pending_set_start = (sched["end_sleep"], end_text)

        # CONSOLIDATION G5 (2026-09-02, D23): REPORT, do not silently fix.
        # When a channel-1 countdown is armed, the bridge finalises that
        # message to "✅ <label> 완료" IN PLACE -- at the scroll position where
        # it was first sent, i.e. ABOVE the 30초-전 and rest-over pushes that
        # were sent later as NEW messages. So the owner reads, top to bottom:
        #   ✅ 휴식 완료  [다음 ▶]   <- the countdown message's final state
        #   ⏱ 30초 전                 <- pushed during the countdown
        #   ✅ 60초 휴식 완료         <- this push's own prefix
        # which is the doubled, order-reversed completion the owner reported.
        # BOTH lines are owner-confirmed on different dates (41-1 2026-08-19 for
        # the prefix here; DGN-915 for the countdown's own done text), so
        # choosing which one to drop is an owner call, not this artifact's.
        # It is made OBSERVABLE instead of being decided unilaterally.
        _g5 = step_affordance.completion_conflict(rest_ok, end_text)
        if _g5:
            print("AFFORDANCE_NOTE\t%s\t%s" % _g5)

    # Only stamp the water cadence when a water line ACTUALLY went out. A rung
    # emits no markers at all, so marking here would silently burn the 15-min
    # slot and swallow the next real reminder.
    # C12-B: the water line rides the before-markers, which now fire iff
    # rest_ok. Keying the stamp on rest_ok keeps this line true to its own
    # contract -- otherwise every newly-refused arm would burn a water slot for
    # a reminder that was never sent.
    if is_water and not args.dry_run and rest_ok:
        mark_water(now)

    # DGN-918 in-place reps/RIR set-entry keyboard (owner 2026-08-17), contract
    # v3.1 (framework HPT0ZAEX, bridge v1.38.1 shape-agnostic). Gated behind the
    # LIVE-SAFETY flag: absent (default) = NOTHING below runs, so today's
    # behavior is byte-identical AND no `[[IDRILL:]]` marker is emitted. Present =
    # write the deterministic arm-id file DECLARING every button/validate/text,
    # then emit the `[[IDRILL:<arm_id>]]` output marker so the bridge renders the
    # initial keyboard. Additive to the existing rest-timer arming; it never
    # touches the pushes above. Best-effort throughout (arm-id write is wrapped)
    # -- a miss here never breaks the logged set.
    # The `[[IDRILL:<arm>]]` marker for the NEXT set's
    # reps->RIR keyboard, or None when this set has no armable next set (hold /
    # exercise transition / session end / no usable reps window / DGN918 flag
    # off). Set inside the block below.
    fp_marker = None
    fp_arm_payload = None
    fp_arm_id = None
    fp_row = False     # True only when fp_marker is the NEXT ROW's reps arm
    if dgn918_enabled():
        arm_id = compute_arm_id(args.session_id, args.exercise_name,
                                args.set_seq)
        # THE SET_SEQ (2026-08-21): this arm is for THIS set, so the resolve has
        # to know which set that is. A rung seq now yields the RUNG's own weight
        # and tapered reps instead of the working prescription -- see
        # resolve_current_arm_data.
        slot_num, weight, target_reps = resolve_current_arm_data(
            rx, prog_abs, db_abs, args.session_id, args.exercise_name, override,
            set_seq=args.set_seq)
        rung_label = rung_label_for_seq(args.set_seq) if not hold_class else None
        # POST-LOG arm: the row at this seq is ALREADY WRITTEN (set-add fired us
        # after its commit), so a differing tap on this keyboard is an in-place
        # CORRECTION and must declare --correct or set-add's collision gate
        # refuses it (IDRILL_ERROR, nothing recorded -- live 2026-08-21). The
        # PRE-LOG arms below/elsewhere must never carry it.
        payload = build_idrill_payload(
            args.session_id, args.exercise_name, args.set_seq, slot_num,
            weight, target_reps, hold_class, rest_basis, sched["designated"],
            correct=True, rung_label=rung_label, db_path=db_abs)

        if rung_label is not None and target_reps is None:
            # Unresolvable rung -> arm NOTHING (never fall back to the working
            # numbers; that fallback is the defect this whole branch fixes).
            out.append("[skip] unresolved rung seq=%s" % args.set_seq)
        else:
            write_callback_file(arm_id, payload, args.dry_run, out)

        if is_rung:
            # WHICH keyboard the owner should see after a RUNG lands is the NEXT
            # LADDER STEP's, not this rung's. A working set gets its next-set
            # affordance from the rest-over push; a rung fires no push at all, so
            # without this the ladder dead-ends after one tap and the owner is
            # back to typing. The same-seq arm above is still WRITTEN (it is the
            # in-place correction arm, and set-add's exact-key weight probe reads
            # it) -- only its marker is replaced, so stdout still carries exactly
            # ONE marker and set-add's "last marker wins" parse is unambiguous.
            _nxt_seq = next_ladder_seq(rx, prog_abs, db_abs, args.session_id,
                                       args.exercise_name, override)
            _nxt_rung = rung_label_for_seq(_nxt_seq)
            _n_slot, _n_wt, _n_reps = resolve_current_arm_data(
                rx, prog_abs, db_abs, args.session_id, args.exercise_name,
                override, set_seq=_nxt_seq)
            # THE PREP GATE (2026-08-27). `is_rung` is `set_seq <= 0`, so a PREP
            # row (set_seq <= -100) lands in this branch too -- and this is the
            # exact call site that RE-FIRED the rung prompt mid-prep: prep drill
            # 1 was logged, next_ladder_seq could not see the prep band, and the
            # first un-logged ramp rung was armed and DELIVERED while the owner
            # was still partway through the prep plan. While the band is short,
            # arm nothing.
            # D10/D16: `_nxt_seq` is already resolved above, so the gate is
            # asked about the step it is actually about to arm rather than
            # about the whole band. This is the call site the owner reaches
            # after each drill/rung lands, and it is where the flat rule kept
            # the ramp shut behind an immediate_primer that is not due yet.
            _lane_open, _lane_why, _lane_planned, _lane_logged = prep_lane_open(
                rx, prog_abs, db_abs, args.session_id, args.exercise_name,
                next_seq=_nxt_seq)
            if not _lane_open:
                out.append("[skip] prep band incomplete (%d/%d) -- ramp/working "
                           "lane closed, nothing armed"
                           % (_lane_logged, _lane_planned))
                print("IDRILL_ARM armed=no reason=%s prep_planned=%d "
                      "prep_logged=%d"
                      % (_lane_why, _lane_planned, _lane_logged))
                # THE DRILL THAT JUST LANDED HAS A SUCCESSOR. This is the call
                # site the owner reaches after tapping drill N complete: the
                # lane is (correctly) still closed, and without this the reply
                # carries no affordance and they have to type "다음". One
                # completion button for drill N+1 -- never a rep keyboard.
                emit_prep_tap(prep_next_tap(
                    rx, prog_abs, db_abs, args.session_id,
                    args.exercise_name), args.session_id, args.exercise_name,
                    args.dry_run, out, db_path=db_abs)
            # THE RAMP GATE (2026-09-11) on the same call site, for the same
            # reason the prep gate is here: `is_rung` is `set_seq <= 0`, so a
            # PREP row lands in this branch too, and the tap that completes the
            # LAST prep drill is exactly where next_ladder_seq answers "1" for a
            # lift whose load nothing resolves. Without this the owner's last
            # mat tap hands them a working keyboard with no warm-up behind it.
            _ramp_open, _ramp_why, _ramp_plan = (True, RAMP_LANE_WORKING, None)
            if _lane_open:
                _ramp_open, _ramp_why, _ramp_plan = ramp_lane_open(
                    rx, prog_abs, db_abs, args.session_id, args.exercise_name,
                    override)
                if _ramp_why == RAMP_LANE_CALIBRATION:
                    # open as calibration: the next rung is the owner's
                    # report, nothing to arm (no keyboard, no rest timer)
                    _ramp_open = False
                    out.append("[skip] calibration ramp -- next rung is "
                               "owner-reported, nothing armed")
                    for _rl in emit_ramp_calibration_lines(
                            args.exercise_name,
                            _slot_display(rx, prog_abs, db_abs,
                                          args.session_id, args.exercise_name,
                                          override),
                            _ramp_plan, session_id=args.session_id,
                            slot_num=_calibration_slot_num(
                                rx, prog_abs, db_abs, args.session_id,
                                args.exercise_name, override),
                            db_path=db_abs):
                        print(_rl)
                elif not _ramp_open:
                    out.append("[skip] no resolvable load -- ramp/working lane "
                               "closed, nothing armed")
                    print("IDRILL_ARM armed=no reason=%s" % _ramp_why)
                    for _rl in emit_ramp_blocked_lines(
                            args.exercise_name,
                            _slot_display(rx, prog_abs, db_abs,
                                          args.session_id, args.exercise_name,
                                          override),
                            _ramp_plan):
                        print(_rl)
                else:
                    # OPEN with no ladder -> say WHY (2026-09-11). Same band as
                    # the gate above it: this branch is only reached while no
                    # working set is logged for this (session, exercise).
                    for _rl in emit_ramp_absent_lines(
                            args.exercise_name,
                            _slot_display(rx, prog_abs, db_abs,
                                          args.session_id, args.exercise_name,
                                          override),
                            _ramp_plan):
                        print(_rl)
            if _lane_open and _ramp_open and _n_reps is not None:
                _nxt_payload = build_idrill_payload(
                    args.session_id, args.exercise_name, _nxt_seq, _n_slot,
                    _n_wt, _n_reps, False, rest_basis, sched["designated"],
                    correct=False,      # PRE-log arm: never --correct
                    rung_label=_nxt_rung, db_path=db_abs,
                    alt_weight=fallback_weight(override, _n_wt))
                _nxt_arm_id = compute_arm_id(args.session_id,
                                             args.exercise_name, _nxt_seq)
                write_callback_file(_nxt_arm_id, _nxt_payload, args.dry_run, out)
                # A1-KEYBOARD: a rung fires NO rest push at all, so this arm has
                # no message to ride -- it gets its own. Without a code-driven
                # delivery the warm-up ladder dead-ends the instant the model
                # stops echoing markers, which is exactly what happened live.
                #
                # D6: and it is THIS message the plate cue has to ride, because
                # this is the only one a rung sends. Walking a ladder IS "무게
                # 올릴 때" -- 20 -> 60 -> 100 -> 140 is four loadings, and the
                # step that matters most (last rung -> first working set, the
                # 100 -> 140 jump) is cued from a rung arm. Sent as a `prefix`,
                # i.e. real body text above the keyboard, so it reads as an
                # instruction rather than a caption.
                #
                # Nothing new fires when nothing changed: plate_line is ""
                # unless this is a bar+plate lift whose load actually moved, so
                # a machine ladder, a bodyweight primer and an unchanged load
                # all send exactly the message they sent before. And the ledger
                # is credited only if delivery was really scheduled --
                # deliver_arm_keyboard returns False for an unrenderable arm and
                # sends nothing at all, in which case the next cue must still be
                # allowed to degrade to the absolute form.
                # ONE ARM ONE KEYBOARD (2026-09-11): this call site was the
                # 06:36/06:37 double -- the marker used to be emitted above
                # unconditionally AND the keyboard pushed here, so the owner
                # got the same buttons twice (code push, then the bridge's
                # render of the model-echoed marker). The marker is now the
                # fallback rail only.
                _kb_status = []
                if deliver_arm_keyboard(_nxt_arm_id, _nxt_payload, args.dry_run,
                                        out, sid=args.session_id,
                                        marker="arm-rung-next",
                                        prefix=plate_line or None,
                                        status=_kb_status, row=True,
                                        db_path=db_abs):
                    print("KEYBOARD_DELIVERED\t%s\tchannel=arm-rung-next"
                          "\tstatus=scheduled" % _nxt_arm_id)
                    if plate_line:
                        plate_cued = True
                elif "refused_duplicate" in _kb_status:
                    print("KEYBOARD_DELIVERED\t%s\tchannel=arm-rung-next"
                          "\tstatus=already_on_screen" % _nxt_arm_id)
                else:
                    emit_idrill_marker(_nxt_arm_id, args.dry_run, out)
                if _nxt_rung is not None:
                    emit_rung_set_cmd(args.session_id, args.exercise_name,
                                      _n_slot, _nxt_seq, _n_wt, _n_reps,
                                      _nxt_rung)
                # PROVENANCE (ruling 3): the rung just armed may stand on the
                # DERIVED basis, and the owner walking a ladder is entitled to
                # know which weight it was cut from. Silent unless derived.
                if _nxt_rung is not None and _ramp_plan is not None:
                    for _bl in emit_ramp_basis_lines(
                            args.exercise_name,
                            _slot_display(rx, prog_abs, db_abs,
                                          args.session_id, args.exercise_name,
                                          override),
                            _ramp_plan.get("basis")):
                        print(_bl)
            print("RUNG_LOGGED\tseq=%s\tnext=%s" % (args.set_seq, _nxt_seq))
        else:
            # Not a rung (working set / hold).
            # Contract v3.1 initial-keyboard sender: emit the `[[IDRILL:<arm_id>]]`
            # output marker (replaces the old file-based emit).
            #
            # CONSOLIDATION G2 (2026-09-02, D26): the payload is now PASSED, so
            # the marker is refused for an arm that cannot work. A HOLD arm is
            # exactly that: build_idrill_payload's hold branch declares
            # step_buttons["1"] == [] and NO cmd, and both bridge render rails
            # hardcode step "1" with no step-2 fallback. The comment this line
            # used to carry -- "or step 2 first when step 1 is empty" -- is
            # STALE; arm_is_renderable() says so in its own docstring. So for
            # every hold set since that comment was written, this call emitted a
            # marker that rendered nothing, and the owner's forward path was the
            # push's "send '다음 세트'" sentence plus the bridge's inert
            # [다음 ▶]. The real hold affordance is armed below.
            #
            # CODE-POSTED KEYBOARDS (2026-10-08): with the code rail live this
            # marker is not emitted at all. It only ever reached the owner if
            # the agent RETYPED it, and the row it belongs to is already
            # logged -- it owes no keyboard. The NEXT row's keyboard is posted
            # by code below (set-start / rung-next / prep-tap).
            if args.dry_run or row_kb() is None:
                emit_idrill_marker(arm_id, args.dry_run, out, payload=payload)

        # NEXT-SET affordance. The arm written just above is the SAME-seq
        # post-log arm (in-place correction); its marker rides set-arm's stdout.
        # What the owner actually needs next is the affordance they would
        # otherwise have to TYPE their way through: a way to tap the NEXT set in.
        # So arm the next seq PRE-LOG (no DB write, same shape as `reps-entry`).
        #   hold_class  -> the next set is a press-start hold, not a reps entry.
        #   transition  -> this was the exercise's LAST working set; the next set
        #                  belongs to another exercise whose own entry
        #                  (exercise-enter) arms its reps-first keyboard.
        #   session_end -> nothing left to arm.
        # The arm-id keyspace is the PLAIN `<seq>` one (no "-fp" variant): this
        # is the same 2-step arm `reps-entry` / the post-log path write for that
        # set, so a later re-arm of the same seq is an idempotent overwrite.
        #
        # A1-KEYBOARD ORDERING FIX (2026-08-25): this block used to sit behind
        # a fast-path-only flag (the text fast path was REMOVED 2026-10-08,
        # owner: every in-session message goes to the model turn). On the
        # MODEL path it never executed, so the rest-complete push cued a set
        # whose keyboard had never been minted, while the only arm in existence
        # was the correction arm for the set just LOGGED. The gate is now:
        # whenever a set-start push is actually going out (`not suppress_next`),
        # because that push is the message this arm is built to ride.
        # `not suppress_next` is deliberately the SAME boolean the push is keyed
        # on: it already excludes --no-next (owner ended early), session end, a
        # non-hold transition, a rung, and an arm bound to no set write. Keying
        # the arm on anything else would let the two disagree again -- an arm
        # with no message, or a message with no arm, which is this whole ticket.
        # ------------------------------------------------------------------
        # THE D26 FIX (P0). A HOLD continuation -- another timed hold set of
        # this exercise remains -- gets a REAL next-set affordance, riding the
        # rest-over push, whose tap arms the next countdown with no model turn.
        #
        # MEASURED BEFORE (wall_sit 45s x 2, live 2026-09-02 07:26:50): the
        # only things this branch produced were
        #   - HOLD_NEXT_REQUIRED  다음 세트     (a machine line asking the MODEL
        #                                        to author an [[OPTIONS]] block)
        #   - "👉 다음으로 진행하려면 '다음 세트'라고 보내주세요"  (type this)
        #   - no CH2_KB line at all on the set-start push (verified in
        #     .ch2-push.log: every rep-based set-start that minute carried
        #     "idrill keyboard sent OK"; the hold one carried none)
        # and the button the owner actually tapped was the bridge's [다음 ▶],
        # which only clears itself. The session stalled and the owner cannot
        # type around a running timer -- the one defect in this batch with no
        # workaround.
        #
        # The decision is asked of step_affordance, not re-derived here, and the
        # payload is gated (G2) before it can ride anything.
        if hold_class and not (transition or session_end) and not suppress_next:
            _hold_sec = hold_seconds(slot)
            _next_seq = args.set_seq + 1
            _hd = step_affordance.decide(
                step_affordance.KIND_HOLD, step_affordance.POS_CONTINUATION,
                timer_armed=False, candidates=1,
                next_set_seq=_next_seq, hold_seconds=_hold_sec or 0)
            print(_hd.as_line())
            if _hold_sec:
                _hn_id = hold_next_arm_id(args.session_id, args.exercise_name,
                                          args.set_seq)
                _hn_payload = build_hold_next_payload(
                    args.session_id, args.exercise_name, _next_seq, _hold_sec,
                    db_abs, prog_abs)
                _live, _why = step_affordance.payload_is_live(_hn_payload)
                if _live:
                    write_callback_file(_hn_id, _hn_payload, args.dry_run, out)
                    fp_marker = idrill_marker_text(_hn_id)
                    fp_arm_payload = _hn_payload
                else:
                    out.append("[hold-next refused] %s %s"
                               % (step_affordance.G2, _why))
                    # The wire must report what HAPPENED, not what was planned.
                    # Leaving this True would print HOLD_NEXT_ARMED ("code
                    # shipped the button; do NOT author one") for a button that
                    # was refused -- stranding the owner with no affordance at
                    # all, which is strictly worse than the defect.
                    code_armed_next = False
            else:
                # No resolvable hold duration -> we cannot arm the next timer
                # honestly. SAY SO on the wire instead of shipping a button
                # that would arm a guessed duration.
                out.append("[hold-next skip] no resolvable hold duration for "
                           "%s -- next-set button NOT armed"
                           % args.exercise_name)
                print("AFFORDANCE_MISSING\thold_next\treason=no_hold_seconds")
                code_armed_next = False

        # ------------------------------------------------------------------
        # DEFECT (C): THE EXERCISE BOUNDARY. The last hold set of an exercise
        # is a `transition`, so the block above (keyed on continuation) never
        # ran and the only forward affordance was a sentence telling the owner
        # to TYPE "다음(진행)" plus a HOLD_NEXT_REQUIRED line asking the model to
        # author a button. That is the same model-discretion fork that made
        # every other defect in this batch; it is closed the same way -- code
        # arms it, riding the same rest/hold-done push, no model turn.
        #
        # The decision is ASKED of step_affordance (position=TRANSITION ->
        # ARM_ADVANCE), not re-derived here, and the payload is gated (G2)
        # before it can ride anything.
        if advance_armable:
            _ad = step_affordance.decide(
                step_affordance.KIND_HOLD, step_affordance.POS_TRANSITION,
                timer_armed=False, candidates=1)
            print(_ad.as_line())
            _adv_payload = build_advance_payload(
                args.session_id, (next_meta or {}).get("name"),
                (next_meta or {}).get("display"),
                hold_next_label(transition, session_end), db_abs, prog_abs)
            _live, _why = (step_affordance.payload_is_live(_adv_payload)
                           if _adv_payload else (False, "no next exercise to "
                                                        "name"))
            if _live:
                _ad_id = advance_arm_id(args.session_id, args.exercise_name,
                                        args.set_seq)
                write_callback_file(_ad_id, _adv_payload, args.dry_run, out)
                fp_marker = idrill_marker_text(_ad_id)
                fp_arm_payload = _adv_payload
            else:
                # SAY SO on the wire. The push text above already committed to
                # NOT printing the type-this fallback (code_armed_next), so a
                # silent failure here would strand the owner -- the exact shape
                # this ticket exists for.
                out.append("[advance refused] %s %s"
                           % (step_affordance.G2, _why))
                print("AFFORDANCE_MISSING\tadvance\treason=%s"
                      % _why.replace(" ", "_"))
                code_armed_next = False

        if (not (hold_class or transition or session_end)
                and prep_pending is None
                and not suppress_next):
            # WHICH set is "next" is a LADDER question, not `+1`: after the bw
            # primer (seq 0) the next step is ramp r1 (seq -1), and only after
            # the last rung does working set 1 come. next_ladder_seq walks that
            # order from the rows already logged; for a working set it returns
            # MAX(working)+1, i.e. the historical seq+1.
            fp_next_seq = (next_ladder_seq(rx, prog_abs, db_abs,
                                           args.session_id, args.exercise_name,
                                           override)
                           if is_rung else args.set_seq + 1)
            fp_rung_label = rung_label_for_seq(fp_next_seq)
            fp_slot_num, fp_weight, fp_target_reps = resolve_current_arm_data(
                rx, prog_abs, db_abs, args.session_id, args.exercise_name,
                override, set_seq=fp_next_seq)
            fp_payload = build_idrill_payload(
                args.session_id, args.exercise_name, fp_next_seq, fp_slot_num,
                fp_weight, fp_target_reps, False, rest_basis,
                sched["designated"],
                correct=False,          # PRE-log arm: never --correct
                rung_label=fp_rung_label, db_path=db_abs,
                alt_weight=fallback_weight(override, fp_weight))
            # No usable reps window -> step_buttons["1"] is empty and the push
            # rail's initial_keyboard_json would render nothing. Push the hint
            # as plain text instead of a dead keyboard (unchanged policy).
            if (fp_payload.get("step_buttons") or {}).get("1"):
                # No "next: <spec>" pre-attach: this arm rides the set-start
                # push, whose body ALREADY opens with the set-start line + <spec>.
                fp_arm_id = compute_arm_id(args.session_id,
                                           args.exercise_name, fp_next_seq)
                write_callback_file(fp_arm_id, fp_payload, args.dry_run, out)
                fp_marker = idrill_marker_text(fp_arm_id)
                fp_arm_payload = fp_payload
                fp_row = True

    # A1-KEYBOARD (2026-08-25): THE DELIVERY. The set-start push -- the message
    # that tells the owner "do this set now" -- goes out HERE, carrying the arm
    # for the set it is cueing on its own last line. push.sh's DGN-966 render
    # hop strips the marker out of the body and sends the arm's declared step-1
    # keyboard as the following message, so the owner taps instead of typing.
    # No model action is involved at any point.
    #
    # The marker is appended LAST and on its OWN line, non-negotiably:
    # bridge/formatting.py's strip matches a full-line-anchored marker and
    # consumes only the FIRST one per body, so it must be alone on its line and
    # there must be exactly one.
    #
    # `fp_marker` None (hold, transition, session end, unusable reps window) ->
    # the push goes out exactly as before, plain text. The keyboard is additive;
    # it can never cost the owner the rest-over message itself.
    if pending_set_start is not None:
        _ss_sleep, _ss_text = pending_set_start
        if fp_marker and arm_is_renderable(fp_arm_payload):
            # CODE-POSTED (2026-10-08): the next row's keyboard is its own
            # code-sent message, landing one second after the set-start text
            # and fenced by the SAME generation, so a re-arm that suppresses
            # the text suppresses the keyboard too. Off the code rail the
            # marker rides the set-start body exactly as before.
            _ss_kb = (post_row_keyboard(fp_arm_id, fp_arm_payload,
                                        args.dry_run, out, db_path=db_abs,
                                        delay=int(_ss_sleep) + 1,
                                        channel="set-start", gen=gen,
                                        gen_file=gen_file)
                      if fp_row else None)
            if _ss_kb in ("scheduled", "already"):
                print("KEYBOARD_DELIVERED\t%s\tchannel=set-start\tstatus=%s"
                      % (fp_arm_id, "scheduled" if _ss_kb == "scheduled"
                         else "already_on_screen"))
            else:
                _ss_text = "%s\n%s" % (_ss_text, fp_marker)
        spawn(_ss_sleep, _ss_text, args.dry_run, out,
              gen=gen, gen_file=gen_file, sid=args.session_id,
              marker="set-start")

    # #39-B / D6: THE LEDGER, written once, after both carriers have had their
    # turn -- and only if one of them actually shipped the line. That condition
    # is the whole contract of this file (`write_last_cued_weight`: "Remember
    # the weight just cued so the NEXT set can diff against it"): recording a
    # cue the owner never received would make the next diff assume they had
    # already moved plates they were never told about, turning a redundant line
    # into a WRONG instruction. The documented degrade runs the other way -- a
    # missing ledger entry costs the next cue its delta form and nothing more.
    # Dry-run never persists (parity with the override write), so suites are
    # repeatable.
    if plate_cued and not args.dry_run:
        write_last_cued_weight(args.session_id, _cue_ex, _cue_wt)

    # F11 Delta 2: surface the derived next-step spec as a machine line on
    # STDOUT so set-add can re-print it and the model can PRE-ATTACH "다음:
    # <spec>" verbatim at arming time (no model composition). NONE at session
    # end. This is a SEPARATE tab-delimited line; it never touches the human
    # summary below. The next-hint value mirrors what the set-start marker
    # shows: derived spec preferred, else model --next, else generic.
    # RUNG: the next step after a warm-up rung is usually ANOTHER RUNG, not the
    # working set, so the hint is taken from the ladder (rung weight + tapered
    # reps + RIR 4+, all from the same SoT 표2 renders). When the ladder is spent
    # the working-set derivation stands.
    rung_hint = None
    if is_rung:
        try:
            _h_seq = next_ladder_seq(rx, prog_abs, db_abs, args.session_id,
                                     args.exercise_name, override)
            for _row in resolve_ramp_ladder(rx, prog_abs, db_abs,
                                            args.session_id,
                                            args.exercise_name, override):
                if _row["set_seq"] == _h_seq:
                    rung_hint = _spec_line_parts(
                        next_meta.get("display") or args.exercise_name,
                        _row["weight_kg"], _row["reps"], _row["rir"],
                        db_abs)
                    break
        except Exception:  # noqa: BLE001 -- a hint miss never breaks arming
            rung_hint = None
    if prep_pending is not None:
        # the next DRILL, never the lift (prep_cues: '<drill> - <dose>')
        try:
            if SCRIPT_DIR not in sys.path:
                sys.path.insert(0, SCRIPT_DIR)
            import prep_cues
            rung_hint = prep_cues.header(
                prep_pending[2], set_table().prep_target_spec(prep_pending[2]))
        except Exception:  # noqa: BLE001 -- a hint miss never breaks arming
            rung_hint = None
    # CODE-POSTED KEYBOARDS (2026-10-08): say which rail carries this install's
    # set keyboards, so set-add stops asking the reply for one.
    if not args.dry_run and dgn918_enabled() and row_kb() is not None:
        print("KEYBOARD_RAIL\tcode")
    hint = None
    if session_end:
        print("NEXT_HINT\tNONE")
    else:
        hint = (rung_hint or derived_spec or args.next_spec
                or GENERIC_NEXT_SPEC)  # 다음 세트 준비
        print("NEXT_HINT\t%s" % hint)

    # live batch 2 item 8 (owner 2026-10-08 07:18-07:19): the next-set line
    # the chat reply carries is CODE-EMITTED, in the owner's format --
    #     line 1: > (marker) next set: <lift>
    #     line 2: > <kg> x <reps> (RIR ..) . rest m:ss   (see next_set_lines)
    # from the same resolved target NEXT_HINT reads (next_meta) and the same
    # designated rest the countdown and REST_ARMED carry. Continuation only
    # (rest_ok): a transition / rung / session end has no next set + rest.
    if rest_ok and not is_rung:
        for _nl in next_set_lines(next_meta, sched["designated"], db_abs):
            print("NEXT_SET_LINE\t%s" % _nl)

    # H11: the CUE (block 2) as a machine line, derived from the SAME `hint`
    # printed above so the two can never drift into two ledgers. Three states,
    # each distinguishable by the consumer -- that separation IS the fix, not a
    # by-product of it: the owner could not tell a failed cue from an absent one
    # because the wire said nothing in either case.
    cue_state, cue_payload = set_cue_line(hint, session_end)
    if cue_state == CUE_STATE_OK:
        print("SET_CUE\t%s" % cue_payload)
    elif cue_state == CUE_STATE_NONE:
        print("SET_CUE\tNONE\t%s" % cue_payload)
    else:
        print("SET_CUE\tMISSING\t%s" % cue_payload)

    # P2: the load decision on the wire, same contract as NEXT_HINT / SET_CUE --
    # a machine line for the ledger and a VERBATIM sentence for the owner. The
    # sentence is authored in load_decision_say(), not here and not by the
    # model, because the failure being fixed was a model-composed explanation
    # that cited the engine and then handed the call back.
    #   LOAD_DECISION       <decision>\t<served>\t<engine>\t<verdict>\t<by>\t<direction>\t<reason_source>
    #   LOAD_DECISION_SAY   NONE | <one Korean sentence to relay verbatim>
    if load_decision is not None:
        print("LOAD_DECISION\t%s\t%s\t%s\t%s\t%s\t%s\t%s"
              % (load_decision.get("decision"),
                 _fmt_load_kg(load_decision.get("served_kg")),
                 _fmt_load_kg(load_decision.get("engine_kg")),
                 load_decision.get("engine_verdict") or "-",
                 load_decision.get("by"),
                 load_decision.get("direction") or "-",
                 load_decision.get("reason_source") or "-"))
        _say = load_decision.get("say")
        print("LOAD_DECISION_SAY\t%s" % (_say if _say else "NONE"))

    # F19/F33 hold-class in-session forcing signal: emit a machine line so
    # set-add re-surfaces it and the model is FORCED to render a tappable
    # completion/next [[OPTIONS]] block IN ITS NEXT IN-SESSION REPLY (options.py
    # renders inline buttons only for in-session replies -- never for the push
    # text above). 41-5 (owner live 2026-08-19): the button LABEL now branches on
    # the completed hold set's position so it reads correctly --
    #   another hold set of this exercise remains -> 다음 세트
    #   exercise/step finished                    -> 다음(진행)
    #   session end                               -> 완료
    # The label is the deterministic value here (hold_next_label); the actual
    # next-step SPEC still rides NEXT_HINT above for the model's chat line. This
    # is the deterministic replacement for the SKILL line-442 OPEN DECISION
    # prompt carrier -- a hold END always presents ONE correct button.
    # 2026-08-22: fire on a plain exercise TRANSITION too, not just hold-class.
    # The original reasoning was "a hold END is a plain push with no inline
    # button, so the owner is otherwise stranded" -- but a plain exercise
    # transition strands them in exactly the same way. The only arm on that turn
    # is a --correct re-arm of the set they just finished, so nothing carries a
    # forward button, and the model is left to author "선택: 1. 다음 운동" by
    # hand: ONE numbered line, which bridge/options.py never promotes to a
    # button (has_numbered_list requires >= 2). That is the defect that stopped
    # a live session today -- and sent us rolling back a framework version that
    # turned out to be innocent.
    #
    # The label branch already resolves this case correctly with no change:
    # transition -> 다음(진행), session end -> 완료.
    #
    # The wire name stays HOLD_NEXT_REQUIRED (and set-add's HOLD_NEXT:) even
    # though it is no longer hold-only -- set-add's parser and session-gate
    # scenario C both key on those exact strings. Renaming buys nothing and
    # breaks two consumers.
    #
    # CONSOLIDATION (2026-09-02, D25/D26): this line is a REQUEST TO THE MODEL
    # to author a button. It is now suppressed exactly when code has already
    # shipped one (`code_armed_next` -- the live comment names the narrower
    # `hold_next_armable` here, but the live CODE keys on the union, and the
    # union is right: an armed ADVANCE button needs this line suppressed for
    # exactly the same reason), because the alternative is what the
    # owner saw on 2026-09-02 -- a code-driven affordance AND a model-authored
    # "선택해 주세요: [1. 완료]" for the same step, in two messages, in
    # whichever order the turn happened to emit them. Two buttons for one
    # decision is not redundancy, it is two live keyboards, which is the shape
    # that wrote a phantom set row (D24).
    # Everywhere code did NOT arm a button -- a plain exercise transition, a
    # hold with no resolvable duration, the DGN918 flag off -- the line is
    # emitted exactly as before, so nothing loses its affordance.
    if (hold_class or transition) and not code_armed_next:
        print("HOLD_NEXT_REQUIRED\t%s"
              % hold_next_label(transition, session_end))
    elif code_armed_next:
        print("HOLD_NEXT_ARMED\t%s\t(code shipped the button; do NOT author "
              "an [[OPTIONS]] block for this step)"
              % hold_next_label(transition, session_end))

    # #23 (owner live 2026-08-19): deterministic between-set REST signal. A
    # continuation set (`not transition`) armed a real between-set rest above
    # (countdown + before-markers + rest-over push). This line makes that
    # arming OBSERVABLE to set-add / the SKILL, and -- for a HOLD/iso set -- is
    # the forcing point that the between-hold-set rest is NOT skipped: the SKILL
    # rule keys on REST_ARMED to require the between-set rest be presented before
    # the NEXT hold set's press-start countdown (a hold set-done is itself a real
    # execution trigger, so the rest is allowed under the #22 intent guard). The
    # rest arms via THIS set-done path (set-add -> set-arm), never depending on
    # the model to remember. A transition (last set) prints REST_ARMED\tNONE.
    # A RUNG prints NONE for the same reason a transition does: nothing was
    # armed. This line is the SKILL's forcing signal to present a rest, so a
    # rung reporting a rest it never armed is exactly how "a rest timer ran
    # after my warm-up" reaches the owner.
    # C12-B: keyed on rest_ok, not on `transition or is_rung`. REST_ARMED is the
    # SKILL's forcing signal to PRESENT a rest -- reporting a rest that was
    # refused would push the model into narrating a countdown that is not
    # running, which is the same class of lie as the phantom push itself.
    if not rest_ok:
        print("REST_ARMED\tNONE")
    else:
        print("REST_ARMED\t%d\thold=%s"
              % (sched["designated"], "1" if hold_class else "0"))

    # C12-B: `unbound:<reason>` and `ended` are DISTINCT from transition/rung so
    # a live refusal is diagnosable from the arm line alone (this bug was
    # invisible for weeks precisely because a refused arm looked like a normal
    # one). Mode order matters: the binding failure is reported ahead of the
    # count-based verdict because it is the stronger statement.
    shown_rest = sched["designated"]
    if prep_pending is not None:
        mode = "prep"           # a drill is next: no rung, no rest
        shown_rest = 0
    elif is_rung:
        mode = "rung"
        # hotfix 0.34.x (owner live 2026-10-08): the rung line used to print the
        # WORKING rest (`ARMED mode=rung rest=165s`) and the turn relayed it as
        # the warm-up rest. A rung arms NO timer (RUNG MODE above); the rest it
        # states is the plate-change pause: RUNG_REST_SEC between rungs,
        # RUNG_REST_LAST_SEC before the first working set.
        try:
            _rr_next = next_ladder_seq(rx, prog_abs, db_abs, args.session_id,
                                       args.exercise_name, override)
        except Exception:  # noqa: BLE001 -- a miss keeps the short default
            _rr_next = None
        shown_rest = (RUNG_REST_LAST_SEC
                      if (_rr_next is not None and _rr_next >= 1)
                      else RUNG_REST_SEC)
        print("RUNG_REST\t%d\tlast=%s\t(warm-up pause for the plate change; "
              "no timer armed -- never quote the working rest for a warm-up)"
              % (shown_rest, "1" if shown_rest == RUNG_REST_LAST_SEC else "0"))
    elif not rest_bound:
        mode = "unbound:%s" % bind_reason
    elif transition:
        mode = "transition"
    elif not rest_ok:
        mode = "ended"          # session_end / model --no-next
    else:
        mode = "continuation"
    n_before = len(sched["markers"]) if rest_ok else 0
    ov_tag = " override=%s" % ",".join(sorted(override)) if override else ""
    # SPEC 5.9 (라이브 "water due니 물 한 모금") -- ROOT CAUSE of that leak.
    # These status lines are read by the MODEL, and the old tokens were English
    # PROSE ("water_due=True", "water=due") that reads as a quotable phrase, so
    # the model spliced "water due" straight into the owner's Korean cue.
    # A boolean status flag must never render as English words: emit 1/0.
    # The water TEXT the owner sees is already fully composed by this script
    # (WATER_LINES / build_marker_text) and pushed on channel 2 -- the model has
    # no reason to compose a water sentence at all, and now no English token to
    # borrow if it tries.
    water_flag = "1" if is_water else "0"
    if mode == "prep":
        # nothing counts down after a drill: the line says the rest that
        # RUNS (0), not the lift's designated rest it never armed
        sched = dict(sched, designated=0, countdown_sec=0, end_sleep=0,
                     push_lead=0)
    if args.dry_run:
        # H16: bar (channel 1) and push (channel 2) are printed side by side so
        # a split ledger is visible from the arm line alone -- the 125/135 skew
        # was invisible for weeks because only one of the two was ever printed.
        print("DRY-RUN mode=%s rest=%ds(bar %ds/push %ds lead=%ds) "
              "before_markers=%d water=%s%s"
              % (mode, shown_rest, sched["countdown_sec"],
                 sched["end_sleep"], sched["push_lead"], n_before,
                 water_flag, ov_tag))
        for line in out:
            print("  " + line)
    else:
        print("ARMED mode=%s rest=%ds before_markers=%d water=%s gen=%d%s"
              % (mode, shown_rest, n_before,
                 water_flag, gen, ov_tag))
    return 0


if __name__ == "__main__":
    sys.exit(main())
