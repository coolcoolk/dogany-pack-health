    # ONE ARM ONE KEYBOARD (2026-09-11): delivery and the model-echo marker
    # used to BOTH fire here, and the owner got the same buttons twice. The
    # marker is now the fallback rail only -- see deliver_or_mark.
    # PLATE-LOADED MACHINE (2026-10-03): the entry keyboard is the message
    # that cues the FIRST rung, so on a plate-loaded machine it carries the
    # first plate line ("one side N kg" / "total N kg"). A barbell's first
    # rung is the empty bar and its first plate line rides arm-rung-next, so
    # the barbell entry push is left exactly as it was: machine path only.
    # 0.36.0 item 5 (live 2026-10-08): the BARBELL entry is cued too -- the
    # owner loaded the first rung uncued. plate_cue_line covers bar + plates
    # (the empty bar included) and hands a plate-loaded machine to
    # plate_machine_cue_line, so one call serves both.
    _entry_cue = ""
    if not hold_class:
        _entry_cue = plate_cue_line(
            db_abs, args.exercise_name, weight,
            (slot or {}).get("lattice_type"),
            prev_weight=read_last_cued_weight(args.session_id,
                                              args.exercise_name),
            loading=(slot or {}).get("loading"),
            machine_ulid=_session_machine_ulid(db_abs, args.session_id,
                                               args.exercise_name))
    _entry_status = []
