def compute_arm_id(session_id, exercise_name, set_seq):
    """DETERMINISTIC 8-char hex arm id = first 8 of sha256(sid|ex|set_seq).
    Deterministic so a re-arm of the SAME set overwrites the SAME arm-id file
    idempotently (matches the F3a set-add in-place correction). set_seq is part
    of the key so concurrent sets of the same session get distinct ids. The key
    is stringified verbatim (no separators inside the fields), '|'-joined."""
    key = "%s|%s|%s" % (session_id, exercise_name, set_seq)
    return hashlib.sha256(key.encode("utf-8")).hexdigest()[:8]


def reps_window(target_reps):
    """DGN-918 reps button window: [R-2, R-1, R, R+1, R+2] where R = target_reps.
    Each value clamped to >= 1, then deduped preserving order (so a low R like 1
    or 2 collapses the clamped duplicates). Returns a list of ints. R unusable
    (None / non-int / < 1) -> [] (caller then has no target -> skips reps and
    arms RIR directly, same as the hold path)."""
    try:
        r = int(target_reps)
    except (TypeError, ValueError):
        return []
    if r < 1:
        return []
    out = []
    for v in (r - 2, r - 1, r, r + 1, r + 2):
        v = max(v, 1)
        if v not in out:
            out.append(v)
    return out


def write_callback_file(arm_id, payload, dry_run, out):
    """DGN-918 arm-id file: one-line JSON at IDRILL_ARM_DIR/<arm_id> carrying
    the fields the bridge needs to write the set on a tap (session_id,
    exercise_name, slot_num, set_seq, weight, target_reps). Written atomically
    (tmp + rename, mirroring emit_countdown) so a concurrent bridge read never
    sees a partial file. A re-arm of the same set REWRITES the same file (the
    arm_id is deterministic), so a target change (F19/F21 substitution / weight
    adjust) refreshes target_reps/weight in place -- no stale file, no stacking.
    BEST-EFFORT: any failure is swallowed (arming must never break a logged
    set); dry-run prints the intent instead of writing."""
    import movement_cues
    movement_cues.attach(payload)
    if dry_run:
        out.append("[callback] %s %s" % (arm_id, json.dumps(
            payload, ensure_ascii=False, sort_keys=True)))
        return
    try:
        os.makedirs(IDRILL_ARM_DIR, exist_ok=True)
        path = os.path.join(IDRILL_ARM_DIR, arm_id)
        tmp = path + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(payload, fh, ensure_ascii=False)
        os.rename(tmp, path)
    except Exception:  # noqa: BLE001 -- never break the logged set
        pass


def emit_idrill_marker(arm_id, dry_run, out, payload=None):
    """DGN-918 contract v3.1 initial-keyboard sender: emit the output marker
    `[[IDRILL:<arm_id>]]` (same output-marker class as `[[OPTIONS]]`). On the
    arming turn the bridge sees this marker on set-arm's STDOUT and renders the
    step-1 inline keyboard from the arm file's step_buttons["1"] + step_text["1"];
    the old file-based control-file sender is gone (v1.38.1 bridge has no reader
    for it).

    Real arming turn -> PRINT the marker to stdout NOW (the bridge parses the
    live turn's output, exactly like `[[OPTIONS]]`). Dry-run -> collect into
    `out` as a `[marker]` intent line (no live send during tests). The marker
    line is stdout-flushed on the real path only.

    LIVE-SAFETY: this is only ever called under the DGN918_FLAG gate. With the
    flag OFF the marker is NEVER emitted, so an inert bridge (flag not yet
    consumed) can never leak raw marker text to the owner.

    CONSOLIDATION G2 (2026-09-02, D26): `payload` is now accepted so the marker
    can be REFUSED for an arm that cannot work. Two failure shapes were live:
    an arm with an empty step-1 keyboard renders NOTHING (both bridge rails
    hardcode step "1"), and an arm with no declared `cmd` makes the bridge edit
    IDRILL_ERROR and clear the keyboard -- the tap that neither starts the next
    timer nor leaves the button on screen. Measured on 2026-09-02: wall_sit set
    1 of 2 got arm 298dc117 with BOTH faults and its marker was emitted anyway.
    payload=None keeps the old unchecked behaviour for the call sites that have
    already gated (none do today) -- so the gate is opt-OUT and loud, not
    opt-in and silent."""
    if payload is not None:
        live, why = step_affordance.payload_is_live(payload)
        if not live:
            msg = ("%s reason=%s arm=%s -- marker NOT emitted (a button that "
                   "renders nothing or fires nothing is worse than no button: "
                   "it consumes the tap and stalls the session)"
                   % (step_affordance.G2, why, arm_id))
            out.append("[marker-refused] " + msg)
            if not dry_run:
                print("AFFORDANCE_REFUSED\t%s" % msg)
                print(msg, file=sys.stderr)
            return False
    if dry_run:
        out.append("[marker] [[IDRILL:%s]]" % arm_id)
        return True
    print("[[IDRILL:%s]]" % arm_id)
    return True


