def _plate_cue_path(session_id, exercise_name):
    """Per-(session, exercise) last-cued-weight marker path. Same sanitization
    as _override_path (mirrors the set-add/set-table PUBLISHED_DIR convention)."""
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", str(exercise_name or ""))
    return os.path.join(PLATE_CUE_DIR, "%s.%s" % (session_id, safe))


def read_last_cued_weight(session_id, exercise_name):
    """The weight of the LAST set this session cued plates for on this exercise,
    or None (never cued / unreadable). Best-effort: any miss -> None, which makes
    the next cue print the absolute loading -- the pre-2026-08-21 behavior, i.e.
    the degrade is a redundant line, never a wrong instruction."""
    try:
        with open(_plate_cue_path(session_id, exercise_name)) as fh:
            return float(fh.read().strip())
    except (OSError, ValueError, TypeError):
        return None


def write_last_cued_weight(session_id, exercise_name, weight_kg):
    """Remember the weight just cued so the NEXT set can diff against it.
    Best-effort; a write failure only costs the next cue its delta form."""
    try:
        os.makedirs(PLATE_CUE_DIR, exist_ok=True)
        with open(_plate_cue_path(session_id, exercise_name), "w") as fh:
            fh.write("%s" % float(weight_kg))
        return True
    except Exception:      # noqa: BLE001 -- never break the set-start push
        return False


def _session_machine_ulid(db_path, session_id, exercise_name):
    """The machine THIS session chose for `exercise_name` (machine_capture),
    or None. Best-effort: no module / no choice -> None, and the plate-machine
    gate then reads the exercise's bound machine instead."""
    try:
        if SCRIPT_DIR not in sys.path:
            sys.path.insert(0, SCRIPT_DIR)
        import machine_capture
        hit = machine_capture.session_machine(db_path, session_id,
                                              exercise_name)
        return hit[0] if hit else None
    except Exception:  # noqa: BLE001
        return None


def plate_machine_cue_line(db_path, exercise_name, weight_kg, loading=None,
                           machine_ulid=None, prev_weight=None):
    """The plate line for a PLATE-LOADED MACHINE, or "" (not one / no copy /
    nothing to say). Same rule as the barbell cue: absolute on the first cue,
    the difference on a change, silence when the load did not move. The
    number is the slot's own unit (per side, or total), so the difference is
    new - old with no halving -- there is no bar term to cancel."""
    try:
        if weight_kg is None or float(weight_kg) <= PLATE_CUE_EPS:
            return ""
        kind = ax_engine().plate_machine_loading(
            db_path, exercise_name, slot_loading=loading,
            machine_ulid=machine_ulid)
        if kind is None:
            return ""
        mod = _ui_labels()
        if mod is None:
            return ""
        if prev_weight is None:
            form, kg = "first", float(weight_kg)
        else:
            delta = float(weight_kg) - float(prev_weight)
            if abs(delta) <= PLATE_CUE_EPS:
                return ""
            form, kg = ("add" if delta > 0 else "drop"), abs(delta)
        return mod.i18n(PLATE_CUE_MACHINE_KEY % (kind, form),
                        kg=ax_engine()._fmt_kg_token(kg))
    except Exception:      # noqa: BLE001 -- never break the set-start push
        return ""


def plate_cue_line(db_path, exercise_name, weight_kg, lattice_type=None,
                   prev_weight=None, delta_kg=None, loading=None,
                   machine_ulid=None):
    """ONE short plate line for the set being cued, or "" when it does not
    apply. Never raises -- a plate-math miss must never cost the set-start push.

    Emits "" (no line at all, never a placeholder) when ANY of:
      * the lift is not bar+plate loaded (machine / stack / cable / bodyweight /
        FIXED DUMBBELL -- see ax_engine.is_plate_loaded for the two signals),
        EXCEPT a plate-loaded machine, which is handed to
        plate_machine_cue_line (`loading` / `machine_ulid`, 2026-10-03)
      * the weight is unknown (weight-free / calibration set)
      * the load is at or below the empty bar (nothing to put on)
      * `prev_weight` equals `weight_kg` -- SAME LOAD AS THE LAST CUED SET, so
        there is nothing to move and the cue would be pure noise (owner, live
        2026-08-21: "워킹세트 4인데 무게 같은데 왜 자꾸 저렇게 알려주냐").

    With a DIFFERENT `prev_weight` the line is the DELTA -- what to add/remove
    per side -- not the absolute loading. `prev_weight` None (the first cued set
    of an exercise) keeps the absolute '바 20kg + 양쪽 Nkg' form. See the block
    comment above for why kg-per-side and not plate counts.

    `delta_kg` (D6, 2026-08-25) supplies that per-side delta as a VALUE instead
    of having it computed here. A RAMP RUNG's delta is already planned by
    set-table._with_plate_deltas -- it is stamped on the very rows 표2 draws --
    and SKILL G10 pins that as the source ("set-arm은 그 값을 읽지, 델타를 다시
    유도하지 않는다"). Supplying it is how a rung cue and a rendered rung stay
    one number rather than two implementations of (a-b)/2 that agree until they
    do not. It is honoured ONLY alongside a real `prev_weight`, and the caller
    is responsible for having checked that the planner measured its delta from
    the same weight the ledger says is on the bar (see plate_prev_kg). Absent
    (the default, and the case for every WORKING set -- a working set is not a
    ladder rung, so no planned delta exists for it) the local arithmetic stands
    exactly as before."""
    try:
        if weight_kg is None:
            return ""
        ax = ax_engine()
        if not ax.is_plate_loaded(db_path, exercise_name, lattice_type):
            # Not bar + plates. A plate-loaded MACHINE still gets its cue
            # (2026-10-03); everything else stays silent, as before. The
            # planner's delta_kg is a bar (per-side-of-a-bar) number and is
            # never quoted here.
            return plate_machine_cue_line(
                db_path, exercise_name, weight_kg, loading=loading,
                machine_ulid=machine_ulid, prev_weight=prev_weight)
        note = ax.plate_breakdown(weight_kg)
        if prev_weight is None:
            # 0.36.0 item 5: EVERY rung is cued, the empty bar included --
            # the first cue is absolute ("bar 20kg, no plates" / "bar 20kg +
            # N kg per side"), every later one the per-side delta.
            if not note:
                if float(weight_kg) <= 0:
                    return ""
                note = _copy("health.plate.empty_bar",
                             bar=ax._fmt_kg_token(getattr(
                                 ax, "EMPTY_BAR_KG", 20)))
                return (PLATE_CUE_FMT % note) if note else ""
            return PLATE_CUE_FMT % note
        if delta_kg is None:
            delta = (float(weight_kg) - float(prev_weight)) / 2.0
        else:
            delta = float(delta_kg)
        if abs(delta) <= PLATE_CUE_EPS:
            return ""       # unchanged load -> nothing to do -> say nothing
        fmt = PLATE_CUE_ADD_FMT if delta > 0 else PLATE_CUE_DROP_FMT
        return fmt % ax._fmt_kg_token(abs(delta))
    except Exception:      # noqa: BLE001 -- never break the set-start push
        return ""


def find_day_code(program, db_path, session_id, exercise_name):
    """The program.yaml day key this session is TRAINING, or None.

    Extracted (2026-08-23) from find_slot, which had the resolution inlined --
    as did derive_next_spec and resolve_current_arm_data, three byte-identical
    copies. All three now need the ANSWER (not just the slot) so they can tell
    rx-calc which day to prescribe for, hence one function.

    THE ANSWER IS SET-TABLE'S, NOT A SECOND OPINION (2026-08-23, corrected the
    same day it was introduced). This function is DELEGATION ONLY: it calls
    set_table().find_day_and_slot and returns the day it resolved. There is
    exactly one day-resolver in the pack and it lives in set-table, because
    set-table's answer is the one the owner SEES -- the 표2 WT column -- and the
    button must write what the table showed.

    What this replaces, and why a second copy was a defect: the first cut of
    this function had TWO tiers (session_type.code, then a file-order scan) and
    a docstring claiming parity with set-table's fallback. set-table has THREE.
    Its middle tier (E23) advances the rotation queue off the last tagged
    non-makeup session and CONFIRMS the exercise is in that day, which is the
    only tier that separates a duplicate exercise name -- single_leg_extension
    and cable_fly each live in BOTH 앞A slot4/5 and 앞B slot4/5. A makeup
    session's code is 보충 and never a program day, so tier 1 always misses and
    every makeup (and every untagged) session resolved its day by file-order
    scan here while set-table used E23. Measured: queue 앞B, set-table 앞B,
    set-arm 앞A -- the table rendering one day's prescription while the armed
    button wrote another day's. That is the exact bug class the makeup fix was
    written to close, re-opened one file over; the fix is not a third copy of
    the tiers but no copy at all.

    Best-effort, like everything on the arm path: any failure (set-table
    unimportable, rx-calc unavailable, an unresolvable session) -> None, and the
    caller degrades to the rotation queue's answer exactly as before."""
    try:
        return set_table().find_day_and_slot(
            program, db_path, session_id, exercise_name,
            rx=rx_calc())[0]
    except Exception:  # noqa: BLE001 -- day resolution never breaks a set
        return None


def find_slot(program, db_path, session_id, exercise_name):
    """Resolve the program.yaml slot dict for exercise_name in THIS session's
    actual day. The day comes from find_day_code, i.e. from set-table's
    find_day_and_slot -- NOT re-derived from rx-calc's rotation-day guess.
    Fixes a live bug (2026-08-04): once ANY set from today's session is logged,
    rx-calc's rotation_day silently rolls forward to the NEXT day (it always
    reads the most-recent-logged session as "last"), so a fresh rx-calc
    subprocess call mid-session stops finding today's own exercises and every
    rest falls back to FALLBACK_REST_SEC -- arming the wrong (too-short) timer
    without any error.

    Untagged and makeup sessions are handled by set-table's own tiers (E23 +
    the file-order last resort); this file does not restate them, because a
    restatement is how the two sides came to disagree in the first place."""
    days = program.get("days") or {}
    day_code = find_day_code(program, db_path, session_id, exercise_name)
    if day_code is None:
        return None

    for ex in (days.get(day_code) or {}).get("exercises") or []:
        if ex.get("name") == exercise_name:
            return ex
    return None


def is_hold_class(slot, db_path=None, rx=None):
    """True for a TRUE isometric hold-class slot (plank / wall_sit class),
    workout-session SKILL.md E14. DELEGATES to rx-calc._is_isometric_hold (A1,
    2026-09-30): the class is read from structure -- the slot's rep_unit /
    isometric marker, else the taxonomy (ax_exercise.measure = hold_sec, hold
    movement), else the legacy card shape -- never from a resolved weight, so
    a hold that once got a logged load stays a hold. A weighted
    'weight-hold / no-progression' slot (back_squat with a seed weight) is
    still NOT a hold. None slot -> False; no rx-calc -> the legacy shape."""
    if not slot:
        return False
    try:
        return bool((rx or load_rx_calc())._is_isometric_hold(slot, db_path))
    except Exception:  # noqa: BLE001 -- sandboxed tree without rx-calc
        return (slot.get("progression") == "hold"
                and slot.get("weight_kg") is None)


def hold_next_label(transition, session_end):
    """41-5 hold-completion branch: resolve the next-action BUTTON label from the
    completed hold set's position (the SAME signals set-arm/exercise-enter already
    emit -- no new schema, no new state).
      session_end             -> 완료 (last thing in the session)
      transition (last set)   -> 다음(진행) (this exercise/step done, advance)
      else (mid-exercise)     -> 다음 세트 (another hold set of this exercise)
    """
    if session_end:
        return HOLD_NEXT_LABEL_END
    if transition:
        return HOLD_NEXT_LABEL_ADVANCE
    return HOLD_NEXT_LABEL_SET


def set_cue_line(spec, session_end):
    """H11: produce block 2 (큐) of the fixed 표->큐->타이머 order, in CODE.

    `spec` is the already-resolved next-step prescription string -- the same
    value NEXT_HINT carries (ramp rung > derived continuation/transition spec >
    the model's --next). It is reused rather than recomposed on purpose: a cue
    that disagreed with the hint would be the "장부 두 개" pathology one seam
    over, and the whole point of this function is that block 2 stops being a
    second, hand-written account of the same numbers.

    Returns (state, payload). Payload is NEVER empty for any state -- an empty
    string is precisely the failure this exists to abolish:
      CUE_STATE_OK      -> payload is the cue text the owner reads
      CUE_STATE_NONE    -> payload is the REASON no cue belongs here (session
                           end). The caller renders NOTHING: the owner's own
                           reading is that an empty block-2 slot should drop
                           out of the order, not sit there blank.
      CUE_STATE_MISSING -> payload is the REASON production failed. The caller
                           says so out loud. A cue we could not build is a
                           defect the owner must be able to SEE and report,
                           not a gap they have to interpret.
    """
    if session_end:
        return CUE_STATE_NONE, "session_end"
    if spec is None or not str(spec).strip():
        return CUE_STATE_MISSING, "no_spec_derived"
    text = str(spec).strip()
    if text == GENERIC_NEXT_SPEC:
        # The generic placeholder means BOTH derivation and the model's --next
        # came back empty. Rendering it as block 2 would be the empty cue
        # wearing a hat -- the owner learns nothing they did not already know.
        return CUE_STATE_MISSING, "generic_placeholder_only"
    return CUE_STATE_OK, text


def hold_seconds(slot):
    """Designated hold duration in seconds for a hold-class slot: the TOP of the
    rep_range (which encodes seconds for these slots, per E14 -- e.g. [20, 45]
    -> 45). Used only to TIME the chat next-button message so it lands right
    after the hold END. Degrades to None (caller falls back) on any miss."""
    rr = slot.get("rep_range") if slot else None
    try:
        if isinstance(rr, (list, tuple)) and rr:
            return int(rr[-1])
    except (TypeError, ValueError):
        pass
    return None


def resolve_slot(rx, program_path, db_path, session_id, exercise_name):
    """Return (rest_sec, sets, slot, basis) for exercise_name in this session's
    actual day. slot is the resolved program.yaml slot dict (or None) so the
    caller can read hold-class attributes (F19/F33). basis is the rx-calc
    resolve_rest_sec descriptive tag (e.g. 'factored:compound+heavy+highfatigue=195'
    or 'slot_override') so the caller can render the §5.11 rest-grounds fold
    without re-resolving. Graceful degrade -> (FALLBACK_REST_SEC, None, None, None)
    on any failure / no match (mirrors the old subprocess-call degrade path).

    F14/RC1-ext: `sets` here is the program.yaml STATIC slot count (last
    session's structure), which is the WRONG basis for the last-working-set
    (transition) judgment when today's rx-calc trims sets for muscle fatigue --
    e.g. program.yaml sets=4 but today's fatigue_trim gives 3. resolve_rx_sets()
    below supplies today's TRIMMED count; the caller prefers it and uses this
    static value only as a fallback."""
    try:
        program = rx.load_yaml(program_path)
        slot = find_slot(program, db_path, session_id, exercise_name)
        if slot is None:
            return FALLBACK_REST_SEC, None, None, None
        cost_map = rx.get_fatigue_cost_map(db_path)
        pattern_map = rx.get_pattern_map(db_path)
        rest_sec, basis = rx.resolve_rest_sec(
            slot, program, cost_map, pattern_map)
        return int(rest_sec), slot.get("sets"), slot, basis
    except Exception:
        return FALLBACK_REST_SEC, None, None, None


def resolve_rx_sets(rx, program_path, db_path, session_id, exercise_name):
    """F14/RC1-ext: TODAY's prescribed working-set count for this exercise --
    the SINGLE source for the last-working-set (transition) judgment, the same
    rx-calc prescription set-table renders. calc_rx's exercises[].sets already
    carries the fatigue-trimmed value (DGN-316 6.3: trimmed count written back
    onto 'sets', pre-trim kept in 'sets_untrimmed'), so reading it here makes
    arming agree with the displayed table -- ending a 3-set (trimmed) exercise
    at set_seq=3 is a TRANSITION, not a continuation into a ghost 4th set (F14
    live mis-arm).

    exclude_session_id = this open session so rx never reads its own partial
    sets as prior evidence (same M-5 discipline set-table uses). Returns an int
    or None; None on any miss so the caller degrades to the program.yaml static
    count (and, absent even that, treats unknown-sets as CONTINUATION -- see
    main: ghost-arm SUPPRESSION is the safe degrade, never a phantom extra set).

    2026-08-23 (보충): unlike its two siblings this function never had a
    day_code in scope -- it takes program_PATH, not the parsed program -- so it
    asked rx-calc for the rotation queue's next regular day and, in a makeup
    session, matched no exercise at all: silent None, and the transition
    judgment fell back to the program.yaml static count. It now parses the
    program (rx.load_yaml, the same load calc_rx is about to do anyway) purely
    to run find_day_code, then prescribes FOR that day. Best-effort: a day
    resolution miss just leaves the override None and the old behaviour stands.
    """
    try:
        today = _session_today(db_path, session_id)
        day_code = None
        try:
            day_code = find_day_code(rx.load_yaml(program_path), db_path,
                                     session_id, exercise_name)
        except Exception:  # noqa: BLE001 -- degrade to the queue answer
            day_code = None
        result = rx.calc_rx(program_path, today, db_path,
                            exclude_session_id=session_id,
                            rotation_day_override=day_code)
        for ex in (result.get("exercises") or []):
            if ex.get("name") == exercise_name:
                s = ex.get("sets")
                return int(s) if s is not None else None
    except SystemExit:
        return None
    except Exception:
        return None
    return None


# --- F11 now-portion: derive the next-step spec from DATA, not the model. ----
# The set-END marker's `<next spec>` was composed by the model (or fell back to
# a generic line). F11 replaces that prompt-judgment with a deterministic
# derivation from program.yaml + rx-calc (the same single-source prescription
# set-table renders), so the "다음 세트/종목" hint is data+rule+code. Reuses
# find_slot's day resolution, rx-calc's calc_rx prescription (weight/RIR, RC1),
# rep_range for reps, and the slot 'display' field for the name (consistent
# with set-table's slot.display naming). Any failure degrades to None so the
# caller falls back to the model --next (or the generic line) -- arming must
# never break the logged set.


def _session_today(db_path, session_id):
    """Session's own date (YYYY-MM-DD) drives calc_rx's 'today' so the
    prescription matches this session, not the wall clock. Replicates
    set-table.session_today. Falls back to the system date."""
    try:
        conn = _db_connect(db_path)
        try:
            row = conn.execute(
                "SELECT date FROM workouts WHERE id = ?", (session_id,)
            ).fetchone()
            if row and row[0]:
                return str(row[0])
        finally:
            conn.close()
    except sqlite3.OperationalError:
        pass
    import datetime
    return datetime.date.today().isoformat()


def _fmt_rir(rir):
    """Render a target RIR value, mirroring set-table._fmt_rir. rx-calc emits
    [lo, hi] (a range), a bare int, or None. None/empty -> '' (blank)."""
    if rir is None:
        return ""
    if isinstance(rir, (list, tuple)):
        if not rir:
            return ""
        if len(rir) >= 2 and rir[0] != rir[1]:
            return "%s-%s" % (rir[0], rir[1])
        return str(rir[0])
    return str(rir)


def _rir_ko(rir_str, db_path=None):
    """OWNER-FACING rendering of an already-formatted rir string.

    Takes _fmt_rir's output ('2' / '1-2' / '4+' / '') and puts the resolved
    NAME in front of it -> 'RIR 2' / 'RIR 1-2' / 'RIR 4+' / ''. Display only:
    the value itself, the `rir` field name, the DB column and `--rir` are all
    untouched.

    2026-08-24: this function used to hold its own copy of the label and its own
    Korean counter grammar. It is now a two-line delegation to ui_labels, which
    is the entire point of the revert -- the spec line, the set table and the
    confirm string cannot disagree about a name none of them stores.
    Empty in -> empty out, so a spec with no target rir stays rir-less."""
    mod = _ui_labels()
    if mod and not mod.gate("spec_line.rir", db_path)["visible"]:
        return ""
    return _rir_fmt(rir_str, db_path)


def _fmt_weight(weight_kg):
    """Verbatim weight, mirroring rx-card._weight_label. None (calibration /
    NULL) -> None so the spec renders weight-free (no invented placeholder).
    Decimals kept verbatim (21.25 stays 21.25; 115.0 -> 115)."""
    if weight_kg is None:
        return None
    if isinstance(weight_kg, float) and weight_kg.is_integer():
        return "%dkg" % int(weight_kg)
    return "%skg" % weight_kg


def _fmt_reps(rep_range):
    """Top of the slot rep_range as the target reps, mirroring set-table's
    planned-row rule (rep_range top). '' when absent."""
    rr = rep_range or []
    if isinstance(rr, (list, tuple)) and len(rr) >= 2:
        return str(rr[1])
    if isinstance(rr, (list, tuple)) and len(rr) == 1:
        return str(rr[0])
    return ""


def _spec_line(display, weight_kg, rep_range, target_rir, db_path=None):
    """One short owner-facing spec line, matching the set table's own columns:
    `<display> <weight>kg × <reps> (RIR <n>)`. Weight-free when calibration
    (weight None); the RIR clause is omitted when there is no target rir.
    Returns None if there is nothing useful to say (no display).

    This string is the NEXT_HINT spec the model echoes VERBATIM (SKILL F11),
    and it is the spec the set-start push opens with. All of them now take their name from ui_labels, so the screen
    can only ever carry ONE name for this quantity. Two of them carrying two
    is not hypothetical: it is what the owner was looking at today.
    The verbatim-echo contract is unaffected -- the model copies whatever this
    prints, it never composes the spec itself."""
    if not display:
        return None
    wt = _fmt_weight(weight_kg)
    reps = _fmt_reps(rep_range)
    core = display
    if wt and reps:
        core = "%s %s × %s" % (display, wt, reps)  # display WT × REPS
    elif wt:
        core = "%s %s" % (display, wt)
    elif reps:
        core = "%s × %s" % (display, reps)         # display × REPS
    rir = _rir_ko(_fmt_rir(target_rir), db_path)
    if rir:
        return "%s (%s)" % (core, rir)
    return core


def _spec_line_parts(display, weight_kg, reps, target_rir, db_path=None):
    """Same owner-facing spec line as _spec_line, but takes an ALREADY-RESOLVED
    reps value (string or int) instead of a rep_range list -- used after an
    override overlay, where reps is a concrete value (F19/F21). Empty reps ('')
    renders weight-only; weight None renders weight-free."""
    if not display:
        return None
    wt = _fmt_weight(weight_kg)
    reps = "" if reps is None else str(reps)
    core = display
    if wt and reps:
        core = "%s %s × %s" % (display, wt, reps)
    elif wt:
        core = "%s %s" % (display, wt)
    elif reps:
        core = "%s × %s" % (display, reps)
    # Same clause as _spec_line, from the same resolver -- these two MUST stay
    # identical in shape or the override path (F19/F21) would render a different
    # spec than the normal path for the very same set. Routing both through
    # _rir_ko is what makes that structural instead of a promise.
    rir = _rir_ko(_fmt_rir(target_rir), db_path)
    if rir:
        return "%s (%s)" % (core, rir)
    return core


# live batch 2 item 1 (owner 2026-10-08, bench first record: 70kg x5 @RIR2
# against a 7-8 @RIR1-2 target; the agent kept 70kg for the next set).
# On a CALIBRATION session -- no prior working set of this lift, so today's
# weight is an estimate or an owner guess -- a working set that falls short of
# the rep floor by >= STEP_DOWN_REP_SHORTFALL (or short AND under the RIR band)
# steps the NEXT set's load down IN-SESSION: the set's e1RM (Epley with RIR,
# e1rm_rx.set_e1rm) back-solved to the target reps + mid-band RIR, snapped DOWN
# onto the slot's lattice. A lift WITH history is the engine's call (rx-calc),
# never re-decided mid-session from one set.
STEP_DOWN_REP_SHORTFALL = 2


def _snap_down(rx, value, lattice):
    """Highest load on the lattice <= value (never rounds a step-down UP)."""
    try:
        pts = rx._lattice_points(lattice)
        if pts:
            lower = [p for p in pts if p <= value + 1e-9]
            return max(lower) if lower else None
        grid = rx._lattice_step(lattice)
    except Exception:  # noqa: BLE001
        pts, grid = None, None
    if grid is None:
        base, step = 0.0, 2.5
    else:
        base, step = grid
    if value < base - 1e-9:
        return None
    import math
    return round(base + math.floor((value - base) / step + 1e-9) * step, 4)


def _rir_band(rir):
    """(lo, hi) of a target RIR (int / [lo, hi] / '1-2' / '1~2'), or None.
    '~' is the owner-screen range form (2026-10-10 18:49)."""
    if rir is None:
        return None
    if isinstance(rir, (list, tuple)) and rir:
        try:
            return float(rir[0]), float(rir[-1])
        except (TypeError, ValueError):
            return None
    m = re.match(r"^\s*(\d+(?:\.\d+)?)(?:\s*[-~]\s*(\d+(?:\.\d+)?))?",
                 str(rir))
    if not m:
        return None
    lo = float(m.group(1))
    return lo, float(m.group(2) or lo)


def calibration_step_down(rx, program_path, db_path, session_id,
                          exercise_name, set_seq, slot, override):
    """The item-1 decision for the working set just logged, or None.

    Returns {"from_kg", "to_kg", "reps", "rir", "target_reps", "band"} when the
    next set's load must step down, else None. Pure read; the caller persists.
    """
    if set_seq < 1 or not slot:
        return None
    prior, _d = _last_logged_working_load(db_path, exercise_name,
                                          exclude_session_id=session_id)
    if prior is not None:
        return None                       # history exists: engine's call
    try:
        conn = _db_connect(db_path)
        try:
            row = conn.execute(
                "SELECT weight_kg, reps, rir FROM workout_sets WHERE "
                "session_id=? AND exercise_name=? AND set_seq=?",
                (session_id, exercise_name, set_seq)).fetchone()
        finally:
            conn.close()
    except Exception:  # noqa: BLE001
        return None
    if not row or row[0] is None or row[1] is None:
        return None
    w, reps, rir = float(row[0]), int(row[1]), row[2]
    rr = slot.get("rep_range") or []
    if not isinstance(rr, (list, tuple)) or not rr:
        return None
    floor_reps, top_reps = int(rr[0]), int(rr[-1])
    if reps >= floor_reps:
        return None                       # in range: nothing to step
    band = _rir_band(arm_target_rir(rx, program_path, db_path, session_id,
                                    exercise_name, None, override))
    if band is None:
        band = (1.0, 2.0)
    rir_v = float(rir) if rir is not None else band[1]
    short = floor_reps - reps
    if not (short >= STEP_DOWN_REP_SHORTFALL
            or (short > 0 and rir_v < band[0])):
        return None
    import e1rm_rx
    e1rm, _basis = e1rm_rx.set_e1rm(w, reps, rir_v)
    target_reps = top_reps
    raw = e1rm_rx.backsolve_load(e1rm, target_reps, (band[0] + band[1]) / 2.0)
    try:
        lattice, _src = rx.resolve_lattice(slot, db_path, session_id)
    except Exception:  # noqa: BLE001
        lattice = slot.get("lattice")
    to_kg = _snap_down(rx, raw, lattice)
    if to_kg is None or to_kg >= w - 1e-9:
        return None
    return {"from_kg": w, "to_kg": to_kg, "reps": reps, "rir": rir,
            "target_reps": target_reps, "band": band,
            "e1rm": round(e1rm, 1)}


def _copy(key, **kw):
    """Owner copy from the i18n bundle (code stays ASCII; ui_labels.i18n)."""
    try:
        if SCRIPT_DIR not in sys.path:
            sys.path.insert(0, SCRIPT_DIR)
        import ui_labels
        return ui_labels.i18n(key, **kw)
    except Exception:  # noqa: BLE001 -- a missing bundle never breaks a set
        return ""


