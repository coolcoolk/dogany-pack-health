def rung_set_argv(session_id, exercise_name, slot_num, set_seq, weight, reps):
    """hotfix 0.34.x: the LITERAL set-add argv that records one setup/ramp row
    as prescribed -- the rung twin of set-table.prep_set_argv. Live 2026-10-08
    the turn composed `set-add <sid> bench_press 0 10 --weight 20 --set-kind
    ramp` by hand (slot and seq swapped) and the warm-up landed as working set
    10. A command the tool prints is a command nobody has to assemble."""
    def _num(v):
        return ("%g" % float(v)) if v is not None else None
    cmd = ["set-add", str(session_id), exercise_name,
           str(slot_num) if slot_num else "session", str(int(set_seq)),
           str(int(reps)) if reps is not None else "done"]
    if weight is not None:
        cmd += ["--weight", _num(weight)]
    cmd += ["--set-kind", "ramp"]
    return cmd


def emit_rung_set_cmd(session_id, exercise_name, slot_num, set_seq, weight,
                      reps, label):
