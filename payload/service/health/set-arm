        return None
    if s > 0:
        return None
    return "bw" if s == 0 else "r%d" % (-s)


def seq_for_rung_label(label):
    """The inverse of rung_label_for_seq: 'bw' -> 0, 'rN' -> -N, else None."""
    lab = str(label or "").strip().lower()
    if lab == "bw":
        return 0
    m = re.match(r"^r([0-9]+)$", lab)
    return -int(m.group(1)) if m else None


def rung_prompt_label(label, weight, is_bar=False):
    """Owner-facing name of the rung the keyboard is about to log -- '세팅 빈
    봉 20kg' / '세팅 50kg' / '웜업 40kg' / '웜업 (맨몸)'. Never invents a number:
    a rung with no resolved weight says so instead of printing a placeholder.

    `is_bar` is the ONLY thing that decides which 세팅 form is spoken, and it is
    supplied by the caller from the shared ax_engine.is_plate_loaded gate --
    never inferred here from the weight, because a stack rung can legitimately
    be 20.0kg with no bar in their hands. Default False: a caller that does not
    know says the plain name rather than asserting a bar that may not exist."""
    wt = _fmt_weight(weight)
    if not wt:
        return RUNG_PROMPT_BODYWEIGHT
    if str(label) == "bw":
        head = RUNG_PROMPT_BW_BAR if is_bar else RUNG_PROMPT_BW_STACK
    else:
        head = RUNG_PROMPT_RAMP
    return "%s %s" % (head, wt)
