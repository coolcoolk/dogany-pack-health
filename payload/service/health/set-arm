    print("IDRILL_ARM_SEQ\t%s" % set_seq)
    if rung_label is not None:
        emit_rung_set_cmd(args.session_id, args.exercise_name, slot_num,
                          set_seq, weight, target_reps, rung_label)
    # RULING 3 (2026-09-11): all four prescription axes, with their sources, on
    # every arm -- including the ones nothing resolved. See emit_rx_issued.
    _rx_plan = resolve_ramp_plan(rx, prog_abs, db_abs, args.session_id,
                                 args.exercise_name, override)
    emit_rx_issued(rx, prog_abs, db_abs, args.session_id, args.exercise_name,
                   set_seq, weight, target_reps,
                   arm_target_rir(rx, prog_abs, db_abs, args.session_id,
                                  args.exercise_name, rung_label, override),
                   rung_label, basis=_rx_plan.get("basis"), override=override)
    # PROVENANCE (2026-09-11, ruling 3). A ladder built on the DERIVED fallback
