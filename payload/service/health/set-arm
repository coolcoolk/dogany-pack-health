# ===========================================================================
# BUTTON CONSOLIDATION (2026-09-02) -- `step_affordance`
# ===========================================================================
# THE single decision point for "does this step need a button, and where does
# it attach". Six defects measured in one live session (D13/D17/D20/D21/D23/
# D25/D26) were six independent answers to that one question, three of them
# delegated to the model. They are now one answer, computed from data, gated.
#
# WHY THIS IS A CLASS-AS-NAMESPACE INSIDE set-arm AND NOT A SIBLING MODULE
# -----------------------------------------------------------------------
# The first cut of this work shipped it as a sibling step_affordance.py loaded
# by path. That was WRONG for this tree, and the suites said so loudly: most of
# them build their isolated tree from an ENUMERATED copy list ("set-add",
# "set-table", "set-arm", ...). A new sibling is in none of those lists, so in
# every one of those trees set-arm died at import with FileNotFoundError --
# measured on three suites at once, including that change's own post-apply
# re-run gate. Adding the file to every copy list would make every future suite
# and every future copier carry a fixture it cannot know about.
#
# So the invariants live where the only consumer lives. `set-arm` is a
# single-file CLI; a script that copies it gets the gate with it, and the gate
# can never be "missing" -- which matters, because the failure mode this whole
# block exists to remove is an affordance rule that silently is not there.
#
# A class is used purely as a namespace so every call site keeps reading
# `step_affordance.X` -- the name is the documentation ("there is ONE place
# that answers this"), and internal cross-references say it too.
class step_affordance(object):     # noqa: N801 -- namespace, not a type
    """THE ONE decision point for "does this step need a button, and where".

    THE FIVE INVARIANTS (each one is a measured defect)
    ---------------------------------------------------
    G1  TIMER_NEEDS_AFFORDANCE  (D25, D26)
        A step that arms a countdown MUST, in the SAME code action, declare the
        affordance that closes it. Arming a bare timer is refused.
        Measured: `set-arm countdown` armed a control file and returned; the
        button was left to the model, which authored it as a SEPARATE message
        that landed BEFORE the timer -- the owner asked why a completion button
        was being handed out separately from the timer that needed it.

    G2  NO_DEAD_AFFORDANCE  (D26, P0)
        An affordance is only emitted when it can actually render AND actually
        fires something. An arm with an empty step-1 keyboard renders nothing;
        an arm with no declared `cmd` makes the bridge edit IDRILL_ERROR and
        clear the keyboard -- the button simply vanishes on tap. Both are
        refused here.
        Measured: for wall_sit set 1 of 2 set-arm wrote arm 298dc117 with
        step_buttons["1"] == [] and NO "cmd" key at all, and emitted its marker.

    G3  DELIVER_ONCE  (D20, D24)
        One affordance == one owner-visible delivery. A second delivery of the
        same arm on the same channel is refused.
        Measured: arm af8371ab was pushed TWICE, 07:14:15 and 07:14:46. Two
        live keyboards for one set is how a phantom set row got written (D24).

    G4  IN_PLACE_NOT_NEW  (D20)
        A re-presentation of an affordance the owner already has is an in-place
        update, never a new message. G3 refuses the new message; this constant
        names the rule the refusal enforces (owner ruling 2026-08-22).

    G5  ONE_COMPLETION_PER_TIMER  (D23)
        A countdown states its own completion exactly once. A second completion
        sentence for the same timer is REPORTED (not silently emitted): the
        channel-2 rest-over prefix and the countdown's own done text are both
        owner-confirmed lines from different dates, so picking a winner is an
        owner call, not this artifact's.

    WHAT THIS DELIBERATELY DOES NOT DO
    ----------------------------------
    * It does not render. Rendering is bridge-owned (the countdown driver, the
      options renderer, the artifact keyboard builder) and is not touched.
    * It never writes to the owner's live surfaces: the delivery ledger hangs
      off set-arm's own STATE_DIR, resolved at CALL time, so an isolated suite
      that binds LIFEKIT_HEALTH_STATE_DIR gets an isolated ledger with no extra wiring.
    """

    # --- step kinds (what the owner is being asked to do) ------------------
    KIND_WORKING = "working_set"     # rep-based working set
    KIND_RUNG = "ramp_rung"          # warm-up primer / ramp rung
    KIND_HOLD = "hold_set"           # timed isometric hold set (wall_sit class)
    KIND_PREP = "prep_drill"         # mat / equipment prep drill
    KIND_FORK = "fork"               # a genuine decision with >= 2 candidates
    ALL_KINDS = (KIND_WORKING, KIND_RUNG, KIND_HOLD, KIND_PREP, KIND_FORK)

    # --- positions (where this step sits in its exercise) ------------------
    POS_CONTINUATION = "continuation"   # another set of THIS exercise remains
    POS_TRANSITION = "transition"       # last set -- next step is another ex.
    POS_SESSION_END = "session_end"     # nothing left
    ALL_POSITIONS = (POS_CONTINUATION, POS_TRANSITION, POS_SESSION_END)

    # --- attachment points (WHERE the button rides) ------------------------
    # The whole point of naming these: "buttons attach to the timer" (D23) and
    # "the button goes out as a separate message before the timer" (D25) are
    # the same disease -- the attachment point was defined nowhere.
    AT_NONE = "none"                  # no affordance belongs on this step
    AT_TIMER_FIRING_MSG = "timer_firing_message"  # the msg that ARMED a timer
    AT_SET_START_PUSH = "set_start_push"          # rest-over / set-start push
    AT_OWN_PUSH = "own_push"                      # its own detached push
    ALL_ATTACHMENTS = (AT_NONE, AT_TIMER_FIRING_MSG, AT_SET_START_PUSH,
                       AT_OWN_PUSH)

    # --- what the affordance's tap must DO ---------------------------------
    ARM_NONE = "none"
    ARM_REPS_RIR = "reps_rir"       # tap reps -> tap RIR -> set-add
    ARM_HOLD_DONE = "hold_done"     # tap = this hold is finished -> set-add
    ARM_HOLD_NEXT = "hold_next"     # tap = start the NEXT hold set's timer
    ARM_ADVANCE = "advance"         # tap = move to the next exercise/step
    ARM_FORK = "fork"               # tap = pick one of >= 2 candidates

    # --- refusal reasons (G-codes are quoted verbatim on stdout/stderr) -----
    G1 = "G1_TIMER_NEEDS_AFFORDANCE"
    G2 = "G2_DEAD_AFFORDANCE"
    G3 = "G3_ALREADY_DELIVERED"
    G4 = "G4_IN_PLACE_NOT_NEW"
    G5 = "G5_DUPLICATE_COMPLETION"

    # --- position-branched vocabulary (the pack already owns these words) ---
    # Kept here rather than re-derived per site so the LABEL and the ACTION can
    # never disagree -- "다음 세트" printed while the tap advances the exercise
    # is the class of bug that produced D26's silent stall.
    LABEL_HOLD_DONE = "✅ 홀드 완료"
    LABEL_HOLD_NEXT_FMT = "▶️ %d세트 시작 (%d초)"
    LABEL_ADVANCE = "다음(진행)"
    LABEL_SESSION_END = "완료"

    class Decision(object):
        """The single answer. Every call site reads these fields and nothing
        else. `needs_button` and `attach` are the two questions the ticket says
        are defined nowhere. They are defined here, once, from data."""

        __slots__ = ("kind", "position", "timer_armed", "candidates",
                     "needs_button", "attach", "arm_kind", "label", "why")

        def __init__(self, kind, position, timer_armed, candidates,
                     needs_button, attach, arm_kind, label, why):
            self.kind = kind
            self.position = position
            self.timer_armed = timer_armed
            self.candidates = candidates
            self.needs_button = needs_button
            self.attach = attach
            self.arm_kind = arm_kind
            self.label = label
            self.why = why

        def as_line(self):
            """One tab-delimited machine line, so a live run is diagnosable
            from stdout alone. Every emission decision now says WHY."""
            return "AFFORDANCE\tkind=%s\tpos=%s\ttimer=%s\tbutton=%s" \
                   "\tattach=%s\targ=%s\tlabel=%s\twhy=%s" % (
                       self.kind, self.position,
                       "1" if self.timer_armed else "0",
                       "1" if self.needs_button else "0",
                       self.attach, self.arm_kind, self.label or "-", self.why)

        def __repr__(self):
            return "<Decision %s>" % self.as_line()

    class AffordanceRefused(Exception):
        """A gate refused. Callers turn this into a non-zero exit / False.

        An EXCEPTION and not a return code on purpose: the failure mode this
        whole block exists to remove is a refusal that degrades into a log line
        nobody reads while the owner's session silently loses its button."""

        def __init__(self, code, detail=""):
            self.code = code
            self.detail = detail
            Exception.__init__(self,
                               "%s %s" % (code, detail) if detail else code)

    # -----------------------------------------------------------------------
    # THE decision.
    # -----------------------------------------------------------------------
    @staticmethod
    def decide(kind, position, timer_armed=False, candidates=1,
               next_set_seq=None, hold_seconds=None):
        """Pure function of DATA -- no model input reaches it.

        kind        one of ALL_KINDS
        position    one of ALL_POSITIONS
        timer_armed True when THIS code action arms a channel-1 countdown
        candidates  how many real next actions exist (0, 1 or N)
        next_set_seq / hold_seconds  used only to word a hold-next label

        Returns a Decision. Raises AffordanceRefused(G1) for the one
        combination that is never legal: arming a timer for a step that gets no
        affordance.
        """
        sa = step_affordance
        if kind not in sa.ALL_KINDS:
            raise sa.AffordanceRefused(sa.G2, "unknown step kind %r" % (kind,))
        if position not in sa.ALL_POSITIONS:
            raise sa.AffordanceRefused(sa.G2,
                                       "unknown position %r" % (position,))

        # --- session end: nothing to tap, and a button here is the owner's
        # --- standing objection to being asked to press 진행 again (2026-08-24)
        if position == sa.POS_SESSION_END:
            d = sa.Decision(kind, position, timer_armed, candidates,
                            False, sa.AT_NONE, sa.ARM_NONE,
                            sa.LABEL_SESSION_END, "session_end_no_affordance")
            # A timer at session end still needs its own completion affordance;
            # only a NON-timer session-end step is button-free.
            if timer_armed:
                d.needs_button = True
                d.attach = sa.AT_TIMER_FIRING_MSG
                d.arm_kind = sa.ARM_HOLD_DONE
                d.label = sa.LABEL_HOLD_DONE
                d.why = "timer_at_session_end_still_needs_its_close"
            return d

        # --- a genuine fork ALWAYS gets code-emitted buttons ---------------
        # D13/D21: the fork is exactly where the owner had to type. The defect
        # is not "the model forgets the marker" -- it is that a model-discretion
        # stretch carries no button GUARANTEE at all.
        if kind == sa.KIND_FORK:
            if candidates < 2:
                # Not a fork. Offering a menu of one is the D3/H17 defect.
                raise sa.AffordanceRefused(
                    sa.G2, "fork declared with %d candidate(s) -- a menu of "
                           "one is not a decision" % candidates)
            return sa.Decision(kind, position, timer_armed, candidates,
                               True, sa.AT_OWN_PUSH, sa.ARM_FORK, None,
                               "real_fork_code_emitted")

        # --- a timed hold --------------------------------------------------
        if kind == sa.KIND_HOLD:
            if timer_armed:
                # THE D25 FIX, structurally: the affordance that closes a hold
                # rides the very message that fired its timer. It cannot be a
                # separate earlier message because it is built in the same call.
                return sa.Decision(kind, position, timer_armed, candidates,
                                   True, sa.AT_TIMER_FIRING_MSG,
                                   sa.ARM_HOLD_DONE, sa.LABEL_HOLD_DONE,
                                   "hold_timer_carries_its_close")
            if position == sa.POS_CONTINUATION:
                # THE D26 FIX: another hold set remains, so the affordance is
                # the NEXT HOLD'S TIMER, delivered on the rest-over push.
                seq = next_set_seq if next_set_seq is not None else 0
                sec = hold_seconds if hold_seconds is not None else 0
                return sa.Decision(kind, position, timer_armed, candidates,
                                   True, sa.AT_SET_START_PUSH,
                                   sa.ARM_HOLD_NEXT,
                                   sa.LABEL_HOLD_NEXT_FMT % (seq, sec),
                                   "next_hold_set_armed_by_code")
            # transition: the hold exercise is done -> advance
            return sa.Decision(kind, position, timer_armed, candidates,
                               True, sa.AT_SET_START_PUSH, sa.ARM_ADVANCE,
                               sa.LABEL_ADVANCE, "hold_exercise_finished_"
                                                 "advance")

        # --- rep-based working set -----------------------------------------
        if kind == sa.KIND_WORKING:
            if position == sa.POS_CONTINUATION:
                return sa.Decision(kind, position, timer_armed, candidates,
                                   True, sa.AT_SET_START_PUSH,
                                   sa.ARM_REPS_RIR, None,
                                   "next_working_set_reps_keyboard")
            return sa.Decision(kind, position, timer_armed, candidates,
                               True, sa.AT_SET_START_PUSH, sa.ARM_ADVANCE,
                               sa.LABEL_ADVANCE, "exercise_finished_advance")

        # --- ramp rung: no rest, no push of its own -> its OWN carrier ------
        if kind == sa.KIND_RUNG:
            return sa.Decision(kind, position, timer_armed, candidates,
                               True, sa.AT_OWN_PUSH, sa.ARM_REPS_RIR, None,
                               "rung_has_no_rest_push_to_ride")

        # --- prep drill: one completion tap, on its own carrier -------------
        return sa.Decision(kind, position, timer_armed, candidates,
                           True, sa.AT_OWN_PUSH, sa.ARM_HOLD_DONE,
                           sa.LABEL_HOLD_DONE, "prep_drill_completion_tap")

    # -----------------------------------------------------------------------
    # G1: a timer may not be armed without an affordance.
    # -----------------------------------------------------------------------
    @staticmethod
    def gate_timer(decision):
        """Refuse a countdown that closes into nothing.

        The forcing point for D25/D26. `set-arm countdown` used to arm a control
        file and return 0; whether a button existed was a separate,
        model-authored event. Now the arming call itself cannot succeed without
        a declared affordance, so "the timer is here and the button is in some
        other message" is unreachable."""
        if decision.timer_armed and not decision.needs_button:
            raise step_affordance.AffordanceRefused(
                step_affordance.G1,
                "a countdown was armed for a %s/%s step with no affordance to "
                "close it (a timer the owner cannot answer is a stall -- they "
                "cannot type around a running timer)"
                % (decision.kind, decision.position))
        return True

    # -----------------------------------------------------------------------
    # G2: an affordance must be able to render AND to fire.
    # -----------------------------------------------------------------------
    @staticmethod
    def payload_is_live(payload):
        """True iff this arm payload would produce a WORKING button.

        TWO clauses, both separately violated by the live hold arm:

          renderable -- step_buttons["1"] and step_text["1"] both non-empty.
            Both bridge rails (the initial-keyboard sender and the artifact
            keyboard builder) hardcode step "1" and return early when either
            half is empty. There is NO step-2 fallback on the initial render,
            so an arm with an empty step 1 renders NOTHING while every log line
            says the push was SENT.

          actionable -- a declared `cmd` list. The bridge's final-fire handler
            consumes the arm and returns False on a missing `cmd` -> it edits
            IDRILL_ERROR and the keyboard is gone. That is D26's tap that
            neither starts the next timer nor leaves the button on screen,
            exactly."""
        if not isinstance(payload, dict):
            return False, "not a payload dict"
        rows = (payload.get("step_buttons") or {}).get("1") or []
        text = ((payload.get("step_text") or {}).get("1") or "").strip()
        if not rows:
            return False, "step_buttons[1] is empty -- nothing would render"
        if not text:
            return False, "step_text[1] is empty -- nothing would render"
        cmd = payload.get("cmd")
        if not isinstance(cmd, list) or not cmd:
            return False, ("no declared cmd -- the tap would clear the "
                           "keyboard and do nothing (IDRILL_ERROR)")
        if not all(isinstance(el, str) for el in cmd):
            return False, "declared cmd is not a list of strings"
        return True, "live"

    @staticmethod
    def gate_payload(payload, arm_id="?"):
        """Refuse a dead affordance. Raises AffordanceRefused(G2)."""
        ok, why = step_affordance.payload_is_live(payload)
        if not ok:
            raise step_affordance.AffordanceRefused(
                step_affordance.G2, "arm=%s %s" % (arm_id, why))
        return True

    # -----------------------------------------------------------------------
    # G3: one affordance, one delivery.
    # -----------------------------------------------------------------------
    @staticmethod
    def ledger_dir():
        """Resolved at CALL time off set-arm's own STATE_DIR.

        NOT captured at import: STATE_DIR is the pinned files/program runtime
        surface (or $LIFEKIT_HEALTH_STATE_DIR), and resolving the ledger anywhere else
        would put the delivery record on a different surface from every other
        runtime marker -- which is how a suite ends up writing next to the
        owner's live markers."""
        return os.path.join(STATE_DIR, ".affordance-ledger")

    @staticmethod
    def _ledger_path(session_id, arm_id, channel):
        safe = "%s.%s.%s" % (session_id, arm_id, channel)
        safe = "".join(ch if (ch.isalnum() or ch in "._-") else "_"
                       for ch in safe)
        return os.path.join(step_affordance.ledger_dir(), safe)

    @staticmethod
    def already_delivered(session_id, arm_id, channel="push"):
        """True when this exact affordance already went out on this channel."""
        return os.path.exists(
            step_affordance._ledger_path(session_id, arm_id, channel))

    @staticmethod
    def claim_delivery(session_id, arm_id, channel="push", dry_run=False):
        """Claim the ONE delivery slot for (session, arm, channel).

        Returns True when the caller owns the delivery. Returns False when it
        was already claimed -- the caller must then send NOTHING (G4: a repeat
        is an in-place update, the bridge's job on the existing message, never
        a new push).

        O_CREAT|O_EXCL, so two concurrent set-arm processes cannot both win.
        The measured D20 duplicate was two separate set-arm invocations 31s
        apart resolving to the same next arm; a non-atomic check would have let
        both through."""
        sa = step_affordance
        if dry_run:
            return not sa.already_delivered(session_id, arm_id, channel)
        p = sa._ledger_path(session_id, arm_id, channel)
        try:
            os.makedirs(sa.ledger_dir(), exist_ok=True)
            fd = os.open(p, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
        except FileExistsError:
            return False
        except OSError:
            # Best-effort like every other side effect in this pack: a ledger
            # we cannot write must never cost the owner the button. Degrades to
            # the pre-fix behaviour (delivery allowed), never to a lost one.
            return True
        try:
            os.write(fd, json.dumps({"at": time.time(), "channel": channel})
                     .encode("utf-8"))
        finally:
            os.close(fd)
        return True

    @staticmethod
    def release_delivery(session_id, arm_id, channel="push"):
        """Drop a claim (a re-arm of the same seq after a correction
        legitimately re-delivers). Correction path only; absent = already
        free."""
        try:
            os.remove(step_affordance._ledger_path(session_id, arm_id,
                                                   channel))
            return True
        except OSError:
            return False

    # -----------------------------------------------------------------------
    # G5: one completion statement per timer.
    # -----------------------------------------------------------------------
    @staticmethod
    def completion_conflict(timer_armed_on_channel1, push_text):
        """Report (never silently fix) a second completion sentence for one
        rest.

        The bridge's countdown finalises its own message to "✅ <label> 완료"
        and set-arm's channel-2 push opens with "✅ N초 휴식 완료". Both are
        real, both are owner-confirmed lines from different dates, and the owner
        sees the completion twice with the countdown's copy sitting ABOVE the
        milestone pushes in the scroll (D23's reversed reading order).

        This refuses to pick a winner unilaterally -- that is an owner call. It
        returns the finding so a caller can print it and a test can assert it."""
        if not timer_armed_on_channel1:
            return None
        text = str(push_text or "")
        if "휴식 완료" in text:
            return (step_affordance.G5,
                    "channel-1 countdown will render its own '휴식 완료' and "
                    "this channel-2 push restates it -- the owner sees the "
                    "completion twice, out of order (D23)")
        return None

