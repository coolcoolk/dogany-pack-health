# WHY the imperative: the keyboard is a convenience, NOT the only route -- a value
# outside the button window gets typed. "몇 개?" reads as "answer me in prose";
# "입력해주세요" covers BOTH tapping a key and typing an off-window value. Same
# reason the prose line above it already says 입력 (owner 2026-08-21 12:55).


def build_idrill_payload(session_id, exercise_name, set_seq, slot_num, weight,
                         target_reps, hold_class, rest_basis, rest_sec,
                         correct=False, rung_label=None, db_path=None,
                         alt_weight=None, slot_engine=None, rir_explain=None):
    """DGN-918 contract v3.1 arm-file payload builder (single source, shared by
    BOTH arm entry points):
      * post-log arm: set-add's do_add fires set-arm AFTER writing the set, to
        re-present the keyboard on an in-place correction; and
      * REPS-FIRST arm (`reps-entry` subcommand): on working-set ENTRY, BEFORE
        any DB write, so the owner gets the reps->RIR keyboard at turn-0 instead
        of the slow prose "몇 개 하셨어요?" model roundtrip.

    Returns the full JSON-able payload dict declaring every button / validate /
    text / confirm-template / terminal argv. The bridge is verb- and
    value-agnostic: it renders/validates/executes purely from these declarations,
    substituting only the {1}(reps)/{2}(rir) positional tokens then running the
    declared list-form set-add command (which performs the DB write on the tap).
    So the REPS-FIRST path can arm WITHOUT writing the DB first -- the set is
    logged only when both steps are chosen and the callback fires cmd/cmd_skip2.

    Weight-free (bw/calibration -> weight None) omits --weight, mirroring set-add.
    Hold/iso carries only the {sec} confirm template and an empty step-1 window
    (RIR-first); a working set carries the RIR + RIR-skip variants and the
    reps-window step-1 keyboard. A None/unusable target_reps collapses to the
    RIR-first path (empty window) rather than an empty reps keyboard.

    `correct` (2026-08-21) declares `--correct` in the fired argv. It belongs to
    the POST-LOG arm ONLY -- that arm re-presents the keyboard on a set that is
    ALREADY WRITTEN, so a differing tap is by definition an in-place correction
    and set-add's collision gate needs the explicit signal or the tap dies with
    IDRILL_ERROR and records nothing. It must NEVER ride the PRE-LOG arms
    (`reps-entry` on entry, the set-start push's set_seq+1 arm): those write a set
    that does not exist yet, and handing them --correct would turn the gate into
    a no-op and re-open the 2026-08-21 destroy-a-logged-set defect.

    `rung_label` ('bw' / 'rN') marks this arm as a warm-up RUNG arm (set_seq <=
    0) and switches it to the ONE-STEP, RIR-free shape described at
    RAMP_STEP_VALIDATE above: reps window centred on the RUNG's own target reps,
    prompt naming the rung, argv without --rir, step_final "1".

    `alt_weight` (owner design 2, 2026-10-09): the prescription's fallback
    weight. On a PRE-log 2-step working arm, and only when the installed bridge
    carries the DGN-1955 engine (`slot_engine`, default: probe it), step 1
    becomes a weight row + reps row -- see apply_weight_row. Otherwise it is
    ignored and the arm is byte-identical to a single-weight prescription."""
    payload = {
        "session_id": session_id,
        "exercise_name": exercise_name,
        "slot_num": slot_num,
        "set_seq": set_seq,
        "weight": weight,
        "target_reps": target_reps,
    }
    mod = _ui_labels()
    ask_rir = not mod or mod.gate("set_arm.step2_rir", db_path)["visible"]
    is_rung = bool(rung_label) and not hold_class
    # live batch 2 item 2: a loaded rung on an ESTIMATED working weight is a
    # calibration PROBE -- it asks RIR too (2-step), because a probe is only
    # informative when its RIR is known (RIR <= 3 at modest reps).
    probe = (is_rung and str(rung_label) != "bw" and db_path is not None
             and is_probe_lift(db_path, session_id, exercise_name))
    reps_only = (is_rung and not probe) or (not hold_class and not ask_rir)
    # DGN-918 confirm-string templates (option b): copy owned here, not the
    # bridge. Hold/iso carries only the {sec} template; a working set carries
    # both the RIR and the RIR-skip variant so the callback picks by tap.
    if hold_class:
        payload["confirm_fmt"] = CONFIRM_FMT_HOLD
    elif is_rung and not probe:
        # ONE captured value ({1} = reps) -> a {2}-bearing template would be a
        # malformed render. No rest-grounds fold either: no rest is armed for a
        # rung, so the §5.11 grounds have no subject.
        payload["confirm_fmt"] = CONFIRM_FMT_RUNG
    elif probe:
        payload["confirm_fmt"] = confirm_fmt_working(db_path)
        payload["confirm_fmt_skip"] = CONFIRM_FMT_SKIP
        payload["probe"] = True
    else:
        payload["confirm_fmt"] = confirm_fmt_working(db_path)
        payload["confirm_fmt_skip"] = CONFIRM_FMT_SKIP
        # DGN-939 §5.12 + §5.11: attach the collapsed rest-grounds fold, if
        # there is one to show. Static (no {1}/{2}) so it is valid on both the
        # RIR and RIR-skip fire paths.
        fold = build_rest_grounds_fold(rest_basis, rest_sec)
        if fold:
            payload["confirm_fold"] = fold
    # DGN-918 contract v2 (declared-argv): the arm-id file declares the FULL
    # terminal argv; the bridge is verb-agnostic and only substitutes the
    # {1}/{2} positional tokens then runs the list-form command (argv[0] = our
    # declared absolute path, no PATH lookup, no shell). set-arm owns the domain
    # verb (set-add). cmd = with --rir; cmd_skip2 = the RIR-skipped form.
    if not hold_class:
        _setadd = os.path.join(SCRIPT_DIR, "set-add")
        _base = [_setadd, str(session_id), exercise_name,
                 str(slot_num), str(set_seq), "{1}"]
        if weight is not None:
            _base += ["--weight", str(weight)]
        if is_rung and target_reps is not None:
            # the rung's prescription rides the row: a done-tap stores reps
            # NULL, so this is where "what was prescribed" lives.
            _base += ["--target-reps", str(target_reps)]
        if correct:
            _base += ["--correct"]
        if reps_only:
            # One step, one capture: {1} = reps. NO --rir (see RAMP_STEP_VALIDATE
            # -- a prescription never enters a measurement column) and NO
            # cmd_skip2 (there is no skippable step to fall back from).
            payload["cmd"] = list(_base)
        else:
            payload["cmd_skip2"] = list(_base)
            payload["cmd"] = _base + ["--rir", "{2}"]
        # DGN-939 item2 (followup_cmd): after set-add fires (exit 0), the bridge
        # posts set-table's stdout as a NEW inline message -> the 세트표 refreshes
        # on the zero-model-turn callback path. sid/exercise literal.
        # `--surface owner` is DECLARED here, not left to set-table's default.
        # This argv IS a delivery path: the bridge runs it with no model turn
        # and posts its stdout to the owner VERBATIM. set-table's default
        # happens to be the same answer, and an inferred default and a declared
        # one read identically in the output and not in the code -- the rail
        # that sends text to a human says which human surface it is.
        _settable = os.path.join(SCRIPT_DIR, "set-table")
        payload["followup_cmd"] = [_settable, str(session_id), exercise_name,
                                   "--surface", "owner"]

    if hold_class and not ask_rir:
        # Holds have a dedicated press-start/timer completion flow. The legacy
        # RIR-only drilldown must not ask for a hidden quantity; no reps or
        # replacement measurement is invented for this non-rep movement.
        return payload

    # DGN-918 contract v3.1: DECLARE the full keyboard spec in the arm file.
    #   step_buttons["1"] = STEP-1 keyboard (workout: the reps window and
    #     nothing else, H9/H13; hold/iso or unusable target_reps: [] -> bridge
    #     jumps straight to RIR).
    #   step_buttons["2"] = STEP-2 keyboard (RIR range + skip).
    window = [] if hold_class else reps_window(target_reps)
    if reps_only:
        # RUNG: exactly ONE declared step, so the bridge's _idrill_next_step
        # finds no successor and step_final "1" fires on the reps tap. The
        # window is centred on the RUNG's target reps (the ax_engine taper 표2
        # renders for this same rung), never the working set's rep range.
        # A PROBE rung with RIR hidden (beginner) is still a probe: it asks
        # the COUNT, never a `done` tap -- a done-tap stores reps NULL and
        # probe_decision then has nothing to calibrate from.
        done_tap = is_rung and not probe
        payload["step_buttons"] = {
            "1": ([[RUNG_DONE_LABEL, RUNG_DONE_VALUE]] if done_tap
                  else ([] if not window
                        else build_reps_step_buttons(window))),
        }
        payload["step_final"] = "1"
        # `done` is a done-tap RUNG value only; a counted set never takes it.
        payload["step_validate"] = (dict(RUNG_STEP_VALIDATE) if done_tap
                                    else dict(RAMP_STEP_VALIDATE))
        if probe:
            payload["confirm_fmt"] = CONFIRM_FMT_SKIP
            payload.pop("confirm_fmt_skip", None)
            payload["step_text"] = {"1": "%s \u2014 %s" % (
                rung_prompt_label(rung_label, weight),
                _copy("health.live.rung_reps_prompt"))}
            return payload
        if not is_rung:
            payload["confirm_fmt"] = CONFIRM_FMT_SKIP
            payload.pop("confirm_fmt_skip", None)
            payload["step_text"] = {"1": "반복수를 입력해주세요."}
            return payload
        # Which 세팅 form this rung is spoken in -- read from the SHARED gate,
        # never inferred from the weight (a stack rung can be 20.0kg with no bar
        # in their hands). Same predicate 표2's `bar_primer` and the plate cue use,
        # so the keyboard and the table can never disagree about whether they are
        # holding a bar. Only the `bw` rung consults it; a loaded rung reads 웜업
        # either way. Best-effort: a gate miss drops the two words "빈 봉", it
        # never costs the keyboard.
        _rung_is_bar = False
        if str(rung_label) == "bw" and db_path:
            try:
                _rung_is_bar = bool(
                    ax_engine().is_plate_loaded(db_path, exercise_name))
            except Exception:  # noqa: BLE001 -- never break an arm on a gate miss
                _rung_is_bar = False
        payload["step_text"] = {
            "1": RAMP_STEP_TEXT_FMT % rung_prompt_label(rung_label, weight,
                                                        is_bar=_rung_is_bar),
        }
        return payload
    payload["step_buttons"] = {
        "1": ([] if not window else build_reps_step_buttons(window)),
        "2": rir_step_buttons(db_path),
    }
    payload["step_validate"] = dict(WORKOUT_STEP_VALIDATE)
    payload["step_text"] = workout_step_text(db_path, session_id, rir_explain)
    if probe:
        _st = dict(payload["step_text"])
        _st["1"] = "%s \u2014 %s" % (rung_prompt_label(rung_label, weight),
                                     _st.get("1")
                                     or _copy("health.live.rung_reps_prompt"))
        payload["step_text"] = _st
    elif (not is_rung and window and not correct
            and fallback_weight({"alt_weight_kg": alt_weight}, weight)
            is not None
            and (slot_engine if slot_engine is not None
                 else bridge_slot_engine())):
        apply_weight_row(payload, weight, float(alt_weight), db_path)
    return payload


# ---------------------------------------------------------------------------
# WEIGHT ROW (owner design 2, 2026-10-09 00:40; bridge DGN-1955).
# ---------------------------------------------------------------------------
# A prescription carries ONE weight, unless it names a FALLBACK ("22.5kg, or
# 20kg if there is no 1.25 plate" -- 2026-10-08 07:57: the arm recorded 22.5,
# the owner lifted 20). The fallback is the override key `alt_weight_kg`
# (`set-arm ... --ov-alt-weight 20`), so it lives and dies with the
# prescription it belongs to. With one, step 1 grows a weight row above the
# reps row: [* prescribed][alt]. Prescribed is preselected, so the common case
# stays 2 taps (reps -> RIR); tapping the alt re-renders step 1 in place with
# the alt selected (3 taps); the record takes the TAPPED weight.
#
# Engine keys (IDRILL-ARM-CONTRACT section 9): step_goto sends a weight tap
# back to step 1 (self-loop) and a reps tap to the RIR step; step_slots names
# w / reps / rir, so the argv and the headers read the taps BY NAME -- a
# self-loop makes the positional {1}/{2} capture list length vary, so named
# slots are mandatory here. Weight values carry a `w` prefix so a weight can
# never collide with a reps value on the same step ("20" kg vs 20 reps); the
# reps values are unchanged.
#
# CAPABILITY. A bridge without DGN-1955 ignores the new keys: the weight tap
# would advance to RIR and the argv would carry a literal "{w}". So the row is
# emitted only when the INSTALLED bridge's artifacts.py -- the one module both
# send rails (bot.py and the push.sh hop) build idrill keyboards through --
# parses all four keys. A version compare cannot answer this: __vendor_rev__
# is a free-form tag, the framework release carrying DGN-1955 is not numbered
# yet, and the contract has no contract_version surface. Otherwise the arm is
# today's, byte for byte, with the ONE prescribed weight (the alt is never
# shown or recorded).
BRIDGE_DIR = (os.environ.get("WARG_BRIDGE_DIR")
              or os.path.join(PROJECT_ROOT, "bridge"))
SLOT_ENGINE_KEYS = ("step_goto", "step_slots", "slot_default",
                    "selected_marker")
WEIGHT_ROW_MARKER = "\u25cf "          # the contract's default, declared
WEIGHT_VALUE_PREFIX = "w"
WEIGHT_ROW_STEP1_VALIDATE = r"^(w[0-9]{1,4}(\.[0-9]{1,3})?|[0-9]{1,4})$"
WEIGHT_ROW_RIR_VALUES = ["0", "1", "2", "3", "4"]


def bridge_slot_engine(bridge_dir=None):
    """True when the installed bridge parses every DGN-1955 arm key (feature
    probe on bridge/artifacts.py source). Any read failure -> False."""
    path = os.path.join(bridge_dir or BRIDGE_DIR, "artifacts.py")
    try:
        with open(path, "rb") as fh:
            src = fh.read(1 << 20)
    except OSError:
        return False
    return all(k.encode("ascii") in src for k in SLOT_ENGINE_KEYS)


def fallback_weight(override, weight):
    """The prescription's fallback weight (override `alt_weight_kg`), or None
    when there is none, it is unusable, or it equals the served weight."""
    try:
        alt = float((override or {}).get("alt_weight_kg"))
        served = float(weight)
    except (TypeError, ValueError):
        return None
    if alt <= 0 or alt == served:
        return None
    return alt


def _kg_num(weight_kg):
    """20.0 -> '20', 22.5 -> '22.5' (the argv value and the header echo)."""
    return (_fmt_weight(float(weight_kg)) or "")[:-2]


def apply_weight_row(payload, weight, alt_weight, db_path=None):
    """Turn a 2-step working arm into the design-2 weight-row arm, in place."""
    w_main, w_alt = _kg_num(weight), _kg_num(alt_weight)
    v_main = WEIGHT_VALUE_PREFIX + w_main
    v_alt = WEIGHT_VALUE_PREFIX + w_alt
    reps_vals = [v for _l, v in payload["step_buttons"]["1"]]
    payload["alt_weight"] = alt_weight
    payload["step_buttons"]["1"] = [
        [[w_main + "kg", v_main], [w_alt + "kg", v_alt]],
        [list(b) for b in payload["step_buttons"]["1"]]]
    payload["step_validate"]["1"] = WEIGHT_ROW_STEP1_VALIDATE
    goto = {v_main: "1", v_alt: "1"}
    goto.update((v, "2") for v in reps_vals)
    payload["step_goto"] = {"1": goto}
    payload["step_slots"] = {
        "1": {"w": {v_main: w_main, v_alt: w_alt}, "reps": reps_vals},
        "2": {"rir": list(WEIGHT_ROW_RIR_VALUES)}}
    payload["slot_default"] = {"w": v_main}
    payload["selected_marker"] = WEIGHT_ROW_MARKER
    n = payload.get("set_seq")
    payload["step_text"] = {
        "1": _copy("health.live.wrow_step1", n=n),
        "2": _copy("health.live.wrow_step2",
                   ask=(payload.get("step_text") or {}).get("2")
                   or rir_ask(db_path, payload.get("session_id")))}
    named = {"{1}": "{reps}", "{2}": "{rir}"}
    for key in ("cmd", "cmd_skip2"):
        argv = [named.get(a, a) for a in payload[key]]
        argv[argv.index("--weight") + 1] = "{w}"
        payload[key] = argv
    load = _copy("health.live.record_load", kg="{w}", reps="{reps}")
    skip = _copy("health.live.record_line", n=n, load=load, rir="")
    payload["confirm_fmt_skip"] = skip
    mod = _ui_labels()
    rir_tmpl = (mod.rir_value_template("{rir}", db_path) if mod
                else "%s {rir}" % _rir_label(db_path))
    payload["confirm_fmt"] = (
        _copy("health.live.record_line", n=n, load=load,
              rir=_copy("health.live.record_rir", rir=rir_tmpl))
        if payload.get("confirm_fmt") != CONFIRM_FMT_SKIP and rir_tmpl
        else skip)
    return payload


def idrill_marker_text(arm_id):
    """The bare `[[IDRILL:<arm_id>]]` line as pushable BODY text (v1.39.3).

    push.sh runs the same shared artifact-render hop the bridge uses
    (bridge/artifacts.py initial_keyboard_json): the marker line is stripped
    from the body and step_buttons["1"]/step_text["1"] go out as a keyboard
    message. A body that strips to whitespace (this one) skips the body bubble
    entirely, so a marker-only push is exactly ONE owner-visible message
    carrying the full declared keyboard -- rows, grids, drilldown steps."""
    return "[[IDRILL:%s]]" % arm_id


def arm_is_renderable(payload):
    """A1-KEYBOARD: True iff this arm can actually produce a visible keyboard
    on the INITIAL-marker rail.

    STEP 1 ONLY, and that is not a simplification -- it is what both rails do.
    bridge/bot.py `_idrill_send_initial_keyboard` and bridge/artifacts.py
    `initial_keyboard_json` (the push.sh hop) BOTH call
    `build_step_keyboard_spec(arm, arm_id, "1")` with the step hardcoded, and
    both return early ("declares no step_buttons[1]" / "no step_text[1]") when
    either half is empty. There is NO step-2 fallback on the initial render, so
    a hold/iso arm -- which declares step 1 empty on purpose and starts at RIR --
    renders nothing from a marker. (A comment elsewhere in this file claims the
    bridge "renders step 2 first when step 1 is empty"; that is stale. Hold sets
    are advanced by the HOLD_NEXT text affordance instead, which is why the gap
    has never been visible.)

    Checking it MATTERS: pushing a marker for an unrenderable arm ships a body
    that strips to whitespace and then no keyboard message, so the owner gets
    literally nothing while every log line says the push was SENT. That is the
    same symptom class as the defect this ticket exists for. The caller checks
    BEFORE it delivers and falls back to plain text."""
    if not isinstance(payload, dict):
        return False
    rows = (payload.get("step_buttons") or {}).get("1") or []
    text = ((payload.get("step_text") or {}).get("1") or "").strip()
    return bool(rows) and bool(text)


# CODE-POSTED SET KEYBOARD (owner live 2026-10-08): every row that owes a
# keyboard gets it from CODE, through row_keyboard.py -- one keyboard per
# (session, exercise, seq), posted with a recorded message id so a repost edits
# in place and a superseded / typed-over / undone row's buttons are cleared.
# None here (module missing, push.sh without strict+edit, dry-run) -> every
# caller keeps the rail it had before, byte for byte.
_ROW_KB = None


def row_kb():
    """row_keyboard when it can carry this install's set keyboards, else None."""
    global _ROW_KB
    if _ROW_KB is None:
        _ROW_KB = False
        try:
            if SCRIPT_DIR not in sys.path:
                sys.path.insert(0, SCRIPT_DIR)
            import row_keyboard as _mod
            if _mod.usable(PUSH, STATE_DIR):
                _ROW_KB = _mod
        except Exception:  # noqa: BLE001 -- the old rail stays
            _ROW_KB = False
    return _ROW_KB or None


def post_row_keyboard(arm_id, payload, dry_run, out, db_path=None, delay=None,
                      prefix=None, channel="row-kb", gen=None, gen_file=None):
    """Post the keyboard of the row this arm logs, by code. Returns
    row_keyboard.schedule's verdict ("scheduled" / "already" / "not_owed"),
    or None when the code rail does not apply (the caller keeps its own)."""
    if dry_run or not dgn918_enabled() or not isinstance(payload, dict):
        return None
    mod = row_kb()
    if mod is None:
        return None
    rows, text = mod.idrill_rows(arm_id, payload)
    if not rows or not text:
        return None
    try:
        seq = int(payload.get("set_seq"))
    except (TypeError, ValueError):
        return None
    if prefix:
        text = "%s\n%s" % (prefix, text)
    legacy = idrill_marker_text(arm_id)
    if prefix:
        legacy = "%s\n%s" % (prefix, legacy)
    kind = mod.KIND_TAP if seq <= 0 else mod.KIND_REPS
    verdict = mod.schedule(
        STATE_DIR, PUSH, payload.get("session_id"),
        payload.get("exercise_name"), seq, kind, mod.RAIL_IDRILL, text, rows,
        arm_id=arm_id, db_path=db_path,
        delay=ARM_KB_PUSH_DELAY_SEC if delay is None else delay,
        gen=gen, gen_file=gen_file, ch2_log=CH2_LOG, legacy_text=legacy,
        channel=channel)
    out.append("[row-kb %s] arm=%s seq=%s kind=%s channel=%s"
               % (verdict, arm_id, seq, kind, channel))
    return None if verdict == "invalid" else verdict


def post_prep_tap(tap, session_id, exercise_name, dry_run, out, db_path=None,
                  delay=None):
    """The NEXT prep drill's completion button, posted by code (one `opt:`
    button: the tap reaches the agent as a user message, which runs the
    PREP_TAP_CMD -- the same route the model-authored button took). Returns
    the schedule verdict, or None when the code rail does not apply."""
    if not tap or dry_run or not dgn918_enabled():
        return None
    mod = row_kb()
    if mod is None:
        return None
    label, seq, drill, _slot_num, spec, _argv = tap
    drill = drill or {}
    # The drill's own display, never a bracketed seq tag: the outbound gate
    # reads `[p1]` as a machine-shaped line. The seq label rides the button.
    import prep_cues
    text = "\n".join(prep_cues.block(
        drill, spec, ordinal=-100 - int(seq) + 1))
    button = "%s (%s)" % (RUNG_DONE_LABEL, label)
    verdict = mod.schedule(
        STATE_DIR, PUSH, session_id, exercise_name, seq, mod.KIND_TAP,
        mod.RAIL_OPT, text, mod.opt_rows(button), db_path=db_path,
        delay=ARM_KB_PUSH_DELAY_SEC if delay is None else delay,
        ch2_log=CH2_LOG, channel="prep-tap")
    out.append("[row-kb %s] prep=%s seq=%s" % (verdict, label, seq))
    return None if verdict == "invalid" else verdict


def emit_prep_tap(tap, session_id, exercise_name, dry_run, out, db_path=None):
    """Post the next drill's button by code when the code rail applies, then
    print the lines for it (emit_prep_tap_lines, told whether it was posted)."""
    verdict = post_prep_tap(tap, session_id, exercise_name, dry_run, out,
                            db_path=db_path)
    if verdict is not None and tap:
        print("PREP_TAP_POSTED\t%s\tseq=%s\tstatus=%s\tby=code"
              % (tap[0], tap[1], verdict))
    for line in emit_prep_tap_lines(tap, posted=verdict is not None):
        print(line)


def deliver_arm_keyboard(arm_id, payload, dry_run, out, sid=None,
                         marker="arm-keyboard", delay=None, prefix=None,
                         status=None, row=False, db_path=None):
    """A1-KEYBOARD (2026-08-25): ATTACH a minted arm's keyboard to a REAL
    outbound message, by code.

    This is the whole fix. Before today an arm reached the owner only if the
    MODEL retyped `[[IDRILL:<arm>]]` into its reply; measured over the owner's
    session 10092 that happened 3 times out of 40 arms, and 0 times in the last
    71 minutes. A delivery obligation that lives in a prose instruction decays
    the moment the model's reply template stabilises around anything else.

    The body is MARKER-ONLY by default, so push.sh skips the text bubble and the
    keyboard message IS the push -- exactly one owner-visible message. `prefix`
    prepends real body text when the caller wants the keyboard to ride a
    sentence (then it is two messages, body then keyboard: push.sh's shape).

    Returns True if a delivery was actually scheduled. False (and NOTHING sent)
    when the arm cannot render -- see arm_is_renderable; the caller then owns
    the plain-text fallback. Best-effort like every other push here: a lost
    keyboard must never cost the logged set.

    `status` (2026-09-11, ONE ARM ONE KEYBOARD): an optional caller-supplied
    list this function appends exactly one reason token to --
    "scheduled" / "unrenderable" / "refused_duplicate". The bool return alone
    cannot tell a caller whether False means "no keyboard exists" (marker
    fallback is legitimate) or "the keyboard is ALREADY on the owner's screen"
    (a marker fallback would render the same buttons a second time -- the
    2026-09-11 06:36/06:37 double). Additive: every no-status caller is
    byte-identical."""
    def _status(token):
        if status is not None:
            status.append(token)
    if not arm_is_renderable(payload):
        # NOT silent. This is the branch that, pushed anyway, produces the
        # owner-visible "text arrived, no buttons" with every log line claiming
        # SENT: the canonical push.sh stages no keyboard for an unrenderable arm
        # and says nothing about it. Refusing here is the fix; SAYING SO is what
        # keeps the refusal from becoming the next invisible failure.
        out.append("[arm-kb skip] %s not renderable (empty buttons/text)"
                   % arm_id)
        if not dry_run:
            _ch2_log_line(["CH2_KB", sid if sid is not None else "?", marker,
                           "arm=%s" % arm_id,
                           "SKIPPED-unrenderable (no keyboard would render)"])
        _status("unrenderable")
        return False

    # `row=True`: this arm IS a row's set keyboard -> the code-posted rail,
    # whose own per-row state replaces the ledger below (a repeat of the same
    # keyboard is a no-op, a changed one edits the row's message in place).
    if row:
        verdict = post_row_keyboard(arm_id, payload, dry_run, out,
                                    db_path=db_path, delay=delay,
                                    prefix=prefix, channel=marker)
        if verdict == "scheduled":
            _status("scheduled")
            return True
        if verdict in ("already", "not_owed"):
            _status("refused_duplicate")
            return False

    # CONSOLIDATION G3 (2026-09-02, D20/D24): ONE affordance, ONE delivery.
    # MEASURED: arm af8371ab was pushed TWICE on 2026-09-02 -- 07:14:15 and
    # 07:14:46, both `arm-rung-next`, both new messages, identical text and
    # identical buttons. Two rung logs 31s apart each resolved next_ladder_seq
    # to the same working set and each delivered its keyboard. Two LIVE
    # keyboards for one set is not a cosmetic duplicate: whichever the owner
    # taps second lands on a set that is already written, and that is how a set
    # they never performed (30kg x 13, RIR 0) got recorded (D24) -- the first
    # data-damaging button defect in this batch.
    # The owner's ruling of 2026-08-22 is the rule being enforced: a timer/button
    # UI updates the message that already exists, in place, instead of sending a
    # new one. A repeat is an IN-PLACE update, which is the bridge's job on the
    # message that already exists -- never a second push from here. So the second
    # delivery is REFUSED, out loud, rather than being sent.
    if not step_affordance.claim_delivery(
            sid if sid is not None else "?", arm_id, channel=marker,
            dry_run=dry_run):
        msg = ("%s arm=%s channel=%s -- already delivered once; a repeat would "
               "be a NEW message where the rule is an in-place update (%s)"
               % (step_affordance.G3, arm_id, marker, step_affordance.G4))
        out.append("[arm-kb refused] " + msg)
        if not dry_run:
            _ch2_log_line(["CH2_KB", sid if sid is not None else "?", marker,
                           "arm=%s" % arm_id, "REFUSED-duplicate"])
            print("AFFORDANCE_REFUSED\t%s" % msg)
        _status("refused_duplicate")
        return False
    text = idrill_marker_text(arm_id)
    if prefix:
        text = "%s\n%s" % (prefix, text)
    spawn_followup_push(
        ARM_KB_PUSH_DELAY_SEC if delay is None else delay,
        text, dry_run, out, sid=sid, marker=marker)
    _status("scheduled")
    return True


def deliver_or_mark(arm_id, payload, dry_run, out, sid=None,
                    marker="arm-keyboard", delay=None, prefix=None,
                    status=None, row=False, db_path=None):
    """ONE ARM, ONE VISIBLE KEYBOARD (owner live 2026-09-11 06:36/06:37).

    The same buttons reached the owner TWICE for one arm: once as the code
    push (deliver_arm_keyboard), once as the bridge's render of the
    `[[IDRILL:...]]` marker the model echoed off this stdout. The two rails
    were belt-and-suspenders from the 3-of-40 marker-echo era; with the code
    push live they are a duplicator, and a duplicate keyboard is data-damaging
    (D24: a tap on the stale twin recorded a set never performed).

    So the rails are now EXCLUSIVE, decided here, at the only seam both pass
    through:
      * delivery scheduled            -> `KEYBOARD_DELIVERED` receipt on
        stdout, NO marker. set-add re-surfaces the receipt so the model knows
        the keyboard is already on screen and echoes nothing.
      * delivery refused (duplicate)  -> same receipt (status=already_on_screen)
        and NO marker -- the owner already has these buttons.
      * no delivery possible (unrenderable / any other miss) -> the marker
        rail, exactly as before this function existed.

    Returns True iff a keyboard is on screen or on its way (either rail).
    `status` (optional list) receives deliver_arm_keyboard's reason token, so
    a caller can tell "scheduled now" (its prefix went out) from the rest."""
    kb_status = [] if status is None else status
    delivered = deliver_arm_keyboard(arm_id, payload, dry_run, out, sid=sid,
                                     marker=marker, delay=delay, prefix=prefix,
                                     status=kb_status, row=row,
                                     db_path=db_path)
    if delivered:
        print("KEYBOARD_DELIVERED\t%s\tchannel=%s\tstatus=scheduled"
              % (arm_id, marker))
        return True
    if "refused_duplicate" in kb_status:
        print("KEYBOARD_DELIVERED\t%s\tchannel=%s\tstatus=already_on_screen"
              % (arm_id, marker))
        return True
    return bool(emit_idrill_marker(arm_id, dry_run, out, payload=payload))


def spawn_followup_push(sleep_sec, text, dry_run, out, sid=None,
                        marker="followup-push"):
    """Detached follow-up push: ONE `push.sh --text <text>`.

    `text` may carry a bare `[[IDRILL:<arm_id>]]` line -- push.sh renders the
    arm's declared keyboard from it through the SHARED artifact contract
    (DGN-966), so this carries a full multi-button/drilldown keyboard, not the
    single `--button` of the DGN-835 era. A marker-only body = one message.

    DETACHED (start_new_session=True) exactly like spawn(): the caller must
    never wait on a push.

    The small delay keeps the owner-visible ORDER sane: this message must land
    just AFTER the caller's own reply, never race ahead of it.

    Best-effort in every branch -- a lost follow-up costs the keyboard, never
    the logged set (the set is already committed when this runs)."""
    if dry_run:
        out.append("[followup-push +%ds] %s" % (int(sleep_sec), text))
        return
    _sid = sid if sid is not None else "?"
    # A1-KEYBOARD: push.sh's keyboard verdict is captured here too -- this rail
    # carries MARKER-ONLY bodies, i.e. pushes whose entire owner-visible payload
    # IS the keyboard. A swallowed failure on this rail is a message that never
    # existed, not merely a message that lost its buttons.
    cmd = 'sleep %d; %s; %s' % (
        int(sleep_sec), _push_run_cmd(text, _sid, marker),
        _ch2_log_cmd(_sid, marker, 0))
    try:
        _ch2_log_line(["CH2_INTENT", _sid,
                       marker, "delay=%ds" % int(sleep_sec),
                       "text=" + str(text).replace("\n", " | ")[:120]])
        subprocess.Popen(
            ["bash", "-c", cmd],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, start_new_session=True,
        )
    except Exception:  # noqa: BLE001 -- never break an already-logged set
        pass


# MACHINE ASK BY CODE (2026-10-03). exercise-enter's MACHINE_ASK / MACHINE_OPTION
# lines are stdout for a model; on the inline-button rail (set-add's transition
# auto-enter) no model turn runs and the question never reached the owner
# (files/session-render.md, step 2). This delivers the SAME question
# (machine_capture.ask_spec wording and options) as the owner's keyboard, by
# code, once: the arm id is deterministic per (session, exercise) and
# deliver_arm_keyboard's ledger refuses a second push. With arming off (no
# keyboard carrier) the question goes out as plain text, once, on its own
# ledger channel. Lands BEFORE the entry keyboard (arm-entry, +5s): it is
# spawned first, with a shorter delay.
MACHINE_ASK_PUSH_DELAY_SEC = 3


def run_machine_ask(argv):
    """`set-arm machine-ask <session_id> <exercise> [--db] [--dry-run]`.

    stdout, one receipt line the caller relays instead of the ask:
      MACHINE_ASK delivered=yes by=code channel=keyboard|plain arm=<id> ...
      MACHINE_ASK delivered=already arm=<id> ...   (ledger: on screen)
      MACHINE_ASK delivered=no reason=<why>        (caller keeps the old lines)
    Never writes the DB."""
    p = argparse.ArgumentParser(prog="set-arm machine-ask")
    p.add_argument("session_id", type=int)
    p.add_argument("exercise_name")
    p.add_argument("--db", default=DEFAULT_DB)
    p.add_argument("--dry-run", action="store_true")
    args = p.parse_args(argv)
    out = []
    db_abs = os.path.abspath(args.db)
    try:
        if SCRIPT_DIR not in sys.path:
            sys.path.insert(0, SCRIPT_DIR)
        import machine_capture as _mc
        spec = _mc.ask_spec(db_abs, args.session_id, args.exercise_name)
        payload = _mc.ask_arm_payload(spec, args.session_id,
                                      args.exercise_name, db_abs)
    except Exception as e:  # noqa: BLE001 -- the caller keeps the model lines
        print("MACHINE_ASK delivered=no reason=error:%s"
              % type(e).__name__)
        return 0
    photo = bool(spec and spec.get("kind") == "photo")
    if payload is None and not photo:
        print("MACHINE_ASK delivered=no reason=nothing_to_ask")
        return 0
    arm_id = _mc.ask_arm_id(args.session_id, args.exercise_name)
    tail = ("-- the machine question is on the owner's screen; do NOT ask "
            "it again. A typed name after the other-machine button registers "
            "via the MACHINE_OTHER cmd.")
    if dgn918_enabled() and not photo:
        write_callback_file(arm_id, payload, args.dry_run, out)
        status = []
        deliver_arm_keyboard(arm_id, payload, args.dry_run, out,
                             sid=args.session_id, marker="machine-ask",
                             delay=MACHINE_ASK_PUSH_DELAY_SEC, status=status)
        if "scheduled" in status:
            print("MACHINE_ASK delivered=yes by=code channel=keyboard arm=%s "
                  "exercise=%s %s" % (arm_id, args.exercise_name, tail))
        elif "refused_duplicate" in status:
            print("MACHINE_ASK delivered=already arm=%s exercise=%s %s"
                  % (arm_id, args.exercise_name, tail))
        else:
            print("MACHINE_ASK delivered=no reason=%s"
                  % (status[0] if status else "unknown"))
    else:
        # No keyboard carrier -- or (item 5) nothing to pick from: the
        # question as plain text, once. A photo ask carries no buttons.
        if step_affordance.claim_delivery(args.session_id, arm_id,
                                          channel="machine-ask-plain",
                                          dry_run=args.dry_run):
            spawn_followup_push(MACHINE_ASK_PUSH_DELAY_SEC, spec["ask"],
                                args.dry_run, out, sid=args.session_id,
                                marker="machine-ask")
            print("MACHINE_ASK delivered=yes by=code channel=plain arm=%s "
                  "exercise=%s kind=%s %s"
                  % (arm_id, args.exercise_name,
                     "photo" if photo else "pick", tail))
        else:
            print("MACHINE_ASK delivered=already arm=%s exercise=%s %s"
                  % (arm_id, args.exercise_name, tail))
    for line in out:
        print(line, file=sys.stderr)
    return 0


def run_reps_entry(argv):
    """REPS-FIRST arm entry point (`set-arm reps-entry <session_id> <exercise>
    <seq>`). Builds the SAME contract-v3.1 arm file as the post-log path and
    emits `[[IDRILL:<arm_id>]]` -- WITHOUT writing the DB first. This is the root
    fix for the live incident: previously the idrill keyboard could only be armed
    as a POST-set-add side-effect (needing reps to already exist), so every
    working set's FIRST set fell back to the slow prose "몇 개 하셨어요?" model
    roundtrip. Now working-set ENTRY (exercise-enter) arms the reps->RIR keyboard
    at turn-0; the set is logged only when the callback fires cmd/cmd_skip2.

    LIVE-SAFETY: gated behind DGN918_FLAG exactly like the post-log arm. Flag
    absent -> emit NOTHING (no arm file, no marker), so behavior stays identical
    and no raw marker can leak. Never writes the DB. Best-effort throughout."""
    p = argparse.ArgumentParser(
        prog="set-arm reps-entry",
        description="Reps-first idrill arm (pre-log, DGN-918).")
    p.add_argument("session_id", type=int)
    p.add_argument("exercise_name")
    p.add_argument("set_seq", type=int, nargs="?", default=None,
                   help="set to arm. OMIT to resolve the ladder position "
                        "automatically (warm-up rungs first, then working "
                        "sets -- see next_ladder_seq)")
    p.add_argument("--db", default=DEFAULT_DB)
    p.add_argument("--program", default=DEFAULT_PROGRAM)
    p.add_argument("--dry-run", action="store_true")
    args = p.parse_args(argv)

    out = []
    if not dgn918_enabled():
        # Flag off: byte-identical to today's no-op. Nothing armed, no marker.
        for line in out:
            print(line)
        return 0

    rx = load_rx_calc()
    from free_session import effective_path
    prog_abs = effective_path(os.path.abspath(args.program), os.path.abspath(args.db), args.session_id)
    db_abs = os.path.abspath(args.db)
    # Resolve slot for hold-class + rest-grounds basis (same read set-arm's
    # main() uses). Failure degrades to a working set with no rest fold.
    _rest_sec, _sets, slot, rest_basis = resolve_slot(
        rx, prog_abs, db_abs, args.session_id, args.exercise_name)
    hold_class = is_hold_class(slot, db_abs, rx)
    # Honor a persisted F19/F21 override so the reps window / recorded weight
    # match the displayed set-table (the arm's cmd bakes in weight/reps).
    override = read_override(args.session_id, args.exercise_name)

    # RUNG-AWARE SEQ (2026-08-21). With no explicit set_seq the entry point
    # resolves the WHOLE ladder position -- warm-up rungs first, working sets
    # after (next_ladder_seq). This is what makes ENTERING an exercise arm the
    # bw primer instead of working set 1. An explicit seq still wins (tests,
    # re-arms).
    set_seq = args.set_seq
    # THE EXPLICIT-SEQ HOLE (2026-09-11). The 2026-08-27 gate below runs on the
    # RESOLVED path only, and the reasoning was sound for the callers that
    # existed: an explicit seq meant a re-arm, a correction or a
    # test -- callers that already know which set they want.
    #
    # The MODEL is also a caller. SKILL.md tells it to run set-arm, and
    # `set-arm reps-entry <sid> <ex> 1` walks straight past the gate and arms
    # working set 1 while the mat prep is still open -- the exact thing F14
    # forbids, through the one door the gate does not watch.
    #
    # NARROWED TO THE FIRST WORKING SET, deliberately. The band this closes is
    # `set_seq >= 1 AND this exercise has no working row yet`, which is F14's
    # own wording (「set_seq==1 게이트는 첫 워킹세트에서만 발화」). A rung/prep
    # seq (<= 0) is not a working-slot arm and F14 does not gate it. A re-arm or
    # a correction of set 2/3 is NOT blocked: by then a working set exists, so
    # this branch is not entered and a mid-session fix can never be refused by
    # a prep drill someone skipped an hour ago.
    if set_seq is not None and set_seq >= 1:
        _explicit_working = [q for q in logged_seqs(db_abs, args.session_id,
                                                    args.exercise_name)
                             if q >= 1]
        if not _explicit_working:
            # D10/D16: the seq is EXPLICIT here, so hand it to the gate --
            # it is already known to be >= 1 (a first working set), which is
            # the phase that does owe the deferred primer. Same verdict as the
            # flat rule gave, now said rather than assumed.
            _eopen, _ewhy, _eplanned, _elogged = prep_lane_open(
                rx, prog_abs, db_abs, args.session_id, args.exercise_name,
                next_seq=set_seq)
            if not _eopen:
                print("IDRILL_ARM armed=no reason=%s prep_planned=%d "
                      "prep_logged=%d explicit_seq=%d"
                      % (_ewhy, _eplanned, _elogged, set_seq))
                emit_prep_tap(prep_next_tap(
                    rx, prog_abs, db_abs, args.session_id,
                    args.exercise_name), args.session_id, args.exercise_name,
                    args.dry_run, out, db_path=db_abs)
                for line in out:
                    print(line)
                return 0
            # THE RAMP GATE, on the same door. An explicit `1` is the model's
            # own argv, and it is the one that walks a cold owner into their
            # first working set when no load resolves -- the seq being explicit
            # says the caller knows WHICH set, not that a warm-up was decided
            # against. Same narrow band as the prep check above it (first
            # working set only), so a re-arm or a correction is never refused.
            _ropen, _rwhy, _rplan = ramp_lane_open(
                rx, prog_abs, db_abs, args.session_id, args.exercise_name,
                override)
            if _rwhy == RAMP_LANE_CALIBRATION:
                for line in emit_ramp_calibration_lines(
                        args.exercise_name,
                        _slot_display(rx, prog_abs, db_abs, args.session_id,
                                      args.exercise_name, override),
                        _rplan, session_id=args.session_id,
                        slot_num=_calibration_slot_num(
                            rx, prog_abs, db_abs, args.session_id,
                            args.exercise_name, override),
                        db_path=db_abs):
                    print(line)
                for line in out:
                    print(line)
                return 0
            if not _ropen:
                print("IDRILL_ARM armed=no reason=%s explicit_seq=%d"
                      % (_rwhy, set_seq))
                for line in emit_ramp_blocked_lines(
                        args.exercise_name,
                        _slot_display(rx, prog_abs, db_abs, args.session_id,
                                      args.exercise_name, override),
                        _rplan):
                    print(line)
                for line in out:
                    print(line)
                return 0
            # OPEN, but with no ladder. The lane stays open -- that is correct,
            # these are real answers -- and the answer is now SAID instead of
            # implied by an absent block. See emit_ramp_absent_lines.
            for line in emit_ramp_absent_lines(
                    args.exercise_name,
                    _slot_display(rx, prog_abs, db_abs, args.session_id,
                                  args.exercise_name, override),
                    _rplan):
                print(line)
    if set_seq is None:
        # THE PREP GATE (2026-08-27) -- on the RESOLVED path only. An explicit
        # seq is a caller that already knows which set it wants (a re-arm, a
        # correction, a test); this gate is about the LADDER
        # RESOLVER opening the ramp/working lane while the mat work is still
        # unfinished. See prep_lane_open for the measured defect.
        # (2026-09-11: an explicit FIRST working seq is now gated too, just
        # above -- the model reaches this CLI directly and that door was open.)
        #
        # `IDRILL_ARM armed=no` is an ALREADY-LIVE path, byte-for-byte what this
        # entry point emits whenever the DGN918 flag is off -- so the worst case
        # is "no rep keyboard on turn 0", a state the surface already handles.
        #
        # D10/D16: the ladder position is resolved FIRST and handed to the
        # gate, because which drills are due depends on what is about to be
        # armed (a rung needs the entry drills; a working set needs the
        # deferred primer too). next_ladder_seq is a pure resolver -- it reads
        # logged_seqs and the planned ramp ladder and writes nothing -- so
        # moving it above the gate cannot have a side effect, and nothing is
        # ARMED until the gate has said yes.
        _resolved_seq = next_ladder_seq(rx, prog_abs, db_abs, args.session_id,
                                        args.exercise_name, override)
        _open, _why, _planned, _logged = prep_lane_open(
            rx, prog_abs, db_abs, args.session_id, args.exercise_name,
            next_seq=_resolved_seq)
        if not _open:
            print("IDRILL_ARM armed=no reason=%s prep_planned=%d prep_logged=%d"
                  % (_why, _planned, _logged))
            # ...and say what the owner SHOULD be tapping instead. The gate on
            # its own left the turn with nothing tappable at all.
            emit_prep_tap(prep_next_tap(
                rx, prog_abs, db_abs, args.session_id,
                args.exercise_name), args.session_id, args.exercise_name,
                args.dry_run, out, db_path=db_abs)
            for line in out:
                print(line)
            return 0
        # THE RAMP GATE (2026-09-11) -- the resolved path's half. next_ladder_seq
        # answers "1" for BOTH "the ladder is spent" and "there is no ladder
        # because no load resolves", and only the second one is a defect. Ask
        # BEFORE the walk, so the walk's answer is never mistaken for a decision
        # nobody made.
        _ropen, _rwhy, _rplan = ramp_lane_open(
            rx, prog_abs, db_abs, args.session_id, args.exercise_name,
            override)
        if _rwhy == RAMP_LANE_CALIBRATION:
            for line in emit_ramp_calibration_lines(
                    args.exercise_name,
                    _slot_display(rx, prog_abs, db_abs, args.session_id,
                                  args.exercise_name, override),
                    _rplan, session_id=args.session_id,
                    slot_num=_calibration_slot_num(
                        rx, prog_abs, db_abs, args.session_id,
                        args.exercise_name, override),
                    db_path=db_abs):
                print(line)
            for line in out:
                print(line)
            return 0
        if not _ropen:
            print("IDRILL_ARM armed=no reason=%s" % _rwhy)
            for line in emit_ramp_blocked_lines(
                    args.exercise_name,
                    _slot_display(rx, prog_abs, db_abs, args.session_id,
                                  args.exercise_name, override),
                    _rplan):
                print(line)
            for line in out:
                print(line)
            return 0
        # OPEN with no ladder -> say WHY there is no warm-up (2026-09-11).
        for line in emit_ramp_absent_lines(
                args.exercise_name,
                _slot_display(rx, prog_abs, db_abs, args.session_id,
                              args.exercise_name, override),
                _rplan):
            print(line)
        set_seq = _resolved_seq

    arm_id = compute_arm_id(args.session_id, args.exercise_name, set_seq)
    slot_num, weight, target_reps = resolve_current_arm_data(
        rx, prog_abs, db_abs, args.session_id, args.exercise_name, override,
        set_seq=set_seq)
    rung_label = rung_label_for_seq(set_seq) if not hold_class else None
    if rung_label is not None and target_reps is None:
        # A rung seq we cannot resolve to a PLANNED rung. Arming it would mean
        # guessing its load/reps -- and the only guess available is the WORKING
        # prescription, which is precisely incident 1. Arm nothing.
        print("IDRILL_ARM armed=no reason=unresolved_rung seq=%s" % set_seq)
        for line in out:
            print(line)
        return 0
    payload = build_idrill_payload(
        args.session_id, args.exercise_name, set_seq, slot_num, weight,
        target_reps, hold_class, rest_basis, _rest_sec,
        correct=False, rung_label=rung_label,   # PRE-log arm: never --correct
        db_path=db_abs, alt_weight=fallback_weight(override, weight))
    write_callback_file(arm_id, payload, args.dry_run, out)
    # CONSOLIDATION G2 (2026-09-02, defect D of the isolated-run review): the
    # payload is PASSED here too, so `reps-entry` cannot emit a dead marker.
    #
    # THIS IS THE exercise-enter HALF OF THE GATE, and it is closed HERE rather
    # than in exercise-enter, because exercise-enter does not mint an arm: its
    # arm_reps_first() shells out to THIS subcommand and RELAYS whatever bare
    # `[[IDRILL:...]]` line appears on this stdout. So the marker it published
    # for arm e5152d5a -- empty step_buttons["1"], which both bridge render
    # rails drop -- was this call's marker, forwarded. Refusing it at the source
    # closes both publishers with one gate and leaves exercise-enter untouched:
    # it finds no marker, prints its existing `IDRILL_ARM armed=no` audit line,
    # and the refusal reason reaches the operator on stderr, which
    # arm_reps_first already relays verbatim.
    # A1-KEYBOARD (2026-08-25): DELIVER the entry keyboard by CODE. Only push a
    # keyboard that can actually render: an empty step-1 window with an empty
