# ---------------------------------------------------------------------------
# #39-B PER-SET PLATE CUE (owner live 2026-08-21)
# ---------------------------------------------------------------------------
# Owner ruling: plate breakdown does not belong in the set table -- it is
# delivered per set, as part of that set's own cue.
# The set table used to carry a static [원판] block listing EVERY rung at once;
# they had to scan it and re-find their line, and by the time they stepped up to the
# bar they were no longer looking at the table. So the plate math now rides the
# set-START push -- the deterministic carrier that already fires at exactly the
# moment the set begins, for THE ONE weight being cued.
#
# WHY the push and not a model-narrated cue: doctrine D2 -- anything that MUST
# happen needs a deterministic carrier. A prompt-only "tell them the plates" rule
# is the same shape as every hold/timer rule that has already failed live. This
# arrives with no model turn at all.
#
# The math is NOT reimplemented here: both this cue and set-table's per-rung
# plate_note read ax_engine.plate_breakdown, and both gate on the SAME predicate
# ax_engine.is_plate_loaded (compound + freeweight = bar + plates). A machine /
# stack / dumbbell lift therefore emits NOTHING -- no bar exists to load, and a
# '바 20kg + 양쪽 N kg' line for a pin setting would be nonsense.
#
# WHEN IT FIRES -- corrected 2026-08-21 (owner, live). The block above used to
# say "every set-start push", and that was a MISREADING of the directive. The
# owner ruling: a plate cue is announced only when the load CHANGES, and only
# by the delta. A plate cue is an INSTRUCTION TO MOVE PLATES, not a status
# readout: between two sets at the same load there is nothing to do, so the
# line is noise, and repeating it across four equal-load working sets trains
# the user to ignore it. The
# rule as implemented:
#   * FIRST cued set of an exercise  -> the ABSOLUTE loading (nothing to diff
#     against, and they do have to build the bar).
#   * weight CHANGED since the last cued set -> the DELTA only, phrased as the
#     action ("양쪽에 2.5kg씩 더" / "양쪽에서 2.5kg씩 빼기").
#   * weight UNCHANGED -> NOTHING AT ALL (no line, no placeholder).
# The delta is per-SIDE and is the same arithmetic plate_breakdown does -- it
# reports per_side = (total - bar) / 2, and the bar term cancels in a difference,
# so the per-side delta is (new - old) / 2 with no plate decomposition invented
# here. It is deliberately expressed in KILOGRAMS PER SIDE and not in plate
# COUNTS ("2.5 하나씩"): counting plates needs a decomposition of the delta into
# the gym's actual plate inventory, which is exactly the plate math this file is
# forbidden to reimplement, and a wrong count is worse than an honest kg.
# The "last cued weight" is remembered per (session, exercise) in PLATE_CUE_DIR
# -- best-effort, so a lost marker degrades to printing the absolute loading
# once (today's behavior), never to a wrong delta.
_AX_ENGINE = None

PLATE_CUE_FMT = "[원판] %s"   # [원판] 바 20kg + 양쪽 55kg (ONE line, mid-workout)
PLATE_CUE_ADD_FMT = "[원판] 양쪽에 %skg씩 더"      # 양쪽에 Nkg씩 더
PLATE_CUE_DROP_FMT = "[원판] 양쪽에서 %skg씩 빼기"  # 양쪽에서 Nkg씩 빼기
PLATE_CUE_DIR = os.path.join(STATE_DIR, ".plate-cue")
PLATE_CUE_EPS = 1e-6          # kg tolerance: float noise is not a weight change

# PLATE-LOADED MACHINES (owner ruling 2026-10-03). The same carrier, the same
# change-only rule, but no bar: the first cued set says what goes on (one side,
# or the whole load), a change says the difference in the SAME unit, an
# unchanged load says nothing. Gate: ax_engine.plate_machine_loading
# (ax_machine.loading_method = plate_loaded). Copy lives in the i18n bundle
# (health.plate.machine.<loading>.<form>); a bundle miss means no line, never
# an English or empty placeholder. The barbell path above is untouched.
PLATE_CUE_MACHINE_KEY = "health.plate.machine.%s.%s"   # loading, first|add|drop


# PACK/LIVE PATH SEAM (pack-local shim) -- the SAME two-candidate probe
# set-table and set-add carry, verbatim, and for the same reason. The engine
# file has ONE canonical owner (pack_health, PROJECTION-ENGINE SEAM cutover
# 2026-08-25) but two landing spots, because the cutover moved the file without
# moving the callers:
#   pack layout   service/health/ax_engine.py   <- SIBLING of this script
#   live layout   database/ax_engine.py         <- pre-cutover kit_life install
# This file used to hardcode the LIVE path alone (PROJECT_ROOT/database). On an
# INSTALLED pack that file cannot exist -- the pack ships the engine to
# service/health/ and capabilities.db_lane=false forbids it from writing
# database/ at all -- so load_ax_engine() raised on every call and the four
