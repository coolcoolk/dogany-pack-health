def build_rest_grounds_fold(rest_basis, rest_sec):
    """SPEC §5.11: the rest-time grounds fold -- WHY the rest is what it is
    (DGN-388 factor sum). The headline still shows only the result.

    rest_basis is the rx-calc tag from resolve_slot. Only the 'factored:...' form
    carries a decomposable breakdown; a 'slot_override' or missing/unparseable
    basis degrades to a GENERAL derivation note (no invented numbers).

    Returns None when there are no grounds to show -- 2026-09-11: this used to
    fall back to the RIR explanation in that case (there was always SOMETHING
    to fold), but that explanation is retired (see the removal note above
    REST_GROUNDS_FOLD_SUMMARY and ui_labels.DEFAULT_LABELS["rir"]), so an arm
    with nothing left to say attaches no fold at all rather than an empty one.
    BEST-EFFORT: any parse failure also returns None, so a fold miss never
    breaks the logged set."""
    try:
        grounds = _rest_grounds_line(rest_basis, rest_sec)
    except Exception:  # noqa: BLE001 -- a fold-text miss must never break arming
        grounds = None
    if not grounds:
        return None
    return {"summary": REST_GROUNDS_FOLD_SUMMARY, "body": grounds}


def _rest_grounds_line(rest_basis, rest_sec):
    """Return the Korean rest-grounds text for the fold, or None when the basis
    is not a decomposable 'factored:' tag. Pure string derivation; no I/O."""
    tag = str(rest_basis or "")
    if not tag.startswith("factored:"):
        # slot_override / unknown: no numeric breakdown to show. Give a general
        # note of HOW rest is derived (SPEC §5.11 fallback branch) rather than an
        # arbitrary raw number with no grounds.
        if rest_sec:
            return ("휴식 %d초는 임의값이 아니라 종목 특성으로 산출됩니다: "
                    "동작 종류(복합/단관절) 기본값에 강도·피로 보정을 더해 "
                    "15초 단위로 정리한 값입니다." % int(rest_sec))
        return None
    # factored:<class>+<intensity>+<fatigue>=<rest>
    body = tag[len("factored:"):]
    factors, _, _rest = body.partition("=")
    parts = factors.split("+")
    if len(parts) != 3:
        return None
    cls, intensity, fatigue = parts
    base_ko = _REST_BASE_KO.get(cls)
    int_ko = _REST_INTENSITY_KO.get(intensity)
    fat_ko = _REST_FATIGUE_KO.get(fatigue)
    if not (base_ko and int_ko and fat_ko):
        return None
    base_label, base_val = base_ko
    int_label, int_val = int_ko
    fat_label, fat_val = fat_ko
    total = int(rest_sec) if rest_sec else (base_val + int_val + fat_val)
    # SPEC 5.9: the internal ticket id "(DGN-388)" was leaking into the owner's
    # fold body. Ticket ids stay in the code comments, never in owner text.
    return ("휴식 %d초 산출근거: %s %d + %s %s + %s %s = %d초 "
            "(15초 단위 반올림)." % (
                total, base_label, base_val,
                int_label, _fmt_delta(int_val),
                fat_label, _fmt_delta(fat_val),
                total))

