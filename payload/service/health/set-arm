def count_logged_working(db_path, session_id, exercise_name, planned):
    """How many of the planned working seats 1..planned hold a logged row, or
    None when the DB cannot be read (caller keeps its old judgment)."""
    try:
        conn = sqlite3.connect(db_path)
        try:
            row = conn.execute(
                "SELECT COUNT(DISTINCT set_seq) FROM workout_sets WHERE "
                "session_id = ? AND exercise_name = ? AND set_seq >= 1 "
                "AND set_seq <= ?",
