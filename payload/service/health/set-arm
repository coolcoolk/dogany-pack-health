def rung_label_for_seq(set_seq):
    """set_seq -> the set-table rung LABEL ('bw' for 0, 'rN' for -N), or None
    for a working set. This is the SAME mapping set-table renders a logged rung
    with (`"bw" if seq == 0 else "r%d" % (-seq)`), so an arm and the table can
    never disagree about which rung a row is."""
