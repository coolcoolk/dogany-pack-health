def is_probe_lift(db_path, session_id, exercise_name):
    """True while this lift's working weight is an estimate (no working set
    in any other session) and no working set is logged this session."""
    try:
        st = set_table()
        if st.calibration_state(db_path, exercise_name,
                                session_id) != st.CAL_ESTIMATE:
            return False
        return not any(s >= 1 for s in logged_seqs(db_path, session_id,
                                                   exercise_name))
    except Exception:  # noqa: BLE001
        return False


def probe_decision(rx, program_path, db_path, session_id, exercise_name,
                   set_seq, slot, override):
    """The item-2 decision after rung `set_seq` lands, or None.
    Returns ("calibrated", new_kg, info) / ("probe", rung_kg, info)."""
    if set_seq > 0 or set_seq <= -100 or not slot:
        return None
    # live batch 3 item 3: a first set the code classified as a calibration
    # rung already re-prescribed the working weight (set-add, live_load);
    # the ladder is closed, so no further probe rung is added.
    if _ladder_closed(session_id, exercise_name):
        return None
    if not is_probe_lift(db_path, session_id, exercise_name):
        return None
    conn = _db_connect(db_path)
    try:
        row = conn.execute(
            "SELECT weight_kg, reps, rir FROM workout_sets WHERE session_id=? "
            "AND exercise_name=? AND set_seq=?",
            (session_id, exercise_name, set_seq)).fetchone()
    finally:
        conn.close()
    if not row or row[0] is None or row[1] is None:
        return None
    w, reps, rir = float(row[0]), int(row[1]), row[2]
    info = {"w": w, "reps": reps, "rir": rir}
    try:
        lattice, _src = rx.resolve_lattice(slot, db_path, session_id)
    except Exception:  # noqa: BLE001
        lattice = slot.get("lattice")
    informative = (rir is not None and int(rir) <= PROBE_RIR_MAX
                   and reps <= PROBE_REPS_MAX)
    if informative:
        if (override or {}).get("by") == OV_BY_OWNER and \
                (override or {}).get("weight_kg") is not None:
            return None                      # owner named the load: keep it
        import e1rm_rx
        rr = slot.get("rep_range") or [reps]
        band = _rir_band(arm_target_rir(rx, program_path, db_path, session_id,
                                        exercise_name, None, override)) \
            or (1.0, 2.0)
        e1rm, _b = e1rm_rx.set_e1rm(w, reps, float(rir))
        raw = e1rm_rx.backsolve_load(e1rm, int(rr[-1]),
                                     (band[0] + band[1]) / 2.0)
        new = _snap_down(rx, raw, lattice)
        if new is None:
            return None
        # owner 2026-10-10: never below a warm-up already lifted today
        try:
            if SCRIPT_DIR not in sys.path:
                sys.path.insert(0, SCRIPT_DIR)
            import live_load as _ll
            new = _ll.above_rungs(rx, slot, db_path, session_id,
                                  exercise_name, new)
        except Exception:  # noqa: BLE001 -- the floor never costs the probe
            pass
        info["e1rm"] = round(e1rm, 1)
        return ("calibrated", new, info)
    if rir is None and reps <= PROBE_REPS_MAX:
        return None                          # no RIR, modest reps: unknown
    _slot, est, _r = resolve_current_arm_data(
        rx, program_path, db_path, session_id, exercise_name, override)
    if est is None:
        return None
    nxt = next_ladder_seq(rx, program_path, db_path, session_id,
                          exercise_name, override)
    if nxt is None or nxt < 1:
        return None                          # planned rungs still ahead
    # The next probe: the settable load nearest the midpoint between this
    # rung and the estimate, strictly between the two (never the working load).
    est = float(est)
    mid = (w + est) / 2.0
    try:
        pts = rx._lattice_points(lattice)
        if not pts:
            g = rx._lattice_step(lattice) or (0.0, 2.5)
            base, step = float(g[0]), float(g[1])
            pts = [base + k * step for k in range(0, int(est / step) + 2)]
    except Exception:  # noqa: BLE001
        pts = [2.5 * k for k in range(0, int(est / 2.5) + 2)]
    cands = [p for p in pts if w + 1e-9 < p < est - 1e-9]
    if not cands:
        return None
    new = min(cands, key=lambda p: (abs(p - mid), -p))
    return ("probe", float(new), info)


def probe_say(display, kind, kg, info):
    rir = "" if info.get("rir") is None else " (RIR %s)" % (
        "4+" if int(info["rir"]) >= 4 else info["rir"])
    head = _copy("health.live.probe_head", name=display,
                 kg=_fmt_load_kg(info["w"]), reps=info["reps"], rir=rir)
    if kind == "calibrated":
        return _copy("health.live.probe_calibrated", head=head,
                     e1rm=_fmt_load_kg(info.get("e1rm")),
                     kg=_fmt_load_kg(kg))
    return _copy("health.live.probe_more", head=head, kg=_fmt_load_kg(kg))


def fmt_rest_mmss(sec):
    """Rest seconds as m:ss (165 -> '2:45')."""
    try:
        sec = max(int(sec), 0)
    except (TypeError, ValueError):
        return None
    return "%d:%02d" % (sec // 60, sec % 60)


def next_set_lines(meta, rest_sec, db_path=None):
    """live batch 2 item 8: the two-line, blockquoted next-set line
    (owner format, 2026-10-08): line 1 names the lift after the marker and
    the next-set label; line 2 is kg x reps (RIR ..) and the rest as m:ss.

    Built from derive_next_spec's resolved `meta` (display / weight_kg / reps /
    rir). A weight-free set drops the kg, a set with no target RIR drops the
    clause, and no rest drops the rest. [] when there is no lift to name."""
    meta = meta or {}
    display = meta.get("display") or meta.get("name")
    if not display:
        return []
    parts = []
    wt = _fmt_weight(meta.get("weight_kg"))
    reps = meta.get("reps")
    reps = "" if reps is None else str(reps)
    if wt and reps:
        parts.append("%s \u00d7 %s" % (wt, reps))
    elif wt:
        parts.append(wt)
    elif reps:
        parts.append(_copy("health.live.next_set.reps", reps=reps))
    rir = _rir_ko(_fmt_rir(meta.get("rir")), db_path)
    if rir and parts:
        parts[-1] = "%s (%s)" % (parts[-1], rir)
    elif rir:
        parts.append("(%s)" % rir)
    rest = fmt_rest_mmss(rest_sec) if rest_sec else None
    if rest:
        parts.append(_copy("health.live.next_set.rest", rest=rest))
    lines = [_copy("health.live.next_set.head", name=display)]
    if parts:
        lines.append("> " + " \u00b7 ".join(parts))
    return lines


def derive_next_spec(rx, program_path, db_path, session_id, exercise_name,
                     set_seq, transition, override=None, meta=None):
    """Compute the next-step prescription spec deterministically. Returns a
    tuple (has_next, spec):
      * CONTINUATION (transition False): next = SAME exercise, next working set
        -> spec = its target weight/reps/RIR. (has_next True, spec text)
      * TRANSITION (transition True): next = the FOLLOWING slot in THIS
        session's day order -> spec = that exercise's display + its NEXT LADDER
        STEP. When that slot still owes a warm-up rung the spec is THAT RUNG
        (weight/reps/RIR read straight off the ladder SoT -- see the H15 note in
        the body); once the ladder is spent, or the slot plans no ramp at all,
        it is the first working-set target. (has_next True, spec text)
      * SESSION END (transition True and no following slot) -> (False, None):
        caller suppresses the set-start push (like --no-next) and emits NONE.
    Any failure -> (None, None) so the caller degrades to the model --next /
    generic line (arming never breaks the logged set).

    F19/F21: `override` (a dict of display/weight_kg/reps/rir, any subset) is
    the owner's mid-session target change for the CURRENT exercise. It is
    overlaid ONLY on the CONTINUATION branch (same exercise, next set) -- a
    TRANSITION targets the NEXT exercise, to which this exercise's override does
    not apply. A None/absent field keeps the rx-calc/program derivation (partial
    override -- e.g. F21 supplies weight only).

    #39-B: `meta` is an optional caller-supplied dict filled IN PLACE with the
    resolved target of the cued set -- {"name", "display", "weight_kg"}. The spec
    is a rendered STRING, so a consumer that needs the NUMBERS (the per-set plate
    cue) would otherwise have to re-parse Korean prose or redo the whole day/rx
    resolution. Purely additive: the return shape is unchanged and every existing
    call site that passes no `meta` is byte-identical."""
    try:
        program = rx.load_yaml(program_path)
        days = program.get("days") or {}

        # Resolve THIS session's day the same way find_slot does (session
        # session_type_id -> code, else first day containing the exercise) --
        # now literally the same function, find_day_code.
        day_code = find_day_code(program, db_path, session_id, exercise_name)
        if day_code is None:
            return None, None

        def slots_of(code):
            return (days.get(code) or {}).get("exercises") or []

        slots = slots_of(day_code)
        cur_idx = None
        for i, ex in enumerate(slots):
            if ex.get("name") == exercise_name:
                cur_idx = i
                break
        if cur_idx is None:
            return None, None

        if transition:
            # Next slot in the day's order; none -> session end.
            if cur_idx + 1 >= len(slots):
                return False, None
            target_slot = slots[cur_idx + 1]
        else:
            # Continuation: the SAME exercise, next working set.
            target_slot = slots[cur_idx]

        target_name = target_slot.get("name")
        display = target_slot.get("display") or target_name

        # Weight + target RIR come from TODAY's rx-calc prescription (RC1, the
        # same single source set-table uses), NOT the stale program.yaml
        # snapshot. exclude_session_id = this open session so rx never reads its
        # own partial sets. Any rx failure -> weight/RIR fall back to None
        # (weight-free / RIR-less), name+reps still render.
        # rotation_day_override = day_code (2026-08-23): target_slot came out of
        # day_code's slot list, so the prescription has to be asked for THAT day
        # or a makeup session's next-step spec quotes no weight at all.
        weight_kg = None
        target_rir = None
        rx_reps = None
        try:
            today = _session_today(db_path, session_id)
            result = rx.calc_rx(program_path, today, db_path,
                                exclude_session_id=session_id,
                                rotation_day_override=day_code)
            for ex in (result.get("exercises") or []):
                if ex.get("name") == target_name:
                    weight_kg = ex.get("weight_kg")
                    target_rir = ex.get("target_rir")
                    rx_reps = ex.get("target_reps")
                    break
        except SystemExit:
            pass
        except Exception:
            pass

        rep_range = target_slot.get("rep_range")
        reps = _fmt_reps(rep_range)
        # 2026-09-30: rx-calc's rep target moved with today's load; it wins
        # over the static range top (None -> the old rule, byte-identical).
        if isinstance(rx_reps, int) and not isinstance(rx_reps, bool):
            reps = str(rx_reps)

        # H15 (2026-08-24 -- moving to the next exercise skipped the ramp):
        # the transition branch above resolves the incoming slot's WORKING
        # prescription and stopped there, so entering an exercise that plans a
        # warm-up ladder announced working set 1 -- the ramp was never offered.
        # Live evidence, .ch2-push.log:289: the pushed next step carried the
        # incoming exercise's WORKING RIR where a ramp rung (RIR 4+) was due.
        #
        # WHICH step is next is a LADDER question for the incoming exercise
        # exactly as it is for the current one, so it is asked of the same
        # resolver the current exercise uses (due_rung -> next_ladder_seq +
        # resolve_ramp_ladder -> set-table.planned_ramp_rows +
        # ax_engine.ramp_taper_reps + RAMP_RIR). NOTHING about a ramp is decided
        # here: this block only substitutes the due rung's already-resolved
        # numbers for the working ones. A second ramp planner in this file is
        # the failure mode the ladder helpers were extracted to prevent.
        #
        # No ramp planned (chin-up, isolation, unknown weight) or the ladder is
        # already logged -> due_rung returns None and the working-set spec below
        # stands byte-identical to before.
        #
        # On a TRANSITION `override` is deliberately NOT passed: it is the
        # owner's target change for the CURRENT exercise (see the F19/F21 note
        # below), and the ladder being resolved there belongs to the NEXT one.
        #
        # D6 (2026-08-25 -- the plate cue must fire when the weight goes UP,
        # not as an absolute stack): the SAME question has to be asked on the
        # CONTINUATION branch. H15 fixed it one branch over and stopped there,
        # so entering an exercise offered its ladder while WALKING that ladder
        # did not: rung -> rung resolved the exercise's WORKING set every time.
        # Two consequences, both measured on session 10092 (deadlift rungs
        # 20/60/100 logged 06:41-06:47, working sets 140 from 06:52):
        #   * the step announced after a rung was the working set, not the next
        #     rung -- the ladder had no voice of its own mid-exercise;
        #   * `meta` therefore carried the WORKING weight while a rung was being
        #     cued, so the plate cue below never wrote a rung into the
        #     `.plate-cue` ledger. An empty ledger makes every first working set
        #     a "first cue", which is exactly the absolute loading the owner
        #     rejected: 06:52:39 `[원판] 바 20kg + 양쪽 60kg`, seconds after they
        #     had ramped that same bar 20 -> 60 -> 100 themselves.
        # Gated on `set_seq <= 0` (the completed set was itself a rung). A
        # continuation OUT OF a working set can never owe a rung -- next_ladder_
        # seq returns MAX(working)+1 there -- so the gate costs a working-set arm
        # nothing, in latency or in behaviour, and keeps this to the one case it
        # is for. `override` IS passed here: this ladder belongs to the current
        # exercise, so the owner's weight change is exactly what it must be
        # planned against.
        # Coerced rather than compared raw: an unexpected `set_seq` type would
        # otherwise raise inside this function's blanket try and degrade the
        # WHOLE spec to None -- i.e. a rung gate would take the next-step cue
        # down with it. Unparseable -> not a rung -> the pre-D6 path.
        try:
            _completed_seq = int(set_seq)
        except (TypeError, ValueError):
            _completed_seq = 1
        rung = None
        if transition:
            rung = due_rung(rx, program_path, db_path, session_id, target_name)
        elif _completed_seq <= 0:
            rung = due_rung(rx, program_path, db_path, session_id, target_name,
                            override)
        if rung is not None:
            weight_kg = rung.get("weight_kg")
            reps = rung.get("reps")
            target_rir = rung.get("rir")

        # F19/F21: overlay the owner's target override on the CONTINUATION spec
        # (same exercise). reps/rir here are already the rendered strings; the
        # override supplies raw values, so normalize before the overlay. A
        # transition ignores the override (targets a different exercise).
        # D6: when a RUNG is due the overlay is limited to the display name --
        # due_rung was already given the override, so the ladder it returned is
        # planned against the owner's new working weight. Re-applying the
        # override's weight on top would put the WORKING load on a warm-up rung,
        # which is the one number a warm-up must not carry.
        if override and not transition and rung is not None:
            display = override.get("display") or display
            spec = _spec_line_parts(display, weight_kg, reps, target_rir,
                                    db_path)
        elif override and not transition:
            disp2, wt2, reps2, rir2 = _apply_override(
                (display, weight_kg, reps, target_rir), override)
            display = disp2
            weight_kg = wt2
            reps = reps2
            target_rir = rir2
            spec = _spec_line_parts(display, weight_kg, reps, target_rir,
                                    db_path)
        elif rung is not None:
            # Rung reps are an already-resolved count (the taper), not a slot
            # rep_range, so the spec renders through the -parts variant -- the
            # same one the in-exercise rung hint uses, which keeps a transition
            # rung and a mid-exercise rung one shape.
            spec = _spec_line_parts(display, weight_kg, reps, target_rir,
                                    db_path)
        else:
            spec = _spec_line_parts(display, weight_kg, reps, target_rir,
                                    db_path)
        if spec is None:
            return None, None
        # #39-B: hand the resolved target back to the caller (see `meta` above).
        # Filled AFTER the override overlay so it carries the weight actually
        # being cued, not the pre-override rx value.
        if meta is not None:
            meta["name"] = target_name
            meta["display"] = display
            meta["weight_kg"] = weight_kg
            # live batch 2 item 8: the next-set line is code-emitted from these
            # resolved parts (never re-parsed out of the spec string).
            meta["reps"] = reps
            meta["rir"] = target_rir
            # program.yaml lattice.type: 'standard' = bar+plate grid, 'even' =
            # fixed dumbbells, 'stack' = pin. The plate gate needs it to keep a
            # dumbbell press out of the plate cue (see ax_engine.is_plate_loaded).
            _lat = target_slot.get("lattice")
            meta["lattice_type"] = (_lat or {}).get("type") \
                if isinstance(_lat, dict) else None
            # D6: when the cued step is a ramp RUNG, hand over the planner's own
            # per-side delta (and the weight it was measured from) so the plate
            # cue can PRINT set-table's number instead of deriving a second one.
            # Both None for a working set: a working set is not a ladder rung,
            # so no planned delta exists and the cue's own arithmetic stands.
            meta["plate_delta"] = (rung or {}).get("plate_delta")
            meta["plate_prev_kg"] = (rung or {}).get("plate_prev_kg")
            # The slot's `loading` (per_side | total): what the number means on
            # a plate-loaded machine (plate_machine_cue_line).
            meta["loading"] = target_slot.get("loading")
        return True, spec
    except Exception:
        return None, None


def water_due(now):
    """True if >= WATER_INTERVAL_SEC since the last water reminder (or never)."""
    try:
        with open(WATER_STATE) as fh:
            last = float(fh.read().strip())
    except (OSError, ValueError):
        return True
    return (now - last) >= WATER_INTERVAL_SEC


def mark_water(now):
    try:
        with open(WATER_STATE, "w") as fh:
            fh.write("%d" % int(now))
    except OSError:
        pass


def _override_path(session_id, exercise_name):
    """Per-(session, exercise) override file path. exercise_name is sanitized to
    a safe filename token (mirrors set-add/set-table PUBLISHED_DIR convention)."""
    import re
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", str(exercise_name or ""))
    return os.path.join(OVERRIDE_DIR, "%s.%s.json" % (session_id, safe))


def write_override(session_id, exercise_name, ov):
    """F19/F21: persist the owner's target override for this (session, exercise)
    so BOTH this script's push spec AND set-table's grid read back the NEW target
    deterministically. ov keys (all optional): display, weight_kg, reps, rir --
    a None value CLEARS that field back to the rx-calc/program derivation, so a
    partial override (e.g. weight-only for F21) leaves the rest derived. Written
    atomically (tmp + rename) so a concurrent set-table read never sees a partial
    file. Best-effort: any failure is swallowed (the derived spec still arms)."""
    try:
        os.makedirs(OVERRIDE_DIR, exist_ok=True)
        path = _override_path(session_id, exercise_name)
        tmp = path + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(ov, fh)
        os.rename(tmp, path)
    except Exception:  # noqa: BLE001 -- override persist must never break a set
        pass


def read_override(session_id, exercise_name):
    """Read back the persisted override for this (session, exercise), or {} when
    none / on any error. Shared read contract with set-table (identical path +
    key convention)."""
    try:
        with open(_override_path(session_id, exercise_name)) as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


# ---------------------------------------------------------------------------
# P2 (2026-08-24): WARG OWNS THE PROGRESSION DECISION. THE ENGINE IS AN INPUT.
#
# Owner directive: load-progression ownership belongs to the agent, not the engine.
#
# THE INCIDENT. Session 10091, tricep_pushdown_rope. rx-calc's verdict for the
# day was `hold` @ 26.25kg. The model wrote `--ov-weight 25.0` and the persisted
# artifact was, in full:
#
#     {"weight_kg": 25.0}
#
# No reason, no engine baseline, no author. Every owner-facing surface then
# served 25kg as if it were the prescription. When the owner later challenged
# the number, the model (a) cited the engine's `hold` as its cover -- the same
# engine it had just overridden -- and (b) handed the call back: "25kg 유지냐
# 26.25kg 복귀냐 고르시면 돼요."
#
# Three failures, one root: an override IS a judgement, and the artifact carried
# no trace that a judgement had been made. Nothing to cite, nothing to defend --
# so the model reached for the engine, and then for the owner.
#
# WHAT THIS CODE ENFORCES (all three, structurally -- not by asking the model to
# remember):
#   1. DIVERGENCE CARRIES A REASON. An override that differs from the engine's
#      resolved weight is stamped with `reason` / `engine_weight_kg` /
#      `engine_verdict` / `decision`, and set-arm emits LOAD_DECISION_SAY -- one
#      owner-facing sentence, code-authored, for the model to relay verbatim.
#      A reason is never optional: unstated, the code writes one.
#   2. UNSURE => THE LOWER SIDE, DECIDED HERE. An override toward the HARDER
#      side with no stated reason is not served. The gate clamps to the engine
#      weight and says so. "Unsure" is not a feeling the model reports -- it is
#      the measurable absence of a stated reason for going up.
#   3. NO LOB-BACK. Every path returns a served weight AND a sentence. There is
#      no branch that asks the owner to choose, and none that blocks the set.
#      Reversal stays one word away, which is not the same thing as a menu.
#
# The owner's own instruction is NOT an agent judgement and is never clamped:
# --ov-by owner passes through, stamped as their.
# ---------------------------------------------------------------------------

OV_BY_COACH = "coach"   # the agent's own call (the default -- deciding IS its job)
OV_BY_OWNER = "owner"   # the owner named this number themselves
OV_BY = (OV_BY_COACH, OV_BY_OWNER)

# kg comparison tolerance. Lattices step at 1.25kg, so anything under this is
# float noise, never a decision.
LOAD_EPS = 0.001

# Engine verdict -> the word the owner reads. The raw token never ships.
VERDICT_KO = {
    "up": "증량",
    "hold": "유지",
    "deload": "감량",
    "none": "판정 없음",
    "calibration": "측정 중",
    "e1rm": "기록 기반",
}

# Code-authored reasons. These exist so that "no reason given" can never reach
# the owner as silence -- the honest sentence is that we chose conservatively.
REASON_CLAMPED = "근거가 서지 않아 낮은 쪽으로 정했습니다"
REASON_EASIER = "기록보다 보수적으로 갑니다"
REASON_OWNER = "직접 지정하신 무게입니다"

# The reversal clause. NOT a choice menu -- the decision is already made and
# stated; this only says it is reversible. See SKILL.md "증량 결정 오너십".
LOAD_REVERSAL_CLAUSE = "다르게 가고 싶으시면 말씀만 주세요"


def _is_harder(engine_kg, ov_kg, assisted):
    """Is `ov_kg` the HARDER side of `engine_kg` for this slot?

    ASSISTED slots (assisted pull-up / chin-up machines) carry the COUNTERWEIGHT
    in weight_kg, so LESS weight = harder. Getting this backwards would clamp
    the wrong direction and call a de-load a raise, so the inversion lives here,
    once, right next to the comparison it governs."""
    if assisted:
        return ov_kg < engine_kg - LOAD_EPS
    return ov_kg > engine_kg + LOAD_EPS


def gate_weight_override(engine_kg, ov_kg, assisted=False, reason=None,
                         by=OV_BY_COACH, engine_verdict=None,
                         engine_source="rx"):
    """THE progression decision point. Pure function -- no I/O, no globals.

    Takes the engine's resolved weight for this slot and the weight the agent (or the
    owner) wants served; returns the weight that WILL be served plus the full
    record of how that was decided.

    Returns a dict:
        served_kg      float|None -- the weight every surface will show
        asked_kg       float|None -- what the caller asked for
        engine_kg      float|None -- the engine's resolved weight (the INPUT)
        engine_verdict str|None   -- up / hold / deload / none / calibration
        engine_source  str        -- rx | last_logged | none
        by             str        -- coach | owner
        diverged       bool       -- the served weight differs from the engine's
        direction      str|None   -- harder | easier
        decision       str        -- engine | diverged | clamped | owner
        reason         str|None   -- ALWAYS set when diverged or clamped
        reason_source  str|None   -- stated | code

    Decision table:
        by=owner                      -> serve as asked            (owner)
        no ask                        -> serve the engine          (engine)
        no engine baseline            -> serve as asked            (engine)
        ask == engine                 -> serve the engine          (engine)
        harder + stated reason        -> serve as asked            (diverged)
        harder + NO stated reason     -> serve the ENGINE          (clamped)
        easier (reason or not)        -> serve as asked            (diverged)

    Note the asymmetry -- it is the point. Going UP without being able to say
    why is the failure this exists for, so it is the one that does not get
    served. Going DOWN is already the lower side, so it is served; it still gets
    a sentence, because an unexplained cut is exactly how the owner ended up
    asking "8회인데왜 증량해?" about a number nobody had ever justified."""
    stated = (reason or "").strip() or None
    rec = {
        "served_kg": engine_kg,
        "asked_kg": ov_kg,
        "engine_kg": engine_kg,
        "engine_verdict": engine_verdict,
        "engine_source": engine_source,
        "by": by if by in OV_BY else OV_BY_COACH,
        "diverged": False,
        "direction": None,
        "decision": "engine",
        "reason": None,
        "reason_source": None,
    }

    if ov_kg is None:
        return rec

    if rec["by"] == OV_BY_OWNER:
        # The owner naming a weight is not the agent overriding the engine; it is the
        # owner training. Serve it, record whose call it was, never clamp it.
        rec.update(served_kg=ov_kg, decision="owner",
                   diverged=(engine_kg is None
                             or abs(ov_kg - engine_kg) > LOAD_EPS),
                   reason=stated or REASON_OWNER,
                   reason_source="stated" if stated else "code")
        if rec["diverged"] and engine_kg is not None:
            rec["direction"] = ("harder" if _is_harder(engine_kg, ov_kg,
                                                       assisted) else "easier")
        return rec

    if engine_kg is None:
        # Nothing to diverge FROM (calibration slot / unresolvable rx). There is
        # no lower side to fall back to, so serve the ask -- but keep any stated
        # reason on the record.
        rec.update(served_kg=ov_kg, reason=stated,
                   reason_source="stated" if stated else None)
        return rec

    if abs(ov_kg - engine_kg) <= LOAD_EPS:
        rec.update(served_kg=engine_kg, reason=stated,
                   reason_source="stated" if stated else None)
        return rec

    harder = _is_harder(engine_kg, ov_kg, assisted)
    rec["direction"] = "harder" if harder else "easier"

    if harder and not stated:
        # UNSURE => LOWER SIDE, decided right here. Not an error, not a prompt:
        # a decision, served, with the sentence that explains it.
        rec.update(served_kg=engine_kg, decision="clamped", diverged=False,
                   reason=REASON_CLAMPED, reason_source="code")
        return rec

    rec.update(served_kg=ov_kg, decision="diverged", diverged=True,
               reason=stated or REASON_EASIER,
               reason_source="stated" if stated else "code")
    return rec


def _fmt_load_kg(v):
    """kg verbatim -- SKILL '무게 소수점 verbatim' (26.25kg stays 26.25kg)."""
    if v is None:
        return "-"
    return ("%.2f" % float(v)).rstrip("0").rstrip(".")


def _ko_topic(word):
    """Korean topic particle for `word`: 은 after a final consonant, 는 after a
    vowel. The sentence below is read by the owner, so '푸시다운는' is a defect
    like any other -- it is the tell that a machine wrote the line."""
    for ch in reversed(word or ""):
        code = ord(ch)
        if 0xAC00 <= code <= 0xD7A3:            # Hangul syllable block
            return "은" if (code - 0xAC00) % 28 else "는"
        if ch.isalnum():
            break
    return "는"


def load_decision_say(rec, display=None):
    """The ONE owner-facing sentence for a load decision, authored HERE so the
    model relays it instead of composing one. Returns None when nothing was
    decided against the engine (ordinary prescription -- say nothing extra).

    Shape, in every branch: STATE the served weight -> ONE line of why ->
    reversal is one word away. There is deliberately no branch that renders a
    choice, because the banned utterance ("25kg 유지냐 26.25kg 복귀냐 고르시면
    돼요") is a SHAPE, and the way to keep a shape out of the product is to own
    no code that can produce it."""
    if not rec or rec.get("decision") == "engine":
        return None
    name = display or "이 종목"
    served = _fmt_load_kg(rec.get("served_kg"))
    engine = _fmt_load_kg(rec.get("engine_kg"))
    verdict = VERDICT_KO.get(rec.get("engine_verdict") or "")
    reason = rec.get("reason") or REASON_EASIER
    dec = rec.get("decision")

    topic = _ko_topic(name)

    if dec == "clamped":
        return ("오늘 %s%s %skg으로 갑니다 -- %skg도 봤지만 %s. %s."
                % (name, topic, served, _fmt_load_kg(rec.get("asked_kg")),
                   reason, LOAD_REVERSAL_CLAUSE))
    if dec == "owner":
        # owner 2026-10-10 13:05: the owner named the number -- the line says
        # so in plain words. The model's --ov-reason ("owner stayed at 150")
        # and the engine verdict are internal; neither reaches the owner.
        return _copy("health.load.owner_say", name=name, topic=topic,
                     kg=served) or None
    # diverged: the agent's call, stated against the record's number. No
    # engine / verdict wording; a reason that is not owner-language prose
    # (an English --ov-reason) is replaced by the code's own.
    if not owner_prose(rec.get("reason")):
        reason = _copy("health.load.reason_easier") or REASON_EASIER
    head = (_copy("health.load.record_head", kg=engine)
            if rec.get("engine_kg") is not None
            else _copy("health.load.no_record_head"))
    return ("오늘 %s%s %skg으로 갑니다 -- %s %s. %s."
            % (name, topic, served, head, reason, LOAD_REVERSAL_CLAUSE))


def owner_prose(text):
    """True when `text` reads as owner-language prose: it carries Hangul and
    no run of Latin words (owner 2026-10-10 13:05, "owner stayed at 150
    (엔진 판정은 판정 없음 150kg)" reached the owner). Unit tokens such as
    kg / RIR / x are allowed."""
    if not text or not re.search(u"[\uac00-\ud7a3]", text):
        return False
    words = [w for w in re.findall(r"[A-Za-z]{2,}", text)
             if w.lower() not in ("kg", "rir", "rpe", "cm", "bpm")]
    return len(words) == 0


def _last_logged_working_load(db_path, exercise_name, exclude_session_id=None):
    """(weight_kg, date) of the most recent WORKING set (set_seq >= 1) the owner
    actually lifted for this exercise, or (None, None).

    The DATE rides along because a weight quoted back to the owner without one
    is unauditable: "지난 기록 무게 70kg" is a claim they can check, "70kg" on
    its own is a number they have to trust. Every provenance line built on this
    reader carries both.

    `exclude_session_id` drops THIS session's own rows, mirroring the
    `exclude_session_id` calc_rx already takes: an in-progress session is being
    written as it is read, and a basis that included it would quote today's
    first working set back as "last time's"."""
    try:
        sql = ("SELECT s.weight_kg, w.date FROM workout_sets s "
               "JOIN workouts w ON w.id = s.session_id "
               "WHERE s.exercise_name = ? AND s.set_seq >= 1 "
               "  AND s.weight_kg IS NOT NULL ")
        params = [exercise_name]
        if exclude_session_id is not None:
            sql += "  AND s.session_id != ? "
            params.append(int(exclude_session_id))
        sql += "ORDER BY w.date DESC, s.set_seq DESC LIMIT 1"
        conn = _db_connect(db_path)
        try:
            row = conn.execute(sql, tuple(params)).fetchone()
        finally:
            conn.close()
        if not row or row[0] is None:
            return None, None
        return float(row[0]), (str(row[1]) if row[1] else None)
    except Exception:  # noqa: BLE001 -- a baseline miss must never break a set
        return None, None


def _last_logged_working_weight(db_path, exercise_name):
    """The most recent WORKING-set (set_seq >= 1) weight the owner actually
    lifted for this exercise, or None.

    Only ever used as the conservative fallback baseline when rx-calc cannot
    answer. Deliberately the LAST LIFTED weight rather than program.yaml's slot
    weight: the slot weight is only the owner's starting seed (nothing writes
    it back; program state step A), so it drifts from reality as soon as
    anything is lifted, and a baseline off reality would wave a real raise
    through as "no divergence"."""
    return _last_logged_working_load(db_path, exercise_name)[0]


def engine_load_baseline(rx, program_path, db_path, session_id, exercise_name,
                         day_code=None):
    """The engine's INPUT to the load decision: (weight_kg, verdict, assisted,
    source) for this exercise in THIS session's split.

    Runs the same call rx-calc makes for the prescription itself (calc_rx with
    this session excluded and the rotation day pinned), so the baseline the gate
    compares against IS the number the 표 would otherwise have shown. Falls back
    to the last logged working weight, then to (None, ...). Best-effort
    throughout -- an unresolvable baseline degrades the gate to pass-through,
    never to a blocked set."""
    weight = verdict = None
    assisted = False
    try:
        program = rx.load_yaml(program_path)
        slot = find_slot(program, db_path, session_id, exercise_name)
        assisted = bool((slot or {}).get("assisted"))
        if day_code is None:
            day_code = find_day_code(program, db_path, session_id,
                                     exercise_name)
    except Exception:  # noqa: BLE001
        pass
    try:
        today = _session_today(db_path, session_id)
        result = rx.calc_rx(program_path, today, db_path,
                            exclude_session_id=session_id,
                            rotation_day_override=day_code)
        for ex in (result.get("exercises") or []):
            if ex.get("name") == exercise_name:
                weight = ex.get("weight_kg")
                verdict = ex.get("progression_applied")
                break
    except SystemExit:
        pass
    except Exception:  # noqa: BLE001
        pass
    if weight is not None:
        return float(weight), verdict, assisted, "rx"
    fallback = _last_logged_working_weight(db_path, exercise_name)
    if fallback is not None:
        return fallback, verdict, assisted, "last_logged"
    return None, verdict, assisted, "none"


def bump_arm_gen(session_id):
    """F21 orphan cancel: advance this session's arm generation token and return
    the NEW value. Every arm calls this once; spawned pushes are stamped with the
    returned value and self-suppress if the file later holds a higher value (a
    re-arm superseded them). Best-effort: on any failure return 0 (degrades to
    no-fencing -- the push still fires, worst case an un-cancelled stale push,
    which is the pre-fix behavior, never a lost set)."""
    try:
        os.makedirs(ARM_GEN_DIR, exist_ok=True)
        path = os.path.join(ARM_GEN_DIR, "%s" % session_id)
        cur = 0
        try:
            with open(path) as fh:
                cur = int(fh.read().strip() or 0)
        except (OSError, ValueError):
            cur = 0
        nxt = cur + 1
        tmp = path + ".tmp"
        with open(tmp, "w") as fh:
            fh.write("%d" % nxt)
        os.rename(tmp, path)
        return nxt
    except Exception:  # noqa: BLE001
        return 0


def _apply_override(spec_parts, ov):
    """Overlay the override onto the derived (display, weight_kg, reps, rir)
    tuple. Only keys PRESENT in ov (and not None) replace the derived value; a
    missing/None key keeps the derivation (partial override, e.g. F21 weight-
    only). Returns a new (display, weight_kg, reps, rir) tuple."""
    display, weight_kg, reps, rir = spec_parts
    if ov.get("display") is not None:
        display = ov["display"]
    if "weight_kg" in ov and ov["weight_kg"] is not None:
        weight_kg = ov["weight_kg"]
    if ov.get("reps") is not None:
        reps = ov["reps"]
    if ov.get("rir") is not None:
        rir = ov["rir"]
    return display, weight_kg, reps, rir


# SPEC 5.10 (2026-08-20 -- tips were firing far too often) -- CANNED TIP COPY RETIRED.
# The #36 behavior was: DEFAULT-ON coaching tip on every continuation
# working-set rest with room (>=60s), drawn from a hardcoded 4-line
# DEFAULT_TIPS bank keyed off a seed. Because the bank had no basis in the
# actual set, the owner got a "첫 렙 폼이 세트 전체를 좌우" setup tip on their
# SECOND working set -- canned text fired at a moment it could not possibly
# describe. Combined with the water line on the 60s marker, every single rest
# turned into a sermon.
# The copy itself is now DELETED (not just gated off): DEFAULT_TIPS and
# TIP_MIN_REST_SEC are gone, so there is no canned bank left to regress to.
# Tips remain FRONT-LINE (5.12: tips are NOT folded) -- they just have to be
# EARNED: only a model-supplied --tip, i.e. a real observed form issue or a
# point the owner just raised, ever rides a marker.


def resolve_default_tip(tip, transition, hold_class, rest_sec, seed):
    """Tip resolution -- MODEL-DRIVEN ONLY (5.10 fix, 2026-08-20: tips were
    firing far too often). A coaching tip rides a rest marker ONLY when the model
    passes an explicit --tip (a REAL detected form issue / context). There is NO
    default-on canned tip: the old #36 behavior fired a hardcoded canned line on
    EVERY continuation working-set rest regardless of context, so a 2nd working
    set got a "첫 렙 폼..." setup tip that had no basis -- pure noise. That copy
    bank is now deleted outright, not merely bypassed.
    Now: model --tip wins (front-line, shown as-is); no --tip -> None (bare
    marker, no invented coaching). `transition`/`hold_class`/`rest_sec`/`seed`
    are kept in the signature for call-site stability but no longer gate a canned
    default (there is none). Never raises."""
    if tip:
        return tip  # model tip (real form point) always wins -- front-line.
    return None     # 5.10: no canned default-on tip. Silence beats noise.


def pick_water_line(seed):
    """#35: choose a natural full-sentence water line, VARIED across sets. Picked
    deterministically from `seed` (e.g. set_seq) so it rotates without repeating
    the same fragment, and stays stable within one arm. Never raises."""
    try:
        idx = int(seed) % len(WATER_LINES)
    except (TypeError, ValueError):
        idx = 0
    return WATER_LINES[idx]


def build_marker_text(remaining, is_water, tip, tip60, water_line=None):
    """Compose one before-marker body line following the SKILL.md tag/dash rule:
    bare tag alone unless a tip rides, in which case `<tag> — <parts>`.

    #35: the water line is a natural full sentence (WATER_LINES), NOT the old
    telegraphic "물 한 모금" fragment. `water_line` is the pre-picked (varied)
    line; absent, fall back to WATER_LINES[0] so the SoT never emits a fragment."""
    tag = "⏱ %d초 전" % remaining          # ⏱ N초 전
    parts = []
    if remaining == 60:
        if is_water:
            parts.append(water_line or WATER_LINES[0])
        if tip60:
            parts.append(tip60)
    if remaining == 30 and tip:
        parts.append(tip)
    if parts:
        return "%s — %s" % (tag, ", ".join(parts))  # tag — parts
    return tag


def _ch2_log_line(fields):
    """#42 observability: append ONE tab-delimited line to CH2_LOG. Best-effort:
    any failure is swallowed so logging never blocks/delays a channel-2 push.
    `fields` is a list of strings already free of tabs/newlines (caller strips).
    Format: <iso-ts>\t<event>\t<sid>\t<marker>\t<detail...>."""
    try:
        ts = time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime())
        line = ts + "\t" + "\t".join(str(f).replace("\t", " ").replace("\n", " ")
                                     for f in fields) + "\n"
        with open(CH2_LOG, "a") as fh:
            fh.write(line)
    except Exception:                  # noqa: BLE001 -- never break the push
        pass


def _ch2_log_cmd(sid, marker, gen):
    """Build the OUTCOME log snippet run INSIDE the detached shell AFTER push.sh:
    record whether the channel-2 push actually sent (exit 0 = SENT, else FAILED
    with the exit code). A gen-suppressed push logs SUPPRESSED (never reached
    push.sh). Pure shell append (no dependency on this parent process). Log
    write is best-effort (`|| true`) so it never affects the push path."""
    label = "%s sid=%s%s" % (marker, sid,
                             ("" if not gen else " gen=%d" % gen))
    # $rc is set by the caller right after push.sh runs.
    return (
        'ts=$(date +%%Y-%%m-%%dT%%H:%%M:%%S); '
        'if [ "$rc" = "0" ]; then st=SENT; else st="FAILED rc=$rc"; fi; '
        'printf "%%s\\tCH2_OUT\\t%s\\t$st\\n" "$ts" >> %s 2>/dev/null || true'
    ) % (_sh_quote(label).strip("'").replace('%', '%%'), _sh_quote(CH2_LOG))


# A1-KEYBOARD: the strings push.sh ALREADY prints about the keyboard send. This
# side owns none of them -- routines/push.sh is a FRAMEWORK CANONICAL file
# (byte-compared against ~/dogany/dogany-agent/agents/.template/routines/push.sh
# by test-session-ux-5x 5.5c; a local patch to it was reverted on 2026-08-21 for
# exactly that reason). So the verdict is read out of push.sh's existing output
# rather than by adding a machine token to it. A cleaner `IDRILL_KB\t<verdict>`
# token belongs in the canonical and is proposed to the framework separately; until it
# lands, these are the grep targets, and they are matched on a SUBSTRING that
# does not depend on the Korean/English mix around them.
PUSH_KB_GREP = "idrill keyboard"      # matches both the OK and the WARN lines
PUSH_KB_GREP2 = "idrill render hop"   # the render-hop failure line


def _push_run_cmd(text, sid, marker):
    """A1-KEYBOARD (2026-08-25): run `push.sh --text <text>` inside the detached
    shell, set `$rc`, and -- the point of this helper -- SURFACE push.sh's
    keyboard verdict instead of dropping it.

    THE HOLE THIS CLOSES. push.sh sends the inline keyboard as its OWN second
    sendMessage and deliberately exits 0 when only that second send fails (the
    body is already delivered; a non-zero exit would make every caller re-send
    the whole body -- see push.sh's own note). Its only report is a line of
    output. But every channel-2 push is launched from spawn() with
    `stdout=DEVNULL, stderr=DEVNULL`, so that line went to /dev/null and the
    outcome log said SENT. A failed keyboard therefore produced EXACTLY the
    symptom the owner reports -- "text arrived, no buttons" -- with zero trace,
    indistinguishable from an arm that was never delivered at all.

    Both streams are captured (the failure warning goes to stderr, the success
    line to stdout) and any keyboard verdict is appended to CH2_LOG as a CH2_KB
    line, alongside the existing CH2_OUT body verdict. The two are deliberately
    separate: "body SENT + keyboard FAILED" is the live symptom, and one
    combined verdict cannot express it.

    Pure shell, no dependency on this parent process (it runs after detach).
    Every write is best-effort (`|| true`) -- observability must never cost a
    push."""
    label = "%s sid=%s" % (marker, sid)
    return (
        'kbe=$(mktemp /tmp/warg_push_out.XXXXXX 2>/dev/null || '
        'echo /tmp/warg_push_out.$$); '
        '%s --text %s > "$kbe" 2>&1; rc=$?; '
        'if [ -s "$kbe" ]; then '
        'kts=$(date +%%Y-%%m-%%dT%%H:%%M:%%S); '
        'grep -a -e %s -e %s "$kbe" 2>/dev/null | while IFS= read -r kl; do '
        'printf "%%s\\tCH2_KB\\t%s\\t%%s\\n" "$kts" "$kl" '
        '>> %s 2>/dev/null || true; done; '
        'fi; rm -f "$kbe"'
    ) % (_sh_quote(PUSH), _sh_quote(text),
         _sh_quote(PUSH_KB_GREP), _sh_quote(PUSH_KB_GREP2),
         _sh_quote(label).strip("'").replace('%', '%%'), _sh_quote(CH2_LOG))


def spawn(sleep_sec, text, dry_run, out, gen=0, gen_file=None,
          sid=None, marker="ch2"):
    # F21 orphan cancel: when a generation is armed, the spawned push re-reads
    # the session's arm-gen token AFTER its sleep and fires ONLY if its stamped
    # generation is still current -- a re-arm bumps the token, so any push
    # spawned by a superseded arm silently self-suppresses when it wakes. gen==0
    # / no gen_file -> unfenced (fires unconditionally, pre-fix behavior).
    # #42: every branch captures push.sh's exit code into $rc and appends a
    # CH2_OUT outcome line (SENT / FAILED / SUPPRESSED) so a silent drop is
    # diagnosable from the agent-side log rather than vanishing.
    out_log = _ch2_log_cmd(sid if sid is not None else "?", marker, gen)
    if gen and gen_file:
        # Guard reads the CURRENT token and only pushes when it equals MY gen.
        # Pure shell so the detached process needs nothing from this parent.
        # A MISSING token file -> suppress: a stamped push exists only after
        # bump_arm_gen wrote the file, so its absence means the session was
        # aborted / closed (session-abort and the close-out sweep remove it;
        # round-1 open item 2026-10-10: the missing counter let queued pushes
        # fire). An empty / unreadable token -> fire (fail-open).
        guard = (
            'if [ ! -e %s ]; then cur=gone; '
            'else cur=$(cat %s 2>/dev/null); [ -z "$cur" ] && cur=%d; fi; '
            'if [ "$cur" = "%d" ]; then %s; %s; '
            'else printf "%%s\\tCH2_OUT\\t%s sid=%s gen=%d\\tSUPPRESSED-gen\\n" '
            '"$(date +%%Y-%%m-%%dT%%H:%%M:%%S)" >> %s 2>/dev/null || true; fi'
        ) % (_sh_quote(gen_file), _sh_quote(gen_file), int(gen), int(gen),
             _push_run_cmd(text, sid if sid is not None else "?", marker),
             out_log,
             marker, (sid if sid is not None else "?"), int(gen),
             _sh_quote(CH2_LOG))
        cmd = 'sleep %d; %s' % (int(sleep_sec), guard)
    else:
        cmd = 'sleep %d; %s; %s' % (
            int(sleep_sec),
            _push_run_cmd(text, sid if sid is not None else "?", marker),
            out_log)
    if dry_run:
        tag = "" if not gen else " gen=%d" % gen
        out.append("[+%ds%s] %s" % (int(sleep_sec), tag, text))
        return
    # #42 INTENT: record the scheduled channel-2 push BEFORE detaching it, so an
    # intended-vs-sent diff is always possible even if the process never wakes.
    _ch2_log_line(["CH2_INTENT", sid if sid is not None else "?", marker,
                   "delay=%ds" % int(sleep_sec),
                   ("gen=%d" % gen if gen else "nogen"),
                   "text=" + str(text)[:80]])
    subprocess.Popen(
        ["bash", "-c", cmd],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, start_new_session=True,
    )


def _sh_quote(s):
    # Minimal, safe single-quote shell escaping (shlex.quote equivalent).
    return "'" + str(s).replace("'", "'\"'\"'") + "'"


def emit_countdown(designated_rest, dry_run, out,
                   label=COUNTDOWN_LABEL, cadence=COUNTDOWN_CADENCE_SEC,
                   done_button=True, blockquote=False):
    """CHANNEL 1: arm the live in-place countdown (DGN-594) by dropping a
    control file the bridge CountdownDriver picks up. ONE transient message,
    edited every `cadence` seconds to show remaining time + a draining bar,
    finalized by the driver on end. This coexists with the channel-2 milestone
    pushes below (one timer + the before/start alerts); editing is silent
    (no re-notify) while the milestone pushes stay separate notifying messages.

    F22/F15: `label`/`cadence` are parameterized so the SAME primitive serves a
    timed HOLD (isometric working set / prep drill / cool-down stretch) -- the
    hold path passes COUNTDOWN_HOLD_LABEL + a finer cadence. The control-file
    id stays "rest-<ms>" for ALL countdowns (rest and hold) so the stale-guard
    below -- which clears every rest-*.json -- cancels ANY prior live countdown
    regardless of kind (a fresh hold cancels a stale rest, and vice-versa;
    there is only ever ONE owner-facing countdown message at a time).

    The countdown runs for the DESIGNATED rest (what the owner sees), NOT the
    10s-corrected effective value -- the effective correction is a push-timing
    concern only (channel 2), whereas the countdown is a live display of true
    remaining rest. DRIFT is self-corrected inside the bridge primitive: it
    re-anchors each edit to the deadline and snaps to the cadence boundary, so
    edit latency shortens the next sleep instead of accumulating (spec DRIFT
    FIX -- owned by the bridge, consumed here as-is).

    Stale-guard: any prior countdown control file for THIS session is deleted
    first (a delete = cancel for the driver), so a fresh set never stacks a
    second live countdown on top of a still-running one. A new unique id is
    used per arming because the driver keys on file identity (a rewrite of an
    already-active id is a no-op).

    BEST-EFFORT: arming must never break the logged set, so every failure here
    is swallowed -- worst case the live countdown is missing, the channel-2
    pushes still fire. dry-run prints the intent instead of writing the file.
    """
    seconds = int(designated_rest or 0)
    if seconds <= 0:
        return
    if dry_run:
        out.append("[countdown] %s %d:%02d cadence=%ds%s"
                   % (label, seconds // 60, seconds % 60, cadence,
                      " format=blockquote" if blockquote else ""))
        return
    try:
        os.makedirs(COUNTDOWN_DIR, exist_ok=True)
        # Cancel any live countdown left over from a previous set/hold of this
        # session (delete = cancel). ALL countdown ids are prefixed "rest-"
        # (rest AND hold, F22/F15) so clearing every rest-*.json here cancels
        # any lingering countdown of either kind -- only one owner-facing
        # countdown ever runs. The driver runs the cleanup edit on the vanished
        # file.
        for name in os.listdir(COUNTDOWN_DIR):
            if name.startswith("rest-") and name.endswith(".json"):
                try:
                    os.remove(os.path.join(COUNTDOWN_DIR, name))
                except OSError:
                    pass
        cid = "rest-%d" % int(time.time() * 1000)
        # done_button (framework DGN-1174): whether the bridge attaches a
        # completion-affordance button to the finished countdown message.
        # Owner ruling 2026-08-22: ONLY time-holds get that button; a rep-based
        # working set's REST timer must not, because the set advances by being
        # logged, not by a tap -- and the bridge's tap handler is a no-op, so
        # the button reads as broken. The renderer cannot infer hold-vs-rest
        # (one shared primitive, F22/F15 above), so the ARMING side declares it.
        # Field is optional upstream and defaults true, so an older framework
        # that does not know it simply ignores it (no version dependency).
        spec = {"seconds": seconds, "label": label,
                "cadence": cadence, "done_button": bool(done_button)}
        # live batch 2 item 8 (owner 2026-10-08 07:18-07:19): the shrinking
        # rest countdown renders INSIDE a blockquote, on the first frame and on
        # every 5s edit. Declared in the control file the driver re-reads for
        # each edit (the same carrier as done_button), so no edit can drop it.
        # Optional field: a driver that does not know it ignores it.
        if blockquote:
            spec["format"] = COUNTDOWN_FORMAT_BLOCKQUOTE
        tmp = os.path.join(COUNTDOWN_DIR, cid + ".json.tmp")
        final = os.path.join(COUNTDOWN_DIR, cid + ".json")
        with open(tmp, "w") as fh:
            json.dump(spec, fh)
        os.rename(tmp, final)          # atomic publish (no partial-read tick)
    except Exception:                  # noqa: BLE001 -- never break the set
        pass


def hold_duration_from_range(spec):
    """F22/F15 range rule: a hold duration may be given as a single value
    ("30") or a RANGE ("20~30" / "20-30" / "20,30"). RULE = use the UPPER
    BOUND (the owner asked to be counted through the full hold, and the E14
    hold-class rep_range convention already keys on the range TOP -- see
    hold_seconds()). Returns a positive int seconds, or None on any miss.
    """
    if spec is None:
        return None
    s = str(spec).strip()
    if not s:
        return None
    # Split on any range separator; take the largest numeric token.
    tokens = re.split(r"[~\-,\s]+", s)
    vals = []
    for t in tokens:
        try:
            v = int(float(t))
        except (TypeError, ValueError):
            continue
        if v > 0:
            vals.append(v)
    return max(vals) if vals else None


def run_hold_countdown(argv):
    """F22/F15 standalone press-start HOLD countdown.

    Fires the SAME channel-1 countdown primitive (emit_countdown) used for the
    rest timer, for a timed hold of N seconds -- isometric/hold working set,
    prep drill, or cool-down stretch. Decoupled from set logging: the model
    invokes it the moment the owner taps 시작 (start). Replaces the old
    "완료되면 알려주세요" + button pattern for every timed hold.

    Usage:
        set-arm countdown <seconds|range> --trigger <start|ready|set_done>
            [--label TEXT] [--dry-run]

    <seconds|range>: "30" or a range "20~30" (upper bound is used, see
    hold_duration_from_range). --label overrides the default 홀드 label
    (e.g. a stretch name). Arming a new hold countdown cancels any prior live
    countdown (rest or hold) via emit_countdown's stale-guard -- no orphan.

    #22 INTENT GUARD: --trigger is REQUIRED and must be a real execution trigger
    (start / ready / set_done). A planning utterance ("~하자 / ~할게") is NOT a
    trigger -- there is no --trigger value for it, so a plan simply cannot arm a
    timer. Absent/invalid trigger -> the countdown is REFUSED (no control file),
    prints GUARD_BLOCKED, exit 3.
    """
    hp = argparse.ArgumentParser(
        prog="set-arm countdown",
        description="Press-start hold countdown (F22/F15).")
    hp.add_argument("seconds",
                    help="hold duration seconds, or a range e.g. 20~30")
    hp.add_argument("--trigger", default=None,
                    help="#22 REQUIRED execution trigger: start|ready|set_done "
                         "(a planning utterance is not a trigger)")
    hp.add_argument("--label", default=COUNTDOWN_HOLD_LABEL,
                    help="countdown label (default: 홀드)")
    hp.add_argument("--cadence", type=int, default=COUNTDOWN_HOLD_CADENCE_SEC,
                    help="edit cadence seconds (default: 5)")
    # CONSOLIDATION G1 (2026-09-02, D25): a bare countdown -- one with no
    # declared affordance to close it -- is now REFUSED. Every timed hold that
    # belongs to a SET must go through `set-arm hold-set`, which arms the timer
    # and its button together. This flag is the explicit, auditable opt-out for
    # the genuinely affordance-free timers that still exist (a cool-down
    # stretch the owner just lets run). It has to be TYPED, so "I forgot the
    # button" and "this timer deliberately has none" stop looking identical.
    hp.add_argument("--no-affordance", action="store_true",
                    help="G1 opt-out: this countdown deliberately has no "
                         "completion button (cool-down stretch etc.). Without "
                         "it, a bare countdown is refused -- use `hold-set`.")
    hp.add_argument("--dry-run", action="store_true")
    args = hp.parse_args(argv)

    # #22 INTENT GUARD (deterministic, before any duration/arming work): a hold
    # countdown fires ONLY on a real execution trigger. This is the arming
    # DECISION that emits the countdown -- NOT the renderer (bridge countdown.py
    # is framework-owned and untouched). A plan/declaration has no valid trigger, so
    # it is refused here regardless of what the model intended.
    trig = (args.trigger or "").strip().lower()
    if trig not in TIMER_EXEC_TRIGGERS:
        print("GUARD_BLOCKED reason=no_exec_trigger trigger=%s "
              "(a plan/declaration is not a start signal; a timer needs an "
              "explicit start/ready or a set completion)"
              % (trig or "none"), file=sys.stderr)
        print("GUARD_BLOCKED no_exec_trigger")
        return 3

    # CONSOLIDATION G1 (D25): refuse a timer that closes into nothing. This is
    # the gate, not an instruction -- workout-session/SKILL.md has forbidden a
    # buttonless hold timer in prose since 2026-08-17 and the 2026-09-02 session
    # still produced one, because a prose prohibition has no execution point.
    # Now the arming call itself fails.
    if not args.no_affordance:
        _d = step_affordance.Decision(
            step_affordance.KIND_HOLD, step_affordance.POS_CONTINUATION,
            True, 0, False, step_affordance.AT_NONE,
            step_affordance.ARM_NONE, None, "bare_countdown_no_affordance")
        try:
            step_affordance.gate_timer(_d)
        except step_affordance.AffordanceRefused as exc:
            print("AFFORDANCE_REFUSED\t%s\n"
                  "  use `set-arm hold-set <sid> <exercise> <seq> --seconds N "
                  "--trigger <t>` for a hold that belongs to a SET (it arms the "
                  "timer AND its completion button in one action), or pass "
                  "--no-affordance to declare that this timer deliberately has "
                  "none." % exc, file=sys.stderr)
            print("AFFORDANCE_REFUSED\t%s" % exc)
            return 4

    seconds = hold_duration_from_range(args.seconds)
    if not seconds or seconds <= 0:
        print("ERROR: could not resolve a positive hold duration from %r"
              % args.seconds, file=sys.stderr)
        return 2
    label = args.label.strip() or COUNTDOWN_HOLD_LABEL
    cadence = args.cadence if args.cadence and args.cadence > 0 \
        else COUNTDOWN_HOLD_CADENCE_SEC

    out = []
    emit_countdown(seconds, args.dry_run, out, label=label, cadence=cadence)
    if args.dry_run:
        print("DRY-RUN hold-countdown %ds label=%s cadence=%ds trigger=%s"
              % (seconds, label, cadence, trig))
        for line in out:
            print("  " + line)
    else:
        print("ARMED hold-countdown %ds label=%s cadence=%ds trigger=%s"
              % (seconds, label, cadence, trig))
    return 0


# ---------------------------------------------------------------------------
# UNILATERAL HOLD AUTO-CHAIN (owner live; the correction was first stated as
# an objection to an intermediate step being inserted between the two sides)
# ---------------------------------------------------------------------------
# Owner spec: when the first-side hold timer ends, its own button must trigger
# the second-side timer automatically; when the second-side timer ends, the
# item is completed automatically and the session advances to the next
# exercise. No intermediate step in between.
#
# WHAT WAS ACTUALLY HAPPENING BEFORE THIS: nothing, in code. `set-arm countdown`
# armed ONE countdown control file and stopped. There was no side awareness, no
# chain, no second arming -- so the ENTIRE 좌 -> 우 sequence was model-narrated
# prose, and the rejected mid-step ("이제 오른쪽 갑니다 [시작]") came straight out
# of the two reference docs that still taught "두 번의 별도 START tap". Both the
# 06:29 asymmetry bug (right side never got a timer) and the 06:32 mid-step bug
# are the same root cause: a MUST-happen sequence with no deterministic carrier.
#
# THE CHAIN (2 arms, contract v3.1 N-step, `step_final` = "1" on both):
#   entry tap  -> hold-chain side 0 : arms the LEFT countdown + writes arm A,
#                 emits [[IDRILL:A]] so ONE button rides the same message that
#                 fired the timer (the existing "타이머 발사 메시지에 완료 버튼
#                 필수" rule, now code-issued instead of model-issued).
#   tap on A   -> fires hold-chain side 1 with NO model turn: arms the RIGHT
#                 countdown IMMEDIATELY and pushes arm B's button. This is the
#                 mid-step removal -- the completion affordance IS the next
#                 timer's trigger; there is no "시작" tap in between.
#   tap on B   -> fires the terminal argv: set-add (the hold set is RECORDED,
#                 elapsed seconds in `reps` per hold-unilateral.md E14), whose
#                 own post-log set-arm chain then points at the next exercise.
#                 followup_cmd refreshes 표2 on the same zero-model-turn path.
#
# BRIDGE LIMIT (reported, not hacked around): the owner's literal "타이머에서
# 버튼이" -- a button ON the countdown message that DOES something -- is not
# reachable from this lane. bridge/countdown.py's control-file spec accepts only
# {seconds, label, cadence, icon, done_icon, glyph}; its DGN-915 completion
# button is hardcoded `cdn:done:<message_id>` and its handler only clears the
# keyboard (bot.py ~3880). So the actionable button rides the arm/push surface,
# which IS consumer-declarable. See the report for the exact bridge change that
# would let the countdown itself carry the next action.
#
# INVARIANT PRESERVED: this path is TIME-HOLD ONLY (isometric hold / dead hang /
# stretch / cooldown). A rep-based working set never reaches it -- it keeps the
# reps->RIR idrill arm and gets NO timer button. The #22 execution-trigger guard
# applies at every link, so a planning utterance still cannot arm a timer.
HOLD_SIDE_KO = {"left": "왼쪽", "right": "오른쪽"}   # 왼쪽 / 오른쪽
HOLD_CHAIN_SIDES_DEFAULT = "left,right"
# The ONE button that rides the timer-firing message. Its tap = the next timer.
HOLD_CHAIN_NEXT_BTN = "▶️ %s 홀드 시작"        # ▶️ 오른쪽 홀드 시작
HOLD_CHAIN_DONE_BTN = "✅ %s 홀드 완료"         # ✅ 오른쪽 홀드 완료
HOLD_CHAIN_BTN_VALUE = "go"
HOLD_CHAIN_VALIDATE = "^go$"
# Confirmations use ONLY {sec} (is_hold render path, bot.py _idrill_confirm_base)
# so they are safe on a 1-step arm regardless of the capture list.
HOLD_CHAIN_CONFIRM_NEXT = "✅ {sec}초 %s 홀드 완료 — %s 홀드 시작"
HOLD_CHAIN_CONFIRM_DONE = "✅ {sec}초 %s 홀드 완료"
HOLD_CHAIN_RESUME_PUSH = "\U0001f3cb️ %s 홀드 %d초 — 타이머 시작"  # 🏋️


def hold_chain_sides(spec):
    """Parse a --sides token ("left,right" / "좌,우") into a normalized side
    list. Unknown tokens are dropped; an empty result falls back to the
    left->right default so the chain can never end up side-less."""
    out = []
    for tok in re.split(r"[,\s/]+", str(spec or "")):
        t = tok.strip().lower()
        t = {"좌": "left", "우": "right", "l": "left", "r": "right"}.get(t, t)
        if t in HOLD_SIDE_KO and t not in out:
            out.append(t)
    return out or ["left", "right"]


def hold_chain_arm_id(session_id, exercise_name, set_seq, side_index):
    """Deterministic arm id for link `side_index` of this hold chain. A distinct
    key space ("<seq>-hc<N>") so a chain arm can never collide with the plain
    reps->RIR arm of the same set (compute_arm_id's own key)."""
    return compute_arm_id(session_id, exercise_name,
                          "%s-hc%d" % (set_seq, side_index))


# ---------------------------------------------------------------------------
# THE TERMINAL ARGVS OF A TIMED HOLD -- built ONCE, used by every hold path.
# ---------------------------------------------------------------------------
# `hold` is set-table's vocabulary (set-table.SET_KIND_HOLD, the derivation
# table's own key). It is mirrored as a literal here rather than imported
# because this argv is built on the arming critical path, and a lazy sibling
# import that fails there would cost the owner the button -- the exact failure
# class this whole file is about. If the two ever disagree, set-table wins and
# this constant is the bug.
SET_KIND_HOLD = "hold"


def hold_record_argv(session_id, exercise_name, slot_num, set_seq, seconds,
                     db_path, program_path):
    """The set-add argv that RECORDS one completed timed hold set.

    ONE builder for BOTH hold terminals (hold-chain's last side, hold-set's
    close button) because two open-coded copies of one argv is how the two
    drifted apart before -- and this argv writes the owner's data.

    THE DATA DEFECT THIS FIXES (measured 2026-09-02 in an isolated run):
    the argv was
        set-add <sid> wall_sit 4 1 45 --db ... --program ...
    with NO --set-kind and NO --hold-sec. set-add derives the kind from the
    sequence number when it is not stated (>=1 -> `working`), so the row landed
    as `reps=45, hold_sec=NULL, set_kind='working'`: 45 SECONDS stored in the
    REPS column of a set the table then believes was a rep-based working set.
    wall_sit is `progression: hold` -- it advances by hold TIME (20s -> 45s) --
    so that row corrupts the progression judgment, the volume aggregation and
    the set table at once.

    The shape below is not invented: it is the shape the owner's own live rows
    already have. workout_sets for session 10096 (2026-09-02, wall_sit sets 1
    and 2) read set_kind='hold', reps=45, hold_sec=45. `reps` carries the
    elapsed seconds (E14 -- there is one integer column and a hold's "how much"
    IS its seconds) and `hold_sec` states the prescription, so the row is
    self-describing and never has to be re-derived from a sequence number.
    The pack's prep-hold path states its kind and hold_sec the same way
    (set-table.prep_set_argv: --set-kind prep --target-reps N --hold-sec S).

    ORDER MATTERS: the flags go AFTER the positionals, so the positional slots
    (argv[5] == seconds) are unchanged for anything reading them by index.
    """
    return [
        os.path.join(SCRIPT_DIR, "set-add"), str(session_id), exercise_name,
        str(slot_num), str(set_seq), str(seconds),
        # STATE the kind. Do not let set_seq derive it -- a hold set's seq is
        # >= 1, which derives to `working`, which is wrong for every hold.
        "--set-kind", SET_KIND_HOLD,
        # STATE the duration. Without it hold_sec is NULL and the seconds
        # survive only in `reps`, where nothing can tell them from repetitions.
        "--hold-sec", str(seconds),
        "--db", db_path, "--program", program_path,
    ]


def hold_followup_argv(session_id, exercise_name, db_path, program_path):
    """The set-table argv the bridge runs right after a hold set is recorded.

    ONE builder for both hold terminals, for the same reason as above -- and
    with a second effect worth stating: `--surface owner` is DECLARED in one
    place for both. The bridge runs this with no model turn and posts its
    stdout to the owner VERBATIM, so the rail that sends text to a human says
    which human surface it is; set-table's default happens to agree, and an
    inferred default and a declared one read identically in the output and not
    in the code.

    (This argument used to be omitted here, under a PORT NOTE claiming this
    pack's set-table had no surface lane and that passing it would make
    argparse exit 2. That stopped being true when the lane landed --
    set-table now carries DEFAULT_SURFACE, resolve_surface, surface_lines and
    `--surface {owner,machine}` on the parser. The note is deleted rather than
    corrected: a stale reason left in place is how the omission survives a
    second reading.)
    """
    return [
        os.path.join(SCRIPT_DIR, "set-table"), str(session_id), exercise_name,
        "--db", db_path, "--program", program_path,
        "--surface", "owner",
    ]


def build_hold_chain_payload(session_id, exercise_name, set_seq, seconds,
                             sides, side_index, label, db_path, program_path,
                             slot_num):
    """Declare the arm that carries THIS link's completion button.

    Returns (payload, button_label) or (None, None) when this link needs no arm.

    * Not the last side -> the button FIRES the next link (arms the next side's
      countdown). This is the auto-chain: completion affordance == next timer.
    * Last side -> the button fires the terminal record argv (set-add) so the
      exercise is logged and set-add's own chain advances to the next exercise.
      When no program slot resolves (a prep drill / cooldown stretch has no
      workout_sets row to write) the terminal argv is the inert `--finish` form:
      it exits 0 and prints the machine line, and the confirmation still closes
      the loop for the user.
    """
    side = sides[side_index]
    side_ko = HOLD_SIDE_KO[side]
    is_last = side_index >= len(sides) - 1
    payload = {
        "session_id": str(session_id),
        "exercise_name": exercise_name,
        "set_seq": set_seq,
        "is_hold": True,
        "hold_sec": seconds,
        "step_final": "1",
        "step_validate": {"1": HOLD_CHAIN_VALIDATE},
    }
    _setarm = os.path.join(SCRIPT_DIR, "set-arm")
    if not is_last:
        nxt = sides[side_index + 1]
        btn = HOLD_CHAIN_NEXT_BTN % HOLD_SIDE_KO[nxt]
        payload["confirm_fmt"] = HOLD_CHAIN_CONFIRM_NEXT % (side_ko,
                                                            HOLD_SIDE_KO[nxt])
        payload["cmd"] = [
            _setarm, "hold-chain", str(session_id), exercise_name,
            str(set_seq), "--seconds", str(seconds),
            "--trigger", "set_done",           # #22: a hold END is a real event
            "--sides", ",".join(sides),
            "--side-index", str(side_index + 1),
            "--label", label,
            "--db", db_path, "--program", program_path,
        ]
    else:
        btn = HOLD_CHAIN_DONE_BTN % side_ko
        payload["confirm_fmt"] = HOLD_CHAIN_CONFIRM_DONE % side_ko
        if slot_num is not None:
            # E14: a hold set records its elapsed SECONDS in `reps`. set-add's
            # post-log set-arm is what then points at the next exercise -- not
            # re-derived here.
            #
            # 2026-09-02: this argv used to be open-coded here WITHOUT
            # --set-kind/--hold-sec, so every hold recorded through the chain
            # landed as set_kind='working' with the seconds sitting in `reps`
            # and hold_sec NULL. It now goes through the shared builder, which
            # states both. That is a PRE-EXISTING pack defect, not one this
            # artifact introduced -- it is fixed here because the new hold-set
            # terminal was a copy of this code and fixing only the copy would
            # have left the original writing corrupt rows.
            payload["cmd"] = hold_record_argv(
                session_id, exercise_name, slot_num, set_seq, seconds,
                db_path, program_path)
            # Same zero-model-turn rail as the working-set arm above.
            payload["followup_cmd"] = hold_followup_argv(
                session_id, exercise_name, db_path, program_path)
        else:
            payload["cmd"] = [
                _setarm, "hold-chain", str(session_id), exercise_name,
                str(set_seq), "--seconds", str(seconds),
                "--trigger", "set_done", "--sides", ",".join(sides),
                "--side-index", str(side_index), "--label", label,
                "--db", db_path, "--program", program_path, "--finish",
            ]
    payload["step_buttons"] = {"1": [[btn, HOLD_CHAIN_BTN_VALUE]]}
    payload["step_text"] = {"1": btn}
    return payload, btn


def run_hold_chain(argv):
    """Unilateral (two-sided) HOLD auto-chain -- see the block comment above.

        set-arm hold-chain <session_id> <exercise_name> <set_seq>
            --seconds <sec|range> --trigger <start|ready|set_done>
            [--sides left,right] [--label TEXT] [--side-index N]
            [--finish] [--db DB] [--program PROGRAM] [--dry-run]

    side-index 0 is the ENTRY link (invoked from a model turn -> the button
    rides an `[[IDRILL:]]` marker on that same message). Any side-index > 0 is a
    RESUMED link, fired by the bridge callback with no model turn at all and no
    stdout channel back to the bridge, so it still needs ONE detached push --
    but since v1.39.3/DGN-966 that push carries the SAME `[[IDRILL:<arm>]]`
    marker (push.sh renders it through the shared artifact contract), not a
    hand-built `--button` string. Entry and resumed links therefore declare and
    render through one identical path; the resume line ("🏋️ <side> 홀드 N초 —
    타이머 시작") is folded into the arm's own step_text so the marker-only push
    stays exactly ONE owner-visible message.
    """
    hp = argparse.ArgumentParser(
        prog="set-arm hold-chain",
        description="Two-sided hold auto-chain (no mid-step 시작 tap).")
    hp.add_argument("session_id")
    hp.add_argument("exercise_name")
    hp.add_argument("set_seq", type=int)
    hp.add_argument("--seconds", required=True,
                    help="hold duration seconds, or a range e.g. 20~30")
    hp.add_argument("--trigger", default=None,
                    help="#22 REQUIRED execution trigger: start|ready|set_done")
    hp.add_argument("--sides", default=HOLD_CHAIN_SIDES_DEFAULT,
                    help="ordered side list (weaker side first): left,right")
    hp.add_argument("--side-index", type=int, default=0,
                    help="which link of the chain to arm (0 = entry)")
    hp.add_argument("--label", default=COUNTDOWN_HOLD_LABEL,
                    help="countdown label (drill / exercise display name)")
    hp.add_argument("--cadence", type=int, default=COUNTDOWN_HOLD_CADENCE_SEC)
    hp.add_argument("--finish", action="store_true",
                    help="inert terminal form for a no-slot drill: print the "
                         "closing machine line and exit 0 (no timer, no write)")
    hp.add_argument("--db", default=DEFAULT_DB)
    hp.add_argument("--program", default=DEFAULT_PROGRAM)
    hp.add_argument("--dry-run", action="store_true")
    args = hp.parse_args(argv)

    sides = hold_chain_sides(args.sides)
    idx = max(0, min(args.side_index, len(sides) - 1))

    # --finish: the terminal no-op for a drill with no workout_sets row. Must
    # exit 0 (the bridge treats non-zero as IDRILL_ERROR) and must not arm.
    if args.finish:
        print("HOLD_CHAIN_DONE\t%s\t%s" % (args.exercise_name, sides[idx]))
        return 0

    # #22 INTENT GUARD -- identical to run_hold_countdown, applied at EVERY link
    # so no chain hop can smuggle a timer in without a real execution trigger.
    trig = (args.trigger or "").strip().lower()
    if trig not in TIMER_EXEC_TRIGGERS:
        print("GUARD_BLOCKED reason=no_exec_trigger trigger=%s "
              "(a plan/declaration is not a start signal; a timer needs an "
              "explicit start/ready or a set completion)"
              % (trig or "none"), file=sys.stderr)
        print("GUARD_BLOCKED no_exec_trigger")
        return 3

    seconds = hold_duration_from_range(args.seconds)
    if not seconds or seconds <= 0:
        print("ERROR: could not resolve a positive hold duration from %r"
              % args.seconds, file=sys.stderr)
        return 2

    side = sides[idx]
    side_ko = HOLD_SIDE_KO[side]
    base_label = (args.label or "").strip() or COUNTDOWN_HOLD_LABEL
    cd_label = "%s %s" % (base_label, side_ko)
    cadence = args.cadence if args.cadence and args.cadence > 0 \
        else COUNTDOWN_HOLD_CADENCE_SEC
    db_abs = os.path.abspath(args.db)
    from free_session import effective_path
    prog_abs = effective_path(os.path.abspath(args.program), os.path.abspath(args.db), args.session_id)

    out = []
    # 1) THE TIMER for this side -- fired immediately, on every link. This is
    #    the 06:29 asymmetry fix: the right side arms its own countdown from the
    #    same code path as the left, never from a model remembering to re-fire.
    emit_countdown(seconds, args.dry_run, out, label=cd_label, cadence=cadence)

    # 2) THE ONE BUTTON that closes this side and opens the next.
    slot_num = resolve_hold_slot_num(prog_abs, db_abs, args.session_id,
                                     args.exercise_name)
    arm_id = hold_chain_arm_id(args.session_id, args.exercise_name,
                               args.set_seq, idx)
    payload, btn = build_hold_chain_payload(
        args.session_id, args.exercise_name, args.set_seq, seconds, sides, idx,
        base_label, db_abs, prog_abs, slot_num)
    if idx > 0:
        # RESUMED link: the push carries this arm as a marker, and push.sh
        # renders step_text["1"] as the message text. Swap in the resume line
        # so the single message still announces "타이머 시작" (the button label
        # is already on the button -- no need to repeat it as the prompt).
        # Entry link untouched: its prompt rides the model's own message.
        payload["step_text"] = dict(payload.get("step_text") or {})
        payload["step_text"]["1"] = HOLD_CHAIN_RESUME_PUSH % (side_ko, seconds)
    write_callback_file(arm_id, payload, args.dry_run, out)

    if idx == 0:
        # ENTRY link: a model turn is rendering this, so the marker works.
        # G2 gated (2026-09-02) like every other marker emission. A hold-chain
        # link always declares one button and a cmd, so this is expected to be a
        # no-op -- which is the point: the invariant is TOTAL over the emitters,
        # not applied only where a defect was measured. A gate with an exception
        # list is the shape that left exercise-enter's marker ungated.
        emit_idrill_marker(arm_id, args.dry_run, out, payload=payload)
    else:
        # RESUMED link: zero model turn and no stdout channel to the bridge, so
        # the affordance still rides ONE detached push -- but as the SAME
        # `[[IDRILL:<arm>]]` marker the entry link emits (DGN-966 shared render
        # path), not a hand-built --button string. Marker-only body => push.sh
        # skips the body bubble and the keyboard message IS the push.
        spawn_followup_push(0, idrill_marker_text(arm_id),
                            args.dry_run, out, sid=args.session_id)

    nxt = sides[idx + 1] if idx + 1 < len(sides) else None
    print("HOLD_CHAIN\tside=%s\tindex=%d\tnext=%s\tsec=%d\tarm=%s"
          % (side, idx, nxt or "NONE", seconds, arm_id))
    print("HOLD_CHAIN_BTN\t%s" % btn)
    if args.dry_run:
        print("DRY-RUN hold-chain side=%s label=%s sec=%d trigger=%s"
              % (side, cd_label, seconds, trig))
    else:
        print("ARMED hold-chain side=%s label=%s sec=%d trigger=%s"
              % (side, cd_label, seconds, trig))
    for line in out:
        print("  " + line)
    return 0


# ---------------------------------------------------------------------------
# BILATERAL TIMED-HOLD CARRIER (`hold-set`) -- the D25 + D26 forcing point.
# ---------------------------------------------------------------------------
# WHAT WAS MEASURED (2026-09-02, wall_sit 45s x 2):
#
#   07:24  "45초 홀드 시작했어요"                  model prose
#   07:24  "선택해 주세요:" [1. 완료]              model [[OPTIONS]], SEPARATE
#                                                  message, BEFORE the timer
#   07:24  countdown 슬개건 월싯 0:20              bridge countdown message
#   ...    timer ends, bridge renders its own [다음 ▶]
#   07:26  owner taps it -> NOTHING HAPPENS, button vanishes, session stalls
#
# TWO distinct root causes, both structural:
#
#  1. `set-arm countdown` armed a control file and RETURNED. It never declared
#     an affordance. So the button existed only if a model turn authored one,
#     and its position relative to the timer was whatever the turn happened to
#     emit. That is D25 -- the owner's own question was why a completion button
#     was being handed out separately from the timer it belongs to.
#
#  2. The [다음 ▶] the owner tapped is the bridge countdown's own DGN-915
#     affordance. Its handler clears the reply markup and does NOTHING ELSE. It
#     is unconditional on every naturally-completed countdown and the
#     control-file spec has no knob to suppress it. So it is bridge-owned,
#     exactly like D6, and the pack cannot make it do anything -- it can only
#     make sure a REAL affordance is also on screen. That is D26.
#
# `hold-set` is the one code action that does both halves of a timed hold:
# arm the timer AND declare what closes it. Neither half can happen without the
# other, because G1 refuses a timer with no affordance before anything is
# written.
#
# AFFORDANCE TIMING (default `end`): the close button is scheduled to land when
# the hold ENDS, not when it starts. The owner's ruling is that the affordance
# has to come out of the timer itself. The bridge's countdown message cannot
# carry an actionable button (see BRIDGE LIMIT above), so landing the button at
# the timer's completion instant is the closest the pack lane gets, and it makes
# "the 완료 button arrives before the timer does" structurally impossible.
HOLD_SET_DONE_BTN = "✅ %d초 홀드 완료"       # ✅ 45초 홀드 완료
HOLD_SET_NEXT_BTN = "▶️ %d세트 시작 (%d초)"   # ▶️ 2세트 시작 (45초)
HOLD_SET_BTN_VALUE = "go"
HOLD_SET_VALIDATE = "^go$"


def hold_set_arm_id(session_id, exercise_name, set_seq):
    """Arm id for the DONE affordance of hold set <set_seq>. Its own key space
    ("<seq>-hs") so it can never collide with the plain post-log correction arm
    of the same seq, nor with a hold-chain link ("<seq>-hcN")."""
    return compute_arm_id(session_id, exercise_name, "%s-hs" % set_seq)


def hold_next_arm_id(session_id, exercise_name, set_seq):
    """Arm id for the NEXT-SET affordance armed after hold set <set_seq> was
    recorded. Distinct key space ("<seq>-hn") for the same reason."""
    return compute_arm_id(session_id, exercise_name, "%s-hn" % set_seq)


def build_hold_set_done_payload(session_id, exercise_name, set_seq, seconds,
                                slot_num, db_path, program_path):
    """The affordance that CLOSES one timed hold set.

    ONE step, ONE button, and a DECLARED cmd -- the three things the live hold
    arm was missing. Compare the arm set-arm actually wrote for wall_sit set 1
    on 2026-09-02 (arm 298dc117): step_buttons["1"] == [], no "cmd" key at all,
    and the marker emitted regardless. It rendered nothing on the marker rail,
    and had it rendered, the tap would have hit IDRILL_ERROR.

    When the hold has no program slot (a prep drill / cool-down stretch has no
    workout_sets row to write) the terminal is the inert `--finish` form, which
    exits 0 and prints the machine line -- the same degrade hold-chain uses.
    """
    label = HOLD_SET_DONE_BTN % seconds
    payload = {
        "session_id": str(session_id),
        "exercise_name": exercise_name,
        "set_seq": set_seq,
        "is_hold": True,
        "hold_sec": seconds,
        "step_final": "1",
        "step_validate": {"1": HOLD_SET_VALIDATE},
        "step_buttons": {"1": [[label, HOLD_SET_BTN_VALUE]]},
        "step_text": {"1": label},
        "confirm_fmt": CONFIRM_FMT_HOLD,
    }
    if slot_num is not None:
        # E14: a hold set records its elapsed SECONDS in `reps`. set-add's own
        # post-log set-arm is what then arms the rest + the NEXT hold set --
        # this payload does not re-derive that, so there is exactly one place
        # that decides what comes after a recorded set.
        #
        # THE ARGV IS NOT BUILT HERE. hold_record_argv states --set-kind hold
        # and --hold-sec; the first cut of this function open-coded the argv
        # without them and an isolated run measured the result:
        # `reps=45, hold_sec=NULL, set_kind='working'` -- the close button was
        # writing 45 SECONDS into the repetitions column.
        payload["cmd"] = hold_record_argv(
            session_id, exercise_name, slot_num, set_seq, seconds,
            db_path, program_path)
        payload["followup_cmd"] = hold_followup_argv(
            session_id, exercise_name, db_path, program_path)
    else:
        payload["cmd"] = [
            os.path.join(SCRIPT_DIR, "set-arm"), "hold-set", str(session_id),
            exercise_name, str(set_seq), "--seconds", str(seconds),
            "--trigger", "set_done", "--db", db_path,
            "--program", program_path, "--finish",
        ]
    return payload


def advance_arm_id(session_id, exercise_name, set_seq):
    """Arm id for the ADVANCE affordance armed after the LAST set of an
    exercise. Its own key space ("<seq>-adv") so it can never collide with the
    post-log correction arm, a hold-chain link, or a hold-next arm."""
    return compute_arm_id(session_id, exercise_name, "%s-adv" % set_seq)


# The advance button's label. The pack owns the WORD (hold_next_label ->
# 다음(진행) / 완료); this only names WHICH exercise, because "다음(진행)" alone
# on a message that has already moved past the last set tells the owner nothing
# about what they are agreeing to start.
ADVANCE_BTN_NAMED = "▶️ 다음: %s"          # ▶️ 다음: <다음 종목 이름>
ADVANCE_BTN_BARE = "▶️ %s"                # ▶️ 다음(진행)
ADVANCE_BTN_VALUE = "go"
ADVANCE_VALIDATE = "^go$"


def build_advance_payload(session_id, next_exercise_name, next_display,
                          label_word, db_path, program_path):
    """The affordance that ADVANCES to the next exercise -- defect (C).

    THE HOLE IT CLOSES. After the LAST hold set of an exercise, `transition` is
    true, so the next-set arm block did not run and the push carried only
    "👉 다음으로 진행하려면 '다음(진행)'라고 보내주세요" -- a sentence, plus a
    HOLD_NEXT_REQUIRED line asking the MODEL to author the button. Measured
    compliance for instruction-shaped prescriptions in this pack is 3.4%, and
    the owner's own reading of the live session was exactly this: the defect is
    not that the model forgets a marker, it is that a model-discretion stretch
    carries no button guarantee. The exercise boundary was the last
    model-discretion fork left in the hold chain, so it is pulled onto the code
    path like every other one.

    THE TAP RUNS `exercise-enter`, which is the pack's own deterministic entry
    for a new exercise (cue + set table + ramp arm). Nothing is invented: the
    NEXT exercise is the one derive_next_spec already resolved for the very push
    this button rides, so the button and the sentence above it can never name
    two different exercises.

    Returns None when there is no next exercise to name -- a button that cannot
    say where it goes is refused rather than shipped with a guess (G2 would
    refuse it anyway; returning None keeps the reason readable at the call
    site).
    """
    if not next_exercise_name:
        return None
    disp = (next_display or "").strip()
    label = (ADVANCE_BTN_NAMED % disp) if disp \
        else (ADVANCE_BTN_BARE % label_word)
    return {
        "session_id": str(session_id),
        "exercise_name": next_exercise_name,
        "step_final": "1",
        "step_validate": {"1": ADVANCE_VALIDATE},
        "step_buttons": {"1": [[label, ADVANCE_BTN_VALUE]]},
        "step_text": {"1": label},
        "confirm_fmt": "✅ %s" % (disp or label_word),
        "cmd": [
            os.path.join(SCRIPT_DIR, "exercise-enter"), str(session_id),
            str(next_exercise_name), "--db", db_path, "--program", program_path,
        ],
    }


def build_hold_next_payload(session_id, exercise_name, next_seq, seconds,
                            db_path, program_path):
    """The affordance that STARTS the next hold set -- THE D26 FIX.

    Its tap re-enters `hold-set`, which arms the next countdown AND its close
    button with no model turn anywhere in the loop. Before this the only things
    offered after a recorded hold set were (a) a sentence telling the owner to
    TYPE "다음 세트", and (b) the bridge's inert [다음 ▶]. Neither advanced the
    session, and a timer is the one surface the owner cannot type around.
    """
    label = HOLD_SET_NEXT_BTN % (next_seq, seconds)
    return {
        "session_id": str(session_id),
        "exercise_name": exercise_name,
        "set_seq": next_seq,
        "is_hold": True,
        "hold_sec": seconds,
        "step_final": "1",
        "step_validate": {"1": HOLD_SET_VALIDATE},
        "step_buttons": {"1": [[label, HOLD_SET_BTN_VALUE]]},
        "step_text": {"1": label},
        "confirm_fmt": "✅ {sec}초 홀드 시작",
        "cmd": [
            os.path.join(SCRIPT_DIR, "set-arm"), "hold-set", str(session_id),
            exercise_name, str(next_seq), "--seconds", str(seconds),
            "--trigger", "set_done",       # #22: a rest ending is a real event
            "--db", db_path, "--program", program_path,
        ],
    }


def run_hold_set(argv):
    """`set-arm hold-set <session_id> <exercise_name> <set_seq> --seconds N
    --trigger <start|ready|set_done> [--label TEXT] [--affordance-at end|start]
    [--finish] [--db DB] [--program PROGRAM] [--dry-run]`

    ONE code action = timer + the affordance that closes it. Both or neither.

    Order of operations matters and is deliberate:
      1. decide()  -- ask the ONE decision point whether this step gets a
                      button and where it attaches. No local re-derivation.
      2. gate_timer() -- G1. Refuse BEFORE any side effect if a timer would be
                      armed with nothing to close it.
      3. build + gate_payload() -- G2. Refuse a dead affordance BEFORE arming.
      4. arm the countdown, write the arm file, schedule the delivery.
    Steps 2 and 3 run before step 4 so a refusal leaves the surface untouched:
    a half-armed hold (timer, no button) is exactly the stall being fixed.
    """
    hp = argparse.ArgumentParser(
        prog="set-arm hold-set",
        description="Timed hold set: countdown + its close affordance, "
                    "as one code action.")
    hp.add_argument("session_id")
    hp.add_argument("exercise_name")
    hp.add_argument("set_seq", type=int)
    hp.add_argument("--seconds", required=True,
                    help="hold duration seconds, or a range e.g. 20~45")
    hp.add_argument("--trigger", default=None,
                    help="#22 REQUIRED execution trigger: start|ready|set_done")
    hp.add_argument("--label", default=None,
                    help="countdown label (default: the exercise display name)")
    hp.add_argument("--cadence", type=int, default=COUNTDOWN_HOLD_CADENCE_SEC)
    hp.add_argument("--affordance-at", dest="affordance_at",
                    choices=("end", "start"), default="end",
                    help="when the close button lands. 'end' (default) = at "
                         "the hold's completion instant, so it can never "
                         "precede the timer (D25). 'start' = immediately.")
    hp.add_argument("--finish", action="store_true",
                    help="inert terminal for a no-slot hold: print the closing "
                         "machine line and exit 0 (no timer, no write)")
    hp.add_argument("--db", default=DEFAULT_DB)
    hp.add_argument("--program", default=DEFAULT_PROGRAM)
    hp.add_argument("--dry-run", action="store_true")
    args = hp.parse_args(argv)

    if args.finish:
        print("HOLD_SET_DONE\t%s\t%s" % (args.exercise_name, args.set_seq))
        return 0

    # #22 INTENT GUARD -- identical to run_hold_countdown / run_hold_chain, so
    # no new entry point can smuggle a timer in on a planning utterance.
    trig = (args.trigger or "").strip().lower()
    if trig not in TIMER_EXEC_TRIGGERS:
        print("GUARD_BLOCKED reason=no_exec_trigger trigger=%s "
              "(a plan/declaration is not a start signal; a timer needs an "
              "explicit start/ready or a set completion)"
              % (trig or "none"), file=sys.stderr)
        print("GUARD_BLOCKED no_exec_trigger")
        return 3

    seconds = hold_duration_from_range(args.seconds)
    if not seconds or seconds <= 0:
        print("ERROR: could not resolve a positive hold duration from %r"
              % args.seconds, file=sys.stderr)
        return 2

    db_abs = os.path.abspath(args.db)
    from free_session import effective_path
    prog_abs = effective_path(os.path.abspath(args.program), os.path.abspath(args.db), args.session_id)
    slot_num = resolve_hold_slot_num(prog_abs, db_abs, args.session_id,
                                     args.exercise_name)

    # 1) THE DECISION -- asked, never re-derived here.
    decision = step_affordance.decide(
        step_affordance.KIND_HOLD, step_affordance.POS_CONTINUATION,
        timer_armed=True, candidates=1,
        next_set_seq=args.set_seq, hold_seconds=seconds)
    print(decision.as_line())

    # 2) G1 -- refuse a timer with no way to close it, before any side effect.
    try:
        step_affordance.gate_timer(decision)
    except step_affordance.AffordanceRefused as exc:
        print("AFFORDANCE_REFUSED\t%s" % exc, file=sys.stderr)
        print("AFFORDANCE_REFUSED\t%s" % exc)
        return 4

    # 3) G2 -- refuse a dead affordance, before any side effect.
    arm_id = hold_set_arm_id(args.session_id, args.exercise_name, args.set_seq)
    payload = build_hold_set_done_payload(
        args.session_id, args.exercise_name, args.set_seq, seconds, slot_num,
        db_abs, prog_abs)
    try:
        step_affordance.gate_payload(payload, arm_id)
    except step_affordance.AffordanceRefused as exc:
        print("AFFORDANCE_REFUSED\t%s" % exc, file=sys.stderr)
        print("AFFORDANCE_REFUSED\t%s" % exc)
        return 4

    # 4) Side effects, in the order the owner reads them.
    out = []
    label = (args.label or "").strip() or exercise_display_name(
        prog_abs, db_abs, args.session_id, args.exercise_name)
    cadence = args.cadence if args.cadence and args.cadence > 0 \
        else COUNTDOWN_HOLD_CADENCE_SEC
    # done_button is left at its default (True): this IS a time-hold, the one
    # class the 2026-08-22 ruling grants the bridge's completion button. See
    # emit_countdown -- the arming side declares it, the renderer cannot infer
    # hold-vs-rest.
    emit_countdown(seconds, args.dry_run, out, label=label, cadence=cadence)
    write_callback_file(arm_id, payload, args.dry_run, out)
    delay = seconds if args.affordance_at == "end" else 0
    delivered = deliver_arm_keyboard(
        arm_id, payload, args.dry_run, out, sid=args.session_id,
        marker="hold-set-done", delay=delay)

    print("HOLD_SET\tseq=%d\tsec=%d\tarm=%s\tattach=%s\tdelivered=%s"
          % (args.set_seq, seconds, arm_id, decision.attach,
             "1" if delivered else "0"))
    print("HOLD_SET_BTN\t%s" % (HOLD_SET_DONE_BTN % seconds))
    if args.dry_run:
        print("DRY-RUN hold-set label=%s sec=%d trigger=%s affordance_at=%s"
              % (label, seconds, trig, args.affordance_at))
    else:
        print("ARMED hold-set label=%s sec=%d trigger=%s affordance_at=%s"
              % (label, seconds, trig, args.affordance_at))
    for line in out:
        print("  " + line)
    # A delivery that was refused (G3 duplicate) is NOT a failure of this call:
    # the owner already has that button. A delivery that could not render would
    # already have been caught by G2 above.
    return 0


def exercise_display_name(program_path, db_path, session_id, exercise_name):
    """The owner-facing name of this exercise, or the raw name on any miss.

    A hold countdown labelled "홀드" tells the owner nothing about WHICH hold is
    running; the live session labelled it "슬개건 월싯" only because the model
    passed --label by hand. Reading it from the program makes the label
    deterministic instead of model-supplied."""
    try:
        rx = load_rx_calc()
        program = rx.load_yaml(program_path)
        slot = find_slot(program, db_path, int(session_id), exercise_name)
        if slot:
            disp = (slot.get("display") or "").strip()
            if disp:
                return disp
    except Exception:      # noqa: BLE001 -- a label miss never breaks the arm
        pass
    return exercise_name


def resolve_hold_slot_num(program_path, db_path, session_id, exercise_name):
    """1-based program.yaml slot number for this exercise in THIS session's day,
    or None when the exercise is not a program slot (a prep drill / cooldown
    stretch -- nothing to record). Best-effort: any failure -> None, which sends
    the chain down the inert `--finish` terminal instead of a bad set-add."""
    try:
        rx = load_rx_calc()
        program = rx.load_yaml(program_path)
        slot = find_slot(program, db_path, int(session_id), exercise_name)
        if slot is None:
            return None
        # Prefer the slot's own declared number; fall back to its index.
        num = slot.get("slot")
        return int(num) if num is not None else None
    except Exception:      # noqa: BLE001 -- never break the chain on a lookup
        return None


def resolve_current_arm_data(rx, program_path, db_path, session_id,
                             exercise_name, override, set_seq=None):
    """DGN-918: resolve (slot_num, weight, target_reps) for the set the owner is
    about to enter, for the arm-id file.

    `set_seq` (2026-08-21 -- THE ROOT-CAUSE PARAMETER) selects WHICH RUNG of the
    exercise is being armed. Before it existed this function had no way to
    express "the warm-up", so it always returned the WORKING-SET prescription
    and every arm -- primer, ramp rung, working set -- carried the working weight
    and the working rep range. Live consequences, all three on 2026-08-21: a
    bodyweight warm-up was offered `10 11 12 13 14` (the working set's range),
    and tapping it wrote WORKING SET 1 at the WORKING WEIGHT.

      * set_seq >= 1, or None (the historical call shape) -> the WORKING
        prescription, byte-identical to before:
          - slot_num    = 1-based index of this exercise in its day's slot order
          - weight      = TODAY's rx-calc prescribed weight_kg (RC1 single
                          source), overlaid with the owner override (F21)
          - target_reps = top of the slot rep_range (set-table planned-row rule),
                          overlaid with the owner override reps (F19)
      * set_seq <= 0 -> the RUNG the seq names ('bw' for 0, 'rN' for -N), read
        from resolve_ramp_ladder -- i.e. from set-table.planned_ramp_rows +
        ax_engine.ramp_taper_reps, the SAME two sources 표2 renders the ladder
        from. weight/target_reps are that RUNG's, so the reps window centres on
        the rung's own tapered target and the fired argv bakes the rung's own
        load. A seq with no matching planned rung -> (slot_num, None, None): the
        caller must NOT arm rather than fall back to the working numbers (that
        fallback IS the defect).

    Any failure -> (None, None, None) so the caller degrades gracefully (a None
    target_reps arms RIR directly, like the hold path). The override is applied
    on the CURRENT exercise (not a transition -- this is always the current
    exercise's own set)."""
    if set_seq is not None:
        try:
            if int(set_seq) <= 0:
                return resolve_rung_arm_data(rx, program_path, db_path,
                                             session_id, exercise_name,
                                             override, int(set_seq))
        except (TypeError, ValueError):
            pass
    try:
        program = rx.load_yaml(program_path)
        slot = find_slot(program, db_path, session_id, exercise_name)
        if slot is None:
            return None, None, None

        # slot_num = 1-based index in this session's day slot order.
        days = program.get("days") or {}
        day_code = find_day_code(program, db_path, session_id, exercise_name)

        def slots_of(code):
            return (days.get(code) or {}).get("exercises") or []

        slot_num = None
        if day_code is not None:
            for i, ex in enumerate(slots_of(day_code)):
                if ex.get("name") == exercise_name:
                    slot_num = i + 1
                    break

        # weight from TODAY's rx-calc prescription (exclude this open session),
        # asked FOR day_code -- the split this session is training (2026-08-23).
        # This is the value that gets baked into the armed argv's --weight, so
        # when it came back None (makeup session, prescription keyed on the
        # rotation queue's day) the button fired a weight-free set-add, which
        # correctly refused to write and left 세트볼륨 at 0.
        weight = None
        rx_reps = None
        try:
            today = _session_today(db_path, session_id)
            result = rx.calc_rx(program_path, today, db_path,
                                exclude_session_id=session_id,
                                rotation_day_override=day_code)
            for ex in (result.get("exercises") or []):
                if ex.get("name") == exercise_name:
                    weight = ex.get("weight_kg")
                    rx_reps = ex.get("target_reps")
                    break
        except SystemExit:
            pass
        except Exception:
            pass

        # target_reps = top of rep_range, override reps wins when present.
        reps_str = _fmt_reps(slot.get("rep_range"))
        target_reps = None
        try:
            target_reps = int(reps_str) if reps_str != "" else None
        except (TypeError, ValueError):
            target_reps = None
        # 2026-09-30: rx-calc's rep target moves with today's load (e1RM path:
        # reps at the rounded load; progression 'up': the range bottom) and
        # wins over the static range top -- the same number 표2 prints.
        if isinstance(rx_reps, int) and not isinstance(rx_reps, bool):
            target_reps = rx_reps

        if override:
            if "weight_kg" in override and override["weight_kg"] is not None:
                weight = override["weight_kg"]
            if override.get("reps") is not None:
                try:
                    target_reps = int(override["reps"])
                except (TypeError, ValueError):
                    pass
        return slot_num, weight, target_reps
    except Exception:  # noqa: BLE001 -- arm data resolve must never break a set
        return None, None, None


def _lattice_type_of(slot):
    """program.yaml `lattice.type` for a slot dict, or None. 'standard' = the
    bar+plate grid, 'even' = fixed dumbbells, 'stack' = a pin."""
    lat = (slot or {}).get("lattice")
    return (lat or {}).get("type") if isinstance(lat, dict) else None


# ---------------------------------------------------------------------------
# THE LADDER BASIS (2026-09-11). MEASURED, live, on a 70 -> 80 progression day.
#
# lat_pulldown carries `weight_kg: null` in program.yaml -- the CALIBRATION
# sentinel, correct and deliberate (the slot replaced an assisted pull-up, so no
# load could be carried across). rx-calc therefore prescribes weight None, and
# resolve_ramp_ladder's first line read:
#
#     if working_weight is None: return []
#
# An empty ladder is zero rungs, next_ladder_seq walks straight to working set 1
# and the owner was handed a working keyboard as their FIRST tap of the
# exercise. Their words: 「원업도안시키네」 -- deadlift, one slot earlier on the
# same day, had `p1 p2 p3 세팅 r1 r2` on it because its slot declares a weight.
#
# The number was never missing. engine_load_baseline, the SIBLING function
# forty lines up, has resolved exactly this for months: rx first, then the LAST
# LOGGED working weight (lat_pulldown: 70.0kg, 2026-09-03). The ladder resolver
# simply never asked.
#
# WHAT THE FALLBACK IS AND IS NOT (owner's ruling, 2026-09-11):
#   * it PRESCRIBES -- it stands up the planned ladder, nothing more;
#   * it is DERIVED, never DECLARED. program.yaml is not written, the working
#     set's own prescription is untouched (resolve_current_arm_data still
#     returns None for a calibration slot, so a working set-add still refuses to
#     invent a load), and an explicit `--weight` / `--ov-weight` always wins;
#   * it is VISIBLE. A derived ladder says where its weight came from, because
#     the owner has to be able to ask "왜 이 무게냐" and get an answer.
#
# And when even the fallback comes up empty -- a brand-new lift with no history
# at all -- the answer is NOT to shrug and open the working lane. That silence
# is what put the owner under 80kg with no warm-up. ramp_lane_open below turns
# it into a refusal that says so.
# ---------------------------------------------------------------------------
RAMP_BASIS_OVERRIDE = "override"        # the owner stated it this session (F21)
RAMP_BASIS_RX = "rx"                    # today's rx-calc prescription
RAMP_BASIS_SLOT = "slot"                # program.yaml's seed weight_kg (nothing logged yet)
RAMP_BASIS_LAST_LOGGED = "last_logged"  # DERIVED: the last working set lifted
RAMP_BASIS_NONE = "none"                # nothing anywhere resolves a load


def ramp_basis(rx, program_path, db_path, session_id, exercise_name,
               override=None, declared=None, slot=None):
    """The working load the warm-up ladder is PLANNED AGAINST, with provenance:
        {"weight": float|None, "source": RAMP_BASIS_*, "as_of": "YYYY-MM-DD"|None}

    Priority, highest first -- the owner's own word beats the engine, the engine
    beats the program file, and all three beat history:
      1. an explicit override weight (F19/F21 `--ov-weight`, or `--weight` on
         the way in). A DECLARED value can never lose to a derived one;
      2. `declared` -- what resolve_current_arm_data resolved (rx-calc's
         prescription for today, override already folded in). Since program
         state step A (2026-09-30) rx-calc itself starts from the last LOGGED
         working load, so on a healthy read this rung answers for every lift
         that was ever logged, and (3)/(4) only run when that read FAILED (an
         unreadable DB, a makeup day rx-calc cannot key, a raised SystemExit
         -- swallowed upstream and arriving here as None);
      3. the last logged working weight for this lift, excluding THIS session.
         The DERIVED fallback engine_load_baseline has always had (the whole
         2026-09-11 defect). It sits ABOVE the card's seed (A4): the seed is
         the owner's starting number, read only before anything was logged --
         the same order rx-calc.resolve_base_weight uses;
      4. the slot's OWN `weight_kg` in program.yaml, i.e. the seed. Keeps (5)
         from standing in for a resolver that merely failed on a lift nobody
         has logged yet: a slot that DECLARES a number is not a slot with no
         number, and the ramp gate below must never refuse a set over our own
         read failing;
      5. nothing.

    `as_of` is set only for (3): it is the date of the set the number came from,
    and it exists so the provenance line can be checked rather than believed.

    Never writes anything, never returns a load it invented: (None, none, None)
    when no source answers."""
    ov = None
    if override and override.get("weight_kg") is not None:
        try:
            ov = float(override["weight_kg"])
        except (TypeError, ValueError):
            ov = None
    if ov is not None:
        return {"weight": ov, "source": RAMP_BASIS_OVERRIDE, "as_of": None}
    if declared is not None:
        try:
            return {"weight": float(declared), "source": RAMP_BASIS_RX,
                    "as_of": None}
        except (TypeError, ValueError):
            pass
    weight, as_of = _last_logged_working_load(db_path, exercise_name,
                                              exclude_session_id=session_id)
    if weight is not None:
        return {"weight": weight, "source": RAMP_BASIS_LAST_LOGGED,
                "as_of": as_of}
    if (slot or {}).get("weight_kg") is not None:
        try:
            return {"weight": float(slot["weight_kg"]),
                    "source": RAMP_BASIS_SLOT, "as_of": None}
        except (TypeError, ValueError):
            pass
    return {"weight": None, "source": RAMP_BASIS_NONE, "as_of": None}


# A ladder resolve that BLEW UP is not a ladder decision. It gets its own reason
# so ramp_lane_open can tell "this lift honestly has no rungs" from "we could
# not read the plan" -- the first is an answer, the second is a fail-open.
RAMP_R_UNREADABLE = "resolver_error"
# live 2026-10-08 (item 3): a first set the CODE classified as a calibration
# rung (set-add, live_load) IS the warm-up -- the next step is working set 1
# at the weight re-prescribed from it, never more planned rungs below it.
RAMP_R_CALIBRATED = "calibrated"


def _ladder_closed(session_id, exercise_name):
    """True once a calibration rung was logged for this lift today
    (live_load.ladder_closed). Best-effort: a miss -> False (pre-fix)."""
    try:
        if SCRIPT_DIR not in sys.path:
            sys.path.insert(0, SCRIPT_DIR)
        import live_load
        return live_load.ladder_closed(session_id, exercise_name)
    except Exception:  # noqa: BLE001
        return False


def resolve_ramp_plan(rx, program_path, db_path, session_id, exercise_name,
                      override=None):
    """The PLANNED warm-up ladder for this exercise AS A DECISION:

        {"rows": [...], "decision": RAMP_YES|RAMP_NO, "reason": <code>,
         "basis": {"weight", "source", "as_of"}}

    `rows` are the armable rungs, ascending (bw first, then r1, r2 ...):
        [{"set_seq", "label", "weight_kg", "reps", "rir", "slot_num",
          "plate_delta", "plate_prev_kg", "basis_kg", "basis_source"}, ...]

    EVERY field is read from an EXISTING source of truth -- nothing here is a
    second planner:
      * the rungs + their weights  -> set-table.ramp_decision (the exact rows 표2
        draws, and now the exact REASON it draws them for)
      * the per-rung reps          -> ax_engine.ramp_taper_reps over those rows
        (the exact taper 표2 prints, and the one _f6_ramp_sets stamps on the
        spoken cue)
      * the per-rung RIR           -> ax_engine.RAMP_RIR
      * label -> set_seq           -> seq_for_rung_label, the same mapping
        set-table uses to label a LOGGED rung row
    So an armed rung and a rendered 표2 rung cannot disagree; if they ever did,
    it would mean one of these two call sites stopped reading the SoT.

    WHY THE REASON RIDES ALONG (2026-09-11). set-table made "no ramp" a VALUE
    with a reason code precisely because an empty list says nothing about why
    (see set-table's RAMP_YES block comment). This resolver then read it through
    `planned_ramp_rows` -- the THIN VIEW that throws the reason away -- so
    RAMP_R_NO_WEIGHT never reached the arm path and the one condition that must
    stop a set died silently one function short of the caller who needed it.

    THE bw RUNG'S WEIGHT, aligned to set-table (D6, 2026-09-11). Only the
    BARBELL ladder mints a synthetic rung: `reason == RAMP_R_BARBELL` puts an
    empty-bar row at 20.0kg (_RAMP_EMPTY_BAR_KG) whether or not the owner is
    holding a bar, and nulling THAT on a bar-less lift is what the old
    `label == "bw" and not has_bar` line was written for. The MACHINE ladder's
    bw row is a different animal: it is the 세팅 rung, and its weight is a real
    pin position computed by set-table._stack_setting_weight under the owner's
    2026-08-25 12:07 ruling (「스택 머신도 낮은 무게로 세팅 잡는 거 가능한데」).
    The old line could not tell them apart -- it keyed on the label alone -- so
    it nulled the pin weight too, and a 50.0kg lat-pulldown 세팅 was armed as
    「웜업 (맨몸)」 and spoken to the owner that way at 07:15 on 2026-09-11.
    set-table already had the third condition (`weight_kg is None`, see its
    wt_cell); this is that same rule, keyed on the reason instead of guessed.

    Best-effort: any failure -> zero rows under RAMP_R_UNREADABLE, so the caller
    simply does not arm a rung (and, per ramp_lane_open, does not BLOCK on it
    either)."""
    basis = {"weight": None, "source": RAMP_BASIS_NONE, "as_of": None}
    try:
        st = set_table()
        if _ladder_closed(session_id, exercise_name):
            return {"rows": [], "decision": st.RAMP_NO,
                    "reason": RAMP_R_CALIBRATED, "basis": basis}
        slot_num, working_weight, working_reps = resolve_current_arm_data(
            rx, program_path, db_path, session_id, exercise_name, override)
        program = rx.load_yaml(program_path)
        slot = find_slot(program, db_path, session_id, exercise_name)
        basis = ramp_basis(rx, program_path, db_path, session_id,
                           exercise_name, override, declared=working_weight,
                           slot=slot)
        if basis["weight"] is None:
            # No declaration, no prescription, no history. set-table's own code
            # for it, carried out rather than swallowed.
            return {"rows": [], "decision": st.RAMP_NO,
                    "reason": st.RAMP_R_NO_WEIGHT, "basis": basis}
        dec = st.ramp_decision(db_path, exercise_name, basis["weight"],
                               slot=slot,
                               e1rm=st.ramp_e1rm_for(db_path, exercise_name,
                                                     slot, session_id),
                               calibration=st.calibration_state(
                                   db_path, exercise_name, session_id),
                               probe_rungs=(override or {}).get("probe_rungs"))
        rows = dec["rows"]
        # THE SECOND CEILING (2026-09-11, incident A). ramp_decision cut these
        # rungs below the BASIS -- the weight the ladder was PLANNED against.
        # That is not always the weight the owner is about to lift: the basis
        # falls back through override -> rx -> slot -> last logged, so a ladder
        # can legitimately be planned against last session's 105kg while
        # resolve_current_arm_data serves 115kg today, or the reverse. Only the
        # SERVED working weight is the load the warm-up is a warm-up FOR, so it
        # gets its own pass through the same gate.
        #
        # Same function, not a second implementation: set-table.gate_rung_ceiling
        # is the one place `rung < working` is written as an executable
        # condition, and a rung that fails it here yields the same
        # RAMP_R_NO_RUNG the planner would have returned. working_weight None
        # (calibration) -> the gate is a no-op by its own rule, so a calibration
        # slot's derived ladder is untouched.
        rows, ceil_r = st.gate_rung_ceiling(rows, working_weight)
        if ceil_r is not None:
            dec = {"decision": st.RAMP_NO, "reason": ceil_r, "rows": []}
        if not rows:
            return {"rows": [], "decision": dec["decision"],
                    "reason": dec["reason"], "basis": basis}
        ax = ax_engine()
        # The taper is measured against the SAME load the rungs were cut from,
        # so a derived ladder tapers exactly like a declared one would.
        taper = ax.ramp_taper_reps(rows, basis["weight"], working_reps)
        has_bar = ax.is_plate_loaded(db_path, exercise_name,
                                     _lattice_type_of(slot))
        out_rows = []
        for idx, r in enumerate(rows):
            label = r.get("label")
            seq = seq_for_rung_label(label)
            if seq is None:
                continue
            weight = r.get("weight_kg")
            if (label == "bw" and not has_bar
                    and dec["reason"] == st.RAMP_R_BARBELL):
                weight = None      # genuine bodyweight primer -- no bar to load
            out_rows.append({
                "set_seq": seq,
                "label": label,
                "weight_kg": weight,
                "reps": taper[idx] if idx < len(taper) else None,
                "rir": ax.RAMP_RIR,
                "slot_num": slot_num,
                # D6 (2026-08-25): the per-side kg to ADD relative to the rung
                # BELOW this one, carried through from the planner instead of
                # recomputed here. set-table._with_plate_deltas owns that
                # arithmetic (SKILL G10: "set-arm은 그 값을 읽지, 델타를 다시
                # 유도하지 않는다"); this resolver was dropping the field on the
                # floor, so the one consumer that could have used it never saw
                # one. None on the first rung and throughout every non-plate
                # (machine/stack/cable) ladder -- the planner's own rule.
                "plate_delta": r.get("plate_delta"),
                # The weight that delta was measured FROM. The cue diffs against
                # the .plate-cue LEDGER (what is actually on the bar), and a
                # SKIPPED rung makes those two different questions -- carrying
                # the predecessor lets the consumer verify they agree before it
                # trusts the planner's number. Without it a planned delta would
                # be quoted as an observed one.
                "plate_prev_kg": (rows[idx - 1].get("weight_kg")
                                  if idx > 0 else None),
                # WHERE THIS RUNG'S LOAD CAME FROM, carried per row so a
                # single-row consumer (due_rung, the transition spec) can answer
                # "왜 이 무게냐" without re-running the resolver.
                "basis_kg": basis["weight"],
                "basis_source": basis["source"],
            })
        return {"rows": out_rows, "decision": dec["decision"],
                "reason": dec["reason"], "basis": basis}
    except Exception:  # noqa: BLE001 -- a ladder miss must never break a set
        return {"rows": [], "decision": "none", "reason": RAMP_R_UNREADABLE,
                "basis": basis}


def resolve_ramp_ladder(rx, program_path, db_path, session_id, exercise_name,
                        override=None):
    """The armable rungs of resolve_ramp_plan, as a bare ascending list -- the
    historical return shape, byte-for-byte, for every caller that only wants the
    rows (next_ladder_seq, due_rung, resolve_rung_arm_data, the suites).

    A THIN VIEW, in the exact sense set-table.planned_ramp_rows is one over
    ramp_decision: there is one planner, and a caller that needs to know WHY the
    list is empty calls resolve_ramp_plan instead. Empty list when this exercise
    plans no ramp (isolation / assisted / a load at or below the ramp floor /
    no resolvable weight at all)."""
    return resolve_ramp_plan(rx, program_path, db_path, session_id,
                             exercise_name, override)["rows"]


def resolve_rung_arm_data(rx, program_path, db_path, session_id, exercise_name,
                          override, set_seq):
    """(slot_num, weight, target_reps) for ONE warm-up rung -- the set_seq <= 0
    branch of resolve_current_arm_data. `(slot_num, None, None)` when this seq
    names no planned rung; the caller MUST treat that as "do not arm" and must
    never fall back to the working prescription (that fallback is the defect)."""
    slot_num, _w, _r = resolve_current_arm_data(
        rx, program_path, db_path, session_id, exercise_name, override)
    for row in resolve_ramp_ladder(rx, program_path, db_path, session_id,
                                   exercise_name, override):
        if row["set_seq"] == set_seq:
            return slot_num, row["weight_kg"], row["reps"]
    return slot_num, None, None


def logged_seqs(db_path, session_id, exercise_name):
    """Every set_seq already stored for this (session, exercise) as a set of
    ints. Best-effort: any DB miss -> empty set."""
    try:
        conn = _db_connect(db_path)
        try:
            rows = conn.execute(
                "SELECT set_seq FROM workout_sets WHERE session_id = ? AND "
                "exercise_name = ?", (session_id, exercise_name)).fetchall()
        finally:
            conn.close()
        return set(int(r[0]) for r in rows if r[0] is not None)
    except Exception:  # noqa: BLE001
        return set()


