# Every one of these degrades instead of raising, in the _drill_display style: a
# sandboxed tree carrying a subset of service/health has no ui_labels.py, and a
# NAME lookup must never be the thing that stops a set from being armed. The
# fallback is the TERM itself, which is also ui_labels' own default -- pinned
# equal by test, so the degrade path can never become a second opinion about
# what this quantity is called.

def _ui_labels():
    """The shared resolver module, or None in a tree that does not carry it."""
    try:
        if SCRIPT_DIR not in sys.path:
            sys.path.insert(0, SCRIPT_DIR)
        import ui_labels
        return ui_labels
    except Exception:  # noqa: BLE001 -- absent module is a degrade, not an error
        return None


def _rir_label(db_path=None):
    """The owner-facing name of the rir quantity. 'RIR' unless the knob differs."""
    mod = _ui_labels()
    return mod.label("rir", db_path) if mod else "RIR"


def _rir_josa(db_path, with_final, without_final):
    """The label plus the Korean particle that agrees with it. Degrades to the
    final-consonant form, which is the correct one for the default 'RIR'."""
    mod = _ui_labels()
    lab = _rir_label(db_path)
    return mod.josa(lab, with_final, without_final) if mod else lab + with_final


def _rir_fmt(rir_str, db_path=None):
    """An already-formatted rir value -> the owner-facing clause ('RIR 1-2').
